{
  "id": "align_anything_ragen_bandit",
  "repo": "align-anything",
  "repo_url": "https://github.com/PKU-Alignment/align-anything",
  "year": 2024,
  "task": "RAGEN Bandit policy optimization",
  "domain": "rl_agent",
  "fidelity": "official_report_task_budget_limited",
  "dataset": {
    "name": "Bandit task",
    "source": "align-anything technical_report.md RAGEN experimental results",
    "local_path": "generated deterministic multi-armed bandit",
    "download_script": null
  },
  "baseline": {
    "name": "RAGEN Bandit reported result",
    "metric": "success_rate",
    "value": 1.0,
    "source": "repositories/align-anything/docs/technical_report.md reports Bandit Task achieved 100% success rate within 200 training steps.",
    "command": "bash tasks/main/align_anything_ragen_bandit/baseline_eval.sh",
    "notes": "AgentHPOBench uses the same reported Bandit task family with a 1/10 training-step budget and exposes optimizer/exploration hyperparameters to the agent."
  },
  "budget_protocol": {
    "metric": "success_rate",
    "higher_is_better": true,
    "paper_steps": 200,
    "standard_steps": 20,
    "seed": 42,
    "baseline_config": {
      "learning_rate": 0.01,
      "batch_size": 16,
      "entropy_coef": 0.0,
      "temperature": 1.6,
      "reward_baseline": "none",
      "optimizer": "sgd"
    },
    "search_space": {
      "learning_rate": [0.01, 0.03, 0.1, 0.3],
      "batch_size": [16, 32, 64],
      "entropy_coef": [0.0, 0.01, 0.03, 0.06],
      "temperature": [0.6, 0.8, 1.0, 1.3, 1.6],
      "reward_baseline": ["none", "mean", "ema"],
      "optimizer": ["adam", "sgd"]
    }
  },
  "scripts": {
    "baseline_eval": "baseline_eval.sh",
    "agent": "run_formal_align_anything_ragen_bandit_agent.sh"
  }
}
