# Optional API-agent backend. Local open-weight runners do not require these.
AUTOREP_AGENT_BACKEND=openai
AUTOREP_API_MODEL=
AUTOREP_API_BASE_URL=
AUTOREP_API_KEY=

# Alternatively use provider-specific variables.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ZHIPUAI_API_KEY=

# Override local model locations when they differ from configs/models.json.
QWEN3_8B_MODEL=
AUTOREP_MODEL_PATH=
GEMMA2_2B_MODEL=
LLAMA3_1_8B_MODEL=
DEEPSEEK_R1_QWEN_14B_MODEL=
PHI4_14B_MODEL=

# Optional runtime layout overrides.
CONDA_ROOT=
VERL_INITIAL_CHECKPOINT=
