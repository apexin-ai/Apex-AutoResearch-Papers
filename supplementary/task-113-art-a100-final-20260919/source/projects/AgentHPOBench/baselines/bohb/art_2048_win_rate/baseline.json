{
  "id": "art_2048_win_rate",
  "repo": "ART",
  "repo_url": "https://github.com/OpenPipe/ART",
  "year": 2025,
  "task": "ART 2048 game policy benchmark",
  "domain": "rl_agent",
  "fidelity": "official_benchmark_task_budget_limited",
  "dataset": {
    "name": "2048 game rollouts",
    "source": "repositories/ART/examples/2048 and assets/benchmarks/2048",
    "local_path": "repositories/ART/examples/2048",
    "download_script": null
  },
  "baseline": {
    "name": "ART 2048 official benchmark chart",
    "metric": "win_rate",
    "value": 0.60,
    "source": "repositories/ART/assets/benchmarks/2048/accuracy-comparison.svg reports RL 60% games won.",
    "command": "bash baselines/bohb/art_2048_win_rate/baseline_eval.sh",
    "notes": "AgentHPOBench uses the repo's official 2048 environment utilities and a 25-game fixed-seed rollout budget capped at 70 moves per game. Agents tune heuristic policy hyperparameters under the same rollout budget."
  },
  "budget_protocol": {
    "metric": "win_rate",
    "higher_is_better": true,
    "paper_anchor": 0.60,
    "standard_games": 25,
    "max_moves": 70,
    "seed": 42,
    "baseline_config": {
      "lookahead_depth": 2,
      "empty_weight": 2.0,
      "merge_weight": 1.0,
      "max_tile_weight": 2.0,
      "corner_weight": 2.0,
      "smoothness_weight": 0.2,
      "move_order": "up_left_right_down"
    },
    "search_space": {
      "lookahead_depth": [1, 2, 3],
      "empty_weight": [0.5, 1.0, 2.0, 3.0],
      "merge_weight": [0.0, 0.5, 1.0, 2.0],
      "max_tile_weight": [0.5, 1.0, 2.0, 4.0],
      "corner_weight": [0.0, 1.0, 2.0, 4.0],
      "smoothness_weight": [0.0, 0.2, 0.5, 1.0],
      "move_order": ["left_up_right_down", "up_left_right_down", "right_up_left_down", "down_left_right_up"]
    }
  },
  "scripts": {
    "baseline_eval": "baseline_eval.sh",
    "agent": "run_formal_art_2048_win_rate_agent.sh"
  }
}
