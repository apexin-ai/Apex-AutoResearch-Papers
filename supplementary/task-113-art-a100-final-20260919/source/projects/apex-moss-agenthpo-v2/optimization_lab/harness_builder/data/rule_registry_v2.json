  "rules": [
    {
      "rule_id": "discipline",
      "trigger": ["A correct incumbent exists and one measured bottleneck is supported by evidence."],
      "action": ["Keep the incumbent and change one bounded mechanism aimed at that bottleneck."],
      "guardrails": ["Do not bundle unrelated structural changes; require a falsifiable expected signal."],
      "maturity": "implemented_partial",
      "provenance": ["Apex-Tune v9-recombinant@17223eec6f7c29490888a278c86122e9f9f070ad"],
      "availability": "executable",
      "decision_plane": "context_hint",
      "enforcement": "typed_proposal",
      "operator_ref": "moss.rule.discipline.v1",
      "writes": ["/kernel_directive"],
      "source_refs": ["apex.v9.discipline", "apex.v9.live.control"],
      "derivation": {"kind": "parameterized_port", "semantic_change_note": "Only the measured-fact control pattern is ported; all NanoChat payload and thresholds are excluded."},
      "confidence": {"implementation": "prompt_only", "empirical_scope": "single_campaign", "transfer": "unvalidated"},
      "relations": {"requires": [], "excludes": [], "overrides": [], "fallback_rule_id": null, "on_same_write": "reject"}
    },
    {
      "rule_id": "dream",
      "trigger": ["The incumbent family is plausibly saturated or repeated local changes are flat."],
      "action": ["Reset the architecture and propose a qualitatively different decomposition."],
      "guardrails": ["Start from a frozen reference or explicit root; the child inherits no parent score."],
      "maturity": "implemented_partial",
      "provenance": ["Apex-Tune v9-recombinant@17223eec6f7c29490888a278c86122e9f9f070ad"],
      "availability": "executable",
      "decision_plane": "stop_restart",
      "enforcement": "deterministic_guard",
      "operator_ref": "moss.rule.dream_restart.v1",
      "writes": ["/parent_strategy", "/kernel_directive"],
      "source_refs": ["apex.v9.dream", "apex.v9.live.control"],
      "derivation": {"kind": "parameterized_port", "semantic_change_note": "Moss implements a reference-root restart; standalone full-champion and live blind-memory Dream remain distinct source surfaces."},
      "confidence": {"implementation": "wired_tested", "empirical_scope": "single_campaign", "transfer": "unvalidated"},
      "relations": {"requires": [], "excludes": [], "overrides": [], "fallback_rule_id": null, "on_same_write": "reject"}
    },
    {
      "rule_id": "law_inversion",
      "trigger": ["At least two evidence-bearing attempts failed to improve and share an assumption."],
      "action": ["State the shared assumption and construct a child that deliberately inverts it."],
      "guardrails": ["The inverted assumption must be named; arbitrary novelty does not qualify."],
      "maturity": "implemented_partial",
      "provenance": ["Apex-Tune v9-recombinant@17223eec6f7c29490888a278c86122e9f9f070ad"],
      "availability": "executable",
      "decision_plane": "context_hint",
      "enforcement": "typed_proposal",
      "operator_ref": "moss.rule.law_inversion_prompt.v1",
      "writes": ["/kernel_directive"],
      "source_refs": ["apex.v9.laws", "apex.v9.live.control"],
      "derivation": {"kind": "parameterized_port", "semantic_change_note": "The inversion proposal is available after two sealed attempts; Apex forced cadence and prose filters are not claimed as Moss guards."},
      "confidence": {"implementation": "prompt_only", "empirical_scope": "single_campaign", "transfer": "unvalidated"},
      "relations": {"requires": [], "excludes": [], "overrides": [], "fallback_rule_id": null, "on_same_write": "reject"}
    },
    {
      "rule_id": "recombination",
      "trigger": ["Two frozen parents have complementary mechanisms or resource profiles."],
      "action": ["Build a new child from explicit parent contributions and re-evaluate from zero."],
      "guardrails": ["Do not splice arbitrary text; reject same-niche duplicates and inherited scores."],
      "maturity": "implemented_partial",
      "provenance": ["Apex-Tune v9-recombinant@17223eec6f7c29490888a278c86122e9f9f070ad"],
      "availability": "executable",
      "decision_plane": "selection",
      "enforcement": "deterministic_guard",
      "operator_ref": "moss.rule.recombination_distinct_structure.v1",
      "writes": ["/parent_strategy", "/kernel_directive"],
      "source_refs": ["apex.v9.archive", "apex.v9.recombination"],
      "derivation": {"kind": "parameterized_port", "semantic_change_note": "Moss selects the two highest-scoring correct distinct structural signatures; it does not claim Apex QD niches or rank-RNG selection."},
      "confidence": {"implementation": "wired_tested", "empirical_scope": "single_campaign", "transfer": "unvalidated"},
      "relations": {"requires": [], "excludes": [], "overrides": [], "fallback_rule_id": null, "on_same_write": "reject"}
    },
    {
      "rule_id": "correctness_recovery",
      "trigger": ["The latest attempt failed formatting, compilation, or correctness."],
      "action": ["Repair the earliest failing contract before any performance optimization."],
      "guardrails": ["A failed attempt remains in the denominator; environment errors are separate."],
      "maturity": "implemented",
      "provenance": ["Moss P1/P2/P2b append-only trajectories"],
      "availability": "executable",
      "decision_plane": "recovery",
      "enforcement": "deterministic_guard",
      "operator_ref": "moss.rule.correctness_recovery.v1",
