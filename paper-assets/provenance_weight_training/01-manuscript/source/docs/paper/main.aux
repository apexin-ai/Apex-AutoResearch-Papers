\@writefile{lot}{\contentsline {table}{\numberline {12}{\ignorespaces Correlation between $\alpha _{\mathrm  {eff}}(0)$ and true batch-level real fraction across batch sizes ($\rho {=}0.4$, seed\,42). Values use a binarized proxy $\hat  {r}_i = \mathbf  {1}[q_i \leq 0.5]$ for discrete comparison; the continuous formulation used during training (\S  \ref {sec:method}) achieves $r \approx 0.77$--$0.79$ depending on batch size. The consistent negative bias (${\approx }{-}0.03$) indicates that $\alpha _{\mathrm  {eff}}$ slightly underestimates the true real fraction, biasing the method toward conservative intervention.}}{13}{table.caption.46}\protected@file@percent }
\newlabel{tab:alpha_corr}{{12}{13}{Correlation between $\aeff (0)$ and true batch-level real fraction across batch sizes ($\rho {=}0.4$, seed\,42). Values use a binarized proxy $\hat {r}_i = \mathbf {1}[q_i \leq 0.5]$ for discrete comparison; the continuous formulation used during training (\S \ref {sec:method}) achieves $r \approx 0.77$--$0.79$ depending on batch size. The consistent negative bias (${\approx }{-}0.03$) indicates that $\aeff $ slightly underestimates the true real fraction, biasing the method toward conservative intervention}{table.caption.46}{}}
\@writefile{lot}{\contentsline {table}{\numberline {13}{\ignorespaces Per-seed $\alpha _{\mathrm  {eff}}$--$\bar  {q}$ correlation ($\rho {=}0.4$, $B{=}4$). Cross-seed spread is $<$0.003 for Pearson $r$ and $<$0.007 for Spearman $\rho _s$, indicating stable proxy fidelity across random seeds. $r(\alpha _{\mathrm  {eff}}, \bar  {q}) = 0.80$ measures the proxy's fidelity to batch composition; the ground-truth correlation $r(\alpha _{\mathrm  {eff}}, \text  {true real fraction}) \approx 0.79$ (\S  \ref {sec:discussion}) is slightly lower due to detector noise. The per-seed table demonstrates cross-seed stability rather than superseding the ground-truth estimate.}}{13}{table.caption.48}\protected@file@percent }
\newlabel{tab:alpha_corr_perseed}{{13}{13}{Per-seed $\aeff $--$\bar {q}$ correlation ($\rho {=}0.4$, $B{=}4$). Cross-seed spread is $<$0.003 for Pearson $r$ and $<$0.007 for Spearman $\rho _s$, indicating stable proxy fidelity across random seeds. $r(\aeff , \bar {q}) = 0.80$ measures the proxy's fidelity to batch composition; the ground-truth correlation $r(\aeff , \text {true real fraction}) \approx 0.79$ (\S \ref {sec:discussion}) is slightly lower due to detector noise. The per-seed table demonstrates cross-seed stability rather than superseding the ground-truth estimate}{table.caption.48}{}}
