\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces D\&R threshold sensitivity ($\rho {=}0.4$, seed\,42 unless noted). Raw PPL traces a U-shaped curve (minimum at $q{>}0.3$); epoch-matched PPL (single content epoch) decreases monotonically and saturates near the adaptive $b^*$ level (${\approx }$17.65) at $q{\geq }0.5$; the U-shape is thus a multi-epoch artifact. $^\dagger $\,3-seed mean $17.250 \pm 0.001$.}}{12}{table.caption.43}\protected@file@percent }
\newlabel{tab:dr_threshold}{{9}{12}{D\&R threshold sensitivity ($\rho {=}0.4$, seed\,42 unless noted). Raw PPL traces a U-shaped curve (minimum at $q{>}0.3$); epoch-matched PPL (single content epoch) decreases monotonically and saturates near the adaptive $\bstar $ level (${\approx }$17.65) at $q{\geq }0.5$; the U-shape is thus a multi-epoch artifact. $^\dagger $\,3-seed mean $17.250 \pm 0.001$}{table.caption.43}{}}
