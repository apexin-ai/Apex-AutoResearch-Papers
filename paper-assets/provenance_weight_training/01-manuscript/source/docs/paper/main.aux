\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Main comparison: held-out PPL ($\downarrow $) at $\rho {=}0.4$, 1 content epoch. Adaptive and Uniform: 5-seed means (seeds 42, 123, 456, 789, 234); ESS-only and Random: 3-seed means (seeds 42, 123, 456); Permuted: single seed (42). Adaptive uses $\tau {=}0.7$, $n_{\min }{=}2$. Permuted randomly shuffles $q$-scores across samples, destroying provenance signal while preserving weight non-uniformity ($\Delta {=}{+}0.225$).}}{5}{table.caption.16}\protected@file@percent }
\newlabel{tab:main}{{2}{5}{Main comparison: held-out PPL ($\downarrow $) at $\rho {=}0.4$, 1 content epoch. Adaptive and Uniform: 5-seed means (seeds 42, 123, 456, 789, 234); ESS-only and Random: 3-seed means (seeds 42, 123, 456); Permuted: single seed (42). Adaptive uses $\tau {=}0.7$, $\nmin {=}2$. Permuted randomly shuffles $q$-scores across samples, destroying provenance signal while preserving weight non-uniformity ($\Delta {=}{+}0.225$)}{table.caption.16}{}}
