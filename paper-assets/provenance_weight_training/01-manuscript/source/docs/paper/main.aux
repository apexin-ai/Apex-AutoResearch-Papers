\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Dual-constraint $b^*$ selection for two representative batches ($B{=}4$, $\tau {=}0.7$, $n_{\min }{=}2$). \textbf  {(a)}~Quality constraint binds: $\alpha _{\mathrm  {eff}}(b)$ reaches $\tau $ before $\mathrm  {ESS}(b)$ drops below $n_{\min }$, so $b^*= b_{\tau }$. \textbf  {(b)}~Stability constraint binds: $\mathrm  {ESS}(b)$ hits the floor first, so $b^*= b_{\mathrm  {ESS}}$. Green: feasible interval; red: over-sharpening.}}{4}{figure.caption.9}\protected@file@percent }
\newlabel{fig:dual_constraint}{{3}{4}{Dual-constraint $\bstar $ selection for two representative batches ($B{=}4$, $\tau {=}0.7$, $\nmin {=}2$). \textbf {(a)}~Quality constraint binds: $\aeff (b)$ reaches $\tau $ before $\mathrm {ESS}(b)$ drops below $\nmin $, so $\bstar = \btau $. \textbf {(b)}~Stability constraint binds: $\mathrm {ESS}(b)$ hits the floor first, so $\bstar = \bess $. Green: feasible interval; red: over-sharpening}{figure.caption.9}{}}
