\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces Quality threshold sweep ($n_{\min }{=}2$, $\rho {=}0.4$). $\Delta $ relative to 3-seed uniform baseline (Holdout 17.694, OWT 18.375, Wiki 15.359). $^\star $\,$\tau {=}0.7$: 5-seed mean (SD from 5 seeds); $\tau {=}0.8$: 3 from-scratch seeds (Appendix~\ref {app:resume_artifact}). The 5-seed comparison in Table~\ref {tab:main} yields $\Delta {=}{-}0.023$. Other values from single-seed exploratory sweep (seed\,42, holdout only). $\tau {=}0.7$ achieves the lowest holdout and largest OOD gains ($|\Delta | \geq 0.028$); $\tau {=}0.8$'s OOD effect is smaller ($|\Delta | \leq 0.009$).}}{11}{table.caption.40}\protected@file@percent }
\newlabel{tab:tau}{{7}{11}{Quality threshold sweep ($\nmin {=}2$, $\rho {=}0.4$). $\Delta $ relative to 3-seed uniform baseline (Holdout 17.694, OWT 18.375, Wiki 15.359). $^\star $\,$\tau {=}0.7$: 5-seed mean (SD from 5 seeds); $\tau {=}0.8$: 3 from-scratch seeds (Appendix~\ref {app:resume_artifact}). The 5-seed comparison in Table~\ref {tab:main} yields $\Delta {=}{-}0.023$. Other values from single-seed exploratory sweep (seed\,42, holdout only). $\tau {=}0.7$ achieves the lowest holdout and largest OOD gains ($|\Delta | \geq 0.028$); $\tau {=}0.8$'s OOD effect is smaller ($|\Delta | \leq 0.009$)}{table.caption.40}{}}
