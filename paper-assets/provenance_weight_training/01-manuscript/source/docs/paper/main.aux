\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Three effectiveness conditions for detect-and-reweight. \textbf  {(a)}~D\&R achieves the best raw perplexity (PPL); epoch-matched controls reveal that multi-epoch exposure on filtered data accounts for the bulk of the advantage (\S  \ref {sec:results}). \textbf  {(b)}~Only detectors with both high AUC \emph  {and} low ECE fall in the effective zone; comparable AUC with poor calibration degrades PPL below uniform. \textbf  {(c)}~Adaptive $b^*{\approx }0.9$ operates near the grid-search optimum, while ESS-only $b{\approx }3.5$ falls in the degradation zone.}}{2}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:overview}{{1}{2}{Three effectiveness conditions for detect-and-reweight. \textbf {(a)}~D\&R achieves the best raw perplexity (PPL); epoch-matched controls reveal that multi-epoch exposure on filtered data accounts for the bulk of the advantage (\S \ref {sec:results}). \textbf {(b)}~Only detectors with both high AUC \emph {and} low ECE fall in the effective zone; comparable AUC with poor calibration degrades PPL below uniform. \textbf {(c)}~Adaptive $\bstar {\approx }0.9$ operates near the grid-search optimum, while ESS-only $b{\approx }3.5$ falls in the degradation zone}{figure.caption.1}{}}
