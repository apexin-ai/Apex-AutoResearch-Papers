\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Exposure bias collapses auxiliary attention losses. \textbf  {(a)}~Goal attention decays 85--90\% across turns under AR generation on both Qwen-2.5-7B and Llama-3.1-8B. \textbf  {(b)}~Under TF evaluation all variants reach GAR$\approx $0.50, but AR generation collapses GAR by 8--17$\times $ (log scale). \textbf  {(c)}~Scheduled sampling compresses the TF--AR gap from 7.8$\times $ to 1.3$\times $ (Qwen) and ${\sim }$27$\times $ to 2.9$\times $ (Llama).}}{3}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:headline}{{1}{3}{Exposure bias collapses auxiliary attention losses. \textbf {(a)}~Goal attention decays 85--90\% across turns under AR generation on both Qwen-2.5-7B and Llama-3.1-8B. \textbf {(b)}~Under TF evaluation all variants reach GAR$\approx $0.50, but AR generation collapses GAR by 8--17$\times $ (log scale). \textbf {(c)}~Scheduled sampling compresses the TF--AR gap from 7.8$\times $ to 1.3$\times $ (Qwen) and ${\sim }$27$\times $ to 2.9$\times $ (Llama)}{figure.caption.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Five-way comparison on Qwen-2.5-7B-Instruct. TF evaluation uses IID UltraChat and 50 held-out conversations; AR evaluation uses $N$\,=\,50 held-out conversations (mean 3.6 user turns). All fine-tuned variants converge under TF ($\leq $2\,pp spread); the 8--17$\times $ TF-AR gap persists across all configurations. $\bar  {g}\!\pm \!\sigma _g$: learned gate mean and std across 28 layers (LoRA-only has no gates). GAR-O = GAR-ours; GAR-D = GAR-Dongre \citep  {dongre2026attention}; PPL = perplexity.}}{3}{table.caption.5}\protected@file@percent }
\newlabel{tab:five-way}{{1}{3}{Five-way comparison on Qwen-2.5-7B-Instruct. TF evaluation uses IID UltraChat and 50 held-out conversations; AR evaluation uses $N$\,=\,50 held-out conversations (mean 3.6 user turns). All fine-tuned variants converge under TF ($\leq $2\,pp spread); the 8--17$\times $ TF-AR gap persists across all configurations. $\bar {g}\!\pm \!\sigma _g$: learned gate mean and std across 28 layers (LoRA-only has no gates). GAR-O = GAR-ours; GAR-D = GAR-Dongre \citep {dongre2026attention}; PPL = perplexity}{table.caption.5}{}}
