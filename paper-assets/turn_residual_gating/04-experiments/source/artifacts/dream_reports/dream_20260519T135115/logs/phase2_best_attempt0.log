{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GmSZXkZsyGay88BQj3AEHr","type":"tool_result","content":"1\t# Experiment Plan — turn_residual_gating (Route B)\n2\t# Post-MVP research phase: negative result + mechanistic insight\n3\t# Target: EMNLP 2026 ARR August cycle (2026-08-03)\n4\t# Last updated: 2026-05-19\n5\t\n6\texperiments:\n7\t  # === COMPLETED (MVP phase, have registry_id) ===\n8\t\n9\t  - id: plan_001\n10\t    claim: C1\n11\t    description: \"Phase 1 GAR degradation diagnosis on Qwen-2.5-7B (70.8% raw drop)\"\n12\t    priority: P0\n13\t    gpu_budget_hours: 2\n14\t    deps: []\n15\t    registry_id: phase1_gar_diag\n16\t    status: done\n17\t\n18\t  - id: plan_002\n19\t    claim: C2\n20\t    description: \"ThreadGate v7 training (MSE+gate_div) - training GAR 0.48, inference GAR 0.016\"\n21\t    priority: P0\n22\t    gpu_budget_hours: 6\n23\t    deps: [plan_001]\n24\t    registry_id: phase2_tg_s42_v7\n25\t    status: done\n26\t\n27\t  - id: plan_003\n28\t    claim: C4\n29\t    description: \"Uniform Gate ablation - isolate turn conditioning contribution\"\n30\t    priority: P0\n31\t    gpu_budget_hours: 6\n32\t    deps: [plan_001]\n33\t    registry_id: phase2_ug_s42\n34\t    status: done\n35\t\n36\t  - id: plan_004\n37\t    claim: C4\n38\t    description: \"LoRA-only ablation - isolate gating mechanism contribution\"\n39\t    priority: P0\n40\t    gpu_budget_hours: 6\n41\t    deps: [plan_001]\n42\t    registry_id: phase2_lora_only_s42\n43\t    status: done\n44\t\n45\t  - id: plan_005\n46\t    claim: C4\n47\t    description: \"Four-way eval (Base/TG/UG/LoRA-only x GAR-ours/Dongre + PPL)\"\n48\t    priority: P0\n49\t    gpu_budget_hours: 2\n50\t    deps: [plan_002, plan_003, plan_004]\n51\t    registry_id: phase2_4way_eval\n52\t    status: done\n53\t\n54\t  - id: plan_006\n55\t    claim: C3\n56\t    description: \"Gradient conflict analysis on v7 (3 epoch checkpoints) - NTP vs GAR gradient cos_sim + magnitude ratio\"\n57\t    prio