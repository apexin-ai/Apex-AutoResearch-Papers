\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Three-way evaluation on Llama-3.1-8B. ThreadGate shows a 1.6 pp advantage over LoRA-only in GAR-Dongre (0.038 vs.\ 0.022), larger than the $<$0.6 pp difference observed on Qwen, but still statistically non-significant (Table~\ref {tab:bootstrap}).}}{4}{table.caption.10}\protected@file@percent }
\newlabel{tab:llama_3way}{{3}{4}{Three-way evaluation on Llama-3.1-8B. ThreadGate shows a 1.6 pp advantage over LoRA-only in GAR-Dongre (0.038 vs.\ 0.022), larger than the $<$0.6 pp difference observed on Qwen, but still statistically non-significant (Table~\ref {tab:bootstrap})}{table.caption.10}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Training-inference gap comparison. Both models show large gaps between training-time and inference-time GAR, confirming the distribution shift is not architecture-specific. Llama's smaller gap (10$\times $ vs.\ 30$\times $) correlates with its higher base GAR and GQA architecture.}}{4}{table.caption.11}\protected@file@percent }
\newlabel{tab:gap}{{4}{4}{Training-inference gap comparison. Both models show large gaps between training-time and inference-time GAR, confirming the distribution shift is not architecture-specific. Llama's smaller gap (10$\times $ vs.\ 30$\times $) correlates with its higher base GAR and GQA architecture}{table.caption.11}{}}
