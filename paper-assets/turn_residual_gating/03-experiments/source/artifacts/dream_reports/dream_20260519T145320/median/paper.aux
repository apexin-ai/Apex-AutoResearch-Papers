\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces Scheduled sampling (SS) vs.\ teacher-forcing (TF) on Qwen. SS reduces the training-inference gap from 30$\times $ to 12.3$\times $ and partially corrects gate direction (13/28 layers no longer reversed), but the improvement is statistically marginal ($p{\approx }0.07$, CI includes zero).}}{6}{table.caption.16}\protected@file@percent }
\newlabel{tab:mitigation}{{9}{6}{Scheduled sampling (SS) vs.\ teacher-forcing (TF) on Qwen. SS reduces the training-inference gap from 30$\times $ to 12.3$\times $ and partially corrects gate direction (13/28 layers no longer reversed), but the improvement is statistically marginal ($p{\approx }0.07$, CI includes zero)}{table.caption.16}{}}
