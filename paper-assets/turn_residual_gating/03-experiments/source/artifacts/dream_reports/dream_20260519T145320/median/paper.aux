\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces GAR and instruction retention rate across turns (Qwen). GAR and retention are positively correlated ($r{=}0.72$), validating GAR as a proxy for task-level degradation. ThreadGate does not improve retention ($<$1.5 pp difference).}}{5}{table.caption.12}\protected@file@percent }
\newlabel{tab:retention}{{5}{5}{GAR and instruction retention rate across turns (Qwen). GAR and retention are positively correlated ($r{=}0.72$), validating GAR as a proxy for task-level degradation. ThreadGate does not improve retention ($<$1.5 pp difference)}{table.caption.12}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces NTP--GAR gradient conflict across training. On both architectures, a majority of layers show opposing gradient directions (negative cosine similarity), while NTP magnitude increasingly dominates. Llama shows more layers with positive cosine similarity (10/32), reflecting the cooperative effect of GQA's shared KV projections.}}{5}{table.caption.13}\protected@file@percent }
\newlabel{tab:gradient}{{6}{5}{NTP--GAR gradient conflict across training. On both architectures, a majority of layers show opposing gradient directions (negative cosine similarity), while NTP magnitude increasingly dominates. Llama shows more layers with positive cosine similarity (10/32), reflecting the cooperative effect of GQA's shared KV projections}{table.caption.13}{}}
