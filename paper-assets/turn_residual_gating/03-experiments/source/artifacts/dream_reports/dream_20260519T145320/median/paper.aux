\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Per-turn GAR decay (GAR-Dongre, mid-turn average) for base models. Qwen shows a steep 70.8\% decline from turn~1 to mid-turns; Llama shows a more gradual 40.8\% decline. Both exhibit monotonic decay, confirming GAR degradation as a cross-architecture phenomenon, though severity varies.}}{4}{table.caption.8}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{tab:gar_decay}{{1}{4}{Per-turn GAR decay (GAR-Dongre, mid-turn average) for base models. Qwen shows a steep 70.8\% decline from turn~1 to mid-turns; Llama shows a more gradual 40.8\% decline. Both exhibit monotonic decay, confirming GAR degradation as a cross-architecture phenomenon, though severity varies}{table.caption.8}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Four-way evaluation on Qwen-2.5-7B (50 held-out conversations). GAR-D: GAR-Dongre (mid-turn); GAR-O: GAR-ours (mid-turn); PPL: perplexity; NTP: NTP loss. All fine-tuned models achieve nearly identical GAR and PPL, confirming that gating provides no incremental benefit.}}{4}{table.caption.9}\protected@file@percent }
\newlabel{tab:qwen_4way}{{2}{4}{Four-way evaluation on Qwen-2.5-7B (50 held-out conversations). GAR-D: GAR-Dongre (mid-turn); GAR-O: GAR-ours (mid-turn); PPL: perplexity; NTP: NTP loss. All fine-tuned models achieve nearly identical GAR and PPL, confirming that gating provides no incremental benefit}{table.caption.9}{}}
