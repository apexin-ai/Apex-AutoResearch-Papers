  dream_20260516T024415:
    dream_id: dream_20260516T024415
    project: meta_brain_lora_routing
    status: failed
    review_mode: full
    review_visible: true
    writing_visible: true
    venue: ''
    focus: 'UPDATES since Dream #2: (1) D008 data strategy pivot — all experts now
      train on standard LIBERO demos + type-specific augmentation (visual/spatial/physical),
      unified pipeline eliminates training data asymmetry. (2) D009 compound perturbation
      experiment added (plan_016) — V+S, V+P, S+P, V+S+P combinations test soft routing
      on co-occurring perturbations. (3) Method reframing — explicitly positioned
      as ''perturbation-diagnostic routing as a new principle, implemented with well-understood
      MoE-LoRA components''. 4 differentiators from standard MoE-LoRA: frozen self-diagnosis
      routing signal, corrective deltas, compound handling via soft blend, mechanistic
      layer placement grounding. (4) Bibliography to be expanded to 30+ refs engaging
      MoE-LoRA literature. Key question: does compound perturbation experiment + reframing
      address the novelty and closed-set taxonomy concerns that kept Dream #2 at 5-6/10?'
    what_if: []
