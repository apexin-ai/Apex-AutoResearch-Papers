{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01D4WfYSW9UmpqgKFySCCD2s","type":"tool_result","content":"1\t# Experiment Plan — Option A: Architecture-Dependent Cross-Axis Signal\n2\t# Last updated: 2026-05-12 (D004: GQA positive, MLA negative)\n3\t# Target: EMNLP 2026 ARR (DDL: 2026-05-25)\n4\t\n5\texperiments:\n6\t\n7\t  # ============================================================\n8\t  # COMPLETED: MVP + cross-model validation\n9\t  # ============================================================\n10\t\n11\t  - plan_id: mvp-001\n12\t    registry_id: mvp-001\n13\t    name: \"MVP: adjacent-sim baseline (invalid EMA)\"\n14\t    status: DONE\n15\t    result: \"r=-0.186, Δpert=-1.5%, FAIL (wrong impl)\"\n16\t\n17\t  - plan_id: mvp-001b\n18\t    registry_id: mvp-001b\n19\t    name: \"MVP: DeepSeek-R1-7B anchor EMA (easy problems)\"\n20\t    claim: \"Claim 1 (MLA side)\"\n21\t    status: DONE\n22\t    result: \"r=+0.147, Δpert=-2.2%, FAIL on MLA\"\n23\t\n24\t  - plan_id: mvp-001c\n25\t    registry_id: mvp-001c\n26\t    name: \"MVP: DeepSeek-R1-7B anchor EMA (AIME hard problems)\"\n27\t    claim: \"Claim 1 (MLA side, difficulty confound)\"\n28\t    status: DONE\n29\t    result: \"r=+0.159, Δpert=-1.2%, FAIL on MLA — difficulty doesn't matter\"\n30\t\n31\t  - plan_id: neg-cross-model-001\n32\t    registry_id: neg-cross-model-001\n33\t    name: \"Llama-3.1-8B anchor EMA validation\"\n34\t    claim: \"Claim 1 (GQA side — POSITIVE)\"\n35\t    status: DONE\n36\t    result: \"r=+0.471, Δpert=+6.6%, hypothesis HOLDS on GQA\"\n37\t\n38\t  # ============================================================\n39\t  # P0: Core experiments for architecture-dependent narrative\n40\t  # ============================================================\n41\t\n42\t  - plan_id: llama-sparsity-sweep\n43\t    name: \"Llama sparsity level sweep: push Δpert higher\"\n44\t    claim: \"Claim 1, 3 (strengthen GQA positive evidence)\"\n45\t    priority: P0\n46\t    description: |\n47\t      Test higher sparsity on Llama: {50%, 55%, 60%, 65%, 70%}.\n48\t      Current Δpert=+6.6% at 55%. Higher sparsity may widen the gap\n49\t      between redundant and novel tokens.\n50\t    model: \"meta-llama/Llama-3.1-8B-Instruct\"\n51\t    gpu_hours: 4\n52\t    depends_on: [neg-cross-model-001]\n53\t    status: PLANNED\n54\t\n55\t  - plan_id: llama-layer-analysis\n56\t    name: \"Llama per-layer r + Δpert decomposition\"\n57\t    claim: \"Claim 3 (per-layer architecture comparison)\"\n58\t    priority: P0\n59\t    description: |\n60\t      Per-layer analysis on Llama data (from neg-cross-model-001).\n61\t      Compare with DeepSeek per-layer profile.\n62\t      Key question: do all layers show positive signal on GQA, or concentrated?\n63\t    gpu_hours: 1\n64\t    depends_on: [neg-cross-model-001]\n65\t    status: PLANNED\n66\t\n67\t  - plan_id: kv-bench-001\n68\t    registry_id: kv-bench-001\n69\t    name: \"KV eviction benchmark: CARC-KV vs baselines\"\n70\t    claim: \"Claim 4 (O(1) KV eviction)\"\n71\t    priority: P0\n72\t    description: |\n73\t      CARC-KV (O(1)) vs H2O (O(n)) vs SnapKV vs StreamingLLM.\n74\t      KV budgets {30%, 50%, 70%}. Eval: perplexity + accuracy.\n75\t    model: \"deepseek-ai/DeepSeek-R1-Distill-Qwen-7B\"\n76\t    gpu_hours: 20\n77\t    depends_on: []\n78\t    status: PREPARING\n79\t\n80\t  # ============================================================\n81\t  # P1: Strengthen architecture-dependence narrative\n82\t  # ============================================================\n83\t\n84\t  - plan_id: cross-arch-mistral\n85\t    name: \"Mistral-7B validation (2nd GQA model)\"\n86\t    claim: \"Claim 1 (GQA generalization)\"\n87\t    priority: P1\n88\t    description: |\n89\t      Repeat validation on Mistral-7B-Instruct (standard GQA).\n90\t      Confirms GQA positive is not Llama-specific.\n91\t    model: \"mistralai/Mistral-7B-Instruct-v0.3\"\n92\t    gpu_hours: 6\n93\t    depends_on: [neg-cross-model-001]\n94\t    status: PLANNED\n95\t\n96\t  - plan_id: mla-signal-analysis\n97\t    name: \"MLA latent space semantic fidelity analysis\"\n98\t    claim: \"Claim 2 (mechanistic: why MLA breaks signal)\"\n99\t    priority: P1\n100\t    description: |\n101\t      Analyze MLA latent compression:\n102\t      - Compare angular distribution of KV vectors in MLA vs GQA\n103\t      - Measure information loss from MLA's low-rank projection\n104\t      - Correlate latent dimension with r degradation\n105\t    gpu_hours: 4\n106\t    depends_on: [mvp-001b, neg-cross-model-001]\n107\t    status: PLANNED\n108\t\n109\t  - plan_id: kv-eviction-wallclock\n110\t    name: \"Wall-clock: O(1) vs O(n) eviction cost\"\n111\t    claim: \"Claim 4\"\n112\t    priority: P1\n113\t    description: |\n114\t      Eviction overhead timing at L={4K, 8K, 16K, 32K}.\n115\t      CARC-KV O(1) vs H2O O(n).\n116\t    gpu_hours: 10\n117\t    depends_on: [kv-bench-001]\n118\t    status: PLANNED\n119\t\n120\t  - plan_id: neg-per-head\n121\t    name: \"Per-head KV contribution analysis\"\n122\t    claim: \"Claim 2, 3 (is it just head count 4 vs 8?)\"\n123\t    priority: P1\n124\t    description: |\n125\t      Normalize per-head signal contribution.\n126\t      DeepSeek: 4 KV heads, Llama: 8 KV heads.\n127\t      Test: even per-head, does GQA show stronger signal?\n128\t    gpu_hours: 2\n129\t    depends_on: [mvp-001b, neg-cross-model-001]\n130\t    status: PLANNED\n131\t\n132\t  # ============================================================\n133\t  # P2: Extensions\n134\t  # ============================================================\n135\t\n136\t  - plan_id: kv-eviction-ablation\n137\t    name: \"KV eviction: key-only vs key+value anchor\"\n138\t    claim: \"Claim 4\"\n139\t    priority: P2\n140\t    gpu_hours: 5\n141\t    depends_on: [kv-bench-001]\n142\t    status: PLANNED\n143\t\n144\t  - plan_id: llama-downstream\n145\t    name: \"Llama two-tier sparsity downstream accuracy\"\n146\t    claim: \"Claim 1 (practical value of cross-axis on GQA)\"\n147\t    priority: P2\n148\t    description: |\n149\t      Apply CARC two-tier MLP sparsity on Llama: 55% redundant / 40% novel.\n150\t      Compare accuracy vs uniform sparsity on MATH problems.\n151\t    gpu_hours: 6\n152\t    depends_on: [llama-sparsity-sweep]\n153\t    status: PLANNED\n154\t\n155\t# ============================================================\n156\t# Timeline (12-day sprint, 5/12 → 5/25)\n157\t# ============================================================\n158\t# Day 1 (5/12): llama-sparsity-sweep + llama-layer-analysis (CPU)\n159\t# Day 1-3: kv-bench-001 (parallel after sparsity sweep)\n160\t# Day 2-4: cross-arch-mistral (download + run)\n161\t# Day 3-5: mla-signal-analysis + neg-per-head\n162\t# Day 4-7: kv-eviction-wallclock\n163\t# Day 6-12: paper writing (parallel with P2)\n164\t"}]},"parent_tool_use_id":null,"session_id":"b29dc05e-0f65-42a2-b5fb-3ed6a8ca41da","uuid":"8db68c55-e7cf-4f04-820d-84cfab42c3ca","timestamp":"2026-05-12T02:25:42.290Z","tool_use_result":{"type":"text","file":{"filePath":"/home/ubuntu/.agent-ml-research-idea_gen_0509_11/projects/redundancy-compound-sparsity/experiment_plan.yaml","content":"# Experiment Plan — Option A: Architecture-Dependent Cross-Axis Signal\n# Last updated: 2026-05-12 (D004: GQA positive, MLA negative)\n# Target: EMNLP 2026 ARR (DDL: 2026-05-25)\n\nexperiments:\n\n  # ============================================================\n  # COMPLETED: MVP + cross-model validation\n  # ============================================================\n\n  - plan_id: mvp-001\n    registry_id: mvp-001\n    name: \"MVP: adjacent-sim baseline (invalid EMA)\"\n    status: DONE\n    result: \"r=-0.186, Δpert=-1.5%, FAIL (wrong impl)\"\n\n  - plan_id: mvp-001b\n    registry_id: mvp-001b\n    name: \"MVP: DeepSeek-R1-7B anchor EMA (easy problems)\"\n    claim: \"Claim 1 (MLA side)\"\n    status: DONE\n    result: \"r=+0.147, Δpert=-2.2%, FAIL on MLA\"\n\n  - plan_id: mvp-001c\n    registry_id: mvp-001c\n    name: \"MVP: DeepSeek-R1-7B anchor EMA (AIME hard problems)\"\n    claim: \"Claim 1 (MLA side, difficulty confound)\"\n    status: DONE\n    result: \"r=+0.159, Δpert=-1.2%, FAIL on MLA — difficulty doesn't matter\"\n\n  - plan_id: neg-cross-model-001\n    registry_id: neg-cross-model-001\n    name: \"Llama-3.1-8B anchor EMA validation\"\n    claim: \"Claim 1 (GQA side — POSITIVE)\"\n    status: DONE\n    result: \"r=+0.471, Δpert=+6.6%, hypothesis HOLDS on GQA\"\n\n  # ============================================================\n  # P0: Core experiments for architecture-dependent narrative\n  # ============================================================\n\n  - plan_id: llama-sparsity-sweep\n    name: \"Llama sparsity level sweep: push Δpert higher\"\n    claim: \"Claim 1, 3 (strengthen GQA positive evidence)\"\n    priority: P0\n    description: |\n      Test higher sparsity on Llama: {50%, 55%, 60%, 65%, 70%}.\n      Current Δpert=+6.6% at 55%. Higher sparsity may widen the gap\n      between redundant and novel tokens.\n    model: \"meta-llama/Llama-3.1-8B-Instruct\"\n    gpu_hours: 4\n    depends_on: [neg-cross-model-001]\n    status: PLANNED\n\n  - plan_id: llama-layer-analysis\n    name: \"Llama per-layer r + Δpert decomposition\"\n    claim: \"Claim 3 (per-layer architecture comparison)\"\n    priority: P0\n    description: |\n      Per-layer analysis on Llama data (from neg-cross-model-001).\n      Compare with DeepSeek per-layer profile.\n      Key question: do all layers show positive signal on GQA, or concentrated?\n    gpu_hours: 1\n    depends_on: [neg-cross-model-001]\n    status: PLANNED\n\n  - plan_id: kv-bench-001\n    registry_id: kv-bench-001\n    name: \"KV eviction benchmark: CARC-KV vs baselines\"\n    claim: \"Claim 4 (O(1) KV eviction)\"\n    priority: P0\n    description: |\n      CARC-KV (O(1)) vs H2O (O(n)) vs SnapKV vs StreamingLLM.\n      KV budgets {30%, 50%, 70%}. Eval: perplexity + accuracy.\n    model: \"deepseek-ai/DeepSeek-R1-Distill-Qwen-7B\"\n    gpu_hours: 20\n    depends_on: []\n    status: PREPARING\n\n  # ============================================================\n  # P1: Strengthen architecture-dependence narrative\n  # ============================================================\n\n  - plan_id: cross-arch-mistral\n    name: \"Mistral-7B validation (2nd GQA model)\"\n    claim: \"Claim 1 (GQA generalization)\"\n    priority: P1\n    description: |\n      Repeat validation on Mistral-7B-Instruct (standard GQA).\n      Confirms GQA positive is not Llama-specific.\n    model: \"mistralai/Mistral-7B-Instruct-v0.3\"\n    gpu_hours: 6\n    depends_on: [neg-cross-model-001]\n    status: PLANNED\n\n  - plan_id: mla-signal-analysis\n    name: \"MLA latent space semantic fidelity analysis\"\n    claim: \"Claim 2 (mechanistic: why MLA breaks signal)\"\n    priority: P1\n    description: |\n      Analyze MLA latent compression:\n      - Compare angular distribution of KV vectors in MLA vs GQA\n      - Measure information loss from MLA's low-rank projection\n      - Correlate latent dimension with r degradation\n    gpu_hours: 4\n    depends_on: [mvp-001b, neg-cross-model-001]\n    status: PLANNED\n\n  - plan_id: kv-eviction-wallclock\n    name: \"Wall-clock: O(1) vs O(n) eviction cost\"\n    claim: \"Claim 4\"\n    priority: P1\n    description: |\n      Eviction overhead timing at L={4K, 8K, 16K, 32K}.\n      CARC-KV O(1) vs H2O O(n).\n    gpu_hours: 10\n    depends_on: [kv-bench-001]\n    status: PLANNED\n\n  - plan_id: neg-per-head\n    name: \"Per-head KV contribution analysis\"\n    claim: \"Claim 2, 3 (is it just head count 4 vs 8?)\"\n    priority: P1\n    description: |\n      Normalize per-head signal contribution.\n      DeepSeek: 4 KV heads, Llama: 8 KV heads.\n      Test: even per-head, does GQA show stronger signal?\n    gpu_hours: 2\n    depends_on: [mvp-001b, neg-cross-model-001]\n    status: PLANNED\n\n  # ============================================================\n  # P2: Extensions\n  # ============================================================\n\n  - plan_id: kv-eviction-ablation\n    name: \"KV eviction: key-only vs key+value anchor\"\n    claim: \"Claim 4\"\n    priority: P2\n    gpu_hours: 5\n    depends_on: [kv-bench-001]\n    status: PLANNED\n\n  - plan_id: llama-downstream\n    name: \"Llama two-tier sparsity downstream accuracy\"\n    claim: \"Claim 1 (practical value of cross-axis on GQA)\"\n    priority: P2\n    description: |\n      Apply CARC two-tier MLP sparsity on Llama: 55% redundant / 40% novel.\n      Compare accuracy vs uniform sparsity on MATH problems.\n    gpu_hours: 6\n    depends_on: [llama-sparsity-sweep]\n    status: PLANNED\n\n# ============================================================\n# Timeline (12-day sprint, 5/12 → 5/25)\n# ============================================================\n# Day 1 (5/12): llama-sparsity-sweep + llama-layer-analysis (CPU)\n# Day 1-3: kv-bench-001 (parallel after sparsity sweep)\n# Day 2-4: cross-arch-mistral (download + run)\n# Day 3-5: mla-signal-analysis + neg-per-head\n# Day 4-7: kv-eviction-wallclock\n# Day 6-12: paper writing (parallel with P2)\n","numLines":164,"startLine":1,"totalLines":164}}}
