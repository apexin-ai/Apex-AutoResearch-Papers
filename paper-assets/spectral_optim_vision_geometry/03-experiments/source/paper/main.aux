\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Per-layer stable rank divergence ($\Delta \mathrm  {sr}_l$) vs.\ Muon benefit ($\Delta a_l$). ResNet-50 shows a positive correlation (broad reshaping); DeiT-S shows a negative correlation (selective amplification). Dashed lines: OLS fit; shading: 95\% CI. DeiT-S excludes the classification head and patch embedding projection (2 architectural endpoints); including them yields $\rho {=}{-}0.36$ ($p{=}0.010$), preserving the sign reversal.}}{7}{figure.3}\protected@file@percent }
\newlabel{fig:sign_reversal}{{3}{7}{Per-layer stable rank divergence ($\Delta \mathrm {sr}_l$) vs.\ Muon benefit ($\Delta a_l$). ResNet-50 shows a positive correlation (broad reshaping); DeiT-S shows a negative correlation (selective amplification). Dashed lines: OLS fit; shading: 95\% CI. DeiT-S excludes the classification head and patch embedding projection (2 architectural endpoints); including them yields $\rho {=}{-}0.36$ ($p{=}0.010$), preserving the sign reversal}{figure.3}{}}
