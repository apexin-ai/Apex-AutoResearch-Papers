\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Best validation accuracy (\%) at 20 epochs. Multi-seed results ($\pm $ std) where available; $^\dagger $single-seed (seed\,=\,42). Bold = best per column. Gap = best spectral $-$ AdamW in pp. $^\ddagger $Muon$-$AdamW only (SOAP/Shampoo evaluated on CIFAR-100 only). Significance: Welch's $t$-test with Holm--Bonferroni correction across 2--4 seeds. $^{*}p<0.05$, $^{**}p<0.01$, $^{***}p<0.001$. For Tiny-ImageNet and ImageNet-100, where only Muon is evaluated among spectral methods, the gap is Muon$-$AdamW.}}{6}{table.1}\protected@file@percent }
\newlabel{tab:main_results}{{1}{6}{Best validation accuracy (\%) at 20 epochs. Multi-seed results ($\pm $ std) where available; $^\dagger $single-seed (seed\,=\,42). Bold = best per column. Gap = best spectral $-$ AdamW in pp. $^\ddagger $Muon$-$AdamW only (SOAP/Shampoo evaluated on CIFAR-100 only). Significance: Welch's $t$-test with Holm--Bonferroni correction across 2--4 seeds. $^{*}p<0.05$, $^{**}p<0.01$, $^{***}p<0.001$. For Tiny-ImageNet and ImageNet-100, where only Muon is evaluated among spectral methods, the gap is Muon$-$AdamW}{table.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Temporal persistence and mechanistic basis of the spectral advantage. (a) Muon-AdamW gap narrows on CNNs but persists on DeiT-S, revealing convergence-speed vs.\ solution-quality mechanisms. (b) On ResNet-50, stable-rank divergence correlates with weight-swap accuracy impact ($\rho = +0.58$, $p = 3.6 \times 10^{-6}$), indicating broad spectral reshaping across layers.}}{6}{figure.2}\protected@file@percent }
\newlabel{fig:gap_evolution}{{2}{6}{Temporal persistence and mechanistic basis of the spectral advantage. (a) Muon-AdamW gap narrows on CNNs but persists on DeiT-S, revealing convergence-speed vs.\ solution-quality mechanisms. (b) On ResNet-50, stable-rank divergence correlates with weight-swap accuracy impact ($\rho = +0.58$, $p = 3.6 \times 10^{-6}$), indicating broad spectral reshaping across layers}{figure.2}{}}
\newlabel{fig:sign_reversal}{{2}{6}{Temporal persistence and mechanistic basis of the spectral advantage. (a) Muon-AdamW gap narrows on CNNs but persists on DeiT-S, revealing convergence-speed vs.\ solution-quality mechanisms. (b) On ResNet-50, stable-rank divergence correlates with weight-swap accuracy impact ($\rho = +0.58$, $p = 3.6 \times 10^{-6}$), indicating broad spectral reshaping across layers}{figure.2}{}}
\newlabel{fig:combined_gap_spectral}{{2}{6}{Temporal persistence and mechanistic basis of the spectral advantage. (a) Muon-AdamW gap narrows on CNNs but persists on DeiT-S, revealing convergence-speed vs.\ solution-quality mechanisms. (b) On ResNet-50, stable-rank divergence correlates with weight-swap accuracy impact ($\rho = +0.58$, $p = 3.6 \times 10^{-6}$), indicating broad spectral reshaping across layers}{figure.2}{}}
