\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Gap decomposition from 20 to 50 epochs (best validation accuracy throughout). $\Delta $Gap${}={}$50ep gap$-$20ep gap. Superscripts denote seed count: $^{(k)}$ = $k$-seed mean; $^\dagger $ = single seed (seed\,=\,42). IN100 AdamW seed\,=\,42 used $\text  {lr}{=}3{\times }10^{-4}$ (vs.\ $3{\times }10^{-3}$ for other seeds); a verification run confirmed identical accuracy at both rates. All gaps are Muon $-$ AdamW.}}{7}{table.2}\protected@file@percent }
\newlabel{tab:gap_narrowing}{{2}{7}{Gap decomposition from 20 to 50 epochs (best validation accuracy throughout). $\Delta $Gap${}={}$50ep gap$-$20ep gap. Superscripts denote seed count: $^{(k)}$ = $k$-seed mean; $^\dagger $ = single seed (seed\,=\,42). IN100 AdamW seed\,=\,42 used $\text {lr}{=}3{\times }10^{-4}$ (vs.\ $3{\times }10^{-3}$ for other seeds); a verification run confirmed identical accuracy at both rates. All gaps are Muon $-$ AdamW}{table.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces (a) Normalization-swap experiment on ResNet-50: replacing BatchNorm with LayerNorm collapses AdamW by ${\sim }17$\,pp and SGD degrades catastrophically (28.87\%, a $-40.6$ pp drop from BN), while Muon is preserved (+1.64\,pp). (b) Training recipe robustness: enhanced augmentation produces differential optimizer response across architectures, where Muon gains while AdamW is flat or declines.}}{7}{figure.3}\protected@file@percent }
\newlabel{fig:norm_recipe}{{3}{7}{(a) Normalization-swap experiment on ResNet-50: replacing BatchNorm with LayerNorm collapses AdamW by ${\sim }17$\,pp and SGD degrades catastrophically (28.87\%, a $-40.6$ pp drop from BN), while Muon is preserved (+1.64\,pp). (b) Training recipe robustness: enhanced augmentation produces differential optimizer response across architectures, where Muon gains while AdamW is flat or declines}{figure.3}{}}
\newlabel{fig:sgd_failure}{{3}{7}{(a) Normalization-swap experiment on ResNet-50: replacing BatchNorm with LayerNorm collapses AdamW by ${\sim }17$\,pp and SGD degrades catastrophically (28.87\%, a $-40.6$ pp drop from BN), while Muon is preserved (+1.64\,pp). (b) Training recipe robustness: enhanced augmentation produces differential optimizer response across architectures, where Muon gains while AdamW is flat or declines}{figure.3}{}}
\newlabel{fig:enhanced_recipe}{{3}{7}{(a) Normalization-swap experiment on ResNet-50: replacing BatchNorm with LayerNorm collapses AdamW by ${\sim }17$\,pp and SGD degrades catastrophically (28.87\%, a $-40.6$ pp drop from BN), while Muon is preserved (+1.64\,pp). (b) Training recipe robustness: enhanced augmentation produces differential optimizer response across architectures, where Muon gains while AdamW is flat or declines}{figure.3}{}}
