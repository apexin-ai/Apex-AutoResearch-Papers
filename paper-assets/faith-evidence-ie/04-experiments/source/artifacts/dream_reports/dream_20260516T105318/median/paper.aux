\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Decoupling spectrum across optimization methods. As RL optimization pressure increases, rel\_F1 degrades while evi\_F1 is maintained or improves, producing rising EDCR. QLoRA amplifies decoupling to catastrophic levels. The pattern replicates on LLaMA-3.1-8B.}}{5}{table.caption.17}\protected@file@percent }
\newlabel{tab:spectrum}{{2}{5}{Decoupling spectrum across optimization methods. As RL optimization pressure increases, rel\_F1 degrades while evi\_F1 is maintained or improves, producing rising EDCR. QLoRA amplifies decoupling to catastrophic levels. The pattern replicates on LLaMA-3.1-8B}{table.caption.17}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces NLI scoring ablation on dev set (5 seeds, mean$\pm $std). CED and flat-NLI are statistically indistinguishable ($p$=0.31). Both substantially improve over SFT ($\sim $+5pp). Top-$k$=3 degrades by $-$1.36pp vs.\ $k$=1, indicating that scoring \emph  {precision} matters more than training set size. Top-$k$=3 row is a single seed.}}{5}{table.caption.18}\protected@file@percent }
\newlabel{tab:scoring}{{3}{5}{NLI scoring ablation on dev set (5 seeds, mean$\pm $std). CED and flat-NLI are statistically indistinguishable ($p$=0.31). Both substantially improve over SFT ($\sim $+5pp). Top-$k$=3 degrades by $-$1.36pp vs.\ $k$=1, indicating that scoring \emph {precision} matters more than training set size. Top-$k$=3 row is a single seed}{table.caption.18}{}}
