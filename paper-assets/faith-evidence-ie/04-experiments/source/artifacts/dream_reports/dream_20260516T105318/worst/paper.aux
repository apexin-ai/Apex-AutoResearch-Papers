\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Decoupling spectrum on Qwen3-4B (DocRED dev). GRPO QLoRA achieves the highest evidence quality (Evi-F1=85.0) but catastrophic extraction collapse (rel\_f1=0.014). RSFT is the only paradigm that improves both extraction and evidence without decoupling. DPO shows gradual degradation from 1 to 3 epochs (rel\_f1: 0.40$\to $0.34).}}{5}{table.3}\protected@file@percent }
\newlabel{tab:decoupling}{{3}{5}{Decoupling spectrum on Qwen3-4B (DocRED dev). GRPO QLoRA achieves the highest evidence quality (Evi-F1=85.0) but catastrophic extraction collapse (rel\_f1=0.014). RSFT is the only paradigm that improves both extraction and evidence without decoupling. DPO shows gradual degradation from 1 to 3 epochs (rel\_f1: 0.40$\to $0.34)}{table.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Evidence tax (No-Evi Ign-F1 minus SFT Ign-F1) and RSFT improvement across Qwen3 model scales (DocRED dev). All values are Ign-F1. The 4B model exhibits an anomalously high tax (7.0pp) compared to 1.7B (1.1pp) and 8B (1.5pp).}}{5}{table.4}\protected@file@percent }
\newlabel{tab:model_scale}{{4}{5}{Evidence tax (No-Evi Ign-F1 minus SFT Ign-F1) and RSFT improvement across Qwen3 model scales (DocRED dev). All values are Ign-F1. The 4B model exhibits an anomalously high tax (7.0pp) compared to 1.7B (1.1pp) and 8B (1.5pp)}{table.4}{}}
