issues:
  # ============================================================
  # Round 1-2 历史 issues（保留完整记录）
  # ============================================================
  - id: R1-N1
    summary: "EDD 公式 (Eq.1) 存在系统性 off-by-one 错误，公式输出值比全文报告值小 1"
    category: method
    severity: critical
    status: resolved
    first_raised_round: 1
    last_seen_round: 1
    mentions:
      - round: 1
        reviewers: [1, 2]
        note: "R1 发现，R2 独立验证确认。Eq.1 定义 EDD_T=max{d*:AUC(d*,d*+1)>=T}，Pythia nucleus d0-d5 T=0.75 时公式得 3 但报告 4。Table 3 所有行均差 1。需修正公式为 max{d*+1:...} 或全文数值下调 1。"
    action_items:
      - round: 1
        action: "修正 Eq.1 公式定义为 EDD_T = max{d*+1 : AUC(d*,d*+1)>=T}，报告值不变"
        assigned_to: paper_agent
        status: done
    resolution: "method.tex Eq.1 已修正为 max{d*+1:...}，报告值不变。"
    resolution_round: 2

  - id: R1-N2
    summary: "主实验 Table 1/2 无 std/CI/significance test，无法判断方法间差异是否显著"
    category: experiment
    severity: critical
    status: resolved
    first_raised_round: 1
    last_seen_round: 1
    mentions:
      - round: 1
        reviewers: [1, 2]
        note: "R1 列为 critical，R2 同意但建议分两级：Table 1 加 fold-level std (must-fix)，Table 2 方法间 significance test (should-fix)。5-fold CV 天然产生 fold estimates，报告 mean±std 成本为零。"
    action_items:
      - round: 1
        action: "修改 atlas_v2_analysis.py 保存 fold-level metrics，重跑 9 cell，Table 1/2 加 ±std"
        assigned_to: main_agent
        status: done
    resolution: "数据+叙事全部完成。fold std + bootstrap + Paper Agent D022 patch 均已落地。"
    resolution_round: 1

  - id: R1-N3
    summary: "DCOL negative result 证据不足：仅 1 架构 6 配置（5 个失败），不足以支撑 end-to-end 方法劣于特征工程的结论"
    category: experiment
    severity: critical
    status: resolved
    first_raised_round: 1
    last_seen_round: 1
    mentions:
      - round: 1
        reviewers: [1, 2]
        note: "两位 Reviewer 独立发现并达成完全共识。补充简单 end-to-end baselines 或弱化结论。"
    action_items:
      - round: 1
        action: "补充 DeBERTa-v3-base + RoBERTa-base 直接 finetune 4-class baseline"
        assigned_to: main_agent
        status: done
    resolution: "双 backbone (DeBERTa 58.3%, RoBERTa 59.5%) 均远低于 RF 78.2%，差距 ~19pp。论文已全面更新。"
    resolution_round: 2

  - id: R2-N2
    summary: "Mohamed et al. (ACL 2025) 'LLM as a Broken Telephone' 高度相关但未讨论"
    category: writing
    severity: critical
    status: resolved
    first_raised_round: 1
    last_seen_round: 1
    mentions:
      - round: 1
        reviewers: [1, 2]
        note: "R2 发现，R1 同意。同时恢复 dohmatob2024 两篇和 cloc2025 的引用。"
    action_items:
      - round: 1
        action: "恢复 bib 条目 + Related Work 加讨论 Mohamed et al.、Dohmatob et al.、CLOC"
        assigned_to: paper_agent
        status: done
    resolution: "related_work.tex 已加入 Mohamed et al. 讨论。"
    resolution_round: 2

  - id: R1-W1
    summary: "Feature importance (Gini) 受 correlated features 影响，universality claim 可能不可靠"
    category: method
    severity: warning
    status: resolved
    first_raised_round: 1
    last_seen_round: 4
    mentions:
      - round: 1
        reviewers: [1, 2]
        note: "R1 提出，R2 同意。"
      - round: 3
        reviewers: [1, 2]
        note: "Gini vs permutation importance 交叉验证已完成。"
      - round: 4
        reviewers: [1, 2]
        note: "R4 两位 Reviewer 再次独立提出：VIF>10 for 14-16/19 features 下，Gini/SHAP/Permutation 三种方法有相似 instability pattern，concordance 不能证明稳定性。Forward selection p90_ppl 首选仅 6/9 cells。建议在 feature group level 报告 importance 或弱化 'p90_ppl AND var_surprisal emerge as universal markers' 为 'perplexity tail statistics group is universally dominant'。"
    action_items:
      - round: 1
        action: "计算 19×19 correlation matrix + permutation importance，加入 Appendix"
        assigned_to: main_agent
        status: done
      - round: 4
        action: "弱化 abstract/正文中 individual feature level 的 'universal marker' 表述为 feature group level dominant；或补充 conditional permutation importance"
        assigned_to: paper_agent
        status: open
    resolution: ""
    resolution_round: null

  - id: R1-W2
    summary: "Wikipedia seed text 引入 domain bias，d0 recall >99% 可能部分反映文体特征"
    category: experiment
    severity: warning
    status: in_progress
    first_raised_round: 1
    last_seen_round: 4
    mentions:
      - round: 1
        reviewers: [1, 2]
        note: "3-class accuracy 缓解部分担忧。"
      - round: 3
        reviewers: [1, 2]
        note: "R3 两位 Reviewer 再次独立提出 d0 inflation 问题。"
      - round: 4
        reviewers: [1, 2]
        note: "R4 再次确认 d0 inflation 是持续问题——cross-model 66.4% 中 d0 recall=99.3%，排除 d0 后 d1-d3 balanced acc = 55.4% (仅 1.66× chance)。Abstract 虽有括号注释但 transfer results 仍缺 qualification。"
    action_items:
      - round: 3
        action: "Sub-B LOGO bug 修复"
        assigned_to: main_agent
        status: in_progress
      - round: 4
        action: "Abstract 和正文 transfer results 处对 d0-excluded metrics 加更醒目的 qualification（不仅是括号）"
        assigned_to: paper_agent
        status: open
    resolution: ""
    resolution_round: null

  - id: R1-W3
    summary: "LoRA 参数缺乏选择依据和 sensitivity analysis"
    category: experiment
    severity: warning
    status: resolved
    first_raised_round: 1
    last_seen_round: 1
    mentions:
      - round: 1
        reviewers: [1, 2]
        note: "添加标准参数引用即可。"
    action_items:
      - round: 1
        action: "method.tex 加 LoRA 参数依据引用 Hu et al. 2022"
        assigned_to: paper_agent
        status: done
    resolution: "method.tex 已加引用依据。"
    resolution_round: 2

  - id: R1-W4
    summary: "Zero-shot LLM baseline 仅 200 samples，CI 宽"
    category: experiment
    severity: warning
    status: in_progress
    first_raised_round: 1
    last_seen_round: 4
    mentions:
      - round: 1
        reviewers: [1, 2]
        note: "差距 38pp >> CI 6.8pp，统计上足以区分。"
      - round: 3
        reviewers: [1, 2]
        note: "额外指出 prompt 设计未报告、仅一个 LLM baseline。"
      - round: 4
        reviewers: [1, 2]
        note: "R4 升级为 structural unfairness 问题——LLM 无法访问 perplexity feature space，对比方法论不成立。Sample size 已扩展到 500 (CI ≈ 4pp)，但核心问题是公平性而非统计功效。"
    action_items:
      - round: 3
        action: "zeroshot_llm_500_001 已审批执行，扩展到 500 samples"
        assigned_to: main_agent
        status: in_progress
      - round: 4
        action: "重新定位 LLM baseline 为 'surface-level feature upper bound'——论证 raw text alone 不含 depth signal，必须经过 reference model 映射"
        assigned_to: paper_agent
        status: open
    resolution: ""
    resolution_round: null

  - id: R1-W5
    summary: "5-fold CV 未说明是否按 passage lineage 分组，存在数据泄漏风险"
