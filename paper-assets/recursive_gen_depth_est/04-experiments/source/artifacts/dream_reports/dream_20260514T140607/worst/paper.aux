\newlabel{tab:baselines}{{5}{6}{6-class depth estimation accuracy across methods. DCOL ranks first but does not significantly outperform CORAL ($p=0.12$, McNemar's test). The 2--3~pp spread among top methods (DCOL, feature RF, CORAL, CE) is consistent with a signal bottleneck rather than a methodology bottleneck}{table.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces DCOL component ablation. Removing all three text-specific modifications reduces accuracy to the CORAL level (40\%), confirming that DCOL's advantage is composed of small, partially redundant effects.}}{6}{table.6}\protected@file@percent }
\newlabel{tab:ablation}{{6}{6}{DCOL component ablation. Removing all three text-specific modifications reduces accuracy to the CORAL level (40\%), confirming that DCOL's advantage is composed of small, partially redundant effects}{table.6}{}}
