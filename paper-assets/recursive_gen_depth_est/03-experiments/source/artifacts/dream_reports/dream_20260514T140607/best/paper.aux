\@writefile{lot}{\contentsline {table}{\numberline {13}{\ignorespaces Correlation between DCOL{} predicted depth and quality proxies on unlabeled wild data. The significant partial correlation ($\rho = -0.198$) confirms that depth captures quality dimensions beyond perplexity alone.}}{10}{table.caption.22}\protected@file@percent }
