\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Confusion matrix for 4-class depth estimation on Qwen2.5-14B (nucleus, RF). Depth 0 is near-perfectly identified (recall = 0.985). The primary confusion occurs between adjacent depths ($d_1$/$d_2$ and $d_2$/$d_3$), consistent with the monotonic decay in inter-depth discriminability. Depth 2 has the lowest recall (0.58), squeezed between neighboring depth distributions.}}{10}{figure.caption.18}\protected@file@percent }
\newlabel{fig:confusion}{{3}{10}{Confusion matrix for 4-class depth estimation on Qwen2.5-14B (nucleus, RF). Depth 0 is near-perfectly identified (recall = 0.985). The primary confusion occurs between adjacent depths ($d_1$/$d_2$ and $d_2$/$d_3$), consistent with the monotonic decay in inter-depth discriminability. Depth 2 has the lowest recall (0.58), squeezed between neighboring depth distributions}{figure.caption.18}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Atlas heatmap: feature trajectory direction and magnitude across strategies (1B models, aggregated). Arrows indicate the direction of feature change from $d_1 \to d_2$. $\downarrow $: features decrease with depth (expected). ``rev'' cells: temperature reverses the $d_1 \to d_2$ trajectory for mean perplexity and bigram entropy, the root cause of cross-strategy transfer failure.}}{10}{figure.caption.19}\protected@file@percent }
\newlabel{fig:atlas_heatmap}{{4}{10}{Atlas heatmap: feature trajectory direction and magnitude across strategies (1B models, aggregated). Arrows indicate the direction of feature change from $d_1 \to d_2$. $\downarrow $: features decrease with depth (expected). ``rev'' cells: temperature reverses the $d_1 \to d_2$ trajectory for mean perplexity and bigram entropy, the root cause of cross-strategy transfer failure}{figure.caption.19}{}}
