\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces AUC decay across adjacent depth pairs for nucleus sampling. The dashed line marks the \textsc  {EDD}{} threshold $T=0.75$. AUC decays monotonically for all models. The 14B model (Qwen2.5, dashed orange) follows the same decay pattern as 1B models, confirming scale invariance. Beyond $d_4$v$d_5$, all models fall below threshold.}}{9}{figure.caption.16}\protected@file@percent }
\newlabel{fig:auc_decay}{{1}{9}{AUC decay across adjacent depth pairs for nucleus sampling. The dashed line marks the \edd {} threshold $T=0.75$. AUC decays monotonically for all models. The 14B model (Qwen2.5, dashed orange) follows the same decay pattern as 1B models, confirming scale invariance. Beyond $d_4$v$d_5$, all models fall below threshold}{figure.caption.16}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Top-5 feature importance across depths (GPT-2 XL, nucleus, RF). \texttt  {p90\_ppl} and \texttt  {var\_surprisal} consistently dominate regardless of which depth boundary is being classified. Importance decays slightly at deeper boundaries, consistent with reduced signal-to-noise as distributions converge.}}{9}{figure.caption.17}\protected@file@percent }
\newlabel{fig:feature_importance}{{2}{9}{Top-5 feature importance across depths (GPT-2 XL, nucleus, RF). \texttt {p90\_ppl} and \texttt {var\_surprisal} consistently dominate regardless of which depth boundary is being classified. Importance decays slightly at deeper boundaries, consistent with reduced signal-to-noise as distributions converge}{figure.caption.17}{}}
