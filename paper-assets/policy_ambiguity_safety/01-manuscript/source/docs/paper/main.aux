\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Experimental overview. (a)~Six-type ambiguity taxonomy (two layers) with 300 matched clause pairs. (b)~Matched-pair causal design: each clause pair is injected into $\tau ^2$-bench policy documents; five models interact under both ambiguous and unambiguous conditions across 2,997 episodes. (c)~Convergent nocuity: models independently converge on the same permissive interpretation, producing unanimous agreement that passes consensus-based safety monitors---a blind spot invisible to multi-agent checks.}}{2}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:overview}{{1}{2}{Experimental overview. (a)~Six-type ambiguity taxonomy (two layers) with 300 matched clause pairs. (b)~Matched-pair causal design: each clause pair is injected into $\tau ^2$-bench policy documents; five models interact under both ambiguous and unambiguous conditions across 2,997 episodes. (c)~Convergent nocuity: models independently converge on the same permissive interpretation, producing unanimous agreement that passes consensus-based safety monitors---a blind spot invisible to multi-agent checks}{figure.caption.1}{}}
