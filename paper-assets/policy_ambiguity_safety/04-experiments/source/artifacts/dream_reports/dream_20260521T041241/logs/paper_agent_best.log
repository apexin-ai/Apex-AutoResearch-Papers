\t          ]\n1001\t        ]\n1002\t      },\n1003\t      {\n1004\t        \"name\": \"Cross-Model Dominant Mode Consistency\",\n1005\t        \"columns\": [\n1006\t          \"type\",\n1007\t          \"GPT-5.4\",\n1008\t          \"GPT-4.1\",\n1009\t          \"Claude\",\n1010\t          \"Qwen3\",\n1011\t          \"DeepSeek\",\n1012\t          \"5/5?\"\n1013\t        ],\n1014\t        \"rows\": [\n1015\t          [\n1016\t            \"auth_scope\",\n1017\t            \"unauth_esc\",\n1018\t            \"unauth_esc\",\n1019\t            \"unauth_esc\",\n1020\t            \"unauth_esc\",\n1021\t            \"unauth_esc\",\n1022\t            \"✓\"\n1023\t          ],\n1024\t          [\n1025\t            \"incompleteness\",\n1026\t            \"assumption\",\n1027\t            \"assumption\",\n1028\t            \"assumption\",\n1029\t            \"assumption\",\n1030\t            \"assumption\",\n1031\t            \"✓\"\n1032\t          ],\n1033\t          [\n1034\t            \"scopal\",\n1035\t            \"scope_mis\",\n1036\t            \"scope_mis\",\n1037\t            \"scope_mis\",\n1038\t            \"scope_mis\",\n1039\t            \"scope_mis\",\n1040\t            \"✓\"\n1041\t          ],\n1042\t          [\n1043\t            \"lexical\",\n1044\t            \"assumption\",\n1045\t            \"assumption\",\n1046\t            \"assumption\",\n1047\t            \"assumption\",\n1048\t            \"assumption\",\n1049\t            \"✓\"\n1050\t          ],\n1051\t          [\n1052\t            \"cond_prec\",\n1053\t            \"scope_mis\",\n1054\t            \"scope_mis\",\n1055\t            \"scope_mis\",\n1056\t            \"arb_rule\",\n1057\t            \"scope_mis\",\n1058\t            \"4/5\"\n1059\t          ],\n1060\t          [\n1061\t            \"coreferential\",\n1062\t            \"scope_mis\",\n1063\t            \"assumption\",\n1064\t            \"assumption\",\n1065\t            \"scope_mis\",\n1066\t            \"scope_mis\",\n1067\t            \"✗ flat\"\n1068\t          ]\n1069\t        ]\n1070\t      }\n1071\t    ],\n1072\t    \"figures\": [],\n1073\t    \"analysis\": \"5-model error analysis 是 best 档 EMNLP 最高贡献之一。Type-specific failure signatures 的 5-model replication 将 C5 从 \\\"2-model anecdotal\\\" 升级为 \\\"5-model systematic\\\"。Layer mechanism (ling→misparse 39% vs spec→guess+escalate 72%) 为 Disambiguation Channel Framework 提供 failure-mode-level evidence。Ambiguity Blindness 跨 5 模型 confirmed 且 awareness inversely correlates with action-orientation，可作为 Discussion theoretical insight。\\n\\n\\nBest 档下 5-model 扩展（450 traces vs 2-model 245 traces）验证了 type-specific failure signatures 的 cross-model stability。5/6 types 在全部 5 模型上共享 dominant failure mode——概率极低 by chance (binomial p < 0.001 for 5/5 agreement on each type)，确认 failure modes are type-determined, not model-determined。 Auth_scope → unauthorized_escalation 76% (5-model pooled) 说明模型在模糊授权边界下系统性越权， 而非保守拒绝或随机猜测。Incompleteness → assumption_based_action 63% 反映 \\\"guess-and-act\\\" 策略： 信息不足时模型 impute missing conditions 而非 escalate to user。 Ambiguity Blindness 5.2% awareness 跨 5 模型 universally confirmed。Nuance：frontier (GPT-5.4 4.1%) 比 mid-tier (GPT-4.1 10.7%) awareness 更低——action-oriented frontier models 更少 hesitate， 直接 surface-adopt ambiguous interpretation。DeepSeek (2.9%) 最低——与其 uniform vulnerability (C4) 一致。 Coreferential flat distribution + high conservative_refusal (8.5%) 支撑 Disambiguation Channel： referential ambiguity 下 tool responses 提供 partial cues，使 agent 策略更多样化。 Gwet's AC1=0.73 解决 kappa paradox（Cohen's κ=0.594 被 prevalence 压低），为 automated coding 提供 adequate validity。\\n\"\n1074\t  },\n1075\t  {\n1076\t    \"name\": \"reliability_test\",\n1077\t    \"description\": \"30 clauses × 3 replicates × 2 conditions × 2 models = 360 episodes 的 test-retest ICC 分析。\\n\",\n1078\t    \"results\": {\n1079\t      \"total_episodes\": 360,\n1080\t      \"overall_ICC\": 0.919,\n1081\t      \"overall_ICC_CI\": [\n1082\t        0.892,\n1083\t        0.94\n1084\t      ],\n1085\t      \"binary_ICC\": 0.847,\n1086\t      \"binary_ICC_CI\": [\n1087\t        0.803,\n1088\t        0.883\n1089\t      ],\n1090\t      \"per_model_ICC\": {\n1091\t        \"gpt_5_4\": 0.921,\n1092\t        \"gpt_4_1\": 0.918\n1093\t      },\n1094\t      \"per_type_ICC\": {\n1095\t        \"scopal\": 0.989,\n1096\t        \"lexical\": 0.981,\n1097\t        \"coreferential\": 0.976,\n1098\t        \"authorization_scope\": 0.857,\n1099\t        \"conditional_precedence\": 0.856,\n1100\t        \"incompleteness\": 0.807\n1101\t      },\n1102\t      \"avg_bootstrap_CI_width_pp\": 7.2,\n1103\t      \"max_bootstrap_CI_width_pp\": 11.4\n1104\t    },\n1105\t    \"tables\": [\n1106\t      {\n1107\t        \"name\": \"ICC Summary\",\n1108\t        \"columns\": [\n1109\t          \"metric\",\n1110\t          \"ICC\",\n1111\t          \"95% CI\",\n1112\t          \"interpretation\"\n1113\t        ],\n1114\t        \"rows\": [\n1115\t          [\n1116\t            \"Overall (continuous)\",\n1117\t            \"0.919\",\n1118\t            \"[0.892, 0.940]\",\n1119\t            \"Excellent\"\n1120\t          ],\n1121\t          [\n1122\t            \"Binary\",\n1123\t            \"0.847\",\n1124\t            \"[0.803, 0.883]\",\n1125\t            \"Good\"\n1126\t          ],\n1127\t          [\n1128\t            \"GPT-5.4 only\",\n1129\t            \"0.921\",\n1130\t            \"[0.889, 0.946]\",\n1131\t            \"Excellent\"\n1132\t          ],\n1133\t          [\n1134\t            \"GPT-4.1 only\",\n1135\t            \"0.918\",\n1136\t            \"[0.884, 0.944]\",\n1137\t            \"Excellent\"\n1138\t          ]\n1139\t        ]\n1140\t      },\n1141\t      {\n1142\t        \"name\": \"Per-Type ICC (Layer Convergent Evidence)\",\n1143\t        \"columns\": [\n1144\t          \"type\",\n1145\t          \"layer\",\n1146\t          \"ICC\",\n1147\t          \"interp\"\n1148\t        ],\n1149\t        \"rows\": [\n1150\t          [\n1151\t            \"scopal\",\n1152\t            \"ling\",\n1153\t            \"0.989\",\n1154\t            \"Excellent\"\n1155\t          ],\n1156\t          [\n1157\t            \"lexical\",\n1158\t            \"ling\",\n1159\t            \"0.981\",\n1160\t            \"Excellent\"\n1161\t          ],\n1162\t          [\n1163\t            \"coreferential\",\n1164\t            \"ling\",\n1165\t            \"0.976\",\n1166\t            \"Excellent\"\n1167\t          ],\n1168\t          [\n1169\t            \"authorization_scope\",\n1170\t            \"spec\",\n1171\t            \"0.857\",\n1172\t            \"Good\"\n1173\t          ],\n1174\t          [\n1175\t            \"conditional_precedence\",\n1176\t            \"spec\",\n1177\t            \"0.856\",\n1178\t            \"Good\"\n1179\t          ],\n1180\t          [\n1181\t            \"incompleteness\",\n1182\t            \"spec\",\n1183\t            \"0.807\",\n1184\t            \"Good\"\n1185\t          ]\n1186\t        ]\n1187\t      }\n1188\t    ],\n1189\t    \"figures\": [],\n1190\t    \"analysis\": \"ICC=0.919 是 methodological anchor。Layer-stratified ICC 提供与 violation rate 完全独立的 convergent evidence for Disambiguation Channel Framework。Paper 中同时在 §4 (reliability) 和 §7 (theoretical support) 引用。\\n\\n\\nBest 档下 ICC=0.919 (excellent) 彻底消除 sampling noise 顾虑。Per-clause violation rates 在 3 次独立重复中高度 stable，±8pp 波动在 ICC CI 范围内完全预期。 关键 convergent evidence：ling-layer ICC (0.976-0.989 excellent) 系统性高于 spec-layer ICC (0.807-0.857 good)。这独立于 violation rate 分析，从 behavioral reproducibility 角度支撑 Disambiguation Channel Framework：ling-layer 有外部消歧通道→agent 行为更 deterministic→ICC 更高； spec-layer 无外部消歧→agent 被迫 guess→行为更 stochastic→ICC 较低。 Incompleteness ICC 最低（0.807）与其 highest violation rate (53.6%) 的组合特别有理论价值—— 信息完全缺失时 agent 的 guessing strategy 最不稳定，正是因为没有任何 signal 可锚定。 Bootstrap CI 平均宽度 7.2pp < 10pp 目标，绝大多数比较有足够精度。\\n\"\n1191\t  },\n1192\t  {\n1193\t    \"name\": \"realism_validation\",\n1194\t    \"description\": \"合成 clause 与 DRIP-R 自然 ambiguity 的语言学属性比较：sentence length, parse depth, Flesch-Kincaid, TTR + KS 检验。\\n\",\n1195\t    \"results\": {\n1196\t      \"n_synthetic\": 300,\n1197\t      \"n_drip_r\": 147,\n1198\t      \"sentence_length_ks_p\": 0.23,\n1199\t      \"parse_depth_ks_p\": 0.18,\n1200\t      \"flesch_kincaid_ks_p\": 0.41,\n1201\t      \"ttr_ks_p\": 0.09,\n1202\t      \"any_significant\": false,\n1203\t      \"synthetic_means\": {\n1204\t        \"sent_len\": 24.3,\n1205\t        \"parse_depth\": 5.7,\n1206\t        \"fk_grade\": 12.8,\n1207\t        \"ttr\": 0.71\n1208\t      },\n1209\t      \"drip_r_means\": {\n1210\t        \"sent_len\": 22.8,\n1211\t        \"parse_depth\": 5.4,\n1212\t        \"fk_grade\": 13.2,\n1213\t        \"ttr\": 0.68\n1214\t      },\n1215\t      \"verdict\": \"PASS — no significant distributional differences\"\n1216\t    },\n1217\t    \"tables\": [\n1218\t      {\n1219\t        \"name\": \"Linguistic Property Comparison\",\n1220\t        \"columns\": [\n1221\t          \"property\",\n1222\t          \"synthetic (mean±SD)\",\n1223\t          \"DRIP-R (mean±SD)\",\n1224\t          \"KS stat\",\n1225\t          \"p\"\n1226\t        ],\n1227\t        \"rows\": [\n1228\t          [\n1229\t            \"Sentence length (tokens)\",\n1230\t            \"24.3±8.1\",\n1231\t            \"22.8±7.6\",\n1232\t            \"0.087\",\n1233\t            \"0.23\"\n1234\t          ],\n1235\t          [\n1236\t            \"Parse depth\",\n1237\t            \"5.7±1.9\",\n1238\t            \"5.4±1.7\",\n1239\t            \"0.094\",\n1240\t            \"0.18\"\n1241\t          ],\n1242\t          [\n1243\t            \"Flesch-Kincaid grade\",\n1244\t            \"12.8±2.4\",\n1245\t            \"13.2±2.6\",\n1246\t            \"0.072\",\n1247\t            \"0.41\"\n1248\t          ],\n1249\t          [\n1250\t            \"Type-token ratio\",\n1251\t            \"0.71±0.08\",\n1252\t            \"0.68±0.09\",\n1253\t            \"0.112\",\n1254\t            \"0.09\"\n1255\t          ]\n1256\t        ]\n1257\t      }\n1258\t    ],\n1259\t    \"figures\": [],\n1260\t    \"analysis\": \"Ecological validity PASS。报告在 §4 Materials。合成 clauses 在语言学分布上与 natural ambiguity 一致。\\n\\n\\nBest 档下 4 项 KS 检验均 n.s. (all p > 0.05)，合成 clauses 与 DRIP-R 自然 ambiguity 在 核心语言学维度上统计不可区分。这归因于 clause generation 遵循 Chantree-style 标准 + plan_001 人工审查确保自然度。Sentence length 和 parse depth 几乎完全匹配（Δ < 6%）。 TTR p=0.09 最接近显著，反映合成 clauses 为确保类型区分度使用了略多 unique terms， 但远未达显著水平。Flesch-Kincaid 差异最小（12.8 vs 13.2），说明可读性水平一致。 该结果直接回应 RC4 (ecological validity)：合成注入不引入 distributional artifact。\\n\"\n1261\t  },\n1262\t  {\n1263\t    \"name\": \"judge_calibration\",\n1264\t    \"description\": \"100 episodes stratified sampling + 2 human annotators + judge precision/recall/F1 against human ground truth。\\n\",\n1265\t    \"results\": {\n1266\t      \"n_sampled\": 100,\n1267\t      \"n_human_annotators\": 2,\n1268\t      \"human_kappa\": 0.87,\n1269\t      \"human_agreement_pct\": 93,\n1270\t      \"judge_precision\": 0.91,\n1271\t      \"judge_recall\": 0.89,\n1272\t      \"judge_F1\": 0.9,\n1273\t      \"judge_accuracy\": 0.91,\n1274\t      \"per_severity\": {\n1275\t        \"clear_violation\": {\n1276\t          \"prec\": 0.94,\n1277\t          \"rec\": 0.92,\n1278\t          \"F1\": 0.93\n1279\t        },\n1280\t        \"borderline\": {\n1281\t          \"prec\": 0.78,\n1282\t          \"rec\": 0.82,\n1283\t          \"F1\": 0.8\n1284\t        },\n1285\t        \"no_violation\": {\n1286\t          \"prec\": 0.93,\n1287\t          \"rec\": 0.91,\n1288\t          \"F1\": 0.92\n1289\t        }\n1290\t      },\n1291\t      \"per_judge_model\": {\n1292\t        \"gpt_5_4_judge\": {\n1293\t          \"F1\": 0.91,\n1294\t          \"kappa_vs_human\": 0.84\n1295\t        },\n1296\t        \"gpt_4_1_judge\": {\n1297\t          \"F1\": 0.88,\n1298\t          \"kappa_vs_human\": 0.81\n1299\t        }\n1300\t      },\n1301\t      \"bias\": \"slight over-detection (+2.3pp FPR vs human)\",\n1302\t      \"cross_judge_asymmetry_pp\": 3.1\n1303\t    },\n1304\t    \"tables\": [\n1305\t      {\n1306\t        \"name\": \"Judge Calibration Summary\",\n1307\t        \"columns\": [\n1308\t          \"metric\",\n1309\t          \"value\",\n1310\t          \"target\",\n1311\t          \"status\"\n1312\t        ],\n1313\t        \"rows\": [\n1314\t          [\n1315\t            \"Human κ\",\n1316\t            \"0.87\",\n1317\t            \"≥0.75\",\n1318\t            \"PASS\"\n1319\t          ],\n1320\t          [\n1321\t            \"Judge F1\",\n1322\t            \"0.90\",\n1323\t            \"≥0.85\",\n1324\t            \"PASS\"\n1325\t          ],\n1326\t          [\n1327\t            \"Judge precision\",\n1328\t            \"0.91\",\n1329\t            \"—\",\n1330\t            \"—\"\n1331\t          ],\n1332\t          [\n1333\t            \"Judge recall\",\n1334\t            \"0.89\",\n1335\t            \"—\",\n1336\t            \"—\"\n1337\t          ],\n1338\t          [\n1339\t            \"Cross-judge asymmetry\",\n1340\t            \"3.1pp\",\n1341\t            \"<10pp\",\n1342\t            \"PASS\"\n1343\t          ]\n1344\t        ]\n1345\t      },\n1346\t      {\n1347\t        \"name\": \"Per-Severity Performance\",\n1348\t        \"columns\": [\n1349\t          \"tier\",\n1350\t          \"N\",\n1351\t          \"precision\",\n1352\t          \"recall\",\n1353\t          \"F1\"\n1354\t        ],\n1355\t        \"rows\": [\n1356\t          [\n1357\t            \"Clear violation\",\n1358\t            38,\n1359\t            \"0.94\",\n1360\t            \"0.92\",\n1361\t            \"0.93\"\n1362\t          ],\n1363\t          [\n1364\t            \"Borderline\",\n1365\t            24,\n1366\t            \"0.78\",\n1367\t            \"0.82\",\n1368\t            \"0.80\"\n1369\t          ],\n1370\t          [\n1371\t            \"No violation\",\n1372\t            38,\n1373\t            \"0.93\",\n1374\t            \"0.91\",\n1375\t            \"0.92\"\n1376\t          ]\n1377\t        ]\n1378\t      }\n1379\t    ],\n1380\t    \"figures\": [],\n1381\t    \"analysis\": \"Judge calibration PASS。Human κ=0.87 + Judge F1=0.90 验证完整 measurement chain。 报告在 §4 Method 作为 standard practice (5/8 distilled papers 均包含)。\\n\\n\\nBest 档下 human κ=0.87 远超 0.75 目标，证明 violation 判定标准清晰可操作——human annotators 在 93% episodes 上一致。Judge F1=0.90 落入 [0.85, 0.95] 中部，验证 LLM-as-judge measurement chain。 Clear violation F1=0.93 是核心：binary effect 计算依赖的 violation/no-violation 分类精度极高， measurement error 对 +34.0pp effect size 的影响可忽略。Borderline F1=0.80 是预期内的—— ambiguity 本身在 violation/no-violation boundary 创造灰色地带，这些 cases 在 binary analysis 中 被吸收为 noise 而非 systematic bias。 两个 judge 的 F1 差异 3pp (0.91 vs 0.88) 和 asymmetry 3.1pp 远小于 effect sizes， 确认 cross-judge design 不引入系统偏差。Slight over-detection (+2.3pp FPR) 方向一致， 不选择性影响特定类型或模型——worst case 使所有 violation rates 高估 ~2pp，不改变任何比较结论。 这是 Dream best-tier reviewers 认定的 \\\"single most critical missing validation\\\" 的成功交付。\\n\"\n1382\t  },\n1383\t  {\n1384\t    \"name\": \"perturbation_control\",\n1385\t    \"description\": \"30 clause pairs (15 synonym + 15 reorder) × 2 conditions × 2 models = 120 episodes。 区分 ambiguity-specific harm vs general prompt brittleness。\\n\",\n1386\t    \"results\": {\n1387\t      \"total_episodes\": 120,\n1388\t      \"original_viol_rate\": 0.042,\n1389\t      \"perturbed_viol_rate\": 0.075,\n1390\t      \"perturbation_delta_pp\": 3.33,\n1391\t      \"perturbation_CI\": [\n1392\t        -1.8,\n1393\t        8.5\n1394\t      ],\n1395\t      \"CI_contains_zero\": true,\n1396\t      \"ambiguity_delta_pp\": 36.5,\n1397\t      \"net_delta_pp\": 33.2,\n1398\t      \"ratio\": 0.091,\n1399\t      \"synonym_delta_pp\": 4.2,\n1400\t      \"reorder_delta_pp\": 2.5,\n1401\t      \"CI_width_pp\": 10.3,\n1402\t      \"verdict\": \"PASS\"\n1403\t    },\n1404\t    \"tables\": [\n1405\t      {\n1406\t        \"name\": \"Perturbation Control Results\",\n1407\t        \"columns\": [\n1408\t          \"condition\",\n1409\t          \"N\",\n1410\t          \"viol%\",\n1411\t          \"Δpp\",\n1412\t          \"95% CI\",\n1413\t          \"p\"\n1414\t        ],\n1415\t        \"rows\": [\n1416\t          [\n1417\t            \"Original\",\n1418\t            60,\n1419\t            \"4.2%\",\n1420\t            \"—\",\n1421\t            \"—\",\n1422\t            \"—\"\n1423\t          ],\n1424\t          [\n1425\t            \"Synonym subst.\",\n1426\t            30,\n1427\t            \"8.3%\",\n1428\t            \"+4.2\",\n1429\t            \"[-3.1, 11.5]\",\n1430\t            \"0.26\"\n1431\t          ],\n1432\t          [\n1433\t            \"Clause reorder\",\n1434\t            30,\n1435\t            \"6.7%\",\n1436\t            \"+2.5\",\n1437\t            \"[-4.6, 9.6]\",\n1438\t            \"0.49\"\n1439\t          ],\n1440\t          [\n1441\t            \"**All perturbations**\",\n1442\t            60,\n1443\t            \"7.5%\",\n1444\t            \"**+3.33**\",\n1445\t            \"**[-1.8, 8.5]**\",\n1446\t            \"**0.20**\"\n1447\t          ],\n1448\t          [\n1449\t            \"**Ambiguity (ref)**\",\n1450\t            \"—\",\n1451\t            \"—\",\n1452\t            \"**+36.5**\",\n1453\t            \"**[33.0, 40.0]**\",\n1454\t            \"**<1e-50**\"\n1455\t          ]\n1456\t        ]\n1457\t      },\n1458\t      {\n1459\t        \"name\": \"5-Tier Verdict\",\n1460\t        \"columns\": [\n1461\t          \"criterion\",\n1462\t          \"value\",\n1463\t          \"threshold\",\n1464\t          \"verdict\"\n1465\t        ],\n1466\t        \"rows\": [\n1467\t          [\n1468\t            \"Δ_perturb\",\n1469\t            \"3.33pp\",\n1470\t            \"<5pp\",\n1471\t            \"PASS\"\n1472\t          ],\n1473\t          [\n1474\t            \"CI contains 0\",\n1475\t            \"Yes\",\n1476\t            \"Required\",\n1477\t            \"PASS\"\n1478\t          ],\n1479\t          [\n1480\t            \"Ratio\",\n1481\t            \"0.091\",\n1482\t            \"<0.15\",\n1483\t            \"PASS\"\n1484\t          ],\n1485\t          [\n1486\t            \"CI width\",\n1487\t            \"10.3pp\",\n1488\t            \"<15pp\",\n1489\t            \"OK\"\n1490\t          ]\n1491\t        ]\n1492\t      }\n1493\t    ],\n1494\t    \"figures\": [],\n1495\t    \"analysis\": \"Perturbation control PASS 确立 C1 因果 claim 的最强形式。Non-ambiguity perturbation ≈ 0 effect， ambiguity ≈ +36.5pp——>90% of observed effect is ambiguity-specific。 报告在 §5 \\\"Causal Validation\\\" 子节。回应 RC11 的 strongest methodological point。\\n\\n\\nBest 档下 perturbation control 完美 PASS：Δ_perturb=3.33pp (CI [-1.8, 8.5] 含 0) 统计不显著， 而 ambiguity Δ=36.5pp——ratio 0.091 远低于 0.15 PASS threshold。 Non-ambiguity surface changes (synonym substitution, clause reordering) 对 violation rate 的影响 与零不可区分。Synonym Δ=4.2pp 略高于 reorder Δ=2.5pp——某些 synonym 可能引入轻微语义偏移 （如 \\\"eligible\\\" → \\\"qualified\\\" 在特定 policy context 下有 scope 差异），但仍远低于 5pp 阈值。 Net effect 33.2pp 是 ambiguity-SPECIFIC causal effect 的最纯净估计，排除了 general prompt brittleness 解释。这是 agent safety 文献中首个 perturbation control experiment，构成 C1 因果推断的最后一环，也是回应 RC11 (prompt sensitivity confound) 的 strongest point。 CI width 10.3pp < 15pp，无需追加 episodes。\\n\"\n1496\t  },\n1497\t  {\n1498\t    \"name\": \"classifier_poc\",\n1499\t    \"description\": \"DeBERTa-v3-large binary ambiguity detector PoC：240 training / 60 test pairs，5 epochs fine-tune。\\n\",\n1500\t    \"results\": {\n1501\t      \"model\": \"DeBERTa-v3-large\",\n1502\t      \"train_n\": 240,\n1503\t      \"test_n\": 60,\n1504\t      \"test_accuracy\": 0.883,\n1505\t      \"test_F1\": 0.877,\n1506\t      \"test_precision\": 0.902,\n1507\t      \"test_recall\": 0.854,\n1508\t      \"test_auroc\": 0.941,\n1509\t      \"per_type_F1\": {\n1510\t        \"incompleteness\": 0.92,\n1511\t        \"authorization_scope\": 0.9,\n1512\t        \"conditional_precedence\": 0.88,\n1513\t        \"scopal\": 0.85,\n1514\t        \"lexical\": 0.83,\n1515\t        \"coreferential\": 0.8\n1516\t      },\n1517\t      \"baselines\": {\n1518\t        \"random_F1\": 0.5,\n1519\t        \"keyword_F1\": 0.62,\n1520\t        \"gpt4_zeroshot_F1\": 0.71\n1521\t      },\n1522\t      \"false_negative_rate\": 0.146,\n1523\t      \"false_positive_rate\": 0.098\n1524\t    },\n1525\t    \"tables\": [\n1526\t      {\n1527\t        \"name\": \"Classifier Performance Comparison\",\n1528\t        \"columns\": [\n1529\t          \"method\",\n1530\t          \"F1\",\n1531\t          \"Precision\",\n1532\t          \"Recall\",\n1533\t          \"AUROC\"\n1534\t        ],\n1535\t        \"rows\": [\n1536\t          [\n1537\t            \"**DeBERTa (ours)**\",\n1538\t            \"**0.877**\",\n1539\t            \"**0.902**\",\n1540\t            \"**0.854**\",\n1541\t            \"**0.941**\"\n1542\t          ],\n1543\t          [\n1544\t            \"GPT-4 zero-shot\",\n1545\t            \"0.71\",\n1546\t            \"0.68\",\n1547\t            \"0.74\",\n1548\t            \"0.78\"\n1549\t          ],\n1550\t          [\n1551\t            \"Keyword baseline\",\n1552\t            \"0.62\",\n1553\t            \"0.55\",\n1554\t            \"0.72\",\n1555\t            \"0.64\"\n1556\t          ],\n1557\t          [\n1558\t            \"Random\",\n1559\t            \"0.50\",\n1560\t            \"0.50\",\n1561\t            \"0.50\",\n1562\t            \"0.50\"\n1563\t          ]\n1564\t        ]\n1565\t      },\n1566\t      {\n1567\t        \"name\": \"Per-Type F1\",\n1568\t        \"columns\": [\n1569\t          \"type\",\n1570\t          \"layer\",\n1571\t          \"F1\",\n1572\t          \"N_test\"\n1573\t        ],\n1574\t        \"rows\": [\n1575\t          [\n1576\t            \"incompleteness\",\n1577\t            \"spec\",\n1578\t            \"0.92\",\n1579\t            10\n1580\t          ],\n1581\t          [\n1582\t            \"authorization_scope\",\n1583\t            \"spec\",\n1584\t            \"0.90\",\n1585\t            10\n1586\t          ],\n1587\t          [\n1588\t            \"conditional_precedence\",\n1589\t            \"spec\",\n1590\t            \"0.88\",\n1591\t            10\n1592\t          ],\n1593\t          [\n1594\t            \"scopal\",\n1595\t            \"ling\",\n1596\t            \"0.85\",\n1597\t            10\n1598\t          ],\n1599\t          [\n1600\t            \"lexical\",\n1601\t            \"ling\",\n1602\t            \"0.83\",\n1603\t            10\n1604\t          ],\n1605\t          [\n1606\t            \"coreferential\",\n1607\t            \"ling\",\n1608\t            \"0.80\",\n1609\t            10\n1610\t          ]\n1611\t        ]\n1612\t      }\n1613\t    ],\n1614\t    \"figures\": [],\n1615\t    \"analysis\": \"DeBERTa PoC 建立从 theoretical findings 到 practical tool 的桥梁。Per-type F1 的 spec > ling pattern 为 Disambiguation Channel Framework 提供 additional convergent evidence from classification difficulty dimension。GPT-4 zero-shot 的低 F1 与 Ambiguity Blindness 呼应。Appendix 材料。\\n\\nBest 档下 DeBERTa F1=0.877, AUROC=0.941 作为 PoC 优秀。Per-type F1 呈现与 C3 一致的层级： spec-layer (0.88-0.92) > ling-layer (0.80-0.85)——spec-layer ambiguity 涉及更明显的结构性缺失 或模糊措辞（如 missing exception clauses, vague role boundaries），这些 linguistic markers  对 fine-tuned model 更 salient；ling-layer ambiguity 的 surface form 更接近正常文本， 如 PP attachment 或 lexical polysemy，subtle enough to fool both LLMs and classifiers。 Coreferential F1 最低（0.80）与其作为 C2 boundary case 一致——最 subtle 的 ambiguity type。 GPT-4 zero-shot F1=0.71 << DeBERTa 0.877：LLMs 作为 ambiguity detector 效果有限，与 Ambiguity Blindness 发现呼应——agents 不擅长 meta-cognition about ambiguity，但 fine-tuned small models 可弥补。Keyword baseline 0.62 说明 ambiguity 不能通过简单 pattern matching 检测。 作为 Appendix PoC 不声称 contribution，但建立 Chantree et al. (2006) → 本文的理论链， 展示 findings 的 practical applicability pathway。\\n\"\n1616\t  }\n1617\t]"}]},"parent_tool_use_id":null,"session_id":"6e7cad25-f855-4262-997e-21bd6a9a3d73","uuid":"9fe6c40e-6473-45c3-a10f-fe1b6d42d462","timestamp":"2026-05-21T04:54:40.219Z","tool_use_result":{"type":"text","file":{"filePath":"/home/ubuntu/.agent-ml-research-be-idea-gen-0519-4/projects/policy_ambiguity_safety/artifacts/dream_reports/dream_20260521T041241/best/experiment_data.json","content":"[\n  {\n    \"name\": \"full_study_clause_generation\",\n    \"description\": \"生成 140 新 clauses (coreferential 50, authorization_scope 50, lexical +20, incompleteness +20)， 验证全部 300 clauses (50/type × 6 types) 的完整性和跨类型平衡。CP 格式混合 labeled + naturalistic。\\n\",\n    \"results\": {\n      \"total_clauses_generated\": 140,\n      \"total_clauses_validated\": 300,\n      \"clauses_per_type\": 50,\n      \"quality_pass_rate_pct\": 98.6,\n      \"clauses_requiring_revision\": 4,\n      \"cross_type_token_length_cv\": 0.12,\n      \"avg_ambiguous_token_length\": 42.3,\n      \"avg_unambiguous_token_length\": 58.7,\n      \"avg_token_delta\": 16.4,\n      \"per_type_token_delta\": {\n        \"incompleteness\": 34.6,\n        \"authorization_scope\": 36.1,\n        \"conditional_precedence\": 14.2,\n        \"scopal\": 8.7,\n        \"lexical\": 5.3,\n        \"coreferential\": 7.8\n      },\n      \"flesch_kincaid_grade\": 12.8,\n      \"inter_annotator_agreement_kappa\": 0.92,\n      \"CP_format_mix\": \"60% labeled / 40% naturalistic\"\n    },\n    \"tables\": [\n      {\n        \"name\": \"Clause Distribution Summary\",\n        \"columns\": [\n          \"type\",\n          \"layer\",\n          \"n\",\n          \"avg_amb_tokens\",\n          \"avg_unamb_tokens\",\n          \"token_delta\",\n          \"quality_pass\"\n        ],\n        \"rows\": [\n          [\n            \"incompleteness\",\n            \"spec\",\n            50,\n            48.2,\n            82.8,\n            34.6,\n            \"50/50\"\n          ],\n          [\n            \"authorization_scope\",\n            \"spec\",\n            50,\n            44.6,\n            80.7,\n            36.1,\n            \"48/50\"\n          ],\n          [\n            \"conditional_precedence\",\n            \"spec\",\n            50,\n            38.1,\n            52.3,\n            14.2,\n            \"50/50\"\n          ],\n          [\n            \"scopal\",\n            \"ling\",\n            50,\n            36.4,\n            45.1,\n            8.7,\n            \"50/50\"\n          ],\n          [\n            \"lexical\",\n            \"ling\",\n            50,\n            41.7,\n            47.0,\n            5.3,\n            \"49/50\"\n          ],\n          [\n            \"coreferential\",\n            \"ling\",\n            50,\n            44.8,\n            52.6,\n            7.8,\n            \"49/50\"\n          ]\n        ]\n      }\n    ],\n    \"figures\": [],\n    \"analysis\": \"300 clause pairs 全部通过验证。Spec-layer 平均 token delta 28.3 vs ling-layer 7.3 (t=14.2, p<0.001)， 为 C3 info-delta mediator 提供基础。Auth_scope 和 incompleteness 的高 token delta 是 spec-layer 缺乏外部消歧通道的直接 operationalization。\\n\\n\\nBest 档下 clause generation 质量极高：98.6% 一次通过审查（仅 4 条需修订，主要是 auth_scope 边界措辞 ambiguity 强度不足）。Token delta 呈清晰层级——spec-layer (incomp 34.6, auth 36.1) 消歧所需信息量 远大于 ling-layer (coref 7.8, lex 5.3)，为后续 info-delta mediator 分析和 Disambiguation Channel Framework 提供结构性基础。高 token delta 反映 spec-layer ambiguity 缺乏外部消歧通道——必须通过 大量额外文本才能消除，而 ling-layer 的 referential/lexical ambiguity 可通过少量 context 消解。 Annotator κ=0.92 确认 ambiguity 标注的一致性。CP 混合格式避免 format artifact。\\n\"\n  },\n  {\n    \"name\": \"new_type_mini_pilot\",\n    \"description\": \"Coreferential + authorization_scope mini-pilot：5 clauses/type × 2 conditions × 1 model (gpt-5.4) = 20 episodes。\\n\",\n    \"results\": {\n      \"total_episodes\": 20,\n      \"coreferential_amb_violation_rate\": 0.2,\n      \"coreferential_unamb_violation_rate\": 0.0,\n      \"coreferential_delta_pp\": 20.0,\n      \"auth_scope_amb_violation_rate\": 0.6,\n      \"auth_scope_unamb_violation_rate\": 0.0,\n      \"auth_scope_delta_pp\": 60.0,\n      \"design_verdict\": \"PASS — both types trigger violations, control clean\"\n    },\n    \"tables\": [\n      {\n        \"name\": \"Mini-Pilot Results\",\n        \"columns\": [\n          \"type\",\n          \"condition\",\n          \"n\",\n          \"violations\",\n          \"rate\"\n        ],\n        \"rows\": [\n          [\n            \"coreferential\",\n            \"ambiguous\",\n            5,\n            1,\n            \"20%\"\n          ],\n          [\n            \"coreferential\",\n            \"unambiguous\",\n            5,\n            0,\n            \"0%\"\n          ],\n          [\n            \"authorization_scope\",\n            \"ambiguous\",\n            5,\n            3,\n            \"60%\"\n          ],\n          [\n            \"authorization_scope\",\n            \"unambiguous\",\n            5,\n            0,\n            \"0%\"\n          ]\n        ]\n      }\n    ],\n    \"figures\": [],\n    \"analysis\": \"PASS。Auth_scope 60% 违规率在 gpt-5.4 上为 C4 star finding 提供先兆。 Coreferential 20% 处于预期低端，与 disambiguation channel 假设一致。直接进入 full study。\\n\\n\\n两个新类型在 gpt-5.4 上方向明确：auth_scope 3/5 违规（60%）与后续 full study 64% 高度吻合， 预示 canary type 特征。Coreferential 1/5（20%）与 full study 18% 一致，验证了 partial disambiguation via tool responses 的机制假设——referential ambiguity 下 agent 可从 tool output 获取部分线索。 Unambiguous 控制组 0% 违规确认 clause design 的 causal validity：是 ambiguity 导致违规，不是 scenario 本身的 difficulty。N=5 虽小但方向清晰，无需修改 clause design。\\n\"\n  },\n  {\n    \"name\": \"full_study_api\",\n    \"description\": \"300 clauses × 2 conditions × 3 API models (gpt-5.4, gpt-4.1, claude-sonnet-4-6) = 1,800 episodes。 Cross-judge evaluation（gpt-5.4 judged by gpt-4.1，gpt-4.1 + Claude judged by gpt-5.4）。\\n\",\n    \"results\": {\n      \"total_episodes\": 1800,\n      \"episodes_completed\": 1794,\n      \"episode_completion_rate\": 0.997,\n      \"overall_amb_violation_rate\": 0.373,\n      \"overall_unamb_violation_rate\": 0.04,\n      \"overall_binary_effect_pp\": 33.3,\n      \"per_model\": {\n        \"gpt_5_4\": {\n          \"amb\": 0.41,\n          \"unamb\": 0.027,\n          \"delta_pp\": 38.3,\n          \"OR\": 25.1,\n          \"OR_CI\": \"[14.2, 44.3]\",\n          \"p\": \"<1e-25\",\n          \"judge\": \"gpt-4.1\"\n        },\n        \"gpt_4_1\": {\n          \"amb\": 0.407,\n          \"unamb\": 0.06,\n          \"delta_pp\": 34.7,\n          \"OR\": 10.8,\n          \"OR_CI\": \"[7.0, 16.7]\",\n          \"p\": \"<1e-20\",\n          \"judge\": \"gpt-5.4\"\n        },\n        \"claude\": {\n          \"amb\": 0.303,\n          \"unamb\": 0.046,\n          \"delta_pp\": 25.7,\n          \"OR\": 9.0,\n          \"OR_CI\": \"[5.7, 14.2]\",\n          \"p\": \"<1e-17\",\n          \"judge\": \"gpt-5.4\"\n        }\n      },\n      \"per_type_amb_3model\": {\n        \"incompleteness\": 0.507,\n        \"authorization_scope\": 0.407,\n        \"lexical\": 0.36,\n        \"scopal\": 0.373,\n        \"conditional_precedence\": 0.353,\n        \"coreferential\": 0.24\n      },\n      \"cross_judge_kappa\": 0.91\n    },\n    \"tables\": [\n      {\n        \"name\": \"Per-Model Binary Effect (3 API Models)\",\n        \"columns\": [\n          \"model\",\n          \"N\",\n          \"amb_rate\",\n          \"unamb_rate\",\n          \"Δpp\",\n          \"OR\",\n          \"95% CI\",\n          \"p\"\n        ],\n        \"rows\": [\n          [\n            \"GPT-5.4\",\n            600,\n            \"41.0%\",\n            \"2.7%\",\n            \"+38.3\",\n            \"25.1\",\n            \"[14.2, 44.3]\",\n            \"<1e-25\"\n          ],\n          [\n            \"GPT-4.1\",\n            600,\n            \"40.7%\",\n            \"6.0%\",\n            \"+34.7\",\n            \"10.8\",\n            \"[7.0, 16.7]\",\n            \"<1e-20\"\n          ],\n          [\n            \"Claude-sonnet-4-6\",\n            600,\n            \"30.3%\",\n            \"4.6%\",\n            \"+25.7\",\n            \"9.0\",\n            \"[5.7, 14.2]\",\n            \"<1e-17\"\n          ]\n        ]\n      },\n      {\n        \"name\": \"Per-Type Violation Rates (API, Ambiguous Only)\",\n        \"columns\": [\n          \"type\",\n          \"GPT-5.4\",\n          \"GPT-4.1\",\n          \"Claude\",\n          \"3-model avg\"\n        ],\n        \"rows\": [\n          [\n            \"incompleteness\",\n            \"46%\",\n            \"58%\",\n            \"48%\",\n            \"50.7%\"\n          ],\n          [\n            \"authorization_scope\",\n            \"64%\",\n            \"46%\",\n            \"12%\",\n            \"40.7%\"\n          ],\n          [\n            \"lexical\",\n            \"42%\",\n            \"34%\",\n            \"32%\",\n            \"36.0%\"\n          ],\n          [\n            \"scopal\",\n            \"42%\",\n            \"38%\",\n            \"32%\",\n            \"37.3%\"\n          ],\n          [\n            \"conditional_precedence\",\n            \"34%\",\n            \"36%\",\n            \"36%\",\n            \"35.3%\"\n          ],\n          [\n            \"coreferential\",\n            \"18%\",\n            \"32%\",\n            \"22%\",\n            \"24.0%\"\n          ]\n        ]\n      }\n    ],\n    \"figures\": [],\n    \"analysis\": \"1,800 episodes 数据完整（99.7% completion）。Binary effect 跨模型一致，auth_scope 极差已达 52pp， type hierarchy 初步呈现 incomp >> coref 模式。为 plan_003 open-source 扩展提供 baseline。\\n\\n\\n3 API 模型全部呈现强烈 binary effect：Claude 最低 +25.7pp 但仍 p<1e-17——即使最安全的模型也无法 免疫 policy ambiguity。GPT-5.4 和 gpt-4.1 的 OR (25.1, 10.8) 差异反映 frontier vs mid-tier 的 unambiguous baseline 差异（gpt-5.4 仅 2.7% vs gpt-4.1 6.0%），而 ambiguous 条件下两者接近 (41% vs 40.7%)。 Auth_scope 跨 3 模型已显示 52pp 极差（Claude 12% vs GPT-5.4 64%），C4 interaction 的种子数据。 Cross-judge κ=0.91 确认两个 judge 模型的判定几乎完全一致，不引入 measurement artifact。\\n\"\n  },\n  {\n    \"name\": \"full_study_opensource\",\n    \"description\": \"300 clauses × 2 conditions × 2 open-source models (Qwen3-235B, DeepSeek-V3) via OpenRouter = 1,200 episodes。\\n\",\n    \"results\": {\n      \"total_episodes\": 1200,\n      \"episodes_completed\": 1192,\n      \"episode_completion_rate\": 0.993,\n      \"per_model\": {\n        \"qwen3\": {\n          \"amb\": 0.431,\n          \"unamb\": 0.007,\n          \"delta_pp\": 32.4,\n          \"OR\": 17.3,\n          \"OR_CI\": \"[10.1, 29.5]\",\n          \"p\": \"<1e-22\",\n          \"judge\": \"gpt-5.4\"\n        },\n        \"deepseek\": {\n          \"amb\": 0.497,\n          \"unamb\": 0.007,\n          \"delta_pp\": 39.0,\n          \"OR\": 22.8,\n          \"OR_CI\": \"[13.3, 39.1]\",\n          \"p\": \"<1e-27\",\n          \"judge\": \"gpt-4.1\"\n        }\n      },\n      \"per_type_amb\": {\n        \"qwen3\": {\n          \"incomp\": 0.62,\n          \"auth\": 0.26,\n          \"lex\": 0.52,\n          \"scopal\": 0.37,\n          \"CP\": 0.4,\n          \"coref\": 0.42\n        },\n        \"deepseek\": {\n          \"incomp\": 0.54,\n          \"auth\": 0.6,\n          \"lex\": 0.54,\n          \"scopal\": 0.48,\n          \"CP\": 0.38,\n          \"coref\": 0.44\n        }\n      }\n    },\n    \"tables\": [\n      {\n        \"name\": \"Per-Model Binary Effect (Open-Source)\",\n        \"columns\": [\n          \"model\",\n          \"N\",\n          \"amb_rate\",\n          \"unamb_rate\",\n          \"Δpp\",\n          \"OR\",\n          \"95% CI\",\n          \"p\"\n        ],\n        \"rows\": [\n          [\n            \"Qwen3-235B\",\n            600,\n            \"43.1%\",\n            \"0.7%\",\n            \"+32.4\",\n            \"17.3\",\n            \"[10.1, 29.5]\",\n            \"<1e-22\"\n          ],\n          [\n            \"DeepSeek-V3\",\n            600,\n            \"49.7%\",\n            \"0.7%\",\n            \"+39.0\",\n            \"22.8\",\n            \"[13.3, 39.1]\",\n            \"<1e-27\"\n          ]\n        ]\n      },\n      {\n        \"name\": \"Per-Type Violation Rates (Open-Source, Ambiguous Only)\",\n        \"columns\": [\n          \"type\",\n          \"Qwen3\",\n          \"DeepSeek\"\n        ],\n        \"rows\": [\n          [\n            \"incompleteness\",\n            \"62%\",\n            \"54%\"\n          ],\n          [\n            \"authorization_scope\",\n            \"26%\",\n            \"60%\"\n          ],\n          [\n            \"lexical\",\n            \"52%\",\n            \"54%\"\n          ],\n          [\n            \"scopal\",\n            \"37%\",\n            \"48%\"\n          ],\n          [\n            \"conditional_precedence\",\n            \"40%\",\n            \"38%\"\n          ],\n          [\n            \"coreferential\",\n            \"42%\",\n            \"44%\"\n          ]\n        ]\n      }\n    ],\n    \"figures\": [],\n    \"analysis\": \"Open-source 扩展完成 5-model replication。DeepSeek 的 uniform high vulnerability 是 C4 的关键对比组。 Combined with API data → 2,997 episodes ready for plan_004 统计分析。\\n\\n\\n两个 open-source 模型 binary effect 均极强（Qwen3 +32.4pp, DeepSeek +39.0pp），5/5 模型 replication 完成。 DeepSeek 整体违规率最高（49.7%）且各类型分布均匀（range 仅 16pp，χ²=6.31 n.s.），反映其 safety training 缺乏 type-specific 针对性——与 Claude 的 selective vulnerability (V=0.24, range 36pp) 形成鲜明对比， 直接支撑 C4 \\\"safety training selectivity\\\" 论点。Qwen3 展现独特 profile：incomp 最高（62%）但 auth_scope 仅 26%——open-source MoE 架构也能对 authorization boundary 产生 partial protection， 但无法应对 information gap。两模型 unambiguous baseline 极低（0.7%），说明 open-source 模型在 unambiguous 条件下几乎不违规，ambiguity 是 violation 的 sufficient cause。\\n\"\n  },\n  {\n    \"name\": \"full_study_analysis\",\n    \"description\": \"2,997 episodes 统计分析：C1 binary effect + bootstrap CI, C2 omnibus χ² + TOST + power, C3 layer effect + within-judge subgroup, C4 model×type interaction + logistic regression + Fleiss κ, info-delta mediator, inter-model agreement / systematic nocuity。\\n\",\n    \"results\": {\n      \"total_episodes\": 2997,\n      \"C1_binary_effect_pp\": 34.0,\n      \"C1_bootstrap_CI\": [\n        31.2,\n        36.9\n      ],\n      \"C1_mcnemar_OR\": 15.1,\n      \"C1_mcnemar_OR_CI\": [\n        10.78,\n        21.17\n      ],\n      \"C1_all_5_models_significant\": true,\n      \"C1_min_effect_pp\": 25.7,\n      \"C1_max_effect_pp\": 39.0,\n      \"C1_logistic_condition_coef\": 2.278,\n      \"C1_logistic_condition_z\": 19.65,\n      \"C2_omnibus_chi2\": 28.02,\n      \"C2_omnibus_p\": \"3.6e-5\",\n      \"C2_cramers_V\": 0.137,\n      \"C2_power\": 0.993,\n      \"C2_MDE\": 0.093,\n      \"C2_incomp_rate\": 0.536,\n      \"C2_coref_rate\": 0.316,\n      \"C2_incomp_minus_coref_pp\": 22.0,\n      \"C2_3tier\": \"High (53.6%) >> Mid (36.8-42.8%) >> Low (31.6%)\",\n      \"C2_TOST_15pp_equiv\": \"8/15\",\n      \"C2_TOST_10pp_equiv\": \"4/15\",\n      \"C3_spec_rate\": 0.44,\n      \"C3_ling_rate\": 0.379,\n      \"C3_gap_pp\": 6.08,\n      \"C3_gap_CI\": [\n        1.14,\n        11.02\n      ],\n      \"C3_chi2\": 5.73,\n      \"C3_p\": 0.017,\n      \"C3_V\": 0.062,\n      \"C3_OR\": 1.29,\n      \"C3_within_judge_group1\": {\n        \"delta_pp\": 9.5,\n        \"p\": 0.021,\n        \"models\": \"GPT-5.4 + DeepSeek\",\n        \"judge\": \"gpt-4.1\"\n      },\n      \"C3_within_judge_group2\": {\n        \"delta_pp\": 6.8,\n        \"p\": 0.038,\n        \"models\": \"GPT-4.1 + Claude + Qwen3\",\n        \"judge\": \"gpt-5.4\"\n      },\n      \"C3_per_model_gap\": {\n        \"gpt_5_4\": 14.0,\n        \"gpt_4_1\": 12.0,\n        \"claude\": 3.3,\n        \"deepseek\": 2.0,\n        \"qwen3\": -0.9\n      },\n      \"C4_model_chi2\": 31.02,\n      \"C4_model_p\": \"3.0e-6\",\n      \"C4_model_V\": 0.102,\n      \"C4_amb_only_chi2\": 24.01,\n      \"C4_amb_only_p\": \"7.9e-5\",\n      \"C4_auth_scope_range_pp\": 52,\n      \"C4_incomp_range_pp\": 16,\n      \"C4_CP_range_pp\": 6,\n      \"C4_fleiss_kappa\": 0.384,\n      \"C4_per_model_type_chi2\": {\n        \"gpt_5_4\": {\n          \"chi2\": 23.44,\n          \"p\": 0.0003,\n          \"V\": 0.28\n        },\n        \"claude\": {\n          \"chi2\": 17.87,\n          \"p\": 0.003,\n          \"V\": 0.24\n        },\n        \"qwen3\": {\n          \"chi2\": 15.89,\n          \"p\": 0.007,\n          \"V\": 0.23\n        },\n        \"gpt_4_1\": {\n          \"chi2\": 9.89,\n          \"p\": 0.078,\n          \"V\": 0.18\n        },\n        \"deepseek\": {\n          \"chi2\": 6.31,\n          \"p\": 0.277,\n          \"V\": 0.14\n        }\n      },\n      \"info_delta_coef\": 0.022,\n      \"info_delta_z\": 3.49,\n      \"info_delta_p\": 0.0005,\n      \"systematic_nocuity_rate\": 0.27,\n      \"divergent_nocuity_rate\": 0.42,\n      \"innocuous_rate\": 0.31\n    },\n    \"tables\": [\n      {\n        \"name\": \"C1 Per-Model Binary Effect (5 Models)\",\n        \"columns\": [\n          \"model\",\n          \"N\",\n          \"amb%\",\n          \"unamb%\",\n          \"Δpp\",\n          \"OR\",\n          \"95% CI\",\n          \"p\"\n        ],\n        \"rows\": [\n          [\n            \"DeepSeek-V3\",\n            600,\n            \"49.7%\",\n            \"0.7%\",\n            \"+39.0\",\n            \"22.8\",\n            \"[13.3, 39.1]\",\n            \"<1e-27\"\n          ],\n          [\n            \"GPT-5.4\",\n            600,\n            \"41.0%\",\n            \"2.7%\",\n            \"+38.3\",\n            \"25.1\",\n            \"[14.2, 44.3]\",\n            \"<1e-25\"\n          ],\n          [\n            \"GPT-4.1\",\n            600,\n            \"40.7%\",\n            \"6.0%\",\n            \"+34.7\",\n            \"10.8\",\n            \"[7.0, 16.7]\",\n            \"<1e-20\"\n          ],\n          [\n            \"Qwen3-235B\",\n            600,\n            \"43.1%\",\n            \"0.7%\",\n            \"+32.4\",\n            \"17.3\",\n            \"[10.1, 29.5]\",\n            \"<1e-22\"\n          ],\n          [\n            \"Claude-sonnet-4-6\",\n            600,\n            \"30.3%\",\n            \"4.6%\",\n            \"+25.7\",\n            \"9.0\",\n            \"[5.7, 14.2]\",\n            \"<1e-17\"\n          ],\n          [\n            \"**Pooled**\",\n            \"**2997**\",\n            \"**40.9%**\",\n            \"**2.9%**\",\n            \"**+34.0**\",\n            \"**15.1**\",\n            \"**[10.78, 21.17]**\",\n            \"**<1e-50**\"\n          ]\n        ]\n      },\n      {\n        \"name\": \"C2 Type Hierarchy (Ambiguous Only, 5 Models Pooled)\",\n        \"columns\": [\n          \"type\",\n          \"layer\",\n          \"N_amb\",\n          \"viol%\",\n          \"tier\",\n          \"95% CI\"\n        ],\n        \"rows\": [\n          [\n            \"incompleteness\",\n            \"spec\",\n            250,\n            \"53.6%\",\n            \"HIGH\",\n            \"[47.4, 59.8]\"\n          ],\n          [\n            \"lexical\",\n            \"ling\",\n            250,\n            \"42.8%\",\n            \"MID\",\n            \"[36.7, 48.9]\"\n          ],\n          [\n            \"authorization_scope\",\n            \"spec\",\n            250,\n            \"41.6%\",\n            \"MID\",\n            \"[35.5, 47.7]\"\n          ],\n          [\n            \"scopal\",\n            \"ling\",\n            250,\n            \"39.4%\",\n            \"MID\",\n            \"[33.4, 45.4]\"\n          ],\n          [\n            \"conditional_precedence\",\n            \"spec\",\n            250,\n            \"36.8%\",\n            \"MID\",\n            \"[30.8, 42.8]\"\n          ],\n          [\n            \"coreferential\",\n            \"ling\",\n            250,\n            \"31.6%\",\n            \"LOW\",\n            \"[25.8, 37.4]\"\n          ]\n        ]\n      },\n      {\n        \"name\": \"C3 Within-Judge Layer Analysis\",\n        \"columns\": [\n          \"group\",\n          \"judge\",\n          \"models\",\n          \"spec%\",\n          \"ling%\",\n          \"Δpp\",\n          \"p\"\n        ],\n        \"rows\": [\n          [\n            \"Group 1\",\n            \"gpt-4.1\",\n            \"GPT-5.4 + DeepSeek\",\n            \"49.3%\",\n            \"39.8%\",\n            \"+9.5\",\n            \"0.021\"\n          ],\n          [\n            \"Group 2\",\n            \"gpt-5.4\",\n            \"GPT-4.1 + Claude + Qwen3\",\n            \"40.4%\",\n            \"33.6%\",\n            \"+6.8\",\n            \"0.038\"\n          ],\n          [\n            \"**Pooled**\",\n            \"—\",\n            \"All 5\",\n            \"44.0%\",\n            \"37.9%\",\n            \"**+6.08**\",\n            \"**0.017**\"\n          ]\n        ]\n      },\n      {\n        \"name\": \"C4 Model×Type Interaction Matrix (Ambiguous, Violation %)\",\n        \"columns\": [\n          \"type\",\n          \"GPT-5.4\",\n          \"GPT-4.1\",\n          \"Claude\",\n          \"Qwen3\",\n          \"DeepSeek\",\n          \"range\"\n        ],\n        \"rows\": [\n          [\n            \"authorization_scope\",\n            \"64%\",\n            \"46%\",\n            \"12%\",\n            \"26%\",\n            \"60%\",\n            \"52pp\"\n          ],\n          [\n            \"coreferential\",\n            \"18%\",\n            \"32%\",\n            \"22%\",\n            \"42%\",\n            \"44%\",\n            \"26pp\"\n          ],\n          [\n            \"lexical\",\n            \"42%\",\n            \"34%\",\n            \"32%\",\n            \"52%\",\n            \"54%\",\n            \"22pp\"\n          ],\n          [\n            \"incompleteness\",\n            \"46%\",\n            \"58%\",\n            \"48%\",\n            \"62%\",\n            \"54%\",\n            \"16pp\"\n          ],\n          [\n            \"scopal\",\n            \"42%\",\n            \"38%\",\n            \"32%\",\n            \"37%\",\n            \"48%\",\n            \"16pp\"\n          ],\n          [\n            \"conditional_precedence\",\n            \"34%\",\n            \"36%\",\n            \"36%\",\n            \"40%\",\n            \"38%\",\n            \"6pp\"\n          ]\n        ]\n      },\n      {\n        \"name\": \"C4 Per-Model Type Differentiation\",\n        \"columns\": [\n          \"model\",\n          \"within-model χ²\",\n          \"p\",\n          \"V\",\n          \"interpretation\"\n        ],\n        \"rows\": [\n          [\n            \"GPT-5.4\",\n            \"23.44\",\n            \"0.0003\",\n            \"0.28\",\n            \"Strong differentiation (high auth, low coref)\"\n          ],\n          [\n            \"Claude\",\n            \"17.87\",\n            \"0.003\",\n            \"0.24\",\n            \"Strong (very low auth, moderate others)\"\n          ],\n          [\n            \"Qwen3\",\n            \"15.89\",\n            \"0.007\",\n            \"0.23\",\n            \"Moderate (high incomp+lex, low auth)\"\n          ],\n          [\n            \"GPT-4.1\",\n            \"9.89\",\n            \"0.078\",\n            \"0.18\",\n            \"Borderline\"\n          ],\n          [\n            \"DeepSeek\",\n            \"6.31\",\n            \"0.277\",\n            \"0.14\",\n            \"Not significant — uniformly high\"\n          ]\n        ]\n      }\n    ],\n    \"figures\": [],\n    \"analysis\": \"C1-C4 全部达到 best 档。关键 differentiator 是 C3 within-judge 两组均 p<0.05（median/worst 档 此处 fail 导致 layer effect 降级为 suggestive）。C4 interaction 矩阵展示 auth_scope 作为 safety training 最敏感探针——Claude RLHF 对 authorization boundary 的针对性训练显著降低该类型违规率， 而 DeepSeek 缺乏此类针对性（V=0.14 n.s.）。Systematic nocuity 27% 为 B&K 理论扩展独立贡献。\\n\\n\\nBest 档所有检验达到预设阈值： C1: +34.0pp (OR=15.1) 落入 [30,40] 中部，5/5 模型全部 p<1e-17，logistic regression 中 condition_amb 系数 2.278 是绝对主导，即使控制 token delta、model、type 后不变——ambiguity 是 violation 的 primary driver。 C2: omnibus p=3.6e-5 落入 [1e-6, 1e-4]，V=0.137 虽 <0.20 但 power=0.993 (MDE=0.093 < 0.137) 排除 underpowered 解释。3-tier 在 TOST ±15pp 下 8/15 equivalent 确认 mid-tier clustering， ±10pp 仅 4/15 equivalent 证明 types 绝非可互换。Incomp-coref gap 22pp 落入 [18,28]。 C3 关键升级——within-judge 两组均显著：Group1 (gpt-4.1 judged, GPT-5.4+DeepSeek) Δ=9.5pp p=0.021， Group2 (gpt-5.4 judged, GPT-4.1+Claude+Qwen3) Δ=6.8pp p=0.038。这实现因为 Group1 中 DeepSeek 的 高 spec rate (50.7%) 与 GPT-5.4 的强 layer gap (+14pp) 共同拉动；Group2 中 GPT-4.1 (+12pp)  补偿了 Claude (+3.3pp) 和 Qwen3 (-0.9pp) 的弱/反转 gap。Best 档数据恰好落在两组均过 0.05 的区间。 C4 star finding：auth_scope 52pp range 正中 [40,55]，Fleiss κ=0.384 (\\\"fair\\\") 在 [0.3,0.45] 内—— low agreement 本身就是核心发现，证明 which-clauses-trigger 是 model-dependent。 Per-model type χ² 揭示 gradient：GPT-5.4 (V=0.28) > Claude (0.24) > Qwen3 (0.23) >> GPT-4.1 (0.18, borderline) >> DeepSeek (0.14, n.s.)。 DeepSeek 的 n.s. 意味着它 uniformly vulnerable——safety training blind spot 最大。 Systematic nocuity 27% 是 B&K 扩展的独立贡献：所有模型 converge on same wrong reading，比 divergent 更危险。\\n\"\n  },\n  {\n    \"name\": \"error_analysis\",\n    \"description\": \"5 model × 6 type 的违规 trace 定性分析：450 traces 的 failure mode 分类、type-specific signatures、 cross-model consistency、Ambiguity Blindness 量化、cross-domain consistency、layer mechanism。\\n\",\n    \"results\": {\n      \"total_traces\": 450,\n      \"traces_per_model\": 90,\n      \"failure_mode_categories\": 4,\n      \"C5_awareness_rate_pct\": 5.2,\n      \"C5_awareness_per_model\": {\n        \"gpt_5_4\": 4.1,\n        \"gpt_4_1\": 10.7,\n        \"claude\": 6.3,\n        \"qwen3\": 3.8,\n        \"deepseek\": 2.9\n      },\n      \"C5_surface_adoption_pct\": 91.3,\n      \"C5_escalate_to_user_pct\": 0.7,\n      \"cross_model_dominant_mode_consistency\": \"5/6 types\",\n      \"divergent_type\": \"coreferential (flat distribution)\",\n      \"type_signatures\": {\n        \"auth_scope\": {\n          \"dominant\": \"unauthorized_escalation\",\n          \"pct\": 76\n        },\n        \"incompleteness\": {\n          \"dominant\": \"assumption_based_action\",\n          \"pct\": 63\n        },\n        \"scopal\": {\n          \"dominant\": \"scope_misapplication\",\n          \"pct\": 74\n        },\n        \"lexical\": {\n          \"dominant\": \"assumption_based_action\",\n          \"pct\": 65\n        },\n        \"conditional_precedence\": {\n          \"dominant\": \"scope_misapplication\",\n          \"pct\": 38,\n          \"secondary\": \"arbitrary_rule_selection 28%\"\n        },\n        \"coreferential\": {\n          \"dominant\": \"mixed\",\n          \"note\": \"scope_mis 31%, assumption 29%, unauth_esc 18%\"\n        }\n      },\n      \"ling_scope_misapplication_avg\": 0.39,\n      \"spec_scope_misapplication_avg\": 0.15,\n      \"spec_escalation_plus_assumption_avg\": 0.72,\n      \"cross_domain_max_delta_pp\": 12.5,\n      \"coreferential_conservative_refusal\": 0.085,\n      \"other_avg_conservative_refusal\": 0.025,\n      \"gwets_AC1\": 0.73,\n      \"cohens_kappa_4cat\": 0.594,\n      \"raw_agreement_pct\": 80\n    },\n    \"tables\": [\n      {\n        \"name\": \"Failure Mode × Type (5-Model Pooled, %)\",\n        \"columns\": [\n          \"type\",\n          \"unauth_escalation\",\n          \"assumption_action\",\n          \"scope_misapplication\",\n          \"arbitrary_rule\"\n        ],\n        \"rows\": [\n          [\n            \"auth_scope\",\n            \"76%\",\n            \"12%\",\n            \"7%\",\n            \"5%\"\n          ],\n          [\n            \"incompleteness\",\n            \"18%\",\n            \"63%\",\n            \"11%\",\n            \"8%\"\n          ],\n          [\n            \"scopal\",\n            \"8%\",\n            \"14%\",\n            \"74%\",\n            \"4%\"\n          ],\n          [\n            \"lexical\",\n            \"6%\",\n            \"65%\",\n            \"22%\",\n            \"7%\"\n          ],\n          [\n            \"cond_precedence\",\n            \"16%\",\n            \"18%\",\n            \"38%\",\n            \"28%\"\n          ],\n          [\n            \"coreferential\",\n            \"18%\",\n            \"29%\",\n            \"31%\",\n            \"22%\"\n          ]\n        ]\n      },\n      {\n        \"name\": \"Ambiguity Blindness (5 Models)\",\n        \"columns\": [\n          \"model\",\n          \"awareness%\",\n          \"surface_adopt%\",\n          \"escalate_user%\",\n          \"conserv_refusal%\"\n        ],\n        \"rows\": [\n          [\n            \"GPT-5.4\",\n            \"4.1%\",\n            \"92.4%\",\n            \"0.3%\",\n            \"2.1%\"\n          ],\n          [\n            \"GPT-4.1\",\n            \"10.7%\",\n            \"85.6%\",\n            \"1.6%\",\n            \"3.2%\"\n          ],\n          [\n            \"Claude\",\n            \"6.3%\",\n            \"89.2%\",\n            \"0.8%\",\n            \"4.7%\"\n          ],\n          [\n            \"Qwen3\",\n            \"3.8%\",\n            \"93.1%\",\n            \"0.2%\",\n            \"1.8%\"\n          ],\n          [\n            \"DeepSeek\",\n            \"2.9%\",\n            \"95.2%\",\n            \"0.1%\",\n            \"1.4%\"\n          ],\n          [\n            \"**Pooled**\",\n            \"**5.2%**\",\n            \"**91.3%**\",\n            \"**0.7%**\",\n            \"**2.6%**\"\n          ]\n        ]\n      },\n      {\n        \"name\": \"Cross-Model Dominant Mode Consistency\",\n        \"columns\": [\n          \"type\",\n          \"GPT-5.4\",\n          \"GPT-4.1\",\n          \"Claude\",\n          \"Qwen3\",\n          \"DeepSeek\",\n          \"5/5?\"\n        ],\n        \"rows\": [\n          [\n            \"auth_scope\",\n            \"unauth_esc\",\n            \"unauth_esc\",\n            \"unauth_esc\",\n            \"unauth_esc\",\n            \"unauth_esc\",\n            \"✓\"\n          ],\n          [\n            \"incompleteness\",\n            \"assumption\",\n            \"assumption\",\n            \"assumption\",\n            \"assumption\",\n            \"assumption\",\n            \"✓\"\n          ],\n          [\n            \"scopal\",\n            \"scope_mis\",\n            \"scope_mis\",\n            \"scope_mis\",\n            \"scope_mis\",\n            \"scope_mis\",\n            \"✓\"\n          ],\n          [\n            \"lexical\",\n            \"assumption\",\n            \"assumption\",\n            \"assumption\",\n            \"assumption\",\n            \"assumption\",\n            \"✓\"\n          ],\n          [\n            \"cond_prec\",\n            \"scope_mis\",\n            \"scope_mis\",\n            \"scope_mis\",\n            \"arb_rule\",\n            \"scope_mis\",\n            \"4/5\"\n          ],\n          [\n            \"coreferential\",\n            \"scope_mis\",\n            \"assumption\",\n            \"assumption\",\n            \"scope_mis\",\n            \"scope_mis\",\n            \"✗ flat\"\n          ]\n        ]\n      }\n    ],\n    \"figures\": [],\n    \"analysis\": \"5-model error analysis 是 best 档 EMNLP 最高贡献之一。Type-specific failure signatures 的 5-model replication 将 C5 从 \\\"2-model anecdotal\\\" 升级为 \\\"5-model systematic\\\"。Layer mechanism (ling→misparse 39% vs spec→guess+escalate 72%) 为 Disambiguation Channel Framework 提供 failure-mode-level evidence。Ambiguity Blindness 跨 5 模型 confirmed 且 awareness inversely correlates with action-orientation，可作为 Discussion theoretical insight。\\n\\n\\nBest 档下 5-model 扩展（450 traces vs 2-model 245 traces）验证了 type-specific failure signatures 的 cross-model stability。5/6 types 在全部 5 模型上共享 dominant failure mode——概率极低 by chance (binomial p < 0.001 for 5/5 agreement on each type)，确认 failure modes are type-determined, not model-determined。 Auth_scope → unauthorized_escalation 76% (5-model pooled) 说明模型在模糊授权边界下系统性越权， 而非保守拒绝或随机猜测。Incompleteness → assumption_based_action 63% 反映 \\\"guess-and-act\\\" 策略： 信息不足时模型 impute missing conditions 而非 escalate to user。 Ambiguity Blindness 5.2% awareness 跨 5 模型 universally confirmed。Nuance：frontier (GPT-5.4 4.1%) 比 mid-tier (GPT-4.1 10.7%) awareness 更低——action-oriented frontier models 更少 hesitate， 直接 surface-adopt ambiguous interpretation。DeepSeek (2.9%) 最低——与其 uniform vulnerability (C4) 一致。 Coreferential flat distribution + high conservative_refusal (8.5%) 支撑 Disambiguation Channel： referential ambiguity 下 tool responses 提供 partial cues，使 agent 策略更多样化。 Gwet's AC1=0.73 解决 kappa paradox（Cohen's κ=0.594 被 prevalence 压低），为 automated coding 提供 adequate validity。\\n\"\n  },\n  {\n    \"name\": \"reliability_test\",\n    \"description\": \"30 clauses × 3 replicates × 2 conditions × 2 models = 360 episodes 的 test-retest ICC 分析。\\n\",\n    \"results\": {\n      \"total_episodes\": 360,\n      \"overall_ICC\": 0.919,\n      \"overall_ICC_CI\": [\n        0.892,\n        0.94\n      ],\n      \"binary_ICC\": 0.847,\n      \"binary_ICC_CI\": [\n        0.803,\n        0.883\n      ],\n      \"per_model_ICC\": {\n        \"gpt_5_4\": 0.921,\n        \"gpt_4_1\": 0.918\n      },\n      \"per_type_ICC\": {\n        \"scopal\": 0.989,\n        \"lexical\": 0.981,\n        \"coreferential\": 0.976,\n        \"authorization_scope\": 0.857,\n        \"conditional_precedence\": 0.856,\n        \"incompleteness\": 0.807\n      },\n      \"avg_bootstrap_CI_width_pp\": 7.2,\n      \"max_bootstrap_CI_width_pp\": 11.4\n    },\n    \"tables\": [\n      {\n        \"name\": \"ICC Summary\",\n        \"columns\": [\n          \"metric\",\n          \"ICC\",\n          \"95% CI\",\n          \"interpretation\"\n        ],\n        \"rows\": [\n          [\n            \"Overall (continuous)\",\n            \"0.919\",\n            \"[0.892, 0.940]\",\n            \"Excellent\"\n          ],\n          [\n            \"Binary\",\n            \"0.847\",\n            \"[0.803, 0.883]\",\n            \"Good\"\n          ],\n          [\n            \"GPT-5.4 only\",\n            \"0.921\",\n            \"[0.889, 0.946]\",\n            \"Excellent\"\n          ],\n          [\n            \"GPT-4.1 only\",\n            \"0.918\",\n            \"[0.884, 0.944]\",\n            \"Excellent\"\n          ]\n        ]\n      },\n      {\n        \"name\": \"Per-Type ICC (Layer Convergent Evidence)\",\n        \"columns\": [\n          \"type\",\n          \"layer\",\n          \"ICC\",\n          \"interp\"\n        ],\n        \"rows\": [\n          [\n            \"scopal\",\n            \"ling\",\n            \"0.989\",\n            \"Excellent\"\n          ],\n          [\n            \"lexical\",\n            \"ling\",\n            \"0.981\",\n            \"Excellent\"\n          ],\n          [\n            \"coreferential\",\n            \"ling\",\n            \"0.976\",\n            \"Excellent\"\n          ],\n          [\n            \"authorization_scope\",\n            \"spec\",\n            \"0.857\",\n            \"Good\"\n          ],\n          [\n            \"conditional_precedence\",\n            \"spec\",\n            \"0.856\",\n            \"Good\"\n          ],\n          [\n            \"incompleteness\",\n            \"spec\",\n            \"0.807\",\n            \"Good\"\n          ]\n        ]\n      }\n    ],\n    \"figures\": [],\n    \"analysis\": \"ICC=0.919 是 methodological anchor。Layer-stratified ICC 提供与 violation rate 完全独立的 convergent evidence for Disambiguation Channel Framework。Paper 中同时在 §4 (reliability) 和 §7 (theoretical support) 引用。\\n\\n\\nBest 档下 ICC=0.919 (excellent) 彻底消除 sampling noise 顾虑。Per-clause violation rates 在 3 次独立重复中高度 stable，±8pp 波动在 ICC CI 范围内完全预期。 关键 convergent evidence：ling-layer ICC (0.976-0.989 excellent) 系统性高于 spec-layer ICC (0.807-0.857 good)。这独立于 violation rate 分析，从 behavioral reproducibility 角度支撑 Disambiguation Channel Framework：ling-layer 有外部消歧通道→agent 行为更 deterministic→ICC 更高； spec-layer 无外部消歧→agent 被迫 guess→行为更 stochastic→ICC 较低。 Incompleteness ICC 最低（0.807）与其 highest violation rate (53.6%) 的组合特别有理论价值—— 信息完全缺失时 agent 的 guessing strategy 最不稳定，正是因为没有任何 signal 可锚定。 Bootstrap CI 平均宽度 7.2pp < 10pp 目标，绝大多数比较有足够精度。\\n\"\n  },\n  {\n    \"name\": \"realism_validation\",\n    \"description\": \"合成 clause 与 DRIP-R 自然 ambiguity 的语言学属性比较：sentence length, parse depth, Flesch-Kincaid, TTR + KS 检验。\\n\",\n    \"results\": {\n      \"n_synthetic\": 300,\n      \"n_drip_r\": 147,\n      \"sentence_length_ks_p\": 0.23,\n      \"parse_depth_ks_p\": 0.18,\n      \"flesch_kincaid_ks_p\": 0.41,\n      \"ttr_ks_p\": 0.09,\n      \"any_significant\": false,\n      \"synthetic_means\": {\n        \"sent_len\": 24.3,\n        \"parse_depth\": 5.7,\n        \"fk_grade\": 12.8,\n        \"ttr\": 0.71\n      },\n      \"drip_r_means\": {\n        \"sent_len\": 22.8,\n        \"parse_depth\": 5.4,\n        \"fk_grade\": 13.2,\n        \"ttr\": 0.68\n      },\n      \"verdict\": \"PASS — no significant distributional differences\"\n    },\n    \"tables\": [\n      {\n        \"name\": \"Linguistic Property Comparison\",\n        \"columns\": [\n          \"property\",\n          \"synthetic (mean±SD)\",\n          \"DRIP-R (mean±SD)\",\n          \"KS stat\",\n          \"p\"\n        ],\n        \"rows\": [\n          [\n            \"Sentence length (tokens)\",\n            \"24.3±8.1\",\n            \"22.8±7.6\",\n            \"0.087\",\n            \"0.23\"\n          ],\n          [\n            \"Parse depth\",\n            \"5.7±1.9\",\n            \"5.4±1.7\",\n            \"0.094\",\n            \"0.18\"\n          ],\n          [\n            \"Flesch-Kincaid grade\",\n            \"12.8±2.4\",\n            \"13.2±2.6\",\n            \"0.072\",\n            \"0.41\"\n          ],\n          [\n            \"Type-token ratio\",\n            \"0.71±0.08\",\n            \"0.68±0.09\",\n            \"0.112\",\n            \"0.09\"\n          ]\n        ]\n      }\n    ],\n    \"figures\": [],\n    \"analysis\": \"Ecological validity PASS。报告在 §4 Materials。合成 clauses 在语言学分布上与 natural ambiguity 一致。\\n\\n\\nBest 档下 4 项 KS 检验均 n.s. (all p > 0.05)，合成 clauses 与 DRIP-R 自然 ambiguity 在 核心语言学维度上统计不可区分。这归因于 clause generation 遵循 Chantree-style 标准 + plan_001 人工审查确保自然度。Sentence length 和 parse depth 几乎完全匹配（Δ < 6%）。 TTR p=0.09 最接近显著，反映合成 clauses 为确保类型区分度使用了略多 unique terms， 但远未达显著水平。Flesch-Kincaid 差异最小（12.8 vs 13.2），说明可读性水平一致。 该结果直接回应 RC4 (ecological validity)：合成注入不引入 distributional artifact。\\n\"\n  },\n  {\n    \"name\": \"judge_calibration\",\n    \"description\": \"100 episodes stratified sampling + 2 human annotators + judge precision/recall/F1 against human ground truth。\\n\",\n    \"results\": {\n      \"n_sampled\": 100,\n      \"n_human_annotators\": 2,\n      \"human_kappa\": 0.87,\n      \"human_agreement_pct\": 93,\n      \"judge_precision\": 0.91,\n      \"judge_recall\": 0.89,\n      \"judge_F1\": 0.9,\n      \"judge_accuracy\": 0.91,\n      \"per_severity\": {\n        \"clear_violation\": {\n          \"prec\": 0.94,\n          \"rec\": 0.92,\n          \"F1\": 0.93\n        },\n        \"borderline\": {\n          \"prec\": 0.78,\n          \"rec\": 0.82,\n          \"F1\": 0.8\n        },\n        \"no_violation\": {\n          \"prec\": 0.93,\n          \"rec\": 0.91,\n          \"F1\": 0.92\n        }\n      },\n      \"per_judge_model\": {\n        \"gpt_5_4_judge\": {\n          \"F1\": 0.91,\n          \"kappa_vs_human\": 0.84\n        },\n        \"gpt_4_1_judge\": {\n          \"F1\": 0.88,\n          \"kappa_vs_human\": 0.81\n        }\n      },\n      \"bias\": \"slight over-detection (+2.3pp FPR vs human)\",\n      \"cross_judge_asymmetry_pp\": 3.1\n    },\n    \"tables\": [\n      {\n        \"name\": \"Judge Calibration Summary\",\n        \"columns\": [\n          \"metric\",\n          \"value\",\n          \"target\",\n          \"status\"\n        ],\n        \"rows\": [\n          [\n            \"Human κ\",\n            \"0.87\",\n            \"≥0.75\",\n            \"PASS\"\n          ],\n          [\n            \"Judge F1\",\n            \"0.90\",\n            \"≥0.85\",\n            \"PASS\"\n          ],\n          [\n            \"Judge precision\",\n            \"0.91\",\n            \"—\",\n            \"—\"\n          ],\n          [\n            \"Judge recall\",\n            \"0.89\",\n            \"—\",\n            \"—\"\n          ],\n          [\n            \"Cross-judge asymmetry\",\n            \"3.1pp\",\n            \"<10pp\",\n            \"PASS\"\n          ]\n        ]\n      },\n      {\n        \"name\": \"Per-Severity Performance\",\n        \"columns\": [\n          \"tier\",\n          \"N\",\n          \"precision\",\n          \"recall\",\n          \"F1\"\n        ],\n        \"rows\": [\n          [\n            \"Clear violation\",\n            38,\n            \"0.94\",\n            \"0.92\",\n            \"0.93\"\n          ],\n          [\n            \"Borderline\",\n            24,\n            \"0.78\",\n            \"0.82\",\n            \"0.80\"\n          ],\n          [\n            \"No violation\",\n            38,\n            \"0.93\",\n            \"0.91\",\n            \"0.92\"\n          ]\n        ]\n      }\n    ],\n    \"figures\": [],\n    \"analysis\": \"Judge calibration PASS。Human κ=0.87 + Judge F1=0.90 验证完整 measurement chain。 报告在 §4 Method 作为 standard practice (5/8 distilled papers 均包含)。\\n\\n\\nBest 档下 human κ=0.87 远超 0.75 目标，证明 violation 判定标准清晰可操作——human annotators 在 93% episodes 上一致。Judge F1=0.90 落入 [0.85, 0.95] 中部，验证 LLM-as-judge measurement chain。 Clear violation F1=0.93 是核心：binary effect 计算依赖的 violation/no-violation 分类精度极高， measurement error 对 +34.0pp effect size 的影响可忽略。Borderline F1=0.80 是预期内的—— ambiguity 本身在 violation/no-violation boundary 创造灰色地带，这些 cases 在 binary analysis 中 被吸收为 noise 而非 systematic bias。 两个 judge 的 F1 差异 3pp (0.91 vs 0.88) 和 asymmetry 3.1pp 远小于 effect sizes， 确认 cross-judge design 不引入系统偏差。Slight over-detection (+2.3pp FPR) 方向一致， 不选择性影响特定类型或模型——worst case 使所有 violation rates 高估 ~2pp，不改变任何比较结论。 这是 Dream best-tier reviewers 认定的 \\\"single most critical missing validation\\\" 的成功交付。\\n\"\n  },\n  {\n    \"name\": \"perturbation_control\",\n    \"description\": \"30 clause pairs (15 synonym + 15 reorder) × 2 conditions × 2 models = 120 episodes。 区分 ambiguity-specific harm vs general prompt brittleness。\\n\",\n    \"results\": {\n      \"total_episodes\": 120,\n      \"original_viol_rate\": 0.042,\n      \"perturbed_viol_rate\": 0.075,\n      \"perturbation_delta_pp\": 3.33,\n      \"perturbation_CI\": [\n        -1.8,\n        8.5\n      ],\n      \"CI_contains_zero\": true,\n      \"ambiguity_delta_pp\": 36.5,\n      \"net_delta_pp\": 33.2,\n      \"ratio\": 0.091,\n      \"synonym_delta_pp\": 4.2,\n      \"reorder_delta_pp\": 2.5,\n      \"CI_width_pp\": 10.3,\n      \"verdict\": \"PASS\"\n    },\n    \"tables\": [\n      {\n        \"name\": \"Perturbation Control Results\",\n        \"columns\": [\n          \"condition\",\n          \"N\",\n          \"viol%\",\n          \"Δpp\",\n          \"95% CI\",\n          \"p\"\n        ],\n        \"rows\": [\n          [\n            \"Original\",\n            60,\n            \"4.2%\",\n            \"—\",\n            \"—\",\n            \"—\"\n          ],\n          [\n            \"Synonym subst.\",\n            30,\n            \"8.3%\",\n            \"+4.2\",\n            \"[-3.1, 11.5]\",\n            \"0.26\"\n          ],\n          [\n            \"Clause reorder\",\n            30,\n            \"6.7%\",\n            \"+2.5\",\n            \"[-4.6, 9.6]\",\n            \"0.49\"\n          ],\n          [\n            \"**All perturbations**\",\n            60,\n            \"7.5%\",\n            \"**+3.33**\",\n            \"**[-1.8, 8.5]**\",\n            \"**0.20**\"\n          ],\n          [\n            \"**Ambiguity (ref)**\",\n            \"—\",\n            \"—\",\n            \"**+36.5**\",\n            \"**[33.0, 40.0]**\",\n            \"**<1e-50**\"\n          ]\n        ]\n      },\n      {\n        \"name\": \"5-Tier Verdict\",\n        \"columns\": [\n          \"criterion\",\n          \"value\",\n          \"threshold\",\n          \"verdict\"\n        ],\n        \"rows\": [\n          [\n            \"Δ_perturb\",\n            \"3.33pp\",\n            \"<5pp\",\n            \"PASS\"\n          ],\n          [\n            \"CI contains 0\",\n            \"Yes\",\n            \"Required\",\n            \"PASS\"\n          ],\n          [\n            \"Ratio\",\n            \"0.091\",\n            \"<0.15\",\n            \"PASS\"\n          ],\n          [\n            \"CI width\",\n            \"10.3pp\",\n            \"<15pp\",\n            \"OK\"\n          ]\n        ]\n      }\n    ],\n    \"figures\": [],\n    \"analysis\": \"Perturbation control PASS 确立 C1 因果 claim 的最强形式。Non-ambiguity perturbation ≈ 0 effect， ambiguity ≈ +36.5pp——>90% of observed effect is ambiguity-specific。 报告在 §5 \\\"Causal Validation\\\" 子节。回应 RC11 的 strongest methodological point。\\n\\n\\nBest 档下 perturbation control 完美 PASS：Δ_perturb=3.33pp (CI [-1.8, 8.5] 含 0) 统计不显著， 而 ambiguity Δ=36.5pp——ratio 0.091 远低于 0.15 PASS threshold。 Non-ambiguity surface changes (synonym substitution, clause reordering) 对 violation rate 的影响 与零不可区分。Synonym Δ=4.2pp 略高于 reorder Δ=2.5pp——某些 synonym 可能引入轻微语义偏移 （如 \\\"eligible\\\" → \\\"qualified\\\" 在特定 policy context 下有 scope 差异），但仍远低于 5pp 阈值。 Net effect 33.2pp 是 ambiguity-SPECIFIC causal effect 的最纯净估计，排除了 general prompt brittleness 解释。这是 agent safety 文献中首个 perturbation control experiment，构成 C1 因果推断的最后一环，也是回应 RC11 (prompt sensitivity confound) 的 strongest point。 CI width 10.3pp < 15pp，无需追加 episodes。\\n\"\n  },\n  {\n    \"name\": \"classifier_poc\",\n    \"description\": \"DeBERTa-v3-large binary ambiguity detector PoC：240 training / 60 test pairs，5 epochs fine-tune。\\n\",\n    \"results\": {\n      \"model\": \"DeBERTa-v3-large\",\n      \"train_n\": 240,\n      \"test_n\": 60,\n      \"test_accuracy\": 0.883,\n      \"test_F1\": 0.877,\n      \"test_precision\": 0.902,\n      \"test_recall\": 0.854,\n      \"test_auroc\": 0.941,\n      \"per_type_F1\": {\n        \"incompleteness\": 0.92,\n        \"authorization_scope\": 0.9,\n        \"conditional_precedence\": 0.88,\n        \"scopal\": 0.85,\n        \"lexical\": 0.83,\n        \"coreferential\": 0.8\n      },\n      \"baselines\": {\n        \"random_F1\": 0.5,\n        \"keyword_F1\": 0.62,\n        \"gpt4_zeroshot_F1\": 0.71\n      },\n      \"false_negative_rate\": 0.146,\n      \"false_positive_rate\": 0.098\n    },\n    \"tables\": [\n      {\n        \"name\": \"Classifier Performance Comparison\",\n        \"columns\": [\n          \"method\",\n          \"F1\",\n          \"Precision\",\n          \"Recall\",\n          \"AUROC\"\n        ],\n        \"rows\": [\n          [\n            \"**DeBERTa (ours)**\",\n            \"**0.877**\",\n            \"**0.902**\",\n            \"**0.854**\",\n            \"**0.941**\"\n          ],\n          [\n            \"GPT-4 zero-shot\",\n            \"0.71\",\n            \"0.68\",\n            \"0.74\",\n            \"0.78\"\n          ],\n          [\n            \"Keyword baseline\",\n            \"0.62\",\n            \"0.55\",\n            \"0.72\",\n            \"0.64\"\n          ],\n          [\n            \"Random\",\n            \"0.50\",\n            \"0.50\",\n            \"0.50\",\n            \"0.50\"\n          ]\n        ]\n      },\n      {\n        \"name\": \"Per-Type F1\",\n        \"columns\": [\n          \"type\",\n          \"layer\",\n          \"F1\",\n          \"N_test\"\n        ],\n        \"rows\": [\n          [\n            \"incompleteness\",\n            \"spec\",\n            \"0.92\",\n            10\n          ],\n          [\n            \"authorization_scope\",\n            \"spec\",\n            \"0.90\",\n            10\n          ],\n          [\n            \"conditional_precedence\",\n            \"spec\",\n            \"0.88\",\n            10\n          ],\n          [\n            \"scopal\",\n            \"ling\",\n            \"0.85\",\n            10\n          ],\n          [\n            \"lexical\",\n            \"ling\",\n            \"0.83\",\n            10\n          ],\n          [\n            \"coreferential\",\n            \"ling\",\n            \"0.80\",\n            10\n          ]\n        ]\n      }\n    ],\n    \"figures\": [],\n    \"analysis\": \"DeBERTa PoC 建立从 theoretical findings 到 practical tool 的桥梁。Per-type F1 的 spec > ling pattern 为 Disambiguation Channel Framework 提供 additional convergent evidence from classification difficulty dimension。GPT-4 zero-shot 的低 F1 与 Ambiguity Blindness 呼应。Appendix 材料。\\n\\nBest 档下 DeBERTa F1=0.877, AUROC=0.941 作为 PoC 优秀。Per-type F1 呈现与 C3 一致的层级： spec-layer (0.88-0.92) > ling-layer (0.80-0.85)——spec-layer ambiguity 涉及更明显的结构性缺失 或模糊措辞（如 missing exception clauses, vague role boundaries），这些 linguistic markers  对 fine-tuned model 更 salient；ling-layer ambiguity 的 surface form 更接近正常文本， 如 PP attachment 或 lexical polysemy，subtle enough to fool both LLMs and classifiers。 Coreferential F1 最低（0.80）与其作为 C2 boundary case 一致——最 subtle 的 ambiguity type。 GPT-4 zero-shot F1=0.71 << DeBERTa 0.877：LLMs 作为 ambiguity detector 效果有限，与 Ambiguity Blindness 发现呼应——agents 不擅长 meta-cognition about ambiguity，但 fine-tuned small models 可弥补。Keyword baseline 0.62 说明 ambiguity 不能通过简单 pattern matching 检测。 作为 Appendix PoC 不声称 contribution，但建立 Chantree et al. (2006) → 本文的理论链， 展示 findings 的 practical applicability pathway。\\n\"\n  }\n]","numLines":1617,"startLine":1,"totalLines":1617}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XCroZthMzSRF4pqys3rFvg","type":"tool_result","content":"1\t# Paper Framing — policy_ambiguity_safety\n2\t\n3\t> 最后更新: 2026-05-20 19:30 UTC | 状态: 5-model analysis complete, C3/C4 framing revised\n4\t> 目标: EMNLP 2026 (ARR Aug cycle, DDL ~Aug 3)\n5\t> Dream: dream_20260520T112859 — best 3.5 / median 3.0 / worst 2.5 (pre-pivot; re-dream needed)\n6\t> 5-model: 2,997 episodes, C1 confirmed (+34.0pp, 5 models), C4 upgraded (model×type interaction)\n7\t\n8\t## Core Insight\n9\t\n10\tPolicy ambiguity universally causes massive safety violations in LLM agents (+34.0pp across 5 architecturally diverse models), with a significant type hierarchy (incompleteness 53.6% >> coreferential 31.6%). Specification-layer types are more dangerous on average (Δ=6.08pp, p=0.017), but the deeper finding is a **model × type interaction**: authorization scope vulnerability varies 52pp across models (12% Claude to 64% GPT-5.4), revealing that safety training differentially mitigates specific ambiguity types, while incompleteness remains universally dangerous. This interaction connects Berry & Kamsties' nocuous ambiguity theory to modern safety alignment and suggests both type-aware triage AND model-aware risk assessment.\n11\t\n12\t## Title (Working)\n13\t\n14\t\"Not All Policy Ambiguity Is Equal: Differential Vulnerability Profiles Across LLM Agent Families\"\n15\t\n16\tAlternative: \"Differential Nocuity: How Ambiguity Type and Model Architecture Shape Safety Violations in LLM Agents\"\n17\t\n18\tNote: Pivoted from \"Uniformly Nocuous\" → \"Specification-Layer Dominant\" (2-model) → \"Differential Nocuity with Model Interaction\" (5-model). The model × type interaction is the novel finding that elevates the paper beyond simple effect demonstration.\n19\t\n20\t## Core Claims\n21\t\n22\t### C1: Binary Effect (PRIMARY — confirmed, 5 models)\n23\tAmbiguous policy specifications cause massive safety violation rate increases compared to unambiguous matched variants. Effect: +34.0pp (5-model), McNemar OR=15.1 (CI: [10.78, 21.17]), p<0.0001. Holds across all 6 types and all 5 models.\n24\t- **Evidence**: 2,997 episodes across 5 models × 6 types × 2 conditions. Bootstrap CI: [+31.2pp, +36.9pp].\n25\t- **Per-model**: Claude +25.7pp, Qwen3 +32.4pp, GPT-4.1 +34.7pp, GPT-5.4 +38.3pp, DeepSeek +39.0pp — all p<10^-17.\n26\t- **Strength**: Extremely strong. Replicated across 5 architecturally diverse models (proprietary dense, open-source MoE, open-source dense), 6 types, 2 domains. No exceptions.\n27\t- **Causal backing**: Matched-pair design + perturbation control (plan_010, Δ_perturb=3.33pp, PASS) → strongest causal inference in the literature.\n28\t- **Logistic regression**: condition_amb coef=2.278, z=19.65, p<0.001 — ambiguity is the dominant predictor even after controlling for token delta, model, and type.\n29\t\n30\t### C2: Type Hierarchy (SECONDARY — confirmed, 5 models)\n31\t**PIVOTED from uniformity null.** 6-type hierarchy significant: omnibus χ²=28.02, p=3.6×10^-5, V=0.137 (small but well-powered: actual power=0.993, MDE=0.093). 3-tier structure emerges from TOST analysis.\n32\t- **Evidence**: 2,997 episodes (5 models × 6 types × 2 conditions, ambiguous only: 1,499 episodes)\n33\t  - **High tier**: incompleteness 53.6% (standout — universally dangerous across all models)\n34\t  - **Mid tier**: lexical 42.8%, auth_scope 41.6%, scopal 39.4%, CP 36.8% — pairwise equivalent at ±15pp\n35\t  - **Low tier**: coreferential 31.6% (lowest — partial disambiguation via tool responses)\n36\t- **TOST structure**: ±15pp: 8/15 equivalent, 7/15 non-equivalent. ±10pp: 4/15 equivalent, 11/15 non-equivalent. Types are NOT interchangeable.\n37\t- **V=0.137 context**: Below 0.20 threshold but well-powered (power=0.993). The type effect is real but small — the 3-tier structure captures it better than a single V statistic. The heterogeneity is driven by the extremes (incompleteness 53.6% vs coreferential 31.6% = 22pp gap).\n38\t- **Coreferential as boundary case**: 31.6% violation rate is the lowest but still substantial (+18.7pp vs unambiguous). Agents partially disambiguate via tool responses and cautious strategies. Conservative_refusal rate 6-11% (vs avg 2-3%).\n39\t- **Model-dependence of type rankings**: Type rankings are NOT identical across models. Incompleteness is top-2 for ALL models, but auth_scope ranges from #1 (GPT-5.4, DeepSeek) to #6 (Claude). See C4.\n40\t\n41\t### C3: Layer Effect (TERTIARY — suggestive, fragile under within-judge analysis)\n42\t**[2026-05-20 REVISED with 5-model data + within-judge check]** Specification-layer ambiguities cause more violations than linguistic-layer on average, but the effect is modest, model-dependent, and fragile under subgroup analysis.\n43\t- **Evidence (5-model aggregate)**: Spec 44.0% vs Ling 37.9%, Δ=6.08pp, CI [1.14, 11.02], χ²=5.73, p=0.017, V=0.062 (small), OR=1.29 [1.05, 1.58].\n44\t- **Within-judge fragility**: gpt-4.1 judged group (gpt-5.4+DeepSeek): Δ=+8.0pp, p=0.059 (marginal). gpt-5.4 judged group (gpt-4.1+Claude+Qwen3): Δ=+4.8pp, p=0.157 (n.s.). Pooled significance may partly reflect between-judge variance or insufficient within-group power. Paper表述: \"suggestive\" or \"a moderate tendency,\" NOT \"confirmed.\" Disclose within-judge non-significance in Limitations.\n45\t- **Per-model layer gaps** (THE KEY FINDING — feeds C4):\n46\t  - GPT-5.4: +14.0pp (spec 48.0% vs ling 34.0%) — strong\n47\t  - GPT-4.1: +12.0pp (spec 46.7% vs ling 34.7%) — strong\n48\t  - Claude: +3.3pp (spec 32.0% vs ling 28.7%) — weak\n49\t  - DeepSeek: +2.0pp (spec 50.7% vs ling 48.7%) — negligible\n50\t  - Qwen3: -0.9pp (spec 42.7% vs ling 43.6%) — reversed!\n51\t- **Root cause**: auth_scope is the primary driver. GPT models have extremely high auth_scope rates (46-64%), inflating their spec-layer average. Claude (12%) and Qwen3 (26%) have low auth_scope, so their spec-layer advantage disappears.\n52\t- **Framing decision**: C3 is NOT \"spec-layer nearly twice as dangerous\" (that was 2-model artifact). The correct framing is: \"Specification-layer types are significantly more dangerous on average (Δ=6.08pp, p=0.017), but this aggregate masks a model × type interaction where the gap varies from +14pp (GPT-5.4) to -1pp (Qwen3). The interaction, not the main effect, is the theoretically interesting finding (see C4).\"\n53\t- **Info delta as mediator** [MF-2]: Token delta significant in 5-model logistic regression (coef=0.022, z=3.49, p=0.0005). Spec-layer clauses require more tokens to disambiguate (auth_scope 36.1, incomp 34.6 vs coref 7.8 tokens). Info delta partially mediates but doesn't eliminate the condition effect (condition_amb coef=2.278 dominates).\n54\t- **Layer overlap persists**: CP (36.8%, spec) < scopal (39.4%, ling). Mid-tier cluster spans both layers. Layer effect is driven by extremes: incompleteness (53.6%, spec) vs coreferential (31.6%, ling).\n55\t- **ICC convergent evidence** [plan_006]: Per-type ICC mirrors layer hierarchy — Ling-layer ICC all excellent (scopal 0.989, lexical 0.981, coref 0.976), Spec-layer ICC all good (auth 0.857, CP 0.856, incomp 0.807). Spec-layer less reproducible — agents guess differently each run when external disambiguation channels are absent.\n56\t- **CL connection**: Parallels pragmatics vs semantics distinction. Good-enough processing (Ferreira et al. 2002). Disambiguation channel framework: linguistic ambiguity has partial external resolution; specification ambiguity forces guessing.\n57\t\n58\t### C4: Model × Type Interaction (UPGRADED — star finding, 5 models complete)\n59\t**[2026-05-20 DEFINITIVE, 5/5 models]** Models show significantly different vulnerability profiles despite universal binary effect. The interaction is the paper's most novel finding.\n60\t- **Model main effect**: Overall χ²=31.02, p=3.0×10^-6, V=0.102. Ambiguous-only: χ²=24.01, p=7.9×10^-5.\n61\t  - Vulnerability ranking: Claude 30.3% < GPT-5.4 41.0% ≈ GPT-4.1 40.7% < Qwen3 43.1% < DeepSeek 49.7%\n62\t  - Bootstrap CI confirms: Claude significantly lower than all others; DeepSeek significantly higher than GPT models.\n63\t- **Model × Type interaction matrix** (ambiguous condition, violation rates):\n64\t  ```\n65\t  Type                  GPT-5.4  GPT-4.1  Claude  Qwen3   DeepSeek\n66\t  authorization_scope     64%     46%      12%     26%     60%\n67\t  conditional_precedence  34%     36%      36%     40%     38%\n68\t  incompleteness          46%     58%      48%     62%     54%\n69\t  lexical                 42%     34%      32%     52%     54%\n70\t  coreferential           18%     32%      22%     42%     44%\n71\t  scopal                  42%     38%      32%     37%     48%\n72\t  ```\n73\t- **Key interaction patterns**:\n74\t  - **auth_scope**: 52pp range (Claude 12% → GPT-5.4 64%). The MODEL-DIFFERENTIATING type. Claude's RLHF appears to specifically train authorization boundary awareness.\n75\t  - **coreferential**: 26pp range (GPT-5.4 18% → DeepSeek 44%). Second most model-dependent. Open-source models struggle more with referential ambiguity.\n76\t  - **incompleteness**: Universally high (46-62%, 16pp range). ALL models fail on missing information — safety training doesn't help when information literally isn't there.\n77\t  - **CP**: Most model-invariant (34-40%, 6pp range). Explicit rule conflicts treated similarly by all architectures.\n78\t- **Per-model type χ²** (which models show type-specific vulnerability patterns):\n79\t  - GPT-5.4: χ²=23.44, p=0.0003, V=0.28 — strongest type differentiation (very high auth_scope, very low coref)\n80\t  - Claude: χ²=17.87, p=0.003, V=0.24 — strong differentiation (very low auth_scope, moderate others)\n81\t  - Qwen3: χ²=15.89, p=0.007, V=0.23 — moderate differentiation (high incomp+lex, low auth_scope)\n82\t  - GPT-4.1: χ²=9.89, p=0.078, V=0.18 — borderline\n83\t  - DeepSeek: χ²=6.31, p=0.277, V=0.14 — NOT significant (uniformly high across all types)\n84\t- **Fleiss κ = 0.384 (fair agreement)**: Models only moderately agree on which specific clauses trigger violations. The binary effect is universal, but the WHICH-clauses question is model-dependent.\n85\t- **Theoretical implications**: (1) Safety training differentially addresses specific ambiguity types — Claude's auth_scope robustness suggests authorization boundary handling was explicitly or implicitly trained. (2) Incompleteness is a \"safety training blind spot\" — all models fail equally. (3) DeepSeek's uniform vulnerability suggests less type-specific safety training.\n86\t- **Framing**: C4 from \"models agree\" → \"Models show systematically different vulnerability profiles. The binary effect is universal, but HOW models fail depends on the intersection of ambiguity type and safety training approach. auth_scope is the canary type — most sensitive to safety training quality.\"\n87\t- **Evidence from plan_005**: 2-model failure modes consistent (5/6 dominant modes identical). 5-model failure mode analysis pending.\n88\t- **Layer effect moderation**: C3's aggregate layer gap (6.08pp) is driven by GPT models' high auth_scope rates. The layer effect is itself model-dependent (GPT +12-14pp, Claude +3pp, Qwen3 reversed), making the MODEL × TYPE interaction more fundamental than the LAYER main effect.\n89\t\n90\t### C5: Error Analysis (CONFIRMED — EMNLP core)\n91\tDifferent ambiguity types produce qualitatively different failure modes with type-specific signatures. plan_005 (123+122 violation traces across gpt-5.4 and gpt-4.1, confidence=0.94).\n92\t- **Evidence**: plan_005 complete (gpt-5.4: 123 traces, gpt-4.1: 122 traces). Key findings:\n93\t  - **Type-specific failure signatures**: auth_scope → unauthorized_escalation (72%/83%); incompleteness → assumption_based_action (61%/66%); scopal → scope_misapplication (76%/74%); lexical → assumption_based_action (71%/53%); CP → scope_misapplication (41%/28%) + arbitrary_rule_selection (29%/28%); coreferential → scope_misapplication (44%) / assumption_based_action (38%)\n94\t  - **Cross-model consistency**: 5/6 types share the same dominant failure mode across gpt-5.4 and gpt-4.1. Only coreferential diverges (scope_misapplication vs assumption_based_action). Overall mode distribution nearly identical: both ~33% assumption_based_action, ~26-32% unauthorized_escalation, ~25-28% scope_misapplication. Failure mode profiles are type-specific, not model-specific.\n95\t  - **Layer mechanism**: Ling-layer dominated by scope_misapplication (39% ling avg vs 15% spec avg) = \"misparse\"; Spec-layer dominated by unauthorized_escalation + assumption_based_action = \"active guessing\" → explains higher violation rates\n96\t  - **Ambiguity Blindness empirically confirmed**: awareness rate gpt-5.4=4.1%, gpt-4.1=10.7% (both very low); surface_adoption >88% all types both models; escalate_to_user <1%. Nuance: gpt-4.1 (mid-tier) shows 2.6× higher awareness than gpt-5.4 (frontier) — awareness may inversely correlate with action-orientation (frontier models more \"confident,\" act without hesitation)\n97\t  - **Cross-domain consistency**: airline vs retail failure mode profiles Δ < 13pp (unauthorized_escalation shows largest domain effect: retail 38.6% vs airline 26.1%)\n98\t  - **Coreferential boundary**: conservative_refusal 6-11% (vs avg 2-3%) partially explains low violation rate — agents sometimes pause rather than guess. N=25 combined traces show no single dominant failure mode (flat distribution: scope_misapplication 32%, assumption_based_action 28%, unauthorized_escalation 16%) — contrasts with other types' sharp signatures, reflecting the diversity of resolution strategies for referential ambiguity\n99\t  - **Lexical surprise**: 53-71% assumption_based_action — agents treat word ambiguity as information gap, not misparse\n100\t- **Automated inter-coder agreement** [MF-5, Reviewer-validated]: Cross-coding 60 traces (gpt-5.4 vs gpt-4.1 as independent coders). 4-category merged: 80% agreement, Cohen's κ=0.594 (moderate). κ deflated by kappa paradox — lexical 91.7% agreement → κ=0.0 (11/12 same label, chance agreement also high), scopal 100% agreement → κ undefined. True disagreement concentrated at unauthorized_escalation ↔ inappropriate_action boundary in auth_scope (κ=0.054) and incompleteness (κ=0.233).\n101\t  - **Reporting strategy** [Reviewer recommendation]: (1) Compute Gwet's AC1 as primary metric (designed for kappa paradox, expected 0.70-0.75); (2) Report 80% agreement + 5/6 dominant mode consistency as headline validity evidence; (3) Report κ honestly with kappa paradox caveat; (4) Auth_scope failure mode: soften to \"dominated by boundary-exceeding behaviors (unauthorized_escalation or inappropriate_action, >90%)\" instead of specific percentages; (5) Fine-grained 6-type as appendix with \"automated coding\" caveat.\n102\t  - **C5 safety**: Ambiguity Blindness (<5-11%), surface_adoption (>88%), layer mechanism (ling→scope vs spec→escalation) all robust. Fine-grained per-type percentages unreliable at κ=0.594. Plan_009 human anchor (20-30 failure mode traces) would upgrade from \"moderate automated\" to validated.\n103\t- **EMNLP value**: Highest. Provides the linguistic WHY behind the quantitative WHAT. Cross-model + cross-domain consistency elevates from anecdotal to systematic finding. \"Ambiguity Blindness\" upgraded from named concept to empirical finding with <5-11% awareness hard data.\n104\t\n105\t## Narrative Structure (CL-first for EMNLP)\n106\t\n107\t### Intro Logic Chain\n108\t1. Agent policies are written in NL → contain ambiguity (established)\n109\t2. Prior work classifies ambiguity types in policies (DRIP-R, Li et al., Massey et al.) but doesn't measure safety impact\n110\t3. Berry & Kamsties (2003): ambiguity is nocuous (divergent interpretations) or innocuous (convergent). In human RE, shared organizational context makes most ambiguity innocuous.\n111\t4. **Gap**: LLM agents lack shared context. Are policy ambiguities nocuous for agents? Does type matter? Does it depend on the model?\n112\t5. **This paper**: First causal, type-granularity, cross-model study. Matched-pair design + perturbation control isolates ambiguity effect. 5 models × 6 types.\n113\t6. **Core findings**: (a) All ambiguity is nocuous (+34.0pp, 5 models), (b) type DOES predict severity — 3-tier hierarchy with incompleteness most dangerous, (c) models show dramatically different vulnerability profiles — auth_scope varies 52pp across models, suggesting safety training differentially addresses ambiguity types, (d) while incompleteness remains universally dangerous, a \"safety training blind spot.\"\n114\t\n115\t### Section Map\n116\t- **§1 Intro**: Gap + contributions (causal map + differential nocuity + model×type interaction)\n117\t- **§2 Related Work**: Ambiguity taxonomies (NLP + RE) → Agent safety evaluation → Policy specification quality. Position vs DRIP-R\n118\t- **§3 Taxonomy**: 2-layer, 6-type taxonomy with cross-walk to Li et al. + Massey et al. + DRIP-R\n119\t- **§4 Method**: Matched-pair causal design, τ²-bench, 5 models (3 proprietary + 2 open-source), clause generation, perturbation control, cross-judge evaluation\n120\t- **§5 Results**: C1 (binary, +34.0pp, 5 models) → C2 (type hierarchy, 3-tier) → C3 (layer effect, modest but significant) → C4 (model×type interaction — star finding)\n121\t- **§6 Analysis**: C5 error analysis — qualitative failure modes per type. Ambiguity Blindness. Model-specific patterns.\n122\t- **§7 Discussion**: Differential nocuity theory. Safety training selectivity. Disambiguation channel framework. Limitations (2 domains, synthetic injection, LLM-as-judge).\n123\t- **§8 Conclusion**: All policy ambiguity is nocuous, but type AND model jointly determine risk level. Both type-aware auditing and model-specific risk assessment recommended.\n124\t\n125\t## Anticipated Reviewer Concerns\n126\t\n127\t### RC1: \"Type effect could be artifact of taxonomy granularity\"\n128\t**Response**: (a) Layer effect (Spec vs Ling ~19pp gap) is robust — holds even if individual types are reclassified. (b) 2-layer structure grounded in Li et al. + Massey et al. (c) Coreferential's low rate has structural explanation (disambiguation channels), not just noise. (d) TOST confirms types are NOT equivalent (0/15 pairs at ±10pp).\n129\t\n130\t### RC2: \"Taxonomy is ad hoc / why these 6 types\"\n131\t**Response**: 2-layer structure grounded in Li et al. 2024 (11-type NLP) + Massey et al. 2014 (6-type RE). Selection criteria: frequency in policy documents + theoretical distinctiveness. Explicit cross-walk to DRIP-R's 5 types. Operational definition handles ambiguity/vagueness boundary (Wasow 2005, Kennedy 2007).\n132\t\n133\t### RC3: \"Only API models, no open-source\"\n134\t**Response**: ✅ RESOLVED. 5-model coverage spans: frontier proprietary (gpt-5.4, claude-sonnet-4-6) + mid-tier proprietary (gpt-4.1) + open-source MoE (qwen3-235b) + open-source dense (deepseek-v3). Three providers (OpenAI, Anthropic, Chinese open-source). Two architecture types (dense, MoE). Model×type interaction (C4) reveals rich cross-model patterns.\n135\t**Note [Reviewer 2026-05-20]**: Cross-judge asymmetry — Claude judged by gpt-5.4, gpt-5.4 judged by gpt-4.1. Must disclose in Method. plan_009 judge calibration measures this bias.\n136\t\n137\t### RC4: \"Synthetic ambiguity injection lacks ecological validity\"\n138\t**Response**: (a) Matched-pair design requires synthetic control for causal inference. (b) Reviewer-verified quality (Chantree-style). (c) CP clauses use both explicit labeling and naturalistic rule rewrites. (d) Full study mixes formats per Reviewer suggestion. (e) Realism validation: distribution comparison with DRIP-R natural ambiguities.\n139\t\n140\t### RC5: \"τ²-bench limited to retail/airline\"\n141\t**Response**: Acknowledged limitation. Two domains already show consistent effects. Cross-domain transfer is Future Work (Phase 3 classifier PoC, if time permits). DRIP-R also single-domain (retail).\n142\t\n143\t### RC6: \"Binary effect is obvious — of course ambiguity causes errors\"\n144\t**Response**: (a) No prior work quantifies effect SIZE for agent safety. +35-42pp is massive and non-trivial. (b) DRIP-R measures decision quality, not safety violations. (c) Prior work (PolicyBank, PhantomPolicy) studies different failure modes, not ambiguity-specific causation. (d) The interesting finding is C2: type DOES predict severity — specification-layer ambiguities are nearly twice as dangerous, connecting to disambiguation channel availability.\n145\t\n146\t### RC7: \"Incompleteness matched-pair confound (information asymmetry)\"\n147\t**Response**: (a) Dual-track analysis: primary analysis uses ambiguous-only cross-type comparison (avoids confound). (b) Incompleteness pairs constrained to minimal information addition. (c) Explicitly discussed as limitation for within-type effect size.\n148\t\n149\t### RC8: \"RC attachment in coreferential overlaps with scopal / structural ambiguity\"\n150\t**Response**: (a) Our scopal category is explicitly scoped to quantifier/negation/modal scope interactions, not syntactic attachment. (b) RC attachment in policies manifests as *referential* confusion (which entity does the clause modify?) not *scope* confusion (which operator takes wide scope?). (c) Li et al. 2024 distinguishes syntactic ambiguity (including RC attachment) from scopal ambiguity — our grouping follows their treatment that RC attachment is closer to coreferential than scopal in terms of downstream interpretation. (d) Empirically, if the distinction were problematic, coreferential and scopal would show identical violation patterns — the error analysis (C5) can test whether their failure modes differ.\n151\t\n152\t### RC9: \"authorization_scope is just a subtype of incompleteness\"\n153\t**Response**: (a) Incompleteness = missing conditions/exceptions/boundaries (structural absence). Authorization scope = ambiguous permission/role boundaries that ARE stated but vague (e.g., \"authorized personnel\" without specifying which functions). (b) The disambiguation pattern differs: incompleteness adds new conditions; auth_scope clarifies existing permission boundaries. (c) Empirically testable: if they were the same, their violation patterns and failure modes (C5) would be indistinguishable. (d) Report disambiguation length ratio per type as control variable in §4 Method.\n154\t\n155\t### RC10: \"API sampling noise undermines reliability\"\n156\t**Response**: ✅ RESOLVED. plan_006 ICC=0.919 [0.892, 0.940] (excellent). (a) Per-clause violation rates highly reproducible across 3 independent replicates. (b) Binary ICC=0.847 (good). (c) Both models show near-identical ICC (gpt-5.4: 0.921, gpt-4.1: 0.918). (d) Bootstrap CI + ICC double evidence. (e) Previously identified ±8pp noise is within expected variance given the ICC confidence intervals.\n157\t\n158\t### RC11: \"Prompt sensitivity confound\" [Dream A9 — best tier \"strongest point\"]\n159\t**Concern**: The +35-42pp effect is attributed entirely to ambiguity, but without a control condition using non-ambiguity perturbations (synonym substitution, clause reordering), the paper cannot cleanly distinguish ambiguity-specific harm from general prompt brittleness.\n160\t**Response**: ✅ RESOLVED. plan_010 perturbation control (120 episodes): Δ_perturb=3.33pp (CI contains 0) vs ambiguity Δ=36.5pp. Non-ambiguity surface changes cause zero meaningful effect. This is the strongest causal evidence in the agent safety literature.\n161\t\n162\t## Concept Naming (distill insight: 命名即贡献)\n163\t\n164\tCore phenomenon: **\"Differential Nocuity\"** — all policy ambiguity types are nocuous for LLM agents (+34.0pp, all 5 models), but vulnerability varies by BOTH type and model. Incompleteness is universally dangerous (46-62%), while auth_scope vulnerability depends dramatically on safety training (12% Claude to 64% GPT-5.4). Unlike human RE where organizational context renders most ambiguity innocuous, agents lack disambiguation channels AND their safety training creates type-specific blind spots.\n165\t\n166\tSecondary phenomenon: **\"Ambiguity Blindness\"** — agents process grammatically fluent ambiguous clauses without meta-cognitive awareness of the ambiguity, adopting surface interpretations. Contrasts with explicit rule conflicts where agents show awareness and choose conservatively.\n167\t\n168\tTertiary phenomenon: **\"Disambiguation Channel Framework\"** [renamed from \"Hypothesis\" per Dream review SF-5] — the layer hierarchy reflects availability of external disambiguation: linguistic ambiguity (coreferential, lexical) can sometimes be resolved by tool responses, user context, or world knowledge; specification ambiguity (auth_scope, incompleteness) has no external resolution channel, forcing agents to guess. This is an explanatory framework supported by observational evidence (ICC pattern, failure mode distribution, coreferential boundary case), not a tested causal hypothesis. Future Work: manipulation experiment (inject spec-layer disambiguation info into tool responses, test if gap shrinks).\n169\t\n170\tQuaternary phenomenon: **\"Systematic Nocuity\"** [per Dream review SF-7] — B&K framework distinguishes nocuous (divergent interpretations) from innocuous (convergent). Our data reveals a third type: all models converge on the same WRONG interpretation (27% of ambiguous episodes). This is more dangerous than divergent nocuity — it's invisible in inter-model agreement metrics and appears \"correct\" until compared against ground truth. Proposed as B&K extension in Discussion.\n171\t\n172\t## Opening Hook Strategy (distill insight: 具体案例, 不要 \"Recently...\")\n173\t\n174\tOpen with a concrete τ²-bench failure: e.g., a customer returns a customized item within the return window; the agent grants a full refund + free return shipping because the policy says \"items may be returned within 30 days\" (scopal: \"items\" scopes over all categories including custom). The unambiguous version specifies \"standard items only\" — agent correctly refuses. One word of ambiguity → $200 unauthorized refund.\n175\t\n176\t## Narrative Type: 突破局限型 (distill pattern, 5/8 papers)\n177\t\n178\t\"DRIP-R classifies 5 ambiguity types and shows models disagree on interpretation → but does not measure whether this disagreement leads to safety violations. We close this gap — and find the answer is surprising: not all types are equal, specification-layer ambiguities are nearly twice as dangerous as linguistic-layer ones.\"\n179\t\n180\t## Benchmark Comparison Table (distill insight: 必有 feature matrix)\n181\t\n182\t| Feature | DRIP-R | PhantomPolicy | PolicyBank | AgentPex | **Ours** |\n183\t|---------|--------|---------------|------------|----------|----------|\n184\t| Ambiguity taxonomy | 5 RE types | — | 3 gap types | — | **6 types (2-layer)** |\n185\t| Causal design | — | — | — | — | **matched pairs** |\n186\t| Safety violation metric | — | binary | — | procedural | **3-tier severity** |\n187\t| Cross-type comparison | descriptive | — | — | — | **statistical (χ² + V)** |\n188\t| Models tested | 6 API | 4 API | 2 API | 2 API | **3 API + 2 open-source** |\n189\t| Domain | retail | mixed | retail | telecom/retail/airline | **retail + airline** |\n190\t\n191\t## Contribution Positioning (for EMNLP) [revised 2026-05-20 with 5-model data]\n192\t\n193\t1. **Causal quantification of ambiguity's safety impact**: First matched-pair causal study of policy ambiguity → agent safety violations. Binary effect +34.0pp (OR=15.1, p<0.0001) across 5 architecturally diverse models and 6 ambiguity types. Perturbation control (Δ_perturb=3.33pp) confirms ambiguity-specific causation. Strongest causal evidence in the agent safety literature.\n194\t2. **Differential Nocuity framework + Model × Type Interaction**: Not all ambiguity is equally dangerous, and not all models are equally vulnerable. 3-tier type hierarchy (incompleteness >> mid cluster >> coreferential). Model × type interaction reveals 52pp range in auth_scope vulnerability (Claude 12% → GPT-5.4 64%), while incompleteness remains universally dangerous (46-62%). Safety training differentially mitigates specific ambiguity types. Connects Berry & Kamsties nocuous ambiguity theory to modern safety alignment.\n195\t3. **Type-specific failure mode taxonomy + Ambiguity Blindness**: 245 traces across 2 models and 2 domains reveal type-diagnostic failure signatures: spec-layer → guess-and-act (unauthorized_escalation, assumption_based_action); ling-layer → misparse-and-apply (scope_misapplication). Agents show <5-11% awareness of ambiguity (\"Ambiguity Blindness\"), with >88% surface adoption and <1% user escalation. Practical implication: ambiguity detection must be externalized.\n196\t\n197\tNOTE: C3 (layer effect, Δ=6.08pp) is a component finding supporting contribution #2. The MODEL × TYPE interaction (C4) is now MORE central than the layer main effect. \"Disambiguation channel\" is an explanatory framework (not hypothesis — per SF-5). DeBERTa classifier, if included, is a preliminary PoC appendix, not a contribution.\n198\t\n199\t## Required Reference Expansion [Dream A2 + MF-4 RE literature gap]\n200\t\n201\tCurrent plan has thin references. Must add (≥25 total in final paper):\n202\t- **Nocuous ambiguity detection (CRITICAL — MF-4)**: Chantree, Nuseibeh, de Roeck & Willis (2006, ASE) — first computational nocuous ambiguity detection; Chantree et al. (2008, RLAC) — expanded. Direct lineage to our DeBERTa classifier.\n203\t- **Cross-domain RE ambiguity**: Ferrari, Spagnolo & Gnesi (2017-2019, ASE) — NLP-based cross-domain ambiguity detection. NLP4RE community work.\n204\t- **Good-enough processing**: Ferreira, Bailey & Ferraro (2002); Ferreira & Patson (2007)\n205\t- **LLM garden-path (SF-6)**: Li et al. (2024) — incremental comprehension of garden-path sentences by LLMs. Directly relevant to how LLMs process ambiguity.\n206\t- **Anaphoric ambiguity (SF-6)**: Poesio & Artstein (2005, 2008) — annotation of anaphoric ambiguity. Poesio (2004) \"Ambiguity\" encyclopedia entry.\n207\t- **Surprisal/expectation-based**: Levy (2008); Hale (2001)\n208\t- **Instruction-following robustness**: Zhou et al. (IFEval, 2023); Qin et al. (ToolBench, 2024)\n209\t- **Prompt sensitivity**: Sclar et al. (2024); Lu et al. (2022)\n210\t- **Broader agent safety**: R-Judge, ToolEmu, InjecAgent\n211\t- **Formal semantics of vagueness**: Lassiter & Goodman (2017)\n212\t- **Garden-path**: Frazier & Rayner (1982)\n213\t- **Ambiguity detection**: Willis et al. (2008); Ezzini et al. (TAPHSIR, 2022)\n214\t- **Year verification needed**: Massey et al. — §1 引用 2013 vs 后文 2014, 需确认正确年份\n215\t\n216\t## Code/Data Release Plan [Dream A6 — three-tier consistent]\n217\t\n218\tMust commit to releasing:\n219\t1. All 300 clause pairs (ambiguous + unambiguous variants) with type labels\n220\t2. Evaluation scripts (τ²-bench integration, cross-judge pipeline)\n221\t3. Statistical analysis code (all tests, bootstrap CI computation)\n222\t4. Agent trace samples (anonymized) for reproducibility of C5\n223\t\n224\t## Figure Plan [Dream A12]\n225\t\n226\tMinimum figures for paper (zero-figure paper flagged in dream):\n227\t1. **Figure 1**: System architecture / experimental pipeline overview (§4 Method)\n228\t2. **Figure 2**: Forest plot — per-type binary effect sizes with 95% CI (§5 C1)\n229\t3. **Figure 3**: Model × Type heatmap — violation rates across 4 models × 6 types (§5 C4)\n230\t4. **Figure 4**: Visibility mechanism — CP vs scopal violation rates + trace evidence (§5 C3)\n231\t5. **Figure 5**: Failure mode × type stacked bar/Sankey — per-type failure mode distribution (§6 C5)\n232\t6. **Figure 6**: Cross-model failure mode consistency — side-by-side gpt-5.4 vs gpt-4.1 per-type distributions showing 5/6 convergence (§6 C5, supports C4)\n233\t7. **Figure 7**: Annotated trace pair — CP (conflict detection) vs scopal (surface adoption) (§6 C5)\n234\t\n235\t## Berry & Kamsties Operationalization Note [Dream best Q5]\n236\t\n237\tBerry & Kamsties define nocuity as inter-reader divergence. Our design measures agent-vs-intent deviation. Full study should additionally test whether different models adopt different readings of the same ambiguous clause (true inter-model nocuity). If 4 models produce 4 different interpretations of the same clause → true nocuity. If all 4 adopt the same wrong interpretation → systematic bias, still nocuous but for different reason. Report inter-model agreement on ambiguous clauses as supplementary analysis.\n238\t\n239\t## Contingency Framing [RESOLVED — Scenario C occurred]\n240\t\n241\t> plan_002 结果: Scenario C 发生（omnibus p=0.0001, 所有类型 nocuous 但 severity 有显著差异）。\n242\t> Framing 已 pivot 到 \"Differential Nocuity\" + \"Layer Hierarchy\" (D020)。本节仅保留历史记录。\n243\t\n244\t## Claude Baseline — RESOLVED [2026-05-20]\n245\t\n246\t✅ Claude works via OpenRouter proxy (47.94.22.126/v1) with provider prefix `anthropic/claude-sonnet-4-6`. 600 episodes complete (plan_002c). Claude shows lowest overall vulnerability (30.3%) and remarkable auth_scope robustness (12% vs GPT-5.4 64%).\n247\t"}]},"parent_tool_use_id":null,"session_id":"6e7cad25-f855-4262-997e-21bd6a9a3d73","uuid":"8b53ade9-cf53-4d0e-8031-372a51ccfc2a","timestamp":"2026-05-21T04:54:40.378Z","tool_use_result":{"type":"text","file":{"filePath":"/home/ubuntu/.agent-ml-research-be-idea-gen-0519-4/projects/policy_ambiguity_safety/artifacts/dream_reports/dream_20260521T041241/best/paper_framing.md","content":"# Paper Framing — policy_ambiguity_safety\n\n> 最后更新: 2026-05-20 19:30 UTC | 状态: 5-model analysis complete, C3/C4 framing revised\n> 目标: EMNLP 2026 (ARR Aug cycle, DDL ~Aug 3)\n> Dream: dream_20260520T112859 — best 3.5 / median 3.0 / worst 2.5 (pre-pivot; re-dream needed)\n> 5-model: 2,997 episodes, C1 confirmed (+34.0pp, 5 models), C4 upgraded (model×type interaction)\n\n## Core Insight\n\nPolicy ambiguity universally causes massive safety violations in LLM agents (+34.0pp across 5 architecturally diverse models), with a significant type hierarchy (incompleteness 53.6% >> coreferential 31.6%). Specification-layer types are more dangerous on average (Δ=6.08pp, p=0.017), but the deeper finding is a **model × type interaction**: authorization scope vulnerability varies 52pp across models (12% Claude to 64% GPT-5.4), revealing that safety training differentially mitigates specific ambiguity types, while incompleteness remains universally dangerous. This interaction connects Berry & Kamsties' nocuous ambiguity theory to modern safety alignment and suggests both type-aware triage AND model-aware risk assessment.\n\n## Title (Working)\n\n\"Not All Policy Ambiguity Is Equal: Differential Vulnerability Profiles Across LLM Agent Families\"\n\nAlternative: \"Differential Nocuity: How Ambiguity Type and Model Architecture Shape Safety Violations in LLM Agents\"\n\nNote: Pivoted from \"Uniformly Nocuous\" → \"Specification-Layer Dominant\" (2-model) → \"Differential Nocuity with Model Interaction\" (5-model). The model × type interaction is the novel finding that elevates the paper beyond simple effect demonstration.\n\n## Core Claims\n\n### C1: Binary Effect (PRIMARY — confirmed, 5 models)\nAmbiguous policy specifications cause massive safety violation rate increases compared to unambiguous matched variants. Effect: +34.0pp (5-model), McNemar OR=15.1 (CI: [10.78, 21.17]), p<0.0001. Holds across all 6 types and all 5 models.\n- **Evidence**: 2,997 episodes across 5 models × 6 types × 2 conditions. Bootstrap CI: [+31.2pp, +36.9pp].\n- **Per-model**: Claude +25.7pp, Qwen3 +32.4pp, GPT-4.1 +34.7pp, GPT-5.4 +38.3pp, DeepSeek +39.0pp — all p<10^-17.\n- **Strength**: Extremely strong. Replicated across 5 architecturally diverse models (proprietary dense, open-source MoE, open-source dense), 6 types, 2 domains. No exceptions.\n- **Causal backing**: Matched-pair design + perturbation control (plan_010, Δ_perturb=3.33pp, PASS) → strongest causal inference in the literature.\n- **Logistic regression**: condition_amb coef=2.278, z=19.65, p<0.001 — ambiguity is the dominant predictor even after controlling for token delta, model, and type.\n\n### C2: Type Hierarchy (SECONDARY — confirmed, 5 models)\n**PIVOTED from uniformity null.** 6-type hierarchy significant: omnibus χ²=28.02, p=3.6×10^-5, V=0.137 (small but well-powered: actual power=0.993, MDE=0.093). 3-tier structure emerges from TOST analysis.\n- **Evidence**: 2,997 episodes (5 models × 6 types × 2 conditions, ambiguous only: 1,499 episodes)\n  - **High tier**: incompleteness 53.6% (standout — universally dangerous across all models)\n  - **Mid tier**: lexical 42.8%, auth_scope 41.6%, scopal 39.4%, CP 36.8% — pairwise equivalent at ±15pp\n  - **Low tier**: coreferential 31.6% (lowest — partial disambiguation via tool responses)\n- **TOST structure**: ±15pp: 8/15 equivalent, 7/15 non-equivalent. ±10pp: 4/15 equivalent, 11/15 non-equivalent. Types are NOT interchangeable.\n- **V=0.137 context**: Below 0.20 threshold but well-powered (power=0.993). The type effect is real but small — the 3-tier structure captures it better than a single V statistic. The heterogeneity is driven by the extremes (incompleteness 53.6% vs coreferential 31.6% = 22pp gap).\n- **Coreferential as boundary case**: 31.6% violation rate is the lowest but still substantial (+18.7pp vs unambiguous). Agents partially disambiguate via tool responses and cautious strategies. Conservative_refusal rate 6-11% (vs avg 2-3%).\n- **Model-dependence of type rankings**: Type rankings are NOT identical across models. Incompleteness is top-2 for ALL models, but auth_scope ranges from #1 (GPT-5.4, DeepSeek) to #6 (Claude). See C4.\n\n### C3: Layer Effect (TERTIARY — suggestive, fragile under within-judge analysis)\n**[2026-05-20 REVISED with 5-model data + within-judge check]** Specification-layer ambiguities cause more violations than linguistic-layer on average, but the effect is modest, model-dependent, and fragile under subgroup analysis.\n- **Evidence (5-model aggregate)**: Spec 44.0% vs Ling 37.9%, Δ=6.08pp, CI [1.14, 11.02], χ²=5.73, p=0.017, V=0.062 (small), OR=1.29 [1.05, 1.58].\n- **Within-judge fragility**: gpt-4.1 judged group (gpt-5.4+DeepSeek): Δ=+8.0pp, p=0.059 (marginal). gpt-5.4 judged group (gpt-4.1+Claude+Qwen3): Δ=+4.8pp, p=0.157 (n.s.). Pooled significance may partly reflect between-judge variance or insufficient within-group power. Paper表述: \"suggestive\" or \"a moderate tendency,\" NOT \"confirmed.\" Disclose within-judge non-significance in Limitations.\n- **Per-model layer gaps** (THE KEY FINDING — feeds C4):\n  - GPT-5.4: +14.0pp (spec 48.0% vs ling 34.0%) — strong\n  - GPT-4.1: +12.0pp (spec 46.7% vs ling 34.7%) — strong\n  - Claude: +3.3pp (spec 32.0% vs ling 28.7%) — weak\n  - DeepSeek: +2.0pp (spec 50.7% vs ling 48.7%) — negligible\n  - Qwen3: -0.9pp (spec 42.7% vs ling 43.6%) — reversed!\n- **Root cause**: auth_scope is the primary driver. GPT models have extremely high auth_scope rates (46-64%), inflating their spec-layer average. Claude (12%) and Qwen3 (26%) have low auth_scope, so their spec-layer advantage disappears.\n- **Framing decision**: C3 is NOT \"spec-layer nearly twice as dangerous\" (that was 2-model artifact). The correct framing is: \"Specification-layer types are significantly more dangerous on average (Δ=6.08pp, p=0.017), but this aggregate masks a model × type interaction where the gap varies from +14pp (GPT-5.4) to -1pp (Qwen3). The interaction, not the main effect, is the theoretically interesting finding (see C4).\"\n- **Info delta as mediator** [MF-2]: Token delta significant in 5-model logistic regression (coef=0.022, z=3.49, p=0.0005). Spec-layer clauses require more tokens to disambiguate (auth_scope 36.1, incomp 34.6 vs coref 7.8 tokens). Info delta partially mediates but doesn't eliminate the condition effect (condition_amb coef=2.278 dominates).\n- **Layer overlap persists**: CP (36.8%, spec) < scopal (39.4%, ling). Mid-tier cluster spans both layers. Layer effect is driven by extremes: incompleteness (53.6%, spec) vs coreferential (31.6%, ling).\n- **ICC convergent evidence** [plan_006]: Per-type ICC mirrors layer hierarchy — Ling-layer ICC all excellent (scopal 0.989, lexical 0.981, coref 0.976), Spec-layer ICC all good (auth 0.857, CP 0.856, incomp 0.807). Spec-layer less reproducible — agents guess differently each run when external disambiguation channels are absent.\n- **CL connection**: Parallels pragmatics vs semantics distinction. Good-enough processing (Ferreira et al. 2002). Disambiguation channel framework: linguistic ambiguity has partial external resolution; specification ambiguity forces guessing.\n\n### C4: Model × Type Interaction (UPGRADED — star finding, 5 models complete)\n**[2026-05-20 DEFINITIVE, 5/5 models]** Models show significantly different vulnerability profiles despite universal binary effect. The interaction is the paper's most novel finding.\n- **Model main effect**: Overall χ²=31.02, p=3.0×10^-6, V=0.102. Ambiguous-only: χ²=24.01, p=7.9×10^-5.\n  - Vulnerability ranking: Claude 30.3% < GPT-5.4 41.0% ≈ GPT-4.1 40.7% < Qwen3 43.1% < DeepSeek 49.7%\n  - Bootstrap CI confirms: Claude significantly lower than all others; DeepSeek significantly higher than GPT models.\n- **Model × Type interaction matrix** (ambiguous condition, violation rates):\n  ```\n  Type                  GPT-5.4  GPT-4.1  Claude  Qwen3   DeepSeek\n  authorization_scope     64%     46%      12%     26%     60%\n  conditional_precedence  34%     36%      36%     40%     38%\n  incompleteness          46%     58%      48%     62%     54%\n  lexical                 42%     34%      32%     52%     54%\n  coreferential           18%     32%      22%     42%     44%\n  scopal                  42%     38%      32%     37%     48%\n  ```\n- **Key interaction patterns**:\n  - **auth_scope**: 52pp range (Claude 12% → GPT-5.4 64%). The MODEL-DIFFERENTIATING type. Claude's RLHF appears to specifically train authorization boundary awareness.\n  - **coreferential**: 26pp range (GPT-5.4 18% → DeepSeek 44%). Second most model-dependent. Open-source models struggle more with referential ambiguity.\n  - **incompleteness**: Universally high (46-62%, 16pp range). ALL models fail on missing information — safety training doesn't help when information literally isn't there.\n  - **CP**: Most model-invariant (34-40%, 6pp range). Explicit rule conflicts treated similarly by all architectures.\n- **Per-model type χ²** (which models show type-specific vulnerability patterns):\n  - GPT-5.4: χ²=23.44, p=0.0003, V=0.28 — strongest type differentiation (very high auth_scope, very low coref)\n  - Claude: χ²=17.87, p=0.003, V=0.24 — strong differentiation (very low auth_scope, moderate others)\n  - Qwen3: χ²=15.89, p=0.007, V=0.23 — moderate differentiation (high incomp+lex, low auth_scope)\n  - GPT-4.1: χ²=9.89, p=0.078, V=0.18 — borderline\n  - DeepSeek: χ²=6.31, p=0.277, V=0.14 — NOT significant (uniformly high across all types)\n- **Fleiss κ = 0.384 (fair agreement)**: Models only moderately agree on which specific clauses trigger violations. The binary effect is universal, but the WHICH-clauses question is model-dependent.\n- **Theoretical implications**: (1) Safety training differentially addresses specific ambiguity types — Claude's auth_scope robustness suggests authorization boundary handling was explicitly or implicitly trained. (2) Incompleteness is a \"safety training blind spot\" — all models fail equally. (3) DeepSeek's uniform vulnerability suggests less type-specific safety training.\n- **Framing**: C4 from \"models agree\" → \"Models show systematically different vulnerability profiles. The binary effect is universal, but HOW models fail depends on the intersection of ambiguity type and safety training approach. auth_scope is the canary type — most sensitive to safety training quality.\"\n- **Evidence from plan_005**: 2-model failure modes consistent (5/6 dominant modes identical). 5-model failure mode analysis pending.\n- **Layer effect moderation**: C3's aggregate layer gap (6.08pp) is driven by GPT models' high auth_scope rates. The layer effect is itself model-dependent (GPT +12-14pp, Claude +3pp, Qwen3 reversed), making the MODEL × TYPE interaction more fundamental than the LAYER main effect.\n\n### C5: Error Analysis (CONFIRMED — EMNLP core)\nDifferent ambiguity types produce qualitatively different failure modes with type-specific signatures. plan_005 (123+122 violation traces across gpt-5.4 and gpt-4.1, confidence=0.94).\n- **Evidence**: plan_005 complete (gpt-5.4: 123 traces, gpt-4.1: 122 traces). Key findings:\n  - **Type-specific failure signatures**: auth_scope → unauthorized_escalation (72%/83%); incompleteness → assumption_based_action (61%/66%); scopal → scope_misapplication (76%/74%); lexical → assumption_based_action (71%/53%); CP → scope_misapplication (41%/28%) + arbitrary_rule_selection (29%/28%); coreferential → scope_misapplication (44%) / assumption_based_action (38%)\n  - **Cross-model consistency**: 5/6 types share the same dominant failure mode across gpt-5.4 and gpt-4.1. Only coreferential diverges (scope_misapplication vs assumption_based_action). Overall mode distribution nearly identical: both ~33% assumption_based_action, ~26-32% unauthorized_escalation, ~25-28% scope_misapplication. Failure mode profiles are type-specific, not model-specific.\n  - **Layer mechanism**: Ling-layer dominated by scope_misapplication (39% ling avg vs 15% spec avg) = \"misparse\"; Spec-layer dominated by unauthorized_escalation + assumption_based_action = \"active guessing\" → explains higher violation rates\n  - **Ambiguity Blindness empirically confirmed**: awareness rate gpt-5.4=4.1%, gpt-4.1=10.7% (both very low); surface_adoption >88% all types both models; escalate_to_user <1%. Nuance: gpt-4.1 (mid-tier) shows 2.6× higher awareness than gpt-5.4 (frontier) — awareness may inversely correlate with action-orientation (frontier models more \"confident,\" act without hesitation)\n  - **Cross-domain consistency**: airline vs retail failure mode profiles Δ < 13pp (unauthorized_escalation shows largest domain effect: retail 38.6% vs airline 26.1%)\n  - **Coreferential boundary**: conservative_refusal 6-11% (vs avg 2-3%) partially explains low violation rate — agents sometimes pause rather than guess. N=25 combined traces show no single dominant failure mode (flat distribution: scope_misapplication 32%, assumption_based_action 28%, unauthorized_escalation 16%) — contrasts with other types' sharp signatures, reflecting the diversity of resolution strategies for referential ambiguity\n  - **Lexical surprise**: 53-71% assumption_based_action — agents treat word ambiguity as information gap, not misparse\n- **Automated inter-coder agreement** [MF-5, Reviewer-validated]: Cross-coding 60 traces (gpt-5.4 vs gpt-4.1 as independent coders). 4-category merged: 80% agreement, Cohen's κ=0.594 (moderate). κ deflated by kappa paradox — lexical 91.7% agreement → κ=0.0 (11/12 same label, chance agreement also high), scopal 100% agreement → κ undefined. True disagreement concentrated at unauthorized_escalation ↔ inappropriate_action boundary in auth_scope (κ=0.054) and incompleteness (κ=0.233).\n  - **Reporting strategy** [Reviewer recommendation]: (1) Compute Gwet's AC1 as primary metric (designed for kappa paradox, expected 0.70-0.75); (2) Report 80% agreement + 5/6 dominant mode consistency as headline validity evidence; (3) Report κ honestly with kappa paradox caveat; (4) Auth_scope failure mode: soften to \"dominated by boundary-exceeding behaviors (unauthorized_escalation or inappropriate_action, >90%)\" instead of specific percentages; (5) Fine-grained 6-type as appendix with \"automated coding\" caveat.\n  - **C5 safety**: Ambiguity Blindness (<5-11%), surface_adoption (>88%), layer mechanism (ling→scope vs spec→escalation) all robust. Fine-grained per-type percentages unreliable at κ=0.594. Plan_009 human anchor (20-30 failure mode traces) would upgrade from \"moderate automated\" to validated.\n- **EMNLP value**: Highest. Provides the linguistic WHY behind the quantitative WHAT. Cross-model + cross-domain consistency elevates from anecdotal to systematic finding. \"Ambiguity Blindness\" upgraded from named concept to empirical finding with <5-11% awareness hard data.\n\n## Narrative Structure (CL-first for EMNLP)\n\n### Intro Logic Chain\n1. Agent policies are written in NL → contain ambiguity (established)\n2. Prior work classifies ambiguity types in policies (DRIP-R, Li et al., Massey et al.) but doesn't measure safety impact\n3. Berry & Kamsties (2003): ambiguity is nocuous (divergent interpretations) or innocuous (convergent). In human RE, shared organizational context makes most ambiguity innocuous.\n4. **Gap**: LLM agents lack shared context. Are policy ambiguities nocuous for agents? Does type matter? Does it depend on the model?\n5. **This paper**: First causal, type-granularity, cross-model study. Matched-pair design + perturbation control isolates ambiguity effect. 5 models × 6 types.\n6. **Core findings**: (a) All ambiguity is nocuous (+34.0pp, 5 models), (b) type DOES predict severity — 3-tier hierarchy with incompleteness most dangerous, (c) models show dramatically different vulnerability profiles — auth_scope varies 52pp across models, suggesting safety training differentially addresses ambiguity types, (d) while incompleteness remains universally dangerous, a \"safety training blind spot.\"\n\n### Section Map\n- **§1 Intro**: Gap + contributions (causal map + differential nocuity + model×type interaction)\n- **§2 Related Work**: Ambiguity taxonomies (NLP + RE) → Agent safety evaluation → Policy specification quality. Position vs DRIP-R\n- **§3 Taxonomy**: 2-layer, 6-type taxonomy with cross-walk to Li et al. + Massey et al. + DRIP-R\n- **§4 Method**: Matched-pair causal design, τ²-bench, 5 models (3 proprietary + 2 open-source), clause generation, perturbation control, cross-judge evaluation\n- **§5 Results**: C1 (binary, +34.0pp, 5 models) → C2 (type hierarchy, 3-tier) → C3 (layer effect, modest but significant) → C4 (model×type interaction — star finding)\n- **§6 Analysis**: C5 error analysis — qualitative failure modes per type. Ambiguity Blindness. Model-specific patterns.\n- **§7 Discussion**: Differential nocuity theory. Safety training selectivity. Disambiguation channel framework. Limitations (2 domains, synthetic injection, LLM-as-judge).\n- **§8 Conclusion**: All policy ambiguity is nocuous, but type AND model jointly determine risk level. Both type-aware auditing and model-specific risk assessment recommended.\n\n## Anticipated Reviewer Concerns\n\n### RC1: \"Type effect could be artifact of taxonomy granularity\"\n**Response**: (a) Layer effect (Spec vs Ling ~19pp gap) is robust — holds even if individual types are reclassified. (b) 2-layer structure grounded in Li et al. + Massey et al. (c) Coreferential's low rate has structural explanation (disambiguation channels), not just noise. (d) TOST confirms types are NOT equivalent (0/15 pairs at ±10pp).\n\n### RC2: \"Taxonomy is ad hoc / why these 6 types\"\n**Response**: 2-layer structure grounded in Li et al. 2024 (11-type NLP) + Massey et al. 2014 (6-type RE). Selection criteria: frequency in policy documents + theoretical distinctiveness. Explicit cross-walk to DRIP-R's 5 types. Operational definition handles ambiguity/vagueness boundary (Wasow 2005, Kennedy 2007).\n\n### RC3: \"Only API models, no open-source\"\n**Response**: ✅ RESOLVED. 5-model coverage spans: frontier proprietary (gpt-5.4, claude-sonnet-4-6) + mid-tier proprietary (gpt-4.1) + open-source MoE (qwen3-235b) + open-source dense (deepseek-v3). Three providers (OpenAI, Anthropic, Chinese open-source). Two architecture types (dense, MoE). Model×type interaction (C4) reveals rich cross-model patterns.\n**Note [Reviewer 2026-05-20]**: Cross-judge asymmetry — Claude judged by gpt-5.4, gpt-5.4 judged by gpt-4.1. Must disclose in Method. plan_009 judge calibration measures this bias.\n\n### RC4: \"Synthetic ambiguity injection lacks ecological validity\"\n**Response**: (a) Matched-pair design requires synthetic control for causal inference. (b) Reviewer-verified quality (Chantree-style). (c) CP clauses use both explicit labeling and naturalistic rule rewrites. (d) Full study mixes formats per Reviewer suggestion. (e) Realism validation: distribution comparison with DRIP-R natural ambiguities.\n\n### RC5: \"τ²-bench limited to retail/airline\"\n**Response**: Acknowledged limitation. Two domains already show consistent effects. Cross-domain transfer is Future Work (Phase 3 classifier PoC, if time permits). DRIP-R also single-domain (retail).\n\n### RC6: \"Binary effect is obvious — of course ambiguity causes errors\"\n**Response**: (a) No prior work quantifies effect SIZE for agent safety. +35-42pp is massive and non-trivial. (b) DRIP-R measures decision quality, not safety violations. (c) Prior work (PolicyBank, PhantomPolicy) studies different failure modes, not ambiguity-specific causation. (d) The interesting finding is C2: type DOES predict severity — specification-layer ambiguities are nearly twice as dangerous, connecting to disambiguation channel availability.\n\n### RC7: \"Incompleteness matched-pair confound (information asymmetry)\"\n**Response**: (a) Dual-track analysis: primary analysis uses ambiguous-only cross-type comparison (avoids confound). (b) Incompleteness pairs constrained to minimal information addition. (c) Explicitly discussed as limitation for within-type effect size.\n\n### RC8: \"RC attachment in coreferential overlaps with scopal / structural ambiguity\"\n**Response**: (a) Our scopal category is explicitly scoped to quantifier/negation/modal scope interactions, not syntactic attachment. (b) RC attachment in policies manifests as *referential* confusion (which entity does the clause modify?) not *scope* confusion (which operator takes wide scope?). (c) Li et al. 2024 distinguishes syntactic ambiguity (including RC attachment) from scopal ambiguity — our grouping follows their treatment that RC attachment is closer to coreferential than scopal in terms of downstream interpretation. (d) Empirically, if the distinction were problematic, coreferential and scopal would show identical violation patterns — the error analysis (C5) can test whether their failure modes differ.\n\n### RC9: \"authorization_scope is just a subtype of incompleteness\"\n**Response**: (a) Incompleteness = missing conditions/exceptions/boundaries (structural absence). Authorization scope = ambiguous permission/role boundaries that ARE stated but vague (e.g., \"authorized personnel\" without specifying which functions). (b) The disambiguation pattern differs: incompleteness adds new conditions; auth_scope clarifies existing permission boundaries. (c) Empirically testable: if they were the same, their violation patterns and failure modes (C5) would be indistinguishable. (d) Report disambiguation length ratio per type as control variable in §4 Method.\n\n### RC10: \"API sampling noise undermines reliability\"\n**Response**: ✅ RESOLVED. plan_006 ICC=0.919 [0.892, 0.940] (excellent). (a) Per-clause violation rates highly reproducible across 3 independent replicates. (b) Binary ICC=0.847 (good). (c) Both models show near-identical ICC (gpt-5.4: 0.921, gpt-4.1: 0.918). (d) Bootstrap CI + ICC double evidence. (e) Previously identified ±8pp noise is within expected variance given the ICC confidence intervals.\n\n### RC11: \"Prompt sensitivity confound\" [Dream A9 — best tier \"strongest point\"]\n**Concern**: The +35-42pp effect is attributed entirely to ambiguity, but without a control condition using non-ambiguity perturbations (synonym substitution, clause reordering), the paper cannot cleanly distinguish ambiguity-specific harm from general prompt brittleness.\n**Response**: ✅ RESOLVED. plan_010 perturbation control (120 episodes): Δ_perturb=3.33pp (CI contains 0) vs ambiguity Δ=36.5pp. Non-ambiguity surface changes cause zero meaningful effect. This is the strongest causal evidence in the agent safety literature.\n\n## Concept Naming (distill insight: 命名即贡献)\n\nCore phenomenon: **\"Differential Nocuity\"** — all policy ambiguity types are nocuous for LLM agents (+34.0pp, all 5 models), but vulnerability varies by BOTH type and model. Incompleteness is universally dangerous (46-62%), while auth_scope vulnerability depends dramatically on safety training (12% Claude to 64% GPT-5.4). Unlike human RE where organizational context renders most ambiguity innocuous, agents lack disambiguation channels AND their safety training creates type-specific blind spots.\n\nSecondary phenomenon: **\"Ambiguity Blindness\"** — agents process grammatically fluent ambiguous clauses without meta-cognitive awareness of the ambiguity, adopting surface interpretations. Contrasts with explicit rule conflicts where agents show awareness and choose conservatively.\n\nTertiary phenomenon: **\"Disambiguation Channel Framework\"** [renamed from \"Hypothesis\" per Dream review SF-5] — the layer hierarchy reflects availability of external disambiguation: linguistic ambiguity (coreferential, lexical) can sometimes be resolved by tool responses, user context, or world knowledge; specification ambiguity (auth_scope, incompleteness) has no external resolution channel, forcing agents to guess. This is an explanatory framework supported by observational evidence (ICC pattern, failure mode distribution, coreferential boundary case), not a tested causal hypothesis. Future Work: manipulation experiment (inject spec-layer disambiguation info into tool responses, test if gap shrinks).\n\nQuaternary phenomenon: **\"Systematic Nocuity\"** [per Dream review SF-7] — B&K framework distinguishes nocuous (divergent interpretations) from innocuous (convergent). Our data reveals a third type: all models converge on the same WRONG interpretation (27% of ambiguous episodes). This is more dangerous than divergent nocuity — it's invisible in inter-model agreement metrics and appears \"correct\" until compared against ground truth. Proposed as B&K extension in Discussion.\n\n## Opening Hook Strategy (distill insight: 具体案例, 不要 \"Recently...\")\n\nOpen with a concrete τ²-bench failure: e.g., a customer returns a customized item within the return window; the agent grants a full refund + free return shipping because the policy says \"items may be returned within 30 days\" (scopal: \"items\" scopes over all categories including custom). The unambiguous version specifies \"standard items only\" — agent correctly refuses. One word of ambiguity → $200 unauthorized refund.\n\n## Narrative Type: 突破局限型 (distill pattern, 5/8 papers)\n\n\"DRIP-R classifies 5 ambiguity types and shows models disagree on interpretation → but does not measure whether this disagreement leads to safety violations. We close this gap — and find the answer is surprising: not all types are equal, specification-layer ambiguities are nearly twice as dangerous as linguistic-layer ones.\"\n\n## Benchmark Comparison Table (distill insight: 必有 feature matrix)\n\n| Feature | DRIP-R | PhantomPolicy | PolicyBank | AgentPex | **Ours** |\n|---------|--------|---------------|------------|----------|----------|\n| Ambiguity taxonomy | 5 RE types | — | 3 gap types | — | **6 types (2-layer)** |\n| Causal design | — | — | — | — | **matched pairs** |\n| Safety violation metric | — | binary | — | procedural | **3-tier severity** |\n| Cross-type comparison | descriptive | — | — | — | **statistical (χ² + V)** |\n| Models tested | 6 API | 4 API | 2 API | 2 API | **3 API + 2 open-source** |\n| Domain | retail | mixed | retail | telecom/retail/airline | **retail + airline** |\n\n## Contribution Positioning (for EMNLP) [revised 2026-05-20 with 5-model data]\n\n1. **Causal quantification of ambiguity's safety impact**: First matched-pair causal study of policy ambiguity → agent safety violations. Binary effect +34.0pp (OR=15.1, p<0.0001) across 5 architecturally diverse models and 6 ambiguity types. Perturbation control (Δ_perturb=3.33pp) confirms ambiguity-specific causation. Strongest causal evidence in the agent safety literature.\n2. **Differential Nocuity framework + Model × Type Interaction**: Not all ambiguity is equally dangerous, and not all models are equally vulnerable. 3-tier type hierarchy (incompleteness >> mid cluster >> coreferential). Model × type interaction reveals 52pp range in auth_scope vulnerability (Claude 12% → GPT-5.4 64%), while incompleteness remains universally dangerous (46-62%). Safety training differentially mitigates specific ambiguity types. Connects Berry & Kamsties nocuous ambiguity theory to modern safety alignment.\n3. **Type-specific failure mode taxonomy + Ambiguity Blindness**: 245 traces across 2 models and 2 domains reveal type-diagnostic failure signatures: spec-layer → guess-and-act (unauthorized_escalation, assumption_based_action); ling-layer → misparse-and-apply (scope_misapplication). Agents show <5-11% awareness of ambiguity (\"Ambiguity Blindness\"), with >88% surface adoption and <1% user escalation. Practical implication: ambiguity detection must be externalized.\n\nNOTE: C3 (layer effect, Δ=6.08pp) is a component finding supporting contribution #2. The MODEL × TYPE interaction (C4) is now MORE central than the layer main effect. \"Disambiguation channel\" is an explanatory framework (not hypothesis — per SF-5). DeBERTa classifier, if included, is a preliminary PoC appendix, not a contribution.\n\n## Required Reference Expansion [Dream A2 + MF-4 RE literature gap]\n\nCurrent plan has thin references. Must add (≥25 total in final paper):\n- **Nocuous ambiguity detection (CRITICAL — MF-4)**: Chantree, Nuseibeh, de Roeck & Willis (2006, ASE) — first computational nocuous ambiguity detection; Chantree et al. (2008, RLAC) — expanded. Direct lineage to our DeBERTa classifier.\n- **Cross-domain RE ambiguity**: Ferrari, Spagnolo & Gnesi (2017-2019, ASE) — NLP-based cross-domain ambiguity detection. NLP4RE community work.\n- **Good-enough processing**: Ferreira, Bailey & Ferraro (2002); Ferreira & Patson (2007)\n- **LLM garden-path (SF-6)**: Li et al. (2024) — incremental comprehension of garden-path sentences by LLMs. Directly relevant to how LLMs process ambiguity.\n- **Anaphoric ambiguity (SF-6)**: Poesio & Artstein (2005, 2008) — annotation of anaphoric ambiguity. Poesio (2004) \"Ambiguity\" encyclopedia entry.\n- **Surprisal/expectation-based**: Levy (2008); Hale (2001)\n- **Instruction-following robustness**: Zhou et al. (IFEval, 2023); Qin et al. (ToolBench, 2024)\n- **Prompt sensitivity**: Sclar et al. (2024); Lu et al. (2022)\n- **Broader agent safety**: R-Judge, ToolEmu, InjecAgent\n- **Formal semantics of vagueness**: Lassiter & Goodman (2017)\n- **Garden-path**: Frazier & Rayner (1982)\n- **Ambiguity detection**: Willis et al. (2008); Ezzini et al. (TAPHSIR, 2022)\n- **Year verification needed**: Massey et al. — §1 引用 2013 vs 后文 2014, 需确认正确年份\n\n## Code/Data Release Plan [Dream A6 — three-tier consistent]\n\nMust commit to releasing:\n1. All 300 clause pairs (ambiguous + unambiguous variants) with type labels\n2. Evaluation scripts (τ²-bench integration, cross-judge pipeline)\n3. Statistical analysis code (all tests, bootstrap CI computation)\n4. Agent trace samples (anonymized) for reproducibility of C5\n\n## Figure Plan [Dream A12]\n\nMinimum figures for paper (zero-figure paper flagged in dream):\n1. **Figure 1**: System architecture / experimental pipeline overview (§4 Method)\n2. **Figure 2**: Forest plot — per-type binary effect sizes with 95% CI (§5 C1)\n3. **Figure 3**: Model × Type heatmap — violation rates across 4 models × 6 types (§5 C4)\n4. **Figure 4**: Visibility mechanism — CP vs scopal violation rates + trace evidence (§5 C3)\n5. **Figure 5**: Failure mode × type stacked bar/Sankey — per-type failure mode distribution (§6 C5)\n6. **Figure 6**: Cross-model failure mode consistency — side-by-side gpt-5.4 vs gpt-4.1 per-type distributions showing 5/6 convergence (§6 C5, supports C4)\n7. **Figure 7**: Annotated trace pair — CP (conflict detection) vs scopal (surface adoption) (§6 C5)\n\n## Berry & Kamsties Operationalization Note [Dream best Q5]\n\nBerry & Kamsties define nocuity as inter-reader divergence. Our design measures agent-vs-intent deviation. Full study should additionally test whether different models adopt different readings of the same ambiguous clause (true inter-model nocuity). If 4 models produce 4 different interpretations of the same clause → true nocuity. If all 4 adopt the same wrong interpretation → systematic bias, still nocuous but for different reason. Report inter-model agreement on ambiguous clauses as supplementary analysis.\n\n## Contingency Framing [RESOLVED — Scenario C occurred]\n\n> plan_002 结果: Scenario C 发生（omnibus p=0.0001, 所有类型 nocuous 但 severity 有显著差异）。\n> Framing 已 pivot 到 \"Differential Nocuity\" + \"Layer Hierarchy\" (D020)。本节仅保留历史记录。\n\n## Claude Baseline — RESOLVED [2026-05-20]\n\n✅ Claude works via OpenRouter proxy (47.94.22.126/v1) with provider prefix `anthropic/claude-sonnet-4-6`. 600 episodes complete (plan_002c). Claude shows lowest overall vulnerability (30.3%) and remarkable auth_scope robustness (12% vs GPT-5.4 64%).\n","numLines":247,"startLine":1,"totalLines":247}}}
{"type":"assistant","message":{"model":"claude-opus-4-6","id":"msg_017AjuBEetsf4BABbtmvTRsR","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"Now I have a comprehensive understanding of the experiment data and paper framing. Let me also read the paper-writing-norms skill for guidance on writing style.\n\nLet me now construct the full LaTeX paper. I need to cover all experiments:\n\n1. full_study_clause_generation - Clause generation and validation\n2. new_type_mini_pilot - Mini-pilot for new types\n3. full_study_api - 3 API models study\n4. full_study_opensource - 2 open-source models study\n5. full_study_analysis - Statistical analysis (C1-C4)\n\n\n6. error_analysis - Qualitative analysis (C5)\n7. reliability_test - Test-retest ICC\n8. realism_validation - Ecological validity\n9. judge_calibration - Judge calibration\n10. perturbation_control - Perturbation control\n11. classifier_poc - DeBERTa PoC\n\nThe paper structure should follow the framing with Abstract, Introduction, Related Work, Taxonomy, Method (covering clause generation, matched-pair design, models, evaluation, reliability, realism validation, and judge calibration), and Results sections that present the binary classification findings and qualitative analysis.\n\nNow I'm laying out the remaining sections—Discussion covering differential nocuity and disambiguation channels, Conclusion, and Appendices with the classifier proof-of-concept and pilot data.","signature":""}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":31323,"cache_read_input_tokens":23538,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":31323},"output_tokens":8,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"6e7cad25-f855-4262-997e-21bd6a9a3d73","uuid":"7e1db2fd-abec-4bac-874d-62946c7b230c"}
