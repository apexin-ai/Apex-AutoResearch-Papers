\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces Layer effect by model (\% violation rate, ambiguous condition). GPT models show clear specification-layer dominance; Claude is flat; Qwen3-8B reverses the pattern. Pooled gap is non-significant ($p$=0.14).}}{4}{table.caption.14}\protected@file@percent }
\newlabel{tab:layer}{{7}{4}{Layer effect by model (\% violation rate, ambiguous condition). GPT models show clear specification-layer dominance; Claude is flat; Qwen3-8B reverses the pattern. Pooled gap is non-significant ($p$=0.14)}{table.caption.14}{}}
\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces Type vulnerability ranking by model (highest to lowest violation rate). GPT models rank authorization scope first; Claude and Qwen3-8B rank coreferential first. Pairwise Spearman $\rho $ vs.\ GPT-5.4: GPT-4.1 .94, Qwen3-32B .77, Claude .54, Qwen3-8B .37.}}{5}{table.caption.15}\protected@file@percent }
\newlabel{tab:rank}{{8}{5}{Type vulnerability ranking by model (highest to lowest violation rate). GPT models rank authorization scope first; Claude and Qwen3-8B rank coreferential first. Pairwise Spearman $\rho $ vs.\ GPT-5.4: GPT-4.1 .94, Qwen3-32B .77, Claude .54, Qwen3-8B .37}{table.caption.15}{}}
\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces Inter-model agreement analysis. Ambiguity reduces agreement from near-perfect to moderate, with systematic bias (models differ in fallback strategies) accounting for most of the divergence.}}{5}{table.caption.17}\protected@file@percent }
\newlabel{tab:agreement}{{9}{5}{Inter-model agreement analysis. Ambiguity reduces agreement from near-perfect to moderate, with systematic bias (models differ in fallback strategies) accounting for most of the divergence}{table.caption.17}{}}
