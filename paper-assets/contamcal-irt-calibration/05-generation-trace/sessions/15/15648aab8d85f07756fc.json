ired=True)\\\\n    parser.add_argument(\\\\\\\"--base-data\\\\\\\", type=str, required=True,\\\\n                        help=\\\\\\\"Path to base SFT JSONL file (e.g. sft_dosage_000.jsonl)\\\\\\\")\\\\n    parser.add_argument(\\\\\\\"--dosage\\\\\\\", typ\n…[truncated 3837 chars]"
