{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01C9pp1VKdYh6jAFX4ch65hJ","type":"tool_result","content":"1\t// 2PL + gamma contamination parameter\n2\t// P(y_ij = 1) = inv_logit(a_j * (theta_i - b_j) + gamma * exposure_ij)\n3\t// No guessing (c) or upper asymptote (d) parameters\n4\t\n5\tdata {\n6\t  int<lower=1> N_models;\n7\t  int<lower=1> N_items;\n8\t  array[N_models, N_items] int<lower=0, upper=1> y;\n9\t  matrix[N_models, N_items] exposure;\n10\t}\n11\t\n12\tparameters {\n13\t  vector[N_models] theta;\n14\t  vector<lower=0>[N_items] a;\n15\t  vector[N_items] b;\n16\t  real gamma;\n17\t}\n18\t\n19\tmodel {\n20\t  theta ~ std_normal();\n21\t  a ~ lognormal(0, 0.5);\n22\t  b ~ std_normal();\n23\t  gamma ~ std_normal();\n24\t\n25\t  for (i in 1:N_models) {\n26\t    for (j in 1:N_items) {\n27\t      real eta = a[j] * (theta[i] - b[j]) + gamma * exposure[i, j];\n28\t      y[i, j] ~ bernoulli_logit(eta);\n29\t    }\n30\t  }\n31\t}\n32\t\n33\tgenerated quantities {\n34\t  // Calibrated scores: P(y=1 | exposure=0)\n35\t  array[N_models] real calibrated_score;\n36\t  for (i in 1:N_models) {\n37\t    real total = 0.0;\n38\t    for (j in 1:N_items) {\n39\t      real eta_clean = a[j] * (theta[i] - b[j]);\n40\t      total += inv_logit(eta_clean);\n41\t    }\n42\t    calibrated_score[i] = total / N_items;\n43\t  }\n44\t\n45\t  vector[N_models * N_items] log_lik;\n46\t  {\n47\t    int idx = 0;\n48\t    for (i in 1:N_models) {\n49\t      for (j in 1:N_items) {\n50\t        idx += 1;\n51\t        real eta = a[j] * (theta[i] - b[j]) + gamma * exposure[i, j];\n52\t        log_lik[idx] = bernoulli_logit_lpmf(y[i, j] | eta);\n53\t      }\n54\t    }\n55\t  }\n56\t}\n57\t"}]},"parent_tool_use_id":"toolu_013VQP97AbaYHHTCFdDjKc12","session_id":"d1bd2efb-8d16-4e43-8307-de39852ed51a","uuid":"029ecd8c-ff58-4d31-83fd-17a6d24dcf10","timestamp":"2026-05-14T18:31:25.875Z"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EzWfVWBydypeLkhEZRszMj","type":"tool_result","content":"1\t% EMNLP 2026 ARR submission — acl_latex template\n2\t% Download style files: https://github.com/acl-org/acl-style-files\n3\t\\documentclass[11pt]{article}\n4\t% TODO: uncomment when acl2023.sty is placed in this directory\n5\t% \\usepackage[hyperref]{acl2023}\n6\t\\usepackage{times}\n7\t\\usepackage[hyphens]{url}\n8\t\\usepackage{graphicx}\n9\t\\usepackage{amsmath,amssymb,amsfonts}\n10\t\\usepackage{natbib}\n11\t\\usepackage{booktabs}\n12\t\\usepackage[margin=1in]{geometry}\n13\t\\usepackage{xcolor}\n14\t\\usepackage{microtype}\n15\t\\usepackage{hyperref}\n16\t\n17\t\\title{ContamCal: Post-Hoc Calibration of Benchmark Scores\\\\\n18\tunder Training Data Contamination via\\\\\n19\tContamination-Augmented Item Response Theory}\n20\t\n21\t\\author{Anonymous ARR Submission}\n22\t\n23\t\\begin{document}\n24\t\\maketitle\n25\t\n26\t\\begin{abstract}\n27\t\\textbf{TODO: Abstract to be written after experiments.}\n28\t\\end{abstract}\n29\t\n30\t\\input{introduction}\n31\t\n32\t\\input{related_work}\n33\t\n34\t\\input{method}\n35\t\n36\t\\input{experiments}\n37\t\n38\t% TODO: Discussion, Conclusion\n39\t\n40\t% TODO: switch to acl_natbib when style file is in place\n41\t\\bibliographystyle{plainnat}\n42\t\\bibliography{references}\n43\t\n44\t\\end{document}\n45\t"}]},"parent_tool_use_id":"toolu_017fxG6z6LdHK1aKs9P2najT","session_id":"d1bd2efb-8d16-4e43-8307-de39852ed51a","uuid":"11f3f0cc-8ad5-4543-b09a-68f905be47cd","timestamp":"2026-05-14T18:31:25.563Z"}
