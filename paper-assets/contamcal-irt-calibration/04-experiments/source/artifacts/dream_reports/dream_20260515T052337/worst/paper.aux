\@writefile{lot}{\contentsline {table}{\numberline {10}{\ignorespaces IRT 4PL+$\gamma $ calibration results. MMLU fails to converge ($\hat  {R}$=1.54). GSM8K $\gamma $ is non-significant with realistic signals and MAE is worse than raw baseline. ARC is the only benchmark where $\gamma $ excludes zero with S1-only, but coverage collapses to 63\% and PPP indicates severe misspecification.}}{9}{table.10}\protected@file@percent }
\newlabel{tab:irt-results}{{10}{9}{IRT 4PL+$\gamma $ calibration results. MMLU fails to converge ($\hat {R}$=1.54). GSM8K $\gamma $ is non-significant with realistic signals and MAE is worse than raw baseline. ARC is the only benchmark where $\gamma $ excludes zero with S1-only, but coverage collapses to 63\% and PPP indicates severe misspecification}{table.10}{}}
