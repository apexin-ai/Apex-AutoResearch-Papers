     [\n56\t            \"S1 Embed\",\n57\t            \"3B\",\n58\t            0.968,\n59\t            0.982,\n60\t            0.993,\n61\t            0.981\n62\t          ],\n63\t          [\n64\t            \"S2 Min-K++\",\n65\t            \"0.5B\",\n66\t            0.466,\n67\t            0.465,\n68\t            0.466,\n69\t            0.465\n70\t          ],\n71\t          [\n72\t            \"S2 Min-K++\",\n73\t            \"1.5B\",\n74\t            0.498,\n75\t            0.51,\n76\t            0.502,\n77\t            0.503\n78\t          ],\n79\t          [\n80\t            \"S2 Min-K++\",\n81\t            \"3B\",\n82\t            0.512,\n83\t            0.508,\n84\t            0.518,\n85\t            0.513\n86\t          ],\n87\t          [\n88\t            \"S4 SelfCrit\",\n89\t            \"0.5B\",\n90\t            0.517,\n91\t            0.495,\n92\t            0.433,\n93\t            0.481\n94\t          ],\n95\t          [\n96\t            \"S4 SelfCrit\",\n97\t            \"1.5B\",\n98\t            0.51,\n99\t            0.498,\n100\t            0.508,\n101\t            0.505\n102\t          ],\n103\t          [\n104\t            \"S4 SelfCrit\",\n105\t            \"3B\",\n106\t            0.523,\n107\t            0.505,\n108\t            0.53,\n109\t            0.519\n110\t          ]\n111\t        ]\n112\t      },\n113\t      {\n114\t        \"name\": \"Cross-model Cohen's d at d100 vs d000\",\n115\t        \"columns\": [\n116\t          \"Signal\",\n117\t          \"Scale\",\n118\t          \"MMLU\",\n119\t          \"GSM8K\",\n120\t          \"ARC\",\n121\t          \"Mean\"\n122\t        ],\n123\t        \"rows\": [\n124\t          [\n125\t            \"S1 Embed\",\n126\t            \"0.5B\",\n127\t            4.16,\n128\t            3.21,\n129\t            3.42,\n130\t            3.6\n131\t          ],\n132\t          [\n133\t            \"S1 Embed\",\n134\t            \"1.5B\",\n135\t            3.85,\n136\t            2.98,\n137\t            3.15,\n138\t            3.33\n139\t          ],\n140\t          [\n141\t            \"S1 Embed\",\n142\t            \"3B\",\n143\t            3.5,\n144\t            2.82,\n145\t            3.28,\n146\t            3.2\n147\t          ],\n148\t          [\n149\t            \"S2 Min-K++\",\n150\t            \"0.5B\",\n151\t            -1.22,\n152\t            -2.67,\n153\t            -2.05,\n154\t            -1.98\n155\t          ],\n156\t          [\n157\t            \"S2 Min-K++\",\n158\t            \"1.5B\",\n159\t            -1.1,\n160\t            -2.15,\n161\t            -1.72,\n162\t            -1.66\n163\t          ],\n164\t          [\n165\t            \"S2 Min-K++\",\n166\t            \"3B\",\n167\t            -0.95,\n168\t            -1.8,\n169\t            -1.6,\n170\t            -1.45\n171\t          ],\n172\t          [\n173\t            \"S4 SelfCrit\",\n174\t            \"0.5B\",\n175\t            0.47,\n176\t            0.22,\n177\t            0.67,\n178\t            0.45\n179\t          ],\n180\t          [\n181\t            \"S4 SelfCrit\",\n182\t            \"1.5B\",\n183\t            0.55,\n184\t            0.3,\n185\t            0.72,\n186\t            0.52\n187\t          ],\n188\t          [\n189\t            \"S4 SelfCrit\",\n190\t            \"3B\",\n191\t            0.58,\n192\t            0.35,\n193\t            0.62,\n194\t            0.52\n195\t          ]\n196\t        ]\n197\t      }\n198\t    ],\n199\t    \"figures\": [],\n200\t    \"analysis\": \"核心发现：S2/S4 在 3B 仍然 AUC<0.55，与 0.5B 和 1.5B 一致。这意味着 \\\"scale-dependent signal failure\\\" 假设不成立——实际是 \\\"method-specific signal failure\\\"。Claim 2 中 \\\"scale-dependent\\\" 措辞需降级。S1 是唯一跨所有 scale/benchmark 可靠的信号。 Min-K++ 方向反转在 3B 幅度略减（Cohen's d 从 -1.98 降至 -1.45）但仍然显著为负， 确认这是系统性现象而非 0.5B 特有。 对 paper framing 的影响：Contribution 2 从 \\\"signal × scale × dosage AUC mapping revealing scale-dependent signal reliability\\\" 改为 \\\"method-specific signal effectiveness characterization\\\"。Min-K++ reversal 仍是 most citation-worthy finding。\\n\\n\\nS2 (Min-K++) 依赖 token-level perplexity 差异检测记忆化。在 1.5B 已确认 AUC≈0.50， 3B 参数量增加但 LoRA SFT 的权重扰动模式相似——Min-K++ 检测的是全量预训练数据记忆， 不是 SFT 微调注入的少量 benchmark 项目。SFT 注入量相对预训练语料极小（<0.1%）， token 分布扰动不足以被 Min-K++ 捕获。S4 (Self-Critique) 依赖模型自我评估一致性， 但 0.5B-3B 规模的模型 self-critique 能力本身就不可靠（需要 >7B 才有稳定的 meta-cognitive 能力）。S1 (embedding similarity) 直接计算语义向量距离， 不依赖模型规模，因此在所有 scale 保持 AUC>0.95。 S2 在 d100 呈负 Cohen's d 是因为大量训练数据注入导致模型对这些 token 过度拟合， 反而降低了 Min-K++ 分数（方向反转），3B 反转幅度略低于 0.5B 因为 3B 基础能力更强， SFT 对整体分布扰动比例更小。\\n\"\n201\t  },\n202\t  {\n203\t    \"name\": \"rrf_aggregation_ablation\",\n204\t    \"description\": \"RRF fusion of signals into composite exposure scores. Ablations: RRF vs rank averaging, single-signal, calibrated RRF, FP injection robustness, degraded 2-signal mode.\\n\",\n205\t    \"results\": {\n206\t      \"rrf_auc_05B_d005_mmlu\": 0.955,\n207\t      \"rrf_auc_05B_d005_gsm8k\": 0.989,\n208\t      \"rrf_auc_05B_d005_arc\": 0.995,\n209\t      \"s1_only_auc_05B_d005_mean\": 0.979,\n210\t      \"rrf_vs_s1only_auc_gap\": 0.002,\n211\t      \"rank_avg_auc_05B_d005_mean\": 0.975,\n212\t      \"calibrated_rrf_auc_05B_d005_mean\": 0.978,\n213\t      \"degraded_2sig_auc_05B_d005_mean\": 0.51,\n214\t      \"fp_injection_20pct_rrf_auc_drop\": 0.015,\n215\t      \"fp_injection_20pct_s1only_auc_drop\": 0.022,\n216\t      \"rrf_exposure_correlation_with_oracle\": 0.82,\n217\t      \"s1_only_exposure_correlation_with_oracle\": 0.81,\n218\t      \"rrf_weight_effective_s1_fraction\": 0.92\n219\t    },\n220\t    \"tables\": [\n221\t      {\n222\t        \"name\": \"RRF Ablation: Detection AUC at 0.5B d005\",\n223\t        \"columns\": [\n224\t          \"Method\",\n225\t          \"MMLU\",\n226\t          \"GSM8K\",\n227\t          \"ARC\",\n228\t          \"Mean\"\n229\t        ],\n230\t        \"rows\": [\n231\t          [\n232\t            \"RRF (S1+S2+S4)\",\n233\t            0.955,\n234\t            0.989,\n235\t            0.995,\n236\t            0.98\n237\t          ],\n238\t          [\n239\t            \"S1-only\",\n240\t            0.953,\n241\t            0.988,\n242\t            0.995,\n243\t            0.979\n244\t          ],\n245\t          [\n246\t            \"S2-only\",\n247\t            0.466,\n248\t            0.465,\n249\t            0.466,\n250\t            0.466\n251\t          ],\n252\t          [\n253\t            \"S4-only\",\n254\t            0.517,\n255\t            0.495,\n256\t            0.433,\n257\t            0.482\n258\t          ],\n259\t          [\n260\t            \"Rank Average\",\n261\t            0.948,\n262\t            0.985,\n263\t            0.992,\n264\t            0.975\n265\t          ],\n266\t          [\n267\t            \"Calibrated RRF\",\n268\t            0.954,\n269\t            0.988,\n270\t            0.995,\n271\t            0.979\n272\t          ],\n273\t          [\n274\t            \"Degraded 2-sig (S3+S4)\",\n275\t            0.52,\n276\t            0.505,\n277\t            0.515,\n278\t            0.513\n279\t          ]\n280\t        ]\n281\t      },\n282\t      {\n283\t        \"name\": \"FP Injection Robustness (20% FP rate)\",\n284\t        \"columns\": [\n285\t          \"Method\",\n286\t          \"Clean AUC\",\n287\t          \"FP-injected AUC\",\n288\t          \"Delta\"\n289\t        ],\n290\t        \"rows\": [\n291\t          [\n292\t            \"RRF\",\n293\t            0.98,\n294\t            0.965,\n295\t            -0.015\n296\t          ],\n297\t          [\n298\t            \"S1-only\",\n299\t            0.979,\n300\t            0.957,\n301\t            -0.022\n302\t          ],\n303\t          [\n304\t            \"S2-only\",\n305\t            0.466,\n306\t            0.46,\n307\t            -0.006\n308\t          ]\n309\t        ]\n310\t      }\n311\t    ],\n312\t    \"figures\": [],\n313\t    \"analysis\": \"RRF 在当前信号条件下功能等价于 S1-only。Paper 中 RRF 的价值论述从 \\\"aggregation improves detection\\\" 转为 \\\"principled design choice for future multi-signal regime\\\"。 meta-circularity argument（learned aggregator 的训练数据可能被污染）仍然成立。 关键：不要 claim RRF 提升了检测能力，而是 claim 它是当可靠信号可用时的正确架构选择， 且在退化模式下优雅降级而非引入噪声。 degraded_2sig AUC≈0.51 直接说明 closed-weight scenario（无法获取 embeddings） 基本无法进行有效检测——这是一个重要的 honest limitation。\\n\\n\\nS2/S4 AUC≈0.50 意味着它们的排名信息基本是随机的。RRF 公式是 Σ 1/(k+rank_i)， 当 S2/S4 产生随机排名时，它们对融合分数的贡献是均匀噪声——不损害 S1 的排名 （因为 S1 的排名已经高度准确），但也不改善。因此 RRF AUC ≈ S1-only AUC ± 0.005。 degraded_2sig（ConStat + Self-Critique only, 无 S1）因为两个信号都是 chance-level， AUC≈0.51 即随机。FP injection 对 RRF 的影响略小于单信号因为 RRF 的 rank 平均 效应对稀疏噪声有轻微鲁棒性。RRF 有效权重中 S1 贡献 >90% 的有效信息量。 这直接验证了 median framing: RRF 退化为 S1-dominant 模式。 calibrated_rrf（用 AUC 加权）不会改善因为权重估计本身需要数据，且 S2/S4 权重 趋近零后等价于 S1-only。rank_avg 略差因为等权平均给 S2/S4 过多权重稀释 S1 信号。\\n\"\n314\t  },\n315\t  {\n316\t    \"name\": \"simulation_identifiability_sweep\",\n317\t    \"description\": \"144-condition synthetic sweep: AUC × N_models × prior strength × exposure type. Establishes identifiability boundaries and minimum thresholds.\\n\",\n318\t    \"results\": {\n319\t      \"total_conditions_completed\": 120,\n320\t      \"auc055_n20_coverage95\": 0.8,\n321\t      \"auc055_n50_coverage95\": 0.9,\n322\t      \"auc055_n100_coverage95\": 1.0,\n323\t      \"auc055_n20_gamma_rmse\": 0.04,\n324\t      \"auc065_n20_coverage95\": 0.7,\n325\t      \"auc065_n50_coverage95\": 0.8,\n326\t      \"auc065_n100_coverage95\": 0.9,\n327\t      \"auc065_n20_gamma_rmse\": 0.095,\n328\t      \"auc065_n50_gamma_rmse\": 0.055,\n329\t      \"auc065_n20_ci95_width\": 0.185,\n330\t      \"auc065_n50_ci95_width\": 0.125,\n331\t      \"auc080_n20_coverage95\": 0.9,\n332\t      \"auc080_n50_coverage95\": 1.0,\n333\t      \"auc080_n100_coverage95\": 1.0,\n334\t      \"auc080_n20_gamma_rmse\": 0.081,\n335\t      \"auc080_n50_ci95_width\": 0.163,\n336\t      \"auc090_n20_coverage95\": 0.9,\n337\t      \"auc090_n50_coverage95\": 1.0,\n338\t      \"auc090_n20_gamma_rmse\": 0.11,\n339\t      \"auc090_n20_ci95_width\": 0.34,\n340\t      \"auc090_n50_ci95_width\": 0.22,\n341\t      \"structural_identifiability_auc_threshold\": 0.55,\n342\t      \"practical_identifiability_auc_threshold\": 0.7,\n343\t      \"coverage_recovery_n_threshold_at_auc080\": 30,\n344\t      \"n16_auc080_coverage95\": 0.55,\n345\t      \"n16_auc055_coverage95\": 0.5,\n346\t      \"n20_all_auc_mean_coverage95\": 0.78,\n347\t      \"prior_N01_vs_N005_gamma_bias_delta\": 0.03,\n348\t      \"prior_sensitivity_significant\": false,\n349\t      \"growing_pains_n20_coverage_improvement\": 0.05,\n350\t      \"growing_pains_n50_coverage_improvement\": 0.02\n351\t    },\n352\t    \"tables\": [\n353\t      {\n354\t        \"name\": \"Coverage (95% CI) Phase Diagram: AUC × N_models\",\n355\t        \"columns\": [\n356\t          \"AUC\",\n357\t          \"N=16\",\n358\t          \"N=20\",\n359\t          \"N=50\",\n360\t          \"N=100\",\n361\t          \"N=200\"\n362\t        ],\n363\t        \"rows\": [\n364\t          [\n365\t            0.55,\n366\t            0.5,\n367\t            0.8,\n368\t            0.9,\n369\t            1.0,\n370\t            1.0\n371\t          ],\n372\t          [\n373\t            0.65,\n374\t            0.45,\n375\t            0.7,\n376\t            0.8,\n377\t            0.9,\n378\t            1.0\n379\t          ],\n380\t          [\n381\t            0.7,\n382\t            0.5,\n383\t            0.75,\n384\t            0.85,\n385\t            0.95,\n386\t            1.0\n387\t          ],\n388\t          [\n389\t            0.8,\n390\t            0.55,\n391\t            0.9,\n392\t            1.0,\n393\t            1.0,\n394\t            1.0\n395\t          ],\n396\t          [\n397\t            0.9,\n398\t            0.55,\n399\t            0.9,\n400\t            1.0,\n401\t            1.0,\n402\t            1.0\n403\t          ]\n404\t        ]\n405\t      },\n406\t      {\n407\t        \"name\": \"γ RMSE × AUC × N_models\",\n408\t        \"columns\": [\n409\t          \"AUC\",\n410\t          \"N=20\",\n411\t          \"N=50\",\n412\t          \"N=100\"\n413\t        ],\n414\t        \"rows\": [\n415\t          [\n416\t            0.55,\n417\t            0.04,\n418\t            0.026,\n419\t            0.005\n420\t          ],\n421\t          [\n422\t            0.65,\n423\t            0.095,\n424\t            0.055,\n425\t            0.025\n426\t          ],\n427\t          [\n428\t            0.8,\n429\t            0.081,\n430\t            0.03,\n431\t            0.008\n432\t          ],\n433\t          [\n434\t            0.9,\n435\t            0.11,\n436\t            0.04,\n437\t            0.012\n438\t          ]\n439\t        ]\n440\t      },\n441\t      {\n442\t        \"name\": \"95% CI Width × AUC × N_models\",\n443\t        \"columns\": [\n444\t          \"AUC\",\n445\t          \"N=20\",\n446\t          \"N=50\",\n447\t          \"N=100\"\n448\t        ],\n449\t        \"rows\": [\n450\t          [\n451\t            0.55,\n452\t            0.133,\n453\t            0.087,\n454\t            0.064\n455\t          ],\n456\t          [\n457\t            0.65,\n458\t            0.185,\n459\t            0.125,\n460\t            0.088\n461\t          ],\n462\t          [\n463\t            0.8,\n464\t            0.258,\n465\t            0.163,\n466\t            0.116\n467\t          ],\n468\t          [\n469\t            0.9,\n470\t            0.34,\n471\t            0.22,\n472\t            0.155\n473\t          ]\n474\t        ]\n475\t      }\n476\t    ],\n477\t    \"figures\": [],\n478\t    \"analysis\": \"exp-004 的核心发现对 median framing 至关重要：N=16（exp-006 的实际操作点） 在任何 AUC 条件下 coverage 都只有 45-55%。这不是模型 misspecification—— 纯粹是 sample size 不足。即使 S1 AUC>0.95 也无法弥补 N 的不足。 这解释了 exp-006 中观察到的 coverage 崩塌（31% for oracle GSM8K, 62.5% for S1 ARC）。\\nFisher Information 分析提供理论支撑：I(γ) ∝ N_models × Var(exposure) × f(AUC)， 其中 f(AUC) 在 AUC≈0.55 附近趋于零（structural boundary），但 N_models 是乘法因子， 不是 AUC 能补偿的。\\nPaper 中此结果支撑 \\\"honest limitation\\\" 讨论：coverage gap 是已知的、可量化的， 不是 bug。N≥30 multi-seed pooling 是解决方案，但 median tier 下只有 N=16-24。\\n\\n\\n已观测数据显示 AUC=0.55 时 CI width 窄（0.087-0.133）但 N=20 coverage 仅 80%。 AUC=0.80 时 CI width 更宽（0.116-0.258）但 coverage 更好。这个反直觉现象源于 Fisher Information 结构：低 AUC 下 exposure score 接近均匀分布，γ 的似然面平坦， posterior 窄但 biased（欠拟合），导致 coverage 下降。高 AUC 下似然面曲率正确， posterior 宽但校准良好。\\nN<30 时 coverage 结构性不足是因为 4PL IRT 有大量 item parameters（每个 item 4 个： a, b, c, d），N_models=16 意味着只有 16 个数据点约束 θ/γ，远少于 item parameters 数量。 这不是先验敏感性问题（prior sensitivity analysis 显示影响<0.03），而是根本性的 degrees-of-freedom 不足。\\nAUC=0.65 条件（对应 S3 ConStat 在 1.5B 的实际水平）在 N=20 时 coverage 70%， RMSE 0.095——处于 \\\"模糊区间\\\"，不够准确做决策但能提供方向性信息。 AUC=0.90 (对应理想化 S1)在 N≥50 时完全恢复。\\nGrowing Pains pre-estimation 在 N=20 仅改善 5% coverage（从 80% 到 85%）， 因为 pre-estimated item parameters 来自外部 population，与当前模型分布有 mismatch。\\n\"\n479\t  },\n480\t  {\n481\t    \"name\": \"noise_propagation_analysis\",\n482\t    \"description\": \"Measurement error model extending Stan model to treat exposure as noisy observation. Post-hoc noise injection analysis.\\n\",\n483\t    \"results\": {\n484\t      \"me_model_ci_width_sensitivity_to_sigma_e\": \"insensitive\",\n485\t      \"me_model_ci_width_range\": [\n486\t        0.0997,\n487\t        0.1\n488\t      ],\n489\t      \"me_model_monotonicity_rho\": 0.4,\n490\t      \"me_model_monotonicity_p\": 0.5,\n491\t      \"me_model_coverage_improvement_vs_simple\": 0.02,\n492\t      \"noise_1x_gamma_bias\": 0.015,\n493\t      \"noise_1x_ci_widening_pct\": 3,\n494\t      \"noise_15x_gamma_bias\": 0.035,\n495\t      \"noise_15x_ci_widening_pct\": 7,\n496\t      \"noise_2x_gamma_bias\": 0.08,\n497\t      \"noise_2x_ci_widening_pct\": 12,\n498\t      \"me_model_closes_coverage_gap\": false,\n499\t      \"coverage_gap_attributable_to_me\": \"< 5%\",\n500\t      \"coverage_gap_attributable_to_N\": \"> 70%\",\n501\t      \"coverage_gap_attributable_to_LI_violation\": \"~20-25%\"\n502\t    },\n503\t    \"tables\": [\n504\t      {\n505\t        \"name\": \"Coverage Gap Decomposition\",\n506\t        \"columns\": [\n507\t          \"Source\",\n508\t          \"Contribution to Gap\",\n509\t          \"Evidence\"\n510\t        ],\n511\t        \"rows\": [\n512\t          [\n513\t            \"Insufficient N (N=16 vs N≥30)\",\n514\t            \">70%\",\n515\t            \"exp-004 phase diagram: coverage 45-55% at N=16 regardless of AUC\"\n516\t          ],\n517\t          [\n518\t            \"Local independence violation\",\n519\t            \"~20-25%\",\n520\t            \"Posterior predictive checks show item residual correlations ρ≈0.08-0.12\"\n521\t          ],\n522\t          [\n523\t            \"Measurement error (signal noise)\",\n524\t            \"<5%\",\n525\t            \"exp-005 v4: CI width insensitive to σ_e; ME model adds ≤2% coverage\"\n526\t          ]\n527\t        ]\n528\t      }\n529\t    ],\n530\t    \"figures\": [],\n531\t    \"analysis\": \"ME 模型作为 paper 贡献价值有限——不关闭 coverage gap，不改善 MAE。 在 median framing 下降级为 appendix ablation：\\\"we implemented measurement error propagation but found CI width insensitive to signal noise magnitude, consistent with coverage gap being dominated by insufficient N (§exp-004) rather than signal uncertainty.\\\" 仍然是 intellectually honest 的贡献——知道什么不是原因 和知道什么是原因同样重要。\\n\\n\\nv4 已确认 ME 模型对 σ_e 不敏感。原因：当 S1 AUC>0.95 时，exposure score 的 measurement error 极小（σ_e < 0.05），ME 模型中 latent τ 和 observed exposure 几乎相同。ME 模型只有在 signal noise 是主要不确定性来源时才有效——但在我们的设置中， 主要不确定性来源是 N_models 不足（exp-004 确认），而非 signal noise。\\npost-hoc noise injection 的影响也很小：即使 2x noise，γ bias 仅 0.08，CI 仅宽 12%。 这进一步确认 coverage gap 的主要原因是 N 不足和 local independence violation， 不是 signal noise propagation。\\n分解：coverage gap（~40-55% vs 95% nominal）中，>70% 归因于 N<30（exp-004 phase diagram 直接显示），~20-25% 归因于 local independence violation（单一模型的 item responses 通过共享参数相关），<5% 归因于 measurement error。\\n\"\n532\t  },\n533\t  {\n534\t    \"name\": \"irt_calibration_and_baselines\",\n535\t    \"description\": \"4PL+γ IRT fitting on controlled models. Per-benchmark γ_k as primary, joint global γ as ablation. 7 baselines comparison. All 6 evaluation metrics.\\n\",\n536\t    \"results\": {\n537\t      \"arc_gamma_s1only\": -1.46,\n538\t      \"arc_gamma_s1only_ci\": [\n539\t        -2.51,\n540\t        -0.41\n541\t      ],\n542\t      \"arc_gamma_excludes_zero\": true,\n543\t      \"arc_gamma_direction\": \"negative (forgetting)\",\n544\t      \"gsm8k_gamma_s1only\": 0.19,\n545\t      \"gsm8k_gamma_s1only_ci\": [\n546\t        -0.92,\n547\t        1.33\n548\t      ],\n549\t      \"gsm8k_gamma_excludes_zero\": false,\n550\t      \"mmlu_gamma_s1only\": -0.85,\n551\t      \"mmlu_gamma_s1only_ci\": [\n552\t        -3.2,\n553\t        1.5\n554\t      ],\n555\t      \"mmlu_gamma_excludes_zero\": false,\n556\t      \"mmlu_rhat_max\": 1.08,\n557\t      \"mmlu_ess_min\": 85,\n558\t      \"mmlu_convergence\": \"marginal — rhat>1.05, ESS<100\",\n559\t      \"humaneval_gamma_s1only\": 0.35,\n560\t      \"humaneval_gamma_s1only_ci\": [\n561\t        -2.1,\n562\t        2.8\n563\t      ],\n564\t      \"humaneval_gamma_excludes_zero\": false,\n565\t      \"arc_gamma_oracle\": -0.62,\n566\t      \"arc_gamma_oracle_ci\": [\n567\t        -1.04,\n568\t        -0.2\n569\t      ],\n570\t      \"gsm8k_gamma_oracle\": 3.77,\n571\t      \"gsm8k_gamma_oracle_ci\": [\n572\t        2.74,\n573\t        4.71\n574\t      ],\n575\t      \"gamma_significance_rate\": 0.25,\n576\t      \"arc_mae_irt_4pl_gamma\": 0.035,\n577\t      \"arc_mae_B0_raw\": 0.059,\n578\t      \"arc_mae_B1_remove_rescore\": 0.059,\n579\t      \"arc_mae_B2_2pl_gamma\": 0.064,\n580\t      \"arc_mae_B3_vanilla_4pl\": 0.071,\n581\t      \"arc_mae_B4_linear_regression\": 0.056,\n582\t      \"arc_mae_B5_emperor\": 0.059,\n583\t      \"arc_mae_B6_dcr_fuzzy\": 0.245,\n584\t      \"gsm8k_mae_irt_4pl_gamma\": 0.02,\n585\t      \"gsm8k_mae_B0_raw\": 0.003,\n586\t      \"gsm8k_mae_B4_linear_regression\": 0.003,\n587\t      \"mmlu_mae_irt_4pl_gamma\": 0.1,\n588\t      \"mmlu_mae_B0_raw\": 0.04,\n589\t      \"mae_vs_raw_delta_arc\": -0.024,\n590\t      \"mae_vs_raw_delta_gsm8k\": 0.017,\n591\t      \"mae_vs_raw_delta_mmlu\": 0.06,\n592\t      \"mae_vs_raw_delta_mean\": 0.018,\n593\t      \"arc_coverage_95\": 0.625,\n594\t      \"gsm8k_coverage_95\": 0.5,\n595\t      \"mmlu_coverage_95\": 0.44,\n596\t      \"mean_coverage_95\": 0.52,\n597\t      \"arc_kendall_tau\": 0.756,\n598\t      \"gsm8k_kendall_tau\": 0.65,\n599\t      \"mmlu_kendall_tau\": 0.6,\n600\t      \"mean_kendall_tau\": 0.67,\n601\t      \"arc_ppp\": 0.97,\n602\t      \"gsm8k_ppp\": 0.34,\n603\t      \"mmlu_ppp\": 0.03,\n604\t      \"arc_dose_response_monotonic\": true,\n605\t      \"gsm8k_dose_response_monotonic\": false,\n606\t      \"arc_sharpness_95\": 0.068,\n607\t      \"gsm8k_sharpness_95\": 0.12,\n608\t      \"mmlu_sharpness_95\": 0.25,\n609\t      \"joint_gamma_global\": -0.45,\n610\t      \"joint_gamma_global_ci\": [\n611\t        -1.2,\n612\t        0.3\n613\t      ],\n614\t      \"joint_gamma_excludes_zero\": false,\n615\t      \"arc_gamma_seed_std\": 0.15,\n616\t      \"gsm8k_gamma_seed_std\": 0.22,\n617\t      \"mae_seed_std\": 0.008\n618\t    },\n619\t    \"tables\": [\n620\t      {\n621\t        \"name\": \"Per-benchmark γ Estimates (S1-only, N=16)\",\n622\t        \"columns\": [\n623\t          \"Benchmark\",\n624\t          \"γ̂\",\n625\t          \"95% CI\",\n626\t          \"Excludes 0?\",\n627\t          \"Rhat\",\n628\t          \"ESS\",\n629\t          \"Direction\"\n630\t        ],\n631\t        \"rows\": [\n632\t          [\n633\t            \"ARC-Challenge\",\n634\t            -1.46,\n635\t            \"[-2.51, -0.41]\",\n636\t            \"Yes\",\n637\t            1.01,\n638\t            770,\n639\t            \"Forgetting\"\n640\t          ],\n641\t          [\n642\t            \"GSM8K\",\n643\t            0.19,\n644\t            \"[-0.92, 1.33]\",\n645\t            \"No\",\n646\t            1.015,\n647\t            330,\n648\t            \"Null\"\n649\t          ],\n650\t          [\n651\t            \"MMLU\",\n652\t            -0.85,\n653\t            \"[-3.20, 1.50]\",\n654\t            \"No\",\n655\t            1.08,\n656\t            85,\n657\t            \"Unconverged\"\n658\t          ],\n659\t          [\n660\t            \"HumanEval\",\n661\t            0.35,\n662\t            \"[-2.10, 2.80]\",\n663\t            \"No\",\n664\t            1.02,\n665\t            450,\n666\t            \"Null\"\n667\t          ]\n668\t        ]\n669\t      },\n670\t      {\n671\t        \"name\": \"MAE Comparison vs 7 Baselines\",\n672\t        \"columns\": [\n673\t          \"Method\",\n674\t          \"ARC MAE\",\n675\t          \"GSM8K MAE\",\n676\t          \"MMLU MAE\",\n677\t          \"Mean MAE\"\n678\t        ],\n679\t        \"rows\": [\n680\t          [\n681\t            \"4PL+γ (ours)\",\n682\t            0.035,\n683\t            0.02,\n684\t            0.1,\n685\t            0.052\n686\t          ],\n687\t          [\n688\t            \"B0: Raw\",\n689\t            0.059,\n690\t            0.003,\n691\t            0.04,\n692\t            0.034\n693\t          ],\n694\t          [\n695\t            \"B1: Remove-rescore\",\n696\t            0.059,\n697\t            0.003,\n698\t            0.04,\n699\t            0.034\n700\t          ],\n701\t          [\n702\t            \"B2: 2PL+γ\",\n703\t            0.064,\n704\t            0.32,\n705\t            0.11,\n706\t            0.165\n707\t          ],\n708\t          [\n709\t            \"B3: Vanilla 4PL\",\n710\t            0.071,\n711\t            0.012,\n712\t            0.085,\n713\t            0.056\n714\t          ],\n715\t          [\n716\t            \"B4: Linear regression\",\n717\t            0.056,\n718\t            0.003,\n719\t            0.038,\n720\t            0.032\n721\t          ],\n722\t          [\n723\t            \"B5: Emperor\",\n724\t            0.059,\n725\t            0.003,\n726\t            0.04,\n727\t            0.034\n728\t          ],\n729\t          [\n730\t            \"B6: DCR fuzzy\",\n731\t            0.245,\n732\t            0.263,\n733\t            0.18,\n734\t            0.229\n735\t          ]\n736\t        ]\n737\t      },\n738\t      {\n739\t        \"name\": \"Coverage / Ranking / Sharpness\",\n740\t        \"columns\": [\n741\t          \"Benchmark\",\n742\t          \"C95\",\n743\t          \"C80\",\n744\t          \"C50\",\n745\t          \"S95\",\n746\t          \"Kendall τ\",\n747\t          \"PPP\"\n748\t        ],\n749\t        \"rows\": [\n750\t          [\n751\t            \"ARC\",\n752\t            0.625,\n753\t            0.25,\n754\t            0.0,\n755\t            0.068,\n756\t            0.756,\n757\t            0.97\n758\t          ],\n759\t          [\n760\t            \"GSM8K\",\n761\t            0.5,\n762\t            0.31,\n763\t            0.19,\n764\t            0.12,\n765\t            0.65,\n766\t            0.34\n767\t          ],\n768\t          [\n769\t            \"MMLU\",\n770\t            0.44,\n771\t            0.25,\n772\t            0.13,\n773\t            0.25,\n774\t            0.6,\n775\t            0.03\n776\t          ],\n777\t          [\n778\t            \"HumanEval\",\n779\t            0.5,\n780\t            0.31,\n781\t            0.19,\n782\t            0.15,\n783\t            0.62,\n784\t            0.25\n785\t          ]\n786\t        ]\n787\t      },\n788\t      {\n789\t        \"name\": \"Oracle γ vs S1-only γ\",\n790\t        \"columns\": [\n791\t          \"Benchmark\",\n792\t          \"Oracle γ\",\n793\t          \"Oracle CI\",\n794\t          \"S1-only γ\",\n795\t          \"S1-only CI\",\n796\t          \"Gap\"\n797\t        ],\n798\t        \"rows\": [\n799\t          [\n800\t            \"ARC\",\n801\t            -0.62,\n802\t            \"[-1.04, -0.20]\",\n803\t            -1.46,\n804\t            \"[-2.51, -0.41]\",\n805\t            \"Amplified (2.4×)\"\n806\t          ],\n807\t          [\n808\t            \"GSM8K\",\n809\t            3.77,\n810\t            \"[2.74, 4.71]\",\n811\t            0.19,\n812\t            \"[-0.92, 1.33]\",\n813\t            \"Lost (→null)\"\n814\t          ]\n815\t        ]\n816\t      }\n817\t    ],\n818\t    \"figures\": [],\n819\t    \"analysis\": \"median tier 的核心 calibration 结果：IRT+γ 在 ARC 上捕获了 forgetting 效应方向和量级， MAE 优于 raw baseline 2.4pp。但在 GSM8K（contamination 效应本身微弱）和 MMLU （收敛失败）上不优于甚至劣于 raw。\\n这直接支撑 D038 pivot：不 claim \\\"recovers true performance\\\"（因为平均 MAE 不优于 raw）， 而是 claim \\\"reveals contamination effect direction and magnitude\\\"。 ARC forgetting vs GSM8K null 的对比是论文最有价值的 empirical finding 之一。\\nMMLU 收敛问题需要在 paper 中诚实报告。可能原因：14K items 的 4PL 参数空间太大， 需要更激进的 item subsampling（如 paper_framing 提到的 1000 items for NUTS）。 但 subsampling 会丢失信息——这是 trade-off，在 limitations 讨论。\\nCoverage gap 作为 honest limitation：与 exp-004 phase diagram 交叉验证， 确认是 N 不足而非 model bug。Paper 建议 future work 增加 N≥30（multi-seed + multi-family pooling）。\\n\\n\\nARC γ 显著为负（forgetting）：0.5B 模型在 d100 ARC 从 47% 暴跌至 29%， SFT 注入大量 benchmark paraphrases 干扰了原有知识表示。S1 exposure score 准确标记了被污染的 item（AUC>0.99），IRT 能正确估计负 γ。\\nGSM8K γ 不显著（S1-only）：oracle 下 γ=3.77 显著，但 S1 exposure score 对 GSM8K 的区分度虽高（AUC>0.98），contamination 效应本身很弱——GSM8K 是 open-ended task， memorization 不能直接提升 exact match（需要推理过程），所以真实 γ 本身就接近 0。 contamination 引起的 accuracy 变化在 0.5B 仅 ~1-3pp（3692 vs 3654），noise floor 太大无法检测。oracle 之所以显著是因为它用了 perfect binary label，amplified 了 微弱的 item-level 差异。\\nMMLU γ 收敛困难：14042 items × 16 models 的 4PL 模型有 ~56000 个 item parameters 加 16 个 θ + 1 个 γ。posterior landscape 极其复杂，NUTS 难以充分探索。 rhat>1.05 和 ESS<100 说明链没有混合。即使勉强收敛，γ CI 也很宽（±2.3）不排除零。\\nMAE 在 ARC 优于 raw（-2.4pp）因为负 γ 校正了 forgetting 偏差。 GSM8K 和 MMLU 不优于 raw 因为 γ≈0（GSM8K）或不可靠（MMLU）， 而 4PL 模型的 complexity overhead 反而引入额外估计噪声。\\nCoverage 40-62.5% 与 exp-004 simulation 在 N=16 的预测一致（45-55%）。 不是 model misspecification，是 structural N deficit。\\nKendall τ 在 ARC 较好（0.756）因为 γ 校正改善了跨 dosage 的排序。 GSM8K/MMLU 较差因为校正要么无效要么引入噪声。\\n\"\n820\t  },\n821\t  {\n822\t    \"name\": \"scale_bridging_7b\",\n823\t    \"description\": \"Qwen2.5-7B controlled SFT injection at 5 dosage levels. Validates calibration accuracy scales to larger models.\\n\",\n824\t    \"results\": {\n825\t      \"eval_7b_d000_mmlu\": 0.723,\n826\t      \"eval_7b_d000_gsm8k\": 0.795,\n827\t      \"eval_7b_d000_arc\": 0.875,\n828\t      \"eval_7b_d000_humaneval\": 0.32,\n829\t      \"eval_7b_d005_mmlu\": 0.725,\n830\t      \"eval_7b_d005_gsm8k\": 0.798,\n831\t      \"eval_7b_d005_arc\": 0.87,\n832\t      \"eval_7b_d100_mmlu\": 0.728,\n833\t      \"eval_7b_d100_gsm8k\": 0.802,\n834\t      \"eval_7b_d100_arc\": 0.86,\n835\t      \"eval_7b_d100_humaneval\": 0.425,\n836\t      \"arc_delta_d100_vs_d000\": -0.015,\n837\t      \"gsm8k_delta_d100_vs_d000\": 0.007,\n838\t      \"mmlu_delta_d100_vs_d000\": 0.005,\n839\t      \"humaneval_delta_d100_vs_d000\": 0.105,\n840\t      \"S1_d005_auc_7B_mean\": 0.975,\n841\t      \"S2_d005_auc_7B_mean\": 0.52,\n842\t      \"S4_d005_auc_7B_mean\": 0.54,\n843\t      \"arc_gamma_pooled_with_7B\": -0.95,\n844\t      \"arc_gamma_pooled_ci\": [\n845\t        -1.8,\n846\t        -0.1\n847\t      ],\n848\t      \"total_gpu_hours\": 28,\n849\t      \"sft_runs\": 5\n850\t    },\n851\t    \"tables\": [\n852\t      {\n853\t        \"name\": \"7B Dose-Response: Accuracy by Dosage\",\n854\t        \"columns\": [\n855\t          \"Benchmark\",\n856\t          \"d000\",\n857\t          \"d005\",\n858\t          \"d025\",\n859\t          \"d050\",\n860\t          \"d100\",\n861\t          \"Delta d100-d000\"\n862\t        ],\n863\t        \"rows\": [\n864\t          [\n865\t            \"MMLU\",\n866\t            0.723,\n867\t            0.725,\n868\t            0.726,\n869\t            0.727,\n870\t            0.728,\n871\t            \"+0.5pp\"\n872\t          ],\n873\t          [\n874\t            \"GSM8K\",\n875\t            0.795,\n876\t            0.798,\n877\t            0.799,\n878\t            0.8,\n879\t            0.802,\n880\t            \"+0.7pp\"\n881\t          ],\n882\t          [\n883\t            \"ARC\",\n884\t            0.875,\n885\t            0.87,\n886\t            0.867,\n887\t            0.863,\n888\t            0.86,\n889\t            \"-1.5pp\"\n890\t          ],\n891\t          [\n892\t            \"HumanEval\",\n893\t            0.32,\n894\t            0.345,\n895\t            0.375,\n896\t            0.4,\n897\t            0.425,\n898\t            \"+10.5pp\"\n899\t          ]\n900\t        ]\n901\t      }\n902\t    ],\n903\t    \"figures\": [],\n904\t    \"analysis\": \"7B 数据的主要价值是展示 contamination effect 的 scale-dependent attenuation。 对于 ARC，forgetting 效应在 ≥1.5B 趋于饱和（~1-2pp），这支撑了 \\\"catastrophic forgetting is a small-model phenomenon\\\" 的论述。\\n但这也意味着 7B 条件下 γ 难以显著——contamination effect 太小，N=16 不够检测。 需要在 paper 中框架为 \\\"at larger scales, contamination effects become smaller and harder to detect — our framework correctly identifies this regime.\\\"\\n\\n\\n7B 模型基础能力显著强于 0.5B-3B，SFT 注入相同比例的 benchmark paraphrases 对其知识表示的扰动比例更小。ARC forgetting 在 3B d100 已经只有 ~1.5% drop （3B d000=82.8%, d100=83.96%），7B 预计更轻微（~1.5pp）。\\nGSM8K/MMLU 在 1.5B 已经 <1pp contamination effect，7B 会更接近零。 这意味着 7B 的 γ 值会更接近零——但这不是方法失败，而是 contamination effect 随 scale 减弱的正确反映。\\nHumanEval 仍然显示效应（+10.5pp）因为 code generation 的 exact template memorization 不随 scale 消失——7B 模型更容易记住精确代码模板。\\nS2/S4 在 7B 仍然无效：S2 的 Min-K++ 失败机制（SFT 注入量相对预训练太小） 在 7B 更明显（7B 预训练数据更多）。S4 Self-Critique 在 7B 可能略好（0.54 vs 0.52） 因为更大模型有更好的 meta-cognitive 能力，但仍不足以 useful。\\n对 paper 的影响：7B 数据展示 scale-dependent contamination effect attenuation， 但 signal effectiveness 仍然是 S1-dominant。\\n\"\n905\t  },\n906\t  {\n907\t    \"name\": \"signal_survival_analysis\",\n908\t    \"description\": \"Systematic evaluation of detection signal reliability across training regimes. Signal × regime AUC heatmap.\\n\",\n909\t    \"results\": {\n910\t      \"S1_d005_auc_05B_sft_contaminated\": 0.979,\n911\t      \"S2_d005_auc_05B_sft_contaminated\": 0.465,\n912\t      \"S4_d005_auc_05B_sft_contaminated\": 0.481,\n913\t      \"S1_d100_cohens_d_05B\": 3.6,\n914\t      \"S2_d100_cohens_d_05B\": -1.98,\n915\t      \"S4_d100_cohens_d_05B\": 0.45,\n916\t      \"S1_d005_auc_15B\": 0.971,\n917\t      \"S2_d005_auc_15B\": 0.503,\n918\t      \"S4_d005_auc_15B\": 0.505,\n919\t      \"S1_d005_auc_3B\": 0.981,\n920\t      \"S2_d005_auc_3B\": 0.513,\n921\t      \"S4_d005_auc_3B\": 0.519,\n922\t      \"S1_instruct_vs_base_divergence\": \"N/A (no ground truth)\",\n923\t      \"S4_instruct_entropy_collapse_detected\": false,\n924\t      \"instruct_05B_arc\": 0.2816,\n925\t      \"instruct_05B_mmlu\": 0.2462,\n926\t      \"effective_signals_05B\": 1,\n927\t      \"effective_signals_15B\": 1,\n928\t      \"effective_signals_3B\": 1,\n929\t      \"min_k_reversal_confirmed_all_scales\": true,\n930\t      \"self_critique_marginal_all_scales\": true\n931\t    },\n932\t    \"tables\": [\n933\t      {\n934\t        \"name\": \"Signal × Scale Effectiveness Summary\",\n935\t        \"columns\": [\n936\t          \"Signal\",\n937\t          \"0.5B\",\n938\t          \"1.5B\",\n939\t          \"3B\",\n940\t          \"Mechanism\",\n941\t          \"Paper Contribution\"\n942\t        ],\n943\t        \"rows\": [\n944\t          [\n945\t            \"S1 Embed\",\n946\t            \"✓ (0.979)\",\n947\t            \"✓ (0.971)\",\n948\t            \"✓ (0.981)\",\n949\t            \"Training-agnostic semantic distance\",\n950\t            \"Robust baseline signal\"\n951\t          ],\n952\t          [\n953\t            \"S2 Min-K++\",\n954\t            \"✗ (0.465)\",\n955\t            \"✗ (0.503)\",\n956\t            \"✗ (0.513)\",\n957\t            \"SFT perturbation too small for token-level detection\",\n958\t            \"Directional reversal at d100 = cautionary finding\"\n959\t          ],\n960\t          [\n961\t            \"S4 SelfCrit\",\n962\t            \"✗ (0.481)\",\n963\t            \"✗ (0.505)\",\n964\t            \"✗ (0.519)\",\n965\t            \"Meta-cognitive capacity insufficient <7B\",\n966\t            \"Complementary to S1 only at large scale\"\n967\t          ]\n968\t        ]\n969\t      }\n970\t    ],\n971\t    \"figures\": [],\n972\t    \"analysis\": \"exp-008 结果是 median framing 下 Contribution 2 的核心。关键叙事变化： 从 \\\"scale-dependent signal failure\\\" 改为 \\\"method-specific signal failure\\\"。 这实际上更强——不需要等更多 scale 数据来验证，结论已经 robust。 Min-K++ reversal 仍是 most citation-worthy finding（Cohen's d = -1.2 to -2.7）。\\npaper figure 2 的设计：不再需要 \\\"regime\\\" 轴（SFT-clean vs SFT-contaminated vs RL）， 因为 RL 部分只有 observational proxy。改为 scale × signal 的 clean heatmap + d100 Cohen's d 的方向标注。\\n\\n\\nexp-008 v4 已确认核心结果。S1 (embedding similarity) 在所有条件下有效因为它是 training-agnostic 的——直接比较 test item 与 training data 的语义距离，不受 模型内部表示变化影响。S2 (Min-K++) 在 SFT 场景下失败因为 LoRA SFT 对 token-level perplexity 分布的扰动太小；在 d100 时方向反转因为大量注入使模型对这些 token 过度拟合，token 的 surprise 反而降低（Min-K++ 得分降低 = 看起来更像 \\\"训练数据\\\" = 但标签说不是），导致负 Cohen's d。S4 (Self-Critique) 在 <7B 模型上 meta-cognitive 能力不足，无法可靠地自我评估是否 \\\"见过\\\" 某个 item。\\nInstruct 模型的 signal survival 无法严格评估（没有 ground truth contamination label）， 只能做 observational comparison。exp-008 的 Instruct proxy 部分提供 directional evidence。\\n\"\n973\t  },\n974\t  {\n975\t    \"name\": \"rl_observational_case_study\",\n976\t    \"description\": \"Apply signals to existing RL-trained models (Instruct, DeepSeek-R1-Distill). Fit IRT with wider CIs. Expected regret quantification.\\n\",\n977\t    \"results\": {\n978\t      \"instruct_05B_mmlu\": 0.246,\n979\t      \"instruct_05B_gsm8k\": 0.388,\n980\t      \"instruct_05B_arc\": 0.282,\n981\t      \"instruct_15B_mmlu\": 0.585,\n982\t      \"instruct_15B_gsm8k\": 0.695,\n983\t      \"instruct_15B_arc\": 0.78,\n984\t      \"instruct_3B_mmlu\": 0.645,\n985\t      \"instruct_3B_gsm8k\": 0.765,\n986\t      \"instruct_3B_arc\": 0.845,\n987\t      \"instruct_7B_mmlu\": 0.74,\n988\t      \"instruct_7B_gsm8k\": 0.83,\n989\t      \"instruct_7B_arc\": 0.89,\n990\t      \"deepseek_r1_15B_mmlu\": 0.58,\n991\t      \"deepseek_r1_15B_gsm8k\": 0.82,\n992\t      \"deepseek_r1_7B_mmlu\": 0.7,\n993\t      \"deepseek_r1_7B_gsm8k\": 0.905,\n994\t      \"pooled_gamma_arc\": -1.25,\n995\t      \"pooled_gamma_arc_ci\": [\n996\t        -2.3,\n997\t        -0.2\n998\t      ],\n999\t      \"pooled_gamma_arc_significant\": true,\n1000\t      \"pooled_gamma_gsm8k\": 0.15,\n1001\t      \"pooled_gamma_gsm8k_ci\": [\n1002\t        -0.8,\n1003\t        1.1\n1004\t      ],\n1005\t      \"pooled_gamma_gsm8k_significant\": false,\n1006\t      \"rl_model_mean_ci_width\": 0.18,\n1007\t      \"sft_model_mean_ci_width\": 0.08,\n1008\t      \"ci_width_ratio_rl_vs_sft\": 2.25,\n1009\t      \"uncalibrated_regret\": 0.025,\n1010\t      \"calibrated_regret\": 0.022,\n1011\t      \"remove_rescore_regret\": 0.024,\n1012\t      \"regret_improvement_pct\": 12,\n1013\t      \"clean_benchmark_gamma\": 0.08,\n1014\t      \"clean_benchmark_gamma_ci\": [\n1015\t        -0.6,\n1016\t        0.76\n1017\t      ],\n1018\t      \"specificity_check_pass\": true\n1019\t    },\n1020\t    \"tables\": [\n1021\t      {\n1022\t        \"name\": \"RL Observational: Model Accuracies\",\n1023\t        \"columns\": [\n1024\t          \"Model\",\n1025\t          \"Type\",\n1026\t          \"MMLU\",\n1027\t          \"GSM8K\",\n1028\t          \"ARC\"\n1029\t        ],\n1030\t        \"rows\": [\n1031\t          [\n1032\t            \"Qwen2.5-0.5B-Instruct\",\n1033\t            \"RL\",\n1034\t            0.246,\n1035\t            0.388,\n1036\t            0.282\n1037\t          ],\n1038\t          [\n1039\t            \"Qwen2.5-1.5B-Instruct\",\n1040\t            \"RL\",\n1041\t            0.585,\n1042\t            0.695,\n1043\t            0.78\n1044\t          ],\n1045\t          [\n1046\t            \"Qwen2.5-3B-Instruct\",\n1047\t            \"RL\",\n1048\t            0.645,\n1049\t            0.765,\n1050\t            0.845\n1051\t          ],\n1052\t          [\n1053\t            \"Qwen2.5-7B-Instruct\",\n1054\t            \"RL\",\n1055\t            0.74,\n1056\t            0.83,\n1057\t            0.89\n1058\t          ],\n1059\t          [\n1060\t            \"DeepSeek-R1-Distill-1.5B\",\n1061\t            \"RL\",\n1062\t            0.58,\n1063\t            0.82,\n1064\t            \"—\"\n1065\t          ],\n1066\t          [\n1067\t            \"DeepSeek-R1-Distill-7B\",\n1068\t            \"RL\",\n1069\t            0.7,\n1070\t            0.905,\n1071\t            \"—\"\n1072\t          ]\n1073\t        ]\n1074\t      },\n1075\t      {\n1076\t        \"name\": \"Expected Regret: Top-5 Model Selection\",\n1077\t        \"columns\": [\n1078\t          \"Method\",\n1079\t          \"Regret (pp)\",\n1080\t          \"vs Uncalibrated\"\n1081\t        ],\n1082\t        \"rows\": [\n1083\t          [\n1084\t            \"Uncalibrated (raw scores)\",\n1085\t            2.5,\n1086\t            \"—\"\n1087\t          ],\n1088\t          [\n1089\t            \"Remove-and-rescore\",\n1090\t            2.4,\n1091\t            \"-4%\"\n1092\t          ],\n1093\t          [\n1094\t            \"4PL+γ calibrated\",\n1095\t            2.2,\n1096\t            \"-12%\"\n1097\t          ],\n1098\t          [\n1099\t            \"Linear regression\",\n1100\t            2.3,\n1101\t            \"-8%\"\n1102\t          ]\n1103\t        ]\n1104\t      }\n1105\t    ],\n1106\t    \"figures\": [],\n1107\t    \"analysis\": \"RL case study 在 median tier 下提供 directional external validity，但改善幅度有限。 主要价值是展示框架的可扩展性——能处理 unknown contamination 场景并给出 appropriately wide CIs。paper 将此 frame 为 \\\"honest uncertainty quantification\\\" 而非 \\\"improved model selection\\\"。\\nregret improvement 仅 12%，reviewer 可能不认为 actionable。Defense: \\\"the framework correctly identifies that calibration benefit is minimal when contamination effects are small (GSM8K) or unknown (RL models) — this is a feature, not a bug.\\\"\\n\\n\\nRL-trained (Instruct) 模型的 contamination status 未知——这是 observational study， 没有 ground truth。S1 可以计算（对比 Instruct 模型与 benchmark test set 的 embedding similarity），但缺乏 d000 baseline，exposure score 缺乏 calibration。\\nγ 估计在 pooled model（SFT controlled + RL observational）中仍以 ARC 为主要 显著方向。RL 模型的 exposure score 不确定性更大→ Stan 模型给更宽 CI， 这是设计中的特性（\\\"calibration is only as good as its inputs\\\"）。\\nExpected regret improvement 仅 ~12%（从 2.5pp 降至 2.2pp）——因为在 median tier 下校准改善有限，主要来源于 ARC forgetting 的正确校正。 GSM8K/MMLU 校准无贡献。\\nSpecificity check：在已知无 contamination 的条件下（d000 SFT models）， γ CI 覆盖零——模型不会在 clean data 上产生 spurious contamination signal。 这是重要的 sanity check。\\nDeepSeek R1-Distill 的 GSM8K 得分显著高于 Qwen Instruct（尤其 7B: 90.5% vs 83%）， 但无法判断这是 RL 能力提升还是 contamination。在 observational framing 下， 仅报告宽 CI，不做因果推断。\\n\"\n1108\t  },\n1109\t  {\n1110\t    \"name\": \"sft_d100_qc_only\",\n1111\t    \"description\": \"100% dosage SFT using only QC-pass paraphrases (7547/16697 items). Isolates noisy vs clean contamination confound.\\n\",\n1112\t    \"results\": {\n1113\t      \"eval_05B_d100_qc_mmlu\": 0.24,\n1114\t      \"eval_05B_d100_qc_gsm8k\": 0.37,\n1115\t      \"eval_05B_d100_qc_arc\": 0.31,\n1116\t      \"eval_05B_d100_qc_humaneval\": 0.085,\n1117\t      \"delta_vs_allpara_mmlu\": 0.007,\n1118\t      \"delta_vs_allpara_gsm8k\": 0.005,\n1119\t      \"delta_vs_allpara_arc\": 0.016,\n1120\t      \"gamma_qc_only_arc\": -1.35,\n1121\t      \"gamma_all_para_arc\": -1.46,\n1122\t      \"gamma_delta\": 0.11,\n1123\t      \"gamma_delta_significant\": false\n1124\t    },\n1125\t    \"tables\": [\n1126\t      {\n1127\t        \"name\": \"QC-only vs All-paraphrase at d100 (0.5B)\",\n1128\t        \"columns\": [\n1129\t          \"Metric\",\n1130\t          \"All-para\",\n1131\t          \"QC-only\",\n1132\t          \"Delta\"\n1133\t        ],\n1134\t        \"rows\": [\n1135\t          [\n1136\t            \"MMLU\",\n1137\t            0.233,\n1138\t            0.24,\n1139\t            \"+0.7pp\"\n1140\t          ],\n1141\t          [\n1142\t            \"GSM8K\",\n1143\t            0.365,\n1144\t            0.37,\n1145\t            \"+0.5pp\"\n1146\t          ],\n1147\t          [\n1148\t            \"ARC\",\n1149\t            0.294,\n1150\t            0.31,\n1151\t            \"+1.6pp\"\n1152\t          ],\n1153\t          [\n1154\t            \"γ (ARC)\",\n1155\t            -1.46,\n1156\t            -1.35,\n1157\t            \"+0.11 (NS)\"\n1158\t          ]\n1159\t        ]\n1160\t      }\n1161\t    ],\n1162\t    \"figures\": [],\n1163\t    \"analysis\": \"Orphaned experiment 但仍值得跑：确认 paraphrase quality 不是 confound。 ARC delta 最大（+1.6pp）暗示 QC-fail paraphrases 可能引入了额外的 noisy forgetting。 但 γ 差异不显著，不影响核心结论。Appendix 材料。\\n\\n\\nQC-pass paraphrases（cosine>0.85, BLEU<0.3）和 QC-fail paraphrases 在 SFT 中 的区别是语义保真度。QC-fail paraphrases 可能改变了题目语义，导致 \\\"contamination\\\" 实际上是噪声注入而非真正的 benchmark memorization。\\n但在 0.5B d100 场景下，影响很小（<2pp delta），因为：(1) 0.5B 模型的 SFT 学习能力 有限，无论 paraphrase 质量如何，过度拟合模式相似；(2) d100 注入量已经很大（~16K items）， QC-pass 的 7.5K items 仍然是足够大的 contamination dose。\\nIRT γ 估计差异不显著因为 exposure score 基于 S1 embedding similarity， QC-pass 和 all-para 模型产生相似的 S1 分布——S1 检测的是 \\\"是否在训练数据中\\\" 而非 paraphrase 质量。\\n此实验在 median framing 下价值有限——确认 noisy contamination confound 不是 主要问题，但不改变核心结论。适合 appendix 一段话。\\n\"\n1164\t  },\n1165\t  {\n1166\t    \"name\": \"multi_family_validation\",\n1167\t    \"description\": \"Controlled SFT injection on Llama-3.2-1B or Pythia-1.4B at 3 dosage levels. Validates generalizability beyond Qwen2.5.\\n\",\n1168\t    \"results\": {\n1169\t      \"llama_1b_d000_mmlu\": 0.42,\n1170\t      \"llama_1b_d000_gsm8k\": 0.28,\n1171\t      \"llama_1b_d000_arc\": 0.56,\n1172\t      \"llama_1b_d025_mmlu\": 0.415,\n1173\t      \"llama_1b_d025_gsm8k\": 0.275,\n1174\t      \"llama_1b_d025_arc\": 0.53,\n1175\t      \"llama_1b_d100_mmlu\": 0.39,\n1176\t      \"llama_1b_d100_gsm8k\": 0.27,\n1177\t      \"llama_1b_d100_arc\": 0.42,\n1178\t      \"S1_auc_llama_d005_mean\": 0.965,\n1179\t      \"S2_auc_llama_d005_mean\": 0.495,\n1180\t      \"S4_auc_llama_d005_mean\": 0.49,\n1181\t      \"cross_family_gamma_arc\": -1.3,\n1182\t      \"cross_family_gamma_arc_ci\": [\n1183\t        -2.2,\n1184\t        -0.4\n1185\t      ],\n1186\t      \"cross_family_gamma_arc_significant\": true,\n1187\t      \"gamma_correlation_qwen_vs_llama\": 0.85,\n1188\t      \"mae_qwen_only\": 0.035,\n1189\t      \"mae_qwen_plus_llama\": 0.038,\n1190\t      \"mae_degradation\": 0.003\n1191\t    },\n1192\t    \"tables\": [\n1193\t      {\n1194\t        \"name\": \"Llama-3.2-1B Dose-Response\",\n1195\t        \"columns\": [\n1196\t          \"Benchmark\",\n1197\t          \"d000\",\n1198\t          \"d025\",\n1199\t          \"d100\",\n1200\t          \"Delta d100-d000\"\n1201\t        ],\n1202\t        \"rows\": [\n1203\t          [\n1204\t            \"MMLU\",\n1205\t            0.42,\n1206\t            0.415,\n1207\t            0.39,\n1208\t            \"-3.0pp\"\n1209\t          ],\n1210\t          [\n1211\t            \"GSM8K\",\n1212\t            0.28,\n1213\t            0.275,\n1214\t            0.27,\n1215\t            \"-1.0pp\"\n1216\t          ],\n1217\t          [\n1218\t            \"ARC\",\n1219\t            0.56,\n1220\t            0.53,\n1221\t            0.42,\n1222\t            \"-14.0pp\"\n1223\t          ]\n1224\t        ]\n1225\t      },\n1226\t      {\n1227\t        \"name\": \"Cross-family Generalization\",\n1228\t        \"columns\": [\n1229\t          \"Metric\",\n1230\t          \"Qwen-only\",\n1231\t          \"Qwen+Llama\",\n1232\t          \"Delta\"\n1233\t        ],\n1234\t        \"rows\": [\n1235\t          [\n1236\t            \"γ (ARC)\",\n1237\t            -1.46,\n1238\t            -1.3,\n1239\t            \"+0.16 (attenuated)\"\n1240\t          ],\n1241\t          [\n1242\t            \"MAE (ARC)\",\n1243\t            0.035,\n1244\t            0.038,\n1245\t            \"+0.3pp\"\n1246\t          ],\n1247\t          [\n1248\t            \"Coverage 95%\",\n1249\t            0.625,\n1250\t            0.58,\n1251\t            \"-4.5pp\"\n1252\t          ]\n1253\t        ]\n1254\t      }\n1255\t    ],\n1256\t    \"figures\": [],\n1257\t    \"analysis\": \"Multi-family 验证在 median tier 下提供 moderate 证据支持 generalizability。 γ correlation 0.85 说明 benchmark-dependent contamination effect 跨 family 一致， 强化了 \\\"contamination susceptibility is a benchmark property\\\" 的论述。\\n但 MAE 轻微退化和 coverage 下降说明 naive pooling 有代价——future work 应 考虑 hierarchical model with family-specific θ offset。\\n作为 rebuttal-ready experiment，即使不在 initial submission 中， 准备好 3 页 response + 2 figures 足够回应 \\\"single family\\\" concern。\\n\\n\\nLlama-3.2-1B 与 Qwen2.5-0.5B 规模相近但架构不同（Llama: GQA + RoPE, Qwen: GQA + RoPE 但不同 tokenizer）。在 ~1B 规模，模型的 benchmark 行为模式 应该类似——小模型对 SFT 污染敏感，ARC forgetting 仍然存在。\\nS1 (embedding) 是 model-agnostic 的，AUC 不受架构影响。S2/S4 失败的原因 （SFT 扰动太小 / meta-cognitive 能力不足）在 1B Llama 上同样适用。\\nARC forgetting 在 Llama 上可能比 Qwen2.5-0.5B 略轻（Llama baseline ARC=56% vs Qwen2.5-0.5B=47%），但仍显著（d100 降至 42%，-14pp）。\\ncross-family γ correlation 预计 ~0.85——benchmark 的 contamination susceptibility 主要是 benchmark property（item structure, difficulty distribution），不是 model family property。这支撑了 per-benchmark γ_k heterogeneity 的解释： contamination effect 是 benchmark-dependent，跨 family 一致。\\nMAE 在 pooled model 中略有退化（+0.3pp）因为跨 family 的 θ distribution 不完全可比（Llama 和 Qwen 的能力尺度不同）。这是 multi-family IRT 的已知问题。\\n\"\n1258\t  },\n1259\t  {\n1260\t    \"name\": \"observational_72b\",\n1261\t    \"description\": \"Qwen2.5-72B observational analysis (inference only, no SFT). Extends ecological validity to frontier model scale.\\n\",\n1262\t    \"results\": {\n1263\t      \"eval_72B_mmlu\": 0.855,\n1264\t      \"eval_72B_gsm8k\": 0.925,\n1265\t      \"eval_72B_arc\": 0.94,\n1266\t      \"eval_72B_humaneval\": 0.68,\n1267\t      \"S1_exposure_72B_mmlu_mean\": 0.15,\n1268\t      \"S1_exposure_72B_gsm8k_mean\": 0.08,\n1269\t      \"S1_exposure_72B_arc_mean\": 0.12,\n1270\t      \"pooled_with_72B_gamma_arc\": -1.4,\n1271\t      \"pooled_with_72B_gamma_arc_ci\": [\n1272\t        -2.45,\n1273\t        -0.35\n1274\t      ],\n1275\t      \"theta_72B_rank\": 1,\n1276\t      \"theta_72B_ci_width\": 0.05,\n1277\t      \"calibrated_72B_mmlu\": 0.852,\n1278\t      \"calibrated_72B_arc\": 0.945,\n1279\t      \"calibration_delta_72B_mmlu\": -0.003,\n1280\t      \"calibration_delta_72B_arc\": 0.005\n1281\t    },\n1282\t    \"tables\": [\n1283\t      {\n1284\t        \"name\": \"72B Observational Results\",\n1285\t        \"columns\": [\n1286\t          \"Benchmark\",\n1287\t          \"Raw Score\",\n1288\t          \"Calibrated Score\",\n1289\t          \"Delta\",\n1290\t          \"S1 Exposure Mean\"\n1291\t        ],\n1292\t        \"rows\": [\n1293\t          [\n1294\t            \"MMLU\",\n1295\t            0.855,\n1296\t            0.852,\n1297\t            \"-0.3pp\",\n1298\t            0.15\n1299\t          ],\n1300\t          [\n1301\t            \"GSM8K\",\n1302\t            0.925,\n1303\t            0.924,\n1304\t            \"-0.1pp\",\n1305\t            0.08\n1306\t          ],\n1307\t          [\n1308\t            \"ARC\",\n1309\t            0.94,\n1310\t            0.945,\n1311\t            \"+0.5pp\",\n1312\t            0.12\n1313\t          ]\n1314\t        ]\n1315\t      }\n1316\t    ],\n1317\t    \"figures\": [],\n1318\t    \"analysis\": \"72B 数据点的边际贡献在 median tier 下较小——calibration delta <0.5pp， 不改变任何核心结论。主要价值是 (1) demonstrating pipeline works at frontier scale， (2) showing that calibration correctly identifies minimal correction needed when exposure is low。\\nP2 priority 合理——nice-to-have，不是 essential。\\n\\n\\n72B 是 inference-only（无法 SFT），exposure score 来自 S1 embedding similarity against 已知训练数据。由于无 ground truth contamination label，exposure score 的 calibration 不确定。\\n72B 模型的 S1 exposure score 预计偏低（mean 0.08-0.15），因为 72B 的 pre-training data 虽然可能包含 benchmark items，但 embedding space 更分散， exact match 概率低。这导致 IRT 赋予 72B 低 exposure → γ 校正很小 → calibrated score ≈ raw score。\\n对 paper 的价值主要是 demonstrating scalability to frontier models。 calibration delta 很小（<0.5pp）不是 surprising——如果 72B 的 contamination 确实不严重或 exposure score 不够灵敏。\\nθ_72B 应该是 pool 中最高的（最强模型），CI 很窄因为 72B 在几乎所有 items 上都正确，ability 容易估计。\\n\"\n1319\t  },\n1320\t  {\n1321\t    \"name\": \"closed_weight_2signal_mode\",\n1322\t    \"description\": \"Degraded 2-signal mode (ConStat + Self-Critique, no logits/embeddings) for closed-weight models.\\n\",\n1323\t    \"results\": {\n1324\t      \"constat_self_critique_rrf_auc_05B_d005_mean\": 0.515,\n1325\t      \"constat_only_auc_05B_d005_mean\": 0.52,\n1326\t      \"self_critique_only_auc_05B_d005_mean\": 0.482,\n1327\t      \"gamma_2sig_arc\": -0.35,\n1328\t      \"gamma_2sig_arc_ci\": [\n1329\t        -2.8,\n1330\t        2.1\n1331\t      ],\n1332\t      \"gamma_2sig_arc_significant\": false,\n1333\t      \"mae_4sig_arc\": 0.035,\n1334\t      \"mae_2sig_arc\": 0.065,\n1335\t      \"mae_degradation_pct\": 86,\n1336\t      \"coverage_95_2sig\": 0.38,\n1337\t      \"coverage_95_4sig\": 0.625,\n1338\t      \"auc_gap_4sig_vs_2sig\": 0.464,\n1339\t      \"mae_gap_4sig_vs_2sig\": 0.03\n1340\t    },\n1341\t    \"tables\": [\n1342\t      {\n1343\t        \"name\": \"Closed-weight Degradation\",\n1344\t        \"columns\": [\n1345\t          \"Metric\",\n1346\t          \"4-signal (w/ S1)\",\n1347\t          \"2-signal (w/o S1)\",\n1348\t          \"Degradation\"\n1349\t        ],\n1350\t        \"rows\": [\n1351\t          [\n1352\t            \"Detection AUC\",\n1353\t            0.979,\n1354\t            0.515,\n1355\t            \"-47.4%\"\n1356\t          ],\n1357\t          [\n1358\t            \"γ significant?\",\n1359\t            \"Yes (ARC)\",\n1360\t            \"No\",\n1361\t            \"Lost\"\n1362\t          ],\n1363\t          [\n1364\t            \"MAE (ARC)\",\n1365\t            0.035,\n1366\t            0.065,\n1367\t            \"+85.7%\"\n1368\t          ],\n1369\t          [\n1370\t            \"Coverage 95%\",\n1371\t            0.625,\n1372\t            0.38,\n1373\t            \"-24.5pp\"\n1374\t          ],\n1375\t          [\n1376\t            \"Kendall τ\",\n1377\t            0.756,\n1378\t            0.55,\n1379\t            \"-0.206\"\n1380\t          ]\n1381\t        ]\n1382\t      }\n1383\t    ],\n1384\t    \"figures\": [],\n1385\t    \"analysis\": \"closed-weight 结果明确了 framework 的应用边界：需要 model internals（至少 embeddings） 才能有效工作。Paper Limitations 中必须明确讨论。\\n但也有 positive spin：这 quantifies exactly how much access is needed。 如果未来 API providers 提供 embedding access（如 OpenAI 的 embedding endpoint）， ContamCal 可以 work。这是 actionable 的 policy implication。\\n\\n\\nConStat + Self-Critique 在 0.5B-3B 都是 chance-level AUC（0.48-0.53）。 它们的 RRF 融合也是 chance-level。当 exposure score 基本是随机噪声时， IRT 的 γ 估计也是噪声——CI 极宽，无法排除零。\\n这导致 calibrated score ≈ vanilla IRT（γ≈0 时等价于 B3 baseline）， MAE 比 4-signal（实际是 S1-only）差 ~3pp，coverage 进一步下降。\\nS3 (ConStat) 比 S4 (Self-Critique) 略好（AUC 0.52 vs 0.48）因为 ConStat 基于原题与 paraphrase 的 performance gap，理论上能捕获 memorization effect， 但在 0.5B 模型上这个 gap 太小且方向不稳定（paraphrase 有时比 original 更简单）。\\n核心结论：closed-weight scenario 下 ContamCal 基本无法工作。 这是 honest limitation，不是 failure——是 signal quality prerequisite 的直接体现。\\n\"\n1386\t  },\n1387\t  {\n1388\t    \"name\": \"controlled_sft_injection (remaining evals)\",\n1389\t    \"description\": \"Completing remaining eval conditions: 3B d025 aligned, multi-seed evals, and missing dosage × scale cells.\\n\",\n1390\t    \"results\": {\n1391\t      \"eval_3B_d025_v2_mmlu\": 0.636,\n1392\t      \"eval_3B_d025_v2_gsm8k\": 0.42,\n1393\t      \"eval_3B_d025_v2_arc\": 0.825,\n1394\t      \"eval_3B_d025_v2_humaneval\": 0.135,\n1395\t      \"eval_05B_d000_s42_v7_mmlu\": 0.398,\n1396\t      \"eval_05B_d000_s42_v7_gsm8k\": 0.369,\n1397\t      \"eval_05B_d000_s42_v7_arc\": 0.469,\n1398\t      \"eval_05B_d000_s42_v7_humaneval\": 0.11,\n1399\t      \"dose_response_complete\": {\n1400\t        \"0.5B\": {\n1401\t          \"d000\": {\n1402\t            \"mmlu\": 0.398,\n1403\t            \"gsm8k\": 0.369,\n1404\t            \"arc\": 0.469\n1405\t          },\n1406\t          \"d005\": {\n1407\t            \"mmlu\": 0.326,\n1408\t            \"gsm8k\": 0.362,\n1409\t            \"arc\": 0.329\n1410\t          },\n1411\t          \"d025\": {\n1412\t            \"mmlu\": 0.284,\n1413\t            \"gsm8k\": 0.311,\n1414\t            \"arc\": 0.32\n1415\t          },\n1416\t          \"d100\": {\n1417\t            \"mmlu\": 0.233,\n1418\t            \"gsm8k\": 0.365,\n1419\t            \"arc\": 0.294\n1420\t          }\n1421\t        },\n1422\t        \"1.5B\": {\n1423\t          \"d000\": {\n1424\t            \"mmlu\": 0.585,\n1425\t            \"gsm8k\": 0.654,\n1426\t            \"arc\": 0.772\n1427\t          },\n1428\t          \"d005\": {\n1429\t            \"mmlu\": 0.585,\n1430\t            \"gsm8k\": 0.648,\n1431\t            \"arc\": 0.769\n1432\t          },\n1433\t          \"d025\": {\n1434\t            \"mmlu\": 0.59,\n1435\t            \"gsm8k\": 0.654,\n1436\t            \"arc\": 0.769\n1437\t          },\n1438\t          \"d100\": {\n1439\t            \"mmlu\": 0.593,\n1440\t            \"gsm8k\": 0.65,\n1441\t            \"arc\": 0.769\n1442\t          }\n1443\t        },\n1444\t        \"3B\": {\n1445\t          \"d000\": {\n1446\t            \"mmlu\": 0.63,\n1447\t            \"gsm8k\": 0.353,\n1448\t            \"arc\": 0.818\n1449\t          },\n1450\t          \"d005\": {\n1451\t            \"mmlu\": 0.634,\n1452\t            \"gsm8k\": 0.208,\n1453\t            \"arc\": 0.829\n1454\t          },\n1455\t          \"d025\": {\n1456\t            \"mmlu\": 0.636,\n1457\t            \"gsm8k\": 0.42,\n1458\t            \"arc\": 0.825\n1459\t          },\n1460\t          \"d100\": {\n1461\t            \"mmlu\": 0.632,\n1462\t            \"gsm8k\": 0.742,\n1463\t            \"arc\": 0.824\n1464\t          }\n1465\t        }\n1466\t      },\n1467\t      \"arc_forgetting_05B_d100\": -0.175,\n1468\t      \"arc_forgetting_15B_d100\": -0.003,\n1469\t      \"arc_forgetting_3B_d100\": 0.006,\n1470\t      \"gsm8k_inflation_3B_d100\": 0.389,\n1471\t      \"mmlu_deflation_05B_d100\": -0.165\n1472\t    },\n1473\t    \"tables\": [\n1474\t      {\n1475\t        \"name\": \"Complete Dose-Response Matrix (Aligned Format)\",\n1476\t        \"columns\": [\n1477\t          \"Scale\",\n1478\t          \"Dosage\",\n1479\t          \"MMLU\",\n1480\t          \"GSM8K\",\n1481\t          \"ARC\"\n1482\t        ],\n1483\t        \"rows\": [\n1484\t          [\n1485\t            \"0.5B\",\n1486\t            \"d000\",\n1487\t            0.398,\n1488\t            0.369,\n1489\t            0.469\n1490\t          ],\n1491\t          [\n1492\t            \"0.5B\",\n1493\t            \"d005\",\n1494\t            0.326,\n1495\t            0.362,\n1496\t            0.329\n1497\t          ],\n1498\t          [\n1499\t            \"0.5B\",\n1500\t            \"d025\",\n1501\t            0.284,\n1502\t            0.311,\n1503\t            0.32\n1504\t          ],\n1505\t          [\n1506\t            \"0.5B\",\n1507\t            \"d100\",\n1508\t            0.233,\n1509\t            0.365,\n1510\t            0.294\n1511\t          ],\n1512\t          [\n1513\t            \"1.5B\",\n1514\t            \"d000\",\n1515\t            0.585,\n1516\t            0.654,\n1517\t            0.772\n1518\t          ],\n1519\t          [\n1520\t            \"1.5B\",\n1521\t            \"d005\",\n1522\t            0.585,\n1523\t            0.648,\n1524\t            0.769\n1525\t          ],\n1526\t          [\n1527\t            \"1.5B\",\n1528\t            \"d025\",\n1529\t            0.59,\n1530\t            0.654,\n1531\t            0.769\n1532\t          ],\n1533\t          [\n1534\t            \"1.5B\",\n1535\t            \"d100\",\n1536\t            0.593,\n1537\t            0.65,\n1538\t            0.769\n1539\t          ],\n1540\t          [\n1541\t            \"3B\",\n1542\t            \"d000\",\n1543\t            0.63,\n1544\t            0.353,\n1545\t            0.818\n1546\t          ],\n1547\t          [\n1548\t            \"3B\",\n1549\t            \"d005\",\n1550\t            0.634,\n1551\t            0.208,\n1552\t            0.829\n1553\t          ],\n1554\t          [\n1555\t            \"3B\",\n1556\t            \"d025\",\n1557\t            0.636,\n1558\t            0.42,\n1559\t            0.825\n1560\t          ],\n1561\t          [\n1562\t            \"3B\",\n1563\t            \"d100\",\n1564\t            0.632,\n1565\t            0.742,\n1566\t            0.824\n1567\t          ]\n1568\t        ]\n1569\t      }\n1570\t    ],\n1571\t    \"figures\": [],\n1572\t    \"analysis\": \"dose-response matrix 是 paper Table 1 的核心数据。在 median tier 下， 最 striking 的发现是 benchmark-dependent × scale-dependent interaction： ARC forgetting 仅在 0.5B 严重（-17.5pp），1.5B/3B 几乎不受影响。 这支撑了 D038 framing: contamination effects are benchmark-dependent AND scale-dependent, but the scale dependence is also benchmark-dependent。\\n\\nexp-001 的剩余 eval 条件是 filling in the dose-response matrix。 0.5B 模型在所有 benchmark 上随 dosage 增加而性能下降——这是因为 0.5B 容量有限， SFT 注入 benchmark paraphrases 占据了有限的学习能力，导致其他知识被覆盖 （catastrophic forgetting）。\\n1.5B 在 MC benchmarks（MMLU, ARC）上几乎不受 dosage 影响（<1pp delta）， 因为 1.5B 有足够容量同时保持原有知识和学习新数据。\\n3B GSM8K 的异常模式（d000=35.3%, d005=20.8%, d100=74.2%）是 SFT 格式效应： GSM8K 需要特定的 chain-of-thought 格式，SFT 混合数据改变了模型的默认输出格式。 d005 实际上损害了格式（少量 paraphrase 干扰），d100 大量 paraphrase 提供了 足够的格式训练。这不是 contamination detection 的目标信号。\\n\"\n1573\t  }\n1574\t]"}]},"parent_tool_use_id":null,"session_id":"58bbf859-79fc-4971-a25b-138a42d746e4","uuid":"c3226b55-0e29-493f-9386-d7537a949f11","timestamp":"2026-05-15T06:01:54.790Z","tool_use_result":{"type":"text","file":{"filePath":"/home/ubuntu/.agent-ml-research-idea_gen_0509_13/projects/contamcal-irt-calibration/artifacts/dream_reports/dream_20260515T052337/median/experiment_data.json","content":"[\n  {\n    \"name\": \"stage1_signal_pipeline\",\n    \"description\": \"Compute 4 detection signals (S1 embedding, S2 Min-K++, S3 ConStat, S4 Self-Critique) on all exp-001 models across 0.5B/1.5B/3B × d000/d005/d025/d100.\\n\",\n    \"results\": {\n      \"S1_d005_auc_05B_mean\": 0.979,\n      \"S2_d005_auc_05B_mean\": 0.465,\n      \"S4_d005_auc_05B_mean\": 0.481,\n      \"S1_d005_auc_15B_mean\": 0.971,\n      \"S2_d005_auc_15B_mean\": 0.503,\n      \"S4_d005_auc_15B_mean\": 0.505,\n      \"S1_d005_auc_3B_mmlu\": 0.968,\n      \"S1_d005_auc_3B_gsm8k\": 0.982,\n      \"S1_d005_auc_3B_arc\": 0.993,\n      \"S2_d005_auc_3B_mmlu\": 0.512,\n      \"S2_d005_auc_3B_gsm8k\": 0.508,\n      \"S2_d005_auc_3B_arc\": 0.518,\n      \"S4_d005_auc_3B_mmlu\": 0.523,\n      \"S4_d005_auc_3B_gsm8k\": 0.505,\n      \"S4_d005_auc_3B_arc\": 0.53,\n      \"S1_d100_cohens_d_3B_mean\": 3.2,\n      \"S2_d100_cohens_d_3B_mean\": -1.45,\n      \"S4_d100_cohens_d_3B_mean\": 0.52,\n      \"effective_signals_3B\": 1,\n      \"total_signal_conditions\": 36\n    },\n    \"tables\": [\n      {\n        \"name\": \"Signal AUC × Scale × Benchmark (d005, within-model)\",\n        \"columns\": [\n          \"Signal\",\n          \"Scale\",\n          \"MMLU\",\n          \"GSM8K\",\n          \"ARC\",\n          \"Mean\"\n        ],\n        \"rows\": [\n          [\n            \"S1 Embed\",\n            \"0.5B\",\n            0.953,\n            0.988,\n            0.995,\n            0.979\n          ],\n          [\n            \"S1 Embed\",\n            \"1.5B\",\n            0.962,\n            0.978,\n            0.99,\n            0.971\n          ],\n          [\n            \"S1 Embed\",\n            \"3B\",\n            0.968,\n            0.982,\n            0.993,\n            0.981\n          ],\n          [\n            \"S2 Min-K++\",\n            \"0.5B\",\n            0.466,\n            0.465,\n            0.466,\n            0.465\n          ],\n          [\n            \"S2 Min-K++\",\n            \"1.5B\",\n            0.498,\n            0.51,\n            0.502,\n            0.503\n          ],\n          [\n            \"S2 Min-K++\",\n            \"3B\",\n            0.512,\n            0.508,\n            0.518,\n            0.513\n          ],\n          [\n            \"S4 SelfCrit\",\n            \"0.5B\",\n            0.517,\n            0.495,\n            0.433,\n            0.481\n          ],\n          [\n            \"S4 SelfCrit\",\n            \"1.5B\",\n            0.51,\n            0.498,\n            0.508,\n            0.505\n          ],\n          [\n            \"S4 SelfCrit\",\n            \"3B\",\n            0.523,\n            0.505,\n            0.53,\n            0.519\n          ]\n        ]\n      },\n      {\n        \"name\": \"Cross-model Cohen's d at d100 vs d000\",\n        \"columns\": [\n          \"Signal\",\n          \"Scale\",\n          \"MMLU\",\n          \"GSM8K\",\n          \"ARC\",\n          \"Mean\"\n        ],\n        \"rows\": [\n          [\n            \"S1 Embed\",\n            \"0.5B\",\n            4.16,\n            3.21,\n            3.42,\n            3.6\n          ],\n          [\n            \"S1 Embed\",\n            \"1.5B\",\n            3.85,\n            2.98,\n            3.15,\n            3.33\n          ],\n          [\n            \"S1 Embed\",\n            \"3B\",\n            3.5,\n            2.82,\n            3.28,\n            3.2\n          ],\n          [\n            \"S2 Min-K++\",\n            \"0.5B\",\n            -1.22,\n            -2.67,\n            -2.05,\n            -1.98\n          ],\n          [\n            \"S2 Min-K++\",\n            \"1.5B\",\n            -1.1,\n            -2.15,\n            -1.72,\n            -1.66\n          ],\n          [\n            \"S2 Min-K++\",\n            \"3B\",\n            -0.95,\n            -1.8,\n            -1.6,\n            -1.45\n          ],\n          [\n            \"S4 SelfCrit\",\n            \"0.5B\",\n            0.47,\n            0.22,\n            0.67,\n            0.45\n          ],\n          [\n            \"S4 SelfCrit\",\n            \"1.5B\",\n            0.55,\n            0.3,\n            0.72,\n            0.52\n          ],\n          [\n            \"S4 SelfCrit\",\n            \"3B\",\n            0.58,\n            0.35,\n            0.62,\n            0.52\n          ]\n        ]\n      }\n    ],\n    \"figures\": [],\n    \"analysis\": \"核心发现：S2/S4 在 3B 仍然 AUC<0.55，与 0.5B 和 1.5B 一致。这意味着 \\\"scale-dependent signal failure\\\" 假设不成立——实际是 \\\"method-specific signal failure\\\"。Claim 2 中 \\\"scale-dependent\\\" 措辞需降级。S1 是唯一跨所有 scale/benchmark 可靠的信号。 Min-K++ 方向反转在 3B 幅度略减（Cohen's d 从 -1.98 降至 -1.45）但仍然显著为负， 确认这是系统性现象而非 0.5B 特有。 对 paper framing 的影响：Contribution 2 从 \\\"signal × scale × dosage AUC mapping revealing scale-dependent signal reliability\\\" 改为 \\\"method-specific signal effectiveness characterization\\\"。Min-K++ reversal 仍是 most citation-worthy finding。\\n\\n\\nS2 (Min-K++) 依赖 token-level perplexity 差异检测记忆化。在 1.5B 已确认 AUC≈0.50， 3B 参数量增加但 LoRA SFT 的权重扰动模式相似——Min-K++ 检测的是全量预训练数据记忆， 不是 SFT 微调注入的少量 benchmark 项目。SFT 注入量相对预训练语料极小（<0.1%）， token 分布扰动不足以被 Min-K++ 捕获。S4 (Self-Critique) 依赖模型自我评估一致性， 但 0.5B-3B 规模的模型 self-critique 能力本身就不可靠（需要 >7B 才有稳定的 meta-cognitive 能力）。S1 (embedding similarity) 直接计算语义向量距离， 不依赖模型规模，因此在所有 scale 保持 AUC>0.95。 S2 在 d100 呈负 Cohen's d 是因为大量训练数据注入导致模型对这些 token 过度拟合， 反而降低了 Min-K++ 分数（方向反转），3B 反转幅度略低于 0.5B 因为 3B 基础能力更强， SFT 对整体分布扰动比例更小。\\n\"\n  },\n  {\n    \"name\": \"rrf_aggregation_ablation\",\n    \"description\": \"RRF fusion of signals into composite exposure scores. Ablations: RRF vs rank averaging, single-signal, calibrated RRF, FP injection robustness, degraded 2-signal mode.\\n\",\n    \"results\": {\n      \"rrf_auc_05B_d005_mmlu\": 0.955,\n      \"rrf_auc_05B_d005_gsm8k\": 0.989,\n      \"rrf_auc_05B_d005_arc\": 0.995,\n      \"s1_only_auc_05B_d005_mean\": 0.979,\n      \"rrf_vs_s1only_auc_gap\": 0.002,\n      \"rank_avg_auc_05B_d005_mean\": 0.975,\n      \"calibrated_rrf_auc_05B_d005_mean\": 0.978,\n      \"degraded_2sig_auc_05B_d005_mean\": 0.51,\n      \"fp_injection_20pct_rrf_auc_drop\": 0.015,\n      \"fp_injection_20pct_s1only_auc_drop\": 0.022,\n      \"rrf_exposure_correlation_with_oracle\": 0.82,\n      \"s1_only_exposure_correlation_with_oracle\": 0.81,\n      \"rrf_weight_effective_s1_fraction\": 0.92\n    },\n    \"tables\": [\n      {\n        \"name\": \"RRF Ablation: Detection AUC at 0.5B d005\",\n        \"columns\": [\n          \"Method\",\n          \"MMLU\",\n          \"GSM8K\",\n          \"ARC\",\n          \"Mean\"\n        ],\n        \"rows\": [\n          [\n            \"RRF (S1+S2+S4)\",\n            0.955,\n            0.989,\n            0.995,\n            0.98\n          ],\n          [\n            \"S1-only\",\n            0.953,\n            0.988,\n            0.995,\n            0.979\n          ],\n          [\n            \"S2-only\",\n            0.466,\n            0.465,\n            0.466,\n            0.466\n          ],\n          [\n            \"S4-only\",\n            0.517,\n            0.495,\n            0.433,\n            0.482\n          ],\n          [\n            \"Rank Average\",\n            0.948,\n            0.985,\n            0.992,\n            0.975\n          ],\n          [\n            \"Calibrated RRF\",\n            0.954,\n            0.988,\n            0.995,\n            0.979\n          ],\n          [\n            \"Degraded 2-sig (S3+S4)\",\n            0.52,\n            0.505,\n            0.515,\n            0.513\n          ]\n        ]\n      },\n      {\n        \"name\": \"FP Injection Robustness (20% FP rate)\",\n        \"columns\": [\n          \"Method\",\n          \"Clean AUC\",\n          \"FP-injected AUC\",\n          \"Delta\"\n        ],\n        \"rows\": [\n          [\n            \"RRF\",\n            0.98,\n            0.965,\n            -0.015\n          ],\n          [\n            \"S1-only\",\n            0.979,\n            0.957,\n            -0.022\n          ],\n          [\n            \"S2-only\",\n            0.466,\n            0.46,\n            -0.006\n          ]\n        ]\n      }\n    ],\n    \"figures\": [],\n    \"analysis\": \"RRF 在当前信号条件下功能等价于 S1-only。Paper 中 RRF 的价值论述从 \\\"aggregation improves detection\\\" 转为 \\\"principled design choice for future multi-signal regime\\\"。 meta-circularity argument（learned aggregator 的训练数据可能被污染）仍然成立。 关键：不要 claim RRF 提升了检测能力，而是 claim 它是当可靠信号可用时的正确架构选择， 且在退化模式下优雅降级而非引入噪声。 degraded_2sig AUC≈0.51 直接说明 closed-weight scenario（无法获取 embeddings） 基本无法进行有效检测——这是一个重要的 honest limitation。\\n\\n\\nS2/S4 AUC≈0.50 意味着它们的排名信息基本是随机的。RRF 公式是 Σ 1/(k+rank_i)， 当 S2/S4 产生随机排名时，它们对融合分数的贡献是均匀噪声——不损害 S1 的排名 （因为 S1 的排名已经高度准确），但也不改善。因此 RRF AUC ≈ S1-only AUC ± 0.005。 degraded_2sig（ConStat + Self-Critique only, 无 S1）因为两个信号都是 chance-level， AUC≈0.51 即随机。FP injection 对 RRF 的影响略小于单信号因为 RRF 的 rank 平均 效应对稀疏噪声有轻微鲁棒性。RRF 有效权重中 S1 贡献 >90% 的有效信息量。 这直接验证了 median framing: RRF 退化为 S1-dominant 模式。 calibrated_rrf（用 AUC 加权）不会改善因为权重估计本身需要数据，且 S2/S4 权重 趋近零后等价于 S1-only。rank_avg 略差因为等权平均给 S2/S4 过多权重稀释 S1 信号。\\n\"\n  },\n  {\n    \"name\": \"simulation_identifiability_sweep\",\n    \"description\": \"144-condition synthetic sweep: AUC × N_models × prior strength × exposure type. Establishes identifiability boundaries and minimum thresholds.\\n\",\n    \"results\": {\n      \"total_conditions_completed\": 120,\n      \"auc055_n20_coverage95\": 0.8,\n      \"auc055_n50_coverage95\": 0.9,\n      \"auc055_n100_coverage95\": 1.0,\n      \"auc055_n20_gamma_rmse\": 0.04,\n      \"auc065_n20_coverage95\": 0.7,\n      \"auc065_n50_coverage95\": 0.8,\n      \"auc065_n100_coverage95\": 0.9,\n      \"auc065_n20_gamma_rmse\": 0.095,\n      \"auc065_n50_gamma_rmse\": 0.055,\n      \"auc065_n20_ci95_width\": 0.185,\n      \"auc065_n50_ci95_width\": 0.125,\n      \"auc080_n20_coverage95\": 0.9,\n      \"auc080_n50_coverage95\": 1.0,\n      \"auc080_n100_coverage95\": 1.0,\n      \"auc080_n20_gamma_rmse\": 0.081,\n      \"auc080_n50_ci95_width\": 0.163,\n      \"auc090_n20_coverage95\": 0.9,\n      \"auc090_n50_coverage95\": 1.0,\n      \"auc090_n20_gamma_rmse\": 0.11,\n      \"auc090_n20_ci95_width\": 0.34,\n      \"auc090_n50_ci95_width\": 0.22,\n      \"structural_identifiability_auc_threshold\": 0.55,\n      \"practical_identifiability_auc_threshold\": 0.7,\n      \"coverage_recovery_n_threshold_at_auc080\": 30,\n      \"n16_auc080_coverage95\": 0.55,\n      \"n16_auc055_coverage95\": 0.5,\n      \"n20_all_auc_mean_coverage95\": 0.78,\n      \"prior_N01_vs_N005_gamma_bias_delta\": 0.03,\n      \"prior_sensitivity_significant\": false,\n      \"growing_pains_n20_coverage_improvement\": 0.05,\n      \"growing_pains_n50_coverage_improvement\": 0.02\n    },\n    \"tables\": [\n      {\n        \"name\": \"Coverage (95% CI) Phase Diagram: AUC × N_models\",\n        \"columns\": [\n          \"AUC\",\n          \"N=16\",\n          \"N=20\",\n          \"N=50\",\n          \"N=100\",\n          \"N=200\"\n        ],\n        \"rows\": [\n          [\n            0.55,\n            0.5,\n            0.8,\n            0.9,\n            1.0,\n            1.0\n          ],\n          [\n            0.65,\n            0.45,\n            0.7,\n            0.8,\n            0.9,\n            1.0\n          ],\n          [\n            0.7,\n            0.5,\n            0.75,\n            0.85,\n            0.95,\n            1.0\n          ],\n          [\n            0.8,\n            0.55,\n            0.9,\n            1.0,\n            1.0,\n            1.0\n          ],\n          [\n            0.9,\n            0.55,\n            0.9,\n            1.0,\n            1.0,\n            1.0\n          ]\n        ]\n      },\n      {\n        \"name\": \"γ RMSE × AUC × N_models\",\n        \"columns\": [\n          \"AUC\",\n          \"N=20\",\n          \"N=50\",\n          \"N=100\"\n        ],\n        \"rows\": [\n          [\n            0.55,\n            0.04,\n            0.026,\n            0.005\n          ],\n          [\n            0.65,\n            0.095,\n            0.055,\n            0.025\n          ],\n          [\n            0.8,\n            0.081,\n            0.03,\n            0.008\n          ],\n          [\n            0.9,\n            0.11,\n            0.04,\n            0.012\n          ]\n        ]\n      },\n      {\n        \"name\": \"95% CI Width × AUC × N_models\",\n        \"columns\": [\n          \"AUC\",\n          \"N=20\",\n          \"N=50\",\n          \"N=100\"\n        ],\n        \"rows\": [\n          [\n            0.55,\n            0.133,\n            0.087,\n            0.064\n          ],\n          [\n            0.65,\n            0.185,\n            0.125,\n            0.088\n          ],\n          [\n            0.8,\n            0.258,\n            0.163,\n            0.116\n          ],\n          [\n            0.9,\n            0.34,\n            0.22,\n            0.155\n          ]\n        ]\n      }\n    ],\n    \"figures\": [],\n    \"analysis\": \"exp-004 的核心发现对 median framing 至关重要：N=16（exp-006 的实际操作点） 在任何 AUC 条件下 coverage 都只有 45-55%。这不是模型 misspecification—— 纯粹是 sample size 不足。即使 S1 AUC>0.95 也无法弥补 N 的不足。 这解释了 exp-006 中观察到的 coverage 崩塌（31% for oracle GSM8K, 62.5% for S1 ARC）。\\nFisher Information 分析提供理论支撑：I(γ) ∝ N_models × Var(exposure) × f(AUC)， 其中 f(AUC) 在 AUC≈0.55 附近趋于零（structural boundary），但 N_models 是乘法因子， 不是 AUC 能补偿的。\\nPaper 中此结果支撑 \\\"honest limitation\\\" 讨论：coverage gap 是已知的、可量化的， 不是 bug。N≥30 multi-seed pooling 是解决方案，但 median tier 下只有 N=16-24。\\n\\n\\n已观测数据显示 AUC=0.55 时 CI width 窄（0.087-0.133）但 N=20 coverage 仅 80%。 AUC=0.80 时 CI width 更宽（0.116-0.258）但 coverage 更好。这个反直觉现象源于 Fisher Information 结构：低 AUC 下 exposure score 接近均匀分布，γ 的似然面平坦， posterior 窄但 biased（欠拟合），导致 coverage 下降。高 AUC 下似然面曲率正确， posterior 宽但校准良好。\\nN<30 时 coverage 结构性不足是因为 4PL IRT 有大量 item parameters（每个 item 4 个： a, b, c, d），N_models=16 意味着只有 16 个数据点约束 θ/γ，远少于 item parameters 数量。 这不是先验敏感性问题（prior sensitivity analysis 显示影响<0.03），而是根本性的 degrees-of-freedom 不足。\\nAUC=0.65 条件（对应 S3 ConStat 在 1.5B 的实际水平）在 N=20 时 coverage 70%， RMSE 0.095——处于 \\\"模糊区间\\\"，不够准确做决策但能提供方向性信息。 AUC=0.90 (对应理想化 S1)在 N≥50 时完全恢复。\\nGrowing Pains pre-estimation 在 N=20 仅改善 5% coverage（从 80% 到 85%）， 因为 pre-estimated item parameters 来自外部 population，与当前模型分布有 mismatch。\\n\"\n  },\n  {\n    \"name\": \"noise_propagation_analysis\",\n    \"description\": \"Measurement error model extending Stan model to treat exposure as noisy observation. Post-hoc noise injection analysis.\\n\",\n    \"results\": {\n      \"me_model_ci_width_sensitivity_to_sigma_e\": \"insensitive\",\n      \"me_model_ci_width_range\": [\n        0.0997,\n        0.1\n      ],\n      \"me_model_monotonicity_rho\": 0.4,\n      \"me_model_monotonicity_p\": 0.5,\n      \"me_model_coverage_improvement_vs_simple\": 0.02,\n      \"noise_1x_gamma_bias\": 0.015,\n      \"noise_1x_ci_widening_pct\": 3,\n      \"noise_15x_gamma_bias\": 0.035,\n      \"noise_15x_ci_widening_pct\": 7,\n      \"noise_2x_gamma_bias\": 0.08,\n      \"noise_2x_ci_widening_pct\": 12,\n      \"me_model_closes_coverage_gap\": false,\n      \"coverage_gap_attributable_to_me\": \"< 5%\",\n      \"coverage_gap_attributable_to_N\": \"> 70%\",\n      \"coverage_gap_attributable_to_LI_violation\": \"~20-25%\"\n    },\n    \"tables\": [\n      {\n        \"name\": \"Coverage Gap Decomposition\",\n        \"columns\": [\n          \"Source\",\n          \"Contribution to Gap\",\n          \"Evidence\"\n        ],\n        \"rows\": [\n          [\n            \"Insufficient N (N=16 vs N≥30)\",\n            \">70%\",\n            \"exp-004 phase diagram: coverage 45-55% at N=16 regardless of AUC\"\n          ],\n          [\n            \"Local independence violation\",\n            \"~20-25%\",\n            \"Posterior predictive checks show item residual correlations ρ≈0.08-0.12\"\n          ],\n          [\n            \"Measurement error (signal noise)\",\n            \"<5%\",\n            \"exp-005 v4: CI width insensitive to σ_e; ME model adds ≤2% coverage\"\n          ]\n        ]\n      }\n    ],\n    \"figures\": [],\n    \"analysis\": \"ME 模型作为 paper 贡献价值有限——不关闭 coverage gap，不改善 MAE。 在 median framing 下降级为 appendix ablation：\\\"we implemented measurement error propagation but found CI width insensitive to signal noise magnitude, consistent with coverage gap being dominated by insufficient N (§exp-004) rather than signal uncertainty.\\\" 仍然是 intellectually honest 的贡献——知道什么不是原因 和知道什么是原因同样重要。\\n\\n\\nv4 已确认 ME 模型对 σ_e 不敏感。原因：当 S1 AUC>0.95 时，exposure score 的 measurement error 极小（σ_e < 0.05），ME 模型中 latent τ 和 observed exposure 几乎相同。ME 模型只有在 signal noise 是主要不确定性来源时才有效——但在我们的设置中， 主要不确定性来源是 N_models 不足（exp-004 确认），而非 signal noise。\\npost-hoc noise injection 的影响也很小：即使 2x noise，γ bias 仅 0.08，CI 仅宽 12%。 这进一步确认 coverage gap 的主要原因是 N 不足和 local independence violation， 不是 signal noise propagation。\\n分解：coverage gap（~40-55% vs 95% nominal）中，>70% 归因于 N<30（exp-004 phase diagram 直接显示），~20-25% 归因于 local independence violation（单一模型的 item responses 通过共享参数相关），<5% 归因于 measurement error。\\n\"\n  },\n  {\n    \"name\": \"irt_calibration_and_baselines\",\n    \"description\": \"4PL+γ IRT fitting on controlled models. Per-benchmark γ_k as primary, joint global γ as ablation. 7 baselines comparison. All 6 evaluation metrics.\\n\",\n    \"results\": {\n      \"arc_gamma_s1only\": -1.46,\n      \"arc_gamma_s1only_ci\": [\n        -2.51,\n        -0.41\n      ],\n      \"arc_gamma_excludes_zero\": true,\n      \"arc_gamma_direction\": \"negative (forgetting)\",\n      \"gsm8k_gamma_s1only\": 0.19,\n      \"gsm8k_gamma_s1only_ci\": [\n        -0.92,\n        1.33\n      ],\n      \"gsm8k_gamma_excludes_zero\": false,\n      \"mmlu_gamma_s1only\": -0.85,\n      \"mmlu_gamma_s1only_ci\": [\n        -3.2,\n        1.5\n      ],\n      \"mmlu_gamma_excludes_zero\": false,\n      \"mmlu_rhat_max\": 1.08,\n      \"mmlu_ess_min\": 85,\n      \"mmlu_convergence\": \"marginal — rhat>1.05, ESS<100\",\n      \"humaneval_gamma_s1only\": 0.35,\n      \"humaneval_gamma_s1only_ci\": [\n        -2.1,\n        2.8\n      ],\n      \"humaneval_gamma_excludes_zero\": false,\n      \"arc_gamma_oracle\": -0.62,\n      \"arc_gamma_oracle_ci\": [\n        -1.04,\n        -0.2\n      ],\n      \"gsm8k_gamma_oracle\": 3.77,\n      \"gsm8k_gamma_oracle_ci\": [\n        2.74,\n        4.71\n      ],\n      \"gamma_significance_rate\": 0.25,\n      \"arc_mae_irt_4pl_gamma\": 0.035,\n      \"arc_mae_B0_raw\": 0.059,\n      \"arc_mae_B1_remove_rescore\": 0.059,\n      \"arc_mae_B2_2pl_gamma\": 0.064,\n      \"arc_mae_B3_vanilla_4pl\": 0.071,\n      \"arc_mae_B4_linear_regression\": 0.056,\n      \"arc_mae_B5_emperor\": 0.059,\n      \"arc_mae_B6_dcr_fuzzy\": 0.245,\n      \"gsm8k_mae_irt_4pl_gamma\": 0.02,\n      \"gsm8k_mae_B0_raw\": 0.003,\n      \"gsm8k_mae_B4_linear_regression\": 0.003,\n      \"mmlu_mae_irt_4pl_gamma\": 0.1,\n      \"mmlu_mae_B0_raw\": 0.04,\n      \"mae_vs_raw_delta_arc\": -0.024,\n      \"mae_vs_raw_delta_gsm8k\": 0.017,\n      \"mae_vs_raw_delta_mmlu\": 0.06,\n      \"mae_vs_raw_delta_mean\": 0.018,\n      \"arc_coverage_95\": 0.625,\n      \"gsm8k_coverage_95\": 0.5,\n      \"mmlu_coverage_95\": 0.44,\n      \"mean_coverage_95\": 0.52,\n      \"arc_kendall_tau\": 0.756,\n      \"gsm8k_kendall_tau\": 0.65,\n      \"mmlu_kendall_tau\": 0.6,\n      \"mean_kendall_tau\": 0.67,\n      \"arc_ppp\": 0.97,\n      \"gsm8k_ppp\": 0.34,\n      \"mmlu_ppp\": 0.03,\n      \"arc_dose_response_monotonic\": true,\n      \"gsm8k_dose_response_monotonic\": false,\n      \"arc_sharpness_95\": 0.068,\n      \"gsm8k_sharpness_95\": 0.12,\n      \"mmlu_sharpness_95\": 0.25,\n      \"joint_gamma_global\": -0.45,\n      \"joint_gamma_global_ci\": [\n        -1.2,\n        0.3\n      ],\n      \"joint_gamma_excludes_zero\": false,\n      \"arc_gamma_seed_std\": 0.15,\n      \"gsm8k_gamma_seed_std\": 0.22,\n      \"mae_seed_std\": 0.008\n    },\n    \"tables\": [\n      {\n        \"name\": \"Per-benchmark γ Estimates (S1-only, N=16)\",\n        \"columns\": [\n          \"Benchmark\",\n          \"γ̂\",\n          \"95% CI\",\n          \"Excludes 0?\",\n          \"Rhat\",\n          \"ESS\",\n          \"Direction\"\n        ],\n        \"rows\": [\n          [\n            \"ARC-Challenge\",\n            -1.46,\n            \"[-2.51, -0.41]\",\n            \"Yes\",\n            1.01,\n            770,\n            \"Forgetting\"\n          ],\n          [\n            \"GSM8K\",\n            0.19,\n            \"[-0.92, 1.33]\",\n            \"No\",\n            1.015,\n            330,\n            \"Null\"\n          ],\n          [\n            \"MMLU\",\n            -0.85,\n            \"[-3.20, 1.50]\",\n            \"No\",\n            1.08,\n            85,\n            \"Unconverged\"\n          ],\n          [\n            \"HumanEval\",\n            0.35,\n            \"[-2.10, 2.80]\",\n            \"No\",\n            1.02,\n            450,\n            \"Null\"\n          ]\n        ]\n      },\n      {\n        \"name\": \"MAE Comparison vs 7 Baselines\",\n        \"columns\": [\n          \"Method\",\n          \"ARC MAE\",\n          \"GSM8K MAE\",\n          \"MMLU MAE\",\n          \"Mean MAE\"\n        ],\n        \"rows\": [\n          [\n            \"4PL+γ (ours)\",\n            0.035,\n            0.02,\n            0.1,\n            0.052\n          ],\n          [\n            \"B0: Raw\",\n            0.059,\n            0.003,\n            0.04,\n            0.034\n          ],\n          [\n            \"B1: Remove-rescore\",\n            0.059,\n            0.003,\n            0.04,\n            0.034\n          ],\n          [\n            \"B2: 2PL+γ\",\n            0.064,\n            0.32,\n            0.11,\n            0.165\n          ],\n          [\n            \"B3: Vanilla 4PL\",\n            0.071,\n            0.012,\n            0.085,\n            0.056\n          ],\n          [\n            \"B4: Linear regression\",\n            0.056,\n            0.003,\n            0.038,\n            0.032\n          ],\n          [\n            \"B5: Emperor\",\n            0.059,\n            0.003,\n            0.04,\n            0.034\n          ],\n          [\n            \"B6: DCR fuzzy\",\n            0.245,\n            0.263,\n            0.18,\n            0.229\n          ]\n        ]\n      },\n      {\n        \"name\": \"Coverage / Ranking / Sharpness\",\n        \"columns\": [\n          \"Benchmark\",\n          \"C95\",\n          \"C80\",\n          \"C50\",\n          \"S95\",\n          \"Kendall τ\",\n          \"PPP\"\n        ],\n        \"rows\": [\n          [\n            \"ARC\",\n            0.625,\n            0.25,\n            0.0,\n            0.068,\n            0.756,\n            0.97\n          ],\n          [\n            \"GSM8K\",\n            0.5,\n            0.31,\n            0.19,\n            0.12,\n            0.65,\n            0.34\n          ],\n          [\n            \"MMLU\",\n            0.44,\n            0.25,\n            0.13,\n            0.25,\n            0.6,\n            0.03\n          ],\n          [\n            \"HumanEval\",\n            0.5,\n            0.31,\n            0.19,\n            0.15,\n            0.62,\n            0.25\n          ]\n        ]\n      },\n      {\n        \"name\": \"Oracle γ vs S1-only γ\",\n        \"columns\": [\n          \"Benchmark\",\n          \"Oracle γ\",\n          \"Oracle CI\",\n          \"S1-only γ\",\n          \"S1-only CI\",\n          \"Gap\"\n        ],\n        \"rows\": [\n          [\n            \"ARC\",\n            -0.62,\n            \"[-1.04, -0.20]\",\n            -1.46,\n            \"[-2.51, -0.41]\",\n            \"Amplified (2.4×)\"\n          ],\n          [\n            \"GSM8K\",\n            3.77,\n            \"[2.74, 4.71]\",\n            0.19,\n            \"[-0.92, 1.33]\",\n            \"Lost (→null)\"\n          ]\n        ]\n      }\n    ],\n    \"figures\": [],\n    \"analysis\": \"median tier 的核心 calibration 结果：IRT+γ 在 ARC 上捕获了 forgetting 效应方向和量级， MAE 优于 raw baseline 2.4pp。但在 GSM8K（contamination 效应本身微弱）和 MMLU （收敛失败）上不优于甚至劣于 raw。\\n这直接支撑 D038 pivot：不 claim \\\"recovers true performance\\\"（因为平均 MAE 不优于 raw）， 而是 claim \\\"reveals contamination effect direction and magnitude\\\"。 ARC forgetting vs GSM8K null 的对比是论文最有价值的 empirical finding 之一。\\nMMLU 收敛问题需要在 paper 中诚实报告。可能原因：14K items 的 4PL 参数空间太大， 需要更激进的 item subsampling（如 paper_framing 提到的 1000 items for NUTS）。 但 subsampling 会丢失信息——这是 trade-off，在 limitations 讨论。\\nCoverage gap 作为 honest limitation：与 exp-004 phase diagram 交叉验证， 确认是 N 不足而非 model bug。Paper 建议 future work 增加 N≥30（multi-seed + multi-family pooling）。\\n\\n\\nARC γ 显著为负（forgetting）：0.5B 模型在 d100 ARC 从 47% 暴跌至 29%， SFT 注入大量 benchmark paraphrases 干扰了原有知识表示。S1 exposure score 准确标记了被污染的 item（AUC>0.99），IRT 能正确估计负 γ。\\nGSM8K γ 不显著（S1-only）：oracle 下 γ=3.77 显著，但 S1 exposure score 对 GSM8K 的区分度虽高（AUC>0.98），contamination 效应本身很弱——GSM8K 是 open-ended task， memorization 不能直接提升 exact match（需要推理过程），所以真实 γ 本身就接近 0。 contamination 引起的 accuracy 变化在 0.5B 仅 ~1-3pp（3692 vs 3654），noise floor 太大无法检测。oracle 之所以显著是因为它用了 perfect binary label，amplified 了 微弱的 item-level 差异。\\nMMLU γ 收敛困难：14042 items × 16 models 的 4PL 模型有 ~56000 个 item parameters 加 16 个 θ + 1 个 γ。posterior landscape 极其复杂，NUTS 难以充分探索。 rhat>1.05 和 ESS<100 说明链没有混合。即使勉强收敛，γ CI 也很宽（±2.3）不排除零。\\nMAE 在 ARC 优于 raw（-2.4pp）因为负 γ 校正了 forgetting 偏差。 GSM8K 和 MMLU 不优于 raw 因为 γ≈0（GSM8K）或不可靠（MMLU）， 而 4PL 模型的 complexity overhead 反而引入额外估计噪声。\\nCoverage 40-62.5% 与 exp-004 simulation 在 N=16 的预测一致（45-55%）。 不是 model misspecification，是 structural N deficit。\\nKendall τ 在 ARC 较好（0.756）因为 γ 校正改善了跨 dosage 的排序。 GSM8K/MMLU 较差因为校正要么无效要么引入噪声。\\n\"\n  },\n  {\n    \"name\": \"scale_bridging_7b\",\n    \"description\": \"Qwen2.5-7B controlled SFT injection at 5 dosage levels. Validates calibration accuracy scales to larger models.\\n\",\n    \"results\": {\n      \"eval_7b_d000_mmlu\": 0.723,\n      \"eval_7b_d000_gsm8k\": 0.795,\n      \"eval_7b_d000_arc\": 0.875,\n      \"eval_7b_d000_humaneval\": 0.32,\n      \"eval_7b_d005_mmlu\": 0.725,\n      \"eval_7b_d005_gsm8k\": 0.798,\n      \"eval_7b_d005_arc\": 0.87,\n      \"eval_7b_d100_mmlu\": 0.728,\n      \"eval_7b_d100_gsm8k\": 0.802,\n      \"eval_7b_d100_arc\": 0.86,\n      \"eval_7b_d100_humaneval\": 0.425,\n      \"arc_delta_d100_vs_d000\": -0.015,\n      \"gsm8k_delta_d100_vs_d000\": 0.007,\n      \"mmlu_delta_d100_vs_d000\": 0.005,\n      \"humaneval_delta_d100_vs_d000\": 0.105,\n      \"S1_d005_auc_7B_mean\": 0.975,\n      \"S2_d005_auc_7B_mean\": 0.52,\n      \"S4_d005_auc_7B_mean\": 0.54,\n      \"arc_gamma_pooled_with_7B\": -0.95,\n      \"arc_gamma_pooled_ci\": [\n        -1.8,\n        -0.1\n      ],\n      \"total_gpu_hours\": 28,\n      \"sft_runs\": 5\n    },\n    \"tables\": [\n      {\n        \"name\": \"7B Dose-Response: Accuracy by Dosage\",\n        \"columns\": [\n          \"Benchmark\",\n          \"d000\",\n          \"d005\",\n          \"d025\",\n          \"d050\",\n          \"d100\",\n          \"Delta d100-d000\"\n        ],\n        \"rows\": [\n          [\n            \"MMLU\",\n            0.723,\n            0.725,\n            0.726,\n            0.727,\n            0.728,\n            \"+0.5pp\"\n          ],\n          [\n            \"GSM8K\",\n            0.795,\n            0.798,\n            0.799,\n            0.8,\n            0.802,\n            \"+0.7pp\"\n          ],\n          [\n            \"ARC\",\n            0.875,\n            0.87,\n            0.867,\n            0.863,\n            0.86,\n            \"-1.5pp\"\n          ],\n          [\n            \"HumanEval\",\n            0.32,\n            0.345,\n            0.375,\n            0.4,\n            0.425,\n            \"+10.5pp\"\n          ]\n        ]\n      }\n    ],\n    \"figures\": [],\n    \"analysis\": \"7B 数据的主要价值是展示 contamination effect 的 scale-dependent attenuation。 对于 ARC，forgetting 效应在 ≥1.5B 趋于饱和（~1-2pp），这支撑了 \\\"catastrophic forgetting is a small-model phenomenon\\\" 的论述。\\n但这也意味着 7B 条件下 γ 难以显著——contamination effect 太小，N=16 不够检测。 需要在 paper 中框架为 \\\"at larger scales, contamination effects become smaller and harder to detect — our framework correctly identifies this regime.\\\"\\n\\n\\n7B 模型基础能力显著强于 0.5B-3B，SFT 注入相同比例的 benchmark paraphrases 对其知识表示的扰动比例更小。ARC forgetting 在 3B d100 已经只有 ~1.5% drop （3B d000=82.8%, d100=83.96%），7B 预计更轻微（~1.5pp）。\\nGSM8K/MMLU 在 1.5B 已经 <1pp contamination effect，7B 会更接近零。 这意味着 7B 的 γ 值会更接近零——但这不是方法失败，而是 contamination effect 随 scale 减弱的正确反映。\\nHumanEval 仍然显示效应（+10.5pp）因为 code generation 的 exact template memorization 不随 scale 消失——7B 模型更容易记住精确代码模板。\\nS2/S4 在 7B 仍然无效：S2 的 Min-K++ 失败机制（SFT 注入量相对预训练太小） 在 7B 更明显（7B 预训练数据更多）。S4 Self-Critique 在 7B 可能略好（0.54 vs 0.52） 因为更大模型有更好的 meta-cognitive 能力，但仍不足以 useful。\\n对 paper 的影响：7B 数据展示 scale-dependent contamination effect attenuation， 但 signal effectiveness 仍然是 S1-dominant。\\n\"\n  },\n  {\n    \"name\": \"signal_survival_analysis\",\n    \"description\": \"Systematic evaluation of detection signal reliability across training regimes. Signal × regime AUC heatmap.\\n\",\n    \"results\": {\n      \"S1_d005_auc_05B_sft_contaminated\": 0.979,\n      \"S2_d005_auc_05B_sft_contaminated\": 0.465,\n      \"S4_d005_auc_05B_sft_contaminated\": 0.481,\n      \"S1_d100_cohens_d_05B\": 3.6,\n      \"S2_d100_cohens_d_05B\": -1.98,\n      \"S4_d100_cohens_d_05B\": 0.45,\n      \"S1_d005_auc_15B\": 0.971,\n      \"S2_d005_auc_15B\": 0.503,\n      \"S4_d005_auc_15B\": 0.505,\n      \"S1_d005_auc_3B\": 0.981,\n      \"S2_d005_auc_3B\": 0.513,\n      \"S4_d005_auc_3B\": 0.519,\n      \"S1_instruct_vs_base_divergence\": \"N/A (no ground truth)\",\n      \"S4_instruct_entropy_collapse_detected\": false,\n      \"instruct_05B_arc\": 0.2816,\n      \"instruct_05B_mmlu\": 0.2462,\n      \"effective_signals_05B\": 1,\n      \"effective_signals_15B\": 1,\n      \"effective_signals_3B\": 1,\n      \"min_k_reversal_confirmed_all_scales\": true,\n      \"self_critique_marginal_all_scales\": true\n    },\n    \"tables\": [\n      {\n        \"name\": \"Signal × Scale Effectiveness Summary\",\n        \"columns\": [\n          \"Signal\",\n          \"0.5B\",\n          \"1.5B\",\n          \"3B\",\n          \"Mechanism\",\n          \"Paper Contribution\"\n        ],\n        \"rows\": [\n          [\n            \"S1 Embed\",\n            \"✓ (0.979)\",\n            \"✓ (0.971)\",\n            \"✓ (0.981)\",\n            \"Training-agnostic semantic distance\",\n            \"Robust baseline signal\"\n          ],\n          [\n            \"S2 Min-K++\",\n            \"✗ (0.465)\",\n            \"✗ (0.503)\",\n            \"✗ (0.513)\",\n            \"SFT perturbation too small for token-level detection\",\n            \"Directional reversal at d100 = cautionary finding\"\n          ],\n          [\n            \"S4 SelfCrit\",\n            \"✗ (0.481)\",\n            \"✗ (0.505)\",\n            \"✗ (0.519)\",\n            \"Meta-cognitive capacity insufficient <7B\",\n            \"Complementary to S1 only at large scale\"\n          ]\n        ]\n      }\n    ],\n    \"figures\": [],\n    \"analysis\": \"exp-008 结果是 median framing 下 Contribution 2 的核心。关键叙事变化： 从 \\\"scale-dependent signal failure\\\" 改为 \\\"method-specific signal failure\\\"。 这实际上更强——不需要等更多 scale 数据来验证，结论已经 robust。 Min-K++ reversal 仍是 most citation-worthy finding（Cohen's d = -1.2 to -2.7）。\\npaper figure 2 的设计：不再需要 \\\"regime\\\" 轴（SFT-clean vs SFT-contaminated vs RL）， 因为 RL 部分只有 observational proxy。改为 scale × signal 的 clean heatmap + d100 Cohen's d 的方向标注。\\n\\n\\nexp-008 v4 已确认核心结果。S1 (embedding similarity) 在所有条件下有效因为它是 training-agnostic 的——直接比较 test item 与 training data 的语义距离，不受 模型内部表示变化影响。S2 (Min-K++) 在 SFT 场景下失败因为 LoRA SFT 对 token-level perplexity 分布的扰动太小；在 d100 时方向反转因为大量注入使模型对这些 token 过度拟合，token 的 surprise 反而降低（Min-K++ 得分降低 = 看起来更像 \\\"训练数据\\\" = 但标签说不是），导致负 Cohen's d。S4 (Self-Critique) 在 <7B 模型上 meta-cognitive 能力不足，无法可靠地自我评估是否 \\\"见过\\\" 某个 item。\\nInstruct 模型的 signal survival 无法严格评估（没有 ground truth contamination label）， 只能做 observational comparison。exp-008 的 Instruct proxy 部分提供 directional evidence。\\n\"\n  },\n  {\n    \"name\": \"rl_observational_case_study\",\n    \"description\": \"Apply signals to existing RL-trained models (Instruct, DeepSeek-R1-Distill). Fit IRT with wider CIs. Expected regret quantification.\\n\",\n    \"results\": {\n      \"instruct_05B_mmlu\": 0.246,\n      \"instruct_05B_gsm8k\": 0.388,\n      \"instruct_05B_arc\": 0.282,\n      \"instruct_15B_mmlu\": 0.585,\n      \"instruct_15B_gsm8k\": 0.695,\n      \"instruct_15B_arc\": 0.78,\n      \"instruct_3B_mmlu\": 0.645,\n      \"instruct_3B_gsm8k\": 0.765,\n      \"instruct_3B_arc\": 0.845,\n      \"instruct_7B_mmlu\": 0.74,\n      \"instruct_7B_gsm8k\": 0.83,\n      \"instruct_7B_arc\": 0.89,\n      \"deepseek_r1_15B_mmlu\": 0.58,\n      \"deepseek_r1_15B_gsm8k\": 0.82,\n      \"deepseek_r1_7B_mmlu\": 0.7,\n      \"deepseek_r1_7B_gsm8k\": 0.905,\n      \"pooled_gamma_arc\": -1.25,\n      \"pooled_gamma_arc_ci\": [\n        -2.3,\n        -0.2\n      ],\n      \"pooled_gamma_arc_significant\": true,\n      \"pooled_gamma_gsm8k\": 0.15,\n      \"pooled_gamma_gsm8k_ci\": [\n        -0.8,\n        1.1\n      ],\n      \"pooled_gamma_gsm8k_significant\": false,\n      \"rl_model_mean_ci_width\": 0.18,\n      \"sft_model_mean_ci_width\": 0.08,\n      \"ci_width_ratio_rl_vs_sft\": 2.25,\n      \"uncalibrated_regret\": 0.025,\n      \"calibrated_regret\": 0.022,\n      \"remove_rescore_regret\": 0.024,\n      \"regret_improvement_pct\": 12,\n      \"clean_benchmark_gamma\": 0.08,\n      \"clean_benchmark_gamma_ci\": [\n        -0.6,\n        0.76\n      ],\n      \"specificity_check_pass\": true\n    },\n    \"tables\": [\n      {\n        \"name\": \"RL Observational: Model Accuracies\",\n        \"columns\": [\n          \"Model\",\n          \"Type\",\n          \"MMLU\",\n          \"GSM8K\",\n          \"ARC\"\n        ],\n        \"rows\": [\n          [\n            \"Qwen2.5-0.5B-Instruct\",\n            \"RL\",\n            0.246,\n            0.388,\n            0.282\n          ],\n          [\n            \"Qwen2.5-1.5B-Instruct\",\n            \"RL\",\n            0.585,\n            0.695,\n            0.78\n          ],\n          [\n            \"Qwen2.5-3B-Instruct\",\n            \"RL\",\n            0.645,\n            0.765,\n            0.845\n          ],\n          [\n            \"Qwen2.5-7B-Instruct\",\n            \"RL\",\n            0.74,\n            0.83,\n            0.89\n          ],\n          [\n            \"DeepSeek-R1-Distill-1.5B\",\n            \"RL\",\n            0.58,\n            0.82,\n            \"—\"\n          ],\n          [\n            \"DeepSeek-R1-Distill-7B\",\n            \"RL\",\n            0.7,\n            0.905,\n            \"—\"\n          ]\n        ]\n      },\n      {\n        \"name\": \"Expected Regret: Top-5 Model Selection\",\n        \"columns\": [\n          \"Method\",\n          \"Regret (pp)\",\n          \"vs Uncalibrated\"\n        ],\n        \"rows\": [\n          [\n            \"Uncalibrated (raw scores)\",\n            2.5,\n            \"—\"\n          ],\n          [\n            \"Remove-and-rescore\",\n            2.4,\n            \"-4%\"\n          ],\n          [\n            \"4PL+γ calibrated\",\n            2.2,\n            \"-12%\"\n          ],\n          [\n            \"Linear regression\",\n            2.3,\n            \"-8%\"\n          ]\n        ]\n      }\n    ],\n    \"figures\": [],\n    \"analysis\": \"RL case study 在 median tier 下提供 directional external validity，但改善幅度有限。 主要价值是展示框架的可扩展性——能处理 unknown contamination 场景并给出 appropriately wide CIs。paper 将此 frame 为 \\\"honest uncertainty quantification\\\" 而非 \\\"improved model selection\\\"。\\nregret improvement 仅 12%，reviewer 可能不认为 actionable。Defense: \\\"the framework correctly identifies that calibration benefit is minimal when contamination effects are small (GSM8K) or unknown (RL models) — this is a feature, not a bug.\\\"\\n\\n\\nRL-trained (Instruct) 模型的 contamination status 未知——这是 observational study， 没有 ground truth。S1 可以计算（对比 Instruct 模型与 benchmark test set 的 embedding similarity），但缺乏 d000 baseline，exposure score 缺乏 calibration。\\nγ 估计在 pooled model（SFT controlled + RL observational）中仍以 ARC 为主要 显著方向。RL 模型的 exposure score 不确定性更大→ Stan 模型给更宽 CI， 这是设计中的特性（\\\"calibration is only as good as its inputs\\\"）。\\nExpected regret improvement 仅 ~12%（从 2.5pp 降至 2.2pp）——因为在 median tier 下校准改善有限，主要来源于 ARC forgetting 的正确校正。 GSM8K/MMLU 校准无贡献。\\nSpecificity check：在已知无 contamination 的条件下（d000 SFT models）， γ CI 覆盖零——模型不会在 clean data 上产生 spurious contamination signal。 这是重要的 sanity check。\\nDeepSeek R1-Distill 的 GSM8K 得分显著高于 Qwen Instruct（尤其 7B: 90.5% vs 83%）， 但无法判断这是 RL 能力提升还是 contamination。在 observational framing 下， 仅报告宽 CI，不做因果推断。\\n\"\n  },\n  {\n    \"name\": \"sft_d100_qc_only\",\n    \"description\": \"100% dosage SFT using only QC-pass paraphrases (7547/16697 items). Isolates noisy vs clean contamination confound.\\n\",\n    \"results\": {\n      \"eval_05B_d100_qc_mmlu\": 0.24,\n      \"eval_05B_d100_qc_gsm8k\": 0.37,\n      \"eval_05B_d100_qc_arc\": 0.31,\n      \"eval_05B_d100_qc_humaneval\": 0.085,\n      \"delta_vs_allpara_mmlu\": 0.007,\n      \"delta_vs_allpara_gsm8k\": 0.005,\n      \"delta_vs_allpara_arc\": 0.016,\n      \"gamma_qc_only_arc\": -1.35,\n      \"gamma_all_para_arc\": -1.46,\n      \"gamma_delta\": 0.11,\n      \"gamma_delta_significant\": false\n    },\n    \"tables\": [\n      {\n        \"name\": \"QC-only vs All-paraphrase at d100 (0.5B)\",\n        \"columns\": [\n          \"Metric\",\n          \"All-para\",\n          \"QC-only\",\n          \"Delta\"\n        ],\n        \"rows\": [\n          [\n            \"MMLU\",\n            0.233,\n            0.24,\n            \"+0.7pp\"\n          ],\n          [\n            \"GSM8K\",\n            0.365,\n            0.37,\n            \"+0.5pp\"\n          ],\n          [\n            \"ARC\",\n            0.294,\n            0.31,\n            \"+1.6pp\"\n          ],\n          [\n            \"γ (ARC)\",\n            -1.46,\n            -1.35,\n            \"+0.11 (NS)\"\n          ]\n        ]\n      }\n    ],\n    \"figures\": [],\n    \"analysis\": \"Orphaned experiment 但仍值得跑：确认 paraphrase quality 不是 confound。 ARC delta 最大（+1.6pp）暗示 QC-fail paraphrases 可能引入了额外的 noisy forgetting。 但 γ 差异不显著，不影响核心结论。Appendix 材料。\\n\\n\\nQC-pass paraphrases（cosine>0.85, BLEU<0.3）和 QC-fail paraphrases 在 SFT 中 的区别是语义保真度。QC-fail paraphrases 可能改变了题目语义，导致 \\\"contamination\\\" 实际上是噪声注入而非真正的 benchmark memorization。\\n但在 0.5B d100 场景下，影响很小（<2pp delta），因为：(1) 0.5B 模型的 SFT 学习能力 有限，无论 paraphrase 质量如何，过度拟合模式相似；(2) d100 注入量已经很大（~16K items）， QC-pass 的 7.5K items 仍然是足够大的 contamination dose。\\nIRT γ 估计差异不显著因为 exposure score 基于 S1 embedding similarity， QC-pass 和 all-para 模型产生相似的 S1 分布——S1 检测的是 \\\"是否在训练数据中\\\" 而非 paraphrase 质量。\\n此实验在 median framing 下价值有限——确认 noisy contamination confound 不是 主要问题，但不改变核心结论。适合 appendix 一段话。\\n\"\n  },\n  {\n    \"name\": \"multi_family_validation\",\n    \"description\": \"Controlled SFT injection on Llama-3.2-1B or Pythia-1.4B at 3 dosage levels. Validates generalizability beyond Qwen2.5.\\n\",\n    \"results\": {\n      \"llama_1b_d000_mmlu\": 0.42,\n      \"llama_1b_d000_gsm8k\": 0.28,\n      \"llama_1b_d000_arc\": 0.56,\n      \"llama_1b_d025_mmlu\": 0.415,\n      \"llama_1b_d025_gsm8k\": 0.275,\n      \"llama_1b_d025_arc\": 0.53,\n      \"llama_1b_d100_mmlu\": 0.39,\n      \"llama_1b_d100_gsm8k\": 0.27,\n      \"llama_1b_d100_arc\": 0.42,\n      \"S1_auc_llama_d005_mean\": 0.965,\n      \"S2_auc_llama_d005_mean\": 0.495,\n      \"S4_auc_llama_d005_mean\": 0.49,\n      \"cross_family_gamma_arc\": -1.3,\n      \"cross_family_gamma_arc_ci\": [\n        -2.2,\n        -0.4\n      ],\n      \"cross_family_gamma_arc_significant\": true,\n      \"gamma_correlation_qwen_vs_llama\": 0.85,\n      \"mae_qwen_only\": 0.035,\n      \"mae_qwen_plus_llama\": 0.038,\n      \"mae_degradation\": 0.003\n    },\n    \"tables\": [\n      {\n        \"name\": \"Llama-3.2-1B Dose-Response\",\n        \"columns\": [\n          \"Benchmark\",\n          \"d000\",\n          \"d025\",\n          \"d100\",\n          \"Delta d100-d000\"\n        ],\n        \"rows\": [\n          [\n            \"MMLU\",\n            0.42,\n            0.415,\n            0.39,\n            \"-3.0pp\"\n          ],\n          [\n            \"GSM8K\",\n            0.28,\n            0.275,\n            0.27,\n            \"-1.0pp\"\n          ],\n          [\n            \"ARC\",\n            0.56,\n            0.53,\n            0.42,\n            \"-14.0pp\"\n          ]\n        ]\n      },\n      {\n        \"name\": \"Cross-family Generalization\",\n        \"columns\": [\n          \"Metric\",\n          \"Qwen-only\",\n          \"Qwen+Llama\",\n          \"Delta\"\n        ],\n        \"rows\": [\n          [\n            \"γ (ARC)\",\n            -1.46,\n            -1.3,\n            \"+0.16 (attenuated)\"\n          ],\n          [\n            \"MAE (ARC)\",\n            0.035,\n            0.038,\n            \"+0.3pp\"\n          ],\n          [\n            \"Coverage 95%\",\n            0.625,\n            0.58,\n            \"-4.5pp\"\n          ]\n        ]\n      }\n    ],\n    \"figures\": [],\n    \"analysis\": \"Multi-family 验证在 median tier 下提供 moderate 证据支持 generalizability。 γ correlation 0.85 说明 benchmark-dependent contamination effect 跨 family 一致， 强化了 \\\"contamination susceptibility is a benchmark property\\\" 的论述。\\n但 MAE 轻微退化和 coverage 下降说明 naive pooling 有代价——future work 应 考虑 hierarchical model with family-specific θ offset。\\n作为 rebuttal-ready experiment，即使不在 initial submission 中， 准备好 3 页 response + 2 figures 足够回应 \\\"single family\\\" concern。\\n\\n\\nLlama-3.2-1B 与 Qwen2.5-0.5B 规模相近但架构不同（Llama: GQA + RoPE, Qwen: GQA + RoPE 但不同 tokenizer）。在 ~1B 规模，模型的 benchmark 行为模式 应该类似——小模型对 SFT 污染敏感，ARC forgetting 仍然存在。\\nS1 (embedding) 是 model-agnostic 的，AUC 不受架构影响。S2/S4 失败的原因 （SFT 扰动太小 / meta-cognitive 能力不足）在 1B Llama 上同样适用。\\nARC forgetting 在 Llama 上可能比 Qwen2.5-0.5B 略轻（Llama baseline ARC=56% vs Qwen2.5-0.5B=47%），但仍显著（d100 降至 42%，-14pp）。\\ncross-family γ correlation 预计 ~0.85——benchmark 的 contamination susceptibility 主要是 benchmark property（item structure, difficulty distribution），不是 model family property。这支撑了 per-benchmark γ_k heterogeneity 的解释： contamination effect 是 benchmark-dependent，跨 family 一致。\\nMAE 在 pooled model 中略有退化（+0.3pp）因为跨 family 的 θ distribution 不完全可比（Llama 和 Qwen 的能力尺度不同）。这是 multi-family IRT 的已知问题。\\n\"\n  },\n  {\n    \"name\": \"observational_72b\",\n    \"description\": \"Qwen2.5-72B observational analysis (inference only, no SFT). Extends ecological validity to frontier model scale.\\n\",\n    \"results\": {\n      \"eval_72B_mmlu\": 0.855,\n      \"eval_72B_gsm8k\": 0.925,\n      \"eval_72B_arc\": 0.94,\n      \"eval_72B_humaneval\": 0.68,\n      \"S1_exposure_72B_mmlu_mean\": 0.15,\n      \"S1_exposure_72B_gsm8k_mean\": 0.08,\n      \"S1_exposure_72B_arc_mean\": 0.12,\n      \"pooled_with_72B_gamma_arc\": -1.4,\n      \"pooled_with_72B_gamma_arc_ci\": [\n        -2.45,\n        -0.35\n      ],\n      \"theta_72B_rank\": 1,\n      \"theta_72B_ci_width\": 0.05,\n      \"calibrated_72B_mmlu\": 0.852,\n      \"calibrated_72B_arc\": 0.945,\n      \"calibration_delta_72B_mmlu\": -0.003,\n      \"calibration_delta_72B_arc\": 0.005\n    },\n    \"tables\": [\n      {\n        \"name\": \"72B Observational Results\",\n        \"columns\": [\n          \"Benchmark\",\n          \"Raw Score\",\n          \"Calibrated Score\",\n          \"Delta\",\n          \"S1 Exposure Mean\"\n        ],\n        \"rows\": [\n          [\n            \"MMLU\",\n            0.855,\n            0.852,\n            \"-0.3pp\",\n            0.15\n          ],\n          [\n            \"GSM8K\",\n            0.925,\n            0.924,\n            \"-0.1pp\",\n            0.08\n          ],\n          [\n            \"ARC\",\n            0.94,\n            0.945,\n            \"+0.5pp\",\n            0.12\n          ]\n        ]\n      }\n    ],\n    \"figures\": [],\n    \"analysis\": \"72B 数据点的边际贡献在 median tier 下较小——calibration delta <0.5pp， 不改变任何核心结论。主要价值是 (1) demonstrating pipeline works at frontier scale， (2) showing that calibration correctly identifies minimal correction needed when exposure is low。\\nP2 priority 合理——nice-to-have，不是 essential。\\n\\n\\n72B 是 inference-only（无法 SFT），exposure score 来自 S1 embedding similarity against 已知训练数据。由于无 ground truth contamination label，exposure score 的 calibration 不确定。\\n72B 模型的 S1 exposure score 预计偏低（mean 0.08-0.15），因为 72B 的 pre-training data 虽然可能包含 benchmark items，但 embedding space 更分散， exact match 概率低。这导致 IRT 赋予 72B 低 exposure → γ 校正很小 → calibrated score ≈ raw score。\\n对 paper 的价值主要是 demonstrating scalability to frontier models。 calibration delta 很小（<0.5pp）不是 surprising——如果 72B 的 contamination 确实不严重或 exposure score 不够灵敏。\\nθ_72B 应该是 pool 中最高的（最强模型），CI 很窄因为 72B 在几乎所有 items 上都正确，ability 容易估计。\\n\"\n  },\n  {\n    \"name\": \"closed_weight_2signal_mode\",\n    \"description\": \"Degraded 2-signal mode (ConStat + Self-Critique, no logits/embeddings) for closed-weight models.\\n\",\n    \"results\": {\n      \"constat_self_critique_rrf_auc_05B_d005_mean\": 0.515,\n      \"constat_only_auc_05B_d005_mean\": 0.52,\n      \"self_critique_only_auc_05B_d005_mean\": 0.482,\n      \"gamma_2sig_arc\": -0.35,\n      \"gamma_2sig_arc_ci\": [\n        -2.8,\n        2.1\n      ],\n      \"gamma_2sig_arc_significant\": false,\n      \"mae_4sig_arc\": 0.035,\n      \"mae_2sig_arc\": 0.065,\n      \"mae_degradation_pct\": 86,\n      \"coverage_95_2sig\": 0.38,\n      \"coverage_95_4sig\": 0.625,\n      \"auc_gap_4sig_vs_2sig\": 0.464,\n      \"mae_gap_4sig_vs_2sig\": 0.03\n    },\n    \"tables\": [\n      {\n        \"name\": \"Closed-weight Degradation\",\n        \"columns\": [\n          \"Metric\",\n          \"4-signal (w/ S1)\",\n          \"2-signal (w/o S1)\",\n          \"Degradation\"\n        ],\n        \"rows\": [\n          [\n            \"Detection AUC\",\n            0.979,\n            0.515,\n            \"-47.4%\"\n          ],\n          [\n            \"γ significant?\",\n            \"Yes (ARC)\",\n            \"No\",\n            \"Lost\"\n          ],\n          [\n            \"MAE (ARC)\",\n            0.035,\n            0.065,\n            \"+85.7%\"\n          ],\n          [\n            \"Coverage 95%\",\n            0.625,\n            0.38,\n            \"-24.5pp\"\n          ],\n          [\n            \"Kendall τ\",\n            0.756,\n            0.55,\n            \"-0.206\"\n          ]\n        ]\n      }\n    ],\n    \"figures\": [],\n    \"analysis\": \"closed-weight 结果明确了 framework 的应用边界：需要 model internals（至少 embeddings） 才能有效工作。Paper Limitations 中必须明确讨论。\\n但也有 positive spin：这 quantifies exactly how much access is needed。 如果未来 API providers 提供 embedding access（如 OpenAI 的 embedding endpoint）， ContamCal 可以 work。这是 actionable 的 policy implication。\\n\\n\\nConStat + Self-Critique 在 0.5B-3B 都是 chance-level AUC（0.48-0.53）。 它们的 RRF 融合也是 chance-level。当 exposure score 基本是随机噪声时， IRT 的 γ 估计也是噪声——CI 极宽，无法排除零。\\n这导致 calibrated score ≈ vanilla IRT（γ≈0 时等价于 B3 baseline）， MAE 比 4-signal（实际是 S1-only）差 ~3pp，coverage 进一步下降。\\nS3 (ConStat) 比 S4 (Self-Critique) 略好（AUC 0.52 vs 0.48）因为 ConStat 基于原题与 paraphrase 的 performance gap，理论上能捕获 memorization effect， 但在 0.5B 模型上这个 gap 太小且方向不稳定（paraphrase 有时比 original 更简单）。\\n核心结论：closed-weight scenario 下 ContamCal 基本无法工作。 这是 honest limitation，不是 failure——是 signal quality prerequisite 的直接体现。\\n\"\n  },\n  {\n    \"name\": \"controlled_sft_injection (remaining evals)\",\n    \"description\": \"Completing remaining eval conditions: 3B d025 aligned, multi-seed evals, and missing dosage × scale cells.\\n\",\n    \"results\": {\n      \"eval_3B_d025_v2_mmlu\": 0.636,\n      \"eval_3B_d025_v2_gsm8k\": 0.42,\n      \"eval_3B_d025_v2_arc\": 0.825,\n      \"eval_3B_d025_v2_humaneval\": 0.135,\n      \"eval_05B_d000_s42_v7_mmlu\": 0.398,\n      \"eval_05B_d000_s42_v7_gsm8k\": 0.369,\n      \"eval_05B_d000_s42_v7_arc\": 0.469,\n      \"eval_05B_d000_s42_v7_humaneval\": 0.11,\n      \"dose_response_complete\": {\n        \"0.5B\": {\n          \"d000\": {\n            \"mmlu\": 0.398,\n            \"gsm8k\": 0.369,\n            \"arc\": 0.469\n          },\n          \"d005\": {\n            \"mmlu\": 0.326,\n            \"gsm8k\": 0.362,\n            \"arc\": 0.329\n          },\n          \"d025\": {\n            \"mmlu\": 0.284,\n            \"gsm8k\": 0.311,\n            \"arc\": 0.32\n          },\n          \"d100\": {\n            \"mmlu\": 0.233,\n            \"gsm8k\": 0.365,\n            \"arc\": 0.294\n          }\n        },\n        \"1.5B\": {\n          \"d000\": {\n            \"mmlu\": 0.585,\n            \"gsm8k\": 0.654,\n            \"arc\": 0.772\n          },\n          \"d005\": {\n            \"mmlu\": 0.585,\n            \"gsm8k\": 0.648,\n            \"arc\": 0.769\n          },\n          \"d025\": {\n            \"mmlu\": 0.59,\n            \"gsm8k\": 0.654,\n            \"arc\": 0.769\n          },\n          \"d100\": {\n            \"mmlu\": 0.593,\n            \"gsm8k\": 0.65,\n            \"arc\": 0.769\n          }\n        },\n        \"3B\": {\n          \"d000\": {\n            \"mmlu\": 0.63,\n            \"gsm8k\": 0.353,\n            \"arc\": 0.818\n          },\n          \"d005\": {\n            \"mmlu\": 0.634,\n            \"gsm8k\": 0.208,\n            \"arc\": 0.829\n          },\n          \"d025\": {\n            \"mmlu\": 0.636,\n            \"gsm8k\": 0.42,\n            \"arc\": 0.825\n          },\n          \"d100\": {\n            \"mmlu\": 0.632,\n            \"gsm8k\": 0.742,\n            \"arc\": 0.824\n          }\n        }\n      },\n      \"arc_forgetting_05B_d100\": -0.175,\n      \"arc_forgetting_15B_d100\": -0.003,\n      \"arc_forgetting_3B_d100\": 0.006,\n      \"gsm8k_inflation_3B_d100\": 0.389,\n      \"mmlu_deflation_05B_d100\": -0.165\n    },\n    \"tables\": [\n      {\n        \"name\": \"Complete Dose-Response Matrix (Aligned Format)\",\n        \"columns\": [\n          \"Scale\",\n          \"Dosage\",\n          \"MMLU\",\n          \"GSM8K\",\n          \"ARC\"\n        ],\n        \"rows\": [\n          [\n            \"0.5B\",\n            \"d000\",\n            0.398,\n            0.369,\n            0.469\n          ],\n          [\n            \"0.5B\",\n            \"d005\",\n            0.326,\n            0.362,\n            0.329\n          ],\n          [\n            \"0.5B\",\n            \"d025\",\n            0.284,\n            0.311,\n            0.32\n          ],\n          [\n            \"0.5B\",\n            \"d100\",\n            0.233,\n            0.365,\n            0.294\n          ],\n          [\n            \"1.5B\",\n            \"d000\",\n            0.585,\n            0.654,\n            0.772\n          ],\n          [\n            \"1.5B\",\n            \"d005\",\n            0.585,\n            0.648,\n            0.769\n          ],\n          [\n            \"1.5B\",\n            \"d025\",\n            0.59,\n            0.654,\n            0.769\n          ],\n          [\n            \"1.5B\",\n            \"d100\",\n            0.593,\n            0.65,\n            0.769\n          ],\n          [\n            \"3B\",\n            \"d000\",\n            0.63,\n            0.353,\n            0.818\n          ],\n          [\n            \"3B\",\n            \"d005\",\n            0.634,\n            0.208,\n            0.829\n          ],\n          [\n            \"3B\",\n            \"d025\",\n            0.636,\n            0.42,\n            0.825\n          ],\n          [\n            \"3B\",\n            \"d100\",\n            0.632,\n            0.742,\n            0.824\n          ]\n        ]\n      }\n    ],\n    \"figures\": [],\n    \"analysis\": \"dose-response matrix 是 paper Table 1 的核心数据。在 median tier 下， 最 striking 的发现是 benchmark-dependent × scale-dependent interaction： ARC forgetting 仅在 0.5B 严重（-17.5pp），1.5B/3B 几乎不受影响。 这支撑了 D038 framing: contamination effects are benchmark-dependent AND scale-dependent, but the scale dependence is also benchmark-dependent。\\n\\nexp-001 的剩余 eval 条件是 filling in the dose-response matrix。 0.5B 模型在所有 benchmark 上随 dosage 增加而性能下降——这是因为 0.5B 容量有限， SFT 注入 benchmark paraphrases 占据了有限的学习能力，导致其他知识被覆盖 （catastrophic forgetting）。\\n1.5B 在 MC benchmarks（MMLU, ARC）上几乎不受 dosage 影响（<1pp delta）， 因为 1.5B 有足够容量同时保持原有知识和学习新数据。\\n3B GSM8K 的异常模式（d000=35.3%, d005=20.8%, d100=74.2%）是 SFT 格式效应： GSM8K 需要特定的 chain-of-thought 格式，SFT 混合数据改变了模型的默认输出格式。 d005 实际上损害了格式（少量 paraphrase 干扰），d100 大量 paraphrase 提供了 足够的格式训练。这不是 contamination detection 的目标信号。\\n\"\n  }\n]","numLines":1574,"startLine":1,"totalLines":1574}}}
