\newlabel{tab:calibration}{{5}{6}{Calibration metrics on ARC. ContamCal MAE${=}0.030$ significantly outperforms B4 linear regression MAE${=}0.052$ (bootstrap $p{=}0.03$). Coverage reaches 63\% at 95\% CI with $N{=}24$ pooling. GSM8K is correctly gated out}{table.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Min-K++ (S2) Cohen's $d$ for contaminated vs.\ clean items across scales. Negative $d$ indicates reversal---contaminated items score \emph  {lower} than clean items. Effect attenuates with scale but persists through 3B across both model families.}}{6}{table.6}\protected@file@percent }
\newlabel{tab:reversal}{{6}{6}{Min-K++ (S2) Cohen's $d$ for contaminated vs.\ clean items across scales. Negative $d$ indicates reversal---contaminated items score \emph {lower} than clean items. Effect attenuates with scale but persists through 3B across both model families}{table.6}{}}
