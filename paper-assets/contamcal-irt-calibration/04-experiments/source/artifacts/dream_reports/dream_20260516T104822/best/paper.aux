\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces 4-signal vs.\ 2-signal (closed-weight) calibration. Removing S1 (embedding similarity) causes significant MAE degradation (+0.032, $p{=}0.012$). The $\gamma $ estimate attenuates to 54\% of the full-signal value ($-$0.65 vs.\ $-$1.2), as noisy exposure scores push the posterior toward the prior.}}{7}{table.7}\protected@file@percent }
\newlabel{tab:2signal}{{7}{7}{4-signal vs.\ 2-signal (closed-weight) calibration. Removing S1 (embedding similarity) causes significant MAE degradation (+0.032, $p{=}0.012$). The $\gam $ estimate attenuates to 54\% of the full-signal value ($-$0.65 vs.\ $-$1.2), as noisy exposure scores push the posterior toward the prior}{table.7}{}}
\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces Observational model accuracies and mean RRF exposure (Exp.$\bar  {}$). Low exposure ($\bar  {x}{=}0.032$) produces appropriately wide CIs: ARC $\gamma {=}{-}0.38$ [$-$1.65, 0.89], GSM8K $\gamma {=}0.15$ [$-$0.72, 1.02]. Specificity confirmed: clean benchmark $\gamma {=}0.04$ [$-$0.55, 0.63].}}{7}{table.8}\protected@file@percent }
\newlabel{tab:obs}{{8}{7}{Observational model accuracies and mean RRF exposure (Exp.$\bar {}$). Low exposure ($\bar {x}{=}0.032$) produces appropriately wide CIs: ARC $\gam {=}{-}0.38$ [$-$1.65, 0.89], GSM8K $\gam {=}0.15$ [$-$0.72, 1.02]. Specificity confirmed: clean benchmark $\gam {=}0.04$ [$-$0.55, 0.63]}{table.8}{}}
