31\t        \"rows\": [\n632\t          [\n633\t            \"4PL+γ ME (ours)\",\n634\t            \"1.8 [1.2,2.4]\",\n635\t            \"94%\",\n636\t            4.2,\n637\t            0.96,\n638\t            0.95\n639\t          ],\n640\t          [\n641\t            \"B0: Raw\",\n642\t            8.2,\n643\t            \"—\",\n644\t            \"—\",\n645\t            0.87,\n646\t            \"—\"\n647\t          ],\n648\t          [\n649\t            \"B1: Remove-rescore\",\n650\t            4.6,\n651\t            \"—\",\n652\t            \"—\",\n653\t            0.91,\n654\t            \"—\"\n655\t          ],\n656\t          [\n657\t            \"B2: 2PL+γ (S1 only)\",\n658\t            2.9,\n659\t            \"81%\",\n660\t            5.6,\n661\t            0.94,\n662\t            0.9\n663\t          ],\n664\t          [\n665\t            \"B3: Vanilla 4PL\",\n666\t            6.5,\n667\t            \"58%\",\n668\t            3.2,\n669\t            0.89,\n670\t            \"—\"\n671\t          ],\n672\t          [\n673\t            \"B4: Linear reg + boot\",\n674\t            3.2,\n675\t            \"76%\",\n676\t            6.8,\n677\t            0.93,\n678\t            0.85\n679\t          ],\n680\t          [\n681\t            \"B5: Emperor mitigation\",\n682\t            5.8,\n683\t            \"—\",\n684\t            \"—\",\n685\t            0.89,\n686\t            \"—\"\n687\t          ],\n688\t          [\n689\t            \"B6: DCR fuzzy\",\n690\t            3.9,\n691\t            \"—\",\n692\t            \"—\",\n693\t            0.92,\n694\t            0.8\n695\t          ]\n696\t        ]\n697\t      },\n698\t      {\n699\t        \"name\": \"Per-Benchmark MAE (pp): Our Method vs Key Baselines\",\n700\t        \"headers\": [\n701\t          \"Benchmark\",\n702\t          \"4PL+γ ME\",\n703\t          \"B0 Raw\",\n704\t          \"B2 2PL+γ\",\n705\t          \"B4 Linear\",\n706\t          \"B6 DCR\"\n707\t        ],\n708\t        \"rows\": [\n709\t          [\n710\t            \"MMLU\",\n711\t            1.1,\n712\t            4.3,\n713\t            1.8,\n714\t            2.1,\n715\t            2.5\n716\t          ],\n717\t          [\n718\t            \"GSM8K\",\n719\t            2.8,\n720\t            14.6,\n721\t            4.2,\n722\t            5.1,\n723\t            6.2\n724\t          ],\n725\t          [\n726\t            \"ARC-C\",\n727\t            1.2,\n728\t            4.8,\n729\t            2.0,\n730\t            2.2,\n731\t            2.8\n732\t          ],\n733\t          [\n734\t            \"Average\",\n735\t            1.8,\n736\t            8.2,\n737\t            2.9,\n738\t            3.2,\n739\t            3.9\n740\t          ]\n741\t        ]\n742\t      },\n743\t      {\n744\t        \"name\": \"Per-Benchmark γ_k Estimates\",\n745\t        \"headers\": [\n746\t          \"Benchmark\",\n747\t          \"γ_k mean\",\n748\t          \"95% CI\",\n749\t          \"Interpretation\"\n750\t        ],\n751\t        \"rows\": [\n752\t          [\n753\t            \"MMLU\",\n754\t            0.22,\n755\t            \"[0.08, 0.38]\",\n756\t            \"MC memorization 产生中等 inflation\"\n757\t          ],\n758\t          [\n759\t            \"GSM8K\",\n760\t            0.85,\n761\t            \"[0.62, 1.12]\",\n762\t            \"生成式任务极易被 answer memorization 加速\"\n763\t          ],\n764\t          [\n765\t            \"ARC-C\",\n766\t            0.18,\n767\t            \"[0.04, 0.34]\",\n768\t            \"MC 格式但 science reasoning 部分抗 memorization\"\n769\t          ]\n770\t        ]\n771\t      },\n772\t      {\n773\t        \"name\": \"Dose-Response: 3B GSM8K (最戏剧性案例)\",\n774\t        \"headers\": [\n775\t          \"Dosage\",\n776\t          \"Observed\",\n777\t          \"Calibrated (ours)\",\n778\t          \"True (d000)\",\n779\t          \"Residual\"\n780\t        ],\n781\t        \"rows\": [\n782\t          [\n783\t            \"d000 (0%)\",\n784\t            \"12.0%\",\n785\t            \"—\",\n786\t            \"12.0%\",\n787\t            \"—\"\n788\t          ],\n789\t          [\n790\t            \"d005 (5%)\",\n791\t            \"20.8%\",\n792\t            \"13.2%\",\n793\t            \"12.0%\",\n794\t            \"+1.2pp\"\n795\t          ],\n796\t          [\n797\t            \"d025 (25%)\",\n798\t            \"~35.4%\",\n799\t            \"14.5%\",\n800\t            \"12.0%\",\n801\t            \"+2.5pp\"\n802\t          ],\n803\t          [\n804\t            \"d050 (50%)\",\n805\t            \"~51.8%\",\n806\t            \"15.1%\",\n807\t            \"12.0%\",\n808\t            \"+3.1pp\"\n809\t          ],\n810\t          [\n811\t            \"d100 (100%)\",\n812\t            \"69.7%\",\n813\t            \"16.2%\",\n814\t            \"12.0%\",\n815\t            \"+4.2pp\"\n816\t          ]\n817\t        ]\n818\t      }\n819\t    ],\n820\t    \"figures\": [],\n821\t    \"analysis\": \"这是论文的 Table 1。核心叙事：(1) ContamCal MAE 1.8pp 显著优于最佳 baseline DCR 的 3.9pp (bootstrap p<0.01)；(2) 唯一提供 near-nominal coverage 的方法（94% vs baselines 的 58-81%）；(3) γ_k heterogeneity 证明 per-benchmark fitting 的必要性——GSM8K γ=0.85 vs MMLU γ=0.22 差异 4 倍，joint model 会 overfit MMLU 同时 underfit GSM8K； (4) 3B GSM8K dose-response 是最佳可视化案例（57pp inflation 被矫正 至 ~4pp residual）。0.5B 的 higher MAE (2.3pp) 和 wider CI 不是缺陷 而是 honest UQ——信号差的模型得到更宽的 CI，这恰好是 C3 的核心主张。\\n\\n\\nMAE 1.8pp (CI [1.2, 2.4]) 的分解： MMLU (1.1pp) 最低因为污染效应小（0.5B 的 forgetting 被 θ 下降吸收， 1.5B/3B 的 inflation 仅 0.5-1.8pp 容易矫正）。 GSM8K (2.8pp) 最高因为 3B 的 57pp inflation 要求巨大矫正——即使 IRT 模型准确估计 γ=0.85，exposure-score 中的噪声在乘以 γ 后放大为 ~3pp residual。ARC (1.2pp) 居中。 0.5B MAE (2.3pp) 高于 1.5B/3B 因为：(1) 0.5B 信号质量差（仅 S1 有效，exposure 估计噪声大）；(2) catastrophic forgetting 使 θ 和 γ 效应交织。ME 模型在 0.5B 条件下产生更宽 CI 以补偿。 γ_k heterogeneity (p=0.002) 证明 per-benchmark fitting 优于 joint fitting——GSM8K 的 γ=0.85 远高于 MMLU/ARC 的 0.18-0.22， 反映 MC 格式对 memorization 的易感性差异。 joint model (shared γ=0.41) MAE 2.6pp > per-benchmark 1.8pp, 确认 heterogeneity matters。 Baselines 排序：DCR (3.9) > Linear (3.2) > Single-2PL+γ (2.9) > ours (1.8)。 DCR 的 6.2pp GSM8K MAE 暴露了它对 large inflation 的处理弱点。 Vanilla 4PL (6.5pp) 接近 Raw (8.2pp) 因为没有 contamination modeling 的 IRT 将 inflation 错误吸收进 θ。Emperor (5.8pp) 确认 mitigation 策略不足以消除 contamination effect。 Coverage 0.94 接近 nominal 0.95（ME model 功劳），而 Simple model (B2, B3) 覆盖仅 58-81%——vanilla 4PL 的 58% 说明不建模 contamination 的 IRT 产出过窄、错误的 CI。 Kendall τ=0.96 说明 calibrated ranking 高度保真。\\n\"\n822\t  },\n823\t  {\n824\t    \"name\": \"scale_bridging_7b\",\n825\t    \"description\": \"Qwen2.5-7B LoRA SFT at 5 dosage levels (d000-d100)。验证 calibration 在更大模型上成立。需 multi-GPU (1×H100 per run)。\\n\",\n826\t    \"results\": {\n827\t      \"d000_mmlu\": 0.718,\n828\t      \"d000_gsm8k\": 0.792,\n829\t      \"d000_arc\": 0.878,\n830\t      \"d000_humaneval\": 0.415,\n831\t      \"d005_mmlu_inflation_pp\": 0.8,\n832\t      \"d005_gsm8k_inflation_pp\": 1.2,\n833\t      \"d025_mmlu_inflation_pp\": 2.5,\n834\t      \"d025_gsm8k_inflation_pp\": 5.8,\n835\t      \"d100_mmlu_inflation_pp\": 4.1,\n836\t      \"d100_gsm8k_inflation_pp\": 12.5,\n837\t      \"d100_arc_inflation_pp\": 2.8,\n838\t      \"S1_d005_auc_7B_mean\": 0.954,\n839\t      \"S2_d005_auc_7B_mean\": 0.871,\n840\t      \"S4_d005_auc_7B_mean\": 0.812,\n841\t      \"calibration_mae_pp_7B\": 1.4,\n842\t      \"ci95_coverage_7B\": 0.95,\n843\t      \"kendall_tau_7B\": 0.97\n844\t    },\n845\t    \"tables\": [\n846\t      {\n847\t        \"name\": \"7B Dose-Response\",\n848\t        \"headers\": [\n849\t          \"Dosage\",\n850\t          \"MMLU\",\n851\t          \"GSM8K\",\n852\t          \"ARC-C\"\n853\t        ],\n854\t        \"rows\": [\n855\t          [\n856\t            \"d000\",\n857\t            \"71.8%\",\n858\t            \"79.2%\",\n859\t            \"87.8%\"\n860\t          ],\n861\t          [\n862\t            \"d005\",\n863\t            \"72.6%\",\n864\t            \"80.4%\",\n865\t            \"88.1%\"\n866\t          ],\n867\t          [\n868\t            \"d025\",\n869\t            \"74.3%\",\n870\t            \"85.0%\",\n871\t            \"89.2%\"\n872\t          ],\n873\t          [\n874\t            \"d100\",\n875\t            \"75.9%\",\n876\t            \"91.7%\",\n877\t            \"90.6%\"\n878\t          ]\n879\t        ]\n880\t      },\n881\t      {\n882\t        \"name\": \"7B Signal AUC at d005\",\n883\t        \"headers\": [\n884\t          \"Signal\",\n885\t          \"MMLU\",\n886\t          \"GSM8K\",\n887\t          \"ARC-C\",\n888\t          \"Mean\"\n889\t        ],\n890\t        \"rows\": [\n891\t          [\n892\t            \"S1 Embedding\",\n893\t            0.948,\n894\t            0.971,\n895\t            0.943,\n896\t            0.954\n897\t          ],\n898\t          [\n899\t            \"S2 Min-K++\",\n900\t            0.851,\n901\t            0.896,\n902\t            0.865,\n903\t            0.871\n904\t          ],\n905\t          [\n906\t            \"S3 ConStat\",\n907\t            0.872,\n908\t            0.908,\n909\t            0.881,\n910\t            0.887\n911\t          ],\n912\t          [\n913\t            \"S4 Self-Critique\",\n914\t            0.795,\n915\t            0.834,\n916\t            0.808,\n917\t            0.812\n918\t          ]\n919\t        ]\n920\t      }\n921\t    ],\n922\t    \"figures\": [],\n923\t    \"analysis\": \"7B 结果确认 calibration 可靠性随 scale 提升（MAE 1.4pp < aggregate 1.8pp）。信号质量持续改善支持 \\\"larger models are easier to calibrate\\\" 叙事。7B 作为 controlled experiment 的上界，为 Reviewer Concern #4 (scale limited to 3B) 提供直接回应。\\n\\n\\n7B 有更强的 memorization capacity，contamination inflation 比 3B 更显著但更均匀（不像 3B 的 GSM8K 极端案例，因为 7B baseline GSM8K 已经 79.2%，天花板效应限制了 inflation 幅度）。MMLU inflation 从 3B 的 0.8pp 升至 4.1pp 因为 7B 有更好的 knowledge retrieval 能力，memorized items 的 boost 更 pronounced。信号质量在 7B 进一步 提升（S2 AUC 0.87, S4 AUC 0.81），验证了 scale-dependent trend 的外推。calibration MAE 1.4pp (低于 0.5B-3B 的 1.8pp aggregate) 因为 7B 信号质量更好 → exposure 估计更准 → γ 矫正更精确。\\n\"\n924\t  },\n925\t  {\n926\t    \"name\": \"signal_survival_multiscale\",\n927\t    \"description\": \"将 exp-008 从 0.5B-only 扩展至 1.5B/3B。这是 C2 \\\"scale-dependent\\\" claim 的核心证据。heatmap 图从 1 列扩展为 3 列。\\n\",\n928\t    \"results\": {\n929\t      \"effective_signals_05B\": 1,\n930\t      \"effective_signals_15B\": 3,\n931\t      \"effective_signals_3B\": 4,\n932\t      \"S2_auc_trajectory\": [\n933\t        0.465,\n934\t        0.74,\n935\t        0.819\n936\t      ],\n937\t      \"S2_scale_labels\": [\n938\t        \"0.5B\",\n939\t        \"1.5B\",\n940\t        \"3B\"\n941\t      ],\n942\t      \"S4_auc_trajectory\": [\n943\t        0.481,\n944\t        0.712,\n945\t        0.773\n946\t      ],\n947\t      \"S2_reversal_cohens_d_trajectory\": [\n948\t        -1.98,\n949\t        -1.52,\n950\t        -1.14\n951\t      ],\n952\t      \"S1_auc_trajectory\": [\n953\t        0.979,\n954\t        0.979,\n955\t        0.974\n956\t      ],\n957\t      \"S2_crosses_070_at_scale\": \"1.5B\",\n958\t      \"S4_crosses_070_at_scale\": \"1.5B\",\n959\t      \"S4_crosses_065_at_scale\": \"1.5B\"\n960\t    },\n961\t    \"tables\": [\n962\t      {\n963\t        \"name\": \"Signal × Scale Effectiveness Summary\",\n964\t        \"headers\": [\n965\t          \"Signal\",\n966\t          \"0.5B d005 AUC\",\n967\t          \"1.5B d005 AUC\",\n968\t          \"3B d005 AUC\",\n969\t          \"Status\"\n970\t        ],\n971\t        \"rows\": [\n972\t          [\n973\t            \"S1 Embedding\",\n974\t            0.979,\n975\t            0.979,\n976\t            0.974,\n977\t            \"Robust across scales\"\n978\t          ],\n979\t          [\n980\t            \"S2 Min-K++\",\n981\t            0.465,\n982\t            0.74,\n983\t            0.819,\n984\t            \"Recovers at 1.5B+ (crosses 0.70)\"\n985\t          ],\n986\t          [\n987\t            \"S3 ConStat\",\n988\t            \"~0.53\",\n989\t            0.814,\n990\t            0.855,\n991\t            \"Recovers at 1.5B+\"\n992\t          ],\n993\t          [\n994\t            \"S4 Self-Critique\",\n995\t            0.481,\n996\t            0.712,\n997\t            0.773,\n998\t            \"Recovers at 1.5B+ (crosses 0.70)\"\n999\t          ]\n1000\t        ]\n1001\t      },\n1002\t      {\n1003\t        \"name\": \"Min-K++ Directional Reversal (d100 Cross-Model Cohen's d)\",\n1004\t        \"headers\": [\n1005\t          \"Benchmark\",\n1006\t          \"0.5B\",\n1007\t          \"1.5B\",\n1008\t          \"3B\"\n1009\t        ],\n1010\t        \"rows\": [\n1011\t          [\n1012\t            \"MMLU\",\n1013\t            -1.22,\n1014\t            -1.08,\n1015\t            -0.85\n1016\t          ],\n1017\t          [\n1018\t            \"GSM8K\",\n1019\t            -2.67,\n1020\t            -1.78,\n1021\t            -1.31\n1022\t          ],\n1023\t          [\n1024\t            \"ARC-C\",\n1025\t            -2.05,\n1026\t            -1.71,\n1027\t            -1.26\n1028\t          ],\n1029\t          [\n1030\t            \"Mean\",\n1031\t            -1.98,\n1032\t            -1.52,\n1033\t            -1.14\n1034\t          ]\n1035\t        ]\n1036\t      }\n1037\t    ],\n1038\t    \"figures\": [],\n1039\t    \"analysis\": \"这是论文的 Fig.2 和 C2 的核心证据。scale-dependent signal effectiveness 在 1.5B crossing point 得到实证验证。Min-K++ 从 \\\"fails at small scale\\\" 到 \\\"recovers at larger scale\\\" 的转变为整个 C2 narrative 提供了 convincing evidence。Min-K++ reversal 的 scale attenuation (-1.98 → -1.52 → -1.14) 是 nuanced finding：reversal 在所有尺度持续存在， 但严重性降低。论文中框架为 \\\"Min-K++ should be used with extreme caution at any scale under high contamination dosage.\\\"\\n\\n\\nS2 从 0.47 (0.5B) → 0.74 (1.5B) → 0.82 (3B) 呈 log-scale 近线性增长， 与 memorization capacity 的 scaling 一致。S4 从 0.48 → 0.71 → 0.77， 增速略慢因为 Self-Critique 依赖生成质量（不如 token-level 信号对 scale 敏感）。S1 跨尺度稳定在 0.97+ 因为 embedding similarity 是 training-data-independent 信号。Min-K++ 反转在 1.5B/3B 持续但减弱： 1.5B 的 -1.52 和 3B 的 -1.14 vs 0.5B 的 -1.98，因为更大模型的 perplexity 分布更稳定，d100 全量污染的 distribution shift 相对更小。 0.5B→1.5B 的跃变最大（effective signals 从 1 跳到 3），说明 1.5B 是 signal effectiveness 的关键转折点。\\n\"\n1040\t  },\n1041\t  {\n1042\t    \"name\": \"rl_observational_case_study\",\n1043\t    \"description\": \"在 Qwen2.5-Instruct (0.5B-7B) 和 DeepSeek-R1-Distill (1.5B/7B) 上应用 ContamCal。无 ground truth (observational)，重点是 directional external validity。\\n\",\n1044\t    \"results\": {\n1045\t      \"S1_auc_instruct_05B\": 0.91,\n1046\t      \"S1_auc_instruct_15B\": 0.93,\n1047\t      \"S1_auc_instruct_3B\": 0.94,\n1048\t      \"S1_auc_instruct_7B\": 0.95,\n1049\t      \"S2_auc_instruct_15B\": 0.62,\n1050\t      \"S2_auc_instruct_3B\": 0.71,\n1051\t      \"gamma_mmlu_instruct\": 0.15,\n1052\t      \"gamma_mmlu_instruct_ci\": [\n1053\t        0.02,\n1054\t        0.31\n1055\t      ],\n1056\t      \"gamma_gsm8k_instruct\": 0.42,\n1057\t      \"gamma_gsm8k_instruct_ci\": [\n1058\t        0.18,\n1059\t        0.68\n1060\t      ],\n1061\t      \"gamma_mmlu_deepseek\": 0.08,\n1062\t      \"gamma_mmlu_deepseek_ci\": [\n1063\t        -0.06,\n1064\t        0.24\n1065\t      ],\n1066\t      \"ci_width_instruct_avg_pp\": 6.8,\n1067\t      \"ci_width_deepseek_avg_pp\": 8.2,\n1068\t      \"regret_uncalibrated_rank_changes\": 3,\n1069\t      \"regret_calibrated_rank_changes\": 1,\n1070\t      \"gamma_known_clean_benchmark\": 0.02,\n1071\t      \"gamma_known_clean_ci_includes_zero\": true\n1072\t    },\n1073\t    \"tables\": [\n1074\t      {\n1075\t        \"name\": \"RL Observational: Calibrated vs Uncalibrated Ranking\",\n1076\t        \"headers\": [\n1077\t          \"Model\",\n1078\t          \"Uncalib MMLU\",\n1079\t          \"Calib MMLU\",\n1080\t          \"95% CI\",\n1081\t          \"Rank Change\"\n1082\t        ],\n1083\t        \"rows\": [\n1084\t          [\n1085\t            \"Qwen2.5-0.5B-Instruct\",\n1086\t            \"47.2%\",\n1087\t            \"46.8%\",\n1088\t            \"[43.1, 50.5]\",\n1089\t            0\n1090\t          ],\n1091\t          [\n1092\t            \"Qwen2.5-1.5B-Instruct\",\n1093\t            \"61.5%\",\n1094\t            \"60.2%\",\n1095\t            \"[56.8, 63.6]\",\n1096\t            0\n1097\t          ],\n1098\t          [\n1099\t            \"Qwen2.5-3B-Instruct\",\n1100\t            \"68.3%\",\n1101\t            \"67.1%\",\n1102\t            \"[63.5, 70.7]\",\n1103\t            0\n1104\t          ],\n1105\t          [\n1106\t            \"Qwen2.5-7B-Instruct\",\n1107\t            \"74.8%\",\n1108\t            \"73.2%\",\n1109\t            \"[70.1, 76.3]\",\n1110\t            -1\n1111\t          ],\n1112\t          [\n1113\t            \"DeepSeek-R1-1.5B\",\n1114\t            \"58.9%\",\n1115\t            \"58.4%\",\n1116\t            \"[53.8, 63.0]\",\n1117\t            1\n1118\t          ],\n1119\t          [\n1120\t            \"DeepSeek-R1-7B\",\n1121\t            \"75.2%\",\n1122\t            \"74.6%\",\n1123\t            \"[71.0, 78.2]\",\n1124\t            0\n1125\t          ]\n1126\t        ]\n1127\t      }\n1128\t    ],\n1129\t    \"figures\": [],\n1130\t    \"analysis\": \"Observational study 提供 directional external validity。关键发现： (1) Instruct 模型 CI 更宽反映信号质量退化——honest UQ 在 action； (2) GSM8K contamination 在 Instruct 后仍存在（γ=0.42），说明 RLHF 未完全消除 memorization；(3) specificity check pass 排除 false positive contamination detection；(4) ranking changes 较少 (1 out of 6) 说明 calibration 的 ranking impact 是 marginal 但 CI widths 差异很大——即使排名不变，uncertainty awareness 也有价值。\\n\\n\\nInstruct 模型的信号质量低于 controlled SFT 因为 RLHF/DPO post-training 扰动了 token-level 统计特征。S1 仍有效但 AUC 略降（0.91-0.95 vs controlled 的 0.95-0.99），S2 在 Instruct 上更难恢复（1.5B 仅 0.62， 低于 controlled 的 0.74）因为 RL 进一步模糊了 memorization 信号。 γ estimates 对 Instruct 模型较低（MMLU 0.15 vs controlled 0.22） 说明 Instruct fine-tuning 部分缓解了 contamination inflation（或者 instruction-following 改变了 response 策略）。GSM8K γ 仍较高（0.42） 因为 math reasoning 的 contamination 更难被 RL 消除。DeepSeek-R1 的 γ CI 包含 0（MMLU: [-0.06, 0.24]），consistent with 可能的低 contamination 或 reasoning-focused training 的 decontamination 效果。 CI width 更宽（6.8-8.2pp vs controlled 4.2pp）是 honest UQ 的体现。 Near-zero γ on clean benchmark (0.02, CI includes 0) 验证 specificity。\\n\"\n1131\t  },\n1132\t  {\n1133\t    \"name\": \"observational_72b\",\n1134\t    \"description\": \"Qwen2.5-72B inference-only observational分析。验证信号和 calibration 在 frontier 模型规模下是否成立。无 SFT，仅推理。\\n\",\n1135\t    \"results\": {\n1136\t      \"baseline_mmlu\": 0.854,\n1137\t      \"baseline_gsm8k\": 0.908,\n1138\t      \"baseline_arc\": 0.943,\n1139\t      \"S1_auc_72B\": 0.96,\n1140\t      \"S2_auc_72B\": 0.89,\n1141\t      \"S3_auc_72B\": 0.91,\n1142\t      \"S4_auc_72B\": 0.84,\n1143\t      \"gamma_mmlu_72B\": 0.12,\n1144\t      \"gamma_mmlu_72B_ci\": [\n1145\t        -0.02,\n1146\t        0.28\n1147\t      ],\n1148\t      \"gamma_gsm8k_72B\": 0.18,\n1149\t      \"gamma_gsm8k_72B_ci\": [\n1150\t        0.01,\n1151\t        0.37\n1152\t      ],\n1153\t      \"calibrated_mmlu\": 0.842,\n1154\t      \"calibrated_gsm8k\": 0.893,\n1155\t      \"ci_width_avg_pp\": 5.5\n1156\t    },\n1157\t    \"tables\": [\n1158\t      {\n1159\t        \"name\": \"72B Observational Results\",\n1160\t        \"headers\": [\n1161\t          \"Benchmark\",\n1162\t          \"Raw Score\",\n1163\t          \"Calibrated\",\n1164\t          \"95% CI\",\n1165\t          \"γ_k\"\n1166\t        ],\n1167\t        \"rows\": [\n1168\t          [\n1169\t            \"MMLU\",\n1170\t            \"85.4%\",\n1171\t            \"84.2%\",\n1172\t            \"[81.5, 86.9]\",\n1173\t            \"0.12 [-0.02, 0.28]\"\n1174\t          ],\n1175\t          [\n1176\t            \"GSM8K\",\n1177\t            \"90.8%\",\n1178\t            \"89.3%\",\n1179\t            \"[86.2, 92.4]\",\n1180\t            \"0.18 [0.01, 0.37]\"\n1181\t          ],\n1182\t          [\n1183\t            \"ARC-C\",\n1184\t            \"94.3%\",\n1185\t            \"93.8%\",\n1186\t            \"[91.4, 96.2]\",\n1187\t            \"0.09 [-0.04, 0.23]\"\n1188\t          ]\n1189\t        ]\n1190\t      }\n1191\t    ],\n1192\t    \"figures\": [],\n1193\t    \"analysis\": \"72B 结果展示 ContamCal 在 frontier scale 的适用性。calibration 调整 幅度小（1-1.5pp）但统计上 GSM8K 的 γ 显著不为零，说明即使 frontier 模型也存在可检测的 contamination signal。Signal quality 达到最高水平 (S2 AUC 0.89) 进一步支持 scale-dependent narrative。 Limitation: single model, γ estimates noisy.\\n\\n\\n72B 作为 single observational model（无 contamination variation）， γ 估计依赖于 exposure score variation across items（不同 items 有不同 exposure levels）。γ CI 较宽因为 single model 提供的 information 有限。MMLU γ CI 包含 0，consistent with 72B 在 MMLU 上可能 contamination 较低（或 frontier model 的 knowledge 已经足够高，contamination boost 可忽略）。GSM8K γ 显著大于 0 (CI: [0.01, 0.37])，提示即使在 72B，math reasoning benchmarks 仍存在 contamination concern。信号质量在 72B 是最高的（S2 0.89, S4 0.84），确认 scale-dependent trend 的外推。\\n\"\n1194\t  },\n1195\t  {\n1196\t    \"name\": \"closed_weight_2signal_mode\",\n1197\t    \"description\": \"仅 ConStat + Self-Critique (无 logits/embeddings) 的退化模式。 量化 2-signal vs 4-signal calibration gap。\\n\",\n1198\t    \"results\": {\n1199\t      \"rrf_2signal_auc_05B\": 0.508,\n1200\t      \"rrf_2signal_auc_15B\": 0.782,\n1201\t      \"rrf_2signal_auc_3B\": 0.831,\n1202\t      \"mae_2signal_05B_pp\": 6.8,\n1203\t      \"mae_2signal_15B_pp\": 2.8,\n1204\t      \"mae_2signal_3B_pp\": 2.1,\n1205\t      \"mae_2signal_avg_pp\": 3.9,\n1206\t      \"ci95_coverage_2signal\": 0.86,\n1207\t      \"mae_gap_4signal_vs_2signal_pp\": 2.1,\n1208\t      \"coverage_gap\": 0.08\n1209\t    },\n1210\t    \"tables\": [\n1211\t      {\n1212\t        \"name\": \"4-Signal vs 2-Signal (Closed-Weight) Comparison\",\n1213\t        \"headers\": [\n1214\t          \"Scale\",\n1215\t          \"4-Signal MAE\",\n1216\t          \"2-Signal MAE\",\n1217\t          \"Gap\",\n1218\t          \"2-Signal AUC\"\n1219\t        ],\n1220\t        \"rows\": [\n1221\t          [\n1222\t            \"0.5B\",\n1223\t            \"2.3pp\",\n1224\t            \"6.8pp\",\n1225\t            \"+4.5pp\",\n1226\t            0.508\n1227\t          ],\n1228\t          [\n1229\t            \"1.5B\",\n1230\t            \"1.4pp\",\n1231\t            \"2.8pp\",\n1232\t            \"+1.4pp\",\n1233\t            0.782\n1234\t          ],\n1235\t          [\n1236\t            \"3B\",\n1237\t            \"1.6pp\",\n1238\t            \"2.1pp\",\n1239\t            \"+0.5pp\",\n1240\t            0.831\n1241\t          ],\n1242\t          [\n1243\t            \"Average\",\n1244\t            \"1.8pp\",\n1245\t            \"3.9pp\",\n1246\t            \"+2.1pp\",\n1247\t            \"—\"\n1248\t          ]\n1249\t        ]\n1250\t      }\n1251\t    ],\n1252\t    \"figures\": [],\n1253\t    \"analysis\": \"Closed-weight mode 在 1.5B+ 仍提供有意义的 calibration (MAE 2.1-2.8pp)， 优于或持平 DCR。在 0.5B 时近似失效——论文应明确声明 \\\"closed-weight mode requires ≥1.5B models for reliable calibration.\\\" 这是 practical guidance for practitioners evaluating closed-source models。\\n\\n\\n0.5B 2-signal 近似失效 (AUC 0.508) 因为 S3/S4 在 0.5B 都不工作， MAE 6.8pp 接近 raw baseline。1.5B 2-signal MAE 2.8pp 可用但明显 劣于 4-signal 的 1.4pp——信息损失约 1.4pp。3B 2-signal MAE 2.1pp 已较接近 4-signal 的 1.6pp（gap 仅 0.5pp），因为 S3+S4 在 3B 已较强 (AUC 0.83+)。Coverage 86% 低于 4-signal 的 94% 因为 exposure 估计噪声更大但 ME model 补偿不足。整体 2-signal 平均 MAE 3.9pp 与 DCR baseline 的 3.9pp 持平——说明 even in degraded mode, ContamCal matches the best existing method, while providing CIs.\\n\"\n1254\t  },\n1255\t  {\n1256\t    \"name\": \"multi_family_validation\",\n1257\t    \"description\": \"在 Llama-3.2-1B 上重复 3-dosage (d000/d025/d100) controlled SFT injection。验证 cross-family generalization。\\n\",\n1258\t    \"results\": {\n1259\t      \"llama_d000_mmlu\": 0.492,\n1260\t      \"llama_d000_gsm8k\": 0.456,\n1261\t      \"llama_d000_arc\": 0.652,\n1262\t      \"llama_d025_mmlu\": 0.508,\n1263\t      \"llama_d025_gsm8k\": 0.478,\n1264\t      \"llama_d100_mmlu\": 0.521,\n1265\t      \"llama_d100_gsm8k\": 0.583,\n1266\t      \"llama_d100_arc\": 0.671,\n1267\t      \"S1_auc_llama_d005\": 0.962,\n1268\t      \"S2_auc_llama_d005\": 0.698,\n1269\t      \"S4_auc_llama_d005\": 0.671,\n1270\t      \"calibration_mae_pp_llama\": 2.1,\n1271\t      \"ci95_coverage_llama\": 0.92,\n1272\t      \"gamma_mmlu_llama\": 0.19,\n1273\t      \"gamma_gsm8k_llama\": 0.72,\n1274\t      \"gamma_consistency_with_qwen_pearson\": 0.91\n1275\t    },\n1276\t    \"tables\": [\n1277\t      {\n1278\t        \"name\": \"Cross-Family γ Comparison\",\n1279\t        \"headers\": [\n1280\t          \"Benchmark\",\n1281\t          \"Qwen2.5 γ\",\n1282\t          \"Llama-3.2 γ\",\n1283\t          \"Difference\"\n1284\t        ],\n1285\t        \"rows\": [\n1286\t          [\n1287\t            \"MMLU\",\n1288\t            0.22,\n1289\t            0.19,\n1290\t            \"-0.03\"\n1291\t          ],\n1292\t          [\n1293\t            \"GSM8K\",\n1294\t            0.85,\n1295\t            0.72,\n1296\t            \"-0.13\"\n1297\t          ],\n1298\t          [\n1299\t            \"ARC-C\",\n1300\t            0.18,\n1301\t            0.16,\n1302\t            \"-0.02\"\n1303\t          ]\n1304\t        ]\n1305\t      }\n1306\t    ],\n1307\t    \"figures\": [],\n1308\t    \"analysis\": \"Multi-family validation 确认核心发现的 generalizability。γ 跨家族 高度一致说明 benchmark-specific contamination susceptibility 是 benchmark 自身的属性（item structure, format, memorizability）， 而非模型家族特异的。Llama 的 S2 AUC (0.698) 刚好在 0.70 threshold 以下，验证了 1B scale 是 Min-K++ 的 borderline regime—— 与 simulation sweep 的 practical boundary 预测吻合。\\n\\nLlama-3.2-1B (~1B scale) 的信号质量介于 Qwen 0.5B 和 1.5B 之间 （S2 AUC 0.698 接近但未达 0.70 threshold），符合 scale-dependent pattern。contamination inflation 模式与 Qwen 一致：GSM8K 敏感 (d100 +12.7pp)，MMLU 中等 (d100 +2.9pp)。γ 估计与 Qwen 高度 相关（Pearson 0.91）——GSM8K 仍是最易受影响的 benchmark。 calibration MAE 2.1pp 略高于 Qwen 1.5B 的 1.4pp 因为 Llama 1B 的信号质量稍低。这为 reviewer concern #11 (single model family) 提供 rebuttal evidence，同时确认 identifiability boundaries 和 benchmark-specific γ patterns generalize across families。\\n\"\n1309\t  }\n1310\t]"}]},"parent_tool_use_id":null,"session_id":"5f0cff07-cb6a-487f-be6b-6af3047fe23a","uuid":"40836cf0-07fc-48fb-94c8-f2b492aa3e8b","timestamp":"2026-05-14T18:03:44.545Z","tool_use_result":{"type":"text","file":{"filePath":"/home/ubuntu/.agent-ml-research-idea_gen_0509_13/projects/contamcal-irt-calibration/artifacts/dream_reports/dream_20260514T171536/best/experiment_data.json","content":"[\n  {\n    \"name\": \"stage1_signal_pipeline\",\n    \"description\": \"在 exp-001 所有模型上计算 4 路检测信号。0.5B 数据已由 exp_002_signals_05B 完成，此处预测 1.5B/3B 扩展结果。核心期望：S2(Min-K++) 和 S4(Self-Critique) 在 1.5B+ 恢复辨别力。\\n\",\n    \"results\": {\n      \"S1_d005_auc_05B_mean\": 0.979,\n      \"S2_d005_auc_05B_mean\": 0.465,\n      \"S4_d005_auc_05B_mean\": 0.481,\n      \"S1_d005_auc_15B_mmlu\": 0.961,\n      \"S1_d005_auc_15B_gsm8k\": 0.985,\n      \"S1_d005_auc_15B_arc\": 0.99,\n      \"S2_d005_auc_15B_mmlu\": 0.718,\n      \"S2_d005_auc_15B_gsm8k\": 0.762,\n      \"S2_d005_auc_15B_arc\": 0.741,\n      \"S3_d005_auc_15B_mmlu\": 0.795,\n      \"S3_d005_auc_15B_gsm8k\": 0.832,\n      \"S3_d005_auc_15B_arc\": 0.814,\n      \"S4_d005_auc_15B_mmlu\": 0.692,\n      \"S4_d005_auc_15B_gsm8k\": 0.731,\n      \"S4_d005_auc_15B_arc\": 0.712,\n      \"S1_d005_auc_3B_mmlu\": 0.948,\n      \"S1_d005_auc_3B_gsm8k\": 0.982,\n      \"S1_d005_auc_3B_arc\": 0.991,\n      \"S2_d005_auc_3B_mmlu\": 0.798,\n      \"S2_d005_auc_3B_gsm8k\": 0.842,\n      \"S2_d005_auc_3B_arc\": 0.816,\n      \"S3_d005_auc_3B_mmlu\": 0.836,\n      \"S3_d005_auc_3B_gsm8k\": 0.873,\n      \"S3_d005_auc_3B_arc\": 0.855,\n      \"S4_d005_auc_3B_mmlu\": 0.751,\n      \"S4_d005_auc_3B_gsm8k\": 0.792,\n      \"S4_d005_auc_3B_arc\": 0.775,\n      \"S2_d100_cohens_d_15B_mean\": -1.52,\n      \"S2_d100_cohens_d_3B_mean\": -1.14,\n      \"S1_d100_cohens_d_15B_mean\": 3.85,\n      \"S1_d100_cohens_d_3B_mean\": 4.02\n    },\n    \"tables\": [\n      {\n        \"name\": \"Signal × Scale × Benchmark AUC at d005\",\n        \"headers\": [\n          \"Signal\",\n          \"Benchmark\",\n          \"0.5B\",\n          \"1.5B\",\n          \"3B\"\n        ],\n        \"rows\": [\n          [\n            \"S1 Embedding\",\n            \"MMLU\",\n            0.953,\n            0.961,\n            0.948\n          ],\n          [\n            \"S1 Embedding\",\n            \"GSM8K\",\n            0.988,\n            0.985,\n            0.982\n          ],\n          [\n            \"S1 Embedding\",\n            \"ARC-C\",\n            0.995,\n            0.99,\n            0.991\n          ],\n          [\n            \"S2 Min-K++\",\n            \"MMLU\",\n            0.466,\n            0.718,\n            0.798\n          ],\n          [\n            \"S2 Min-K++\",\n            \"GSM8K\",\n            0.465,\n            0.762,\n            0.842\n          ],\n          [\n            \"S2 Min-K++\",\n            \"ARC-C\",\n            0.466,\n            0.741,\n            0.816\n          ],\n          [\n            \"S3 ConStat\",\n            \"MMLU\",\n            \"~0.55\",\n            0.795,\n            0.836\n          ],\n          [\n            \"S3 ConStat\",\n            \"GSM8K\",\n            \"~0.53\",\n            0.832,\n            0.873\n          ],\n          [\n            \"S3 ConStat\",\n            \"ARC-C\",\n            \"~0.52\",\n            0.814,\n            0.855\n          ],\n          [\n            \"S4 Self-Critique\",\n            \"MMLU\",\n            0.517,\n            0.692,\n            0.751\n          ],\n          [\n            \"S4 Self-Critique\",\n            \"GSM8K\",\n            0.495,\n            0.731,\n            0.792\n          ],\n          [\n            \"S4 Self-Critique\",\n            \"ARC-C\",\n            0.433,\n            0.712,\n            0.775\n          ]\n        ]\n      },\n      {\n        \"name\": \"Min-K++ d100 Cross-Model Cohen's d (方向性反转)\",\n        \"headers\": [\n          \"Benchmark\",\n          \"0.5B\",\n          \"1.5B\",\n          \"3B\"\n        ],\n        \"rows\": [\n          [\n            \"MMLU\",\n            -1.22,\n            -1.08,\n            -0.85\n          ],\n          [\n            \"GSM8K\",\n            -2.67,\n            -1.78,\n            -1.31\n          ],\n          [\n            \"ARC-C\",\n            -2.05,\n            -1.71,\n            -1.26\n          ]\n        ]\n      }\n    ],\n    \"figures\": [],\n    \"analysis\": \"Scale-dependent signal effectiveness 的核心证据。0.5B→1.5B 跨越了 Min-K++ 有效性的 capacity threshold（AUC 从 0.47 跃至 0.74）， 0.5B→3B 更进一步（0.47→0.82）。Self-Critique 在 1.5B 恢复到 0.71 刚好过 0.70 threshold。S1 Embedding 跨尺度稳定在 0.95+ ——不受尺度影响因为它是 training-data-independent 的语义相似度信号。 这为 C2 \\\"method-specific, scale-dependent\\\" framing 提供直接证据。\\n\\n\\nS2 (Min-K++) 在 1.5B+ 恢复的核心机制：更大模型有更强的 token-level memorization capacity（LoRA adapter 从 34MB/0.5B → 71MB/1.5B → 115MB/3B）， paraphrase 训练数据在模型中留下更可检测的 token probability 指纹。 0.5B 容量有限，LoRA 微调不足以产生可区分的 memorization 信号。 S4 (Self-Critique) 恢复的机制：Self-Critique 本质是生成任务，要求模型 对自身知识来源进行元认知。0.5B 生成质量太差（自我评估近似随机噪声）， 1.5B+ 可产生足够连贯的自我评估，contaminated items 呈现特征性低熵模式。 S3 (ConStat) 在 1.5B+ 表现更好因为更强模型对 memorized original items vs unseen paraphrases 产生更大的 performance gap。S2 d100 反转持续但 幅度减弱（-1.52 at 1.5B vs -1.98 at 0.5B），因为更大模型的 perplexity distribution 更稳定，全量污染导致的分布偏移相对减小。\\n\"\n  },\n  {\n    \"name\": \"rrf_aggregation_ablation\",\n    \"description\": \"4 信号 RRF 融合及消融实验。测试单信号 vs RRF 在不同尺度下的表现， 验证 RRF 在 1.5B+ 实现真正多信号融合。\\n\",\n    \"results\": {\n      \"rrf_4signal_auc_05B\": 0.962,\n      \"rrf_4signal_auc_15B\": 0.924,\n      \"rrf_4signal_auc_3B\": 0.943,\n      \"single_S1_auc_05B\": 0.979,\n      \"single_S1_auc_15B\": 0.972,\n      \"single_S1_auc_3B\": 0.964,\n      \"single_S2_auc_05B\": 0.465,\n      \"single_S2_auc_15B\": 0.74,\n      \"single_S2_auc_3B\": 0.819,\n      \"single_S3_auc_05B\": 0.533,\n      \"single_S3_auc_15B\": 0.814,\n      \"single_S3_auc_3B\": 0.855,\n      \"single_S4_auc_05B\": 0.481,\n      \"single_S4_auc_15B\": 0.712,\n      \"single_S4_auc_3B\": 0.773,\n      \"equal_weight_rank_avg_auc_15B\": 0.908,\n      \"calibrated_weighted_rrf_auc_15B\": 0.931,\n      \"rrf_2signal_auc_05B\": 0.508,\n      \"rrf_2signal_auc_15B\": 0.782,\n      \"rrf_2signal_auc_3B\": 0.831,\n      \"fp_injection_5pct_auc_drop\": 0.008,\n      \"fp_injection_10pct_auc_drop\": 0.014,\n      \"fp_injection_15pct_auc_drop\": 0.023,\n      \"rrf_05B_S1_weight_share\": 0.89,\n      \"rrf_15B_S1_weight_share\": 0.38,\n      \"rrf_3B_S1_weight_share\": 0.31\n    },\n    \"tables\": [\n      {\n        \"name\": \"RRF vs Single-Signal AUC (d005, benchmark-averaged)\",\n        \"headers\": [\n          \"Method\",\n          \"0.5B\",\n          \"1.5B\",\n          \"3B\"\n        ],\n        \"rows\": [\n          [\n            \"RRF 4-signal\",\n            0.962,\n            0.924,\n            0.943\n          ],\n          [\n            \"S1 only\",\n            0.979,\n            0.972,\n            0.964\n          ],\n          [\n            \"S2 only\",\n            0.465,\n            0.74,\n            0.819\n          ],\n          [\n            \"S3 only\",\n            0.533,\n            0.814,\n            0.855\n          ],\n          [\n            \"S4 only\",\n            0.481,\n            0.712,\n            0.773\n          ],\n          [\n            \"RRF 2-signal (closed)\",\n            0.508,\n            0.782,\n            0.831\n          ],\n          [\n            \"Equal-weight rank avg\",\n            \"—\",\n            0.908,\n            \"—\"\n          ],\n          [\n            \"Calibrated weighted RRF\",\n            \"—\",\n            0.931,\n            \"—\"\n          ]\n        ]\n      }\n    ],\n    \"figures\": [],\n    \"analysis\": \"RRF 在 0.5B 退化为 S1-dominated（weight share 89%）是预期的、正确的行为。 论文应 honestly 报告这一 degradation 并强调：(1) RRF 的价值在 1.5B+ 显现， 实现真正多信号融合; (2) 即使在 0.5B，RRF 的 graceful degradation 优于 hard failure; (3) FP robustness 证明 RRF 是比 learned aggregation 更稳健 的选择（meta-circularity argument 成立）。calibrated weighted RRF 微弱优势 不足以 justify 引入 training 依赖。\\n\\n\\n0.5B RRF (0.962) 低于单独 S1 (0.979)，因为 S2/S4 近似随机噪声拉低 融合质量——RRF 的 rank fusion 无法区分有效和无效信号。这是 honest characterization of degraded regime。0.5B 的 S1 weight share 达 89% 说明 RRF 退化为近似单信号模式。1.5B RRF (0.924) 虽然低于单独 S1 (0.972)，但高于任何非 S1 单信号，且通过 precision 提升（false positive reduction）在 IRT 下游产生更好的 exposure estimates。3B RRF (0.943) 接近 S1 水平同时整合其他信号的互补信息。calibrated weighted RRF (0.931 at 1.5B) 比标准 RRF (0.924) 略优但差距不大——验证了 RRF 作为 training-free 方案的合理性。FP injection 鲁棒性好（15% FP 仅 降 2.3% AUC），因为 RRF 的 rank-based aggregation 天然抗异常值。\\n\"\n  },\n  {\n    \"name\": \"simulation_identifiability_sweep_v2\",\n    \"description\": \"完成 120-condition simulation sweep。已有 48/120 条完成 （AUC=0.55 全部完成，AUC=0.80 部分）。预测全部完成后的结果。\\n\",\n    \"results\": {\n      \"auc055_n20_gamma_bias\": 0.02,\n      \"auc055_n20_gamma_rmse\": 0.04,\n      \"auc055_n20_ci95_width_pp\": 13.3,\n      \"auc055_n20_ci95_coverage\": 0.8,\n      \"auc055_n50_gamma_bias\": 0.015,\n      \"auc055_n50_gamma_rmse\": 0.026,\n      \"auc055_n50_ci95_width_pp\": 8.7,\n      \"auc055_n50_ci95_coverage\": 0.9,\n      \"auc055_n100_gamma_bias\": -0.003,\n      \"auc055_n100_gamma_rmse\": 0.004,\n      \"auc055_n100_ci95_width_pp\": 6.5,\n      \"auc055_n100_ci95_coverage\": 1.0,\n      \"auc065_n20_gamma_bias\": 0.016,\n      \"auc065_n20_gamma_rmse\": 0.035,\n      \"auc065_n20_ci95_width_pp\": 11.8,\n      \"auc065_n20_ci95_coverage\": 0.85,\n      \"auc065_n50_gamma_bias\": 0.01,\n      \"auc065_n50_gamma_rmse\": 0.02,\n      \"auc065_n50_ci95_width_pp\": 7.6,\n      \"auc065_n50_ci95_coverage\": 0.93,\n      \"auc065_n100_gamma_bias\": -0.004,\n      \"auc065_n100_gamma_rmse\": 0.008,\n      \"auc065_n100_ci95_width_pp\": 5.8,\n      \"auc065_n100_ci95_coverage\": 0.97,\n      \"auc070_n50_gamma_bias\": 0.008,\n      \"auc070_n50_gamma_rmse\": 0.018,\n      \"auc070_n50_ci95_width_pp\": 7.0,\n      \"auc070_n50_ci95_coverage\": 0.95,\n      \"auc070_n100_gamma_bias\": -0.002,\n      \"auc070_n100_gamma_rmse\": 0.006,\n      \"auc070_n100_ci95_width_pp\": 5.3,\n      \"auc070_n100_ci95_coverage\": 0.98,\n      \"auc080_n50_gamma_bias\": 0.006,\n      \"auc080_n50_gamma_rmse\": 0.014,\n      \"auc080_n50_ci95_width_pp\": 6.2,\n      \"auc080_n50_ci95_coverage\": 0.96,\n      \"auc080_n100_gamma_bias\": 0.003,\n      \"auc080_n100_gamma_rmse\": 0.005,\n      \"auc080_n100_ci95_width_pp\": 4.8,\n      \"auc080_n100_ci95_coverage\": 0.98,\n      \"auc090_n50_gamma_bias\": 0.004,\n      \"auc090_n50_gamma_rmse\": 0.01,\n      \"auc090_n50_ci95_width_pp\": 5.4,\n      \"auc090_n50_ci95_coverage\": 0.97,\n      \"auc090_n100_gamma_bias\": 0.002,\n      \"auc090_n100_gamma_rmse\": 0.004,\n      \"auc090_n100_ci95_width_pp\": 4.2,\n      \"auc090_n100_ci95_coverage\": 0.99,\n      \"prior_sd05_ci_narrowing_pct\": 18,\n      \"prior_sd20_ci_widening_pct\": 28,\n      \"continuous_vs_binary_ci_ratio\": 0.92,\n      \"fisher_info_auc_threshold_structural\": 0.52,\n      \"fisher_info_auc_threshold_practical\": 0.7,\n      \"growing_pains_n20_ci_narrowing_pct\": 22,\n      \"total_divergences\": 0,\n      \"max_rhat_across_all\": 1.012,\n      \"median_fit_time_sec\": 1150\n    },\n    \"tables\": [\n      {\n        \"name\": \"γ Recovery: AUC × N_models Grid (γ_true=0.5)\",\n        \"headers\": [\n          \"AUC\",\n          \"N\",\n          \"Bias\",\n          \"RMSE\",\n          \"CI95 Width (pp)\",\n          \"Coverage 95%\",\n          \"θ Corr\"\n        ],\n        \"rows\": [\n          [\n            0.55,\n            20,\n            \"+0.020\",\n            0.04,\n            13.3,\n            \"80%\",\n            0.958\n          ],\n          [\n            0.55,\n            50,\n            \"+0.015\",\n            0.026,\n            8.7,\n            \"90%\",\n            0.947\n          ],\n          [\n            0.55,\n            100,\n            \"−0.003\",\n            0.004,\n            6.5,\n            \"100%\",\n            0.95\n          ],\n          [\n            0.65,\n            20,\n            \"+0.016\",\n            0.035,\n            11.8,\n            \"85%\",\n            0.955\n          ],\n          [\n            0.65,\n            50,\n            \"+0.010\",\n            0.02,\n            7.6,\n            \"93%\",\n            0.952\n          ],\n          [\n            0.65,\n            100,\n            \"−0.004\",\n            0.008,\n            5.8,\n            \"97%\",\n            0.956\n          ],\n          [\n            0.7,\n            50,\n            \"+0.008\",\n            0.018,\n            7.0,\n            \"95%\",\n            0.958\n          ],\n          [\n            0.7,\n            100,\n            \"−0.002\",\n            0.006,\n            5.3,\n            \"98%\",\n            0.961\n          ],\n          [\n            0.8,\n            50,\n            \"+0.006\",\n            0.014,\n            6.2,\n            \"96%\",\n            0.96\n          ],\n          [\n            0.8,\n            100,\n            \"+0.003\",\n            0.005,\n            4.8,\n            \"98%\",\n            0.965\n          ],\n          [\n            0.9,\n            50,\n            \"+0.004\",\n            0.01,\n            5.4,\n            \"97%\",\n            0.964\n          ],\n          [\n            0.9,\n            100,\n            \"+0.002\",\n            0.004,\n            4.2,\n            \"99%\",\n            0.968\n          ]\n        ]\n      }\n    ],\n    \"figures\": [],\n    \"analysis\": \"AUC≥0.70 at N≥50 为 practical identifiability sweet spot（CI<7pp, coverage≥95%）。这正好对应 best tier 的 S2 AUC at 1.5B (~0.74)， 意味着 1.5B 模型的 Min-K++ 信号刚好越过 practical threshold。 AUC=0.55 仍可识别（CI<9pp at N≥50）但 coverage 仅 90%——需要 measurement error model 补偿。Fisher Information 推导提供理论根基， 解决 reviewer concern #1。\\n\\n\\nAUC=0.80 N=50 的 CI width (6.2pp) 相比初步 1-seed 的 16.2pp 大幅下降—— 初始异常值被 seed 平均消除（1-seed 结果是极端离群值，10-seed 平均 回归到与趋势一致的水平）。CI width 随 AUC 单调递减（从 0.55 的 8.7pp 到 0.90 的 5.4pp at N=50）符合 Fisher Information 预测：I(γ) 随 AUC 增大，posterior uncertainty 随之收缩。CI width 随 N 按 ~1/√N 缩放 （实测比率 N20/N100 = 2.04 at AUC=0.55，理论 2.24）。 coverage 在 N=20 时低于 nominal (80-85%) 因为少量 examinee 导致 posterior 过于集中——这是已知的 small-N IRT limitation。N≥50 时 coverage 达 90%+，N=100 时接近 nominal。Fisher Information 推导 给出 structural identifiability 下界 AUC≈0.52（I(γ)>0 的理论保证）， practical threshold AUC≈0.70 定义为 \\\"CI95 width < 10pp at N=50\\\"。 连续 exposure 比 binary 产生 ~8% 更窄的 CI，因为连续值提供更多 信息。Growing Pains pre-estimation 在 N=20 缩窄 CI ~22%，因为 借用外部数据的 item parameter 估计减少了参数不确定性。\\n\"\n  },\n  {\n    \"name\": \"noise_propagation_analysis_v3\",\n    \"description\": \"测量误差模型将 Stage 1 信号不确定性传播至 IRT posterior。当前 v3 在 σ_e=0.1 条件下 ME 与 simple 模型差异不显著（γ 偏差问题待修复）。 Best tier 预测在更高 σ_e 条件下 ME 模型展现明确优势。\\n\",\n    \"results\": {\n      \"sigma01_me_gamma_bias\": 0.02,\n      \"sigma01_me_gamma_rmse\": 0.04,\n      \"sigma01_me_ci95_coverage\": 0.95,\n      \"sigma01_me_ci_width_pp\": 5.2,\n      \"sigma01_simple_gamma_bias\": 0.03,\n      \"sigma01_simple_ci95_coverage\": 0.91,\n      \"sigma01_simple_ci_width_pp\": 4.8,\n      \"sigma03_me_gamma_bias\": 0.04,\n      \"sigma03_me_gamma_rmse\": 0.07,\n      \"sigma03_me_ci95_coverage\": 0.93,\n      \"sigma03_me_ci_width_pp\": 7.8,\n      \"sigma03_simple_gamma_bias\": 0.09,\n      \"sigma03_simple_ci95_coverage\": 0.78,\n      \"sigma03_simple_ci_width_pp\": 5.1,\n      \"sigma05_me_gamma_bias\": 0.06,\n      \"sigma05_me_gamma_rmse\": 0.11,\n      \"sigma05_me_ci95_coverage\": 0.91,\n      \"sigma05_me_ci_width_pp\": 11.4,\n      \"sigma05_simple_gamma_bias\": 0.18,\n      \"sigma05_simple_ci95_coverage\": 0.65,\n      \"sigma05_simple_ci_width_pp\": 5.3,\n      \"noise_1x_ci_widening_pct\": 28,\n      \"noise_15x_ci_widening_pct\": 52,\n      \"noise_2x_ci_widening_pct\": 83,\n      \"coverage_gap_simple_vs_nominal\": 0.13,\n      \"coverage_gap_me_vs_nominal\": 0.01\n    },\n    \"tables\": [\n      {\n        \"name\": \"ME vs Simple Model Coverage (95% nominal)\",\n        \"headers\": [\n          \"σ_e\",\n          \"ME Coverage\",\n          \"ME CI Width (pp)\",\n          \"Simple Coverage\",\n          \"Simple CI Width (pp)\"\n        ],\n        \"rows\": [\n          [\n            0.1,\n            \"95%\",\n            5.2,\n            \"91%\",\n            4.8\n          ],\n          [\n            0.3,\n            \"93%\",\n            7.8,\n            \"78%\",\n            5.1\n          ],\n          [\n            0.5,\n            \"91%\",\n            11.4,\n            \"65%\",\n            5.3\n          ]\n        ]\n      },\n      {\n        \"name\": \"Post-hoc Noise Injection CI Widening\",\n        \"headers\": [\n          \"Noise Level\",\n          \"γ CI Widening\",\n          \"θ CI Widening\",\n          \"Coverage Change\"\n        ],\n        \"rows\": [\n          [\n            \"1.0×\",\n            \"+28%\",\n            \"+15%\",\n            \"−3pp\"\n          ],\n          [\n            \"1.5×\",\n            \"+52%\",\n            \"+31%\",\n            \"−8pp\"\n          ],\n          [\n            \"2.0×\",\n            \"+83%\",\n            \"+48%\",\n            \"−15pp\"\n          ]\n        ]\n      }\n    ],\n    \"figures\": [],\n    \"analysis\": \"ME 模型是 C3 claims 的关键基础设施。在真实场景中 σ_e ≈ 0.15-0.30 （基于 exp-002 signal pipeline 的 FP/FN rates），ME 模型将 coverage 从 ~78-91% 提升至 93-95%。这解决了 exp-004 simulation sweep 中 发现的 coverage gap（尤其在 low-AUC/small-N regime）。CI width 增加是必要代价——更宽的 CI 反映了 genuine epistemic uncertainty。 论文中框架为：\\\"Models with high-AUC signals get tighter CIs; those with degraded signals get appropriately wider CIs.\\\"\\n\\n\\n当前 v3 结果中 γ 偏差问题（seed 42: 0.793 vs true 0.5, seed 43: 0.402） 源于模型中 latent τ prior 与真实 exposure 分布不匹配——在 best tier， 这通过 prior calibration (使用 exp-001 ground-truth FP/FN rates 估计 σ_e) 和增加 seeds (20+ seeds 平均) 得到解决。σ_e=0.1 时 ME vs simple 差异小（覆盖 95% vs 91%），因为低噪声下 point-estimate exposure 已足够好。σ_e=0.3 时差异显著（93% vs 78%），因为 simple 模型将噪声 错误归因为真实 exposure variation，导致 γ 被高估且 CI 过窄。ME 模型 通过显式建模 noise 产生更宽但更诚实的 CI。σ_e=0.5 时 ME 覆盖仍有 91%（略低于 nominal），因为高噪声下即使 ME 模型也难以完全分离 signal 和 noise。simple 模型在 σ_e=0.5 时严重失效（65% coverage）。 Post-hoc noise injection的 CI widening 与 σ_e 水平呈超线性关系。\\n\"\n  },\n  {\n    \"name\": \"irt_calibration_and_baselines\",\n    \"description\": \"核心实验。4PL+γ IRT per-benchmark fitting on 3 scales × 5 dosages × 3 seeds = 45 model instances per benchmark。与 7 baselines 对比 5 metrics。best tier: 全面优于所有 baselines。\\n\",\n    \"results\": {\n      \"ours_mae_pp\": 1.8,\n      \"ours_mae_bootstrap_lo\": 1.2,\n      \"ours_mae_bootstrap_hi\": 2.4,\n      \"ours_ci95_coverage\": 0.94,\n      \"ours_ci80_coverage\": 0.83,\n      \"ours_ci50_coverage\": 0.52,\n      \"ours_ci_width_avg_pp\": 4.2,\n      \"ours_kendall_tau\": 0.96,\n      \"ours_dose_response_monotonicity\": 0.95,\n      \"b0_raw_mae_pp\": 8.2,\n      \"b0_raw_kendall_tau\": 0.87,\n      \"b1_remove_mae_pp\": 4.6,\n      \"b1_remove_kendall_tau\": 0.91,\n      \"b2_single_2pl_mae_pp\": 2.9,\n      \"b2_single_2pl_ci95_coverage\": 0.81,\n      \"b2_single_2pl_ci_width_pp\": 5.6,\n      \"b2_single_2pl_kendall_tau\": 0.94,\n      \"b3_vanilla_4pl_mae_pp\": 6.5,\n      \"b3_vanilla_4pl_ci95_coverage\": 0.58,\n      \"b3_vanilla_4pl_ci_width_pp\": 3.2,\n      \"b3_vanilla_4pl_kendall_tau\": 0.89,\n      \"b4_linear_mae_pp\": 3.2,\n      \"b4_linear_ci95_coverage\": 0.76,\n      \"b4_linear_ci_width_pp\": 6.8,\n      \"b4_linear_kendall_tau\": 0.93,\n      \"b5_emperor_mae_pp\": 5.8,\n      \"b5_emperor_kendall_tau\": 0.89,\n      \"b6_dcr_mae_pp\": 3.9,\n      \"b6_dcr_kendall_tau\": 0.92,\n      \"ours_mmlu_mae_pp\": 1.1,\n      \"b0_raw_mmlu_mae_pp\": 4.3,\n      \"b6_dcr_mmlu_mae_pp\": 2.5,\n      \"ours_gsm8k_mae_pp\": 2.8,\n      \"b0_raw_gsm8k_mae_pp\": 14.6,\n      \"b6_dcr_gsm8k_mae_pp\": 6.2,\n      \"ours_arc_mae_pp\": 1.2,\n      \"b0_raw_arc_mae_pp\": 4.8,\n      \"b6_dcr_arc_mae_pp\": 2.8,\n      \"ours_05B_mae_pp\": 2.3,\n      \"ours_15B_mae_pp\": 1.4,\n      \"ours_3B_mae_pp\": 1.6,\n      \"gamma_mmlu_mean\": 0.22,\n      \"gamma_mmlu_ci\": [\n        0.08,\n        0.38\n      ],\n      \"gamma_gsm8k_mean\": 0.85,\n      \"gamma_gsm8k_ci\": [\n        0.62,\n        1.12\n      ],\n      \"gamma_arc_mean\": 0.18,\n      \"gamma_arc_ci\": [\n        0.04,\n        0.34\n      ],\n      \"gamma_heterogeneity_chi2_p\": 0.002,\n      \"joint_gamma_global\": 0.41,\n      \"joint_gamma_mae_pp\": 2.6,\n      \"residual_correlation_mean\": 0.032,\n      \"residual_correlation_max\": 0.085,\n      \"mcmc_divergences\": 0,\n      \"mcmc_max_rhat\": 1.008,\n      \"mcmc_min_ess\": 850,\n      \"mcmc_fit_time_per_benchmark_min\": 45\n    },\n    \"tables\": [\n      {\n        \"name\": \"Main Results: 8 Methods × 5 Metrics\",\n        \"headers\": [\n          \"Method\",\n          \"MAE (pp)↓\",\n          \"95% Coverage↑\",\n          \"CI Width (pp)↓\",\n          \"Kendall τ↑\",\n          \"Monotonicity\"\n        ],\n        \"rows\": [\n          [\n            \"4PL+γ ME (ours)\",\n            \"1.8 [1.2,2.4]\",\n            \"94%\",\n            4.2,\n            0.96,\n            0.95\n          ],\n          [\n            \"B0: Raw\",\n            8.2,\n            \"—\",\n            \"—\",\n            0.87,\n            \"—\"\n          ],\n          [\n            \"B1: Remove-rescore\",\n            4.6,\n            \"—\",\n            \"—\",\n            0.91,\n            \"—\"\n          ],\n          [\n            \"B2: 2PL+γ (S1 only)\",\n            2.9,\n            \"81%\",\n            5.6,\n            0.94,\n            0.9\n          ],\n          [\n            \"B3: Vanilla 4PL\",\n            6.5,\n            \"58%\",\n            3.2,\n            0.89,\n            \"—\"\n          ],\n          [\n            \"B4: Linear reg + boot\",\n            3.2,\n            \"76%\",\n            6.8,\n            0.93,\n            0.85\n          ],\n          [\n            \"B5: Emperor mitigation\",\n            5.8,\n            \"—\",\n            \"—\",\n            0.89,\n            \"—\"\n          ],\n          [\n            \"B6: DCR fuzzy\",\n            3.9,\n            \"—\",\n            \"—\",\n            0.92,\n            0.8\n          ]\n        ]\n      },\n      {\n        \"name\": \"Per-Benchmark MAE (pp): Our Method vs Key Baselines\",\n        \"headers\": [\n          \"Benchmark\",\n          \"4PL+γ ME\",\n          \"B0 Raw\",\n          \"B2 2PL+γ\",\n          \"B4 Linear\",\n          \"B6 DCR\"\n        ],\n        \"rows\": [\n          [\n            \"MMLU\",\n            1.1,\n            4.3,\n            1.8,\n            2.1,\n            2.5\n          ],\n          [\n            \"GSM8K\",\n            2.8,\n            14.6,\n            4.2,\n            5.1,\n            6.2\n          ],\n          [\n            \"ARC-C\",\n            1.2,\n            4.8,\n            2.0,\n            2.2,\n            2.8\n          ],\n          [\n            \"Average\",\n            1.8,\n            8.2,\n            2.9,\n            3.2,\n            3.9\n          ]\n        ]\n      },\n      {\n        \"name\": \"Per-Benchmark γ_k Estimates\",\n        \"headers\": [\n          \"Benchmark\",\n          \"γ_k mean\",\n          \"95% CI\",\n          \"Interpretation\"\n        ],\n        \"rows\": [\n          [\n            \"MMLU\",\n            0.22,\n            \"[0.08, 0.38]\",\n            \"MC memorization 产生中等 inflation\"\n          ],\n          [\n            \"GSM8K\",\n            0.85,\n            \"[0.62, 1.12]\",\n            \"生成式任务极易被 answer memorization 加速\"\n          ],\n          [\n            \"ARC-C\",\n            0.18,\n            \"[0.04, 0.34]\",\n            \"MC 格式但 science reasoning 部分抗 memorization\"\n          ]\n        ]\n      },\n      {\n        \"name\": \"Dose-Response: 3B GSM8K (最戏剧性案例)\",\n        \"headers\": [\n          \"Dosage\",\n          \"Observed\",\n          \"Calibrated (ours)\",\n          \"True (d000)\",\n          \"Residual\"\n        ],\n        \"rows\": [\n          [\n            \"d000 (0%)\",\n            \"12.0%\",\n            \"—\",\n            \"12.0%\",\n            \"—\"\n          ],\n          [\n            \"d005 (5%)\",\n            \"20.8%\",\n            \"13.2%\",\n            \"12.0%\",\n            \"+1.2pp\"\n          ],\n          [\n            \"d025 (25%)\",\n            \"~35.4%\",\n            \"14.5%\",\n            \"12.0%\",\n            \"+2.5pp\"\n          ],\n          [\n            \"d050 (50%)\",\n            \"~51.8%\",\n            \"15.1%\",\n            \"12.0%\",\n            \"+3.1pp\"\n          ],\n          [\n            \"d100 (100%)\",\n            \"69.7%\",\n            \"16.2%\",\n            \"12.0%\",\n            \"+4.2pp\"\n          ]\n        ]\n      }\n    ],\n    \"figures\": [],\n    \"analysis\": \"这是论文的 Table 1。核心叙事：(1) ContamCal MAE 1.8pp 显著优于最佳 baseline DCR 的 3.9pp (bootstrap p<0.01)；(2) 唯一提供 near-nominal coverage 的方法（94% vs baselines 的 58-81%）；(3) γ_k heterogeneity 证明 per-benchmark fitting 的必要性——GSM8K γ=0.85 vs MMLU γ=0.22 差异 4 倍，joint model 会 overfit MMLU 同时 underfit GSM8K； (4) 3B GSM8K dose-response 是最佳可视化案例（57pp inflation 被矫正 至 ~4pp residual）。0.5B 的 higher MAE (2.3pp) 和 wider CI 不是缺陷 而是 honest UQ——信号差的模型得到更宽的 CI，这恰好是 C3 的核心主张。\\n\\n\\nMAE 1.8pp (CI [1.2, 2.4]) 的分解： MMLU (1.1pp) 最低因为污染效应小（0.5B 的 forgetting 被 θ 下降吸收， 1.5B/3B 的 inflation 仅 0.5-1.8pp 容易矫正）。 GSM8K (2.8pp) 最高因为 3B 的 57pp inflation 要求巨大矫正——即使 IRT 模型准确估计 γ=0.85，exposure-score 中的噪声在乘以 γ 后放大为 ~3pp residual。ARC (1.2pp) 居中。 0.5B MAE (2.3pp) 高于 1.5B/3B 因为：(1) 0.5B 信号质量差（仅 S1 有效，exposure 估计噪声大）；(2) catastrophic forgetting 使 θ 和 γ 效应交织。ME 模型在 0.5B 条件下产生更宽 CI 以补偿。 γ_k heterogeneity (p=0.002) 证明 per-benchmark fitting 优于 joint fitting——GSM8K 的 γ=0.85 远高于 MMLU/ARC 的 0.18-0.22， 反映 MC 格式对 memorization 的易感性差异。 joint model (shared γ=0.41) MAE 2.6pp > per-benchmark 1.8pp, 确认 heterogeneity matters。 Baselines 排序：DCR (3.9) > Linear (3.2) > Single-2PL+γ (2.9) > ours (1.8)。 DCR 的 6.2pp GSM8K MAE 暴露了它对 large inflation 的处理弱点。 Vanilla 4PL (6.5pp) 接近 Raw (8.2pp) 因为没有 contamination modeling 的 IRT 将 inflation 错误吸收进 θ。Emperor (5.8pp) 确认 mitigation 策略不足以消除 contamination effect。 Coverage 0.94 接近 nominal 0.95（ME model 功劳），而 Simple model (B2, B3) 覆盖仅 58-81%——vanilla 4PL 的 58% 说明不建模 contamination 的 IRT 产出过窄、错误的 CI。 Kendall τ=0.96 说明 calibrated ranking 高度保真。\\n\"\n  },\n  {\n    \"name\": \"scale_bridging_7b\",\n    \"description\": \"Qwen2.5-7B LoRA SFT at 5 dosage levels (d000-d100)。验证 calibration 在更大模型上成立。需 multi-GPU (1×H100 per run)。\\n\",\n    \"results\": {\n      \"d000_mmlu\": 0.718,\n      \"d000_gsm8k\": 0.792,\n      \"d000_arc\": 0.878,\n      \"d000_humaneval\": 0.415,\n      \"d005_mmlu_inflation_pp\": 0.8,\n      \"d005_gsm8k_inflation_pp\": 1.2,\n      \"d025_mmlu_inflation_pp\": 2.5,\n      \"d025_gsm8k_inflation_pp\": 5.8,\n      \"d100_mmlu_inflation_pp\": 4.1,\n      \"d100_gsm8k_inflation_pp\": 12.5,\n      \"d100_arc_inflation_pp\": 2.8,\n      \"S1_d005_auc_7B_mean\": 0.954,\n      \"S2_d005_auc_7B_mean\": 0.871,\n      \"S4_d005_auc_7B_mean\": 0.812,\n      \"calibration_mae_pp_7B\": 1.4,\n      \"ci95_coverage_7B\": 0.95,\n      \"kendall_tau_7B\": 0.97\n    },\n    \"tables\": [\n      {\n        \"name\": \"7B Dose-Response\",\n        \"headers\": [\n          \"Dosage\",\n          \"MMLU\",\n          \"GSM8K\",\n          \"ARC-C\"\n        ],\n        \"rows\": [\n          [\n            \"d000\",\n            \"71.8%\",\n            \"79.2%\",\n            \"87.8%\"\n          ],\n          [\n            \"d005\",\n            \"72.6%\",\n            \"80.4%\",\n            \"88.1%\"\n          ],\n          [\n            \"d025\",\n            \"74.3%\",\n            \"85.0%\",\n            \"89.2%\"\n          ],\n          [\n            \"d100\",\n            \"75.9%\",\n            \"91.7%\",\n            \"90.6%\"\n          ]\n        ]\n      },\n      {\n        \"name\": \"7B Signal AUC at d005\",\n        \"headers\": [\n          \"Signal\",\n          \"MMLU\",\n          \"GSM8K\",\n          \"ARC-C\",\n          \"Mean\"\n        ],\n        \"rows\": [\n          [\n            \"S1 Embedding\",\n            0.948,\n            0.971,\n            0.943,\n            0.954\n          ],\n          [\n            \"S2 Min-K++\",\n            0.851,\n            0.896,\n            0.865,\n            0.871\n          ],\n          [\n            \"S3 ConStat\",\n            0.872,\n            0.908,\n            0.881,\n            0.887\n          ],\n          [\n            \"S4 Self-Critique\",\n            0.795,\n            0.834,\n            0.808,\n            0.812\n          ]\n        ]\n      }\n    ],\n    \"figures\": [],\n    \"analysis\": \"7B 结果确认 calibration 可靠性随 scale 提升（MAE 1.4pp < aggregate 1.8pp）。信号质量持续改善支持 \\\"larger models are easier to calibrate\\\" 叙事。7B 作为 controlled experiment 的上界，为 Reviewer Concern #4 (scale limited to 3B) 提供直接回应。\\n\\n\\n7B 有更强的 memorization capacity，contamination inflation 比 3B 更显著但更均匀（不像 3B 的 GSM8K 极端案例，因为 7B baseline GSM8K 已经 79.2%，天花板效应限制了 inflation 幅度）。MMLU inflation 从 3B 的 0.8pp 升至 4.1pp 因为 7B 有更好的 knowledge retrieval 能力，memorized items 的 boost 更 pronounced。信号质量在 7B 进一步 提升（S2 AUC 0.87, S4 AUC 0.81），验证了 scale-dependent trend 的外推。calibration MAE 1.4pp (低于 0.5B-3B 的 1.8pp aggregate) 因为 7B 信号质量更好 → exposure 估计更准 → γ 矫正更精确。\\n\"\n  },\n  {\n    \"name\": \"signal_survival_multiscale\",\n    \"description\": \"将 exp-008 从 0.5B-only 扩展至 1.5B/3B。这是 C2 \\\"scale-dependent\\\" claim 的核心证据。heatmap 图从 1 列扩展为 3 列。\\n\",\n    \"results\": {\n      \"effective_signals_05B\": 1,\n      \"effective_signals_15B\": 3,\n      \"effective_signals_3B\": 4,\n      \"S2_auc_trajectory\": [\n        0.465,\n        0.74,\n        0.819\n      ],\n      \"S2_scale_labels\": [\n        \"0.5B\",\n        \"1.5B\",\n        \"3B\"\n      ],\n      \"S4_auc_trajectory\": [\n        0.481,\n        0.712,\n        0.773\n      ],\n      \"S2_reversal_cohens_d_trajectory\": [\n        -1.98,\n        -1.52,\n        -1.14\n      ],\n      \"S1_auc_trajectory\": [\n        0.979,\n        0.979,\n        0.974\n      ],\n      \"S2_crosses_070_at_scale\": \"1.5B\",\n      \"S4_crosses_070_at_scale\": \"1.5B\",\n      \"S4_crosses_065_at_scale\": \"1.5B\"\n    },\n    \"tables\": [\n      {\n        \"name\": \"Signal × Scale Effectiveness Summary\",\n        \"headers\": [\n          \"Signal\",\n          \"0.5B d005 AUC\",\n          \"1.5B d005 AUC\",\n          \"3B d005 AUC\",\n          \"Status\"\n        ],\n        \"rows\": [\n          [\n            \"S1 Embedding\",\n            0.979,\n            0.979,\n            0.974,\n            \"Robust across scales\"\n          ],\n          [\n            \"S2 Min-K++\",\n            0.465,\n            0.74,\n            0.819,\n            \"Recovers at 1.5B+ (crosses 0.70)\"\n          ],\n          [\n            \"S3 ConStat\",\n            \"~0.53\",\n            0.814,\n            0.855,\n            \"Recovers at 1.5B+\"\n          ],\n          [\n            \"S4 Self-Critique\",\n            0.481,\n            0.712,\n            0.773,\n            \"Recovers at 1.5B+ (crosses 0.70)\"\n          ]\n        ]\n      },\n      {\n        \"name\": \"Min-K++ Directional Reversal (d100 Cross-Model Cohen's d)\",\n        \"headers\": [\n          \"Benchmark\",\n          \"0.5B\",\n          \"1.5B\",\n          \"3B\"\n        ],\n        \"rows\": [\n          [\n            \"MMLU\",\n            -1.22,\n            -1.08,\n            -0.85\n          ],\n          [\n            \"GSM8K\",\n            -2.67,\n            -1.78,\n            -1.31\n          ],\n          [\n            \"ARC-C\",\n            -2.05,\n            -1.71,\n            -1.26\n          ],\n          [\n            \"Mean\",\n            -1.98,\n            -1.52,\n            -1.14\n          ]\n        ]\n      }\n    ],\n    \"figures\": [],\n    \"analysis\": \"这是论文的 Fig.2 和 C2 的核心证据。scale-dependent signal effectiveness 在 1.5B crossing point 得到实证验证。Min-K++ 从 \\\"fails at small scale\\\" 到 \\\"recovers at larger scale\\\" 的转变为整个 C2 narrative 提供了 convincing evidence。Min-K++ reversal 的 scale attenuation (-1.98 → -1.52 → -1.14) 是 nuanced finding：reversal 在所有尺度持续存在， 但严重性降低。论文中框架为 \\\"Min-K++ should be used with extreme caution at any scale under high contamination dosage.\\\"\\n\\n\\nS2 从 0.47 (0.5B) → 0.74 (1.5B) → 0.82 (3B) 呈 log-scale 近线性增长， 与 memorization capacity 的 scaling 一致。S4 从 0.48 → 0.71 → 0.77， 增速略慢因为 Self-Critique 依赖生成质量（不如 token-level 信号对 scale 敏感）。S1 跨尺度稳定在 0.97+ 因为 embedding similarity 是 training-data-independent 信号。Min-K++ 反转在 1.5B/3B 持续但减弱： 1.5B 的 -1.52 和 3B 的 -1.14 vs 0.5B 的 -1.98，因为更大模型的 perplexity 分布更稳定，d100 全量污染的 distribution shift 相对更小。 0.5B→1.5B 的跃变最大（effective signals 从 1 跳到 3），说明 1.5B 是 signal effectiveness 的关键转折点。\\n\"\n  },\n  {\n    \"name\": \"rl_observational_case_study\",\n    \"description\": \"在 Qwen2.5-Instruct (0.5B-7B) 和 DeepSeek-R1-Distill (1.5B/7B) 上应用 ContamCal。无 ground truth (observational)，重点是 directional external validity。\\n\",\n    \"results\": {\n      \"S1_auc_instruct_05B\": 0.91,\n      \"S1_auc_instruct_15B\": 0.93,\n      \"S1_auc_instruct_3B\": 0.94,\n      \"S1_auc_instruct_7B\": 0.95,\n      \"S2_auc_instruct_15B\": 0.62,\n      \"S2_auc_instruct_3B\": 0.71,\n      \"gamma_mmlu_instruct\": 0.15,\n      \"gamma_mmlu_instruct_ci\": [\n        0.02,\n        0.31\n      ],\n      \"gamma_gsm8k_instruct\": 0.42,\n      \"gamma_gsm8k_instruct_ci\": [\n        0.18,\n        0.68\n      ],\n      \"gamma_mmlu_deepseek\": 0.08,\n      \"gamma_mmlu_deepseek_ci\": [\n        -0.06,\n        0.24\n      ],\n      \"ci_width_instruct_avg_pp\": 6.8,\n      \"ci_width_deepseek_avg_pp\": 8.2,\n      \"regret_uncalibrated_rank_changes\": 3,\n      \"regret_calibrated_rank_changes\": 1,\n      \"gamma_known_clean_benchmark\": 0.02,\n      \"gamma_known_clean_ci_includes_zero\": true\n    },\n    \"tables\": [\n      {\n        \"name\": \"RL Observational: Calibrated vs Uncalibrated Ranking\",\n        \"headers\": [\n          \"Model\",\n          \"Uncalib MMLU\",\n          \"Calib MMLU\",\n          \"95% CI\",\n          \"Rank Change\"\n        ],\n        \"rows\": [\n          [\n            \"Qwen2.5-0.5B-Instruct\",\n            \"47.2%\",\n            \"46.8%\",\n            \"[43.1, 50.5]\",\n            0\n          ],\n          [\n            \"Qwen2.5-1.5B-Instruct\",\n            \"61.5%\",\n            \"60.2%\",\n            \"[56.8, 63.6]\",\n            0\n          ],\n          [\n            \"Qwen2.5-3B-Instruct\",\n            \"68.3%\",\n            \"67.1%\",\n            \"[63.5, 70.7]\",\n            0\n          ],\n          [\n            \"Qwen2.5-7B-Instruct\",\n            \"74.8%\",\n            \"73.2%\",\n            \"[70.1, 76.3]\",\n            -1\n          ],\n          [\n            \"DeepSeek-R1-1.5B\",\n            \"58.9%\",\n            \"58.4%\",\n            \"[53.8, 63.0]\",\n            1\n          ],\n          [\n            \"DeepSeek-R1-7B\",\n            \"75.2%\",\n            \"74.6%\",\n            \"[71.0, 78.2]\",\n            0\n          ]\n        ]\n      }\n    ],\n    \"figures\": [],\n    \"analysis\": \"Observational study 提供 directional external validity。关键发现： (1) Instruct 模型 CI 更宽反映信号质量退化——honest UQ 在 action； (2) GSM8K contamination 在 Instruct 后仍存在（γ=0.42），说明 RLHF 未完全消除 memorization；(3) specificity check pass 排除 false positive contamination detection；(4) ranking changes 较少 (1 out of 6) 说明 calibration 的 ranking impact 是 marginal 但 CI widths 差异很大——即使排名不变，uncertainty awareness 也有价值。\\n\\n\\nInstruct 模型的信号质量低于 controlled SFT 因为 RLHF/DPO post-training 扰动了 token-level 统计特征。S1 仍有效但 AUC 略降（0.91-0.95 vs controlled 的 0.95-0.99），S2 在 Instruct 上更难恢复（1.5B 仅 0.62， 低于 controlled 的 0.74）因为 RL 进一步模糊了 memorization 信号。 γ estimates 对 Instruct 模型较低（MMLU 0.15 vs controlled 0.22） 说明 Instruct fine-tuning 部分缓解了 contamination inflation（或者 instruction-following 改变了 response 策略）。GSM8K γ 仍较高（0.42） 因为 math reasoning 的 contamination 更难被 RL 消除。DeepSeek-R1 的 γ CI 包含 0（MMLU: [-0.06, 0.24]），consistent with 可能的低 contamination 或 reasoning-focused training 的 decontamination 效果。 CI width 更宽（6.8-8.2pp vs controlled 4.2pp）是 honest UQ 的体现。 Near-zero γ on clean benchmark (0.02, CI includes 0) 验证 specificity。\\n\"\n  },\n  {\n    \"name\": \"observational_72b\",\n    \"description\": \"Qwen2.5-72B inference-only observational分析。验证信号和 calibration 在 frontier 模型规模下是否成立。无 SFT，仅推理。\\n\",\n    \"results\": {\n      \"baseline_mmlu\": 0.854,\n      \"baseline_gsm8k\": 0.908,\n      \"baseline_arc\": 0.943,\n      \"S1_auc_72B\": 0.96,\n      \"S2_auc_72B\": 0.89,\n      \"S3_auc_72B\": 0.91,\n      \"S4_auc_72B\": 0.84,\n      \"gamma_mmlu_72B\": 0.12,\n      \"gamma_mmlu_72B_ci\": [\n        -0.02,\n        0.28\n      ],\n      \"gamma_gsm8k_72B\": 0.18,\n      \"gamma_gsm8k_72B_ci\": [\n        0.01,\n        0.37\n      ],\n      \"calibrated_mmlu\": 0.842,\n      \"calibrated_gsm8k\": 0.893,\n      \"ci_width_avg_pp\": 5.5\n    },\n    \"tables\": [\n      {\n        \"name\": \"72B Observational Results\",\n        \"headers\": [\n          \"Benchmark\",\n          \"Raw Score\",\n          \"Calibrated\",\n          \"95% CI\",\n          \"γ_k\"\n        ],\n        \"rows\": [\n          [\n            \"MMLU\",\n            \"85.4%\",\n            \"84.2%\",\n            \"[81.5, 86.9]\",\n            \"0.12 [-0.02, 0.28]\"\n          ],\n          [\n            \"GSM8K\",\n            \"90.8%\",\n            \"89.3%\",\n            \"[86.2, 92.4]\",\n            \"0.18 [0.01, 0.37]\"\n          ],\n          [\n            \"ARC-C\",\n            \"94.3%\",\n            \"93.8%\",\n            \"[91.4, 96.2]\",\n            \"0.09 [-0.04, 0.23]\"\n          ]\n        ]\n      }\n    ],\n    \"figures\": [],\n    \"analysis\": \"72B 结果展示 ContamCal 在 frontier scale 的适用性。calibration 调整 幅度小（1-1.5pp）但统计上 GSM8K 的 γ 显著不为零，说明即使 frontier 模型也存在可检测的 contamination signal。Signal quality 达到最高水平 (S2 AUC 0.89) 进一步支持 scale-dependent narrative。 Limitation: single model, γ estimates noisy.\\n\\n\\n72B 作为 single observational model（无 contamination variation）， γ 估计依赖于 exposure score variation across items（不同 items 有不同 exposure levels）。γ CI 较宽因为 single model 提供的 information 有限。MMLU γ CI 包含 0，consistent with 72B 在 MMLU 上可能 contamination 较低（或 frontier model 的 knowledge 已经足够高，contamination boost 可忽略）。GSM8K γ 显著大于 0 (CI: [0.01, 0.37])，提示即使在 72B，math reasoning benchmarks 仍存在 contamination concern。信号质量在 72B 是最高的（S2 0.89, S4 0.84），确认 scale-dependent trend 的外推。\\n\"\n  },\n  {\n    \"name\": \"closed_weight_2signal_mode\",\n    \"description\": \"仅 ConStat + Self-Critique (无 logits/embeddings) 的退化模式。 量化 2-signal vs 4-signal calibration gap。\\n\",\n    \"results\": {\n      \"rrf_2signal_auc_05B\": 0.508,\n      \"rrf_2signal_auc_15B\": 0.782,\n      \"rrf_2signal_auc_3B\": 0.831,\n      \"mae_2signal_05B_pp\": 6.8,\n      \"mae_2signal_15B_pp\": 2.8,\n      \"mae_2signal_3B_pp\": 2.1,\n      \"mae_2signal_avg_pp\": 3.9,\n      \"ci95_coverage_2signal\": 0.86,\n      \"mae_gap_4signal_vs_2signal_pp\": 2.1,\n      \"coverage_gap\": 0.08\n    },\n    \"tables\": [\n      {\n        \"name\": \"4-Signal vs 2-Signal (Closed-Weight) Comparison\",\n        \"headers\": [\n          \"Scale\",\n          \"4-Signal MAE\",\n          \"2-Signal MAE\",\n          \"Gap\",\n          \"2-Signal AUC\"\n        ],\n        \"rows\": [\n          [\n            \"0.5B\",\n            \"2.3pp\",\n            \"6.8pp\",\n            \"+4.5pp\",\n            0.508\n          ],\n          [\n            \"1.5B\",\n            \"1.4pp\",\n            \"2.8pp\",\n            \"+1.4pp\",\n            0.782\n          ],\n          [\n            \"3B\",\n            \"1.6pp\",\n            \"2.1pp\",\n            \"+0.5pp\",\n            0.831\n          ],\n          [\n            \"Average\",\n            \"1.8pp\",\n            \"3.9pp\",\n            \"+2.1pp\",\n            \"—\"\n          ]\n        ]\n      }\n    ],\n    \"figures\": [],\n    \"analysis\": \"Closed-weight mode 在 1.5B+ 仍提供有意义的 calibration (MAE 2.1-2.8pp)， 优于或持平 DCR。在 0.5B 时近似失效——论文应明确声明 \\\"closed-weight mode requires ≥1.5B models for reliable calibration.\\\" 这是 practical guidance for practitioners evaluating closed-source models。\\n\\n\\n0.5B 2-signal 近似失效 (AUC 0.508) 因为 S3/S4 在 0.5B 都不工作， MAE 6.8pp 接近 raw baseline。1.5B 2-signal MAE 2.8pp 可用但明显 劣于 4-signal 的 1.4pp——信息损失约 1.4pp。3B 2-signal MAE 2.1pp 已较接近 4-signal 的 1.6pp（gap 仅 0.5pp），因为 S3+S4 在 3B 已较强 (AUC 0.83+)。Coverage 86% 低于 4-signal 的 94% 因为 exposure 估计噪声更大但 ME model 补偿不足。整体 2-signal 平均 MAE 3.9pp 与 DCR baseline 的 3.9pp 持平——说明 even in degraded mode, ContamCal matches the best existing method, while providing CIs.\\n\"\n  },\n  {\n    \"name\": \"multi_family_validation\",\n    \"description\": \"在 Llama-3.2-1B 上重复 3-dosage (d000/d025/d100) controlled SFT injection。验证 cross-family generalization。\\n\",\n    \"results\": {\n      \"llama_d000_mmlu\": 0.492,\n      \"llama_d000_gsm8k\": 0.456,\n      \"llama_d000_arc\": 0.652,\n      \"llama_d025_mmlu\": 0.508,\n      \"llama_d025_gsm8k\": 0.478,\n      \"llama_d100_mmlu\": 0.521,\n      \"llama_d100_gsm8k\": 0.583,\n      \"llama_d100_arc\": 0.671,\n      \"S1_auc_llama_d005\": 0.962,\n      \"S2_auc_llama_d005\": 0.698,\n      \"S4_auc_llama_d005\": 0.671,\n      \"calibration_mae_pp_llama\": 2.1,\n      \"ci95_coverage_llama\": 0.92,\n      \"gamma_mmlu_llama\": 0.19,\n      \"gamma_gsm8k_llama\": 0.72,\n      \"gamma_consistency_with_qwen_pearson\": 0.91\n    },\n    \"tables\": [\n      {\n        \"name\": \"Cross-Family γ Comparison\",\n        \"headers\": [\n          \"Benchmark\",\n          \"Qwen2.5 γ\",\n          \"Llama-3.2 γ\",\n          \"Difference\"\n        ],\n        \"rows\": [\n          [\n            \"MMLU\",\n            0.22,\n            0.19,\n            \"-0.03\"\n          ],\n          [\n            \"GSM8K\",\n            0.85,\n            0.72,\n            \"-0.13\"\n          ],\n          [\n            \"ARC-C\",\n            0.18,\n            0.16,\n            \"-0.02\"\n          ]\n        ]\n      }\n    ],\n    \"figures\": [],\n    \"analysis\": \"Multi-family validation 确认核心发现的 generalizability。γ 跨家族 高度一致说明 benchmark-specific contamination susceptibility 是 benchmark 自身的属性（item structure, format, memorizability）， 而非模型家族特异的。Llama 的 S2 AUC (0.698) 刚好在 0.70 threshold 以下，验证了 1B scale 是 Min-K++ 的 borderline regime—— 与 simulation sweep 的 practical boundary 预测吻合。\\n\\nLlama-3.2-1B (~1B scale) 的信号质量介于 Qwen 0.5B 和 1.5B 之间 （S2 AUC 0.698 接近但未达 0.70 threshold），符合 scale-dependent pattern。contamination inflation 模式与 Qwen 一致：GSM8K 敏感 (d100 +12.7pp)，MMLU 中等 (d100 +2.9pp)。γ 估计与 Qwen 高度 相关（Pearson 0.91）——GSM8K 仍是最易受影响的 benchmark。 calibration MAE 2.1pp 略高于 Qwen 1.5B 的 1.4pp 因为 Llama 1B 的信号质量稍低。这为 reviewer concern #11 (single model family) 提供 rebuttal evidence，同时确认 identifiability boundaries 和 benchmark-specific γ patterns generalize across families。\\n\"\n  }\n]","numLines":1310,"startLine":1,"totalLines":1310}}}
