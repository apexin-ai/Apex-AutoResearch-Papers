{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016YGUczMoFMwEv6JeasNsUj","type":"tool_result","content":"1\t// 4PL + gamma contamination-augmented IRT model\n2\t// P(y_ij = 1) = c_j + (d_j - c_j) * inv_logit(a_j * (theta_i - b_j) + gamma * exposure_ij)\n3\t\n4\tdata {\n5\t  int<lower=1> N_models;\n6\t  int<lower=1> N_items;\n7\t  array[N_models, N_items] int<lower=0, upper=1> y;\n8\t  matrix[N_models, N_items] exposure;\n9\t}\n10\t\n11\tparameters {\n12\t  vector[N_models] theta;\n13\t  vector<lower=0>[N_items] a;\n14\t  vector[N_items] b;\n15\t  vector<lower=0, upper=1>[N_items] c;\n16\t  vector<lower=0, upper=1>[N_items] d;\n17\t  real gamma;\n18\t}\n19\t\n20\tmodel {\n21\t  // Priors\n22\t  theta ~ std_normal();\n23\t  a ~ lognormal(0, 0.5);\n24\t  b ~ std_normal();\n25\t  c ~ beta(5, 20);\n26\t  d ~ beta(20, 5);\n27\t  gamma ~ std_normal();\n28\t\n29\t  // Likelihood\n30\t  for (i in 1:N_models) {\n31\t    for (j in 1:N_items) {\n32\t      real eta = a[j] * (theta[i] - b[j]) + gamma * exposure[i, j];\n33\t      real p = c[j] + (d[j] - c[j]) * inv_logit(eta);\n34\t      y[i, j] ~ bernoulli(p);\n35\t    }\n36\t  }\n37\t}\n38\t\n39\tgenerated quantities {\n40\t  vector[N_models * N_items] log_lik;\n41\t  {\n42\t    int idx = 0;\n43\t    for (i in 1:N_models) {\n44\t      for (j in 1:N_items) {\n45\t        idx += 1;\n46\t        real eta = a[j] * (theta[i] - b[j]) + gamma * exposure[i, j];\n47\t        real p = c[j] + (d[j] - c[j]) * inv_logit(eta);\n48\t        log_lik[idx] = bernoulli_lpmf(y[i, j] | p);\n49\t      }\n50\t    }\n51\t  }\n52\t}\n53\t"}]},"parent_tool_use_id":"toolu_01StMkgFznUJ2jWkHjGWh7eb","session_id":"96df0b3b-89a3-4c1d-a37a-4bedcebb08c8","uuid":"a0279128-3c43-4845-afdf-6f2ac0cd610d","timestamp":"2026-05-13T18:12:17.427Z"}
