{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015YXrae9JW2TBen2cQJVmUy","type":"tool_result","content":"1\t// 2PL + gamma contamination-augmented IRT model (fallback)\n2\t// P(y_ij = 1) = inv_logit(a_j * (theta_i - b_j) + gamma * exposure_ij)\n3\t\n4\tdata {\n5\t  int<lower=1> N_models;\n6\t  int<lower=1> N_items;\n7\t  array[N_models, N_items] int<lower=0, upper=1> y;\n8\t  matrix[N_models, N_items] exposure;\n9\t}\n10\t\n11\tparameters {\n12\t  vector[N_models] theta;\n13\t  vector<lower=0>[N_items] a;\n14\t  vector[N_items] b;\n15\t  real gamma;\n16\t}\n17\t\n18\tmodel {\n19\t  // Priors\n20\t  theta ~ std_normal();\n21\t  a ~ lognormal(0, 0.5);\n22\t  b ~ std_normal();\n23\t  gamma ~ std_normal();\n24\t\n25\t  // Likelihood\n26\t  for (i in 1:N_models) {\n27\t    for (j in 1:N_items) {\n28\t      real eta = a[j] * (theta[i] - b[j]) + gamma * exposure[i, j];\n29\t      y[i, j] ~ bernoulli_logit(eta);\n30\t    }\n31\t  }\n32\t}\n33\t\n34\tgenerated quantities {\n35\t  vector[N_models * N_items] log_lik;\n36\t  {\n37\t    int idx = 0;\n38\t    for (i in 1:N_models) {\n39\t      for (j in 1:N_items) {\n40\t        idx += 1;\n41\t        real eta = a[j] * (theta[i] - b[j]) + gamma * exposure[i, j];\n42\t        log_lik[idx] = bernoulli_logit_lpmf(y[i, j] | eta);\n43\t      }\n44\t    }\n45\t  }\n46\t}\n47\t"}]},"parent_tool_use_id":"toolu_0147H16AmgeJ9qKA5FfTAu8A","session_id":"239c4b18-ea77-4d79-9faf-bb096f3c14d6","uuid":"2aaee2ff-f0b1-4777-af5d-d31d10feb999","timestamp":"2026-05-13T16:33:08.623Z"}
