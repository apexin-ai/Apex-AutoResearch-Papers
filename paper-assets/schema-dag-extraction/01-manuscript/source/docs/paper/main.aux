\@writefile{lot}{\contentsline {table}{\numberline {28}{\ignorespaces Top-10 confused relation pairs on FewRel 80-relation RE. $N$: bidirectional confusion count aggregated over 3 seeds $\times $ 25 batches. SCS: pairwise Schema Confusability Score (Qwen3 embedding cosine similarity). High-SCS pairs (e.g., \textit  {followed by}/\textit  {follows}, SCS\,=\,0.90) and family-relation pairs (\textit  {child}/\textit  {father}, \textit  {child}/\textit  {mother}) dominate. Some low-SCS pairs (\textit  {instance of}/\textit  {taxon rank}, SCS\,=\,0.53) reflect domain-specific co-occurrence rather than semantic similarity.}}{25}{table.caption.82}\protected@file@percent }
\newlabel{tab:top10_re}{{28}{25}{Top-10 confused relation pairs on FewRel 80-relation RE. $N$: bidirectional confusion count aggregated over 3 seeds $\times $ 25 batches. SCS: pairwise Schema Confusability Score (Qwen3 embedding cosine similarity). High-SCS pairs (e.g., \textit {followed by}/\textit {follows}, SCS\,=\,0.90) and family-relation pairs (\textit {child}/\textit {father}, \textit {child}/\textit {mother}) dominate. Some low-SCS pairs (\textit {instance of}/\textit {taxon rank}, SCS\,=\,0.53) reflect domain-specific co-occurrence rather than semantic similarity}{table.caption.82}{}}
