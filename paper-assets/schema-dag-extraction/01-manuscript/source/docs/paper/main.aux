\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Schema complexity in zero-shot relation extraction. Given the same input, a simple schema (few dissimilar types) yields the correct relation, while a complex schema with more candidate types and a cluster of semantically similar types causes type substitution (gold \emph  {place of birth} $\to $ predicted \emph  {residence}). We decompose schema complexity into two dimensions: type count and inter-type confusability.}}{1}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:problem}{{1}{1}{Schema complexity in zero-shot relation extraction. Given the same input, a simple schema (few dissimilar types) yields the correct relation, while a complex schema with more candidate types and a cluster of semantically similar types causes type substitution (gold \emph {place of birth} $\to $ predicted \emph {residence}). We decompose schema complexity into two dimensions: type count and inter-type confusability}{figure.caption.1}{}}
