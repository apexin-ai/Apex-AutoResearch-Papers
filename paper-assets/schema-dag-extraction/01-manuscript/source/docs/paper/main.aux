\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Cross-model count-curve replication on Few-NERD (text-match recall). Both models show a general declining trend in recall with schema size. Per-batch correlation $r = 0.725$. Qwen3-32B values use the v2 prompt (\S  \ref {sec:model}) for fair cross-model comparison; the count-curve results in \S  \ref {sec:count_curves} use the v1 prompt, yielding higher absolute recall (0.72 vs.\ 0.64 at count${}\,=\,1$) due to over-prediction under v1.}}{12}{table.caption.29}\protected@file@percent }
\newlabel{tab:cross_model}{{5}{12}{Cross-model count-curve replication on Few-NERD (text-match recall). Both models show a general declining trend in recall with schema size. Per-batch correlation $r = 0.725$. Qwen3-32B values use the v2 prompt (\S \ref {sec:model}) for fair cross-model comparison; the count-curve results in \S \ref {sec:count_curves} use the v1 prompt, yielding higher absolute recall (0.72 vs.\ 0.64 at count${}\,=\,1$) due to over-prediction under v1}{table.caption.29}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Cross-model BCS-controlled FewRel accuracy. High-BCS accuracy converges to $\approx $51\% regardless of model, while low-BCS accuracy reflects model capacity differences. The confusability gap ($\Delta $, in pp) is 77--87\% as large on Llama-3.1-8B as on Qwen3-32B.}}{12}{table.caption.30}\protected@file@percent }
\newlabel{tab:cross_model_bcs}{{6}{12}{Cross-model BCS-controlled FewRel accuracy. High-BCS accuracy converges to $\approx $51\% regardless of model, while low-BCS accuracy reflects model capacity differences. The confusability gap ($\Delta $, in pp) is 77--87\% as large on Llama-3.1-8B as on Qwen3-32B}{table.caption.30}{}}
