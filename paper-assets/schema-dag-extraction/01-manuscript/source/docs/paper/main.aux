\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Schema decomposition pipeline and failure modes. Graph coloring partitions the schema into low-confusability sub-schemas, but two structural bottlenecks prevent practical gains: \textbf  {routing failure} in RE (73.4\% of instances match multiple sub-schemas) and \textbf  {merge amplification} in NER/ED (union merge increases false positives ${\sim }4\times $).}}{8}{figure.caption.23}\protected@file@percent }
\newlabel{fig:sdgd_pipeline}{{7}{8}{Schema decomposition pipeline and failure modes. Graph coloring partitions the schema into low-confusability sub-schemas, but two structural bottlenecks prevent practical gains: \textbf {routing failure} in RE (73.4\% of instances match multiple sub-schemas) and \textbf {merge amplification} in NER/ED (union merge increases false positives ${\sim }4\times $)}{figure.caption.23}{}}
