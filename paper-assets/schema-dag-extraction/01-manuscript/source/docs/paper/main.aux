\@writefile{lot}{\contentsline {table}{\numberline {29}{\ignorespaces Top-10 confused entity type pairs on Few-NERD NER. $N$: bidirectional confusion count from 66-type full-schema extraction. SCS: pairwise Schema Confusability Score (Qwen3 embedding cosine similarity). Intra-category confusions (e.g., \textit  {person-other}/\textit  {person-politician}, SCS\,=\,0.93) and cross-category pairs sharing referent overlap (\textit  {building-other}/\textit  {location-GPE}, SCS\,=\,0.85) are most frequent. The ``other'' subtypes absorb diverse entities and confuse with more specific siblings.}}{25}{table.caption.83}\protected@file@percent }
\newlabel{tab:top10_ner}{{29}{25}{Top-10 confused entity type pairs on Few-NERD NER. $N$: bidirectional confusion count from 66-type full-schema extraction. SCS: pairwise Schema Confusability Score (Qwen3 embedding cosine similarity). Intra-category confusions (e.g., \textit {person-other}/\textit {person-politician}, SCS\,=\,0.93) and cross-category pairs sharing referent overlap (\textit {building-other}/\textit {location-GPE}, SCS\,=\,0.85) are most frequent. The ``other'' subtypes absorb diverse entities and confuse with more specific siblings}{table.caption.83}{}}
\@writefile{lot}{\contentsline {table}{\numberline {30}{\ignorespaces Illustrative confusion instances from FewRel 80-rel RE. All gold-predicted pairs have SCS\,$>$\,0.90: \textit  {participant} vs.\ \textit  {participant of} reverses directionality; \textit  {contains} vs.\ \textit  {located in} inverts containment; \textit  {part of} vs.\ \textit  {member of} conflates meronymy with membership. a.t.e.\ = admin.\ territorial entity.}}{25}{table.caption.84}\protected@file@percent }
\newlabel{tab:error_examples}{{30}{25}{Illustrative confusion instances from FewRel 80-rel RE. All gold-predicted pairs have SCS\,$>$\,0.90: \textit {participant} vs.\ \textit {participant of} reverses directionality; \textit {contains} vs.\ \textit {located in} inverts containment; \textit {part of} vs.\ \textit {member of} conflates meronymy with membership. a.t.e.\ = admin.\ territorial entity}{table.caption.84}{}}
