{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01S5wQeoU2RqwjJNTBRcE5DB","type":"tool_result","content":"1\texperiments:\n2\t  # === MVP (completed) ===\n3\t  - id: exp-001\n4\t    claim: [1, 2]\n5\t    description: \"Count curve baseline: recall/precision/F1 across type counts [1,2,6,12,22,44,66] on Few-NERD with Qwen3-32B-FP8\"\n6\t    priority: P0\n7\t    gpu_budget_hours: 3.5\n8\t    deps: []\n9\t    registry_id: exp001_count_baseline\n10\t    status_note: \"DONE. Recall 0.72->0.42 monotonic. WrongType 0->2434. Over-prediction at low counts.\"\n11\t\n12\t  - id: exp-002\n13\t    claim: [1, 2]\n14\t    description: \"Confusability controlled: within-count r(metric, BCS) at count=6/12, 25 random + extreme batches on Few-NERD\"\n15\t    priority: P0\n16\t    gpu_budget_hours: 3\n17\t    deps: [exp-001]\n18\t    registry_id: exp002_confusability_controlled\n19\t    status_note: \"DONE. Partial r=0.303 (p=0.026), count_12 r=0.501 (p=0.008). Confusion rate 10-28x.\"\n20\t\n21\t  - id: exp-003a\n22\t    claim: [1, 2]\n23\t    description: \"Prompt v2 rerun: clean data without offset fabrication, anti-hallucination instruction. Re-run exp1+exp2.\"\n24\t    priority: P0\n25\t    gpu_budget_hours: 3\n26\t    deps: [exp-001, exp-002]\n27\t    registry_id: exp003a_prompt_v2_rerun\n28\t    status_note: \"FAILED (EXIT_CODE=2 syntax error). Needs fix and re-run.\"\n29\t\n30\t  # === Research Phase: Contribution A (Replication + Generalization) ===\n31\t  - id: exp-004\n32\t    claim: [1, 2, 3]\n33\t    description: \"MAVEN confusability study: count curve + within-count BCS correlation on MAVEN Event Detection (168 event types, FrameNet hierarchy). Replicates core finding cross-task (NER→ED) with larger type space and known sibling confusion (14.6-19.8%).\"\n34\t    priority: P0\n35\t    gpu_budget_hours: 4\n36\t    deps: [exp-003a]\n37\t    registry_id: exp-004\n38\t    status_note: \"DONE (success). MAVEN count curve replicated. Also: exp004_maven_bcs (negative) — BCS within-count correlation weaker on MAVEN due to FrameNet hierarchy structure.\"\n39\t\n40\t  - id: exp-005\n41\t    claim: [1, 2]\n42\t    description: \"DocRED confusability study: count curve + BCS correlation on DocRED (96 relation types). Scaling stress test.\"\n43\t    priority: P1\n44\t    gpu_budget_hours: 5\n45\t    deps: [exp-003a]\n46\t\n47\t  - id: exp-006\n48\t    claim: [2]\n49\t    description: \"Interaction effect 2x2: {low count, high count} x {low BCS, high BCS} on Few-NERD. Tests additive vs multiplicative interaction between count and confusability.\"\n50\t    priority: P1\n51\t    gpu_budget_hours: 2\n52\t    deps: [exp-003a]\n53\t\n54\t  - id: exp-007\n55\t    claim: [2]\n56\t    description: \"Error taxonomy: systematic FP classification (type_substitution / boundary_error / false_negative / hallucination) across BCS bins. Mechanistic evidence for multi-channel model.\"\n57\t    priority: P1\n58\t    gpu_budget_hours: 1\n59\t    deps: [exp-002]\n60\t    status_note: \"Partially done via reeval_text_match.py FP three-way. Needs systematic BCS-binned analysis.\"\n61\t\n62\t  - id: exp-012\n63\t    claim: [1, 2]\n64\t    description: \"Multi-model validation: replicate exp-002 protocol with >=1 additional model (candidate: Qwen2.5-72B-Instruct or LLaMA-3.3-70B-Instruct). Addresses single-model generalizability.\"\n65\t    priority: P0\n66\t    gpu_budget_hours: 6\n67\t    deps: [exp-003a]\n68\t\n69\t  - id: exp-016\n70\t    claim: [1, 2]\n71\t    description: \"FewRel cross-task replication: count curve + BCS correlation on FewRel RE (80 relation types with --use_all). Replicates confusability effect NER→RE. Pilot (fewrel_pilot) confirmed signal; formal run with full count curve [1,4,8,16,32,64,80].\"\n72\t    priority: P0\n73\t    gpu_budget_hours: 4\n74\t    deps: [exp-003a]\n75\t    registry_id: exp_fewrel_formal\n76\t    status_note: \"RUNNING (16-rel version). Will rerun with --use_all for 80-rel full count curve after current run completes.\"\n77\t\n78\t  # === Research Phase: Contribution B (SDGD Framework) ===\n79\t  - id: exp-008\n80\t    claim: [3]\n81\t    description: \"SDGD-zero on Few-NERD: confusability-minimizing batch composition via embedding SCS + graph coloring. Compare vs single-pass full-schema baseline.\"\n82\t    priority: P0\n83\t    gpu_budget_hours: 3\n84\t    deps: [exp-003a]\n85\t    registry_id: exp008_sdgd_zero_fewnerd_r2\n86\t    status_note: \"DONE (negative). R2 attempt: SDGD-zero did not outperform single-pass baseline on Few-NERD. R1 (exp008_sdgd_zero_fewnerd) failed with script error.\"\n87\t\n88\t  - id: exp-009\n89\t    claim: [3]\n90\t    description: \"SDGD-zero on MAVEN: confusability-minimizing batch composition on 168 event types. Compare vs single-pass + random batching. Cross-task validation of SDGD framework (NER→ED).\"\n91\t    priority: P0\n92\t    gpu_budget_hours: 4\n93\t    deps: [exp-004, exp-008]\n94\t\n95\t  - id: exp-010\n96\t    claim: [3]\n97\t    description: \"SDGD-cal on Few-NERD: empirical confusability from 5-10 calibration examples (no gradients). Compare vs SDGD-zero.\"\n98\t    priority: P1\n99\t    gpu_budget_hours: 4\n100\t    deps: [exp-008]\n101\t\n102\t  - id: exp-011\n103\t    claim: [3]\n104\t    description: \"SDGD-cal on MAVEN: empirical confusability with calibration on 168 event types. Full comparison table.\"\n105\t    priority: P1\n106\t    gpu_budget_hours: 4\n107\t    deps: [exp-009, exp-010]\n108\t\n109\t  # === Ablations ===\n110\t  - id: exp-013\n111\t    claim: [3]\n112\t    description: \"Ablation: random batching -- same batch count k as SDGD, random composition. Isolates confusability-aware grouping from batch count reduction.\"\n113\t    priority: P0\n114\t    gpu_budget_hours: 3\n115\t    deps: [exp-008]\n116\t\n117\t  - id: exp-014\n118\t    claim: [3]\n119\t    description: \"Ablation: per-type splitting (UniNER-style, 1 type per batch). Upper bound on decomposition benefit. Reveals latency vs quality tradeoff.\"\n120\t    priority: P1"}]},"parent_tool_use_id":"toolu_01F4mKoAGQenSYMfBcSrr8sy","session_id":"08912b4a-ab76-4663-b333-b897e4b7593f","uuid":"e56b4e29-7c97-49c0-a9fa-f0f6a9736b74","timestamp":"2026-05-15T12:28:01.722Z"}
