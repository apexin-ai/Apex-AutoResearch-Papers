\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces Error taxonomy by BCS bin (Few-NERD, frequency-controlled). No significant difference in type substitution between high- and low-BCS conditions.}}{6}{table.8}\protected@file@percent }
\newlabel{tab:errors}{{8}{6}{Error taxonomy by BCS bin (Few-NERD, frequency-controlled). No significant difference in type substitution between high- and low-BCS conditions}{table.8}{}}
