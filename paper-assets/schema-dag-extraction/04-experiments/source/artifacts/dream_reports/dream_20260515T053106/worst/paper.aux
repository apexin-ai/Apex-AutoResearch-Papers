\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces SCS vs.\ empirical confusion. Despite weak statistical significance ($p$<0.05 due to large $n$), practical predictive value is near-random (AUC=0.56).}}{6}{table.9}\protected@file@percent }
\newlabel{tab:scs_validation}{{9}{6}{SCS vs.\ empirical confusion. Despite weak statistical significance ($p$<0.05 due to large $n$), practical predictive value is near-random (AUC=0.56)}{table.9}{}}
\@writefile{lot}{\contentsline {table}{\numberline {10}{\ignorespaces Top-10 empirically confused type pairs. Only 2/10 overlap with top-10 SCS pairs. Confusion is driven by ``-other'' label ambiguity, not embedding similarity.}}{6}{table.10}\protected@file@percent }
\newlabel{tab:mismatch}{{10}{6}{Top-10 empirically confused type pairs. Only 2/10 overlap with top-10 SCS pairs. Confusion is driven by ``-other'' label ambiguity, not embedding similarity}{table.10}{}}
