\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces MAVEN count curve (Qwen3-32B). Recall declines monotonically from 0.58 to 0.10. WrongType errors increase from 0 to 3100 as more types compete for assignment.}}{4}{table.2}\protected@file@percent }
