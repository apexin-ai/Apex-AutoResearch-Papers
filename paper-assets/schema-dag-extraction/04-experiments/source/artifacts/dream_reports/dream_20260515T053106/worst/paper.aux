\@writefile{toc}{\contentsline {section}{\numberline {5}Experiment 2: Testing Confusability Independence}{4}{section.5}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {5.1}Factorial Analysis on Few-NERD}{4}{subsection.5.1}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces 2$\times $2 factorial F1 results on Few-NERD (Qwen3-32B). BCS has negligible effect ($\Delta $=0.01) compared to count ($\Delta $=0.03).}}{4}{table.4}\protected@file@percent }
\newlabel{tab:factorial}{{4}{4}{2$\times $2 factorial F1 results on Few-NERD (Qwen3-32B). BCS has negligible effect ($\Delta $=0.01) compared to count ($\Delta $=0.03)}{table.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Two-way ANOVA. BCS main effect is not significant after controlling for count. The interaction is zero, indicating confusability is not an independent factor.}}{5}{table.5}\protected@file@percent }
\newlabel{tab:anova}{{5}{5}{Two-way ANOVA. BCS main effect is not significant after controlling for count. The interaction is zero, indicating confusability is not an independent factor}{table.5}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.2}Within-Count BCS Correlation on MAVEN}{5}{subsection.5.2}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces MAVEN within-count BCS--F1 correlation. No evidence for confusability independence on event detection.}}{5}{table.6}\protected@file@percent }
\newlabel{tab:maven_bcs}{{6}{5}{MAVEN within-count BCS--F1 correlation. No evidence for confusability independence on event detection}{table.6}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.3}Pairwise BCS--Confusion Analysis}{5}{subsection.5.3}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces Pairwise BCS--confusion correlations. The Few-NERD/Qwen3 result ($r$=0.156) does not replicate across models or tasks. $\rho _{\text  {nz}}$: Spearman $\rho $ on nonzero confusion pairs.}}{5}{table.7}\protected@file@percent }
\newlabel{tab:pairwise}{{7}{5}{Pairwise BCS--confusion correlations. The Few-NERD/Qwen3 result ($r$=0.156) does not replicate across models or tasks. $\rho _{\text {nz}}$: Spearman $\rho $ on nonzero confusion pairs}{table.7}{}}
