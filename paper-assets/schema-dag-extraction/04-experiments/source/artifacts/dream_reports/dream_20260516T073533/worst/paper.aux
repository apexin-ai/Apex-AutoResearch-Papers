\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces DocRED count curve. Accuracy degrades from 0.82 (single type) to 0.31 (full schema), but count and BCS are confounded at the batch level.}}{3}{table.1}\protected@file@percent }
