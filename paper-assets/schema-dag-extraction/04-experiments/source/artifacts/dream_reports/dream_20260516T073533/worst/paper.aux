\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces BCS-controlled comparison at count=16 on DocRED. Effect direction is consistent ($\Delta $=$-$8.3pp) but CI crosses zero [$-$16.1, +0.5]pp due to $n$=5.}}{3}{table.2}\protected@file@percent }
\newlabel{tab:docred_bcs}{{2}{3}{BCS-controlled comparison at count=16 on DocRED. Effect direction is consistent ($\Delta $=$-$8.3pp) but CI crosses zero [$-$16.1, +0.5]pp due to $n$=5}{table.2}{}}
