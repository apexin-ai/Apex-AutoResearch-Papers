93\n847\t      correlation:\n848\t        intra_sub_vs_bcs_spearman_rho: 1\n849\t        intra_sub_vs_bcs_p: <0.001\n850\t        chi_square: 6952\n851\t        chi_square_p: ~0\n852\t      exp2_controlled:\n853\t        trend: IntraSub 3.2% -> 7.3% -> 8.6% (rho=1.0, p<0.001)\n854\t      key_finding: 'BCS>=0.95: 49.4% FP are intra-batch type confusion (13/100 gold).\n855\t        Hallucination+boundary <3%. LLM main error mode is type confusion, not hallucination.'\n856\t  exp012_llama_fewnerd_r2:\n857\t    status: RUNNING\n858\t    retry_count: 0\n859\t    created_at: '2026-05-15T14:20:57.669Z'\n860\t    updated_at: '2026-05-15T14:21:34.279Z'\n861\t    spec:\n862\t      command: bash /root/schema-dag-extraction/scripts/run_exp012_llama.sh\n863\t      server: cqa1-38874\n864\t      gpu:\n865\t      - cuda:0\n866\t      pid: '275856'\n867\t      log_path: ~/runs/schema-dag-extraction/exp012_llama_fewnerd_r2.log\n868\t      submitted_at: '2026-05-15T14:20:57.610Z'\n869\t      submitted_via: submit_training_job\n870\t      backend: tmux\n871\t      account: root\n872\t      hypothesis: 'Multi-model validation: LLaMA-3.3-70B-FP8 replicates confusability\n873\t        effect on Few-NERD (r2: fixed VLLM_ATTENTION_BACKEND)'\n874\t      dataset: Few-NERD\n875\t      model: LLaMA-3.3-70B-Instruct-FP8\n876\t      data_path: /root/schema-dag-extraction/data/parquet/test.parquet\n877\t      data_count: 1000\n878\t      model_name: LLaMA-3.3-70B-Instruct-FP8\n879\t      seed: 42\n880\t      plan_id: exp-012\n881\t"}]},"parent_tool_use_id":"toolu_01QXRrq61ytHCNXeWfzB2Uc5","session_id":"08464124-1424-4e01-848b-117232553f88","uuid":"400ccc50-c5e6-4556-9b2c-f92060196616","timestamp":"2026-05-15T14:39:00.399Z"}
