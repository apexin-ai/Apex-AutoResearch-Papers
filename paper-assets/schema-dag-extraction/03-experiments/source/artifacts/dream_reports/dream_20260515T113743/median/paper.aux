\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces MAVEN confusability analysis ($2{\times }2$ embedding matrix). Pairwise MiniLM confirms the confusability signal cross-task. Per-type correlations are \emph  {positive} for both embeddings---a centrality confound (see \S  \ref {sec:centrality}). $^{*}p{<}0.05$.}}{4}{table.caption.20}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{tab:maven-pairwise}{{1}{4}{MAVEN confusability analysis ($2{\times }2$ embedding matrix). Pairwise MiniLM confirms the confusability signal cross-task. Per-type correlations are \emph {positive} for both embeddings---a centrality confound (see \S \ref {sec:centrality}). $^{*}p{<}0.05$}{table.caption.20}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces MAVEN count curve (Relaxed F1). Performance increases up to 44 types then plateaus, unlike the monotonic decline seen in Few-NERD's cross-domain schema.}}{4}{table.caption.21}\protected@file@percent }
