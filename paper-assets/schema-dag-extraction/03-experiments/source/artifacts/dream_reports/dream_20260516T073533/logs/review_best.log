8: delta=-31.2pp, count_16: delta=-31.2pp'\\\\n  - exp_id: exp_fewrel_40rel_r4\\\\n    metric: '40-rel count_8: delta=-33.3pp, count_16: delta=-31.8pp'\\\\n  - exp_id: exp012_llama_fewrel_ch2\\\\n    metric: 'LLaMA cross-model: count_8 delta=-27.1pp, count_16 delta=-24.0pp'\\\\n  - exp_id: bootstrap_ci_analysis\\\\n    metric: 'CIs: count_8 [17.7, 42.7], count_16 [22.9, 39.6]'\\\\n  id: T003\\\\n  deprecated: false\\\\n- caption: Intra-batch substitution (IntraSub) rate by BCS bin.\\\\n  label: tab:error_taxonomy\\\\n  location:\\\\n    section: results\\\\n  cells:\\\\n  - exp_id: exp007_error_taxonomy\\\\n    metric: NER IntraSub 0%->49.4%, rho=1.0; NER Missed 42.8/64.8/49.9% (non-monotonic)\\\\n  - exp_id: exp016_fewrel_error_taxonomy\\\\n    metric: RE IntraSub 0%->32.3%, rho=0.954; RE Missed 10.4/11.3/13.1/15.7% (flat)\\\\n  id: T004\\\\n  deprecated: false\\\\n- caption: Few-NERD extraction under decomposition modes.\\\\n  label: tab:sdgd_results\\\\n  location:\\\\n    section: sdgd_negative\\\\n  cells:\\\\n  - exp_id: exp008_sdgd_zero_fewnerd_r2\\\\n    metric: 'v1: single_pass F1=0.445, sdgd_zero F1=0.251, random F1=0.320, per_type\\\\n      F1=0.292'\\\\n  - exp_id: exp008_sdgd_v2_fewnerd\\\\n    metric: 'v2: sdgd_zero F1=0.241, random F1=0.301'\\\\n  id: T005\\\\n  deprecated: false\\\\n- caption: Three-way BCS--accuracy analysis on FewRel (regression slope, quartile\\\\n    delta, permutation test).\\\\n  label: tab:within_pool\\\\n  location:\\\\n    section: results\\\\n  cells:\\\\n  - exp_id: three_way_comparison\\\\n    metric: 'Independent 16-rel: slope=-0.449, CI [-0.552, -0.346], r=-0.637'\\\\n    source: artifacts/three_way_comparison/results_unified.json\\\\n  - exp_id: three_way_comparison\\\\n    metric: '80-pool→16-sub: slope=-0.401, CI [-0.701, -0.069], r=-0.221, p=0.027'\\\\n    source: artifacts/three_way_comparison/results_unified.json\\\\n  - exp_id: three_way_comparison\\\\n    metric: 'Full 80-rel: slope=-0.151, CI [-0.930, +0.657], underpowered'\\\\n    source: artifacts/three_way_comparison/results_unified.json\\\\n  - exp_id: three_way_comparison\\\\n    metric: 'Permutation test (16-rel vs 80-pool slopes): p=0.436'\\\\n    source: artifacts/three_way_comparison/results_unified.json\\\\n  id: T006\\\\n  deprecated: false\\\\nfigures:\\\\n- caption: Count scaling curves for NER (Few-NERD) and RE (FewRel)\\\\n  label: fig:count_curves\\\\n  location:\\\\n    section: results\\\\n  cells:\\\\n  - exp_id: exp001_count_baseline\\\\n    metric: 'Panel (a): recall 0.72->0.418'\\\\n  - exp_id: exp_fewrel_formal_80rel\\\\n    metric: 'Panel (b): accuracy 0.857->0.504'\\\\n  - exp_id: exp_fewrel_40rel_r4\\\\n    metric: 'Panel (b): count_40=0.588'\\\\n  id: F001\\\\n  deprecated: false\\\\n- caption: BCS effect scaling with pool size\\\\n  label: fig:bcs_scaling\\\\n  location:\\\\n    section: results\\\\n  cells:\\\\n  - exp_id: exp_fewrel_formal\\\\n    metric: 16-rel delta=9.1pp\\\\n  - exp_id: exp_fewrel_40rel_r4\\\\n    metric: 40-rel delta=33.3pp (80-pool subset)\\\\n  - exp_id: exp_fewrel_formal_80rel\\\\n    metric: 80-rel delta=31.2pp\\\\n  - exp_id: exp012_llama_fewrel_ch2\\\\n    metric: LLaMA 80-rel delta=27.1pp\\\\n  id: F002\\\\n  deprecated: false\\\\n- caption: Error taxonomy by BCS bin\\\\n  label: fig:error_taxonomy\\\\n  location:\\\\n    section: results\\\\n  cells:\\\\n  - exp_id: exp007_error_taxonomy\\\\n    metric: 'NER: IntraSub 0%->49.4%'\\\\n  - exp_id: exp016_fewrel_error_taxonomy\\\\n    metric: 'RE: IntraSub 0%->32.3%'\\\\n  id: F003\\\\n  deprecated: false\\\\n_completeness:\\\\n  coverage: 32/42\\\\n  claims: 39\\\\n  tables: 6\\\\n  figures: 3\\\\n  tier_counts:\\\\n    tier1: 0\\\\n    tier2: 32\\\\n    tier3: 10\\\\n    tierX: 0\\\\n  last_checked: '2026-05-16T04:06:55.250751+00:00'\\\\n\\\", \\\"total_chars\\\": 22197, \\\"truncated\\\": false}, \\\"error\\\": null, \\\"metadata\\\": {}}\"}"}]},"parent_tool_use_id":"toolu_01N6BRmGrcwiu7gm7j98SRfJ","session_id":"08