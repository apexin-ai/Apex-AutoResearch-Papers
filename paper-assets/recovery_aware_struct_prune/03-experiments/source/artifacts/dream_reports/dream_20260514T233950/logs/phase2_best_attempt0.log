{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LcSww5DUqdn8bR1yXf7VnH","type":"tool_result","content":"1\t# Experiment Plan — recovery_aware_struct_prune\n2\t# Created: 2026-05-14\n3\t# Target: EMNLP 2026 ARR May 25 (11 days)\n4\t# Resources: 2× RTX PRO 6000 94G (westb-23072, cuda:0 + cuda:1)\n5\t# Total GPU budget: ~528 GPU-hours available, ~200h planned\n6\t\n7\texperiments:\n8\t  # === P0: Core Evidence (must complete for submission) ===\n9\t\n10\t  - id: plan_001\n11\t    claim: 1\n12\t    description: \"Full GSM8K eval (1319 samples) for baseline + RASP_20 + Standard_20. Currently only N=100 — need full test set for tight CIs (±2.4pp vs ±9pp).\"\n13\t    priority: P0\n14\t    gpu_budget_hours: 5\n15\t    deps: []\n16\t    registry_id: null  # new experiment needed\n17\t    status_note: \"baseline eval was running on GPU0, may be done\"\n18\t\n19\t  - id: plan_002\n20\t    claim: 1\n21\t    description: \"SFT warmup recovery for RASP_20 and Standard_20. Teacher-forcing on GSM8K train gold solutions to restore basic generation ability (fix no-EOS problem). Both models in parallel on 2 GPUs.\"\n22\t    priority: P0\n23\t    gpu_budget_hours: 10\n24\t    deps: []\n25\t    registry_id: null  # D013 initiated this, Agent is setting up\n26\t    status_note: \"D013 in progress — Agent executing SFT setup\"\n27\t\n28\t  - id: plan_003\n29\t    claim: 1\n30\t    description: \"GRPO recovery on SFT-warmed models. RASP_20 and Standard_20 in parallel. This is the core MVP-completion experiment — demonstrate RASP enables RLVR recovery while Standard cannot recover.\"\n31\t    priority: P0\n32\t    gpu_budget_hours: 35\n33\t    deps: [plan_002]\n34\t    registry_id: null\n35\t    status_note: \"blocked on SFT completion\"\n36\t\n37\t  - id: plan_004\n38\t    claim: 1\n39\t    description: \"Full GSM8K eval (1319 samples) for all recovered models. Final numbers for paper Table 1.\"\n40\t    priority: P0\n41\t    gpu_budget_hours: 8\n42\t    deps: [plan_003]\n43\t    registry_id: null\n44\t\n45\t  - id: plan_005\n46\t    claim: 1\n47\t    description: \"GRASPrune baseline at 20% sparsity. Clone repo, run gate training, eval post-prune, then SFT→GRPO recovery. Primary external baseline (ACL 2026 SOTA).\"\n48\t    priority: P0\n49\t    gpu_budget_hours: 30\n50\t    deps: []\n51\t    registry_id: null\n52\t    status_note: \"GRASPrune research memo in memory.md, Qwen-compatible\"\n53\t\n54\t  - id: plan_006\n55\t    claim: 1\n56\t    description: \"Multi-seed RASP_20 post-prune eval (seeds 123, 7). Verify 29% result is not seed-dependent. Only need prune+eval (~2h each), not full recovery.\"\n57\t    priority: P0\n58\t    gpu_budget_hours: 5\n59\t    deps: []\n60\t    registry_id: null\n61\t\n62\t  # === P1: Strengthening Claims (important for paper quality) ===\n63\t\n64\t  - id: plan_007\n65\t    claim: 2\n66\t    description: \"Scoring ablation at 20% sparsity: magnitude-only, gradient-only, random pruning. Same pipeline as RASP/Standard but different scoring. Compare post-prune accuracy to isolate CKA's contribution.\"\n67\t    priority: P1\n68\t    gpu_budget_hours: 8\n69\t    deps: []\n70\t    registry_id: null\n71\t\n72\t  - id: plan_008\n73\t    claim: 2\n74\t    description: \"Per-structure CKA-recoverability correlation analysis. Extract per-head F(h) from RASP scoring, correlate with per-head activation change after recovery. Mixed-effects regression with layer as random effect, controlling for weight norm / gradient importance / activation magnitude.\"\n75\t    priority: P1\n76\t    gpu_budget_hours: 6\n77\t    deps: [plan_003]\n78\t    registry_id: null\n79\t    status_note: \"analysis code + GPU compute for activation extraction\"\n80\t\n81\t  - id: plan_009\n82\t    claim: 3\n83\t    description: \"SFT-only recovery comparison. Same pruned models (RASP_20, Standard_20), same data budget, but SFT only (no GRPO). Tests whether recovery method changes optimal pruning order.\"\n84\t    priority: P1\n85\t    gpu_budget_hours: 10\n86\t    deps: [plan_001]\n87\t    registry_id: null\n88\t\n89\t  - id: plan_010\n90\t    claim: 1\n91\t    description: \"25% sparsity RASP + Standard. Prune, eval, SFT→GRPO recovery. Tests robustness across sparsity levels and approaches the 'threshold' where RASP advantage might narrow or widen.\"\n92\t    priority: P1\n93\t    gpu_budget_hours: 40\n94\t    deps: []\n95\t    registry_id: null\n96\t\n97\t  # === P2: Polish & Extension (if time allows) ===\n98\t\n99\t  - id: plan_011\n100\t    claim: 1\n101\t    description: \"30% sparsity probe. Prune + eval only (no recovery) for RASP and Standard. Maps the sparsity threshold where both methods collapse (expected based on D005 35% result).\"\n102\t    priority: P2\n103\t    gpu_budget_hours: 4\n104\t    deps: []\n105\t    registry_id: null\n106\t\n107\t  - id: plan_012\n108\t    claim: 1\n109\t    description: \"Extended evaluation on best recovered config: MMLU, HumanEval, MATH-500. Shows RASP recovery generalizes beyond GSM8K.\"\n110\t    priority: P2\n111\t    gpu_budget_hours: 10\n112\t    deps: [plan_003]\n113\t    registry_id: null\n114\t\n115\t  - id: plan_013\n116\t    claim: 1\n117\t    description: \"Bonsai baseline at 20% sparsity. Gradient-free structured pruning (ICML 2025). Lower priority than GRASPrune since GRASPrune is more directly comparable.\"\n118\t    priority: P2\n119\t    gpu_budget_hours: 25\n120\t    deps: []\n121\t    registry_id: null\n122\t\n123\t  - id: plan_014\n124\t    claim: 2\n125\t    description: \"CKA reliability analysis: split-half consistency (Spearman ρ > 0.9) and calibration size sensitivity (256/512/1024 samples). Shows CKA-based scoring is stable.\"\n126\t    priority: P2\n127\t    gpu_budget_hours: 4\n128\t    deps: []\n129\t    registry_id: null\n130\t\n131\t# GPU Budget Summary:\n132\t#   P0 total: ~93h (fits in ~3 days with 2 GPUs)\n133\t#   P1 total: ~64h (fits in ~2 days with 2 GPUs)\n134\t#   P2 total: ~43h (fits in ~1.5 days with 2 GPUs)\n135\t#   Grand total: ~200h out of 528h available\n136\t#   Buffer: ~328h for reruns, unexpected issues, paper writing compute\n137\t\n138\t# Critical Path:\n139\t#   plan_002 (SFT, ~5h) → plan_003 (GRPO, ~17h) → plan_004 (eval, ~4h) → plan_008 (analysis)\n140\t#   Wall-clock: ~26h for core recovery evidence\n141\t#   GRASPrune (plan_005) runs in parallel on second GPU\n142\t"}]},"parent_tool_use_id":"toolu_01Grq38H1uuBXWm7ctAsRR2q","session_id":"50085846-2f4c-49ad-8f2d-ef8b9b74cc58","uuid":"ee6bb139-0f7f-42e6-a22c-d9ecc423a2b5","timestamp":"2026-05-14T23:44:59.790Z"}
