\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces CKA scoring reliability across calibration sizes ($n=896$ structures). Split-half consistency $\rho =0.93$ ($p < 10^{-45}$) confirms stable scoring at 512 samples. Accuracy impact of calibration size is $<$2pp.}}{8}{table.9}\protected@file@percent }
\newlabel{tab:cka_reliability}{{9}{8}{CKA scoring reliability across calibration sizes ($n=896$ structures). Split-half consistency $\rho =0.93$ ($p < 10^{-45}$) confirms stable scoring at 512 samples. Accuracy impact of calibration size is $<$2pp}{table.9}{}}
\@writefile{lot}{\contentsline {table}{\numberline {10}{\ignorespaces Mixed-effects regression: CKA-based $F(h)$ vs.\ post-recovery activation change. CKA captures a real signal ($r=0.38$, $p=0.003$) but prediction power is layer-dominated (ICC=0.71). Within-layer, CKA explains only 8\% of variance.}}{8}{table.10}\protected@file@percent }
\newlabel{tab:cka_corr}{{10}{8}{Mixed-effects regression: CKA-based $F(h)$ vs.\ post-recovery activation change. CKA captures a real signal ($r=0.38$, $p=0.003$) but prediction power is layer-dominated (ICC=0.71). Within-layer, CKA explains only 8\% of variance}{table.10}{}}
