\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Post-prune accuracy (\%) on GSM8K ($N=1319$). RASP vs.\ Standard gap at 20\%: 3.7pp ($p=0.034$). Multi-seed results (5 seeds): paired $t$-test $p=0.024$, Cohen's $d=0.58$. Unstructured pruning preserves 68.2\% accuracy---38pp above the best structured method---confirming that structural removal causes far greater damage than weight zeroing.}}{4}{table.1}\protected@file@percent }
\newlabel{tab:postprune}{{1}{4}{Post-prune accuracy (\%) on GSM8K ($N=1319$). RASP vs.\ Standard gap at 20\%: 3.7pp ($p=0.034$). Multi-seed results (5 seeds): paired $t$-test $p=0.024$, Cohen's $d=0.58$. Unstructured pruning preserves 68.2\% accuracy---38pp above the best structured method---confirming that structural removal causes far greater damage than weight zeroing}{table.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Recovery accuracy (\%) on GSM8K ($N=1319$). GRPO \emph  {never} improves over SFT---in every configuration, post-GRPO accuracy is equal to or below post-SFT accuracy. The SFT gap between RASP and Standard is 2.2pp at 20\% ($p=0.25$) and 3.2pp at 25\% ($p=0.089$).}}{4}{table.2}\protected@file@percent }
\newlabel{tab:recovery}{{2}{4}{Recovery accuracy (\%) on GSM8K ($N=1319$). GRPO \emph {never} improves over SFT---in every configuration, post-GRPO accuracy is equal to or below post-SFT accuracy. The SFT gap between RASP and Standard is 2.2pp at 20\% ($p=0.25$) and 3.2pp at 25\% ($p=0.089$)}{table.2}{}}
\@writefile{toc}{\contentsline {paragraph}{Sparsity levels.}{4}{section*.13}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {5}Results}{4}{section.5}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {5.1}Post-Prune Accuracy (Table~\ref {tab:postprune})}{4}{subsection.5.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {5.2}Recovery Accuracy Matrix (Table~\ref {tab:recovery})}{4}{subsection.5.2}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces GRPO collapse dynamics. Collapse step = first step meeting all three collapse criteria. The severity gradient (RASP $<$ GRASPrune $<$ Bonsai $<$ Standard) directly maps to how aggressively each method removes functionally redundant structures. Unstructured pruning produces no collapse. $^*$Standard at 20\% shows transient dip at step $\sim $60 with partial recovery.}}{5}{table.3}\protected@file@percent }
\newlabel{tab:collapse}{{3}{5}{GRPO collapse dynamics. Collapse step = first step meeting all three collapse criteria. The severity gradient (RASP $<$ GRASPrune $<$ Bonsai $<$ Standard) directly maps to how aggressively each method removes functionally redundant structures. Unstructured pruning produces no collapse. $^*$Standard at 20\% shows transient dip at step $\sim $60 with partial recovery}{table.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Alpha sensitivity ablation at 20\% sparsity ($N=1319$). $\alpha =0$ reduces to standard importance pruning. The U-shaped curve with minimum at $\alpha =0.5$ and optimum at $\alpha =2.0$ indicates that aggressive redundancy preservation (high $\alpha $) benefits both post-prune and post-SFT accuracy. The paradox: higher $\alpha $ preserves more unique structures for better accuracy but removes more redundancy---accelerating GRPO collapse.}}{5}{table.4}\protected@file@percent }
\newlabel{tab:alpha}{{4}{5}{Alpha sensitivity ablation at 20\% sparsity ($N=1319$). $\alpha =0$ reduces to standard importance pruning. The U-shaped curve with minimum at $\alpha =0.5$ and optimum at $\alpha =2.0$ indicates that aggressive redundancy preservation (high $\alpha $) benefits both post-prune and post-SFT accuracy. The paradox: higher $\alpha $ preserves more unique structures for better accuracy but removes more redundancy---accelerating GRPO collapse}{table.4}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.3}GRPO Collapse Dynamics (Table~\ref {tab:collapse})}{5}{subsection.5.3}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {5.4}Alpha Sensitivity Ablation (Table~\ref {tab:alpha})}{5}{subsection.5.4}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Cross-model collapse step comparison (RASP vs.\ Standard). On DeepSeek-R1-Distill-Qwen-7B, the collapse severity gradient is clean (6$\times $ ratio at 20\%). On Qwen2.5-Math-7B, the direction is consistent (RASP collapses first) but the ratio is smaller and 95\% CI includes 1---the gradient is a diagnostic tendency rather than a universal law.}}{6}{table.5}\protected@file@percent }
\newlabel{tab:crossmodel}{{5}{6}{Cross-model collapse step comparison (RASP vs.\ Standard). On DeepSeek-R1-Distill-Qwen-7B, the collapse severity gradient is clean (6$\times $ ratio at 20\%). On Qwen2.5-Math-7B, the direction is consistent (RASP collapses first) but the ratio is smaller and 95\% CI includes 1---the gradient is a diagnostic tendency rather than a universal law}{table.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Scoring ablation at 20\% sparsity. CKA's marginal contribution over gradient-only is 3pp. The ordering confirms that gradient-based importance is the dominant signal, with CKA providing complementary but non-dominant functional redundancy information.}}{6}{table.6}\protected@file@percent }
\newlabel{tab:scoring}{{6}{6}{Scoring ablation at 20\% sparsity. CKA's marginal contribution over gradient-only is 3pp. The ordering confirms that gradient-based importance is the dominant signal, with CKA providing complementary but non-dominant functional redundancy information}{table.6}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.5}Cross-Model Validation (Table~\ref {tab:crossmodel})}{6}{subsection.5.5}\protected@file@percent }
