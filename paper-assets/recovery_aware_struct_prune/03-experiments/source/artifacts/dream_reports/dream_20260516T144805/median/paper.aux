\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces Inference speedup on A100-80GB (batch=1, seq\_len=512, 50 runs after 10 warmup). Actual speedup ($\sim $15\%) is below the theoretical 19\% due to non-pruned computation (attention, LayerNorm, embedding) and framework overhead.}}{7}{table.7}\protected@file@percent }
\newlabel{tab:speedup}{{7}{7}{Inference speedup on A100-80GB (batch=1, seq\_len=512, 50 runs after 10 warmup). Actual speedup ($\sim $15\%) is below the theoretical 19\% due to non-pruned computation (attention, LayerNorm, embedding) and framework overhead}{table.7}{}}
\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces Extended evaluation across benchmarks. Recovery ratio = (pruned SFT) / (unpruned SFT). SFT recovery is domain-specific: GSM8K in-domain recovery (75.7\%) far exceeds harder math (60.7\%) and code (64.5\%). MMLU factual knowledge (80.3\%) is least affected by MLP pruning.}}{7}{table.8}\protected@file@percent }
\newlabel{tab:extended}{{8}{7}{Extended evaluation across benchmarks. Recovery ratio = (pruned SFT) / (unpruned SFT). SFT recovery is domain-specific: GSM8K in-domain recovery (75.7\%) far exceeds harder math (60.7\%) and code (64.5\%). MMLU factual knowledge (80.3\%) is least affected by MLP pruning}{table.8}{}}
