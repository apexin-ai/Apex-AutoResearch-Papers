\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Training dynamics diagnostics. (a)~$f_0$ (fraction of zero-variance batches): CKA-only stays below 0.35; Standard and \textsc  {Rasp}{} remain in the collapse zone ($f_0 > 0.5$) throughout training. (b)~Gradient norm: Standard exhibits a transient minimum of 0.017 at step 90 before recovering to 2.41 at step 100; \textsc  {Rasp}{} gradient norms remain predominantly near zero.}}{7}{figure.caption.23}\protected@file@percent }
\newlabel{fig:collapse_dynamics}{{3}{7}{Training dynamics diagnostics. (a)~$f_0$ (fraction of zero-variance batches): CKA-only stays below 0.35; Standard and \rasp {} remain in the collapse zone ($f_0 > 0.5$) throughout training. (b)~Gradient norm: Standard exhibits a transient minimum of 0.017 at step 90 before recovering to 2.41 at step 100; \rasp {} gradient norms remain predominantly near zero}{figure.caption.23}{}}
