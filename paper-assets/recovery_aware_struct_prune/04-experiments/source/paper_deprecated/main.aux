\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Recovery capacity gradient: GRPO dynamics for four pruning criteria at 20\% sparsity under identical configuration (lr $1{\times }10^{-6}$, $\beta {=}0.01$, $T{=}0.4$, 100 steps). Peak reward = best across 100 training steps. $f_0$: fraction of training batches where all sampled completions receive identical reward (lower = healthier exploration). Best in \textbf  {bold}, second-best \underline  {underlined}.}}{6}{table.caption.21}\protected@file@percent }
\newlabel{tab:recovery_gradient}{{1}{6}{Recovery capacity gradient: GRPO dynamics for four pruning criteria at 20\% sparsity under identical configuration (lr $1{\times }10^{-6}$, $\beta {=}0.01$, $T{=}0.4$, 100 steps). Peak reward = best across 100 training steps. $f_0$: fraction of training batches where all sampled completions receive identical reward (lower = healthier exploration). Best in \textbf {bold}, second-best \underline {underlined}}{table.caption.21}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces GRPO reward trajectories for four pruning criteria and the unpruned model under identical training configuration ($\beta {=}0.01$, $T{=}0.4$, 100 steps). CKA-only reaches 0.354 peak reward with an observed recovery event at step 90. Random oscillates between 0.14 and 0.19 (training timed out at step 97; 9 steps shown). Standard peaks at 0.081 before borderline collapse. \textsc  {Rasp}{} peaks at 0.061 (step 50) and declines to 0.010 by step 100.}}{6}{figure.caption.22}\protected@file@percent }
\newlabel{fig:reward_trajectories}{{2}{6}{GRPO reward trajectories for four pruning criteria and the unpruned model under identical training configuration ($\beta {=}0.01$, $T{=}0.4$, 100 steps). CKA-only reaches 0.354 peak reward with an observed recovery event at step 90. Random oscillates between 0.14 and 0.19 (training timed out at step 97; 9 steps shown). Standard peaks at 0.081 before borderline collapse. \rasp {} peaks at 0.061 (step 50) and declines to 0.010 by step 100}{figure.caption.22}{}}
