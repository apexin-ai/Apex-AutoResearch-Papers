lusion\\\\n    paragraph: 0\\\\n    sentence: 0\\\\n  text: After two-stage recovery, RASP reaches [TBD]% vs [TBD]%\\\\n  type: quantitative_placeholder\\\\n  evidence:\\\\n  - exp_id: grpo_stage2_rasp_20_v2\\\\n    status: RUNNING\\\\n  - exp_id: grpo_stage2_standard_20_v2\\\\n    status: RUNNING\\\\n  decisions: []\\\\n  deprecated: false\\\\n- id: C031\\\\n  location:\\\\n    section: conclusion\\\\n    paragraph: 0\\\\n    sentence: 0\\\\n  text: Paradigm-conditioned prunability extends LTH\\\\n  type: conceptual\\\\n  evidence: []\\\\n  decisions: []\\\\n  deprecated: false\\\\n- id: C032\\\\n  location:\\\\n    section: experiments\\\\n    paragraph: 0\\\\n    sentence: 0\\\\n  text: At 20% sparsity, 0/112 attention GQA groups pruned; all 200 pruned structures\\\\n    are MLP groups\\\\n  type: quantitative\\\\n  evidence:\\\\n  - exp_id: mvp_rasp_pipeline_v4\\\\n    description: Pruning distribution at 20% sparsity\\\\n  decisions: []\\\\n  deprecated: false\\\\n- id: C033\\\\n  location:\\\\n    section: limitations\\\\n    paragraph: 0\\\\n    sentence: 0\\\\n  text: At 20% sparsity, 0/112 attention GQA groups pruned; Claim 2 applies specifically\\\\n    to MLP groups\\\\n  type: scope_limitation\\\\n  evidence:\\\\n  - exp_id: mvp_rasp_pipeline_v4\\\\n    description: Pruning distribution observation\\\\n  decisions:\\\\n  - 'D018: Claim 2 scope limited to MLP groups at moderate sparsity'\\\\n  deprecated: false\\\\ntables: []\\\\nfigures: []\\\\n_completeness:\\\\n  coverage: 17/18\\\\n  claims: 18\\\\n  tables: 0\\\\n  figures: 0\\\\n  tier_counts:\\\\n    tier1: 0\\\\n    tier2: 17\\\\n    tier3: 1\\\\n    tierX: 0\\\\n  last_checked: '2026-05-15T07:15:37.156625+00:00'\\\\n\\\", \\\"total_chars\\\": 6383, \\\"truncated\\\": false}, \\\"error\\\": null, \\\"metadata\\\": {}}\"}"}]},"parent_tool_use_id":"toolu_01Jx1jirUJ8DukLEsTetRwWZ","session_id":"338b77c3-ab77-4d20-989d-1a060abc37a8","uuid":"db8e7d92-50a3-4b4d-adbe-6a5ec6cb94a9","timestamp":"2026-05-15