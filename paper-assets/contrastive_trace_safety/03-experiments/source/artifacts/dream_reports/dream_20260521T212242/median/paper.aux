\newlabel{tab:uniform-w}{{3}{5}{Uniform $W=3$ analysis. 3/4 models retain significance; R1-32B drops to 0/3 Holm--Bonferroni at uniform $W$, reflecting dimensionality constraints ($51{,}200 \times 3$ features for $n=20$ traces)}{table.caption.14}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Temporal window effect on HS probes at corrected layers. Text probes benefit universally from larger windows (4/4 models). HS probes improve for 3/4 models; R1-32B peaks at $W=1$ due to dimensionality constraints.}}{5}{table.caption.16}\protected@file@percent }
\newlabel{tab:temporal}{{4}{5}{Temporal window effect on HS probes at corrected layers. Text probes benefit universally from larger windows (4/4 models). HS probes improve for 3/4 models; R1-32B peaks at $W=1$ due to dimensionality constraints}{table.caption.16}{}}
