\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces Holm--Bonferroni step-down correction (12 tests, $\alpha = 0.05$, 10,000 bootstrap resamples). All 12 tests pass. The weakest tests are FPR comparisons: QwQ ($p=0.004$) and R1-32B ($p=0.007$), which are the marginal links under stricter family-wise correction.}}{7}{table.caption.21}\protected@file@percent }
\newlabel{tab:holm-bonf}{{7}{7}{Holm--Bonferroni step-down correction (12 tests, $\alpha = 0.05$, 10,000 bootstrap resamples). All 12 tests pass. The weakest tests are FPR comparisons: QwQ ($p=0.004$) and R1-32B ($p=0.007$), which are the marginal links under stricter family-wise correction}{table.caption.21}{}}
\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces Mahalanobis distance fails on all 4 models (max separation 0.20). The safety signal occupies minor PCA components, not the principal variance directions that Mahalanobis measures. TrajGuard's approach, designed for adversarial input detection, does not transfer to reasoning-model commitment.}}{7}{table.caption.23}\protected@file@percent }
\newlabel{tab:mahal}{{8}{7}{Mahalanobis distance fails on all 4 models (max separation 0.20). The safety signal occupies minor PCA components, not the principal variance directions that Mahalanobis measures. TrajGuard's approach, designed for adversarial input detection, does not transfer to reasoning-model commitment}{table.caption.23}{}}
