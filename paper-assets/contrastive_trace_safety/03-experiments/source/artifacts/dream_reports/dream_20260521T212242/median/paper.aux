\newlabel{tab:layer-metrics}{{1}{4}{Layer selected by each metric (layer number and relative depth). The \texttt {bal\_acc $\times $ crossing\_rate} metric selects shallow layers for all models, while three threshold-dependent metrics converge on deep layers at 32B. Pure \texttt {bal\_acc} selects middle layers. LOO-CV stability: the dominant layer is selected in 65--68\% of folds}{table.caption.11}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces HS vs.\ text advantage at corrected layers (best W per model). All 12 tests pass Holm--Bonferroni correction ($\alpha =0.05$). Precision advantage is consistent at $+15$--$24\text  {pp}$ across all 4 models.}}{4}{table.caption.12}\protected@file@percent }
\newlabel{tab:hs-vs-text}{{2}{4}{HS vs.\ text advantage at corrected layers (best W per model). All 12 tests pass Holm--Bonferroni correction ($\alpha =0.05$). Precision advantage is consistent at $+15$--$24\pp $ across all 4 models}{table.caption.12}{}}
