{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01571hyg855E7ZhzJKx3gENi","type":"tool_result","content":"1\t\"\"\"Central configuration for contrastive_trace_safety project.\"\"\"\n2\t\n3\timport os\n4\tfrom pathlib import Path\n5\t\n6\t# Paths\n7\tPROJECT_ROOT = Path(\"/root/autodl-tmp/contrastive_trace_safety\")\n8\tARTIFACTS_DIR = PROJECT_ROOT / \"artifacts\"\n9\tHIDDEN_STATES_DIR = ARTIFACTS_DIR / \"hidden_states\"\n10\tPROBES_DIR = ARTIFACTS_DIR / \"probes\"\n11\t\n12\t# Model\n13\tMODEL_NAME = \"deepseek-ai/DeepSeek-R1-Distill-Llama-8B\"\n14\tMODEL_PATH = \"/root/autodl-tmp/.hf_cache/deepseek-ai/DeepSeek-R1-Distill-Llama-8B\"\n15\t\n16\t# Dataset\n17\tHF_DATASET = \"ishitakakkar-10/HarmThoughts\"\n18\tTARGET_MODEL = \"r1-8b\"\n19\t\n20\t# Hidden state extraction\n21\tLAYERS = list(range(12, 25))  # layers 12-24, 13 layers total\n22\tNUM_LAYERS = len(LAYERS)\n23\tHIDDEN_DIM = 4096\n24\tEXTRACT_BATCH_SIZE = 4\n25\tDEVICE = \"cuda:0\"\n26\t\n27\t# Probes\n28\tWINDOW_SIZE = 5\n29\tTEMPORAL_HIDDEN_DIM = 512\n30\tLEARNING_RATE = 1e-3\n31\tTRAIN_EPOCHS = 20\n32\tPROBE_BATCH_SIZE = 64\n33\tDEFAULT_LAYER = 20  # for static probe\n34\t\n35\t# Data split\n36\tTRAIN_RATIO = 0.6\n37\tVAL_RATIO = 0.2\n38\tSEED = 42\n39\t\n40\t# Evaluation\n41\tDETECTION_THRESHOLD = 0.9\n42\tDETECTION_WINDOW = 5\n43\t\n44\t# Safety labels that define commitment point\n45\tSAFETY_LABELS = {\"RA\", \"AL\", \"CC\", \"ED\", \"IA\"}\n46\t"}]},"parent_tool_use_id":"toolu_01MYPrkjHZ1hJynCtMmTH3xh","session_id":"584eac82-aa50-4806-9859-0d2ba8093b1f","uuid":"f592792d-5c61-4f9d-a292-32d8a543faf7","timestamp":"2026-05-16T21:52:56.163Z"}
