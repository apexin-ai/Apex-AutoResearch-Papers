  dream_20260521T212242:
    dream_id: dream_20260521T212242
    project: contrastive_trace_safety
    status: done
    review_mode: full
    review_visible: true
    writing_visible: true
    venue: emnlp-2026
    focus: 'Evaluate whether adding CV-validated ensemble results (currently p≤0.002
      without CV) meaningfully improves paper acceptance probability at EMNLP 2026.
      Key question: does upgrading ensemble from ''preliminary'' to ''CV-validated''
      move the needle from Findings to Main, or is it marginal? Also assess current
      paper state post-R30 fixes (commit 322b668) — are there any OTHER low-cost improvements
      the dream reviewers would prioritize?'
    what_if:
    - name: ensemble_cv_7b
      claim: C1 (layer selection bias mitigation)
      description: 5-fold CV validation of multi-metric ensemble layer selection on
        7-8B models (R1-8B + OT-7B). Validates that ensemble eliminates metric-induced
        bias under cross-validation, upgrading from preliminary to validated diagnostic
        guidance.
      estimated_gpu_hours: 0.5
    pid: 1827424
