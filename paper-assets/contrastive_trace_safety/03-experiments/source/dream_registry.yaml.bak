  dream_20260522T085530:
    dream_id: dream_20260522T085530
    project: contrastive_trace_safety
    status: reviewing
    review_mode: full
    review_visible: true
    writing_visible: true
    venue: emnlp-2026
    focus: 'Evaluate whether adding AdvBench layer selection bias replication moves
      the paper from Findings (3.0) toward Borderline Conference (3.5). Previous Dream
      scored 3.0 across all tiers. Key question: does cross-dataset C1 validation
      meaningfully strengthen the paper?'
    what_if:
    - name: advbench_layer_bias_replication
      claim: C1 (layer selection bias)
      description: 'Replicate layer selection bias on AdvBench using jailbreak/safe
        binary labels (no CP needed). Train probes on R1-8B AdvBench traces, run 5-metric
        layer selection analysis. Expected: CR-composite selects shallow layers, threshold-based
        selects deep layers, confirming bias is model-geometric not dataset-specific.
        Results in appendix table + main text one-sentence reference.'
      estimated_gpu_hours: 6.0
    pid: 1888077
