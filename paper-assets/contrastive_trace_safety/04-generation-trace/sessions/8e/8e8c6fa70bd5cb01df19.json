f\\\\\\\": \\\\\\\"ot-7b\\\\\\\",\\\\n        \\\\\\\"hs_dir\\\\\\\": BASE / \\\\\\\"artifacts/hidden_states_ot7b\\\\\\\",\\\\n        \\\\\\\"layer_idx\\\\\\\": 16,\\\\n        \\\\\\\"hidden_dim\\\\\\\": 3584,\\\\n        \\\\\\\"window\\\\\\\": 3,\\\\n    },\\\\n    \\\\\\\"qwq_32b\\\\\\\": {\\\\n        \\\\\\\"model_name_hf\\\\\\\": \\\\\\\"QwQ\\\\\\\",\\\\n        \\\\\\\"hs_dir\\\\\\\": BASE / \\\\\\\"artifacts/hidden_states_qwq_32b\\\\\\\",\\\\n        \\\\\\\"layer_idx\\\\\\\": 60,\\\\n        \\\\\\\"hidden_dim\\\\\\\": 5120,\\\\n        \\\\\\\"window\\\\\\\": 3,\\\\n    },\\\\n    \\\\\\\"r1_32b\\\\\\\": {\\\\n        \\\\\\\"model_name_hf\\\\\\\": \\\\\\\"r1-32b\\\\\\\",\\\\n        \\\\\\\"hs_dir\\\\\\\": BASE / \\\\\\\"artifacts/hidden_states_r1_32b\\\\\\\",\\\\n        \\\\\\\"layer_idx\\\\\\\": 63,\\\\n        \\\\\\\"hidden_dim\\\\\\\": 5120,\\\\n        \\\\\\\"window\\\\\\\": 1,\\\\n    },\\\\n}\\\\n\\\\nBGE_MODEL_PATH = str(BASE / \\\\\\\"models/bge-large-en-v1.5\\\\\\\")\\\\nBGE_DIM = 768\\\\n\\\\n\\\\ndef parse_args():\\\\n    \\\\\\\"\\\\\\\"\\\\\\\"Parse command line arguments.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n    parser = argparse.ArgumentParser(\\\\n        description=\\\\\\\"HS vs BGE-large text probe paired bootstrap comparison\\\\\\\"\\\\n    )\\\\n    parser.add_argument(\\\\n\\\", \\\"stderr\\\": \\\"\\\", \\\"return_code\\\": 0}, \\\"error\\\": null, \\\"metadata\\\": {\\\"elapsed_seconds\\\": 0.94}}\"}",
