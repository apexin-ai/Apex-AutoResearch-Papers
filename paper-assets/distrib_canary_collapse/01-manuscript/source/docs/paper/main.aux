\@writefile{lof}{\contentsline {figure}{\numberline {25}{\ignorespaces PermG power curves as a function of coupling strength $\beta $ for $T \in \{6, 8, 10, 15, 20\}$ (100 replications, 5{,}000 permutations, BH-FDR $q{=}0.05$). Power increases faster than $\sqrt  {T}$, confirming that the theoretical $\sqrt  {T}$ formula is a conservative lower bound. At $T{=}10$, 50\% power requires $\beta {\geq }2.0$; at $T{=}20$, this drops to $\beta {\approx }0.9$.}}{34}{figure.caption.157}\protected@file@percent }
\newlabel{fig:permg_power_curve}{{25}{34}{PermG power curves as a function of coupling strength $\beta $ for $T \in \{6, 8, 10, 15, 20\}$ (100 replications, 5{,}000 permutations, BH-FDR $q{=}0.05$). Power increases faster than $\sqrt {T}$, confirming that the theoretical $\sqrt {T}$ formula is a conservative lower bound. At $T{=}10$, 50\% power requires $\beta {\geq }2.0$; at $T{=}20$, this drops to $\beta {\approx }0.9$}{figure.caption.157}{}}
