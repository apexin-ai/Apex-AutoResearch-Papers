512.7,\n33\t      \"alpha_075_gen10_distinct_1\": 0.083,\n34\t      \"alpha_075_gen10_token_entropy\": 1.68,\n35\t      \"alpha_075_gen10_ece\": 0.312,\n36\t      \"effective_rank_lead_any_alpha\": \"not significant\",\n37\t      \"self_bleu_lead_any_alpha\": \"not significant\"\n38\t    },\n39\t    \"tables\": [\n40\t      {\n41\t        \"name\": \"Table 2: Toda-Yamamoto lead-lag results across α\",\n42\t        \"columns\": [\n43\t          \"α\",\n44\t          \"canary_family\",\n45\t          \"target\",\n46\t          \"TY_lead_gen\",\n47\t          \"TY_p_median\",\n48\t          \"seeds_sig\",\n49\t          \"effect_size_r\"\n50\t        ],\n51\t        \"rows\": [\n52\t          [\n53\t            0.25,\n54\t            \"ECE\",\n55\t            \"distinct_1\",\n56\t            2,\n57\t            0.002,\n58\t            \"3/3\",\n59\t            0.93\n60\t          ],\n61\t          [\n62\t            0.25,\n63\t            \"token_entropy\",\n64\t            \"distinct_1\",\n65\t            2,\n66\t            0.004,\n67\t            \"3/3\",\n68\t            0.91\n69\t          ],\n70\t          [\n71\t            0.25,\n72\t            \"ECE\",\n73\t            \"perplexity\",\n74\t            1,\n75\t            0.038,\n76\t            \"2/3\",\n77\t            0.72\n78\t          ],\n79\t          [\n80\t            0.25,\n81\t            \"token_entropy\",\n82\t            \"perplexity\",\n83\t            1,\n84\t            0.047,\n85\t            \"2/3\",\n86\t            0.68\n87\t          ],\n88\t          [\n89\t            0.5,\n90\t            \"ECE\",\n91\t            \"distinct_1\",\n92\t            1,\n93\t            0.006,\n94\t            \"3/3\",\n95\t            0.9\n96\t          ],\n97\t          [\n98\t            0.5,\n99\t            \"token_entropy\",\n100\t            \"distinct_1\",\n101\t            1,\n102\t            0.01,\n103\t            \"3/3\",\n104\t            0.88\n105\t          ],\n106\t          [\n107\t      