      \"alpha_0.75_TY_canary_to_perplexity_p\": 0.214,\n35\t      \"alpha_0.75_effect_size_r_ece_distinct1\": 0.96,\n36\t      \"phase_boundary_alpha_star\": 0.6,\n37\t      \"cross_seed_consistency_diversity_lead\": \"3/3 seeds at all α\",\n38\t      \"cross_seed_consistency_perplexity_lead\": \"3/3 seeds at α≤0.50; 1/3 at α=0.75\"\n39\t    },\n40\t    \"tables\": [\n41\t      {\n42\t        \"name\": \"Table 1: α-sweep Summary Statistics (mean ± std across seeds)\",\n43\t        \"columns\": [\n44\t          \"α\",\n45\t          \"gen10_ppl\",\n46\t          \"gen10_entropy\",\n47\t          \"gen10_ece\",\n48\t          \"gen10_d1\",\n49\t          \"gen10_d2\",\n50\t          \"canary→d1 lead (gen)\",\n51\t          \"canary→ppl lead (gen)\",\n52\t          \"TY p (canary→d1)\",\n53\t          \"TY p (canary→ppl)\"\n54\t        ],\n55\t        \"rows\": [\n56\t          [\n57\t            \"0.25\",\n58\t            \"68.4±4.1\",\n59\t            \"2.41±0.05\",\n60\t            \"0.138±0.009\",\n61\t            \"0.312±0.018\",\n62\t            \"0.681±0.022\",\n63\t            \"2.7±0.3\",\n64\t            \"2.0±0.4\",\n65\t            \"<0.005\",\n66\t            \"0.018\"\n67\t          ],\n68\t          [\n69\t            \"0.50\",\n70\t            \"189.3±12.6\",\n71\t            \"1.94±0.07\",\n72\t            \"0.247±0.015\",\n73\t            \"0.198±0.014\",\n74\t            \"0.512±0.019\",\n75\t            \"2.0±0.2\",\n76\t            \"1.3±0.3\",\n77\t            \"<0.005\",\n78\t            \"0.032\"\n79\t          ],\n80\t          [\n81\t            \"0.75\",\n82\t            \"512.7±31.4\",\n83\t            \"1.52±0.09\",\n84\t            \"0.361±0.021\",\n85\t            \"0.112±0.011\",\n86\t            \"0.402±0.025\",\n87\t            \"1.7±0.2\",\n88\t            \"0.3±0.5\",\n89\t            \"<0.005\",\n90\t            \"0.214\"\n91\t          ],\n92\t          [\n93\t            \"1.00 (MVP)\",\n94\t            \"1024.7±16.8\",\n95\t            \"1.27±0.06\",\n96\t            \"0.420±0.012\",\n97\t            \"0.075±0.008\",\n98\t            \"0.365±0.015\",\n99\t            \"1.5±0.3\",\n100\t            \"0.0±0.2\","}]},"parent_tool_use_id":"toolu_0121a2JqSYn9WuKiDTNimUzn","session_id":"94fcddd3-8b83-4721-94fe-5ba1b028b20f","uuid":"117a1019-22a5-4c7e-96a8-d8be6dd9a304","timestamp":"2026-05-14T19:28:40.238Z"}
