{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016xErpBufMRDBMyjqmqv3FT","type":"tool_result","content":"1\t[\n2\t  {\n3\t    \"name\": \"Full Pareto Frontier — Qwen3-235B-A22B\",\n4\t    \"description\": \"94-layer MoE model, INT8, 24 probed layers (every 4th), 20 languages, 5 transfer conditions (zero-shot, mean-shift, linear projection, few-shot 25/100, CaCLR).\\n\",\n5\t    \"results\": {\n6\t      \"en_best_auroc\": 0.838,\n7\t      \"en_best_layer\": 76,\n8\t      \"en_best_ece_raw\": 0.162,\n9\t      \"en_best_ece_tempcal\": 0.048,\n10\t      \"temp_scaling_T\": 4.83,\n11\t      \"en_auroc_range\": [\n12\t        0.592,\n13\t        0.838\n14\t      ],\n15\t      \"optimal_transfer_layer_median\": 56,\n16\t      \"zs_transfer_auroc_median_20lang\": 0.758,\n17\t      \"zs_transfer_auroc_at_en_optimal_layer76\": 0.714,\n18\t      \"zs_transfer_auroc_at_transfer_optimal_layer56\": 0.771,\n19\t      \"pareto_rho_global\": -0.81,\n20\t      \"pareto_rho_per_lang_median\": -0.78,\n21\t      \"pareto_rho_per_lang_iqr\": [\n22\t        -0.84,\n23\t        -0.71\n24\t      ],\n25\t      \"zs_langs_above_0p65_out_of_20\": 17,\n26\t      \"best_zs_auroc_by_tier\": {\n27\t        \"HIGH_zh\": 0.793,\n28\t        \"HIGH_es\": 0.801,\n29\t        \"HIGH_fr\": 0.798,\n30\t        \"HIGH_de\": 0.784,\n31\t        \"MID_hi\": 0.742,\n32\t        \"MID_ru\": 0.769,\n33\t        \"MID_ko\": 0.751,\n34\t        \"MID_tr\": 0.738,\n35\t        \"LOW_sw\": 0.641,\n36\t        \"LOW_bn\": 0.633\n37\t      },\n38\t      \"mean_shift_delta_auroc_median\": 0.0,\n39\t      \"linear_proj_delta_auroc_over_zs_median\": 0.048,\n40\t      \"fewshot_25_delta_auroc_over_zs_median\": 0.032,\n41\t      \"fewshot_100_delta_auroc_over_zs_median\": 0.055\n42\t    },\n43\t    \"tables\": [\n44\t      {\n45\t        \"name\": \"Table 1: Qwen3-235B Pareto Frontier — EN AUROC vs ZS Transfer AUROC by Layer\",\n46\t        \"columns\": [\n47\t          \"layer\",\n48\t          \"depth_pct\",\n49\t          \"en_auroc\",\n50\t          \"zs_median_auroc\",\n51\t          \"zs_min_auroc\",\n52\t          \"zs_max_auroc\",\n53\t          \"rho_median\"\n54\t        ],\n55\t        \"rows\": [\n56\t          [\n57\t            0,\n58\t            0,\n59\t            0.592,\n60\t            0.583,\n61\t            0.521,\n62\t            0.601,\n63\t            null\n64\t          ],\n65\t          [\n66\t            8,\n67\t            9,\n68\t            0.631,\n69\t            0.618,\n70\t            0.554,\n71\t            0.639,\n72\t            null\n73\t          ],\n74\t          [\n75\t            16,\n76\t            17,\n77\t            0.672,\n78\t            0.659,\n79\t            0.589,\n80\t            0.678,\n81\t            null\n82\t          ],\n83\t          [\n84\t            24,\n85\t            26,\n86\t            0.711,\n87\t            0.698,\n88\t            0.621,\n89\t            0.719,\n90\t            null\n91\t          ],\n92\t          [\n93\t            32,\n94\t            34,\n95\t            0.738,\n96\t            0.729,\n97\t            0.648,\n98\t            0.751,\n99\t            null\n100\t          ],"}]},"parent_tool_use_id":"toolu_016CqR9KEpkaiibBTanwneDE","session_id":"d1221443-c15e-4888-b9c9-64cd2c74844d","uuid":"b03db14b-76b4-4c72-b5bf-3329faa94722","timestamp":"2026-05-20T21:00:41.855Z"}
