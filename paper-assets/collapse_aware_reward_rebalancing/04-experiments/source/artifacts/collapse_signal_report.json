  "interpretation": {
    "vendi_score_context": {
      "k8_curation": "107.21 -> 107.25 (flat, +0.04)",
      "baseline": "105.42 -> 108.72 (increasing, +3.30)"
    },
    "key_question": "Does text-level collapse exist in K=8 curation despite stable Vendi Score?",
    "answer": "YES — K=8 curation shows FORMAT/TEMPLATE collapse that Vendi Score cannot detect.",
    "evidence": {
      "opening_pattern_collapse": {
        "description": "Near-duplicate opening rate (50-char fingerprint) jumps from 50% to 84% in K=8 curation, vs 38% to 75% in baseline. K=8 Gen2 has only 36.7% unique openings vs 51.3% for baseline.",
        "mechanism": "Reward model (ArmoRM) implicitly favors certain opening patterns. Iterative selection amplifies this preference into a template.",
        "vendi_blind_spot": "Embedding models are insensitive to surface-level formatting—responses starting the same way but continuing differently still map to distant embeddings."
      },
      "degenerate_repetition": {
        "description": "K=8 Gen2 shows \"answer: answer: answer: answer:\" as 2nd most common 4-gram (1149x), plus repetition loops like \"ito ito ito ito\" and \"ba ba ba ba\". Baseline Gen2 is actually WORSE here: \"chopped chopped chopped\" (1282x) and \"i_jump i_jump i_jump\" (1008x) rank #1 and #2.",
        "implication": "Both conditions develop degenerate token loops by Gen2, but baseline is worse in absolute terms. This is generic SFT mode collapse, not curation-specific."
      },
      "length_compression": {
        "description": "K=8 curation: mean length drops 2.8 words, std drops 0.95. Baseline: mean grows 1.0, std grows 2.8. Curation pushes toward a narrower length band.",
        "mechanism": "ArmoRM may have a length preference; top-K selection concentrates outputs near that optimum.",
        "severity": "Low — absolute change is small relative to mean (160 words)."
      },
      "per_response_vocab_actually_stable_in_curation": {
        "description": "Per-response TTR drops only -0.008 in K=8 curation vs -0.023 in baseline. Within individual responses, curation maintains vocabulary diversity better.",
        "explanation": "Curation selects higher-quality (more articulate) responses, indirectly preserving per-response lexical richness. Baseline SFT on random picks allows vocabulary to degrade."
      }
    },
    "conclusion": "K=8 curation collapse is primarily a FORMAT/TEMPLATE collapse (opening patterns, response structure) rather than CONTENT/SEMANTIC collapse. Vendi Score, which operates in embedding space, correctly captures that semantic diversity is maintained — but misses that the surface-level generation is becoming template-bound. A complementary metric like opening-entropy or n-gram distinctness would catch this.",
    "recommended_metrics": [
      "opening_entropy (first-10-word entropy)",
      "near_duplicate_start_rate (50-char fingerprint collision rate)",
      "structural_template_frequency (regex pattern match rates)"
    ]
  }
}
