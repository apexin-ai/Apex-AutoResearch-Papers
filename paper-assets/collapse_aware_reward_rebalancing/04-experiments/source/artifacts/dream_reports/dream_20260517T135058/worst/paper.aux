\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Qwen2.5-1.5B LoRA $K{=}4$ curated trajectory over five generations. All diversity metrics decline monotonically while quality rises, constituting a multi-metric collapse signature. The 1.5B random baseline was terminated during Gen1 training due to CUDA OOM; only Gen0 is available (Vendi: 107.1, nn-dist: 0.708, quality: 0.1135).}}{6}{table.caption.8}\protected@file@percent }
\newlabel{tab:1.5b}{{4}{6}{Qwen2.5-1.5B LoRA $K{=}4$ curated trajectory over five generations. All diversity metrics decline monotonically while quality rises, constituting a multi-metric collapse signature. The 1.5B random baseline was terminated during Gen1 training due to CUDA OOM; only Gen0 is available (Vendi: 107.1, nn-dist: 0.708, quality: 0.1135)}{table.caption.8}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Training loss dynamics. Loss drop confirms real learning across all configurations. The 1.5B model achieves the deepest loss reduction, consistent with its higher capacity enabling more directional distribution shift.}}{6}{table.caption.9}\protected@file@percent }
\newlabel{tab:loss}{{5}{6}{Training loss dynamics. Loss drop confirms real learning across all configurations. The 1.5B model achieves the deepest loss reduction, consistent with its higher capacity enabling more directional distribution shift}{table.caption.9}{}}
