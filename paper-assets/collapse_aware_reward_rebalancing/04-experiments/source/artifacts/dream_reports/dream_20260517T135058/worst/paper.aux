\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{tab:main}{{1}{4}{Semantic diversity and quality metrics across eight 0.6B configurations over three generations. All configurations show P1 = FAIL (no collapse detected). $\Delta _V$: Vendi Score change (\%). Gen0/Gen2 values shown for Vendi Score, nn-distance, and quality}{table.caption.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Vendi Score trajectory summary across scales. 0.6B configurations (three generations) are uniformly stable. The 1.5B curated configuration (five generations) shows monotonic decline, crossing the P1 threshold by generation 3. Color coding: {\color  {safegreen}green} = stable, {\color  {dangerred}red} = collapsing.}}{4}{table.caption.6}\protected@file@percent }
\newlabel{tab:vendi_trajectory}{{2}{4}{Vendi Score trajectory summary across scales. 0.6B configurations (three generations) are uniformly stable. The 1.5B curated configuration (five generations) shows monotonic decline, crossing the P1 threshold by generation 3. Color coding: {\color {safegreen}green} = stable, {\color {dangerred}red} = collapsing}{table.caption.6}{}}
