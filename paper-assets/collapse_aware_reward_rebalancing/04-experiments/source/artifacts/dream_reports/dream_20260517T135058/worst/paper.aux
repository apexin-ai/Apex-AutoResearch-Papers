\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Format diversity metrics. Same-$K$ comparison (C1 curated vs. C5 random, both $K{=}4$) shows format collapse is independent of curation. C2 ($K{=}8$) demonstrates that higher $K$ amplifies severity. Selected = 2,000 retained responses; Full-pool = all generated candidates.}}{5}{table.caption.7}\protected@file@percent }
\newlabel{tab:format}{{3}{5}{Format diversity metrics. Same-$K$ comparison (C1 curated vs. C5 random, both $K{=}4$) shows format collapse is independent of curation. C2 ($K{=}8$) demonstrates that higher $K$ amplifies severity. Selected = 2,000 retained responses; Full-pool = all generated candidates}{table.caption.7}{}}
