\newlabel{tab:configs}{{1}{4}{Experimental configurations. $K$: candidates generated per prompt. Sel: selection strategy (curated = top-1 by reward, random = uniform). $G$: number of training generations}{table.caption.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Semantic diversity across all configurations. $V_0$, $V_f$: Vendi Score at generation 0 and final generation. $\Delta V$: relative change (\%). $d_f$: mean NN distance at final generation. $B_f$: self-BLEU at final generation. No configuration shows meaningful semantic diversity loss.}}{4}{table.caption.6}\protected@file@percent }
\newlabel{tab:semantic}{{2}{4}{Semantic diversity across all configurations. $V_0$, $V_f$: Vendi Score at generation 0 and final generation. $\Delta V$: relative change (\%). $d_f$: mean NN distance at final generation. $B_f$: self-BLEU at final generation. No configuration shows meaningful semantic diversity loss}{table.caption.6}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.2}Format Collapse is Inherent to Iterative Training}{4}{subsection.4.2}\protected@file@percent }
\newlabel{sec:format}{{4.2}{4}{Format Collapse is Inherent to Iterative Training}{subsection.4.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Format diversity metrics. $H_0$, $H_f$: opening-pattern entropy (bits) at generation 0 and final generation. $D_0$, $D_f$: near-duplicate start rate. The C1 vs.\ C5 comparison (same $K$, same training, differing only in selection strategy) shows identical format degradation. Higher $K$ amplifies the effect (C2, C8). The 1.5B models (C9, C10) replicate the pattern over 5 generations.}}{5}{table.caption.7}\protected@file@percent }
\newlabel{tab:format}{{3}{5}{Format diversity metrics. $H_0$, $H_f$: opening-pattern entropy (bits) at generation 0 and final generation. $D_0$, $D_f$: near-duplicate start rate. The C1 vs.\ C5 comparison (same $K$, same training, differing only in selection strategy) shows identical format degradation. Higher $K$ amplifies the effect (C2, C8). The 1.5B models (C9, C10) replicate the pattern over 5 generations}{table.caption.7}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Curation effect on Vendi Score across training regimes (0.6B, $K$=4). Gap = $\Delta V_{\text  {curated}} - \Delta V_{\text  {random}}$ in percentage points. Under LoRA, curation appears to suppress diversity ($-$3.38\,pp). Under FFT with high learning rate, curation mildly promotes diversity (+0.63\,pp). The 1.5B LoRA gap is compressed relative to 0.6B, consistent with a tighter capacity ceiling at lower LoRA-to-parameter ratio.}}{5}{table.caption.8}\protected@file@percent }
\newlabel{tab:gap}{{4}{5}{Curation effect on Vendi Score across training regimes (0.6B, $K$=4). Gap = $\Delta V_{\text {curated}} - \Delta V_{\text {random}}$ in percentage points. Under LoRA, curation appears to suppress diversity ($-$3.38\,pp). Under FFT with high learning rate, curation mildly promotes diversity (+0.63\,pp). The 1.5B LoRA gap is compressed relative to 0.6B, consistent with a tighter capacity ceiling at lower LoRA-to-parameter ratio}{table.caption.8}{}}
