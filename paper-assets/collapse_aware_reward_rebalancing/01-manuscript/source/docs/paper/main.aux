\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Per-generation metrics for all 8 experimental conditions across 3 self-training generations. Curated conditions (C1--C4, C8) show stable Vendi Score ($\pm $1\%), low Self-BLEU, and consistent NND, indicating no semantic collapse. Random baselines (C5--C7) exhibit comparable or larger metric drift despite the absence of reward selection. C7 metrics were recorded from a separate analysis pass.}}{12}{table.caption.24}\protected@file@percent }
\newlabel{tab:per_gen_metrics}{{6}{12}{Per-generation metrics for all 8 experimental conditions across 3 self-training generations. Curated conditions (C1--C4, C8) show stable Vendi Score ($\pm $1\%), low Self-BLEU, and consistent NND, indicating no semantic collapse. Random baselines (C5--C7) exhibit comparable or larger metric drift despite the absence of reward selection. C7 metrics were recorded from a separate analysis pass}{table.caption.24}{}}
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces Mean ArmoRM quality score per generation. All conditions remain in the 0.110--0.116 range with mild decreases across generations ($-$0.3\% to $-$1.3\%), confirming quality stability under iterative self-training.}}{12}{table.caption.25}\protected@file@percent }
\newlabel{tab:quality_scores}{{7}{12}{Mean ArmoRM quality score per generation. All conditions remain in the 0.110--0.116 range with mild decreases across generations ($-$0.3\% to $-$1.3\%), confirming quality stability under iterative self-training}{table.caption.25}{}}
\@LN@col{2}
\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces Self-BLEU-4 and Distinct-$n$ across generations. Self-BLEU-4 remains low ($<$0.016) for all conditions, indicating minimal textual repetition. Distinct-$n$ shows uniform decline across all conditions (curated and random alike), consistent with format homogenization under iterative self-training rather than reward-specific narrowing.}}{13}{table.caption.26}\protected@file@percent }
\newlabel{tab:lexical_diversity}{{8}{13}{Self-BLEU-4 and Distinct-$n$ across generations. Self-BLEU-4 remains low ($<$0.016) for all conditions, indicating minimal textual repetition. Distinct-$n$ shows uniform decline across all conditions (curated and random alike), consistent with format homogenization under iterative self-training rather than reward-specific narrowing}{table.caption.26}{}}
