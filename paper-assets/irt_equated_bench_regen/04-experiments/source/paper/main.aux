\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Four-stage psychometric auditing pipeline. \textbf  {{\fontfamily  {pzd}\fontencoding  {U}\fontseries  {m}\fontshape  {n}\selectfont  \char 192}} A binary response matrix records model correctness across benchmark items, with models split into temporal cohorts (2023 reference vs.\ 2024 focal). \textbf  {{\fontfamily  {pzd}\fontencoding  {U}\fontseries  {m}\fontshape  {n}\selectfont  \char 193}} Models are stratified into $K{=}5$ score quintiles. \textbf  {{\fontfamily  {pzd}\fontencoding  {U}\fontseries  {m}\fontshape  {n}\selectfont  \char 194}} Per-item Mantel-Haenszel DIF tests compute $\Delta _{\mathrm  {MH}}$ across strata. \textbf  {{\fontfamily  {pzd}\fontencoding  {U}\fontseries  {m}\fontshape  {n}\selectfont  \char 195}} ETS classification assigns severity labels (A/B/C). Result: 29.2\% of items flagged as C, yet stable-item $\rho = 0.997$, replicated across six benchmarks.}}{2}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:pipeline}{{1}{2}{Four-stage psychometric auditing pipeline. \textbf {\ding {192}} A binary response matrix records model correctness across benchmark items, with models split into temporal cohorts (2023 reference vs.\ 2024 focal). \textbf {\ding {193}} Models are stratified into $K{=}5$ score quintiles. \textbf {\ding {194}} Per-item Mantel-Haenszel DIF tests compute $\Delta _{\mathrm {MH}}$ across strata. \textbf {\ding {195}} ETS classification assigns severity labels (A/B/C). Result: 29.2\% of items flagged as C, yet stable-item $\rho = 0.997$, replicated across six benchmarks}{figure.caption.1}{}}
\newlabel{fig:pipeline@cref}{{[figure][1][]1}{[1][1][]2}{}{}{}}
