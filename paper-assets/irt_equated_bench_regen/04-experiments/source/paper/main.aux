\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Schematic illustration of global vs.\ differential contamination via Item Characteristic Curves (ICCs). \textbf  {Left}: global contamination produces no DIF; both cohorts encounter the item, and their ICCs overlap. \textbf  {Right}: differential contamination produces DIF; the focal cohort's ICC shifts because only that cohort was disproportionately exposed during training (assuming no ceiling effect). The enrichment ratio of $\approx 1.0$ between DIF flags and web-overlap labels is expected because most MMLU items fall into the left category.}}{14}{figure.caption.33}\protected@file@percent }
\newlabel{fig:global_vs_differential}{{4}{14}{Schematic illustration of global vs.\ differential contamination via Item Characteristic Curves (ICCs). \textbf {Left}: global contamination produces no DIF; both cohorts encounter the item, and their ICCs overlap. \textbf {Right}: differential contamination produces DIF; the focal cohort's ICC shifts because only that cohort was disproportionately exposed during training (assuming no ceiling effect). The enrichment ratio of $\approx 1.0$ between DIF flags and web-overlap labels is expected because most MMLU items fall into the left category}{figure.caption.33}{}}
\newlabel{fig:global_vs_differential@cref}{{[figure][4][]4}{[1][14][]14}{}{}{}}
