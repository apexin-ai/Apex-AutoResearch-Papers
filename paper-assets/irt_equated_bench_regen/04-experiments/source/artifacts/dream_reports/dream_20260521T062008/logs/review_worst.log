{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XtZnPFD4Lnr91sL14Nvren","type":"tool_result","content":"1\t\\documentclass{article}\n2\t\\usepackage{iclr2026_conference,times}\n3\t\\input{math_commands.tex}\n4\t\n5\t\\usepackage{hyperref}\n6\t\\usepackage{url}\n7\t\\usepackage{booktabs}\n8\t\\usepackage{graphicx}\n9\t\\usepackage{xcolor}\n10\t\\usepackage{microtype}\n11\t\\usepackage{multirow}\n12\t\\usepackage{subcaption}\n13\t\\usepackage{cleveref}\n14\t\n15\t\\graphicspath{{../figures/paper/}}\n16\t\n17\t\\title{Psychometric Instability of LLM Benchmarks:\\\\Differential Item Functioning Reveals 31\\% of MMLU Items\\\\Behave Differently Across Model Generations}\n18\t\n19\t%\\iclrfinalcopy\n20\t\n21\t\\newcommand{\\fix}{\\marginpar{FIX}}\n22\t\\newcommand{\\new}{\\marginpar{NEW}}\n23\t\n24\t\\begin{document}\n25\t\n26\t\\maketitle\n27\t\n28\t\\input{sections/abstract}\n29\t\\input{sections/introduction}\n30\t\\input{sections/related_work}\n31\t\\input{sections/method}\n32\t\\input{sections/experiments}\n33\t\\input{sections/discussion}\n34\t\n35\t\\bibliography{references}\n36\t\\bibliographystyle{iclr2026_conference}\n37\t\n38\t\\appendix\n39\t\\input{sections/appendix}\n40\t\n41\t\\end{document}\n42\t"}]},"parent_tool_use_id":"toolu_01AwPKLvJtxVbyFjC2QqdFcN","session_id":"1de34d84-f766-4404-96e4-471a6ac5107f","uuid":"9382dd8e-7e3a-45ab-b7fd-1b3abf521df5","timestamp":"2026-05-21T07:10:34.161Z"}
