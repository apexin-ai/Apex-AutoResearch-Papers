{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JGKdFjff4WqtT69ezqv3TR","type":"tool_result","content":"1\t\\documentclass[11pt]{article}\n2\t\\usepackage[review]{acl}\n3\t\n4\t\\usepackage{times}\n5\t\\usepackage{latexsym}\n6\t\\usepackage[T1]{fontenc}\n7\t\\usepackage[utf8]{inputenc}\n8\t\\usepackage{microtype}\n9\t\\usepackage{booktabs}\n10\t\\usepackage{graphicx}\n11\t\\usepackage{xcolor}\n12\t\\usepackage{multirow}\n13\t\\usepackage{subcaption}\n14\t\n15\t\\input{math_commands.tex}\n16\t\n17\t\\usepackage{cleveref}\n18\t\n19\t\\graphicspath{{../figures/paper/}}\n20\t\n21\t\\title{Psychometric Instability of LLM Benchmarks:\\\\Differential Item Functioning Reveals 31\\% of MMLU Items\\\\Behave Differently Across Model Generations}\n22\t\n23\t\\begin{document}\n24\t\n25\t\\maketitle\n26\t\n27\t\\input{sections/abstract}\n28\t\\input{sections/introduction}\n29\t\\input{sections/related_work}\n30\t\\input{sections/method}\n31\t\\input{sections/experiments}\n32\t\\input{sections/discussion}\n33\t\\input{sections/conclusion}\n34\t\\input{sections/limitations}\n35\t\n36\t\\bibliography{references}\n37\t\n38\t\\appendix\n39\t\\input{sections/appendix}\n40\t\n41\t\\end{document}\n42\t"}]},"parent_tool_use_id":"toolu_017Ve6VeYsmSXUuKEKZ2Ge95","session_id":"e51e0195-9c84-4e56-b272-a71ad93d54d2","uuid":"872d9575-dcfb-4e9f-863f-3eb5421de61a","timestamp":"2026-05-21T14:59:12.990Z"}
