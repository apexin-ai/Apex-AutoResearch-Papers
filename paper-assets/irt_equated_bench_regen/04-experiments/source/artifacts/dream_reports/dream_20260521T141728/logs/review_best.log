{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019kuDGCPrB87jxnb61SDyJN","type":"tool_result","content":"{\"result\":\"{\\\"success\\\": true, \\\"data\\\": {\\\"path\\\": \\\"/home/ubuntu/.agent-ml-research-idea_gen_0520_2/projects/irt_equated_bench_regen/literature_map.yaml\\\", \\\"content\\\": \\\"categories:\\\\n- key: contamination_detection\\\\n  name: Benchmark Contamination Detection\\\\n  narrative: Methods for detecting training data contamination in LLM benchmarks,\\\\n    including RL-robust approaches\\\\n- key: irt_equating\\\\n  name: IRT Methodology & Equating\\\\n  narrative: Item Response Theory models, calibration, equating, and their application\\\\n    to LLM evaluation\\\\n- key: benchmark_design\\\\n  name: Dynamic Benchmark Design\\\\n  narrative: Approaches for creating contamination-resistant or self-updating benchmarks\\\\n- key: dif_methodology\\\\n  name: DIF Statistical Methods\\\\n  narrative: Differential Item Functioning detection methods, power analysis, and\\\\n    small-sample strategies\\\\n- key: item_generation\\\\n  name: Automated Item Generation\\\\n  narrative: LLM-based test item generation with difficulty control and psychometric\\\\n    validation\\\\n- key: llm_evaluation\\\\n  name: LLM Evaluation Methodology\\\\n  narrative: General LLM evaluation methodology, benchmark psychometric analysis,\\\\n    evaluation surveys, and benchmark design principles\\\\nmeta:\\\\n  last_updated: '2026-05-21T03:50:29.840Z'\\\\n  total_papers: 45\\\\npapers:\\\\n  balloccu2024leak:\\\\n    abstract: ''\\\\n    added_at: '2026-05-21T01:40:37.987Z'\\\\n    added_by: literature-gap-fill\\\\n    authors:\\\\n    - Balloccu, S.\\\\n    - Schmidtova, P.\\\\n    - Lango, M.\\\\n    - Dusek, O.\\\\n    bibtex_key: balloccu2024leak\\\\n    category: contamination_detection\\\\n    doi: 10.18653/v1/2024.eacl-long.5\\\\n    relevance: Systematic survey of data leakage in closed-source LLMs covering 255\\\\n      papers and 263 benchmarks; establishes scope of contamination problem motivating\\\\n      our detection approach\\\\n    role: foundation\\\\n    semantic_scholar_id: 798feda076ad710df65d509a7884bd15937c8056\\\\n    title: 'Leak, Cheat, Repeat: Data Contamination and Evaluation Malpractices in\\\\n      Closed-Source LLMs'\\\\n    url: https://arxiv.org/abs/2402.03927\\\\n    venue: EACL 2024\\\\n    verified: true\\\\n    year: 2024\\\\n  belzak2020smallsample:\\\\n    abstract: ''\\\\n    added_at: '2026-05-20T17:30:00.000Z'\\\\n    added_by: director\\\\n    authors:\\\\n    - Belzak, W.\\\\n    bibtex_key: belzak2020smallsample\\\\n    category: dif_methodology\\\\n    doi: 10.1080/00273171.2019.1671162\\\\n    relevance: Parsimonious logistic regression with sum scores outperforms complex\\\\n      IRT models for DIF detection in small samples; directly applicable to our N=50-80\\\\n      model cohorts\\\\n    role: method-component\\\\n    semantic_scholar_id: 8f13882b6f37be1ade68c40539156277e5723395\\\\n    title: Testing Differential Item Functioning in Small Samples\\\\n    url: https://www.tandfonline.com/doi/abs/10.1080/00273171.2019.1671162\\\\n    venue: Multivariate Behavioral Research\\\\n    verified: true\\\\n    year: 2020\\\\n  dekoninck2024constat:\\\\n    abstract: ''\\\\n    added_at: '2026-05-21T01:40:37.987Z'\\\\n    added_by: literature-gap-fill\\\\n    authors:\\\\n    - Dekoninck, J.\\\\n    - Mueller, M. N.\\\\n    - Vechev, M.\\\\n    bibtex_key: dekoninck2024constat\\\\n    category: contamination_detection\\\\n    doi: ''\\\\n    relevance: Performance-based contamination detection via perturbation analysis;\\\\n      closest methodological parallel to our DIF approach in using behavioral patterns\\\\n      rather than memorization signals\\\\n    role: direct-competitor\\\\n    semantic_scholar_id: ''\\\\n    title: 'ConStat: Performance-Based Contamination Detection in Large Language Models'\\\\n    url: https://arxiv.org/abs/2405.16281\\\\n    venue: NeurIPS 2024\\\\n    verified: true\\\\n    year: 2024\\\\n  golchin2024timetravel:\\\\n    abstract: ''\\\\n    added_at: '2026-05-21T01:40:37.987Z'\\\\n    added_by: literature-gap-fill\\\\n    authors:\\\\n    - Golchin, S.\\\\n    - Surdeanu, M.\\\\n    bibtex_key: golchin2024timetravel\\\\n    category: contamination_detection\\\\n    doi: ''\\\\n    relevance: Instance-level contamination detection via guided completion prompts;\\\\n      baseline approach for individual-item detection that our group-level DIF method\\\\n      extends\\\\n    role: method-component\\\\n    semantic_scholar_id: d6d0fd994f37b630f35945736b5e1bb198148404\\\\n    title: 'Time Travel in LLMs: Tracing Data Contamination in Large Language Models'\\\\n    url: https://arxiv.org/abs/2308.08493\\\\n    venue: ICLR 2024\\\\n    verified: true\\\\n    year: 2024\\\\n  hardy2026scalability:\\\\n    abstract: ''\\\\n    added_at: '2026-05-20T17:30:00.000Z'\\\\n    added_by: director\\\\n    authors:\\\\n    - Hardy, M.\\\\n    - Gilbert, J.\\\\n    - Domingue, B.\\\\n    bibtex_key: hardy2026scalability\\\\n    category: irt_equating\\\\n    doi: 10.48550/arXiv.2603.24999\\\\n    relevance: Nonparametric signed isotonic R2 scalability coefficients outperform\\\\n      IRT item diagnostics; lightweight pre-filter for item quality before our parametric\\\\n      calibration\\\\n    role: method-component\\\\n    semantic_scholar_id: ''\\\\n    title: Efficient Detection of Bad Benchmark Items with Novel Scalability Coefficients\\\\n    url: https://arxiv.org/abs/2603.24999\\\\n    venue: arXiv\\\\n    verified: true\\\\n    year: 2026\\\\n  kim2019fpc:\\\\n    abstract: ''\\\\n    added_at: '2026-05-20T17:30:00.000Z'\\\\n    added_by: director\\\\n    authors:\\\\n    - Kim, S.\\\\n    - Kolen, M.\\\\n    bibtex_key: kim2019fpc\\\\n    category: irt_equating\\\\n    doi: 10.1080/08957347.2019.1660344\\\\n    relevance: Fixed-parameter calibration requires only N>=200 vs N>=500 for full\\\\n      calibration; core methodology for our bifactor IRT equating with anchor items\\\\n    role: method-component\\\\n    semantic_scholar_id: ''\\\\n    title: Application of IRT Fixed Parameter Calibration to Multiple-Group Test Data\\\\n    url: https://www.tandfonline.com/doi/abs/10.1080/08957347.2019.1660344\\\\n    venue: Applied Measurement in Education\\\\n    verified: true\\\\n    year: 2019\\\\n  li2024contamination:\\\\n    abstract: ''\\\\n    added_at: '2026-05-21T01:40:37.987Z'\\\\n    added_by: literature-gap-fill\\\\n    authors:\\\\n    - Li, Y.\\\\n    - Guo, Y.\\\\n    - Guerin, F.\\\\n    - Lin, C.\\\\n    bibtex_key: li2024contamination\\\\n    category: contamination_detection\\\\n    doi: 10.18653/v1/2024.findings-emnlp.30\\\\n    relevance: Provides web-overlap contamination labels for MMLU and other benchmarks\\\\n      via Common Crawl matching; primary ground-truth comparison for our DIF-based\\\\n      contamination detection\\\\n    role: foundation\\\\n    semantic_scholar_id: 32e11cf020021c225782a3b77b5cfed4ae8e14a0\\\\n    title: An Open-Source Data Contamination Report for Large Language Models\\\\n    url: https://aclanthology.org/2024.findings-emnlp.30/\\\\n    venue: Findings of EMNLP 2024\\\\n    verified: true\\\\n    year: 2024\\\\n  liang2026dvd:\\\\n    abstract: ''\\\\n    added_at: '2026-05-20T17:30:00.000Z'\\\\n    added_by: director\\\\n    authors:\\\\n    - Liang, R.\\\\n    bibtex_key: liang2026dvd\\\\n    category: contamination_detection\\\\n    doi: ''\\\\n    relevance: Detects variant contamination via generation variance (AUC 0.73-0.74\\\\n      vs Min-K++ 0.43-0.68); complementary signal in our ensemble but untested under\\\\n      RL training\\\\n    role: direct-competitor\\\\n    semantic_scholar_id: ''\\\\n    title: 'DVD: Detection via Variance of Generation Distribution for Variant Contamination'\\\\n    url: https://arxiv.org/abs/2601.04895\\\\n    venue: arXiv\\\\n    verified: true\\\\n    year: 2026\\\\n  shi2024mink:\\\\n    abstract: ''\\\\n    added_at: '2026-05-21T01:40:37.987Z'\\\\n    added_by: literature-gap-fill\\\\n    authors:\\\\n    - Shi, W.\\\\n    - Ajith, A.\\\\n    - Xia, M.\\\\n    - Huang, Y.\\\\n    - Liu, D.\\\\n    - Blevins, T.\\\\n    - Chen, D.\\\\n    - Zettlemoyer, L.\\\\n    bibtex_key: shi2024mink\\\\n    category: contamination_detection\\\\n    doi: ''\\\\n    relevance: Introduces Min-K% Prob method and WikiMIA benchmark for pretraining\\\\n      data detection; key baseline whose limitations under RL training motivate our\\\\n      DIF-based alternative\\\\n    role: foundation\\\\n    semantic_scholar_id: 3422d5e0cdfdc935d6a84a1e3d3f96659265fe3a\\\\n    title: Detecting Pretraining Data from Large Language Models\\\\n    url: https://arxiv.org/abs/2310.16789\\\\n    venue: ICLR 2024\\\\n    verified: true\\\\n    year: 2024\\\\n  tao2026selfcritique:\\\\n    abstract: ''\\\\n    added_at: '2026-05-20T17:30:00.000Z'\\\\n    added_by: director\\\\n    authors:\\\\n    - Tao, Y.\\\\n    bibtex_key: tao2026selfcritique\\\\n    category: contamination_detection\\\\n    doi: ''\\\\n    relevance: Self-Critique/RL-MIA partially addresses RL concealment via policy-collapse\\\\n      detection, but remains individual-model-level; our DIF is group-level and complementary\\\\n    role: direct-competitor\\\\n    semantic_scholar_id: ''\\\\n    title: Detecting Data Contamination from Reinforcement Learning Post-training\\\\n      for Large Language Models\\\\n    url: https://arxiv.org/abs/2510.09259\\\\n    venue: ICLR 2026\\\\n    verified: true\\\\n    year: 2026\\\\n  wang2026fragility:\\\\n    abstract: ''\\\\n    added_at: '2026-05-20T17:30:00.000Z'\\\\n    added_by: director\\\\n    authors:\\\\n    - Wang, H.\\\\n    - Li, H.\\\\n    - Ko, B.\\\\n    - Zhang, H.\\\\n    bibtex_key: wang2026fragility\\\\n    category: contamination_detection\\\\n    doi: ''\\\\n    relevance: Proves GRPO/PPO RL training conceals contamination signals (14-20pp\\\\n      AUROC degradation), motivating our DIF-based approach which operates on behavioral\\\\n      patterns immune to NLL smoothing\\\\n    role: foundation\\\\n    semantic_scholar_id: 9a5bf5d3c7116cc4a104c06599fbcef2d1b5abf3\\\\n    title: On The Fragility of Benchmark Contamination Detection in Reasoning Models\\\\n    url: https://arxiv.org/abs/2510.02386\\\\n    venue: ICLR 2026\\\\n    verified: true\\\\n    year: 2026\\\\n  white2025livebench:\\\\n    abstract: ''\\\\n    added_at: '2026-05-20T17:30:00.000Z'\\\\n    added_by: director\\\\n    authors:\\\\n    - White, C.\\\\n    bibtex_key: white2025livebench\\\\n    category: benchmark_design\\\\n    doi: 10.48550/arXiv.2406.19314\\\\n    relevance: Monthly-updated contamination-free benchmark with objective scoring;\\\\n      no difficulty calibration or psychometric equivalence across updates\\\\n    role: direct-competitor\\\\n    semantic_scholar_id: 4e5d86ea8eacd341d13123852d50d1ef62738744\\\\n    title: 'LiveBench: A Challenging, Contamination-Free LLM Benchmark'\\\\n    url: https://arxiv.org/abs/2406.19314\\\\n    venue: ICLR 2025\\\\n    verified: true\\\\n    year: 2025\\\\n  zhang2024gsm1k:\\\\n    abstract: ''\\\\n    added_at: '2026-05-20T17:30:00.000Z'\\\\n    added_by: director\\\\n    authors:\\\\n    - Zhang, H.\\\\n    bibtex_key: zhang2024gsm1k\\\\n    category: contamination_detection\\\\n    doi: ''\\\\n    relevance: GSM1K documents 10-13% average accuracy drops from contamination; provides\\\\n      ground-truth contamination evidence and item-level effect sizes (delta 0.8-1.4\\\\n      logits) critical for our DIF power analysis\\\\n    role: foundation\\\\n    semantic_scholar_id: ef62f95c16f668f031d649799cbd79081c6d2b0f\\\\n    title: A Careful Examination of Large Language Model Performance on Grade School\\\\n      Arithmetic\\\\n    url: https://arxiv.org/abs/2405.00332\\\\n    venue: arXiv\\\\n    verified: true\\\\n    year: 2024\\\\n  zhang2024minkpp:\\\\n    abstract: ''\\\\n    added_at: '2026-05-21T01:40:37.987Z'\\\\n    added_by: literature-gap-fill\\\\n    authors:\\\\n    - Zhang, J.\\\\n    - Sun, J.\\\\n    - Yeats, E.\\\\n    - Ouyang, Y.\\\\n    - Kuo, M.\\\\n    - Zhang, J.\\\\n    - Yang, H.\\\\n    - Li, H.\\\\n    bibtex_key: zhang2024minkpp\\\\n    category: contamination_detection\\\\n    doi: ''\\\\n    relevance: Improves Min-K% with vocabulary-normalized token probabilities; key\\\\n      baseline whose AUC degrades to 0.43-0.68 on RL-trained models, motivating our\\\\n      DIF-based alternative\\\\n    role: direct-competitor\\\\n    semantic_scholar_id: ''\\\\n    title: 'Min-K%++: Improved Baseline for Detecting Pre-Training Data from Large\\\\n      Language Models'\\\\n    url: https://arxiv.org/abs/2404.02936\\\\n    venue: arXiv\\\\n    verified: true\\\\n    year: 2024\\\\n  lalor2019irt:\\\\n    title: 'Learning Latent Parameters without Human Response Patterns: Item Response\\\\n      Theory with Artificial Crowds'\\\\n    authors:\\\\n    - Lalor, J.\\\\n    - Wu, H.\\\\n    - Yu, H.\\\\n    year: 2019\\\\n    venue: EMNLP-IJCNLP 2019\\\\n    url: https://aclanthology.org/D19-1434/\\\\n    doi: 10.18653/v1/D19-1434\\\\n    bibtex_key: lalor2019irt\\\\n    category: irt_equating\\\\n    role: foundation\\\\n    relevance: Pioneering application of IRT to NLP evaluation using artificial crowds\\\\n      of DNN models; establishes that IRT parameters from machine response patterns\\\\n      correlate with human-calibrated parameters\\\\n    abstract: ''\\\\n    semantic_scholar_id: df6cd8a8d836e75690141deb732f6d19f0176a2e\\\\n    verified: true\\\\n    added_by: literature-gap-fill\\\\n    added_at:\\\\n\\\\n... [截断: 省略 24146 字符，传 max_chars=0 获取完整内容]\\\", \\\"total_chars\\\": 36146, \\\"truncated\\\": true}, \\\"error\\\": null, \\\"metadata\\\": {}}\"}"}]},"parent_tool_use_id":"toolu_01JcfwMvGjUNRpf6W8fNUts9","session_id":"e51e0195-9c84-4e56-b272-a71ad93d54d2","uuid":"49ca75aa-8d35-4