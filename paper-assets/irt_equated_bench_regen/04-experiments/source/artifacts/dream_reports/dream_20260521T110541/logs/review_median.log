nd saturation in artificial\\\\n      intelligence\\\\n    authors:\\\\n    - Ott, S.\\\\n    - Barbosa-Silva, A.\\\\n    - Blagec, K.\\\\n    - Brauner, J.\\\\n    - Samwald, M.\\\\n    year: 2022\\\\n    venue: Nature Communications\\\\n    url: https://www.nature.com/articles/s41467-022-34591-0\\\\n    doi: 10.1038/s41467-022-34591-0\\\\n    bibtex_key: ott2022benchmark\\\\n    category: llm_evaluation\\\\n    role: background\\\\n    relevance: Large-scale analysis of 3765 AI benchmarks showing rapid saturation\\\\n      dynamics; supports our argument that static benchmarks need psychometric equating\\\\n      and regeneration\\\\n    abstract: ''\\\\n    semantic_scholar_id: ''\\\\n    verified: true\\\\n    added_by: paper_agent\\\\n    added_at: '2026-05-21T03:50:29.780Z'\\\\n\\\", \\\"total_chars\\\": 36146, \\\"truncated\\\": false}, \\\"error\\\": null, \\\"metadata\\\": {}}\"}"}]},"parent_tool_use_id":"toolu_01L27ir7ywE9CMtHXHS3NDtC","session_id":"9a39fd00-8805-41a7-a4c4-e92500e754cb","uuid":"9e87118a-824c-40c5-99b7-42281217f48d","timestamp":"2026-05-21T11:55:36.192Z"}
