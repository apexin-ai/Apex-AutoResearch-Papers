{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011s3X17BPBNAQttLTgHeRzG","type":"tool_result","content":"{\"result\":\"{\\\"success\\\": true, \\\"data\\\": {\\\"path\\\": \\\"/home/ubuntu/.agent-ml-research-idea_gen_0520_2/projects/irt_equated_bench_regen/literature_map.yaml\\\", \\\"content\\\": \\\"meta:\\\\n  last_updated: \\\\\\\"2026-05-20T17:30:00.000Z\\\\\\\"\\\\n  total_papers: 10\\\\ncategories:\\\\n  - key: \\\\\\\"contamination_detection\\\\\\\"\\\\n    name: \\\\\\\"Benchmark Contamination Detection\\\\\\\"\\\\n    narrative: \\\\\\\"Methods for detecting training data contamination in LLM benchmarks, including RL-robust approaches\\\\\\\"\\\\n  - key: \\\\\\\"irt_equating\\\\\\\"\\\\n    name: \\\\\\\"IRT Methodology & Equating\\\\\\\"\\\\n    narrative: \\\\\\\"Item Response Theory models, calibration, equating, and their application to LLM evaluation\\\\\\\"\\\\n  - key: \\\\\\\"benchmark_design\\\\\\\"\\\\n    name: \\\\\\\"Dynamic Benchmark Design\\\\\\\"\\\\n    narrative: \\\\\\\"Approaches for creating contamination-resistant or self-updating benchmarks\\\\\\\"\\\\n  - key: \\\\\\\"dif_methodology\\\\\\\"\\\\n    name: \\\\\\\"DIF Statistical Methods\\\\\\\"\\\\n    narrative: \\\\\\\"Differential Item Functioning detection methods, power analysis, and small-sample strategies\\\\\\\"\\\\n  - key: \\\\\\\"item_generation\\\\\\\"\\\\n    name: \\\\\\\"Automated Item Generation\\\\\\\"\\\\n    narrative: \\\\\\\"LLM-based test item generation with difficulty control and psychometric validation\\\\\\\"\\\\npapers:\\\\n  wang2026fragility:\\\\n    title: \\\\\\\"On The Fragility of Benchmark Contamination Detection in Reasoning Models\\\\\\\"\\\\n    authors:\\\\n      - \\\\\\\"Wang, Y.\\\\\\\"\\\\n    year: 2026\\\\n    venue: \\\\\\\"ICLR 2026\\\\\\\"\\\\n    doi: \\\\\\\"\\\\\\\"\\\\n    url: \\\\\\\"https://arxiv.org/abs/2510.02386\\\\\\\"\\\\n    bibtex_key: \\\\\\\"wang2026fragility\\\\\\\"\\\\n    category: \\\\\\\"contamination_detection\\\\\\\"\\\\n    role: \\\\\\\"foundation\\\\\\\"\\\\n    relevance: \\\\\\\"Proves GRPO/PPO RL training conceals contamination signals (14-20pp AUROC degradation), motivating our DIF-based approach which operates on behavioral patterns immune to NLL smoothing\\\\\\\"\\\\n    abstract: \\\\\\\"\\\\\\\"\\\\n    semantic_scholar_id: \\\\\\\"\\\\\\\"\\\\n    verified: false\\\\n    added_by: \\\\\\\"director\\\\\\\"\\\\n    added_at: \\\\\\\"2026-05-20T17:30:00.000Z\\\\\\\"\\\\n  liang2026dvd:\\\\n    title: \\\\\\\"DVD: Detection via Variance of Generation Distribution for Variant Contamination\\\\\\\"\\\\n    authors:\\\\n      - \\\\\\\"Liang, Y.\\\\\\\"\\\\n    year: 2026\\\\n    venue: \\\\\\\"arXiv\\\\\\\"\\\\n    doi: \\\\\\\"\\\\\\\"\\\\n    url: \\\\\\\"https://arxiv.org/abs/2601.04895\\\\\\\"\\\\n    bibtex_key: \\\\\\\"liang2026dvd\\\\\\\"\\\\n    category: \\\\\\\"contamination_detection\\\\\\\"\\\\n    role: \\\\\\\"direct-competitor\\\\\\\"\\\\n    relevance: \\\\\\\"Detects variant contamination via generation variance (AUC 0.73-0.74 vs Min-K++ 0.43-0.68); complementary signal in our ensemble but untested under RL training\\\\\\\"\\\\n    abstract: \\\\\\\"\\\\\\\"\\\\n    semantic_scholar_id: \\\\\\\"\\\\\\\"\\\\n    verified: false\\\\n    added_by: \\\\\\\"director\\\\\\\"\\\\n    added_at: \\\\\\\"2026-05-20T17:30:00.000Z\\\\\\\"\\\\n  tao2026selfcritique:\\\\n    title: \\\\\\\"Detecting Data Contamination from Reinforcement Learning Post-training\\\\\\\"\\\\n    authors:\\\\n      - \\\\\\\"Tao, S.\\\\\\\"\\\\n    year: 2026\\\\n    venue: \\\\\\\"ICLR 2026\\\\\\\"\\\\n    doi: \\\\\\\"\\\\\\\"\\\\n    url: \\\\\\\"https://arxiv.org/abs/2510.09259\\\\\\\"\\\\n    bibtex_key: \\\\\\\"tao2026selfcritique\\\\\\\"\\\\n    category: \\\\\\\"contamination_detection\\\\\\\"\\\\n    role: \\\\\\\"direct-competitor\\\\\\\"\\\\n    relevance: \\\\\\\"Self-Critique/RL-MIA partially addresses RL concealment via policy-collapse detection, but remains individual-model-level; our DIF is group-level and complementary\\\\\\\"\\\\n    abstract: \\\\\\\"\\\\\\\"\\\\n    semantic_scholar_id: \\\\\\\"\\\\\\\"\\\\n    verified: false\\\\n    added_by: \\\\\\\"director\\\\\\\"\\\\n    added_at: \\\\\\\"2026-05-20T17:30:00.000Z\\\\\\\"\\\\n  polo2026growingpains:\\\\n    title: \\\\\\\"Growing Pains: Extensible and Efficient LLM Benchmarking Via Fixed Parameter Calibration\\\\\\\"\\\\n    authors:\\\\n      - \\\\\\\"Polo, F.\\\\\\\"\\\\n    year: 2026\\\\n    venue: \\\\\\\"arXiv\\\\\\\"\\\\n    doi: \\\\\\\"\\\\\\\"\\\\n    url: \\\\\\\"\\\\\\\"\\\\n    bibtex_key: \\\\\\\"polo2026growingpains\\\\\\\"\\\\n    category: \\\\\\\"irt_equating\\\\\\\"\\\\n    role: \\\\\\\"direct-competitor\\\\\\\"\\\\n    relevance: \\\\\\\"Uses multidimensional IRT with fixed-parameter calibration and 100 anchor items for extensible evaluation (rho>=0.9); addresses score comparability but NOT contamination detection or item regeneration\\\\\\\"\\\\n    abstract: \\\\\\\"\\\\\\\"\\\\n    semantic_scholar_id: \\\\\\\"\\\\\\\"\\\\n    verified: false\\\\n    added_by: \\\\\\\"director\\\\\\\"\\\\n    added_at: \\\\\\\"2026-05-20T17:30:00.000Z\\\\\\\"\\\\n  polo2026psnirt:\\\\n    title: \\\\\\\"Lost in Benchmarks? Rethinking Large Language Model Benchmarking with Item Response Theory\\\\\\\"\\\\n    authors:\\\\n      - \\\\\\\"Polo, F.\\\\\\\"\\\\n    year: 2026\\\\n    venue: \\\\\\\"AAAI 2026\\\\\\\"\\\\n    doi: \\\\\\\"\\\\\\\"\\\\n    url: \\\\\\\"\\\\\\\"\\\\n    bibtex_key: \\\\\\\"polo2026psnirt\\\\\\\"\\\\n    category: \\\\\\\"irt_equating\\\\\\\"\\\\n    role: \\\\\\\"method-component\\\\\\\"\\\\n    relevance: \\\\\\\"PSN-IRT analyzes benchmark quality via 4PL IRT; provides published IRT parameters for MMLU we can use in semi-synthetic validation\\\\\\\"\\\\n    abstract: \\\\\\\"\\\\\\\"\\\\n    semantic_scholar_id: \\\\\\\"\\\\\\\"\\\\n    verified: false\\\\n    added_by: \\\\\\\"director\\\\\\\"\\\\n    added_at: \\\\\\\"2026-05-20T17:30:00.000Z\\\\\\\"\\\\n  white2025livebench:\\\\n    title: \\\\\\\"LiveBench: A Challenging, Contamination-Free LLM Benchmark\\\\\\\"\\\\n    authors:\\\\n      - \\\\\\\"White, C.\\\\\\\"\\\\n    year: 2025\\\\n    venue: \\\\\\\"ICLR 2025\\\\\\\"\\\\n    doi: \\\\\\\"\\\\\\\"\\\\n    url: \\\\\\\"\\\\\\\"\\\\n    bibtex_key: \\\\\\\"white2025livebench\\\\\\\"\\\\n    category: \\\\\\\"benchmark_design\\\\\\\"\\\\n    role: \\\\\\\"direct-competitor\\\\\\\"\\\\n    relevance: \\\\\\\"Monthly-updated contamination-free benchmark with objective scoring; no difficulty calibration or psychometric equivalence across updates\\\\\\\"\\\\n    abstract: \\\\\\\"\\\\\\\"\\\\n    semantic_scholar_id: \\\\\\\"\\\\\\\"\\\\n    verified: false\\\\n    added_by: \\\\\\\"director\\\\\\\"\\\\n    added_at: \\\\\\\"2026-05-20T17:30:00.000Z\\\\\\\"\\\\n  zhang2024gsm1k:\\\\n    title: \\\\\\\"A Careful Examination of Large Language Model Performance on Grade School Arithmetic\\\\\\\"\\\\n    authors:\\\\n      - \\\\\\\"Zhang, H.\\\\\\\"\\\\n    year: 2024\\\\n    venue: \\\\\\\"arXiv\\\\\\\"\\\\n    doi: \\\\\\\"\\\\\\\"\\\\n    url: \\\\\\\"https://arxiv.org/abs/2405.00332\\\\\\\"\\\\n    bibtex_key: \\\\\\\"zhang2024gsm1k\\\\\\\"\\\\n    category: \\\\\\\"contamination_detection\\\\\\\"\\\\n    role: \\\\\\\"foundation\\\\\\\"\\\\n    relevance: \\\\\\\"GSM1K documents 10-13% average accuracy drops from contamination; provides ground-truth contamination evidence and item-level effect sizes (delta 0.8-1.4 logits) critical for our DIF power analysis\\\\\\\"\\\\n    abstract: \\\\\\\"\\\\\\\"\\\\n    semantic_scholar_id: \\\\\\\"\\\\\\\"\\\\n    verified: false\\\\n    added_by: \\\\\\\"director\\\\\\\"\\\\n    added_at: \\\\\\\"2026-05-20T17:30:00.000Z\\\\\\\"\\\\n  hardy2026scalability:\\\\n    title: \\\\\\\"Efficient Detection of Bad Benchmark Items with Novel Scalability Coefficients\\\\\\\"\\\\n    authors:\\\\n      - \\\\\\\"Hardy, M.\\\\\\\"\\\\n    year: 2026\\\\n    venue: \\\\\\\"arXiv\\\\\\\"\\\\n    doi: \\\\\\\"\\\\\\\"\\\\n    url: \\\\\\\"https://arxiv.org/abs/2603.24999\\\\\\\"\\\\n    bibtex_key: \\\\\\\"hardy2026scalability\\\\\\\"\\\\n    category: \\\\\\\"irt_equating\\\\\\\"\\\\n    role: \\\\\\\"method-component\\\\\\\"\\\\n    relevance: \\\\\\\"Nonparametric signed isotonic R2 scalability coefficients outperform IRT item diagnostics; lightweight pre-filter for item quality before our parametric calibration\\\\\\\"\\\\n    abstract: \\\\\\\"\\\\\\\"\\\\n    semantic_scholar_id: \\\\\\\"\\\\\\\"\\\\n    verified: false\\\\n    added_by: \\\\\\\"director\\\\\\\"\\\\n    added_at: \\\\\\\"2026-05-20T17:30:00.000Z\\\\\\\"\\\\n  kim2019fpc:\\\\n    title: \\\\\\\"Application of IRT Fixed Parameter Calibration to Multiple-Group Test Data\\\\\\\"\\\\n    authors:\\\\n      - \\\\\\\"Kim, S.\\\\\\\"\\\\n      - \\\\\\\"Kolen, M.\\\\\\\"\\\\n    year: 2019\\\\n    venue: \\\\\\\"Applied Measurement in Education\\\\\\\"\\\\n    doi: \\\\\\\"\\\\\\\"\\\\n    url: \\\\\\\"\\\\\\\"\\\\n    bibtex_key: \\\\\\\"kim2019fpc\\\\\\\"\\\\n    category: \\\\\\\"irt_equating\\\\\\\"\\\\n    role: \\\\\\\"method-component\\\\\\\"\\\\n    relevance: \\\\\\\"Fixed-parameter calibration requires only N>=200 vs N>=500 for full calibration; core methodology for our bifactor IRT equating with anchor items\\\\\\\"\\\\n    abstract: \\\\\\\"\\\\\\\"\\\\n    semantic_scholar_id: \\\\\\\"\\\\\\\"\\\\n    verified: false\\\\n    added_by: \\\\\\\"director\\\\\\\"\\\\n    added_at: \\\\\\\"2026-05-20T17:30:00.000Z\\\\\\\"\\\\n  belzak2020smallsample:\\\\n    title: \\\\\\\"Testing Differential Item Functioning in Small Samples\\\\\\\"\\\\n    authors:\\\\n      - \\\\\\\"Belzak, W.\\\\\\\"\\\\n    year: 2020\\\\n    venue: \\\\\\\"Multivariate Behavioral Research\\\\\\\"\\\\n    doi: \\\\\\\"\\\\\\\"\\\\n    url: \\\\\\\"\\\\\\\"\\\\n    bibtex_key: \\\\\\\"belzak2020smallsample\\\\\\\"\\\\n    category: \\\\\\\"dif_methodology\\\\\\\"\\\\n    role: \\\\\\\"method-component\\\\\\\"\\\\n    relevance: \\\\\\\"Parsimonious logistic regression with sum scores outperforms complex IRT models for DIF detection in small samples; directly applicable to our N=50-80 model cohorts\\\\\\\"\\\\n    abstract: \\\\\\\"\\\\\\\"\\\\n    semantic_scholar_id: \\\\\\\"\\\\\\\"\\\\n    verified: false\\\\n    added_by: \\\\\\\"director\\\\\\\"\\\\n    added_at: \\\\\\\"2026-05-20T17:30:00.000Z\\\\\\\"\\\\n\\\", \\\"total_chars\\\": 7312, \\\"truncated\\\": false}, \\\"error\\\": null, \\\"metadata\\\": {}}\"}"}]},"parent_tool_use_id":"toolu_01BQBBKoi6bR9NoZyK5Y3G3r","session_id":"570af1f9-c3cd-4db4-aa61-2d20e9ee2d29","uuid":"65e2ecfc-d7c4-4792-ba23-c0c1c5199784","timestamp":"2026-05-20T20:29:39.821Z"}
