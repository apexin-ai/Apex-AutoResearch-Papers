n compressed benchmark items\\\\n    abstract: ''\\\\n    semantic_scholar_id: dfd5186def202285a0f23cd3f08415a5780895c1\\\\n    verified: true\\\\n    added_by: literature-gap-fill\\\\n    added_at: '2026-05-21T03:43:39.896Z'\\\\n  hendrycks2021mmlu:\\\\n    title: Measuring Massive Multitask Language Understanding\\\\n    authors:\\\\n    - Hendrycks, D.\\\\n    - Burns, C.\\\\n    - Basart, S.\\\\n    - Zou, A.\\\\n    - Mazeika, M.\\\\n    - Song, D.\\\\n    - Steinhardt, J.\\\\n    year: 2021\\\\n    venue: ICLR 2021\\\\n    url: https://arxiv.org/abs/2009.03300\\\\n    doi: ''\\\\n    bibtex_key: hendrycks2021mmlu\\\\n    category: benchmark_design\\\\n    role: foundation\\\\n    relevance: Seminal 57-subject benchmark for LLM evaluation; primary benchmark\\\\n      in our DIF analysis due to documented contamination and available IRT parameters\\\\n    abstract: ''\\\\n    semantic_scholar_id: 814a4f680b9ba6baba23b93499f4b48af1a27678\\\\n    verified: true\\\\n    added_by: literature-gap-fill\\\\n    added_at: '2026-05-21T03:43:39.896Z'\\\\n  liang2023helm:\\\\n    title: Holistic Evaluation of Language Models\\\\n    authors:\\\\n    - Liang, P.\\\\n    - Bommasani, R.\\\\n    - Lee, T.\\\\n    - Tsipras, D.\\\\n    - Soylu, D.\\\\n    - Yasunaga, M.\\\\n    - Zhang, Y.\\\\n    - Narayanan, D.\\\\n    - Wu, Y.\\\\n    - Kumar, A.\\\\n    year: 2023\\\\n    venue: TMLR 2023\\\\n    url: https://arxiv.org/abs/2211.09110\\\\n    doi: 10.1111/nyas.15007\\\\n    bibtex_key: liang2023helm\\\\n    category: benchmark_design\\\\n    role: foundation\\\\n    relevance: Holistic multi-metric evaluation framework covering accuracy, calibration,\\\\n      robustness, fairness, and bias; establishes multi-dimensional evaluation philosophy\\\\n      complementary to our psychometric approach\\\\n    abstract: ''\\\\n    semantic_scholar_id: ce913026f693101e54d3ab9152e107034d81fce1\\\\n    verified: true\\\\n    added_by: literature-gap-fill\\\\n    added_at: '2026-05-21T