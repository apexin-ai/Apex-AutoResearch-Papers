   authors:\\\\n    - Burnell, R.\\\\n    - Schellaert, W.\\\\n    - Burden, J.\\\\n    - Ullman, T.D.\\\\n    - Martinez-Plumed, F.\\\\n    - Tenenbaum, J.B.\\\\n    - Rutar, D.\\\\n    - Cheke, L.G.\\\\n    - Sohl-Dickstein, J.\\\\n    - Mitchell, M.\\\\n    - Kiela, D.\\\\n    - Shanahan, M.\\\\n    - Voorhees, E.M.\\\\n    - Cohn, A.G.\\\\n    - Leibo, J.Z.\\\\n    - Hernandez-Orallo, J.\\\\n    year: 2023\\\\n    venue: Science\\\\n    url: https://www.science.org/doi/10.1126/science.adf6369\\\\n    doi: 10.1126/science.adf6369\\\\n    bibtex_key: burnell2023rethink\\\\n    category: llm_evaluation\\\\n    role: background\\\\n    relevance: Argues that aggregate metrics and lack of item-level transparency in\\\\n      AI evaluation limit understanding of model capabilities; motivates psychometric\\\\n      item-level analysis\\\\n    abstract: ''\\\\n    semantic_scholar_id: ''\\\\n    verified: true\\\\n    added_by: paper_agent\\\\n    added_at: '2026-05-21T03:50:29.780Z'\\\\n  chang2024survey:\\\\n    title: A Survey on Evaluation of Large Language Models\\\\n    authors:\\\\n    - Chang, Y.\\\\n    - Wang, X.\\\\n    - Wang, J.\\\\n    - Wu, Y.\\\\n    - Zhu, K.\\\\n    - Chen, H.\\\\n    - Yang, L.\\\\n    - Yi, X.\\\\n    - Wang, C.\\\\n    - Wang, Y.\\\\n    - Ye, W.\\\\n    - Zhang, Y.\\\\n    - Chang, Y.\\\\n    - Yu, P.S.\\\\n    - Yang, Q.\\\\n    - Xie, X.\\\\n    year: 2024\\\\n    venue: ACM Transactions on Intelligent Systems and Technology\\\\n    url: https://dl.acm.org/doi/full/10.1145/3641289\\\\n    doi: 10.1145/3641289\\\\n    bibtex_key: chang2024survey\\\\n    category: llm_evaluation\\\\n    role: background\\\\n    relevance: Comprehensive survey covering what/where/how to evaluate LLMs across\\\\n      tasks and societal dimensions; provides landscape context for our psychometric\\\\n      evaluation approach\\\\n    abstract: ''\\\\n    semantic_scholar_id: ''\\\\n    verified: true\\\\n    added_by: paper_agent\\\\n    added_at: '2026-05-21T03:50:29.780Z'\\\\n  maiapolo2024tinybenchmarks:\\\\n    title: 'tinyBenchmarks: evaluating LLMs with fewer examples'\\\\n    authors:\\\\n    - Maia Polo, F.\\\\n    - Weber, L.\\\\n    - Choshen, L.\\\\n    - Sun, Y.\\\\n    - Xu, G.\\\\n    - Yurochkin, M.\\\\n    year: 2024\\\\n    venue: ICML 2024\\\\n    url: https://proceedings.mlr.press/v235/maia-polo24a.html\\\\n    doi: ''\\\\n    bibtex_key: maiapolo2024tinybenchmarks\\\\n    category: llm_evaluation\\\\n    role: direct-competitor\\\\n    relevance: Uses IRT to select representative benchmark subsets for efficient LLM\\\\n      evaluation with 100 items approximating full MMLU; directly related to our IRT-based\\\\n      equating methodology\\\\n    abstract: ''\\\\n    semantic_scholar_id: ''\\\\n    verified: true\\\\n    added_by: paper_agent\\\\n    added_at: '2026-05-21T03:50:29.780Z'\\\\n  wang2024mmlupro:\\\\n    title: 'MMLU-Pro: A More Robust and Challenging Multi-Task Language Understanding\\\\n      Benchmark'\\\\n    authors:\\\\n    - Wang, Y.\\\\n    - Ma, X.\\\\n    - Zhang, G.\\\\n    - Ni, Y.\\\\n    - Chandra, A.\\\\n    - Guo, S.\\\\n    - Ren, W.\\\\n    - Arulraj, A.\\\\n    - He, X.\\\\n    - Jiang, Z.\\\\n    - Li, T.\\\\n    - Ku, M.\\\\n    - Wang, K.\\\\n    - Zhuang, A.\\\\n    - Fan, R.\\\\n    - Xue, X.\\\\n    - Chen, W.\\\\n    year: 2024\\\\n    venue: NeurIPS 2024\\\\n    url: https://arxiv.org/abs/2406.01574\\\\n    doi: ''\\\\n    bibtex_key: wang2024mmlupro\\\\n    category: llm_evaluation\\\\n    role: evaluation\\\\n    relevance: Extends MMLU with harder reasoning items and 10-option format causing\\\\n      16-33% accuracy drop; demonstrates benchmark evolution that motivates psychometric\\\\n      equating across versions\\\\n    abstract: ''\\\\n    semantic_scholar_id: ''\\\\n    verified: true\\\\n    added_by: paper_agent\\\\n    added_at: '2026-05-21T03:50:29.780Z'\\\\n  ott2022benchmark:\\\\n    title: Mapping global dynamics of benchmark creation and saturation in artificial\\\\n      intelligence\\\\n    authors:\\\\n    - Ott, S.\\\\n    - Barbosa-Silva, A.\\\\n    - Blagec, K.\\\\n    - Brauner, J.\\\\n    - Samwald, M.\\\\n    year: 2022\\\\n    venue: Nature Communications\\\\n    url: https://www.nature.com/articles/s41467-022-34591-0\\\\n    doi: 10.1038/s41467-022-34591-0\\\\n    bibtex_key: ott2022benchmark\\\\n    category: llm_evaluation\\\\n    role: background\\\\n    relevance: Large-scale analysis of 3765 AI benchmarks showing rapid saturation\\\\n      dynamics; supports our argument that static benchmarks need psychometric equating\\\\n      and regeneration\\\\n    abstract: ''\\\\n    semantic_scholar_id: ''\\\\n    verified: true\\\\n    added_by: paper_agent\\\\n    added_at: '2026-05-21T03:50:29.780Z'\\\\n\\\", \\\"total_chars\\\": 36146, \\\"truncated\\\": false}, \\\"error\\\": null, \\\"metadata\\\": {}}\"}"}]},"parent_tool_use_id":"toolu_01PuS8GmEM35MEC2eKYJqRo8","session_id":"bb24cef7-36bb-4a79-8344-c199f758081c","uuid":"34adbaf3-2f7d-4bac-83f0-800a4e8435b1","timestamp":"2026-05-21T15:14:51.014Z"}
