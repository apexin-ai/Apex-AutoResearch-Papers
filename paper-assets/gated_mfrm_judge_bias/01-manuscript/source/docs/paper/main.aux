\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Ranking accuracy (Kendall $\tau $ against Chatbot Arena) as a function of exposure coverage. G-MFRM over-correction decreases across all three coverage levels ($\Delta \tau $: $-0.044 \to -0.015 \to 0.000$). At full coverage, G-MFRM matches the raw average exactly; the pilot ($N = 8$) suggests positive $\Delta \tau $ when coverage is adequate. All seven baselines (MFRM-only, Sequential, CyclicJudge, DCR Factor, Pref.\ Leakage) produce $\tau $ within 0.015 of the raw average at both panel sizes. $^{\dagger }$Bootstrap $\Delta \tau $ CI includes zero.}}{6}{table.caption.16}\protected@file@percent }
\newlabel{tab:main_results}{{1}{6}{Ranking accuracy (Kendall $\tau $ against Chatbot Arena) as a function of exposure coverage. G-MFRM over-correction decreases across all three coverage levels ($\Delta \tau $: $-0.044 \to -0.015 \to 0.000$). At full coverage, G-MFRM matches the raw average exactly; the pilot ($N = 8$) suggests positive $\Delta \tau $ when coverage is adequate. All seven baselines (MFRM-only, Sequential, CyclicJudge, DCR Factor, Pref.\ Leakage) produce $\tau $ within 0.015 of the raw average at both panel sizes. $^{\dagger }$Bootstrap $\Delta \tau $ CI includes zero}{table.caption.16}{}}
