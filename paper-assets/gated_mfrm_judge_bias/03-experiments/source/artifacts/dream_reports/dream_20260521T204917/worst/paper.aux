\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces Contamination magnitude calibration. Real data ($\bar  {c} = 0.14$) falls far below the synthetic weak scenario ($\bar  {c} = 0.50$). $\theta $-RMSE degradation from confounding is only 2.1\% (vs.\ 43.8\% in the strong synthetic scenario). Sequential bias scatter $r = 0.11$, indicating near-zero systematic bias.}}{5}{table.caption.11}\protected@file@percent }
\newlabel{tab:calibration}{{7}{5}{Contamination magnitude calibration. Real data ($\bar {c} = 0.14$) falls far below the synthetic weak scenario ($\bar {c} = 0.50$). $\theta $-RMSE degradation from confounding is only 2.1\% (vs.\ 43.8\% in the strong synthetic scenario). Sequential bias scatter $r = 0.11$, indicating near-zero systematic bias}{table.caption.11}{}}
\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces Facet fit summary (infit MNSQ). Judge severity ($d$) has excellent fit (0 misfit, narrow range). Contamination ($c$) shows high misfit rate (22.7\%) and wide infit range, consistent with $c_n$ being prior-dominated rather than data-driven.}}{5}{table.caption.12}\protected@file@percent }
\newlabel{tab:fit_diag}{{8}{5}{Facet fit summary (infit MNSQ). Judge severity ($d$) has excellent fit (0 misfit, narrow range). Contamination ($c$) shows high misfit rate (22.7\%) and wide infit range, consistent with $c_n$ being prior-dominated rather than data-driven}{table.caption.12}{}}
