\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Overview of three findings. \textbf  {(a)}~Action-collapsed safety: Pi0+A1 reports 91.5\% CAR, but 99.6\% of safe episodes have displacement ${<}\,0.1$\,mm; dfCAR drops to ${\approx }\,0$\%. \textbf  {(b)}~EE-only SDF fails: SDF gradient repels the end-effector (EE) but rotates unmonitored arm links into obstacles; all oracle variants underperform unrefined baselines on collapsed models, and Oracle-adaptive also degrades the non-collapsed Pi0.5 LoRA baseline. \textbf  {(c)}~Data drives safety: collision-free demonstrations account for $+$26\,pp CAR; SDF supervision adds only $+$2.2\,pp ($p = 0.155$, n.s.).}}{2}{figure.1}\protected@file@percent }
\newlabel{fig:overview}{{1}{2}{Overview of three findings. \textbf {(a)}~Action-collapsed safety: Pi0+A1 reports 91.5\% CAR, but 99.6\% of safe episodes have displacement ${<}\,0.1$\,mm; dfCAR drops to ${\approx }\,0$\%. \textbf {(b)}~EE-only SDF fails: SDF gradient repels the end-effector (EE) but rotates unmonitored arm links into obstacles; all oracle variants underperform unrefined baselines on collapsed models, and Oracle-adaptive also degrades the non-collapsed Pi0.5 LoRA baseline. \textbf {(c)}~Data drives safety: collision-free demonstrations account for $+$26\,pp CAR; SDF supervision adds only $+$2.2\,pp ($p = 0.155$, n.s.)}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces The action-collapsed safety problem in VLA collision avoidance evaluation. Standard CAR classifies an action-collapsed robot as safe because it produces zero collisions (left). dfCAR filters out action-collapsed episodes where displacement falls below $\tau _d$; Pi0+A1's 91.5\% safety score drops to ${\approx }$\,0\% (center). Pi0.5 exhibits genuine avoidance with active motion above 288\,mm in all safe episodes, and dfCAR equals raw CAR (right).}}{2}{figure.2}\protected@file@percent }
\newlabel{fig:teaser}{{2}{2}{The action-collapsed safety problem in VLA collision avoidance evaluation. Standard CAR classifies an action-collapsed robot as safe because it produces zero collisions (left). dfCAR filters out action-collapsed episodes where displacement falls below $\tau _d$; Pi0+A1's 91.5\% safety score drops to ${\approx }$\,0\% (center). Pi0.5 exhibits genuine avoidance with active motion above 288\,mm in all safe episodes, and dfCAR equals raw CAR (right)}{figure.2}{}}
