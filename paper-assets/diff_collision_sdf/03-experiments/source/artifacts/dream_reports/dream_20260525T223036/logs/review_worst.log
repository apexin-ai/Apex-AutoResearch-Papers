{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PVfFDJi2S4mEqRH6zCLpMv","type":"tool_result","content":"1\t\"\"\"\n2\tA1-Pi0.5: Pi0.5 + SDF auxiliary task training via openpi train_loop hooks.\n3\t\n4\tForked from train_a1_sdf_aux.py (Pi0 version). Key differences:\n5\t  - Model: Pi0Config(pi05=True, action_horizon=10, discrete_state_input=False)\n6\t  - Weights: pi05_libero checkpoint (not pi0_base)\n7\t  - lambda_sdf default: 0.005 (reduced from 0.1 to avoid action collapse per M030)\n8\t  - action_horizon: 10 tokens (Pi0=50), affects mean pooling granularity for SDFDecoder\n9\t\n10\tArchitecture: Pi0.5 shares PI0Pytorch class (pi05=True flag). Action Expert is identical\n11\t(gemma_300m, width=1024), so action_out_proj hook, SDFDecoder, EEExtractor, and LoRA\n12\tinjection work without modification.\n13\t\n14\tDependencies:\n15\t  - openpi (sys.path: ../openpi/src)\n16\t  - colliforce.sdf_decoder, colliforce.ee_extractor, colliforce.lora_utils\n17\t  - scripts.train_pytorch (TrainHooks, train_loop)\n18\t\n19\tInput: SafeLIBERO scene data + SDF ground truth\n20\tOutput: Checkpoint with LoRA params + sdf_decoder.pt + ee_extractor.pt\n21\t\n22\tUsage:\n23\t    python scripts/train_a1_sdf_aux_pi05.py --scene spatial_bowl --dry_run\n24\t    python scripts/train_a1_sdf_aux_pi05.py --scene spatial_bowl --seed 0 --gpu 0\n25\t\"\"\"\n26\timport argparse\n27\timport logging\n28\timport os\n29\timport sys\n30\t\n31\timport numpy as np\n32\timport torch\n33\timport torch.nn.functional as F\n34\t\n35\tsys.path.insert(0, os.path.join(os.path.dirname(__file__), \"..\", \"openpi\"))\n36\tsys.path.insert(0, os.path.join(os.path.dirname(__file__), \"..\", \"openpi\", \"src\"))\n37\tsys.path.insert(0, os.path.join(os.path.dirname(__file__), \"..\"))\n38\t\n39\tos.environ[\"HF_LEROBOT_HOME\"] = \"/root/autodl-tmp/colliforce_data\"\n40\t\n41\timport openpi.models.pi0_config as pi0_config\n42\timport openpi.training.config as _config\n43\tfrom openpi.training.optimizer import CosineDecaySchedule\n44\tfrom openpi.training.config import AssetsConfig\n45\t\n46\tfrom colliforce.sdf_decoder import SDFDecoder, compute_sdf_loss\n47\tfrom colliforce.ee_extractor import EEPositionExtractor\n48\tfrom colliforce.lora_utils import inject_lora_pi0\n49\tfrom scripts.train_pytorch import TrainHooks, train_loop\n50\t\n51\t\n52\tSCENE_CONFIG = {\n53\t    \"spatial_bowl\": {\n54\t        \"description\": \"SafeLIBERO Spatial: bowl between plate and ramekin\",\n55\t        \"data_subdir\": \"safelibero_spatial\",\n56\t        \"sdf_gt\": \"/root/colliforce-vla/data/sdf_gt_spatial_bowl.npz\",\n57\t        \"assets_dir\": \"/root/colliforce-vla/assets/baseline_spatial_bowl\",\n58\t    },\n59\t    \"object_pudding\": {\n60\t        \"description\": \"SafeLIBERO Object: pick chocolate pudding into basket\",\n61\t        \"data_subdir\": \"safelibero_object\",\n62\t        \"sdf_gt\": \"/root/colliforce-vla/data/sdf_gt_object_chocolate.npz\",\n63\t        \"assets_dir\": \"/root/colliforce-vla/assets/baseline_object_pudding\",\n64\t    },\n65\t}\n66\t\n67\tCHECKPOINT_BASE = \"/root/autodl-tmp/checkpoints\"\n68\tDATA_BASE = \"/root/autodl-tmp/colliforce_data\"\n69\tWEIGHTS_BASE = \"/root/autodl-tmp/openpi_weights\"\n70\t\n71\t\n72\tdef parse_args():\n73\t    p = argparse.ArgumentParser(description=\"A1-Pi0.5: Pi0.5 + SDF auxiliary task via hooks\")\n74\t    p.add_argument(\"--scene\", type=str, required=True, choices=list(SCENE_CONFIG.keys()))\n75\t    p.add_argument(\"--seed\", type=int, default=0)\n76\t    p.add_argument(\"--gpu\", type=int, default=3)\n77\t    p.add_argument(\"--batch_size\", type=int, default=32)\n78\t    p.add_argument(\"--num_train_steps\", type=int, default=30000)\n79\t    p.add_argument(\"--lr\", type=float, default=2.5e-5)\n80\t    p.add_argument(\"--save_interval\", type=int, default=2000)\n81\t    p.add_argument(\"--log_interval\", type=int, default=100)\n82\t    p.add_argument(\"--exp_name\", type=str, default=None)\n83\t    p.add_argument(\"--dry_run\", action=\"store_true\")\n84\t    p.add_argument(\"--resume\", action=\"store_true\")\n85\t    p.add_argument(\"--lambda_sdf\", type=float, default=0.005,\n86\t                   help=\"SDF loss weight (default 0.005, reduced from Pi0's 0.1 to avoid action collapse)\")\n87\t    p.add_argument(\"--lambda_sdf_phase2\", type=float, default=None,\n88\t                   help=\"SDF loss weight for Phase 2 (step >= phase1_steps). If None, uses --lambda_sdf throughout.\")\n89\t    p.add_argument(\"--lambda_ee\", type=float, default=0.01)\n90\t    p.add_argument(\"--n_query_points\", type=int, default=64)\n91\t    p.add_argument(\"--sdf_clamp\", type=float, default=0.05)\n92\t    p.add_argument(\"--eikonal_weight\", type=float, default=0.1)\n93\t    p.add_argument(\"--warmup_phase_steps\", type=int, default=5000)\n94\t    return p.parse_args()\n95\t\n96\t\n97\tclass SuffixOutHook:\n98\t    \"\"\"Captures input to action_out_proj (= suffix_out after slicing).\"\"\"\n99\t    def __init__(self):\n100\t        self.features = None"}]},"parent_tool_use_id":"toolu_015zhreRCQYFUhgnkByEUWzp","session_id":"82fe1c25-39c0-4259-b5cc-ba16f1a4fb53","uuid":"b58a0d6c-b0da-435e-baba-fb8d8f5dbdeb","timestamp":"2026-05-25T23:20:27.505Z"}
