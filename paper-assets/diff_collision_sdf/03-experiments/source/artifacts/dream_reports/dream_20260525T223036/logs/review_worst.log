{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HxWwDyqe21tPtKWTUn9tUk","type":"tool_result","content":"100\t        self.features = None\n101\t\n102\t    def __call__(self, module, input, output):\n103\t        self.features = input[0]  # [B, action_horizon, 1024]\n104\t\n105\t\n106\tdef load_sdf_gt(path, device):\n107\t    data = np.load(path)\n108\t    query_points = torch.tensor(data[\"query_points\"], dtype=torch.float32, device=device)\n109\t    sdf_values = torch.tensor(data[\"sdf_values\"], dtype=torch.float32, device=device)\n110\t    return query_points, sdf_values\n111\t\n112\t\n113\tdef sample_sdf_batch(query_points, sdf_values, batch_size, n_query):\n114\t    indices = torch.randint(0, len(query_points), (n_query,), device=query_points.device)\n115\t    pts = query_points[indices].unsqueeze(0).expand(batch_size, -1, -1)\n116\t    sdf = sdf_values[indices].unsqueeze(0).expand(batch_size, -1)\n117\t    return pts, sdf\n118\t\n119\t\n120\tclass SdfAuxHooks(TrainHooks):\n121\t    def __init__(self, args):\n122\t        self.args = args\n123\t        self.phase = 1\n124\t        self.warmup_phase_steps = args.warmup_phase_steps\n125\t        self.lambda_sdf = args.lambda_sdf\n126\t        self.lambda_sdf_phase2 = args.lambda_sdf_phase2 if args.lambda_sdf_phase2 is not None else args.lambda_sdf\n127\t        self.lambda_ee = args.lambda_ee\n128\t        self.n_query_points = args.n_query_points\n129\t\n130\t        self.sdf_decoder = SDFDecoder(feature_dim=1024, hidden_dim=256)\n131\t        self.ee_extractor = EEPositionExtractor(feature_dim=1024, hidden_dim=256)\n132\t\n133\t        self.suffix_hook = SuffixOutHook()\n134\t        self.hook_handle = None\n135\t        self.sdf_query = None\n136\t        self.sdf_values = None\n137\t\n138\t    def on_model_created(self, model, device):\n139\t        _m = model.module if hasattr(model, \"module\") else model\n140\t        self.hook_handle = _m.action_out_proj.register_forward_hook(self.suffix_hook)\n141\t\n142\t        self.sdf_decoder = self.sdf_decoder.to(device)\n143\t        self.ee_extractor = self.ee_extractor.to(device)\n144\t\n145\t        scene_cfg = SCENE_CONFIG[self.args.scene]\n146\t        self.sdf_query, self.sdf_values = load_sdf_gt(scene_cfg[\"sdf_gt\"], device)\n147\t        logging.info(\"SDF GT loaded: %d points\", len(self.sdf_query))\n148\t\n149\t        # Freeze ALL backbone params\n150\t        for p in _m.parameters():\n151\t            p.requires_grad = False\n152\t\n153\t        # Inject LoRA (initially frozen for Phase 1)\n154\t        self.lora_params, self._pali_lora_params, self._expert_lora_params = inject_lora_pi0(\n155\t            _m, pali_rank=16, pali_alpha=16.0, expert_rank=32, expert_alpha=32.0)\n156\t        for p in self.lora_params:\n157\t            p.requires_grad = False\n158\t\n159\t        # Unfreeze aux modules\n160\t        for p in self.sdf_decoder.parameters():\n161\t            p.requires_grad = True\n162\t        for p in self.ee_extractor.parameters():\n163\t            p.requires_grad = True\n164\t\n165\t        n_backbone = sum(p.numel() for p in _m.parameters())\n166\t        n_lora = sum(p.numel() for p in self.lora_params)\n167\t        n_sdf = sum(p.numel() for p in self.sdf_decoder.parameters())\n168\t        n_ee = sum(p.numel() for p in self.ee_extractor.parameters())\n169\t        logging.info(\"=== A1-Pi0.5 SDF Aux Hooks ===\")\n170\t        logging.info(\"  Backbone params (incl. LoRA weights): %.2fM\", n_backbone / 1e6)\n171\t        logging.info(\"  LoRA PaliGemma (rank=16): %.2fM\",\n172\t                     sum(p.numel() for p in self._pali_lora_params) / 1e6)\n173\t        logging.info(\"  LoRA Action Expert (rank=32): %.2fM\",\n174\t                     sum(p.numel() for p in self._expert_lora_params) / 1e6)\n175\t        logging.info(\"  LoRA total (frozen for Phase 1): %.2fM\", n_lora / 1e6)\n176\t        logging.info(\"  Phase 1: SDF decoder (%d) + EE extractor (%d) trainable\",\n177\t                     n_sdf, n_ee)\n178\t        logging.info(\"  Phase 2: + LoRA (%.2fM) will be unfrozen\", n_lora / 1e6)\n179\t\n180\t    def extra_params(self):\n181\t        return list(self.sdf_decoder.parameters()) + list(self.ee_extractor.parameters())\n182\t\n183\t    def on_step_start(self, global_step, model):\n184\t        if global_step == self.warmup_phase_steps and self.phase == 1:\n185\t            self.phase = 2\n186\t            self._phase2_start = global_step\n187\t            self._lora_warmup_steps = 100\n188\t            self._lora_warmup_scale = 0.0\n189\t            self._lora_grad_hooks = []\n190\t            n_unfrozen = 0\n191\t            for p in self.lora_params:\n192\t                p.requires_grad = True\n193\t                n_unfrozen += p.numel()\n194\t                h = p.register_hook(lambda grad, s=self: grad * s._lora_warmup_scale)\n195\t                self._lora_grad_hooks.append(h)\n196\t            n_total_trainable = n_unfrozen\n197\t            for p in self.sdf_decoder.parameters():\n198\t                n_total_trainable += p.numel()\n199\t            for p in self.ee_extractor.parameters():\n200\t                n_total_trainable += p.numel()\n201\t            logging.info(\n202\t                \"Phase 2: unfroze %d LoRA params at step %d (total trainable: %d, LoRA grad warmup: %d steps)\",\n203\t                n_unfrozen, global_step, n_total_trainable, self._lora_warmup_steps,\n204\t            )\n205\t            if self.lambda_sdf != self.lambda_sdf_phase2:\n206\t                logging.info(\n207\t                    \"[Phase 2] Switching lambda_sdf: %.4f -> %.4f\",\n208\t                    self.lambda_sdf, self.lambda_sdf_phase2,\n209\t                )\n210\t\n211\t        if self.phase == 2 and hasattr(self, '_phase2_start'):\n212\t            steps_in = global_step - self._phase2_start\n213\t            if steps_in < self._lora_warmup_steps:\n214\t                self._lora_warmup_scale = (steps_in + 1) / self._lora_warmup_steps\n215\t            elif hasattr(self, '_lora_grad_hooks') and self._lora_grad_hooks:\n216\t                for h in self._lora_grad_hooks:\n217\t                    h.remove()\n218\t                self._lora_grad_hooks = []\n219\t                self._lora_warmup_scale = 1.0\n220\t                logging.info(\"LoRA gradient warmup complete at step %d\", global_step)\n221\t\n222\t        # Param verification for first 100 steps\n223\t        if global_step < 100 and global_step % 10 == 0:\n224\t            _m = model.module if hasattr(model, \"module\") else model\n225\t            trainable = {n: p.numel() for n, p in _m.named_parameters() if p.requires_grad}\n226\t            aux_trainable = sum(p.numel() for p in self.sdf_decoder.parameters() if p.requires_grad) + \\\n227\t                           sum(p.numel() for p in self.ee_extractor.parameters() if p.requires_grad)\n228\t            print(f\"[Step {global_step}] Trainable params: {sum(trainable.values()) + aux_trainable:,}\")\n229\t            print(f\"[Step {global_step}] LoRA params: {sum(v for n, v in trainable.items() if 'lora' in n):,}\")\n230\t\n231\t    def on_loss_computed(self, action_loss, model, observation, global_step):\n232\t        features = self.suffix_hook.features\n233\t        if features is None:\n234\t            return action_loss, {}\n235\t\n236\t        pooled = features.mean(dim=1)  # [B, 1024]\n237\t        if self.phase == 1:\n238\t            pooled = pooled.detach()\n239\t\n240\t        B = pooled.shape[0]\n241\t        query_pts, gt_sdf = sample_sdf_batch(\n242\t            self.sdf_query, self.sdf_values, B, self.n_query_points\n243\t        )\n244\t        pred_sdf, grad_sdf = self.sdf_decoder(pooled, query_pts, return_gradients=True)\n245\t        sdf_losses = compute_sdf_loss(\n246\t            pred_sdf, gt_sdf, grad_sdf,\n247\t            clamp_delta=self.args.sdf_clamp,\n248\t            eikonal_weight=self.args.eikonal_weight,\n249\t        )"}]},"parent_tool_use_id":"toolu_015zhreRCQYFUhgnkByEUWzp","session_id":"82fe1c25-39c0-4259-b5cc-ba16f1a4fb53","uuid":"ab339f04-bf8b-4f80-9fa5-a74124be54c7","timestamp":"2026-05-25T23:20:31.033Z"}
