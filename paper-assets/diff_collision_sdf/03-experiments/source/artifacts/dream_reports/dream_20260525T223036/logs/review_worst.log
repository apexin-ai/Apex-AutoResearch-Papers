{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012c3EmUardaWsj3g1aj4VEP","type":"tool_result","content":"100\t    parser.add_argument(\"--max_steps\", type=int, default=300)\n101\t    parser.add_argument(\"--seed\", type=int, default=0)\n102\t    parser.add_argument(\"--gpu\", type=int, default=0)\n103\t    parser.add_argument(\"--save_dir\", type=str, default=\"/root/autodl-tmp/eval_results\")\n104\t    parser.add_argument(\"--save_videos\", action=\"store_true\")\n105\t    parser.add_argument(\"--verbose\", action=\"store_true\")\n106\t    return parser.parse_args()\n107\t\n108\t\n109\tdef get_obstacle_positions(sim, obstacle_names):\n110\t    \"\"\"Get current positions of all obstacle objects from MuJoCo sim.\"\"\"\n111\t    positions = {}\n112\t    for name in obstacle_names:\n113\t        try:\n114\t            body_id = sim.model.body_name2id(name + \"_main\")\n115\t            pos = sim.data.body_xpos[body_id].copy()\n116\t            positions[name] = pos\n117\t        except Exception:\n118\t            try:\n119\t                joint_name = name + \"_jnt0\"\n120\t                joint_id = sim.model.joint_name2id(joint_name)\n121\t                qpos_addr = sim.model.jnt_qposadr[joint_id]\n122\t                pos = sim.data.qpos[qpos_addr:qpos_addr + 3].copy()\n123\t                positions[name] = pos\n124\t            except Exception:\n125\t                pass\n126\t    return positions\n127\t\n128\t\n129\tdef check_collision(initial_positions, current_positions, threshold=COLLISION_THRESHOLD):\n130\t    \"\"\"Check if any obstacle has been displaced beyond threshold.\"\"\"\n131\t    for name in initial_positions:\n132\t        if name in current_positions:\n133\t            displacement = np.linalg.norm(\n134\t                current_positions[name] - initial_positions[name]\n135\t            )\n136\t            if displacement > threshold:\n137\t                return True, name, displacement\n138\t    return False, None, 0.0\n139\t\n140\t\n141\tdef compute_smoothness(trajectory):\n142\t    \"\"\"Compute trajectory smoothness as mean jerk (third derivative of position).\"\"\"\n143\t    if len(trajectory) < 4:\n144\t        return 0.0\n145\t    traj = np.array(trajectory)\n146\t    vel = np.diff(traj, axis=0)\n147\t    acc = np.diff(vel, axis=0)\n148\t    jerk = np.diff(acc, axis=0)\n149\t    return float(np.mean(np.linalg.norm(jerk, axis=-1)))\n150\t\n151\t\n152\tdef load_policy(args):\n153\t    \"\"\"Load openpi policy from checkpoint or default.\"\"\"\n154\t    from openpi.policies import policy_config as _policy_config\n155\t    from openpi.training import config as _config\n156\t\n157\t    if args.default_policy:\n158\t        from scripts.serve_policy import create_default_policy, EnvMode\n159\t        policy = create_default_policy(EnvMode.LIBERO)\n160\t        return policy\n161\t\n162\t    config = _config.get_config(args.config_name)\n163\t    policy = _policy_config.create_trained_policy(\n164\t        config, args.checkpoint, default_prompt=None\n165\t    )\n166\t    return policy\n167\t\n168\t\n169\tdef get_action_from_policy(policy, obs, language_instruction):\n170\t    \"\"\"Get action from openpi policy given environment observation.\"\"\"\n171\t    from scipy.spatial.transform import Rotation as _Rotation\n172\t\n173\t    agentview_image = obs.get(\"agentview_image\", obs.get(\"agentview_rgb\", None))\n174\t    wrist_image = obs.get(\"robot0_eye_in_hand_image\", obs.get(\"eye_in_hand_rgb\", None))\n175\t\n176\t    if agentview_image is None or wrist_image is None:\n177\t        for key in obs:\n178\t            if \"agentview\" in key and \"image\" in key:\n179\t                agentview_image = obs[key]\n180\t            if \"eye_in_hand\" in key and \"image\" in key:\n181\t                wrist_image = obs[key]\n182\t\n183\t    ee_pos = obs.get(\"robot0_eef_pos\", np.zeros(3))\n184\t    ee_quat = obs.get(\"robot0_eef_quat\", np.array([1.0, 0.0, 0.0, 0.0]))\n185\t    gripper_qpos = obs.get(\"robot0_gripper_qpos\", np.zeros(2))\n186\t    ee_ori = _Rotation.from_quat(ee_quat).as_rotvec()\n187\t    state = np.concatenate([ee_pos, ee_ori, gripper_qpos]).astype(np.float32)\n188\t\n189\t    policy_input = {\n190\t        \"observation/image\": agentview_image,\n191\t        \"observation/wrist_image\": wrist_image,\n192\t        \"observation/state\": state,\n193\t        \"prompt\": language_instruction,\n194\t    }\n195\t\n196\t    result = policy.infer(policy_input)\n197\t    actions = result[\"actions\"]\n198\t\n199\t    if len(actions.shape) == 2:\n200\t        return actions[0]\n201\t    return actions\n202\t\n203\t\n204\tdef run_episode(env, policy, language_instruction, max_steps, obstacle_names, verbose=False):\n205\t    \"\"\"Run a single evaluation episode.\"\"\"\n206\t    obs = env.reset()\n207\t\n208\t    for _ in range(5):\n209\t        obs, _, _, _ = env.step(np.zeros(7))\n210\t\n211\t    initial_positions = get_obstacle_positions(env.sim, obstacle_names)\n212\t\n213\t    collided = False\n214\t    collision_step = -1\n215\t    collision_obstacle = None\n216\t    success = False\n217\t    trajectory = []\n218\t    max_displacement = 0.0\n219\t\n220\t    for step in range(max_steps):\n221\t        action = get_action_from_policy(policy, obs, language_instruction)\n222\t        obs, reward, done, info = env.step(action)\n223\t\n224\t        eef_pos = obs.get(\"robot0_eef_pos\", np.zeros(3))\n225\t        trajectory.append(eef_pos.copy())\n226\t\n227\t        if not collided:\n228\t            current_positions = get_obstacle_positions(env.sim, obstacle_names)\n229\t            hit, hit_name, displacement = check_collision(initial_positions, current_positions)\n230\t            if hit:\n231\t                collided = True\n232\t                collision_step = step\n233\t                collision_obstacle = hit_name\n234\t                if verbose:\n235\t                    logging.info(\"  Collision at step %d: %s displaced %.4fm\",\n236\t                                 step, hit_name, displacement)\n237\t\n238\t        for name in initial_positions:\n239\t            current_positions = get_obstacle_positions(env.sim, obstacle_names)\n240\t            if name in current_positions:\n241\t                d = np.linalg.norm(current_positions[name] - initial_positions[name])\n242\t                max_displacement = max(max_displacement, d)\n243\t\n244\t        if env.check_success():\n245\t            success = True\n246\t            if verbose:\n247\t                logging.info(\"  Task succeeded at step %d\", step)\n248\t            break\n249\t\n250\t    smoothness = compute_smoothness(trajectory)\n251\t\n252\t    return {\n253\t        \"success\": success,\n254\t        \"collided\": collided,\n255\t        \"collision_step\": collision_step,\n256\t        \"collision_obstacle\": collision_obstacle,\n257\t        \"max_displacement\": max_displacement,\n258\t        \"total_steps\": step + 1 if 'step' in dir() else 0,\n259\t        \"smoothness\": smoothness,\n260\t    }\n261\t\n262\t\n263\tdef evaluate_task(args, policy, benchmark, task_id):\n264\t    \"\"\"Evaluate a single task over n_episodes.\"\"\"\n265\t    import torch\n266\t    from libero.libero import get_libero_path\n267\t    from libero.libero.envs import OffScreenRenderEnv\n268\t\n269\t    task = benchmark.get_task(task_id)\n270\t    bddl_path = benchmark.get_task_bddl_file_path(task_id)\n271\t    language = task.language\n272\t\n273\t    logging.info(\"Task %d: %s\", task_id, language)\n274\t    logging.info(\"BDDL: %s\", bddl_path)\n275\t    logging.info(\"Safety level: %s\", args.safety_level)\n276\t\n277\t    env_args = {\n278\t        \"bddl_file_name\": bddl_path,\n279\t        \"camera_heights\": 224,\n280\t        \"camera_widths\": 224,\n281\t    }\n282\t    env = OffScreenRenderEnv(**env_args)\n283\t\n284\t    init_states = benchmark.get_task_init_states(task_id)\n285\t    n_init_states = init_states.shape[0]\n286\t\n287\t    results = []\n288\t    np.random.seed(args.seed)\n289\t\n290\t    for ep in range(args.n_episodes):\n291\t        init_idx = ep % n_init_states\n292\t        init_state = init_states[init_idx]\n293\t\n294\t        env.reset()\n295\t        env.set_init_state(init_state)\n296\t        obs = env._get_observations()\n297\t\n298\t        for _ in range(5):\n299\t            obs, _, _, _ = env.step(np.zeros(7))"}]},"parent_tool_use_id":"toolu_015zhreRCQYFUhgnkByEUWzp","session_id":"82fe1c25-39c0-4259-b5cc-ba16f1a4fb53","uuid":"46d6a578-80da-42fc-85b1-55f62d81c729","timestamp":"2026-05-25T23:20:50.325Z"}
