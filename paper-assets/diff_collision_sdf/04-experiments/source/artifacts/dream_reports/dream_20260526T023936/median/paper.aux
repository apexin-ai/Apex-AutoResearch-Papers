\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces dfCAR threshold sensitivity. The metric is invariant across $\delta \in [2, 100]$\,mm due to the extreme bimodality of EE displacement: action-collapsed episodes show displacement $<$1\,$\mu $m while genuinely active episodes show displacement $>$239\,mm. This six-order-of-magnitude gap eliminates the need for threshold tuning.}}{4}{table.caption.10}\protected@file@percent }
\newlabel{tab:dfcar-sensitivity}{{2}{4}{dfCAR threshold sensitivity. The metric is invariant across $\delta \in [2, 100]$\,mm due to the extreme bimodality of EE displacement: action-collapsed episodes show displacement $<$1\,$\mu $m while genuinely active episodes show displacement $>$239\,mm. This six-order-of-magnitude gap eliminates the need for threshold tuning}{table.caption.10}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces End-effector displacement distribution by condition. Action-collapsed models (A1) exhibit displacement $<$1\,mm while all other conditions show minimum displacement $>$100\,mm, creating a six-order-of-magnitude gap.}}{4}{table.caption.11}\protected@file@percent }
\newlabel{tab:ee-distribution}{{3}{4}{End-effector displacement distribution by condition. Action-collapsed models (A1) exhibit displacement $<$1\,mm while all other conditions show minimum displacement $>$100\,mm, creating a six-order-of-magnitude gap}{table.caption.11}{}}
