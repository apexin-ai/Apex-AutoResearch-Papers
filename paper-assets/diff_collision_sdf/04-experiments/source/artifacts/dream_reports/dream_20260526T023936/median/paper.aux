\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces Phase 2 results (10K SDF $\to $ 20K $\lambda {=}0$). The weak CAR elevation and partial TSR recovery are consistent across seeds but not statistically significant. TSR remains far below the Pi0.5 baseline (73\%).}}{7}{table.caption.16}\protected@file@percent }
\newlabel{tab:phase2}{{8}{7}{Phase 2 results (10K SDF $\to $ 20K $\lambda {=}0$). The weak CAR elevation and partial TSR recovery are consistent across seeds but not statistically significant. TSR remains far below the Pi0.5 baseline (73\%)}{table.caption.16}{}}
\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces Persistence comparison across all conditions. Phase 2 and $\lambda {=}0.1$ show similar marginal CAR elevations (${\sim }$6\,pp) over LoRA-only, both with $p > 0.1$. Neither achieves practical significance given TSR collapse.}}{7}{table.caption.17}\protected@file@percent }
\newlabel{tab:persistence}{{9}{7}{Persistence comparison across all conditions. Phase 2 and $\lambda {=}0.1$ show similar marginal CAR elevations (${\sim }$6\,pp) over LoRA-only, both with $p > 0.1$. Neither achieves practical significance given TSR collapse}{table.caption.17}{}}
