\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces Per-task results on \texttt  {spatial\_bowl}. Despite large EE displacements confirming real avoidance behavior, CAR remains low because arm-body collisions (not targeted by EE-only SDF) dominate.}}{4}{table.9}\protected@file@percent }
