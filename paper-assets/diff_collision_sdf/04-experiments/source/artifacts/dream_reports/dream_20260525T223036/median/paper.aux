\newlabel{sec:lambda}{{4.3}{3}{Lambda Dose--Response Curve}{subsection.4.3}{}}
\@writefile{toc}{\contentsline {paragraph}{Marginal Analysis.}{3}{section*.9}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces 4-point $\lambda $ curve on \texttt  {object\_pudding}. CAR increases monotonically with $\lambda $ but with diminishing returns. TSR catastrophically drops at $\lambda =0.005$ and floors near zero at $\lambda =0.1$.}}{4}{table.5}\protected@file@percent }
\newlabel{tab:lambda}{{5}{4}{4-point $\lambda $ curve on \texttt {object\_pudding}. CAR increases monotonically with $\lambda $ but with diminishing returns. TSR catastrophically drops at $\lambda =0.005$ and floors near zero at $\lambda =0.1$}{table.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Marginal tradeoff analysis. The transition from $\lambda =0$ to $\lambda =0.005$ is the critical regime: 14.5\,pp CAR gain costs 29.5\,pp TSR. Beyond $\lambda =0.005$, CAR saturates while TSR continues to degrade.}}{4}{table.6}\protected@file@percent }
\newlabel{tab:marginal}{{6}{4}{Marginal tradeoff analysis. The transition from $\lambda =0$ to $\lambda =0.005$ is the critical regime: 14.5\,pp CAR gain costs 29.5\,pp TSR. Beyond $\lambda =0.005$, CAR saturates while TSR continues to degrade}{table.6}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.4}Phase-2 Ablation: Safety Persistence}{4}{subsection.4.4}\protected@file@percent }
\newlabel{sec:phase2}{{4.4}{4}{Phase-2 Ablation: Safety Persistence}{subsection.4.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces Phase-2 ablation: removing SDF supervision after 10K steps. TSR recovers to 42\% (from 5--9\% under continuous SDF), confirming SDF does not permanently damage task capability. However, CAR regresses to 32\%---below even LoRA-only (38\%)---indicating safety encoding is not persistent.}}{4}{table.7}\protected@file@percent }
\newlabel{tab:phase2}{{7}{4}{Phase-2 ablation: removing SDF supervision after 10K steps. TSR recovers to 42\% (from 5--9\% under continuous SDF), confirming SDF does not permanently damage task capability. However, CAR regresses to 32\%---below even LoRA-only (38\%)---indicating safety encoding is not persistent}{table.7}{}}
