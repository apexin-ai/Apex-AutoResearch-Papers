\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces SciERC ablation (Qwen3-8B). Full S1 achieves 94\% DR reduction. Grammar eliminates ET and RV; semantic adds DR enforcement. Semantic-only achieves only 24\% DR reduction---the enabling dependency in action.}}{5}{table.2}\protected@file@percent }
\newlabel{tab:scierc-ablation}{{2}{5}{SciERC ablation (Qwen3-8B). Full S1 achieves 94\% DR reduction. Grammar eliminates ET and RV; semantic adds DR enforcement. Semantic-only achieves only 24\% DR reduction---the enabling dependency in action}{table.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces DocRED ablation (Qwen3-8B). Full S1 achieves 44.7\% DR reduction with significant F1 improvement (R-F1 $+$0.50pp, $p{<}0.001$; E-F1 $+$1.23pp, $p{<}0.001$). Grammar-only \emph  {increases} DR---see text for explanation.}}{5}{table.3}\protected@file@percent }
\newlabel{tab:docred-ablation}{{3}{5}{DocRED ablation (Qwen3-8B). Full S1 achieves 44.7\% DR reduction with significant F1 improvement (R-F1 $+$0.50pp, $p{<}0.001$; E-F1 $+$1.23pp, $p{<}0.001$). Grammar-only \emph {increases} DR---see text for explanation}{table.3}{}}
