\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces SciERC constraint configuration comparison (551 sentences, Qwen3-8B). Full S1 achieves 94\% DR reduction (15.4\%$\to $0.93\%) with F1-neutral performance (+0.13pp, not significant). Grammar alone eliminates ET and RV violations entirely.}}{6}{table.4}\protected@file@percent }
\newlabel{tab:scierc-results}{{4}{6}{SciERC constraint configuration comparison (551 sentences, Qwen3-8B). Full S1 achieves 94\% DR reduction (15.4\%$\to $0.93\%) with F1-neutral performance (+0.13pp, not significant). Grammar alone eliminates ET and RV violations entirely}{table.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces DocRED Phase 2 results (962 documents, Qwen3-8B). Grammar perfectly eliminates ET (7.5\%$\to $0\%) and near-eliminates RV (28.9\%$\to $0.03\%). Full S1 reduces DR by 46\% (18.7\%$\to $10.2\%), a substantial but attenuated effect compared to SciERC.}}{6}{table.5}\protected@file@percent }
\newlabel{tab:docred-results}{{5}{6}{DocRED Phase 2 results (962 documents, Qwen3-8B). Grammar perfectly eliminates ET (7.5\%$\to $0\%) and near-eliminates RV (28.9\%$\to $0.03\%). Full S1 reduces DR by 46\% (18.7\%$\to $10.2\%), a substantial but attenuated effect compared to SciERC}{table.5}{}}
