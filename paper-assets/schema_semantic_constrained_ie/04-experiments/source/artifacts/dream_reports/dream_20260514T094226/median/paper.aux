\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Enabling dependency analysis. The enabling ratio (full reduction / semantic-only reduction) measures how much grammar amplifies semantic effectiveness. The effect is strong on SciERC (3.9$\times $) and attenuated on DocRED (1.6$\times $).}}{7}{table.6}\protected@file@percent }
\newlabel{tab:enabling}{{6}{7}{Enabling dependency analysis. The enabling ratio (full reduction / semantic-only reduction) measures how much grammar amplifies semantic effectiveness. The effect is strong on SciERC (3.9$\times $) and attenuated on DocRED (1.6$\times $)}{table.6}{}}
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces Cross-field consistency violation composition under full\_s1. CF violations are 100\% attributable to the semantic layer (grammar\_only CF $\approx $ 0.1\%). The majority are entity-vs-relation type drift (EVR) driven by type system ambiguity.}}{7}{table.7}\protected@file@percent }
\newlabel{tab:cf-analysis}{{7}{7}{Cross-field consistency violation composition under full\_s1. CF violations are 100\% attributable to the semantic layer (grammar\_only CF $\approx $ 0.1\%). The majority are entity-vs-relation type drift (EVR) driven by type system ambiguity}{table.7}{}}
