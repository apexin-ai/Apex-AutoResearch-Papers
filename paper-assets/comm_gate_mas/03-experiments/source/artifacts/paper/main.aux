\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Backbone-dependent communication. (a)\nobreakspace  {}Function type distribution by backbone (round-robin, GSM8K, $N{=}300$ each). Qwen and Llama concentrate $>$47\% of messages as acknowledgments; Gemma is dominated by information provision (56\%). (b)\nobreakspace  {}Acknowledgment injection effect: inserting acks into non-ack positions is harmless for Qwen ($p = 0.71$, five seeds) but degrades Llama accuracy ($\bar  {\Delta } = -3.88$\,pp, $p = 0.0029$, five seeds), revealing backbone-dependent mechanisms. Green band: $\pm 1$\,pp equivalence zone.\relax }}{11}{figure.caption.22}\protected@file@percent }
\newlabel{fig:distribution}{{4}{11}{Backbone-dependent communication. (a)~Function type distribution by backbone (round-robin, GSM8K, $N{=}300$ each). Qwen and Llama concentrate $>$47\% of messages as acknowledgments; Gemma is dominated by information provision (56\%). (b)~Acknowledgment injection effect: inserting acks into non-ack positions is harmless for Qwen ($p = 0.71$, five seeds) but degrades Llama accuracy ($\bar {\Delta } = -3.88$\,pp, $p = 0.0029$, five seeds), revealing backbone-dependent mechanisms. Green band: $\pm 1$\,pp equivalence zone.\relax }{figure.caption.22}{}}
\newlabel{fig:injection}{{4}{11}{Backbone-dependent communication. (a)~Function type distribution by backbone (round-robin, GSM8K, $N{=}300$ each). Qwen and Llama concentrate $>$47\% of messages as acknowledgments; Gemma is dominated by information provision (56\%). (b)~Acknowledgment injection effect: inserting acks into non-ack positions is harmless for Qwen ($p = 0.71$, five seeds) but degrades Llama accuracy ($\bar {\Delta } = -3.88$\,pp, $p = 0.0029$, five seeds), revealing backbone-dependent mechanisms. Green band: $\pm 1$\,pp equivalence zone.\relax }{figure.caption.22}{}}
