              "type": "text",
              "text": "{\"result\":\"{\\\"success\\\": true, \\\"data\\\": {\\\"stdout\\\": \\\"#!/bin/bash\\\\n# M1 数据迁移: cqa1-21977 → bjb1-42106\\\\n# 用法:\\\\n#   首次全量: bash migrate_m1_data.sh\\\\n#   增量同步: bash migrate_m1_data.sh  (相同命令，rsync 自动跳过已有文件)\\\\n#   仅统计:   bash migrate_m1_data.sh --dry-run\\\\nset -euo pipefail\\\\n\\\\nSRC_HOST=\\\\\\\"root@connect.cqa1.seetacloud.com\\\\\\\"\\\\nSRC_PORT=21977\\\\nSRC_DIR=\\\\\\\"/root/autodl-tmp/structfuse/m1_extraction/\\\\\\\"\\\\nDST_DIR=\\\\\\\"/root/autodl-tmp/structfuse/full_m1_data/\\\\\\\"\\\\n\\\\nSSH_CMD=\\\\\\\"ssh -p ${SRC_PORT} -o StrictHostKeyChecking=no\\\\\\\"\\\\n\\\\nRSYNC_OPTS=\\\\\\\"-avz --compress-level=9 --progress --stats\\\\\\\"\\\\n\\\\nif [[ \\\\\\\"${1:-}\\\\\\\" == \\\\\\\"--dry-run\\\\\\\" ]]; then\\\\n    RSYNC_OPTS=\\\\\\\"${RSYNC_OPTS} --dry-run\\\\\\\"\\\\n    echo \\\\\\\"[DRY-RUN] 仅统计，不实际传输\\\\\\\"\\\\nfi\\\\n\\\\necho \\\\\\\"=== M1 数据迁移 ===\\\\\\\"\\\\necho \\\\\\\"源: ${SRC_HOST}:${SRC_PORT}:${SRC_DIR}\\\\\\\"\\\\necho \\\\\\\"目标: ${DST_DIR}\\\\\\\"\\\\necho \\\\\\\"\\\\\\\"\\\\n\\\\n# 1. 获取源文件数和大小\\\\necho \\\\\\\"[1/4] 检查源数据...\\\\\\\"\\\\nSRC_INFO=$(${SSH_CMD} ${SRC_HOST} \\\\\\\"echo \\\\\\\\$(find ${SRC_DIR} -name '*.json' -type f | wc -l) \\\\\\\\$(du -sh ${SRC_DIR} | cut -f1)\\\\\\\")\\\\nSRC_COUNT=$(echo $SRC_INFO | cut -d' ' -f1)\\\\nSRC_SIZE=$(echo $SRC_INFO | cut -d' ' -f2)\\\\necho \\\\\\\"  源: ${SRC_COUNT} 文件, ${SRC_SIZE}\\\\\\\"\\\\n\\\\n# 2. 创建目标目录\\\\nmkdir -p \\\\\\\"${DST_DIR}\\\\\\\"\\\\n\\\\n# 3. rsync 传输\\\\necho \\\\\\\"\\\\\\\"\\\\necho \\\\\\\"[2/4] 开始 rsync 传输...\\\\\\\"\\\\necho \\\\\\\"  开始时间: $(date '+%Y-%m-%d %H:%M:%S')\\\\\\\"\\\\nrsync ${RSYNC_OPTS} -e \\\\\\\"${SSH_CMD}\\\\\\\" \\\\\\\"${SRC_HOST}:${SRC_DIR}\\\\\\\" \\\\\\\"${DST_DIR}\\\\\\\"\\\\necho \\\\\\\"  结束时间: $(date '+%Y-%m-%d %H:%M:%S')\\\\\\\"\\\\n\\\\n# 4. 验证\\\\necho \\\\\\\"\\\\\\\"\\\\necho \\\\\\\"[3/4] 验证...\\\\\\\"\\\\nDST_COUNT=$(find \\\\\\\"${DST_DIR}\\\\\\\" -name '*.json' -type f | wc -l)\\\\nDST_SIZE=$(du -sh \\\\\\\"${DST_DIR}\\\\\\\" | cut -f1)\\\\necho \\\\\\\"  目标: ${DST_COUNT} 文件, ${DST_SIZE}\\\\\\\"\\\\n\\\\nif [[ \\\\\\\"${DST_COUNT}\\\\\\\" -ge \\\\\\\"${SRC_COUNT}\\\\\\\" ]]; then\\\\n    echo \\\\\\\"[4/4] ✓ 迁移完成 (${DST_COUNT}/${SRC_COUNT} 文件)\\\\\\\"\\\\nelse\\\\n    echo \\\\\\\"[4/4] ⚠ 文件数不匹配 (目标 ${DST_COUNT} < 源 ${SRC_COUNT})\\\\\\\"\\\\n    echo \\\\\\\"  建议重新运行本脚本进行增量同步\\\\\\\"\\\\n\n…[truncated 122 chars]"
