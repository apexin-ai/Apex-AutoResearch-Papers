\@writefile{lot}{\contentsline {table}{\numberline {13}{\ignorespaces ActAdd inference steering with $d_\text  {syc}$. Increasing $\alpha $ improves NoF marginally but destroys ToF, resulting in net-negative SYCONScore. The direction conflates revision with capitulation at inference time as well.}}{9}{table.caption.26}\protected@file@percent }
\newlabel{tab:actadd}{{13}{9}{ActAdd inference steering with $d_\text {syc}$. Increasing $\alpha $ improves NoF marginally but destroys ToF, resulting in net-negative SYCONScore. The direction conflates revision with capitulation at inference time as well}{table.caption.26}{}}
