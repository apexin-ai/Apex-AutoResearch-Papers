\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces DC-GRPO training progression. $r$(R1,R3) = correlation between directional and behavioral reward signals. $\cos (d, d_0)$ = cosine similarity of current $d_{\mathrm  {syc}}${} to initial direction. Asterisked (*) rows indicate recalibration. NoF improvement saturates after step 4,000, but WRR continues to benefit from R1 guidance.}}{6}{table.5}\protected@file@percent }
\newlabel{tab:training}{{5}{6}{DC-GRPO training progression. $r$(R1,R3) = correlation between directional and behavioral reward signals. $\cos (d, d_0)$ = cosine similarity of current \dsyc {} to initial direction. Asterisked (*) rows indicate recalibration. NoF improvement saturates after step 4,000, but WRR continues to benefit from R1 guidance}{table.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Ablation results. SI\% = surface inconsistency rate (internal reasoning correct but output inconsistent). R1 contributes primarily to Warranted Revision Rate (0.67 vs. vanilla 0.58). R3 is necessary for surface behavioral compliance: without it, surface inconsistency rises to 8.3\%.}}{6}{table.6}\protected@file@percent }
\newlabel{tab:ablation}{{6}{6}{Ablation results. SI\% = surface inconsistency rate (internal reasoning correct but output inconsistent). R1 contributes primarily to Warranted Revision Rate (0.67 vs. vanilla 0.58). R3 is necessary for surface behavioral compliance: without it, surface inconsistency rises to 8.3\%}{table.6}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.3}Training Dynamics}{6}{subsection.5.3}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {5.4}Ablation Studies}{6}{subsection.5.4}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces Direction stability trajectory. The sycophancy direction drifts as the policy model updates, requiring periodic recalibration (checkmarked rows). The sawtooth pattern indicates that $d_{\mathrm  {syc}}${} is a training-dependent moving target, not a fixed geometric invariant.}}{7}{table.7}\protected@file@percent }
\newlabel{tab:stability}{{7}{7}{Direction stability trajectory. The sycophancy direction drifts as the policy model updates, requiring periodic recalibration (checkmarked rows). The sawtooth pattern indicates that \dsyc {} is a training-dependent moving target, not a fixed geometric invariant}{table.7}{}}
\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces NoF and Warranted Revision Rate by turn depth. DC-GRPO's WRR advantage over R3-only grows slightly at deeper turns (6pp at T2, 7pp at T3, 8pp at T4+), suggesting the directional reward is more valuable when behavioral signals become noisier under commitment pressure.}}{7}{table.8}\protected@file@percent }
\newlabel{tab:turndepth}{{8}{7}{NoF and Warranted Revision Rate by turn depth. DC-GRPO's WRR advantage over R3-only grows slightly at deeper turns (6pp at T2, 7pp at T3, 8pp at T4+), suggesting the directional reward is more valuable when behavioral signals become noisier under commitment pressure}{table.8}{}}
