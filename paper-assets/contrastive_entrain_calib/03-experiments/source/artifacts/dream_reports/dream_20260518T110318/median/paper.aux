\@writefile{lot}{\contentsline {table}{\numberline {11}{\ignorespaces Cross-model analysis. Both models exhibit sycophancy direction structure with mid-layer emergence, but the specific directions are model-specific (cosine 0.31). The direction must be recalibrated per model.}}{9}{table.11}\protected@file@percent }
\newlabel{tab:crossmodel}{{11}{9}{Cross-model analysis. Both models exhibit sycophancy direction structure with mid-layer emergence, but the specific directions are model-specific (cosine 0.31). The direction must be recalibrated per model}{table.11}{}}
\@writefile{lot}{\contentsline {table}{\numberline {12}{\ignorespaces Three-way design validation. The genuine-revision and sycophancy directions are highly anti-correlated (cosine $-$0.72) but not perfectly opposite, confirming that the rank-based R2 design is a reasonable approximation. Using an independently computed $d_{\mathrm  {gen}}${} provides only 1.2pp additional NoF reduction.}}{9}{table.12}\protected@file@percent }
\newlabel{tab:threeway}{{12}{9}{Three-way design validation. The genuine-revision and sycophancy directions are highly anti-correlated (cosine $-$0.72) but not perfectly opposite, confirming that the rank-based R2 design is a reasonable approximation. Using an independently computed \dgen {} provides only 1.2pp additional NoF reduction}{table.12}{}}
