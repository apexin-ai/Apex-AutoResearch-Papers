}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":7008,"cache_read_input_tokens":51359,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":7008},"output_tokens":8,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"62a285b4-2e65-40ae-891e-0aaa22cfb53a","uuid":"4be54397-6853-4f48-bbad-0c4fcb718c42"}
