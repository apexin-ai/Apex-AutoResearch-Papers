trajectories_5000.jsonl\")\nprint(\"  Windows Dataset: /artifacts/data/windows_labeled.jsonl\")\nprint(\"  Label Quality: /artifacts/data/label_quality_details.jsonl\")\nprint(\"  Compute Audit: compute_waste_audit.py (generates audit output)\")\nprint(\"  OH Data Pointer: /artifacts/_project/data/openhands_sampling_stats_pointer.txt\")\n\nprint(\"\\n\" + \"=\" * 80)\nEOF\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":0,"cache_creation_input_tokens":1279,"cache_read_input_tokens":65754,"cache_creation":{"ephemeral_5m_input_tokens":1279,"ephemeral_1h_input_tokens":0},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":"toolu_01TSejwjRnjMaR43mKgCUzQ6","session_id":"b07a11b6-c8ab-4699-acee-a0e26907aaa6","uuid":"da27896d-1939-455e-a549-d8d362652f46"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UUWBcc4zoJWzXkFVRj8gDF","type":"tool_result","content":"================================================================================\nTRAJECTORY-LEVEL STATISTICS SUMMARY\n================================================================================\n\n1. SWE-AGENT TRAJECTORIES (5000 instances)\n--------------------------------------------------------------------------------\n  Average trajectory length (steps): 53.57 steps\n  Median trajectory length: 35.00 steps\n  Min: 3 steps, Max: 723 steps, Std dev: 57.05\n  Resolved (target=True): 815 instances (16.3%)\n  Unresolved (target=False): 4,185 instances (83.7%)\n\n2. SWE-AGENT TRAJECTORIES (1000 instances subset)\n--------------------------------------------------------------------------------\n  Average trajectory length: 55.29 steps\n  Median trajectory length: 35.00 steps\n  Min: 3 steps, Max: 699 steps\n  Resolved: 169 instances (16.9%)\n  Unresolved: 831 instances (83.1%)\n\n3. WINDOWS DATASET (SWE-Agent)\n--------------------------------------------------------------------------------\n  Total windows: 59,496 windows\n  Unique trajectories: 5,000\n  Average windows per trajectory: 11.90 windows\n  Median windows per trajectory: 7.00 windows\n  Min: 1 window, Max: 179 windows per trajectory\n  Window size (steps per window): 10 steps (default)\n  Label distribution:\n    - Stagnation windows (0): 15,600 (26.2%)\n    - Progress windows (1): 39,209 (65.9%)\n    - Abstain/Unknown (-1): 4,687 (7.9%)\n\n4. OPENHANDS TRAJECTORIES\n--------------------------------------------------------------------------------\n  Total windows: 154,743 windows\n  Valid windows: 150,652 windows\n  Stagnation windows: 31,440 (20.9% excl. abstain)\n  Progress windows: 119,212\n  Stagnation rate (OH): 20.32% (excl. abstain: 20.87%)\n  Confidence >= 2 windows: 43,376 windows\n  Stagnation rate (fixed embeddings): 21.45%\n\n5. MAX STEPS / TERMINATION SETTINGS\n--------------------------------------------------------------------------------\n  SWE-Agent max steps: 50 per issue (typical GitHub issue difficulty)\n  OpenHands max steps: ~50-100 (logs show variable termination)\n  Default window size: 10 steps (fixed window)\n  Trajectory max length: 723 steps observed (SWE)\n\n6. TOKEN COUNT DATA\n--------------------------------------------------------------------------------\n  Per-step token counts: Available in trajectory['text'] lengths\n  Average text length per step: ~400-800 chars (varies by step type)\n  Total window tokens: Aggregated across step_indices\n  Note: Token counts tracked implicitly via text length in steps\n\n7. STAGNATION ONSET POSITION DATA\n--------------------------------------------------------------------------------\n  Stagnation onset position: Calculated in compute_waste_audit.py\n  Compute waste metric: Position of first stagnation window\n  Tail ratio: (total_steps - onset_step) / total_steps\n  Stagnation tail analysis: Grouped by agent type (SWE vs OH)\n  Confidence >= 2 filter: Applied for reliable onset detection\n\n8. TRAJECTORY BREAKDOWN BY LENGTH\n--------------------------------------------------------------------------------\n  Short (<= 8 steps): 191 trajectories, 375 windows, stag=88 (23.5%)\n  Medium (9-18 steps): 175 trajectories, 599 windows, stag=155 (25.9%)\n  Long (19-144 steps): 177 trajectories, 850 windows, stag=242 (28.5%)\n\n9. CONFIDENCE STRATIFICATION\n--------------------------------------------------------------------------------\n  Confidence = 1 (2/3 LFs agree): 5,895 windows (67.3% of 8,101)\n  Confidence = 2 (all 3 LFs agree): 2,149 windows (24.5%)\n  Confidence = 3 (high confidence): 57 windows (0.65%)\n\n10. KEY FILE LOCATIONS\n--------------------------------------------------------------------------------\n  SWE Trajectories: /artifacts/data/swe_agent_trajectories_5000.jsonl\n  Windows Dataset: /artifacts/data/windows_labeled.jsonl\n  Label Quality: /artifacts/data/label_quality_details.jsonl\n  Compute Audit: compute_waste_audit.py (generates audit output)\n  OH Data Pointer: /artifacts/_project/data/openhands_sampling_stats_pointer.txt\n\n================================================================================","is_error":false}]},"parent_tool_use_id":"toolu_01TSejwjRnjMaR43mKgCUzQ6","session_id":"b07a11b6-c8ab-4699-acee-a0e26907aaa6","uuid":"5e067feb-cee6-408c-831c-c219c3fcc348","timestamp":"2026-05-15T14:37:49.570Z"}
