{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QUnYrDHbeHL6rK7h5CNwRe","type":"tool_result","content":"1\t#!/usr/bin/env python3\n2\t\"\"\"E9: Multi-seed Paired t-tests + E10: Conf=1 Subset Evaluation.\"\"\"\n3\t\n4\timport json\n5\timport re\n6\timport sys\n7\tfrom collections import Counter\n8\tfrom difflib import SequenceMatcher\n9\tfrom pathlib import Path\n10\t\n11\timport numpy as np\n12\tfrom scipy import stats\n13\tfrom sklearn.ensemble import GradientBoostingClassifier, RandomForestClassifier\n14\tfrom sklearn.metrics import f1_score, accuracy_score, precision_score, recall_score\n15\tfrom sklearn.model_selection import train_test_split\n16\t\n17\tBASE = Path(__file__).parent\n18\tDATA_DIR = BASE / \"artifacts\" / \"data\"\n19\t\n20\t# ============================================================\n21\t# Feature extraction (from e3_conf_stratified_gap.py)\n22\t# ============================================================\n23\tEDIT_CMDS = {\"edit\", \"str_replace\", \"create\", \"insert\"}\n24\tSEARCH_CMDS = {\"search_dir\", \"search_file\", \"find_file\", \"find\", \"grep\", \"view\"}\n25\tNAV_CMDS = {\"open\", \"goto\", \"scroll_down\", \"scroll_up\", \"cd\", \"ls\", \"cat\"}\n26\t\n27\t\n28\tdef extract_command(text):\n29\t    m = re.search(r\"```\\n?(.*?)```\", text, re.DOTALL)\n30\t    return m.group(1).strip() if m else None\n31\t\n32\t\n33\tdef cmd_similarity(a, b):\n34\t    if a == b:\n35\t        return 1.0\n36\t    if not a or not b:\n37\t        return 0.0\n38\t    return SequenceMatcher(None, a, b).ratio()\n39\t\n40\t\n41\tdef extract_features(steps, is_short):\n42\t    n = len(steps)\n43\t    if n == 0:\n44\t        return np.zeros(30, dtype=np.float32)\n45\t    texts = [s[\"text\"] for s in steps]\n46\t    text_lens = [len(t) for t in texts]\n47\t    actions = [(s, t) for s, t in zip(steps, texts) if s[\"role\"] == \"ai\"]\n48\t    observations = [(s, t) for s, t in zip(steps, texts) if s[\"role\"] == \"user\"]\n49\t    n_actions = len(actions)\n50\t    n_obs = len(observations)\n51\t    mean_tlen = np.mean(text_lens)\n52\t    std_tlen = np.std(text_lens) if n > 1 else 0.0\n53\t    max_tlen = max(text_lens)\n54\t    min_tlen = min(text_lens)\n55\t    action_lens = [len(t) for _, t in actions] if actions else [0]\n56\t    obs_lens = [len(t) for _, t in observations] if observations else [0]\n57\t    mean_action_len = np.mean(action_lens)\n58\t    mean_obs_len = np.mean(obs_lens)\n59\t    if n > 1:\n60\t        x = np.arange(n, dtype=float)\n61\t        y = np.array(text_lens, dtype=float)\n62\t        slope = (n * np.dot(x, y) - x.sum() * y.sum()) / (n * np.dot(x, x) - x.sum() ** 2 + 1e-9)\n63\t    else:\n64\t        slope = 0.0\n65\t    commands = []\n66\t    for _, t in actions:\n67\t        cmd = extract_command(t)\n68\t        if cmd:\n69\t            commands.append(cmd)\n70\t    n_cmds = len(commands)\n71\t    cmd_lens = [len(c) for c in commands] if commands else [0]\n72\t    mean_cmd_len = np.mean(cmd_lens)\n73\t    max_cmd_len = max(cmd_lens) if cmd_lens else 0\n74\t    if n_cmds > 0:\n75\t        unique_cmds = len(set(commands))\n76\t        unique_cmd_ratio = unique_cmds / n_cmds\n77\t        cmd_counter = Counter(commands)\n78\t        repeat_ratio = cmd_counter.most_common(1)[0][1] / n_cmds\n79\t    else:\n80\t        unique_cmd_ratio = 1.0\n81\t        repeat_ratio = 0.0\n82\t    n_edit = n_search = n_nav = n_submit = 0\n83\t    for cmd in commands:\n84\t        fw = cmd.strip().split()[0] if cmd.strip() else \"\"\n85\t        if fw in EDIT_CMDS:\n86\t            n_edit += 1\n87\t        elif fw in SEARCH_CMDS:\n88\t            n_search += 1\n89\t        elif fw in NAV_CMDS:\n90\t            n_nav += 1\n91\t        elif fw == \"submit\":\n92\t            n_submit += 1\n93\t    edit_ratio = n_edit / max(n_cmds, 1)\n94\t    search_ratio = n_search / max(n_cmds, 1)\n95\t    if n_cmds >= 2:\n96\t        sims = [cmd_similarity(commands[i], commands[i + 1]) for i in range(n_cmds - 1)]\n97\t        avg_adj_sim = np.mean(sims)\n98\t        max_adj_sim = max(sims)\n99\t        max_run = 1\n100\t        cur_run = 1"}]},"parent_tool_use_id":"toolu_01TSejwjRnjMaR43mKgCUzQ6","session_id":"b07a11b6-c8ab-4699-acee-a0e26907aaa6","uuid":"395e3a74-1104-448d-9c97-e95f4a8699ec","timestamp":"2026-05-15T14:36:22.078Z"}
