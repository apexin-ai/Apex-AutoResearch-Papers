{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PQphcrBovNKj5LrZRgeBcb","type":"tool_result","content":"1\t#!/usr/bin/env python3\n2\t\"\"\"Generate Pareto curve: Compute Saved vs Task Success Preserved.\"\"\"\n3\t\n4\timport argparse\n5\timport json\n6\timport os\n7\timport sys\n8\tfrom pathlib import Path\n9\t\n10\timport matplotlib\n11\tmatplotlib.use(\"Agg\")\n12\timport matplotlib.pyplot as plt\n13\timport numpy as np\n14\t\n15\tDATA_PATH = Path(\"artifacts/d072/early_termination_sim.json\")\n16\tOUT_DIR = Path(\"artifacts/d072\")\n17\t\n18\tMODELS = [\n19\t    (\"3lf_gb\",   \"3-LF GB\",  \"-\",  \"#1f77b4\"),\n20\t    (\"2lf_rf\",   \"2-LF RF\",  \"--\", \"#ff7f0e\"),\n21\t    (\"oracle\",   \"Oracle\",   \":\",  \"#2ca02c\"),\n22\t    (\"random\",   \"Random\",   \"-.\", \"#7f7f7f\"),\n23\t]\n24\t\n25\tK_VALUES = [1, 2, 3, 5, 7, 10]\n26\t\n27\t\n28\tdef generate_mock_data():\n29\t    \"\"\"Deterministic mock data for dry-run.\"\"\"\n30\t    rng = np.random.RandomState(42)\n31\t    data = {}\n32\t    curves = {\n33\t        \"oracle\":  {\"base_save\": 12, \"scale\": 8.5, \"success_floor\": 0.96},\n34\t        \"3lf_gb\":  {\"base_save\": 8,  \"scale\": 7.5, \"success_floor\": 0.93},\n35\t        \"2lf_rf\":  {\"base_save\": 6,  \"scale\": 6.5, \"success_floor\": 0.90},\n36\t        \"random\":  {\"base_save\": 4,  \"scale\": 5.0, \"success_floor\": 0.80},\n37\t    }\n38\t    for model_key, params in curves.items():\n39\t        model_data = {}\n40\t        for k in K_VALUES:\n41\t            compute_saved = params[\"base_save\"] + params[\"scale\"] * np.log1p(k)\n42\t            compute_saved += rng.normal(0, 0.3)\n43\t            false_term = (1 - params[\"success_floor\"]) * (1 - np.exp(-0.3 * k))\n44\t            false_term = max(0, false_term + rng.normal(0, 0.005))\n45\t            model_data[str(k)] = {\n46\t                \"compute_saved_pct\": round(float(compute_saved), 2),\n47\t                \"false_termination_rate\": round(float(false_term), 4),\n48\t            }\n49\t        data[model_key] = model_data\n50\t    return data\n51\t\n52\t\n53\tdef load_data(path):\n54\t    if path.exists():\n55\t        with open(path) as f:\n56\t            return json.load(f)\n57\t    print(f\"[WARN] {path} not found, using mock data\", file=sys.stderr)\n58\t    return generate_mock_data()\n59\t\n60\t\n61\tdef extract_curve(model_data):\n62\t    ks, xs, ys = [], [], []\n63\t    for k_str in sorted(model_data.keys(), key=lambda x: int(x)):\n64\t        k = int(k_str)\n65\t        entry = model_data[k_str]\n66\t        compute_saved = entry[\"compute_saved_pct\"]\n67\t        success_preserved = (1 - entry[\"false_termination_rate\"]) * 100\n68\t        ks.append(k)\n69\t        xs.append(compute_saved)\n70\t        ys.append(success_preserved)\n71\t    return ks, xs, ys\n72\t\n73\t\n74\tdef plot(data, out_dir, dpi=300):\n75\t    fig, ax = plt.subplots(figsize=(5.5, 4.2))\n76\t\n77\t    for model_key, label, ls, color in MODELS:\n78\t        if model_key not in data:\n79\t            continue\n80\t        ks, xs, ys = extract_curve(data[model_key])\n81\t        ax.plot(xs, ys, linestyle=ls, color=color, label=label,\n82\t                linewidth=1.8, marker=\"o\", markersize=4, zorder=3)\n83\t        for k, x, y in zip(ks, xs, ys):\n84\t            ax.annotate(\n85\t                f\"k={k}\", (x, y),\n86\t                textcoords=\"offset points\", xytext=(5, -8),\n87\t                fontsize=7, color=color, alpha=0.85,\n88\t            )\n89\t\n90\t    ax.set_xlabel(\"Compute Saved (%)\", fontsize=12)\n91\t    ax.set_ylabel(\"Task Success Preserved (%)\", fontsize=12)\n92\t    ax.tick_params(labelsize=10)\n93\t    ax.grid(True, alpha=0.3, linewidth=0.5)\n94\t    ax.legend(fontsize=10, loc=\"best\", framealpha=0.9)\n95\t    ax.set_ylim(None, 101)\n96\t\n97\t    fig.tight_layout()\n98\t    out_dir.mkdir(parents=True, exist_ok=True)\n99\t    for ext in (\"pdf\", \"png\"):\n100\t        out_path = out_dir / f\"pareto_curve.{ext}\"\n101\t        fig.savefig(out_path, dpi=dpi, bbox_inches=\"tight\")\n102\t        print(f\"Saved {out_path}\")\n103\t    plt.close(fig)\n104\t\n105\t\n106\tdef main():\n107\t    parser = argparse.ArgumentParser(\n108\t        description=\"Generate Pareto curve from early termination simulation.\"\n109\t    )\n110\t    parser.add_argument(\"--input\", type=Path, default=DATA_PATH,\n111\t                        help=\"Path to early_termination_sim.json\")\n112\t    parser.add_argument(\"--outdir\", type=Path, default=OUT_DIR,\n113\t                        help=\"Output directory for PDF/PNG\")\n114\t    parser.add_argument(\"--dpi\", type=int, default=300)\n115\t    args = parser.parse_args()\n116\t\n117\t    data = load_data(args.input)\n118\t    plot(data, args.outdir, dpi=args.dpi)\n119\t\n120\t\n121\tif __name__ == \"__main__\":\n122\t    main()\n123\t"}]},"parent_tool_use_id":"toolu_01VxqiVJ87aTR1C8rGYzvz9z","session_id":"b07a11b6-c8ab-4699-acee-a0e26907aaa6","uuid":"cfa7191d-e15b-41c2-be6b-b4993f7010e8","timestamp":"2026-05-15T14:38:25.975Z"}
