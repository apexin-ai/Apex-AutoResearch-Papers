{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BTu8etexPMU8ZmSLNUKqiZ","type":"tool_result","content":"1\t#!/usr/bin/env python3\n2\t\"\"\"D072: Early Termination Simulation.\n3\t\n4\tSimulate early termination based on stagnation prediction.\n5\tTrain on SWE conf>=2, evaluate cross-agent on OH.\n6\tPolicy: k consecutive stagnation predictions -> terminate.\n7\t\"\"\"\n8\t\n9\timport argparse\n10\timport json\n11\timport re\n12\tfrom collections import Counter, defaultdict\n13\tfrom difflib import SequenceMatcher\n14\tfrom pathlib import Path\n15\t\n16\timport numpy as np\n17\tfrom sklearn.ensemble import GradientBoostingClassifier, RandomForestClassifier\n18\t\n19\tPROJECT = Path(\"/root/autodl-tmp/agent_progress_probe\")\n20\tOH_DIR = Path(\"/root/autodl-tmp/openhands_data\")\n21\t\n22\tEDIT_CMDS = {\"edit\", \"str_replace\", \"create\", \"insert\"}\n23\tSEARCH_CMDS = {\"search_dir\", \"search_file\", \"find_file\", \"find\", \"grep\", \"view\"}\n24\tNAV_CMDS = {\"open\", \"goto\", \"scroll_down\", \"scroll_up\", \"cd\", \"ls\", \"cat\"}\n25\t\n26\tK_VALUES = [1, 2, 3, 5, 7, 10]\n27\t\n28\t\n29\tdef extract_command(text):\n30\t    m = re.search(r\"```\\n?(.*?)```\", text, re.DOTALL)\n31\t    return m.group(1).strip() if m else None\n32\t\n33\t\n34\tdef cmd_similarity(a, b):\n35\t    if a == b:\n36\t        return 1.0\n37\t    if not a or not b:\n38\t        return 0.0\n39\t    return SequenceMatcher(None, a, b).ratio()\n40\t\n41\t\n42\tdef extract_features(steps, is_short):\n43\t    n = len(steps)\n44\t    if n == 0:\n45\t        return np.zeros(30, dtype=np.float32)\n46\t    texts = [s[\"text\"] for s in steps]\n47\t    text_lens = [len(t) for t in texts]\n48\t    actions = [(s, t) for s, t in zip(steps, texts) if s[\"role\"] == \"ai\"]\n49\t    observations = [(s, t) for s, t in zip(steps, texts) if s[\"role\"] == \"user\"]\n50\t    n_actions = len(actions)\n51\t    n_obs = len(observations)\n52\t    mean_tlen = np.mean(text_lens)\n53\t    std_tlen = np.std(text_lens) if n > 1 else 0.0\n54\t    max_tlen = max(text_lens)\n55\t    min_tlen = min(text_lens)\n56\t    action_lens = [len(t) for _, t in actions] if actions else [0]\n57\t    obs_lens = [len(t) for _, t in observations] if observations else [0]\n58\t    mean_action_len = np.mean(action_lens)\n59\t    mean_obs_len = np.mean(obs_lens)\n60\t    if n > 1:\n61\t        x = np.arange(n, dtype=float)\n62\t        y = np.array(text_lens, dtype=float)\n63\t        slope = (n * np.dot(x, y) - x.sum() * y.sum()) / (\n64\t            n * np.dot(x, x) - x.sum() ** 2 + 1e-9\n65\t        )\n66\t    else:\n67\t        slope = 0.0\n68\t    commands = []\n69\t    for _, t in actions:\n70\t        cmd = extract_command(t)\n71\t        if cmd:\n72\t            commands.append(cmd)\n73\t    n_cmds = len(commands)\n74\t    cmd_lens = [len(c) for c in commands] if commands else [0]\n75\t    mean_cmd_len = np.mean(cmd_lens)\n76\t    max_cmd_len = max(cmd_lens) if cmd_lens else 0\n77\t    if n_cmds > 0:\n78\t        unique_cmds = len(set(commands))\n79\t        unique_cmd_ratio = unique_cmds / n_cmds\n80\t        cmd_counter = Counter(commands)\n81\t        repeat_ratio = cmd_counter.most_common(1)[0][1] / n_cmds\n82\t    else:\n83\t        unique_cmd_ratio = 1.0\n84\t        repeat_ratio = 0.0\n85\t    n_edit = n_search = n_nav = n_submit = 0\n86\t    for cmd in commands:\n87\t        fw = cmd.strip().split()[0] if cmd.strip() else \"\"\n88\t        if fw in EDIT_CMDS:\n89\t            n_edit += 1\n90\t        elif fw in SEARCH_CMDS:\n91\t            n_search += 1\n92\t        elif fw in NAV_CMDS:\n93\t            n_nav += 1\n94\t        elif fw == \"submit\":\n95\t            n_submit += 1\n96\t    edit_ratio = n_edit / max(n_cmds, 1)\n97\t    search_ratio = n_search / max(n_cmds, 1)\n98\t    if n_cmds >= 2:\n99\t        sims = [cmd_similarity(commands[i], commands[i + 1]) for i in range(n_cmds - 1)]\n100\t        avg_adj_sim = np.mean(sims)\n101\t        max_adj_sim = max(sims)\n102\t        max_run = 1\n103\t        cur_run = 1\n104\t        for s in sims:\n105\t            if s >= 0.9:\n106\t                cur_run += 1\n107\t                max_run = max(max_run, cur_run)\n108\t            else:\n109\t                cur_run = 1\n110\t    else:\n111\t        avg_adj_sim = 0.0\n112\t        max_adj_sim = 0.0\n113\t        max_run = 0\n114\t    n_errors = sum(1 for t in texts if \"Traceback\" in t or \"Error\" in t)\n115\t    n_test_output = sum(\n116\t        1 for t in texts if (\"PASSED\" in t or \"FAILED\" in t) and \"test\" in t.lower()\n117\t    )\n118\t    n_file_display = sum(1 for t in texts if \"[File:\" in t)\n119\t    n_nonzero_exit = sum(\n120\t        1\n121\t        for _, t in observations\n122\t        if re.search(r\"exit code [1-9]|returned non-zero|command not found\", t)\n123\t    )\n124\t    return np.array(\n125\t        [\n126\t            n, n_actions, n_obs, n_actions / max(n, 1),\n127\t            mean_tlen, std_tlen, max_tlen, min_tlen,\n128\t            mean_action_len, mean_obs_len, slope,\n129\t            n_cmds, mean_cmd_len, max_cmd_len,\n130\t            unique_cmd_ratio, repeat_ratio,\n131\t            n_edit, n_search, n_nav, n_submit,\n132\t            edit_ratio, search_ratio,\n133\t            avg_adj_sim, max_adj_sim, max_run,\n134\t            n_errors, n_test_output, n_file_display, n_nonzero_exit,\n135\t            float(is_short),\n136\t        ],\n137\t        dtype=np.float32,\n138\t    )\n139\t\n140\t\n141\tdef build_trajectory_index(path):\n142\t    index = {}\n143\t    with open(path) as f:\n144\t        for row_idx, line in enumerate(f):\n145\t            line = line.strip()\n146\t            if not line:\n147\t                continue\n148\t            raw = json.loads(line)\n149\t            steps = []\n150\t            for s in raw.get(\"trajectory\") or []:\n151\t                steps.append({\n152\t                    \"role\": s.get(\"role\", \"unknown\"),\n153\t                    \"text\": s.get(\"text\") or s.get(\"system_prompt\") or \"\",\n154\t                })\n155\t            index[row_idx] = steps\n156\t    return index\n157\t\n158\t\n159\tdef extract_features_batch(windows, traj_index):\n160\t    X = np.zeros((len(windows), 30), dtype=np.float32)\n161\t    y = np.zeros(len(windows), dtype=int)\n162\t    missing = 0\n163\t    for i, w in enumerate(windows):\n164\t        row_idx = w.get(\"row_index\", -1)\n165\t        traj_steps = traj_index.get(row_idx)\n166\t        if traj_steps is None:\n167\t            missing += 1\n168\t            continue\n169\t        si = w[\"step_indices\"]\n170\t        steps = [traj_steps[j] for j in si if j < len(traj_steps)]\n171\t        X[i] = extract_features(steps, w.get(\"short_trajectory\", False))\n172\t        y[i] = w[\"majority_label\"]\n173\t    if missing > 0:\n174\t        print(f\"  WARNING: {missing}/{len(windows)} windows had missing trajectories\")\n175\t    return X, y\n176\t\n177\t\n178\tdef recompute_2lf(window):\n179\t    labels = window.get(\"labels\", {})\n180\t    fd = labels.get(\"file_diff_delta\", -1)\n181\t    cr = labels.get(\"command_repetition\", -1)\n182\t    votes = [v for v in [fd, cr] if v != -1]\n183\t    if len(votes) == 0:\n184\t        return -1, 0\n185\t    elif len(votes) == 1:\n186\t        return votes[0], 1\n187\t    else:\n188\t        if fd == cr:\n189\t            return fd, 2\n190\t        else:\n191\t            return -1, 0\n192\t\n193\t\n194\tdef simulate_early_termination(traj_windows, preds, labels, k, traj_total_steps):\n195\t    \"\"\"Simulate k-consecutive-stagnation early termination policy.\n196\t\n197\t    Args:\n198\t        traj_windows: dict[traj_id] -> list of (global_idx, window_dict) sorted by window_idx\n199\t        preds: np.array of predictions for all OH windows (0=stag, 1=prog)\n200\t        labels: np.array of MV labels for all OH windows\n201\t        k: consecutive stagnation threshold\n202\t        traj_total_steps: dict[traj_id] -> total trajectory step count\n203\t\n204\t    Returns: dict with metrics\n205\t    \"\"\"\n206\t    n_terminated = 0\n207\t    n_correct_termination = 0\n208\t    n_stag_tail = 0\n209\t    n_stag_tail_terminated = 0\n210\t    total_steps = 0\n211\t    saved_steps = 0\n212\t    n_false_termination = 0\n213\t\n214\t    for traj_id, windows in traj_windows.items():\n215\t        if not windows:\n216\t            continue\n217\t\n218\t        t_steps = traj_total_steps.get(traj_id, 0)\n219\t        if t_steps == 0:\n220\t            continue\n221\t        total_steps += t_steps\n222\t\n223\t        last_global_idx = windows[-1][0]\n224\t        has_stag_tail = labels[last_global_idx] == 0\n225\t        if has_stag_tail:\n226\t            n_stag_tail += 1\n227\t\n228\t        consec = 0\n229\t        terminated = False\n230\t        term_global_idx = None\n231\t        term_window = None\n232\t\n233\t        for global_idx, w in windows:\n234\t            if preds[global_idx] == 0:\n235\t                consec += 1\n236\t            else:\n237\t                consec = 0\n238\t\n239\t            if consec >= k:\n240\t                terminated = True\n241\t                term_global_idx = global_idx\n242\t                term_window = w\n243\t                break\n244\t\n245\t        if terminated:\n246\t            n_terminated += 1\n247\t            if labels[term_global_idx] == 0:\n248\t                n_correct_termination += 1\n249\t            if has_stag_tail:\n250\t                n_stag_tail_terminated += 1\n251\t            else:\n252\t                n_false_termination += 1\n253\t            term_step = max(term_window[\"step_indices\"])\n254\t            saved_steps += max(0, t_steps - term_step - 1)\n255\t\n256\t    precision = n_correct_termination / max(n_terminated, 1)\n257\t    recall = n_stag_tail_terminated / max(n_stag_tail, 1)\n258\t    compute_saved = saved_steps / max(total_steps, 1)\n259\t    false_term_rate = n_false_termination / max(n_terminated, 1)\n260\t\n261\t    return {\n262\t        \"precision\": round(precision, 4),\n263\t        \"recall\": round(recall, 4),\n264\t        \"compute_saved\": round(compute_saved, 4),\n265\t        \"false_termination_rate\": round(false_term_rate, 4),\n266\t        \"n_terminated\": int(n_terminated),\n267\t        \"n_stag_tail\": int(n_stag_tail),\n268\t        \"n_stag_tail_terminated\": int(n_stag_tail_terminated),\n269\t        \"n_false_termination\": int(n_false_termination),\n270\t        \"total_steps\": int(total_steps),\n271\t        \"saved_steps\": int(saved_steps),\n272\t    }\n273\t\n274\t\n275\tdef main():\n276\t    parser = argparse.ArgumentParser(description=\"D072: Early Termination Simulation\")\n277\t    parser.add_argument(\"--dry-run\", action=\"store_true\", help=\"Load data and print stats only\")\n278\t    parser.add_argument(\"--seed\", type=int, default=42)\n279\t    args = parser.parse_args()\n280\t\n281\t    rng = np.random.RandomState(args.seed)\n282\t\n283\t    # ==================================================================\n284\t    # 1. Load SWE windows\n285\t    # ==================================================================\n286\t    print(\"Loading SWE windows...\")\n287\t    swe_windows = []\n288\t    with open(PROJECT / \"data\" / \"windows_labeled.jsonl\") as f:\n289\t        for line in f:\n290\t            line = line.strip()\n291\t            if line:\n292\t                w = json.loads(line)\n293\t                if \"openhands\" not in w.get(\"trajectory_id\", \"\"):\n294\t                    swe_windows.append(w)\n295\t    print(f\"  SWE total: {len(swe_windows)}\")\n296\t\n297\t    swe_3lf_conf2 = [\n298\t        w for w in swe_windows\n299\t        if w.get(\"majority_label\", -1) != -1 and w.get(\"confidence\", 0) >= 2\n300\t    ]\n301\t    print(f\"  3-LF conf>=2: {len(swe_3lf_conf2)}\")\n302\t\n303\t    for w in swe_windows:\n304\t        mv, conf = recompute_2lf(w)\n305\t        w[\"mv_2lf\"] = mv\n306\t        w[\"conf_2lf\"] = conf\n307\t\n308\t    swe_2lf_conf2 = [w for w in swe_windows if w[\"conf_2lf\"] >= 2 and w[\"mv_2lf\"] != -1]\n309\t    print(f\"  2-LF conf>=2: {len(swe_2lf_conf2)}\")\n310\t\n311\t    # ==================================================================\n312\t    # 2. Load trajectories\n313\t    # ==================================================================\n314\t    print(\"Loading SWE trajectories...\")\n315\t    swe_traj = build_trajectory_index(PROJECT / \"data\" / \"swe_agent_trajectories_5000.jsonl\")\n316\t    print(f\"  {len(swe_traj)} trajectories\")\n317\t\n318\t    print(\"Loading OH trajectories...\")\n319\t    oh_traj = build_trajectory_index(OH_DIR / \"openhands_trajectories.jsonl\")\n320\t    print(f\"  {len(oh_traj)} trajectories\")\n321\t\n322\t    # ==================================================================\n323\t    # 3. Extract SWE features and train models\n324\t    # ==================================================================\n325\t    print(\"Extracting SWE 3-LF features...\")\n326\t    X_3lf, y_3lf = extract_features_batch(swe_3lf_conf2, swe_traj)\n327\t    valid_3lf = np.any(X_3lf != 0, axis=1)\n328\t    X_3lf, y_3lf = X_3lf[valid_3lf], y_3lf[valid_3lf]\n329\t    print(f\"  3-LF valid: {len(X_3lf)}\")\n330\t\n331\t    print(\"Extracting SWE 2-LF features...\")\n332\t    train_2lf = [dict(w, majority_label=w[\"mv_2lf\"]) for w in swe_2lf_conf2]\n333\t    X_2lf, y_2lf = extract_features_batch(train_2lf, swe_traj)\n334\t    valid_2lf = np.any(X_2lf != 0, axis=1)\n335\t    X_2lf, y_2lf = X_2lf[valid_2lf], y_2lf[valid_2lf]\n336\t    print(f\"  2-LF valid: {len(X_2lf)}\")\n337\t\n338\t    print(\"Training 3-LF GB (n_estimators=200, lr=0.05, max_depth=5)...\")\n339\t    gb = GradientBoostingClassifier(\n340\t        n_estimators=200, learning_rate=0.05, max_depth=5, random_state=args.seed\n341\t    )\n342\t    gb.fit(X_3lf, y_3lf)\n343\t\n344\t    print(\"Training 2-LF RF (n_estimators=100, max_depth=10)...\")\n345\t    rf = RandomForestClassifier(\n346\t        n_estimators=100, max_depth=10, random_state=args.seed, n_jobs=-1\n347\t    )\n348\t    rf.fit(X_2lf, y_2lf)\n349\t\n350\t    # ==================================================================\n351\t    # 4. Load OH evaluation data (conf>=2)\n352\t    # ==================================================================\n353\t    print(\"\\nLoading OH windows...\")\n354\t    oh_windows_all = []\n355\t    with open(OH_DIR / \"windows_labeled.jsonl\") as f:\n356\t        for line in f:\n357\t            line = line.strip()\n358\t            if line:\n359\t                oh_windows_all.append(json.loads(line))\n360\t\n361\t    oh_conf2 = [\n362\t        w for w in oh_windows_all\n363\t        if w.get(\"majority_label\", -1) != -1 and w.get(\"confidence\", 0) >= 2\n364\t    ]\n365\t    n_oh_stag = sum(1 for w in oh_conf2 if w[\"majority_label\"] == 0)\n366\t    n_oh_prog = sum(1 for w in oh_conf2 if w[\"majority_label\"] == 1)\n367\t    stag_prevalence = n_oh_stag / len(oh_conf2)\n368\t    print(f\"  OH conf>=2: {len(oh_conf2)} (stag={n_oh_stag}, prog={n_oh_prog}, prev={stag_prevalence:.3f})\")\n369\t\n370\t    # ==================================================================\n371\t    # 5. Extract OH features and get predictions\n372\t    # ==================================================================\n373\t    print(\"Extracting OH features...\")\n374\t    X_oh, y_oh = extract_features_batch(oh_conf2, oh_traj)\n375\t\n376\t    print(\"Predicting on OH...\")\n377\t    gb_preds = gb.predict(X_oh)\n378\t    rf_preds = rf.predict(X_oh)\n379\t\n380\t    oracle_preds = y_oh.copy()\n381\t    random_preds = (rng.random(len(y_oh)) >= stag_prevalence).astype(int)\n382\t\n383\t    # ==================================================================\n384\t    # 6. Group OH windows by trajectory\n385\t    # ==================================================================\n386\t    print(\"Grouping OH windows by trajectory...\")\n387\t    traj_groups = defaultdict(list)\n388\t    for i, w in enumerate(oh_conf2):\n389\t        tid = w[\"trajectory_id\"]\n390\t        traj_groups[tid].append((i, w))\n391\t\n392\t    for tid in traj_groups:\n393\t        traj_groups[tid].sort(key=lambda x: x[1][\"window_idx\"])\n394\t\n395\t    traj_total_steps = {}\n396\t    for i, w in enumerate(oh_conf2):\n397\t        tid = w[\"trajectory_id\"]\n398\t        if tid in traj_total_steps:\n399\t            continue\n400\t        row_idx = w.get(\"row_index\", -1)\n401\t        traj_steps = oh_traj.get(row_idx)\n402\t        if traj_steps is not None:\n403\t            traj_total_steps[tid] = len(traj_steps)\n404\t\n405\t    n_traj = len(traj_groups)\n406\t    n_traj_with_steps = len(traj_total_steps)\n407\t    print(f\"  {n_traj} trajectories, {n_traj_with_steps} with step data\")\n408\t\n409\t    if args.dry_run:\n410\t        print(\"\\n[dry-run] Data loaded successfully. Exiting.\")\n411\t        return\n412\t\n413\t    # ==================================================================\n414\t    # 7. Simulate early termination\n415\t    # ==================================================================\n416\t    print(\"\\nSimulating early termination...\")\n417\t\n418\t    model_preds = {\n419\t        \"3lf_gb\": gb_preds,\n420\t        \"2lf_rf\": rf_preds,\n421\t        \"oracle\": oracle_preds,\n422\t        \"random\": random_preds,\n423\t    }\n424\t\n425\t    results = {}\n426\t    for model_name, preds in model_preds.items():\n427\t        results[model_name] = {}\n428\t        for k in K_VALUES:\n429\t            res = simulate_early_termination(\n430\t                traj_groups, preds, y_oh, k, traj_total_steps\n431\t            )\n432\t            results[model_name][str(k)] = res\n433\t            print(\n434\t                f\"  {model_name:>8} k={k:<2}: \"\n435\t                f\"prec={res['precision']:.3f} rec={res['recall']:.3f} \"\n436\t                f\"saved={res['compute_saved']:.3f} ftr={res['false_termination_rate']:.3f} \"\n437\t                f\"(term={res['n_terminated']}/{n_traj})\"\n438\t            )\n439\t        print()\n440\t\n441\t    # ==================================================================\n442\t    # 8. Save output\n443\t    # ==================================================================\n444\t    out_dir = PROJECT / \"artifacts\" / \"d072\"\n445\t    out_dir.mkdir(parents=True, exist_ok=True)\n446\t\n447\t    output = {\n448\t        \"models\": list(model_preds.keys()),\n449\t        \"k_values\": K_VALUES,\n450\t        \"results\": {\n451\t            model: {k: {\n452\t                \"precision\": v[\"precision\"],\n453\t                \"recall\": v[\"recall\"],\n454\t                \"compute_saved\": v[\"compute_saved\"],\n455\t                \"false_termination_rate\": v[\"false_termination_rate\"],\n456\t            } for k, v in kv.items()}\n457\t            for model, kv in results.items()\n458\t        },\n459\t        \"details\": results,\n460\t        \"metadata\": {\n461\t            \"oh_trajectories\": n_traj,\n462\t            \"oh_trajectories_with_steps\": n_traj_with_steps,\n463\t            \"oh_windows\": len(oh_conf2),\n464\t            \"stag_prevalence\": round(stag_prevalence, 4),\n465\t            \"swe_3lf_train\": int(len(X_3lf)),\n466\t            \"swe_2lf_train\": int(len(X_2lf)),\n467\t            \"seed\": args.seed,\n468\t            \"gb_hp\": {\"n_estimators\": 200, \"learning_rate\": 0.05, \"max_depth\": 5},\n469\t            \"rf_hp\": {\"n_estimators\": 100, \"max_depth\": 10},\n470\t        },\n471\t    }\n472\t\n473\t    out_path = out_dir / \"early_termination_sim.json\"\n474\t    with open(out_path, \"w\") as f:\n475\t        json.dump(output, f, indent=2)\n476\t    print(f\"Saved: {out_path}\")\n477\t\n478\t    # ==================================================================\n479\t    # 9. Summary table\n480\t    # ==================================================================\n481\t    print(\"\\n\" + \"=\" * 90)\n482\t    print(\"EARLY TERMINATION SIMULATION SUMMARY\")\n483\t    print(\"=\" * 90)\n484\t    print(f\"OH trajectories: {n_traj} | OH windows (conf>=2): {len(oh_conf2)} | Stag prevalence: {stag_prevalence:.1%}\")\n485\t    print()\n486\t\n487\t    header = f\"{'Model':<10} {'k':>3} | {'Precision':>9} {'Recall':>8} {'Saved':>7} {'FalseTermR':>10}\"\n488\t    print(header)\n489\t    print(\"-\" * len(header))\n490\t    for model_name in [\"3lf_gb\", \"2lf_rf\", \"oracle\", \"random\"]:\n491\t        for k in K_VALUES:\n492\t            r = results[model_name][str(k)]\n493\t            print(\n494\t                f\"{model_name:<10} {k:>3} | \"\n495\t                f\"{r['precision']:>9.3f} {r['recall']:>8.3f} \"\n496\t                f\"{r['compute_saved']:>7.3f} {r['false_termination_rate']:>10.3f}\"\n497\t            )\n498\t        print(\"-\" * len(header))\n499\t\n500\t\n501\tif __name__ == \"__main__\":\n502\t    main()\n503\t"}]},"parent_tool_use_id":"toolu_01VxqiVJ87aTR1C8rGYzvz9z","session_id":"b07a11b6-c8ab-4699-acee-a0e26907aaa6","uuid":"8ecdac79-21fe-4768-b2b5-b654618da635","timestamp":"2026-05-15T14:38:46.842Z"}
