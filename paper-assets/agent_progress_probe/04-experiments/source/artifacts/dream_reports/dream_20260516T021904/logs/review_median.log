ns/appendix.tex:195:\\subsection{Temporal Label Model Specifications}\ndocs/paper/sections/appendix.tex:223:\\subsection{Label Quality: Extended Analysis}\ndocs/paper/sections/appendix.tex:241:\\subsection{Temporal Label Model Results}\ndocs/paper/sections/appendix.tex:267:\\paragraph{Temporal models.}\ndocs/paper/sections/appendix.tex:274:\\paragraph{Generative (i.i.d.) models.}\ndocs/paper/sections/appendix.tex:280:\\paragraph{Root cause: insufficient inter-LF conflict.}\ndocs/paper/sections/appendix.tex:285:\\subsection{Label Model Failure Analysis}\ndocs/paper/sections/appendix.tex:302:\\subsection{Error Analysis}\ndocs/paper/sections/appendix.tex:305:\\paragraph{In-domain errors.}\ndocs/paper/sections/appendix.tex:319:\\paragraph{Cross-agent error patterns.}\ndocs/paper/sections/appendix.tex:331:\\subsection{Outcome Backpropagation as Distant Supervision}\ndocs/paper/sections/appendix.tex:343:\\subsection{Labeling Function Temporal Dynamics}\ndocs/paper/sections/appendix.tex:372:\\subsection{Gold Set Validation Protocol}\ndocs/paper/sections/appendix.tex:381:\\paragraph{Evaluation sets.}\ndocs/paper/sections/appendix.tex:388:\\paragraph{Inter-annotator agreement.}\ndocs/paper/sections/appendix.tex:394:\\paragraph{Gold detection results.}\ndocs/paper/sections/appendix.tex:422:\\subsection{Feature Overlap Ablation Table}\ndocs/paper/sections/introduction.tex:1:\\section{Introduction}"}]},"parent_tool_use_id":"toolu_01FVX8NunzF4Uy4XCLQ2hvVd","session_id":"8ba2873e-73c0-42d5-b773-116ccfe0b545","uuid":"5ab31fea-1dcd-41cb-9522-e0a616dc9f3e","timestamp":"2026-05-16T03:20:44.990Z"}
