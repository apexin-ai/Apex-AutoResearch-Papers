s},\n218\t  journal = {arXiv preprint arXiv:2512.12895},\n219\t  year    = {2025},\n220\t}\n221\t\n222\t@inproceedings{huang2024selfcorrect,\n223\t  title     = {Large Language Models Cannot Self-Correct Reasoning Yet},\n224\t  author    = {Jie Huang and Xinyun Chen and Swaroop Mishra and others},\n225\t  booktitle = {International Conference on Learning Representations},\n226\t  year      = {2024},\n227\t}\n228\t\n229\t@article{kamoi2024selfcorrection,\n230\t  title   = {When Can LLMs Actually Correct Their Own Mistakes? A Critical Survey of Self-Correction of LLMs},\n231\t  author  = {Ryo Kamoi and Yusen Zhang and Nan Zhang and Jiawei Han and Rui Zhang},\n232\t  journal = {Transactions of the Association for Computational Linguistics},\n233\t  year    = {2024},\n234\t}\n235\t\n236\t@article{liu2026trajad,\n237\t  title   = {TrajAD: Trajectory Anomaly Detection for Trustworthy LLM Agents},\n238\t  author  = {Yibing Liu and Chong Zhang and Zhongyi Han and others},\n239\t  journal = {arXiv preprint arXiv:2602.06443},\n240\t  year    = {2026},\n241\t}\n242\t\n243\t% ==============================================================\n244\t% CATEGORY: technique\n245\t% ==============================================================\n246\t\n247\t@inproceedings{cho2014gru,\n248\t  title     = {Learning Phrase Representations using RNN Encoder-Decoder for Statistical Machine Translation},\n249\t  author    = {Kyunghyun Cho and Bart van Merrienboer and Caglar Gulcehre and others},\n250\t  booktitle = {Conference on Empirical Methods in Natural Language Processing},\n251\t  year      = {2014},\n252\t}\n253\t\n254\t@inproceedings{bahdanau2015attention,\n255\t  title     = {Neural Machine Translation by Jointly Learning to Align and Translate},\n256\t  author    = {Dzmitry Bahdanau and Kyunghyun Cho and Yoshua Bengio},\n257\t  booktitle = {International Conference on Learning Representations},\n258\t  year      = {2015},\n259\t}\n260\t\n261\t@article{zhang2025qwen3embedding,\n262\t  title   = {Qwen3 Embedding: Advancing Text Embedding and Reranking Through Foundation Models},\n263\t  author  = {Yanzhao Zhang and Mingxin Li and Dingkun Long and others},\n264\t  journal = {arXiv preprint arXiv:2506.05176},\n265\t  year    = {2025},\n266\t}\n267\t\n268\t% ==============================================================\n269\t% CATEGORY: related-work-additions (Round 1 revision)\n270\t% ==============================================================\n271\t\n272\t@book{vanderaalst2016processmining,\n273\t  title     = {Process Mining: Data Science in Action},\n274\t  author    = {Wil M. P. van der Aalst},\n275\t  publisher = {Springer},\n276\t  year      = {2016},\n277\t  edition   = {2nd},\n278\t}\n279\t\n280\t@inproceedings{liu2008isolationforest,\n281\t  title     = {Isolation Forest},\n282\t  author    = {Fei Tony Liu and Kai Ming Ting and Zhi-Hua Zhou},\n283\t  booktitle = {IEEE International Conference on Data Mining},\n284\t  year      = {2008},\n285\t}\n286\t\n287\t% ==============================================================\n288\t% CATEGORY: references-expansion (Round 2 revision)\n289\t% ==============================================================\n290\t\n291\t% --- Sequential Anomaly Detection ---\n292\t@article{chandola2009anomaly,\n293\t  title   = {Anomaly Detection: A Survey},\n294\t  author  = {Varun Chandola and Arindam Banerjee and Vipin Kumar},\n295\t  journal = {ACM Computing Surveys},\n296\t  volume  = {41},\n297\t  number  = {3},\n298\t  year    = {2009},\n299\t}\n300\t\n301\t@inproceedings{du2017deeplog,\n302\t  title     = {DeepLog: Anomaly Detection and Diagnosis from System Logs through Deep Learning},\n303\t  author    = {Min Du and Feifei Li and Guineng Zheng and Vivek Srikumar},\n304\t  booktitle = {ACM SIGSAC Conference on Computer and Communications Security},\n305\t  year      = {2017},\n306\t}\n307\t\n308\t@inproceedings{meng2019loganomaly,\n309\t  title     = {LogAnomaly: Unsupervised Detection of Sequential and Quantitative Anomalies in Unstructured Logs},\n310\t  author    = {Weibin Meng and Ying Liu and Yichen Zhu and Shenglin Zhang and Dan Pei and Yuqing Liu and Yihao Chen and Ruizhi Zhang and Shimin Tao and Pei Sun and Rong Zhou},\n311\t  booktitle = {International Joint Conference on Artificial Intelligence},\n312\t  year      = {2019},\n313\t}\n314\t\n315\t% --- Runtime Verification ---\n316\t@article{leucker2009runtime,\n317\t  title   = {A Brief Account of Runtime Verification},\n318\t  author  = {Martin Leucker and Christian Schallhart},\n319\t  journal = {The Journal of Logic and Algebraic Programming},\n320\t  volume  = {78},\n321\t  number  = {5},\n322\t  pages   = {293--303},\n323\t  year    = {2009},\n324\t}\n325\t\n326\t% --- Agent Benchmarks ---\n327\t@inproceedings{liu2024agentbench,\n328\t  title     = {AgentBench: Evaluating LLMs as Agents},\n329\t  author    = {Xiao Liu and Hao Yu and Hanchen Zhang and Yifan Xu and Xuanyu Lei and Hanyu Lai and Yu Gu and Hangliang Ding and Kaiwen Men and Kejuan Yang and Shudan Zhang and Xiang Deng and Aohan Zeng and Zhengxiao Du and Chenhui Zhang and Sheng Shen and Tianjun Zhang and Yu Su and Huan Sun and Minlie Huang and Yuxiao Dong and Jie Tang},\n330\t  booktitle = {International Conference on Learning Representations},\n331\t  year      = {2024},\n332\t}\n333\t\n334\t@inproceedings{zhou2024webarena,\n335\t  title     = {WebArena: A Realistic Web Environment for Building Autonomous Agents},\n336\t  author    = {Shuyan Zhou and Frank F. Xu and Hao Zhu and Xuhui Zhou and Robert Lo and Abishek Sridhar and Xianyi Cheng and Tianyue Ou and Yonatan Bisk and Daniel Fried and Uri Alon and Graham Neubig},\n337\t  booktitle = {International Conference on Learning Representations},\n338\t  year      = {2024},\n339\t}\n340\t\n341\t@inproceedings{yang2024intercode,\n342\t  title     = {InterCode: Standardizing and Benchmarking Interactive Coding with Execution Feedback},\n343\t  author    = {John Yang and Akshara Prabhakar and Karthik Narasimhan and Shunyu Yao},\n344\t  booktitle = {Advances in Neural Information Processing Systems},\n345\t  year      = {2024},\n346\t}\n347\t\n348\t@inproceedings{qin2024toolllm,\n349\t  title     = {ToolLLM: Facilitating Large Language Models to Master 16000+ Real-World APIs},\n350\t  author    = {Yujia Qin and Shihao Liang and Yining Ye and Kunlun Zhu and Lan Yan and Yaxi Lu and Yankai Lin and Xin Cong and Xiangru Tang and Bill Qian and Sihan Zhao and Lauren Hong and Runchu Tian and Ruobing Xie and Jie Zhou and Mark Gerstein and Dahai Li and Zhiyuan Liu and Maosong Sun},\n351\t  booktitle = {International Conference on Learning Representations},\n352\t  year      = {2024},\n353\t}\n354\t\n355\t% --- Agent Debugging ---\n356\t@inproceedings{tian2024debugbench,\n357\t  title     = {DebugBench: Evaluating Debugging Capability of Large Language Models},\n358\t  author    = {Runchu Tian and Yining Ye and Yujia Qin and Xin Cong and Yankai Lin and Yinxu Pan and Yesai Wu and Haotian Liu and Shuo Liu and Zhiyuan Liu and Maosong Sun},\n359\t  booktitle = {Findings of the Association for Computational Linguistics: ACL 2024},\n360\t  year      = {2024},\n361\t}\n362\t\n363\t% --- Process Supervision ---\n364\t@inproceedings{lightman2024letsverify,\n365\t  title     = {Let's Verify Step by Step},\n366\t  author    = {Hunter Lightman and Vineet Kosaraju and Yura Burda and Harri Edwards and Bowen Baker and Teddy Lee and Jan Leike and John Schulman and Ilya Sutskever and Karl Cobbe},\n367\t  booktitle = {International Conference on Learning Representations},\n368\t  year      = {2024},\n369\t}\n370\t\n371\t@article{uesato2022processfeedback,\n372\t  title   = {Solving Math Word Problems with Process- and Outcome-Based Feedback},\n373\t  author  = {Jonathan Uesato and Nate Kushman and Ramana Kumar and Francis Song and Noah Siegel and Lisa Wang and Antonia Creswell and Geoffrey Irving and Irina Higgins},\n374\t  journal = {arXiv preprint arXiv:2211.14275},\n375\t  year    = {2022},\n376\t}\n377\t\n378\t% --- Early Exit / Compute-Efficient ---\n379\t@inproceedings{teerapittayanon2016branchynet,\n380\t  title     = {BranchyNet: Fast Inference via Early Exiting from Deep Neural Networks},\n381\t  author    = {Surat Teerapittayanon and Bradley McDanel and H. T. Kung},\n382\t  booktitle = {International Conference on Pattern Recognition},\n383\t  year      = {2016},\n384\t}\n385\t\n386\t@inproceedings{schwartz2020righttool,\n387\t  title     = {The Right Tool for the Job: Matching Model and Instance Complexities},\n388\t  author    = {Roy Schwartz and Gabriel Stanovsky and Swabha Swayamdipta and Jesse Dodge and Noah A. Smith},\n389\t  booktitle = {Proceedings of the 58th Annual Meeting of the Association for Computational Linguistics},\n390\t  year      = {2020},\n391\t}\n392\t\n393\t% --- Agent Guardrails ---\n394\t@inproceedings{rebedea2023nemo,\n395\t  title     = {NeMo Guardrails: A Toolkit for Controllable and Safe LLM Applications with Programmable Rails},\n396\t  author    = {Traian Rebedea and Razvan Dinu and Makesh Narsimhan Sreedhar and Christopher Parisien and Jonathan Cohen},\n397\t  booktitle = {Conference on Empirical Methods in Natural Language Processing: System Demonstrations},\n398\t  year      = {2023},\n399\t}\n400\t\n401\t@article{xiang2024guardagent,\n402\t  title   = {GuardAgent: Safeguard LLM Agents by a Guard Agent via Knowledge-Enabled Reasoning},\n403\t  author  = {Zhen Xiang and Linzhi Zheng and Yanjie Li and Junyuan Hong and Qinbin Li and Han Xie and Jiawei Zhang and Zidi Xiong and Chulin Xie and Carl Yang and Dawn Song and Bo Li},\n404\t  journal = {arXiv preprint arXiv:2406.09187},\n405\t  year    = {2024},\n406\t}\n407\t\n408\t% --- Active Learning ---\n409\t@techreport{settles2009active,\n410\t  title       = {Active Learning Literature Survey},\n411\t  author      = {Burr Settles},\n412\t  institution = {University of Wisconsin-Madison, Department of Computer Sciences},\n413\t  number      = {1648},\n414\t  year        = {2009},\n415\t}\n416\t\n417\t% --- Curriculum Learning ---\n418\t@inproceedings{bengio2009curriculum,\n419\t  title     = {Curriculum Learning},\n420\t  author    = {Yoshua Bengio and J{\\'e}r{\\^o}me Louradour and Ronan Collobert and Jason Weston},\n421\t  booktitle = {International Conference on Machine Learning},\n422\t  year      = {2009},\n423\t}\n424\t"}]},"parent_tool_use_id":"toolu_01VbgWNAGj2H8SxuS9QLLX8F","session_id":"a13beb9d-44fb-4973-a348-fa71d68014d3","uuid":"96a68f6a-6d53-4384-a053-ccdfd4e0ae11","timestamp":"2026-05-16T03:12:32.214Z"}
