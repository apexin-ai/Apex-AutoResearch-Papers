 others},\n89\t  booktitle = {Advances in Neural Information Processing Systems},\n90\t  year      = {2021},\n91\t}\n92\t\n93\t@inproceedings{safranchik2020linkedhmm,\n94\t  title     = {Weakly Supervised Sequence Tagging from Noisy Rules},\n95\t  author    = {Esteban Safranchik and Shiying Luo and Stephen H. Bach},\n96\t  booktitle = {Proceedings of the AAAI Conference on Artificial Intelligence},\n97\t  year      = {2020},\n98\t}\n99\t\n100\t@inproceedings{sala2019multiresolution,"}]},"parent_tool_use_id":"toolu_011px2qzXanuBtKfZzqbMU3j","session_id":"4efa5a2a-e3e9-4e76-992e-c9082babf060","uuid":"7ba2378b-d328-4163-b522-b76b66d16a59","timestamp":"2026-05-16T03:30:54.688Z"}
