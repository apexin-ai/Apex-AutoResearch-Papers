\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Error decomposition on conf${=}$1 gold windows ($N{=}282$). GB shows a net advantage of 10 windows over MV, suggestive of beyond-LF learned decision boundaries.}}{5}{table.caption.12}\protected@file@percent }
