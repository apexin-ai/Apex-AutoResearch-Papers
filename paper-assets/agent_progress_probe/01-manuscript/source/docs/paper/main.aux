\@writefile{lot}{\contentsline {table}{\numberline {15}{\ignorespaces Encoder cross-agent transfer (OH conf${\geq }$2). All probes use the same GRU architecture. In-domain performance is encoder-agnostic (0.91--0.94), but cross-agent transfer varies substantially (0.60--0.73, 13.5\,pp spread). Even the best probe (E5-large, 0.733) remains 25.9\,pp below structural GB (0.992 conf${\geq }$2).}}{17}{table.caption.51}\protected@file@percent }
\newlabel{tab:encoder_cross}{{15}{17}{Encoder cross-agent transfer (OH conf${\geq }$2). All probes use the same GRU architecture. In-domain performance is encoder-agnostic (0.91--0.94), but cross-agent transfer varies substantially (0.60--0.73, 13.5\,pp spread). Even the best probe (E5-large, 0.733) remains 25.9\,pp below structural GB (0.992 conf${\geq }$2)}{table.caption.51}{}}
