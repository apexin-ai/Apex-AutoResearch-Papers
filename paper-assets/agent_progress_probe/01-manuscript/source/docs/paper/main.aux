\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Stagnation detection results (SWE-Agent in-domain, $N{=}1{,}824$; OpenHands zero-shot transfer). $^\dagger $Structural metrics reflect LF-reconstructibility, not ground-truth accuracy (\S  \ref {sec:circular}). $^a$Probe All: full OH embeddings ($N{=}143{,}057$); Conf${\geq }$2: 15\% test split ($N{=}6{,}122$). Structural models on all OH windows ($N{=}150{,}652$) and conf${\geq }$2 ($N{=}43{,}376$). $^b$Paired bootstrap ($N{=}6{,}122$): GB leads fine-tuned probe by 1.65\,pp (CI [1.11, 2.23], $p{<}0.001$) on conf${\geq }$2; probe advantage on all windows reflects better conf${=}1$ performance. \textbf  {Bold} = best, \underline  {underline} = second.}}{7}{table.caption.13}\protected@file@percent }
\newlabel{tab:main_results}{{1}{7}{Stagnation detection results (SWE-Agent in-domain, $N{=}1{,}824$; OpenHands zero-shot transfer). $^\dagger $Structural metrics reflect LF-reconstructibility, not ground-truth accuracy (\S \ref {sec:circular}). $^a$Probe All: full OH embeddings ($N{=}143{,}057$); Conf${\geq }$2: 15\% test split ($N{=}6{,}122$). Structural models on all OH windows ($N{=}150{,}652$) and conf${\geq }$2 ($N{=}43{,}376$). $^b$Paired bootstrap ($N{=}6{,}122$): GB leads fine-tuned probe by 1.65\,pp (CI [1.11, 2.23], $p{<}0.001$) on conf${\geq }$2; probe advantage on all windows reflects better conf${=}1$ performance. \textbf {Bold} = best, \underline {underline} = second}{table.caption.13}{}}
