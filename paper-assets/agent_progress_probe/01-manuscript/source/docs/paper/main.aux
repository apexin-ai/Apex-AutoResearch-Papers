\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Example agent trajectory with stagnation labels. Colored regions indicate silver-labeled stagnation (red) and progress (green) windows. The trajectory illustrates semantic stagnation: the agent issues diverse commands but makes no effective progress, with stagnation onset detected before overt repetition begins.}}{19}{figure.caption.57}\protected@file@percent }
\newlabel{fig:trajectory}{{5}{19}{Example agent trajectory with stagnation labels. Colored regions indicate silver-labeled stagnation (red) and progress (green) windows. The trajectory illustrates semantic stagnation: the agent issues diverse commands but makes no effective progress, with stagnation onset detected before overt repetition begins}{figure.caption.57}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Reliability diagrams for the structural GB and GRU probe classifiers. GB is well-calibrated across all confidence bins; the probe shows slight overconfidence at high predicted stagnation probability.}}{19}{figure.caption.58}\protected@file@percent }
\newlabel{fig:reliability}{{6}{19}{Reliability diagrams for the structural GB and GRU probe classifiers. GB is well-calibrated across all confidence bins; the probe shows slight overconfidence at high predicted stagnation probability}{figure.caption.58}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Pareto frontier of task resolution rate vs.\ compute savings under early termination triggered by stagnation detection. Structural GB achieves the best trade-off, enabling 15--30\% compute reduction with $<$2\% resolution rate loss. The probe achieves comparable savings only after fine-tuning on target-agent data.}}{19}{figure.caption.59}\protected@file@percent }
\newlabel{fig:pareto}{{7}{19}{Pareto frontier of task resolution rate vs.\ compute savings under early termination triggered by stagnation detection. Structural GB achieves the best trade-off, enabling 15--30\% compute reduction with $<$2\% resolution rate loss. The probe achieves comparable savings only after fine-tuning on target-agent data}{figure.caption.59}{}}
