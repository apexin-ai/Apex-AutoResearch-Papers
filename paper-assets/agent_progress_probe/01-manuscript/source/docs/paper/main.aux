\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Encoder ablation on SWE-Agent conf${\geq }$2 ($N{=}1{,}824$). All models use the same GRU architecture (2-layer, hidden$=$256, dropout$=$0.1, lr$=$1e-3, batch$=$32, early stopping patience~5). All encoders exceed 0.90 macro-F1, confirming the probe's temporal architecture drives performance rather than a specific encoder. BGE-M3 achieves the highest score ($+$3.6\,pp over Qwen3), but the gap between encoders (0.5\,pp) is small relative to the structural--probe gap (8.96\,pp). ``---'' indicates per-class scores were not logged in the initial sweep; macro-F1 is computed from the checkpoint with lowest validation loss. E5-large-v2 reports mean $\pm $ std over 3 seeds.}}{12}{table.caption.30}\protected@file@percent }
\newlabel{tab:encoder_ablation}{{3}{12}{Encoder ablation on SWE-Agent conf${\geq }$2 ($N{=}1{,}824$). All models use the same GRU architecture (2-layer, hidden$=$256, dropout$=$0.1, lr$=$1e-3, batch$=$32, early stopping patience~5). All encoders exceed 0.90 macro-F1, confirming the probe's temporal architecture drives performance rather than a specific encoder. BGE-M3 achieves the highest score ($+$3.6\,pp over Qwen3), but the gap between encoders (0.5\,pp) is small relative to the structural--probe gap (8.96\,pp). ``---'' indicates per-class scores were not logged in the initial sweep; macro-F1 is computed from the checkpoint with lowest validation loss. E5-large-v2 reports mean $\pm $ std over 3 seeds}{table.caption.30}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Window size ablation on SWE-Agent conf${\geq }$2 using the Qwen3-0.6B encoder (seed~42). $k{=}5$ is optimal. $k{=}3$ lacks sufficient context for stagnation detection (F1\textsubscript  {stag} drops 11.3\,pp). $k{=}7$ dilutes signal by spanning both progress and stagnation phases.}}{12}{table.caption.31}\protected@file@percent }
\newlabel{tab:window_ablation}{{4}{12}{Window size ablation on SWE-Agent conf${\geq }$2 using the Qwen3-0.6B encoder (seed~42). $k{=}5$ is optimal. $k{=}3$ lacks sufficient context for stagnation detection (F1\textsubscript {stag} drops 11.3\,pp). $k{=}7$ dilutes signal by spanning both progress and stagnation phases}{table.caption.31}{}}
