\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Gradient signal analysis across context windows. Small $h$ produces noise-dominated gradients with high variance, effectively performing random walks rather than optimization.}}{4}{table.3}\protected@file@percent }
\newlabel{tab:gradient}{{3}{4}{Gradient signal analysis across context windows. Small $h$ produces noise-dominated gradients with high variance, effectively performing random walks rather than optimization}{table.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.5}Per-Task Breakdown}{4}{subsection.4.5}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Performance breakdown by ALFWorld task type. Success correlates strongly with episode length ($r = -0.87$), consistent with the credit assignment mechanism.}}{4}{table.4}\protected@file@percent }
