\newlabel{tab:generalization}{{5}{5}{Episode-level advantage generalizes across environments and model scales. Step-independent training fails catastrophically in all tested configurations}{table.5}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.7}Verification Value: Always-On vs.\ No-Verify}{5}{subsection.4.7}\protected@file@percent }
