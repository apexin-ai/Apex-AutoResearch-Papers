\@writefile{toc}{\contentsline {subsection}{\numberline {4.8}Action-Change Statistics}{5}{subsection.4.8}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces Action-change statistics from always-on verification runs. The majority of verifications (68.8\%) are confirmatory, and action-change rate increases with episode progression.}}{6}{table.7}\protected@file@percent }
\newlabel{tab:actionchange}{{7}{6}{Action-change statistics from always-on verification runs. The majority of verifications (68.8\%) are confirmatory, and action-change rate increases with episode progression}{table.7}{}}
\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces Action-change signal survives entropy control. The partial correlation ($r = 0.14$, $p = 0.031$) indicates that action-change is not purely an artifact of policy stochasticity.}}{6}{table.8}\protected@file@percent }
\newlabel{tab:entropy}{{8}{6}{Action-change signal survives entropy control. The partial correlation ($r = 0.14$, $p = 0.031$) indicates that action-change is not purely an artifact of policy stochasticity}{table.8}{}}
