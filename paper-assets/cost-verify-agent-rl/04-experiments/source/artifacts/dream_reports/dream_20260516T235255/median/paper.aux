\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Episode-level vs.\ step-independent training. Episode-level achieves stable convergence while step-independent collapses to 0\% across all seeds.}}{3}{table.1}\protected@file@percent }
\newlabel{tab:main}{{1}{3}{Episode-level vs.\ step-independent training. Episode-level achieves stable convergence while step-independent collapses to 0\% across all seeds}{table.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Context window $h$-sweep. Performance degrades sharply below $h=10$, with complete collapse at $h=2$. The cliff region lies between $h=5$ and $h=10$.}}{4}{table.2}\protected@file@percent }
\newlabel{tab:hsweep}{{2}{4}{Context window $h$-sweep. Performance degrades sharply below $h=10$, with complete collapse at $h=2$. The cliff region lies between $h=5$ and $h=10$}{table.2}{}}
