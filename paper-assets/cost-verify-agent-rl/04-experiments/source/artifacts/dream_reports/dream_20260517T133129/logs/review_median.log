         0.545,\n59\t            0.19\n60\t          ],\n61\t          [\n62\t            20,\n63\t            0.3125,\n64\t            0.5,\n65\t            0.8125,\n66\t            0.57,\n67\t            0.19\n68\t          ],\n69\t          [\n70\t            25,\n71\t            0.34375,\n72\t            0.5313,\n73\t            0.875,\n74\t            0.6,\n75\t            0.18\n76\t          ],\n77\t          [\n78\t            30,\n79\t            0.34375,\n80\t            0.5625,\n81\t            0.875,\n82\t            0.61,\n83\t            0.18\n84\t          ],\n85\t          [\n86\t            40,\n87\t            0.375,\n88\t            0.5625,\n89\t            0.9375,\n90\t            0.62,\n91\t            0.18\n92\t          ],\n93\t          [\n94\t            50,\n95\t            0.375,\n96\t            0.5625,\n97\t            0.9375,\n98\t            0.62,\n99\t            0.18\n100\t          ]\n101\t        ]\n102\t      }\n103\t    ],\n104\t    \"figures\": [],\n105\t    \"analysis\": \"收敛于 37.5% 落入 median 指标范围 [30%, 44%]。足以作为 diagnostic paper 的核心证据： episode-level 训练有效（vs step-independent 灾难性崩溃），但 performance 不够强以支撑 selective verification 的 cost-efficiency 叙事。Paper pivot 到 Plan A。\\n\\n\\nStep 15 已达 28.125%，训练曲线减速明显（step 5→10 无进步，step 10→15 仅 +3pp）。 Median 档下 episode-level GRPO 的 bandit-style credit（所有 token 共享同一 advantage） 足以消除 sign misattribution，但缺乏 per-token credit 使得模型难以学习精细的 action-level 策略。 37.5% 的 plateau 反映了 GRPO episode-level 的 credit assignment 天花板：模型学会了 \\\"哪类 trajectory 好\\\"但无法精确归因 \\\"哪个 action 关键\\\"。Pass@8=0.94 说明 policy 覆盖了 正确策略但 greedy sampling 时选择不够精准。这个 success rate 足以证明 episode-level 显著优于 step-independent（0%），但不足以支撑 cost-efficiency story（需 ≥40%）。\\n\"\n106\t  },\n107\t  {\n108\t    \"name\": \"Context window h-sweep ablation (3 seeds each)\",\n109\t    \"description\": \"Sweep h={2, 5, 10, 20, full}，每个 h 值 3 个 seed，每 seed 训练 15 steps。 Median 档下 cliff 存在但 sharpness 因 seed 而异。\\n\",\n110\t    \"results\": {\n111\t      \"h2_seed1_step15_success\": 0.0,\n112\t      \"h2_seed2_step15_success\": 0.0,\n113\t      \"h2_seed3_step15_success\": 0.0313,\n114\t      \"h2_mean\": 0.0104,\n115\t      \"h2_std\": 0.018,\n116\t      \"h5_seed1_step15_success\": 0.0625,\n117\t      \"h5_seed2_step15_success\": 0.0313,\n118\t      \"h5_seed3_step15_success\": 0.125,\n119\t      \"h5_mean\": 0.0729,\n120\t      \"h5_std\": 0.047,\n121\t      \"h10_seed1_step15_success\": 0.1563,\n122\t      \"h10_seed2_step15_success\": 0.125,\n123\t      \"h10_seed3_step15_success\": 0.2188,\n124\t      \"h10_mean\": 0.1667,\n125\t      \"h10_std\": 0.047,\n126\t      \"h20_seed1_step15_success\": 0.25,\n127\t      \"h20_seed2_step15_success\": 0.2188,\n128\t      \"h20_seed3_step15_success\": 0.2813,\n129\t      \"h20_mean\": 0.25,\n130\t      \"h20_std\": 0.031,\n131\t      \"full_seed1_step15_success\": 0.3125,\n132\t      \"full_seed2_step15_success\": 0.25,\n133\t      \"full_seed3_step15_success\": 0.2813,\n134\t      \"full_mean\": 0.2813,\n135\t      \"full_std\": 0.031,\n136\t      \"cliff_threshold_h\": 10,\n137\t      \"cliff_clear_seeds\": 2,\n138\t      \"cliff_fuzzy_seeds\": 1\n139\t    },\n140\t    \"tables\": [\n141\t      {\n142\t        \"title\": \"h-sweep results (15 steps, 3 seeds each)\",\n143\t        \"columns\": [\n144\t          \"h\",\n145\t          \"seed1\",\n146\t          \"seed2\",\n147\t          \"seed3\",\n148\t          \"mean\",\n149\t          \"std\",\n150\t          \"collapse_at_step\"\n151\t        ],\n152\t        \"rows\": [\n153\t          [\n154\t            \"h=2\",\n155\t            \"0%\",\n156\t            \"0%\",\n157\t            \"3.1%\",\n158\t            \"1.0%\",\n159\t            \"1.8%\",\n160\t            \"step 3-4\"\n161\t          ],\n162\t          [\n163\t            \"h=5\",\n164\t            \"6.3%\",\n165\t            \"3.1%\",\n166\t            \"12.5%\",\n167\t            \"7.3%\",\n168\t            \"4.7%\",\n169\t            \"step 5-7\"\n170\t          ],\n171\t          [\n172\t            \"h=10\",\n173\t            \"15.6%\",\n174\t            \"12.5%\",\n175\t            \"21.9%\",\n176\t            \"16.7%\",\n177\t            \"4.7%\",\n178\t            \"none\"\n179\t          ],\n180\t          [\n181\t            \"h=20\",\n182\t            \"25.0%\",\n183\t            \"21.9%\",\n184\t            \"28.1%\",\n185\t            \"25.0%\",\n186\t            \"3.1%\",\n187\t            \"none\"\n188\t          ],\n189\t          [\n190\t            \"full\",\n191\t            \"31.3%\",\n192\t            \"25.0%\",\n193\t            \"28.1%\",\n194\t            \"28.1%\",\n195\t            \"3.1%\",\n196\t            \"none\"\n197\t          ]\n198\t        ]\n199\t      },\n200\t      {\n201\t        \"title\": \"h-sweep action_is_valid at step 15\",\n202\t        \"columns\": [\n203\t          \"h\",\n204\t          \"mean_action_is_valid\",\n205\t          \"mean_invalid_action\"\n206\t        ],\n207\t        \"rows\": [\n208\t          [\n209\t            \"h=2\",\n210\t            0.31,\n211\t            0.69\n212\t          ],\n213\t          [\n214\t            \"h=5\",\n215\t            0.48,\n216\t            0.52\n217\t          ],\n218\t          [\n219\t            \"h=10\",\n220\t            0.55,\n221\t            0.45\n222\t          ],\n223\t          [\n224\t            \"h=20\",\n225\t            0.58,\n226\t            0.42\n227\t          ],\n228\t          [\n229\t            \"full\",\n230\t            0.6,\n231\t            0.4\n232\t          ]\n233\t        ]\n234\t      }\n235\t    ],\n236\t    \"figures\": [],\n237\t    \"analysis\": \"Cliff 存在于 h≈5-10 区间，但非单一 sharp threshold。h=2 → 0% 是 robust 的（3/3 seeds）， h=5 → h=10 是 transition zone 且 seed-dependent。这支持 Claim 1 但 cliff sharpness 弱于 ideal：无法画出一条漂亮的 \\\"step function\\\"，只能描述 \\\"monotonic degradation with high-variance transition zone\\\"。Paper 需要更多讨论来解释 seed 依赖性。\\n\\n\\nh=2 一致崩溃（3/3 seeds → ~0%）：2-step window 对 ALFWorld 完全不够，policy information loss 和 sign misattribution 同时严重。h=5 有 1 个 seed 勉强存活（12.5%）但另 2 个很弱，因为 5-step 窗口偶尔能捕捉到短 task 的完整策略但多数时候不行。h=10 是转折区域但 seed 间方差大： seed 3 达 21.9% 说明 10-step 窗口在某些 seed 初始化下能部分解决 information loss， 但 sign misattribution 仍导致梯度噪声。h=20 和 full 接近但有 gap（25% vs 28%）， 说明即使 20-step 窗口也会因 sign misattribution 损失一些信号。 Cliff 的 \\\"fuzzy seed\\\" 出现在 h=10 区间——seed 3 的 21.9% 模糊了 cliff 的清晰度， 而 seed 1/2 的 15.6%/12.5% 明确显示 h<10 区域的 degradation。2/3 seeds 清晰对应 median 定义。\\n\"\n238\t  },\n239\t  {\n240\t    \"name\": \"Multi-seed replication (5 seeds total)\",\n241\t    \"description\": \"4 个额外 seed 运行 exp029 episode-level 配置（共 5 seeds），训练至 step 30+，报告 mean ± std。\\n\",\n242\t    \"results\": {\n243\t      \"seed1_converged_success\": 0.375,\n244\t      \"seed2_converged_success\": 0.3125,\n245\t      \"seed3_converged_success\": 0.28125,\n246\t      \"seed4_converged_success\": 0.4063,\n247\t      \"seed5_converged_success\": 0.34375,\n248\t      \"multi_seed_mean_success\": 0.3438,\n249\t      \"multi_seed_std\": 0.048,\n250\t      \"multi_seed_ci95_lower\": 0.284,\n251\t      \"multi_seed_ci95_upper\": 0.404,\n252\t      \"multi_seed_mean_action_is_valid\": 0.59,\n253\t      \"multi_seed_std_action_is_valid\": 0.04,\n254\t      \"multi_seed_mean_pass_at_8\": 0.9,\n255\t      \"multi_seed_std_pass_at_8\": 0.03\n256\t    },\n257\t    \"tables\": [\n258\t      {\n259\t        \"title\": \"Multi-seed episode-level GRPO results (converged)\",\n260\t        \"columns\": [\n261\t          \"seed\",\n262\t          \"val_success\",\n263\t          \"train_success\",\n264\t          \"pass_at_8\",\n265\t          \"action_is_valid\",\n266\t          \"converge_step\"\n267\t        ],\n268\t        \"rows\": [\n269\t          [\n270\t            1,\n271\t            \"37.5%\",\n272\t            \"56.3%\",\n273\t            \"93.8%\",\n274\t            0.62,\n275\t            30\n276\t          ],\n277\t          [\n278\t            2,\n279\t            \"31.3%\",\n280\t            \"50.0%\",\n281\t            \"87.5%\",\n282\t            0.58,\n283\t            35\n284\t          ],\n285\t          [\n286\t            3,\n287\t            \"28.1%\",\n288\t            \"46.9%\",\n289\t            \"87.5%\",\n290\t            0.55,\n291\t            25\n292\t          ],\n293\t          [\n294\t            4,\n295\t            \"40.6%\",\n296\t            \"59.4%\",\n297\t            \"93.8%\",\n298\t            0.63,\n299\t            30\n300\t          ],\n301\t          [\n302\t            5,\n303\t            \"34.4%\",\n304\t            \"53.1%\",\n305\t            \"87.5%\",\n306\t            0.59,\n307\t            30\n308\t          ],\n309\t          [\n310\t            \"mean±std\",\n311\t            \"34.4±4.8%\",\n312\t            \"53.1±4.9%\",\n313\t            \"90.0±3.4%\",\n314\t            \"0.59±0.04\",\n315\t            \"30±3.5\"\n316\t          ]\n317\t        ]\n318\t      }\n319\t    ],\n320\t    \"figures\": [],\n321\t    \"analysis\": \"Std 4.8pp 意味着 paper 需要报告 CI 而非单点。CI [28.4%, 40.4%] 宽度 12pp 说明单 seed 结果不够可信——这也是为什么 dream review 要求多 seed。好消息是 CI 下界仍远超 step-independent。\\n\\n\\n5 个 seed 的 spread 反映了 GRPO 训练的固有随机性：初始化 + rollout sampling + ALFWorld 环境随机性。Std = 4.8pp 落入 median 范围 [5%, 8%] 的下端。Mean = 34.4% 落入 [28%, 42%]。 Seed 3 最弱（28.1%）可能因为初始 rollout 运气差导致 early advantage estimates 偏差， seed 4 最强（40.6%）可能恰好 early rollout 探索到了高效策略。 这个 std 水平意味着 \\\"episode-level 有效\\\" 的 claim 是 robust 的（CI 下界 28.4% >> step-independent 0%）， 但具体 success rate 有不可忽略的 seed 依赖性。Reproducibility 可接受但不完美。\\n\"\n322\t  },\n323\t  {\n324\t    \"name\": \"GAE baseline comparison\",\n325\t    \"description\": \"实现 GAE(λ=0.95, γ=1.0) 和 GAE(λ=1.0, γ=1.0) 作为标准 RL baseline，需要 critic head。 15 steps × 3 seeds each。\\n\",\n326\t    \"results\": {\n327\t      \"gae_095_seed1_step15_success\": 0.375,\n328\t      \"gae_095_seed2_step15_success\": 0.4063,\n329\t      \"gae_095_seed3_step15_success\": 0.4375,\n330\t      \"gae_095_mean\": 0.4063,\n331\t      \"gae_095_std\": 0.031,\n332\t      \"gae_10_seed1_step15_success\": 0.34375,\n333\t      \"gae_10_seed2_step15_success\": 0.375,\n334\t      \"gae_10_seed3_step15_success\": 0.3125,\n335\t      \"gae_10_mean\": 0.3438,\n336\t      \"gae_10_std\": 0.031,\n337\t      \"episode_grpo_mean_at_step15\": 0.2813,\n338\t      \"gae_095_vs_episode_grpo_delta_pp\": 12.5,\n339\t      \"gae_10_vs_episode_grpo_delta_pp\": 6.25,\n340\t      \"gae_095_per_token_advantage_variance\": 0.42,\n341\t      \"gae_10_per_token_advantage_variance\": 0.28,\n342\t      \"episode_grpo_per_token_advantage_variance\": 0.0\n343\t    },\n344\t    \"tables\": [\n345\t      {\n346\t        \"title\": \"GAE vs Episode-level GRPO comparison (step 15, 3 seeds)\",\n347\t        \"columns\": [\n348\t          \"method\",\n349\t          \"mean_success\",\n350\t          \"std\",\n351\t          \"adv_variance\",\n352\t          \"training_cost_ratio\"\n353\t        ],\n354\t        \"rows\": [\n355\t          [\n356\t            \"Step-independent (h=2)\",\n357\t            \"1.0%\",\n358\t            \"1.8%\",\n359\t            0.85,\n360\t            \"1.0x\"\n361\t          ],\n362\t          [\n363\t            \"Episode-level GRPO\",\n364\t            \"28.1%\",\n365\t            \"3.1%\",\n366\t            0.0,\n367\t            \"1.2x\"\n368\t          ],\n369\t          [\n370\t            \"GAE(λ=1.0, γ=1.0)\",\n371\t            \"34.4%\",\n372\t            \"3.1%\",\n373\t            0.28,\n374\t            \"1.8x\"\n375\t          ],\n376\t          [\n377\t            \"GAE(λ=0.95, γ=1.0)\",\n378\t            \"40.6%\",\n379\t            \"3.1%\",\n380\t            0.42,\n381\t            \"1.8x\"\n382\t          ]\n383\t        ]\n384\t      }\n385\t    ],\n386\t    \"figures\": [],\n387\t    \"analysis\": \"GAE 优势削弱 contrarian \\\"更粗就够了\\\" 的 positioning。Paper 需改为：step-independent 的问题 是 sign misattribution（episode-level 解决），但 performance 最优需要 finer credit（GAE 解决）。 两个 contribution 维度分离：诊断问题（我们的主要贡献）vs 最大化性能（GAE/竞品的贡献）。 GAE 额外 50% 训练成本（critic head）是 trade-off，可以讨论但不改变主论点。\\n\\n\\nGAE(0.95) 的 12.5pp 优势落入 median 范围 [5, 12] 的上端。这直接挑战 contrarian positioning： finer credit assignment（per-token advantage via value function）确实比 episode-level bandit credit 提供额外信息。GAE(1.0, 1.0) 相当于 MC return + baseline，优势较小（6.25pp）， 因为 λ=1.0 等效于不做 bootstrapping，信息量接近 episode-level。 GAE(0.95) 的优势来源于 critic 提供的 per-token baseline 减少了 variance，使得有效 action 能更快被强化。但关键是 GAE 也远超 step-independent（40.6% vs 0%），说明问题的主要因素 确实是 step-independent 的 sign misattribution，而非 credit granularity 不够。 这迫使 paper 调整叙事：episode-level 是 \\\"necessary minimum\\\"，GAE 是 \\\"sufficient improvement\\\"。\\n\"\n388\t  },\n389\t  {\n390\t    \"name\": \"Episode-level + valid_action_bonus (plateau-breaker)\",\n391\t    \"description\": \"在 episode-level 配置上加 valid_action_bonus=0.05。测试是否安全提升 action_is_valid 且打破 plateau。\\n\",\n392\t    \"results\": {\n393\t      \"step15_val_success\": 0.3125,\n394\t      \"step15_val_action_is_valid\": 0.72,\n395\t      \"step15_val_action_is_effective\": 0.85,\n396\t      \"step15_train_success\": 0.4688,\n397\t      \"valid_bonus_vs_task_reward_ratio\": 0.22,\n398\t      \"gaming_detected\": false,\n399\t      \"plateau_broken\": false,\n400\t      \"success_delta_vs_no_bonus_pp\": 3.1\n401\t    },\n402\t    \"tables\": [\n403\t      {\n404\t        \"title\": \"Episode-level ± valid_action_bonus comparison (step 15)\",\n405\t        \"columns\": [\n406\t          \"config\",\n407\t          \"val_success\",\n408\t          \"action_is_valid\",\n409\t          \"gaming\",\n410\t          \"bonus_ratio\"\n411\t        ],\n412\t        \"rows\": [\n413\t          [\n414\t            \"Episode-level (no bonus)\",\n415\t            \"28.1%\",\n416\t            \"54.5%\",\n417\t            \"N/A\",\n418\t            \"N/A\"\n419\t          ],\n420\t          [\n421\t            \"Episode-level + bonus=0.05\",\n422\t            \"31.3%\",\n423\t            \"72.0%\",\n424\t            \"No\",\n425\t            0.22\n426\t          ],\n427\t          [\n428\t            \"Step-independent + bonus=0.05 (exp013f)\",\n429\t            \"0%\",\n430\t            \"97.5%\",\n431\t            \"Yes\",\n432\t            67.0\n433\t          ]\n434\t        ]\n435\t      }\n436\t    ],\n437\t    \"figures\": [],\n438\t    \"analysis\": \"结果验证 D056 insight：dense reward gaming 是 step-independent 特有的。但 bonus 对 打破 success plateau 帮助有限。可作为 paper 的 supplementary ablation。\\n\\n\\nEpisode-level 训练下 valid_action_bonus 不会被 game（与 exp013f step-independent 不同）， 因为模型优化的是整条 trajectory 的 total reward，而非单个 window 的 return。 Action_is_valid 从 55% 提升至 72%（有效但非 dramatic），因为 bonus 信号相对 task reward 仍然弱（ratio 0.22 vs exp013f 的 67）。Success 仅提升 3pp（31.3% vs 28.1%）， 因为 valid action 和 task success 的 correlation 虽为正但不强——模型可以执行 valid 但 strategically wrong 的 action。Plateau 未被打破：根本瓶颈是 credit assignment granularity， 不是 action validity。这个实验更多是 negative control：证明 dense reward gaming 是 step-independent 特有的问题。\\n\"\n439\t  },\n440\t  {\n441\t    \"name\": \"Credit assignment mechanism empirical verification (paper Figure 2)\",\n442\t    \"description\": \"对 h=2 seed 2 运行添加 per-window advantage logging，验证 sign misattribution 机制。 分析 advantage sign 与 episode outcome / local action quality 的 correlation。\\n\",\n443\t    \"results\": {\n444\t      \"sign_vs_outcome_correlation\": 0.87,\n445\t      \"sign_vs_local_quality_correlation\": 0.14,\n446\t      \"gamma_k_magnitude_decay_r2\": 0.72,\n447\t      \"episode_level_advantage_variance_across_positions\": 0.0,\n448\t      \"success_episodes_all_positive_pct\": 0.92,\n449\t      \"failure_episodes_all_negative_pct\": 0.89,\n450\t      \"mixed_sign_episodes_pct\": 0.11,\n451\t      \"total_episodes_analyzed\": 256,\n452\t      \"total_windows_analyzed\": 3200\n453\t    },\n454\t    \"tables\": [\n455\t      {\n456\t        \"title\": \"Advantage sign attribution analysis (h=2, 256 episodes)\",\n457\t        \"columns\": [\n458\t          \"metric\",\n459\t          \"value\",\n460\t          \"interpretation\"\n461\t        ],\n462\t        \"rows\": [\n463\t          [\n464\t            \"sign-vs-outcome corr\",\n465\t            0.87,\n466\t            \"strong but not perfect — GRPO normalization noise\"\n467\t          ],\n468\t          [\n469\t            \"sign-vs-local-quality corr\",\n470\t            0.14,\n471\t            \"weak — sign NOT determined by local action quality\"\n472\t          ],\n473\t          [\n474\t            \"γ^k decay R²\",\n475\t            0.72,\n476\t            \"moderate fit — magnitude decays with position but noisy\"\n477\t          ],\n478\t          [\n479\t            \"success eps all-positive %\",\n480\t            \"92%\",\n481\t            \"most success episodes have uniformly positive advantages\"\n482\t          ],\n483\t          [\n484\t            \"failure eps all-negative %\",\n485\t            \"89%\",\n486\t            \"most failure episodes have uniformly negative advantages\"\n487\t          ],\n488\t          [\n489\t            \"mixed-sign episodes %\",\n490\t            \"11%\",\n491\t            \"GRPO normalization creates exceptions\"\n492\t          ]\n493\t        ]\n494\t      },\n495\t      {\n496\t        \"title\": \"Per-window advantage statistics (success vs failure episodes)\",\n497\t        \"columns\": [\n498\t          \"episode_type\",\n499\t          \"mean_advantage\",\n500\t          \"std_advantage\",\n501\t          \"pct_positive\",\n502\t          \"pct_negative\"\n503\t        ],\n504\t        \"rows\": [\n505\t          [\n506\t            \"success (n=72)\",\n507\t            \"+0.43\",\n508\t            \"0.12\",\n509\t            \"92%\",\n510\t            \"8%\"\n511\t          ],\n512\t          [\n513\t            \"failure (n=184)\",\n514\t            \"-0.31\",\n515\t            \"0.15\",\n516\t            \"11%\",\n517\t            \"89%\"\n518\t          ]\n519\t        ]\n520\t      },\n521\t      {\n522\t        \"title\": \"Episode-level control: advantage uniformity\",\n523\t        \"columns\": [\n524\t          \"mode\",\n525\t          \"within_episode_sign_variance\",\n526\t          \"within_episode_magnitude_cv\"\n527\t        ],\n528\t        \"rows\": [\n529\t          [\n530\t            \"step-independent (h=2)\",\n531\t            0.18,\n532\t            0.45\n533\t          ],\n534\t          [\n535\t            \"episode-level\",\n536\t            0.0,\n537\t            0.0\n538\t          ]\n539\t        ]\n540\t      }\n541\t    ],\n542\t    \"figures\": [],\n543\t    \"analysis\": \"Sign misattribution 实证为 \\\"dominant factor\\\" 而非 \\\"complete explanation\\\"。0.87 correlation 足够强以支撑核心 claim，但 GRPO normalization 导致的 exceptions 需要诚实讨论。 Paper 措辞从 \\\"advantage sign is determined by episode outcome\\\" 改为 \\\"advantage sign is predominantly determined by episode outcome (r=0.87), with exceptions arising from GRPO's within-group normalization\\\"。γ^k decay 作为 secondary mechanism 报告但不过度强调。\\n\\n\\nSign-vs-outcome correlation 0.87 而非理论预测的 ~1.0，因为 GRPO 的 group normalization 引入噪声：当一个 group 内所有 trajectory 都失败时，GRPO 的 (R-μ)/σ 会将 \\\"least bad\\\" 的 trajectory 赋予正 advantage，即使 episode 失败。这导致约 11% 的 episode 出现 \\\"mixed sign\\\" （失败 episode 中部分 window 获得正 advantage）。 Sign-vs-local-quality correlation 0.14（非零但弱）因为 local action quality proxy （action_is_valid × action_is_effective）与 episode outcome 有弱正相关——好的 local action 确实微弱增加 success 概率。但 0.14 远低于 0.87，足以证明 advantage sign 主要由 episode outcome 决定而非 local quality。 γ^k decay R²=0.72 说明 magnitude decay 存在但拟合不完美：实际 magnitude 受 GRPO normalization 和 token-level variance 影响，不是纯粹的 γ^k 指数衰减。\\n\"\n544\t  },\n545\t  {\n546\t    \"name\": \"Action-change statistics from always-on runs\",\n547\t    \"description\": \"从 exp029 训练好的 checkpoint 收集 verification 后的 action change 统计。\\n\",\n548\t    \"results\": {\n549\t      \"overall_action_change_rate\": 0.32,\n550\t      \"confirmatory_rate\": 0.68,\n551\t      \"action_change_when_success\": 0.28,\n552\t      \"action_change_when_failure\": 0.34,\n553\t      \"action_change_success_correlation\": 0.12,\n554\t      \"per_task_breakdown\": {\n555\t        \"pick\": {\n556\t          \"action_change_rate\": 0.25,\n557\t          \"n_episodes\": 40\n558\t        },\n559\t        \"clean\": {\n560\t          \"action_change_rate\": 0.38,\n561\t          \"n_episodes\": 25\n562\t        },\n563\t        \"heat\": {\n564\t          \"action_change_rate\": 0.35,\n565\t          \"n_episodes\": 20\n566\t        },\n567\t        \"cool\": {\n568\t          \"action_change_rate\": 0.3,\n569\t          \"n_episodes\": 15\n570\t        },\n571\t        \"examine\": {\n572\t          \"action_change_rate\": 0.42,\n573\t          \"n_episodes\": 10\n574\t        },\n575\t        \"pick_two\": {\n576\t          \"action_change_rate\": 0.4,\n577\t          \"n_episodes\": 18\n578\t        }\n579\t      },\n580\t      \"total_verification_events\": 512\n581\t    },\n582\t    \"tables\": [\n583\t      {\n584\t        \"title\": \"Verification action-change statistics\",\n585\t        \"columns\": [\n586\t          \"category\",\n587\t          \"action_change_rate\",\n588\t          \"n_events\"\n589\t        ],\n590\t        \"rows\": [\n591\t          [\n592\t            \"Overall\",\n593\t            \"32%\",\n594\t            512\n595\t          ],\n596\t          [\n597\t            \"Success episodes\",\n598\t            \"28%\",\n599\t            192\n600\t          ],\n601\t          [\n602\t            \"Failure episodes\",\n603\t            \"34%\",\n604\t            320\n605\t          ],\n606\t          [\n607\t            \"Early turns (1-3)\",\n608\t            \"38%\",\n609\t            180\n610\t          ],\n611\t          [\n612\t            \"Mid turns (4-6)\",\n613\t            \"30%\",\n614\t            170\n615\t          ],\n616\t          [\n617\t            \"Late turns (7+)\",\n618\t            \"28%\",\n619\t            162\n620\t          ]\n621\t        ]\n622\t      }\n623\t    ],\n624\t    \"figures\": [],\n625\t    \"analysis\": \"Confirmatory rate 高是好消息（支持 selective verification 动机），但 correlation 弱是坏消息 （action-change 作为 reward 的有效性存疑）。这为 plan_007 的弱结果埋下伏笔。\\n\\n\\n68% confirmatory rate 符合 \\\"大部分 verification 是 confirmatory\\\" 的 hypothesis。 但 action_change-success correlation 仅 0.12（弱正相关），低于 hypothesis 的 0.2。 原因：在 37.5% success rate 下，模型经常在 \\\"confused\\\" 状态下 change action（改了但改错了）， 导致 change ≠ improvement。高 confirmatory rate 说明 always-on verification 有大量浪费， 支持 selective verification 的动机。但弱 correlation 意味着 action-change 作为 reward signal 的信噪比可能不够好——这预示了 Phase B 的挑战。\\n\"\n626\t  },\n627\t  {\n628\t    \"name\": \"Selective verification implementation\",\n629\t    \"description\": \"实现 binary verify/skip decision，纯代码工作无 GPU。\\n\",\n630\t    \"results\": {\n631\t      \"implementation_complete\": true,\n632\t      \"code_changes_files\": 5,\n633\t      \"test_coverage\": \"unit tests passing\",\n634\t      \"integration_verified\": true\n635\t    },\n636\t    \"tables\": [],\n637\t    \"figures\": [],\n638\t    \"analysis\": \"实现本身不影响 tier，为 plan_007 做准备。\\n\\n\\n纯工程任务，无不确定性。实现 verify/skip token + reward 计算逻辑。\\n\"\n639\t  },\n640\t  {\n641\t    \"name\": \"B-IAVR selective verification training\",\n642\t    \"description\": \"用 episode-level GRPO 训练 selective verification policy，从 exp029 best checkpoint 初始化。 Action-change reward 驱动 verification 选择。\\n\",\n643\t    \"results\": {\n644\t      \"converged_success\": 0.34375,\n645\t      \"converged_verification_rate\": 0.72,\n646\t      \"verification_rate_reduction_vs_always_on\": 0.28,\n647\t      \"success_delta_vs_always_on_pp\": -3.1,\n648\t      \"training_steps_to_converge\": 20,\n649\t      \"reward_components\": {\n650\t        \"task_success_mean\": 0.34,\n651\t        \"action_change_reward_mean\": 0.08,\n652\t        \"verification_cost_penalty_mean\": -0.05\n653\t      },\n654\t      \"training_stability\": \"moderate oscillation in verification_rate\"\n655\t    },\n656\t    \"tables\": [\n657\t      {\n658\t        \"title\": \"B-IAVR training trajectory\",\n659\t        \"columns\": [\n660\t          \"step\",\n661\t          \"success\",\n662\t          \"verification_rate\",\n663\t          \"cost_reduction\"\n664\t        ],\n665\t        \"rows\": [\n666\t          [\n667\t            0,\n668\t            \"37.5%\",\n669\t            \"100%\",\n670\t            \"0%\"\n671\t          ],\n672\t          [\n673\t            5,\n674\t            \"34.4%\",\n675\t            \"85%\",\n676\t            \"15%\"\n677\t          ],\n678\t          [\n679\t            10,\n680\t            \"31.3%\",\n681\t            \"68%\",\n682\t            \"32%\"\n683\t          ],\n684\t          [\n685\t            15,\n686\t            \"34.4%\",\n687\t            \"75%\",\n688\t            \"25%\"\n689\t          ],\n690\t          [\n691\t            20,\n692\t            \"34.4%\",\n693\t            \"72%\",\n694\t            \"28%\"\n695\t          ]\n696\t        ]\n697\t      }\n698\t    ],\n699\t    \"figures\": [],\n700\t    \"analysis\": \"28% verification reduction 不足以讲 compelling cost-efficiency story。Selective verification 降为 paper 的 preliminary results / future work section。\\n\\n\\nVerification rate reduction 仅 28%，落入 median 范围 [15%, 35%] 但未达 target 40%。 原因是 action-change reward 的信噪比弱（plan_005 显示 correlation 仅 0.12）：模型 难以学到 \\\"何时 verify 有信息量\\\"，倾向于保守地 verify（因为 skip-and-fail 的惩罚 高于 unnecessary-verify 的成本）。Success 下降 3.1pp 因为偶尔 skip 了本该 verify 的 turn。 训练过程中 verification_rate 振荡反映了 reward signal 的噪声——模型在 \\\"verify everything\\\" 和 \\\"skip too much\\\" 之间摆动。\\n\"\n701\t  },\n702\t  {\n703\t    \"name\": \"Selective verification full comparison\",\n704\t    \"description\": \"在相同 val set 上比较 always-on / B-IAVR / no-verify / random-p / confidence-threshold。\\n\",\n705\t    \"results\": {\n706\t      \"always_on_success\": 0.375,\n707\t      \"always_on_verification_rate\": 1.0,\n708\t      \"always_on_total_tokens\": 45000,\n709\t      \"biavr_success\": 0.34375,\n710\t      \"biavr_verification_rate\": 0.72,\n711\t      \"biavr_total_tokens\": 38000,\n712\t      \"no_verify_success\": 0.25,\n713\t      \"no_verify_verification_rate\": 0.0,\n714\t      \"no_verify_total_tokens\": 28000,\n715\t      \"random_p05_success\": 0.3125,\n716\t      \"random_p05_verification_rate\": 0.5,\n717\t      \"random_p05_total_tokens\": 35000,\n718\t      \"confidence_threshold_success\": 0.3125,\n719\t      \"confidence_threshold_verification_rate\": 0.65,\n720\t      \"confidence_threshold_total_tokens\": 37000\n721\t    },\n722\t    \"tables\": [\n723\t      {\n724\t        \"title\": \"Selective verification comparison\",\n725\t        \"columns\": [\n726\t          \"method\",\n727\t          \"success\",\n728\t          \"verif_rate\",\n729\t          \"tokens\",\n730\t          \"cost_saving\"\n731\t        ],\n732\t        \"rows\": [\n733\t          [\n734\t            \"Always-on\",\n735\t            \"37.5%\",\n736\t            \"100%\",\n737\t            45000,\n738\t            \"0%\"\n739\t          ],\n740\t          [\n741\t            \"B-IAVR (ours)\",\n742\t            \"34.4%\",\n743\t            \"72%\",\n744\t            38000,\n745\t            \"15.6%\"\n746\t          ],\n747\t          [\n748\t            \"Confidence-threshold\",\n749\t            \"31.3%\",\n750\t            \"65%\",\n751\t            37000,\n752\t            \"17.8%\"\n753\t          ],\n754\t          [\n755\t            \"Random p=0.5\",\n756\t            \"31.3%\",\n757\t            \"50%\",\n758\t            35000,\n759\t            \"22.2%\"\n760\t          ],\n761\t          [\n762\t            \"No-verify\",\n763\t            \"25.0%\",\n764\t            \"0%\",\n765\t            28000,\n766\t            \"37.8%\"\n767\t          ]\n768\t        ]\n769\t      }\n770\t    ],\n771\t    \"figures\": [],\n772\t    \"analysis\": \"B-IAVR 未能 dominate Pareto frontier。这进一步支持 selective verification 降为 preliminary result。Paper 的核心 contribution 只能是 Claim 1（diagnostic）。\\n\\n\\nB-IAVR 的 Pareto 优势不明显：它与 confidence-threshold 在 success-cost space 中位置接近。 Random-p=0.5 也达到了 31.3% success，仅比 B-IAVR 低 3pp，但 verification cost 更低。 这说明 learned selective policy 相对 simple heuristics 的优势微弱——在 37.5% 的 base success rate 下，verification 的 marginal value 本身就不大（只有 +12.5pp vs no-verify）， 所以 \\\"选择性 verify\\\" 的空间有限。\\n\"\n773\t  },\n774\t  {\n775\t    \"name\": \"No-verify ablation\",\n776\t    \"description\": \"Episode-level GRPO 完全不做 self-verification，作为 lower bound。\\n\",\n777\t    \"results\": {\n778\t      \"converged_val_success\": 0.25,\n779\t      \"converged_action_is_valid\": 0.52,\n780\t      \"success_delta_vs_always_on_pp\": -12.5\n781\t    },\n782\t    \"tables\": [\n783\t      {\n784\t        \"title\": \"Verification ablation\",\n785\t        \"columns\": [\n786\t          \"config\",\n787\t          \"val_success\",\n788\t          \"delta_vs_always_on\"\n789\t        ],\n790\t        \"rows\": [\n791\t          [\n792\t            \"Always-on verification\",\n793\t            \"37.5%\",\n794\t            \"baseline\"\n795\t          ],\n796\t          [\n797\t            \"No verification\",\n798\t            \"25.0%\",\n799\t            \"-12.5pp\"\n800\t          ]\n801\t        ]\n802\t      }\n803\t    ],\n804\t    \"figures\": [],\n805\t    \"analysis\": \"12.5pp gap 支持 \\\"verification 有价值\\\" 的前提。但在 selective verification 效果弱的情况下， 这个数据更多用于 motivation section 而非 main result。\\n\\n\\n无 verification 时 success 降 12.5pp（25% vs 37.5%），符合 hypothesis（≥10pp）。 这证明 verification 本身有价值（模型确实受益于 self-check），但 12.5pp 的 gap 也意味着 verification 的 marginal value 在 medium-performance regime 并非 overwhelming。 对 pick 类简单任务影响小（5pp），对 clean/heat 类复杂任务影响大（15-20pp）。\\n\"\n806\t  },\n807\t  {\n808\t    \"name\": \"Entropy-controlled action-change analysis\",\n809\t    \"description\": \"按 policy entropy 分层，检验 action-change-success correlation 在控制 entropy 后是否保持。\\n\",\n810\t    \"results\": {\n811\t      \"raw_correlation\": 0.12,\n812\t      \"partial_correlation_controlling_entropy\": 0.08,\n813\t      \"p_value\": 0.12,\n814\t      \"low_entropy_stratum_correlation\": 0.05,\n815\t      \"high_entropy_stratum_correlation\": 0.15,\n816\t      \"n_observations\": 512\n817\t    },\n818\t    \"tables\": [\n819\t      {\n820\t        \"title\": \"Entropy-stratified action-change analysis\",\n821\t        \"columns\": [\n822\t          \"stratum\",\n823\t          \"n\",\n824\t          \"action_change_rate\",\n825\t          \"success_rate\",\n826\t          \"correlation\"\n827\t        ],\n828\t        \"rows\": [\n829\t          [\n830\t            \"Low entropy (<0.1)\",\n831\t            180,\n832\t            \"22%\",\n833\t            \"42%\",\n834\t            0.05\n835\t          ],\n836\t          [\n837\t            \"Medium entropy (0.1-0.3)\",\n838\t            200,\n839\t            \"32%\",\n840\t            \"35%\",\n841\t            0.1\n842\t          ],\n843\t          [\n844\t            \"High entropy (>0.3)\",\n845\t            132,\n846\t            \"45%\",\n847\t            \"25%\",\n848\t            0.15\n849\t          ],\n850\t          [\n851\t            \"All (raw)\",\n852\t            512,\n853\t            \"32%\",\n854\t            \"34%\",\n855\t            0.12\n856\t          ],\n857\t          [\n858\t            \"All (partial, controlling entropy)\",\n859\t            512,\n860\t            \"-\",\n861\t            \"-\",\n862\t            0.08\n863\t          ]\n864\t        ]\n865\t      }\n866\t    ],\n867\t    \"figures\": [],\n868\t    \"analysis\": \"p=0.12 无法拒绝 null hypothesis。这弱化了 action-change 作为 intrinsic reward 的理论基础。 Paper 需诚实报告：action-change signal 有 entropy confounding，但 selective verification 已降为 future work，所以这个 negative 结果的影响可控。\\n\\n\\n控制 entropy 后 partial correlation 降至 0.08（p=0.12，not significant at 0.05）。 高 entropy stratum 的 correlation（0.15）比低 entropy（0.05）高，说明 action-change 在 uncertain states 中更 informative，但在 confident states 中接近 noise。 这意味着 action-change 作为 reward signal 有 confounding：部分 correlation 来自 \\\"uncertain states → both more changes and more failures\\\"，不是 \\\"change → improvement\\\"。\\n\"\n869\t  },\n870\t  {\n871\t    \"name\": \"Causal intervention: random vs verification-triggered changes\",\n872\t    \"description\": \"随机注入 action changes（与 verification-triggered 同频率），比较 task success。\\n\",\n873\t    \"results\": {\n874\t      \"verification_triggered_success\": 0.375,\n875\t      \"random_change_success\": 0.28125,\n876\t      \"delta_pp\": 9.4,\n877\t      \"p_value\": 0.04,\n878\t      \"n_episodes_per_condition\": 128\n879\t    },\n880\t    \"tables\": [\n881\t      {\n882\t        \"title\": \"Causal intervention results\",\n883\t        \"columns\": [\n884\t          \"condition\",\n885\t          \"success\",\n886\t          \"n_episodes\",\n887\t          \"p_value\"\n888\t        ],\n889\t        \"rows\": [\n890\t          [\n891\t            \"Verification-triggered\",\n892\t            \"37.5%\",\n893\t            128,\n894\t            \"-\"\n895\t          ],\n896\t          [\n897\t            \"Random (same rate)\",\n898\t            \"28.1%\",\n899\t            128,\n900\t            \"0.04\"\n901\t          ],\n902\t          [\n903\t            \"No changes\",\n904\t            \"25.0%\",\n905\t            128,\n906\t            \"ref\"\n907\t          ]\n908\t        ]\n909\t      }\n910\t    ],\n911\t    \"figures\": [],\n912\t    \"analysis\": \"弱 causal evidence。可作为 supplementary result 但不足以成为 main claim。\\n\\n\\nVerification-triggered changes 比 random 高 9.4pp，接近但略低于 hypothesis 的 10pp。 P=0.04 勉强 significant。这提供了弱 causal evidence：verification 确实能在 marginal 上 选择更好的 change point。但 effect size 不大，因为在 37.5% base success 下，很多 episode 的命运在 verification 之前就已决定（选错了第一步物品 → 后续 verify 无法挽救）。\\n\"\n913\t  },\n914\t  {\n915\t    \"name\": \"Reward signal ablation (action-change vs alternatives)\",\n916\t    \"description\": \"用不同 reward signal 训练 B-IAVR：action-change / random trigger / confidence-based。\\n\",\n917\t    \"results\": {\n918\t      \"action_change_success\": 0.34375,\n919\t      \"action_change_verification_rate\": 0.72,\n920\t      \"random_trigger_success\": 0.3125,\n921\t      \"random_trigger_verification_rate\": 0.55,\n922\t      \"confidence_based_success\": 0.3125,\n923\t      \"confidence_based_verification_rate\": 0.68\n924\t    },\n925\t    \"tables\": [\n926\t      {\n927\t        \"title\": \"Reward signal comparison\",\n928\t        \"columns\": [\n929\t          \"reward\",\n930\t          \"success\",\n931\t          \"verif_rate\",\n932\t          \"cost_reduction\"\n933\t        ],\n934\t        \"rows\": [\n935\t          [\n936\t            \"Action-change (ours)\",\n937\t            \"34.4%\",\n938\t            \"72%\",\n939\t            \"28%\"\n940\t          ],\n941\t          [\n942\t            \"Confidence-based\",\n943\t            \"31.3%\",\n944\t            \"68%\",\n945\t            \"32%\"\n946\t          ],\n947\t          [\n948\t            \"Random trigger\",\n949\t            \"31.3%\",\n950\t            \"55%\",\n951\t            \"45%\"\n952\t          ]\n953\t        ]\n954\t      }\n955\t    ],\n956\t    \"figures\": [],\n957\t    \"analysis\": \"差异不显著，进一步支持 selective verification 降为 future work。\\n\\n\\nAction-change reward 略优于 alternatives（+3pp success, 高 verification rate）， 但差距不大。Random trigger 的 success 仅低 3pp 说明 learned policy 的 value add 有限。 Confidence-based 与 action-change 接近因为两者都 proxy 了 \\\"uncertainty\\\"。 在 median 档下，三种 reward 的差异不够大以 claim \\\"action-change is the best signal\\\"。\\n\"\n958\t  },\n959\t  {\n960\t    \"name\": \"ARES reproduction + comparison\",\n961\t    \"description\": \"复现 ARES SFT router 在 ALFWorld 上的表现，与 B-IAVR head-to-head 比较。\\n\",\n962\t    \"results\": {\n963\t      \"ares_repro_success\": 0.3125,\n964\t      \"ares_repro_verification_rate\": 0.55,\n965\t      \"ares_repro_cost_reduction\": 0.45,\n966\t      \"biavr_success\": 0.34375,\n967\t      \"biavr_verification_rate\": 0.72,\n968\t      \"biavr_cost_reduction\": 0.28,\n969\t      \"biavr_vs_ares_success_delta_pp\": 3.1,\n970\t      \"biavr_vs_ares_cost_reduction_delta_pp\": -17\n971\t    },\n972\t    \"tables\": [\n973\t      {\n974\t        \"title\": \"B-IAVR vs ARES comparison\",\n975\t        \"columns\": [\n976\t          \"method\",\n977\t          \"success\",\n978\t          \"verif_rate\",\n979\t          \"cost_reduction\",\n980\t          \"training_paradigm\"\n981\t        ],\n982\t        \"rows\": [\n983\t          [\n984\t            \"B-IAVR (ours)\",\n985\t            \"34.4%\",\n986\t            \"72%\",\n987\t            \"28%\",\n988\t            \"RL (GRPO)\"\n989\t          ],\n990\t          [\n991\t            \"ARES (repro)\",\n992\t            \"31.3%\",\n993\t            \"55%\",\n994\t            \"45%\",\n995\t            \"SFT router\"\n996\t          ],\n997\t          [\n998\t            \"Always-on\",\n999\t            \"37.5%\",\n1000\t            \"100%\",\n1001\t            \"0%\",\n1002\t            \"N/A\"\n1003\t          ]\n1004\t        ]\n1005\t      }\n1006\t    ],\n1007\t    \"figures\": [],\n1008\t    \"analysis\": \"无法 claim B-IAVR dominates ARES。但在 Plan A (diagnostic paper) 下，这个比较降为 supplementary material。\\n\\n\\nARES 的 SFT router 更 aggressive 地 skip verification（55% rate），cost reduction 更高（45%） 但 success 更低（31.3%）。B-IAVR success 略高（+3pp）但 cost 更高（只省 28% vs 45%）。 两者在 Pareto frontier 上各有优势而非 domination。 原因：ARES 用 SFT 从 expert demonstrations 学习 skip pattern，more data-efficient； B-IAVR 用 RL 但 reward signal 弱导致 policy 不够 aggressive。\\n\"\n1009\t  },\n1010\t  {\n1011\t    \"name\": \"ScienceWorld transfer (episode-level advantage)\",\n1012\t    \"description\": \"在 ScienceWorld 上验证 episode-level vs step-independent。\\n\",\n1013\t    \"results\": {\n1014\t      \"not_executed\": true,\n1015\t      \"reason\": \"资源/时间不足，ScienceWorld 集成复杂度高于预期\"\n1016\t    },\n1017\t    \"tables\": [],\n1018\t    \"figures\": [],\n1019\t    \"analysis\": \"Single-environment limitation 需在 paper 中正面讨论。通过 h-sweep 的 within-ALFWorld 多样性和 per-task-type breakdown 来部分缓解，但 reviewer concern #5 无法完全回应。\\n\\n\\nMedian 档定义明确指出 \\\"ScienceWorld transfer 未执行或结果不明确\\\"。 ScienceWorld 需要不同的 environment wrapper 和 action space adapter，集成工作量 在 Phase D 时间线内难以完成，尤其在 Phase A+ 已消耗大量 GPU hours 的情况下。 Paper 将其列为 limitation / future work，承认 single-environment 是弱点。\\n\"\n1020\t  },\n1021\t  {\n1022\t    \"name\": \"7B model scaling verification\",\n1023\t    \"description\": \"在 Qwen3-7B 上验证 episode-level vs step-independent。\\n\",\n1024\t    \"results\": {\n1025\t      \"not_executed\": true,\n1026\t      \"reason\": \"需要 4xA100 或 2xH100 云 GPU，预算/时间约束\"\n1027\t    },\n1028\t    \"tables\": [],\n1029\t    \"figures\": [],\n1030\t    \"analysis\": \"Reviewer concern #6 只能通过 framing 缓解（\\\"resource-constrained research setting\\\"）， 无硬 evidence。Analysis paper track 对 model scale 的要求比 SOTA paper 更宽容。\\n\\n\\n7B 模型需要至少 4xA100 80GB（episode-level full context 下 7B 的 memory footprint 约 60GB+）， 现有双 GPU 设置无法支撑。在 median 档下 budget 不足以租用云 GPU。 Paper 将 \\\"small model\\\" 列为 limitation，定位为 resource-constrained research。\\n\"\n1031\t  },\n1032\t  {\n1033\t    \"name\": \"Per-task-type breakdown analysis\",\n1034\t    \"description\": \"按 ALFWorld 6 种 task type 分解 episode-level 和 step-independent 的 success。\\n\",\n1035\t    \"results\": {\n1036\t      \"episode_level_per_task\": {\n1037\t        \"pick\": {\n1038\t          \"success\": 0.5,\n1039\t          \"n_episodes\": 40,\n1040\t          \"avg_episode_length\": 18\n1041\t        },\n1042\t        \"clean\": {\n1043\t          \"success\": 0.36,\n1044\t          \"n_episodes\": 25,\n1045\t          \"avg_episode_length\": 28\n1046\t        },\n1047\t        \"heat\": {\n1048\t          \"success\": 0.3,\n1049\t          \"n_episodes\": 20,\n1050\t          \"avg_episode_length\": 32\n1051\t        },\n1052\t        \"cool\": {\n1053\t          \"success\": 0.33,\n1054\t          \"n_episodes\": 15,\n1055\t          \"avg_episode_length\": 25\n1056\t        },\n1057\t        \"examine\": {\n1058\t          \"success\": 0.2,\n1059\t          \"n_episodes\": 10,\n1060\t          \"avg_episode_length\": 35\n1061\t        },\n1062\t        \"pick_two\": {\n1063\t          \"success\": 0.22,\n1064\t          \"n_episodes\": 18,\n1065\t          \"avg_episode_length\": 40\n1066\t        }\n1067\t      },\n1068\t      \"step_independent_per_task\": {\n1069\t        \"pick\": {\n1070\t          \"success\": 0.05,\n1071\t          \"n_episodes\": 40,\n1072\t          \"avg_episode_length\": 18\n1073\t        },\n1074\t        \"clean\": {\n1075\t          \"success\": 0.0,\n1076\t          \"n_episodes\": 25,\n1077\t          \"avg_episode_length\": 28\n1078\t        },\n1079\t        \"heat\": {\n1080\t          \"success\": 0.0,\n1081\t          \"n_episodes\": 20,\n1082\t          \"avg_episode_length\": 32\n1083\t        },\n1084\t        \"cool\": {\n1085\t          \"success\": 0.0,\n1086\t          \"n_episodes\": 15,\n1087\t          \"avg_episode_length\": 25\n1088\t        },\n1089\t        \"examine\": {\n1090\t          \"success\": 0.0,\n1091\t          \"n_episodes\": 10,\n1092\t          \"avg_episode_length\": 35\n1093\t        },\n1094\t        \"pick_two\": {\n1095\t          \"success\": 0.0,\n1096\t          \"n_episodes\": 18,\n1097\t          \"avg_episode_length\": 40\n1098\t        }\n1099\t      },\n1100\t      \"episode_length_vs_episode_level_advantage_correlation\": -0.82\n1101\t    },\n1102\t    \"tables\": [\n1103\t      {\n1104\t        \"title\": \"Per-task-type breakdown\",\n1105\t        \"columns\": [\n1106\t          \"task_type\",\n1107\t          \"n\",\n1108\t          \"avg_steps\",\n1109\t          \"episode_level\",\n1110\t          \"step_independent\",\n1111\t          \"delta\"\n1112\t        ],\n1113\t        \"rows\": [\n1114\t          [\n1115\t            \"pick\",\n1116\t            40,\n1117\t            18,\n1118\t            \"50.0%\",\n1119\t            \"5.0%\",\n1120\t            \"+45.0pp\"\n1121\t          ],\n1122\t          [\n1123\t            \"clean\",\n1124\t            25,\n1125\t            28,\n1126\t            \"36.0%\",\n1127\t            \"0.0%\",\n1128\t            \"+36.0pp\"\n1129\t          ],\n1130\t          [\n1131\t            \"cool\",\n1132\t            15,\n1133\t            25,\n1134\t            \"33.3%\",\n1135\t            \"0.0%\",\n1136\t            \"+33.3pp\"\n1137\t          ],\n1138\t          [\n1139\t            \"heat\",\n1140\t            20,\n1141\t            32,\n1142\t            \"30.0%\",\n1143\t            \"0.0%\",\n1144\t            \"+30.0pp\"\n1145\t          ],\n1146\t          [\n1147\t            \"pick_two\",\n1148\t            18,\n1149\t            40,\n1150\t            \"22.2%\",\n1151\t            \"0.0%\",\n1152\t            \"+22.2pp\"\n1153\t          ],\n1154\t          [\n1155\t            \"examine\",\n1156\t            10,\n1157\t            35,\n1158\t            \"20.0%\",\n1159\t            \"0.0%\",\n1160\t            \"+20.0pp\"\n1161\t          ]\n1162\t        ]\n1163\t      }\n1164\t    ],\n1165\t    \"figures\": [],\n1166\t    \"analysis\": \"Per-task breakdown 是 diagnostic paper 的重要 figure：展示了 step-independent 崩溃 在长 horizon 任务上尤为严重，与 sign misattribution 机制预测一致（更多 windows → 更多 misattributed gradients）。短任务（pick）的残存 success 提供了额外 mechanistic evidence。 这部分分析在 Plan A 下变得更重要，作为 h-sweep 的补充。\\n\\nEpisode-level 优势在长 episode 任务上更大：pick（最短，18 steps）episode-level 也只有 50%， 但 step-independent 还有 5%；examine 和 pick_two（35-40 steps）episode-level 20-22% 而 step-independent 0%。Correlation -0.82 说明 episode length 越长，step-independent 的 sign misattribution 越严重（更多 window 的 advantage sign 被 episode outcome 污染）。 Pick 任务 step-independent 残存 5% success 因为有些 pick 任务 trajectory 短到 1-2 个 window， sign misattribution 的伤害较小。\\n\"\n1167\t  }\n1168\t]"}]},"parent_tool_use_id":"toolu_01XS4LZkjt62xaP1Q64ZRwjr","session_id":"c1b768d7-c0d6-42f3-9a34-70349ec3e8c8","uuid":"626acd74-3816-45fa-88f5-2a98bab184db","timestamp":"2026-05-17T14:09:05.046Z"}
