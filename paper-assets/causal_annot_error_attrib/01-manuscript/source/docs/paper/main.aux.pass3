\@writefile{loa}{\contentsline {algorithm}{\numberline {1}{\ignorespaces Correction method selection for LLM-annotated causal inference. This topology-based classification is robust to $\varepsilon $-approximate deviations; practitioners computing quantitative ASV thresholds should note the $\varepsilon $-approximate bounds (Conjecture~\ref {conj:monotone}, Section~\ref {sec:asv}). Assumes linear structural equations; FWL-based routing may not apply under nonlinear models (see Appendix~\ref {sec:logistic_dgp}). Thresholds calibrated for $K{=}3$ linear SEM; recalibrate for different $K$ using topology-specific bias functions.}}{33}{algorithm.1}\protected@file@percent }
\newlabel{alg:correction}{{1}{33}{Correction method selection for LLM-annotated causal inference. This topology-based classification is robust to $\varepsilon $-approximate deviations; practitioners computing quantitative ASV thresholds should note the $\varepsilon $-approximate bounds (Conjecture~\ref {conj:monotone}, Section~\ref {sec:asv}). Assumes linear structural equations; FWL-based routing may not apply under nonlinear models (see Appendix~\ref {sec:logistic_dgp}). Thresholds calibrated for $K{=}3$ linear SEM; recalibrate for different $K$ using topology-specific bias functions}{algorithm.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces Non-differential misclassification stress test: sign flip rate (SF) and mean bias ratio (BR\,$=\overline  {|\hat  \tau /\tau |}$) under increasing differential departure $\varepsilon $.}}{34}{table.caption.83}\protected@file@percent }
\newlabel{tab:stress-test}{{9}{34}{Non-differential misclassification stress test: sign flip rate (SF) and mean bias ratio (BR\,$=\overline {|\hat \tau /\tau |}$) under increasing differential departure $\varepsilon $}{table.caption.83}{}}
\@writefile{lot}{\contentsline {table}{\numberline {10}{\ignorespaces ASV stability across DGP configurations. Each cell shows $\delta ^*$ at the 10\% relative bias threshold (median over 5 confusion matrices with diagonal $\in \{0.5,0.6,0.7,0.8,0.9\}$). Lower $\delta ^*$ indicates greater fragility. Confounding is consistently most robust; for alternating-sign $\boldsymbol  {\beta }$, the ranking Exposure $<$ IV $<$ Confounding holds. ``$\infty $\!\!'' = threshold never reached within $\delta $ range.}}{35}{table.caption.86}\protected@file@percent }
\newlabel{tab:asv_stability}{{10}{35}{ASV stability across DGP configurations. Each cell shows $\delta ^*$ at the 10\% relative bias threshold (median over 5 confusion matrices with diagonal $\in \{0.5,0.6,0.7,0.8,0.9\}$). Lower $\delta ^*$ indicates greater fragility. Confounding is consistently most robust; for alternating-sign $\boldsymbol {\beta }$, the ranking Exposure $<$ IV $<$ Confounding holds. ``$\infty $\!\!'' = threshold never reached within $\delta $ range}{table.caption.86}{}}
\@writefile{lot}{\contentsline {table}{\numberline {11}{\ignorespaces Envelope monotonicity violations per 10{,}000 random $C_0$ matrices ($\delta $ step $= 0.01$). ``Worst mag.''\ is the largest single-step deviation $|B(\delta _{i+1})|-|B(\delta _i)|$ in the non-monotonic direction. $^*$100{,}000 matrices at step $= 0.005$ yield exposure $\varepsilon = 0.075$.}}{35}{table.caption.87}\protected@file@percent }
\newlabel{tab:conjecture_verify}{{11}{35}{Envelope monotonicity violations per 10{,}000 random $C_0$ matrices ($\delta $ step $= 0.01$). ``Worst mag.''\ is the largest single-step deviation $|B(\delta _{i+1})|-|B(\delta _i)|$ in the non-monotonic direction. $^*$100{,}000 matrices at step $= 0.005$ yield exposure $\varepsilon = 0.075$}{table.caption.87}{}}
\@writefile{lot}{\contentsline {table}{\numberline {12}{\ignorespaces $\varepsilon \equiv \max _\delta (|B(\delta {+}\Delta )|{-}|B(\delta )|)/|\tau _{\text  {true}}|$ in the non-monotonic direction (max over $K \in \{3,5,7\}$; 10{,}000 random $C_0$ per cell). Bold marks $\varepsilon > 0.02$ (non-exposure) or $\varepsilon > 0.08$ (exposure). Counts in parentheses are violations / 30{,}000. Tables~\ref {tab:conjecture_verify} and~\ref {tab:conjecture_tau_sens} use independent random seeds; for topologies with low violation rates (exposure $<$0.02\%), the worst-case $\varepsilon $ is sample-sensitive.}}{35}{table.caption.89}\protected@file@percent }
\newlabel{tab:conjecture_tau_sens}{{12}{35}{$\varepsilon \equiv \max _\delta (|B(\delta {+}\Delta )|{-}|B(\delta )|)/|\tau _{\text {true}}|$ in the non-monotonic direction (max over $K \in \{3,5,7\}$; 10{,}000 random $C_0$ per cell). Bold marks $\varepsilon > 0.02$ (non-exposure) or $\varepsilon > 0.08$ (exposure). Counts in parentheses are violations / 30{,}000. Tables~\ref {tab:conjecture_verify} and~\ref {tab:conjecture_tau_sens} use independent random seeds; for topologies with low violation rates (exposure $<$0.02\%), the worst-case $\varepsilon $ is sample-sensitive}{table.caption.89}{}}
\@writefile{lot}{\contentsline {table}{\numberline {13}{\ignorespaces Conjecture~1 DGP sensitivity: worst-case $\varepsilon _{\text  {rel}} = \max _{C_0} (\text  {wrong-direction step})/|\tau _{\text  {true}}|$ across 5 effect magnitudes $\beta $, 3 noise variances $\sigma ^2$, and 7 topologies ($K{=}3$, 10{,}000 Dirichlet$(1,\ldots  ,1)$ matrices per cell). $\varepsilon $ scales approximately linearly with $|\beta |$ for non-exposure topologies; the safe/fragile partition is stable across all cells.}}{35}{table.caption.91}\protected@file@percent }
\newlabel{tab:dgp_sensitivity}{{13}{35}{Conjecture~1 DGP sensitivity: worst-case $\varepsilon _{\text {rel}} = \max _{C_0} (\text {wrong-direction step})/|\tau _{\text {true}}|$ across 5 effect magnitudes $\beta $, 3 noise variances $\sigma ^2$, and 7 topologies ($K{=}3$, 10{,}000 Dirichlet$(1,\ldots ,1)$ matrices per cell). $\varepsilon $ scales approximately linearly with $|\beta |$ for non-exposure topologies; the safe/fragile partition is stable across all cells}{table.caption.91}{}}
\@writefile{lot}{\contentsline {table}{\numberline {14}{\ignorespaces $\lambda (C)$ out-of-bounds rate and mediation sign failure rate by degree of departure from proportional effects ($K{=}3$, 100K random confusion matrices per row).}}{35}{table.caption.92}\protected@file@percent }
\newlabel{tab:proportional_effects}{{14}{35}{$\lambda (C)$ out-of-bounds rate and mediation sign failure rate by degree of departure from proportional effects ($K{=}3$, 100K random confusion matrices per row)}{table.caption.92}{}}
\@writefile{lot}{\contentsline {table}{\numberline {15}{\ignorespaces Mean logistic bias reduction (\%) from matrix-based correction, by topology and error level (averaged over $N \in \{1K, 5K, 10K, 50K\}$; 200 MC reps each). Under linear OLS, all covariate topologies yield exactly 0\%. Exposure is shown for comparison.}}{35}{table.caption.93}\protected@file@percent }
\newlabel{tab:fwl_nonlinear}{{15}{35}{Mean logistic bias reduction (\%) from matrix-based correction, by topology and error level (averaged over $N \in \{1K, 5K, 10K, 50K\}$; 200 MC reps each). Under linear OLS, all covariate topologies yield exactly 0\%. Exposure is shown for comparison}{table.caption.93}{}}
\@writefile{lot}{\contentsline {table}{\numberline {16}{\ignorespaces PPI++ RMSE reduction (\%) vs.\ gold label fraction across five topologies. Negative values indicate PPI++ increases RMSE relative to the naive estimator.}}{35}{table.caption.94}\protected@file@percent }
\newlabel{tab:ppi_gold_ratio}{{16}{35}{PPI++ RMSE reduction (\%) vs.\ gold label fraction across five topologies. Negative values indicate PPI++ increases RMSE relative to the naive estimator}{table.caption.94}{}}
\@writefile{lot}{\contentsline {table}{\numberline {17}{\ignorespaces Safe differential misclassification thresholds $\varepsilon ^*_{\text  {safe}}$ by dataset/K. For $K{=}2$ (binary), no configuration produces sign reversal up to $\varepsilon {=}0.50$. For $K{\geq }3$, the majority of configurations are fragile ($\varepsilon ^*_{\text  {safe}}{=}0$), confirming that the non-differential assumption is load-bearing for multi-class exposure.}}{36}{table.caption.95}\protected@file@percent }
\newlabel{tab:realistic_epsilon}{{17}{36}{Safe differential misclassification thresholds $\varepsilon ^*_{\text {safe}}$ by dataset/K. For $K{=}2$ (binary), no configuration produces sign reversal up to $\varepsilon {=}0.50$. For $K{\geq }3$, the majority of configurations are fragile ($\varepsilon ^*_{\text {safe}}{=}0$), confirming that the non-differential assumption is load-bearing for multi-class exposure}{table.caption.95}{}}
\@writefile{lot}{\contentsline {table}{\numberline {18}{\ignorespaces Proportional effects validation with 23 real LLM confusion matrices under mediation DGP. $\lambda (C) \in [0,1]$: proportion satisfying the Theorem~\ref {thm:monotone} bound. Sign pres.: sign preservation rate of the direct effect estimate.}}{36}{table.caption.96}\protected@file@percent }
\newlabel{tab:proportional_empirical}{{18}{36}{Proportional effects validation with 23 real LLM confusion matrices under mediation DGP. $\lambda (C) \in [0,1]$: proportion satisfying the Theorem~\ref {thm:monotone} bound. Sign pres.: sign preservation rate of the direct effect estimate}{table.caption.96}{}}
\@writefile{lot}{\contentsline {table}{\numberline {19}{\ignorespaces End-to-end demo over 100 replicates (N=10,000, K=3, 20\% gold). Confounding: plug-in corrections leave the treatment coefficient unchanged (FWL invariance), so Algorithm~1 routes to ``no correction''. Exposure: PPI++ recovers the target coefficient. IV: Wald estimator instability produces large bias; PPI++ (OLS-based) is limited, routing to MC-SIMEX.}}{36}{table.caption.97}\protected@file@percent }
\newlabel{tab:e2e-demo}{{19}{36}{End-to-end demo over 100 replicates (N=10,000, K=3, 20\% gold). Confounding: plug-in corrections leave the treatment coefficient unchanged (FWL invariance), so Algorithm~1 routes to ``no correction''. Exposure: PPI++ recovers the target coefficient. IV: Wald estimator instability produces large bias; PPI++ (OLS-based) is limited, routing to MC-SIMEX}{table.caption.97}{}}
\@writefile{lot}{\contentsline {table}{\numberline {20}{\ignorespaces Semi-real case study with VAST K=3 confusion matrices from 10 LLM configurations. Bias is relative to true $\tau $. Exposure: PPI++ substantially reduces bias. Confounding: plug-in correction is ineffective (FWL invariance).}}{36}{table.caption.98}\protected@file@percent }
\newlabel{tab:e2e-real-cm}{{20}{36}{Semi-real case study with VAST K=3 confusion matrices from 10 LLM configurations. Bias is relative to true $\tau $. Exposure: PPI++ substantially reduces bias. Confounding: plug-in correction is ineffective (FWL invariance)}{table.caption.98}{}}
