\newlabel{tab:c_robustness}{{24}{36}{$\hat {C}$ estimation robustness: safe/fragile partition stability and ASV ranking correlation (Spearman $\rho $ vs.\ true-$C$ ranking) under multinomial bootstrap from finite gold sets. 8 empirical matrices $\times $ 200 bootstrap replicates per $n_{\text {gold}}$}{table.caption.104}{}}
\@writefile{lot}{\contentsline {table}{\numberline {25}{\ignorespaces Sign reversal rates by $K$ and best single-feature decision rule. Rule: $\det (C) < 0.014 \to $ sign reversal (accuracy 91.3\%, sensitivity 85.7\%, specificity 100\%). An AND rule ($\min _k C_{kk} < 0.55$ and mean entropy $> 0.40$) achieves 95.7\% accuracy with 100\% sensitivity.}}{36}{table.caption.105}\protected@file@percent }
\newlabel{tab:sign_determinants}{{25}{36}{Sign reversal rates by $K$ and best single-feature decision rule. Rule: $\det (C) < 0.014 \to $ sign reversal (accuracy 91.3\%, sensitivity 85.7\%, specificity 100\%). An AND rule ($\min _k C_{kk} < 0.55$ and mean entropy $> 0.40$) achieves 95.7\% accuracy with 100\% sensitivity}{table.caption.105}{}}
