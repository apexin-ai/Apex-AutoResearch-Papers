\@writefile{lot}{\contentsline {table}{\numberline {23}{\ignorespaces Within-topology Spearman $\rho (F_1, |\text  {bias}|)$ across 23 empirical LLM configurations $\times $ 3 datasets. Negative $\rho $: higher $F_1$ $\to $ lower bias (expected). Positive $\rho $: higher $F_1$ $\to $ higher bias (protective attenuation removed).}}{36}{table.caption.103}\protected@file@percent }
\newlabel{tab:within_topo_f1}{{23}{36}{Within-topology Spearman $\rho (F_1, |\text {bias}|)$ across 23 empirical LLM configurations $\times $ 3 datasets. Negative $\rho $: higher $F_1$ $\to $ lower bias (expected). Positive $\rho $: higher $F_1$ $\to $ higher bias (protective attenuation removed)}{table.caption.103}{}}
