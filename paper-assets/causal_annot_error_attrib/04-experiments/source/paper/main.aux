\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Bias distributions under 10{,}000 random $K{=}3$ confusion matrices for seven topologies. Red shading indicates sign reversal ($\hat  {\tau }$ opposite to $\tau $). Exposure exhibits 83.4\% $\beta _1$ sign reversal; the IV Wald estimator shows 52.6\% sign reversal. The five safe topologies show attenuation without sign flip.}}{21}{figure.2}\protected@file@percent }
\newlabel{fig:bias_distribution}{{2}{21}{Bias distributions under 10{,}000 random $K{=}3$ confusion matrices for seven topologies. Red shading indicates sign reversal ($\hat {\tau }$ opposite to $\tau $). Exposure exhibits 83.4\% $\beta _1$ sign reversal; the IV Wald estimator shows 52.6\% sign reversal. The five safe topologies show attenuation without sign flip}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces ASV sensitivity ranking across topologies. Three ASV types (magnitude, significance, sign-flip) reveal a topology-dependent vulnerability spectrum from IV (maximally fragile, magnitude ASV $= 0.101$--$0.607$) to M-bias (immune, ASV $= \infty $).}}{22}{figure.3}\protected@file@percent }
\newlabel{fig:asv_ranking}{{3}{22}{ASV sensitivity ranking across topologies. Three ASV types (magnitude, significance, sign-flip) reveal a topology-dependent vulnerability spectrum from IV (maximally fragile, magnitude ASV $= 0.101$--$0.607$) to M-bias (immune, ASV $= \infty $)}{figure.3}{}}
