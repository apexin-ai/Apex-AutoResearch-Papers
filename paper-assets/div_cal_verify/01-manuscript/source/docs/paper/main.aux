\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Pairwise statistical comparisons at Generation~7. GPT2-125M rows: $n{=}3$ seeds per method. All pairwise tests use Welch's $t$-test (two-sided, unequal variance). PPL: perplexity on WikiText-103 validation set. Rare: rare trigram ratio. $\Delta $: difference (row method $-$ column method for pairwise; not applicable for ANOVA). Cohen's $d$: standardized effect size. RGDS differs significantly from all non-RGDS methods on both metrics ($p < .05$, $|d| > 4$). Within the non-RGDS cluster, PPL differences are not significant (ANOVA $p = .219$), but rare n-gram differences are (ANOVA $p = .007$). 355M: $n{=}2$ seeds (42, 123); seed=456 pending; $t$-tests deferred until $n \geq 3$.}}{11}{table.caption.14}\protected@file@percent }
\newlabel{tab:stat_tests}{{3}{11}{Pairwise statistical comparisons at Generation~7. GPT2-125M rows: $n{=}3$ seeds per method. All pairwise tests use Welch's $t$-test (two-sided, unequal variance). PPL: perplexity on WikiText-103 validation set. Rare: rare trigram ratio. $\Delta $: difference (row method $-$ column method for pairwise; not applicable for ANOVA). Cohen's $d$: standardized effect size. RGDS differs significantly from all non-RGDS methods on both metrics ($p < .05$, $|d| > 4$). Within the non-RGDS cluster, PPL differences are not significant (ANOVA $p = .219$), but rare n-gram differences are (ANOVA $p = .007$). 355M: $n{=}2$ seeds (42, 123); seed=456 pending; $t$-tests deferred until $n \geq 3$}{table.caption.14}{}}
\@LN@col{1}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces GPT2-Medium (355M) Generation~7 perplexity by seed. PPL$_{42}$ and PPL$_{123}$: WikiText-103 validation perplexity for each seed. RGDS and Uncurated ordering flips across seeds (82.84 vs.\ 91.66 at seed=42; 90.25 vs.\ 87.05 at seed=123). All seed=456 experiments are pending.}}{11}{table.caption.15}\protected@file@percent }
\newlabel{tab:medium_comparison}{{4}{11}{GPT2-Medium (355M) Generation~7 perplexity by seed. PPL$_{42}$ and PPL$_{123}$: WikiText-103 validation perplexity for each seed. RGDS and Uncurated ordering flips across seeds (82.84 vs.\ 91.66 at seed=42; 90.25 vs.\ 87.05 at seed=123). All seed=456 experiments are pending}{table.caption.15}{}}
