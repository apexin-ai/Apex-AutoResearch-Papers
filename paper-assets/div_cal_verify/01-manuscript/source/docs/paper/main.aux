\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Generation~7 summary across methods (GPT2-125M on WikiText-103). PPL: perplexity on WikiText-103 validation set (lower is better). Sel.\ Ratio: mean rare trigram density of the selected subset divided by that of the rejected subset ($>$1 = selected samples richer in rare n-grams than rejected). Rare n-gram: proportion of generated trigrams at or below the 10th percentile of the WikiText-103 frequency distribution. RankMe: effective embedding rank via singular value entropy. $\Delta $\%: relative perplexity increase from Generation~0 to Generation~7. All methods report $n{=}3$ seeds.}}{8}{table.caption.11}\protected@file@percent }
\newlabel{tab:gen7_summary}{{2}{8}{Generation~7 summary across methods (GPT2-125M on WikiText-103). PPL: perplexity on WikiText-103 validation set (lower is better). Sel.\ Ratio: mean rare trigram density of the selected subset divided by that of the rejected subset ($>$1 = selected samples richer in rare n-grams than rejected). Rare n-gram: proportion of generated trigrams at or below the 10th percentile of the WikiText-103 frequency distribution. RankMe: effective embedding rank via singular value entropy. $\Delta $\%: relative perplexity increase from Generation~0 to Generation~7. All methods report $n{=}3$ seeds}{table.caption.11}{}}
\@LN@col{1}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Per-generation perplexity trajectories across four data selection methods (GPT2-125M on WikiText-103). Lines show means over $n{=}3$ seeds; shaded bands show $\pm $1 standard deviation. RGDS diverges from the non-RGDS cluster after Generation~4 and reaches catastrophic perplexity by Generation~7 ($74.29 \pm 7.71$), while the other three methods converge to a narrow band (43--47).}}{8}{figure.caption.12}\protected@file@percent }
\newlabel{fig:ppl_trends}{{1}{8}{Per-generation perplexity trajectories across four data selection methods (GPT2-125M on WikiText-103). Lines show means over $n{=}3$ seeds; shaded bands show $\pm $1 standard deviation. RGDS diverges from the non-RGDS cluster after Generation~4 and reaches catastrophic perplexity by Generation~7 ($74.29 \pm 7.71$), while the other three methods converge to a narrow band (43--47)}{figure.caption.12}{}}
