\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces RankMe and $k$-NN under RGDS collapse (seed=42). Despite catastrophic PPL and rare $n$-gram degradation, RankMe \emph  {increases} and $k$-NN is stable. These metrics track geometric structure, not content diversity.}}{5}{table.caption.7}\protected@file@percent }
\newlabel{tab:metrics_blind}{{3}{5}{RankMe and $k$-NN under RGDS collapse (seed=42). Despite catastrophic PPL and rare $n$-gram degradation, RankMe \emph {increases} and $k$-NN is stable. These metrics track geometric structure, not content diversity}{table.caption.7}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Re-anchoring results (gen 7, GPT-2 125M, seed=42). Re-anchoring largely eliminates the selection ratio degradation ($0.52 \to 0.95$) and recovers most of the PPL gap. Rare $n$-gram recovery is partial ($+33\%$), localizing residual loss to the generation side.}}{5}{table.caption.8}\protected@file@percent }
\newlabel{tab:reanchor}{{4}{5}{Re-anchoring results (gen 7, GPT-2 125M, seed=42). Re-anchoring largely eliminates the selection ratio degradation ($0.52 \to 0.95$) and recovers most of the PPL gap. Rare $n$-gram recovery is partial ($+33\%$), localizing residual loss to the generation side}{table.caption.8}{}}
