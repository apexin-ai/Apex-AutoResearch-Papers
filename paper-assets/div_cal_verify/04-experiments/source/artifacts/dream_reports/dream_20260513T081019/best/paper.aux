\newlabel{tab:sel_ratio}{{1}{4}{Selection ratio across generations (seed=42). RGDS ratio drops monotonically below 1.0, indicating the selector increasingly favors vocabulary-poor samples. External embeddings maintain ratio $>1.0$ throughout}{table.caption.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Core metrics at generations 0 and 7 (GPT-2 125M, WikiText-103). RGDS worsens both PPL (+50\% vs uncurated) and rare $n$-gram survival ($-$47\%). 3-seed 95\% CIs for RGDS vs uncurated PPL do not overlap: $[67.9, 77.1]$ vs $[46.0, 50.6]$, $p < 0.01$.}}{4}{table.caption.6}\protected@file@percent }
\newlabel{tab:main_full}{{2}{4}{Core metrics at generations 0 and 7 (GPT-2 125M, WikiText-103). RGDS worsens both PPL (+50\% vs uncurated) and rare $n$-gram survival ($-$47\%). 3-seed 95\% CIs for RGDS vs uncurated PPL do not overlap: $[67.9, 77.1]$ vs $[46.0, 50.6]$, $p < 0.01$}{table.caption.6}{}}
