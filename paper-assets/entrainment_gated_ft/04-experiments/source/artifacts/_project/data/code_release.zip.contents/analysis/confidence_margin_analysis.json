  "cross_arch_narrative": "hurt_borderline_consistent",
  "narrative_text": "All 3 architectures show hurt samples have significantly lower pure-model confidence margins than helped samples (all p < 1e-60, Cohen d > 1.2). This is the OPPOSITE of the borderline hypothesis: attention does NOT primarily help borderline cases. Instead, attention corrects high-confidence errors (helped: mean margin ~2.5) while disrupting low-confidence correct predictions (hurt: mean margin ~1.0-1.5). The pure model confidence is a strong predictor of whether attention will help or hurt on a given example.",
  "rebuttal_implications": {
    "overturns_opaque": true,
    "finding": "Attention effect is NOT opaque w.r.t. confidence margin. Hurt samples cluster near the decision boundary; helped samples are confidently wrong under pure model.",
    "rebuttal_use": "If reviewer asks why attention helps/hurts unpredictably: confidence margin analysis shows attention systematically rescues high-confidence errors and destabilizes borderline-correct predictions. The effect is predictable from pure-model confidence, even though surface/perplexity features show no signal.",
    "effect_sizes": {
      "GDN": "Cohen d=1.45, r_rb=-0.78",
      "RetNet": "Cohen d=1.39, r_rb=-0.71",
      "HGRN2": "Cohen d=1.22, r_rb=-0.64"
    }
  }
