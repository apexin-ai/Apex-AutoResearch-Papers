{
  "description": "A3: Complementarity Decomposition Analysis",
  "methodology": {
    "categories": {
      "unanimous_correct": "3_of_3: all 3 architectures correct \u2192 redundant correct",
      "unanimous_wrong": "0_of_3: all 3 architectures wrong \u2192 redundant wrong (hard examples)",
      "minority_correct": "1_of_3: exactly 1 correct, 2 wrong \u2192 complementary but MV-hostile (MV votes wrong)",
      "majority_correct": "2_of_3: exactly 2 correct, 1 wrong \u2192 complementary and MV-exploitable"
    },
    "derived_metrics": {
      "oracle_exploitable": "1_of_3 + 2_of_3 (any disagreement where at least one is correct)",
      "mv_exploitable": "2_of_3 only (MV needs majority to be correct)",
      "mv_hostile": "1_of_3 (MV votes with wrong majority \u2014 actively harmful)",
      "redundant_total": "0_of_3 + 3_of_3 (all agree, no ensemble value)",
      "complementary_total": "1_of_3 + 2_of_3 (disagreement with at least one correct)",
      "mv_exploitation_ratio": "2_of_3 / (1_of_3 + 2_of_3) \u2014 fraction of complementary cases MV can exploit",
      "minority_dominance": "1_of_3 / (1_of_3 + 2_of_3) \u2014 fraction of complementary cases where MV fails"
    }
  },
