\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces Steps to reach accuracy milestones (Qwen-7B). Exception-only reaches 95\% in $\sim $50 steps, 5$\times $ faster than full-trace reaches 80\%. Full-trace shows non-monotonic behavior (epoch~2 dip), indicating information overload destabilizes training.}}{7}{table.7}\protected@file@percent }
\newlabel{tab:dynamics}{{7}{7}{Steps to reach accuracy milestones (Qwen-7B). Exception-only reaches 95\% in $\sim $50 steps, 5$\times $ faster than full-trace reaches 80\%. Full-trace shows non-monotonic behavior (epoch~2 dip), indicating information overload destabilizes training}{table.7}{}}
\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces Out-of-distribution generalization. Absolute accuracy degrades 3.3pp within-language and 8--9pp cross-language, but the diagnostic signal advantage ($\sim $24pp lift over no-trace) is preserved across all settings.}}{7}{table.8}\protected@file@percent }
\newlabel{tab:ood}{{8}{7}{Out-of-distribution generalization. Absolute accuracy degrades 3.3pp within-language and 8--9pp cross-language, but the diagnostic signal advantage ($\sim $24pp lift over no-trace) is preserved across all settings}{table.8}{}}
