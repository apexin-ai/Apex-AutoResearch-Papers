\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Verdict accuracy and calibration by trace condition (Qwen-7B, seed42). Exception-only and assertion-point (ae\_only) are Tier~1 signals; both achieve near-perfect accuracy and calibration. VOTA combines Tier~1 and Tier~2 but performs slightly worse than Tier~1 alone.}}{4}{table.1}\protected@file@percent }
\newlabel{tab:core_ablation}{{1}{4}{Verdict accuracy and calibration by trace condition (Qwen-7B, seed42). Exception-only and assertion-point (ae\_only) are Tier~1 signals; both achieve near-perfect accuracy and calibration. VOTA combines Tier~1 and Tier~2 but performs slightly worse than Tier~1 alone}{table.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Cross-model calibration for exception-only training. ECE ratio is relative to no-trace baseline (ECE = 0.171). Excluding the DeepSeek seed123 outlier, all models achieve ECE $\leq $ 0.008, a 21--86$\times $ improvement. DeepSeek seed123 is a LoRA initialization outlier (fail recall = 0.705).}}{4}{table.2}\protected@file@percent }
\newlabel{tab:calibration}{{2}{4}{Cross-model calibration for exception-only training. ECE ratio is relative to no-trace baseline (ECE = 0.171). Excluding the DeepSeek seed123 outlier, all models achieve ECE $\leq $ 0.008, a 21--86$\times $ improvement. DeepSeek seed123 is a LoRA initialization outlier (fail recall = 0.705)}{table.2}{}}
\@writefile{toc}{\contentsline {section}{\numberline {4}Experiments}{4}{section.4}\protected@file@percent }
