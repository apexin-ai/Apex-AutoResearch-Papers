\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces SFT exception-only vs. frontier model few-shot comparison. A 1.5B SFT model outperforms GPT-4o 3-shot by 3.3pp while costing 250$\times $ less. Error counts: SFT produces 2 errors (irreducible) vs. $\sim $42 for GPT-4o 3-shot, a 21$\times $ difference.}}{6}{table.5}\protected@file@percent }
\newlabel{tab:frontier}{{5}{6}{SFT exception-only vs. frontier model few-shot comparison. A 1.5B SFT model outperforms GPT-4o 3-shot by 3.3pp while costing 250$\times $ less. Error counts: SFT produces 2 errors (irreducible) vs. $\sim $42 for GPT-4o 3-shot, a 21$\times $ difference}{table.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Error mode distribution (Qwen-7B). f$\to $p = fail predicted as pass. Exception-only errors are entirely due to \texttt  {GeneratorExit}, a representation-inherent artifact. Full-trace errors correlate with trace length ($r = 0.42$).}}{6}{table.6}\protected@file@percent }
\newlabel{tab:errors}{{6}{6}{Error mode distribution (Qwen-7B). f$\to $p = fail predicted as pass. Exception-only errors are entirely due to \texttt {GeneratorExit}, a representation-inherent artifact. Full-trace errors correlate with trace length ($r = 0.42$)}{table.6}{}}
