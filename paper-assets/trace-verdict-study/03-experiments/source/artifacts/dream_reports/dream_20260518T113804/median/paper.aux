\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Budget curve: accuracy (\%) by tail truncation length across four models. All models converge to $>$93\% at tail-512, but the transition from 256 to 512 is model-dependent: stronger models (Qwen-7B, CodeLlama-13B) show gradual onset, weaker models (DeepSeek, Qwen-1.5B) exhibit sharp thresholds. $\dagger $: CodeLlama tail-2048 collapsed.}}{5}{table.3}\protected@file@percent }
\newlabel{tab:budget}{{3}{5}{Budget curve: accuracy (\%) by tail truncation length across four models. All models converge to $>$93\% at tail-512, but the transition from 256 to 512 is model-dependent: stronger models (Qwen-7B, CodeLlama-13B) show gradual onset, weaker models (DeepSeek, Qwen-1.5B) exhibit sharp thresholds. $\dagger $: CodeLlama tail-2048 collapsed}{table.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Cross-seed tail-512 robustness (3 seeds $\times $ 4 models). Seed variance correlates with model strength: stronger models (CodeLlama std = 0.5pp, Qwen-7B std = 1.0pp) are near-deterministic, while weaker models (DeepSeek std = 3.2pp, Qwen-1.5B std = 2.9pp) show wider bands.}}{5}{table.4}\protected@file@percent }
\newlabel{tab:seeds}{{4}{5}{Cross-seed tail-512 robustness (3 seeds $\times $ 4 models). Seed variance correlates with model strength: stronger models (CodeLlama std = 0.5pp, Qwen-7B std = 1.0pp) are near-deterministic, while weaker models (DeepSeek std = 3.2pp, Qwen-1.5B std = 2.9pp) show wider bands}{table.4}{}}
