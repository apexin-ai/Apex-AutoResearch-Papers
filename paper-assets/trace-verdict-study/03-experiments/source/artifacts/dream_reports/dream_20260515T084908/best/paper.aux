\newlabel{app:seeds}{{B}{9}{Seed Robustness}{appendix.B}{}}
\@writefile{lot}{\contentsline {table}{\numberline {10}{\ignorespaces Seed robustness across three random seeds. \textsc  {Vota}{} shows minimal variance (std $= 0.15\,\text  {pp}$), with all seeds preserving the three-condition gradient. Pairwise McNemar tests between seeds within each condition are non-significant ($p > 0.10$).}}{9}{table.10}\protected@file@percent }
\newlabel{tab:seeds}{{10}{9}{Seed robustness across three random seeds. \vota {} shows minimal variance (std $= 0.15\pp $), with all seeds preserving the three-condition gradient. Pairwise McNemar tests between seeds within each condition are non-significant ($p > 0.10$)}{table.10}{}}
