\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces Actual/expected (ae) component isolation. ae\_only achieves 88.0\%, but this is confounded by structural fallback: when tests crash before reaching assertions, the ae trace is empty/``no assertions reached,'' which itself is a strong fail signal. Combined with \textsc  {Vota}{}\_no\_ae (99.4\%), this confirms ae values are redundant in the full \textsc  {Vota}{} representation.}}{9}{table.9}\protected@file@percent }
\newlabel{tab:ae_only}{{9}{9}{Actual/expected (ae) component isolation. ae\_only achieves 88.0\%, but this is confounded by structural fallback: when tests crash before reaching assertions, the ae trace is empty/``no assertions reached,'' which itself is a strong fail signal. Combined with \vota {}\_no\_ae (99.4\%), this confirms ae values are redundant in the full \vota {} representation}{table.9}{}}
