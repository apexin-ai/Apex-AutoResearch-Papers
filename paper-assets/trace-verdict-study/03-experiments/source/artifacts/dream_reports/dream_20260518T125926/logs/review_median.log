{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NixjokYicGeZCqi1iwVFL5","type":"tool_result","content":"{\"result\":\"{\\\"success\\\": true, \\\"data\\\": {\\\"path\\\": \\\"/home/ubuntu/.agent-ml-research-idea_gen_0509_4/projects/trace-verdict-study/writing_plan.yaml\\\", \\\"content\\\": \\\"# trace-verdict-study — 论文写作计划\\\\n# 生成日期: 2026-05-15\\\\n# 投稿目标: EMNLP 2026 Main (ARR May 25, 2026)\\\\n\\\\nsubmission:\\\\n  venue: \\\\\\\"EMNLP 2026 Main (ARR)\\\\\\\"\\\\n  deadline: \\\\\\\"2026-05-25\\\\\\\"\\\\n  format: \\\\\\\"8 pages + unlimited references + unlimited appendix\\\\\\\"\\\\n  fallback: \\\\\\\"EMNLP 2026 Findings\\\\\\\"\\\\n  paper_type: \\\\\\\"Empirical study\\\\\\\"\\\\n  title_candidates:\\\\n    - \\\\\\\"Exception Is All You Need: Fault Detection as a Universal Mechanism for Verdict Prediction\\\\\\\"\\\\n    - \\\\\\\"What Makes Traces Work for Verdict Prediction? An Empirical Study of Diagnostic Signal Sufficiency\\\\\\\"\\\\n    - \\\\\\\"Beyond Trace Reasoning: Exception Events as Model-Agnostic Signals for Verdict Prediction\\\\\\\"\\\\n\\\\n# ============================================================\\\\n# 论文 Outline\\\\n# ============================================================\\\\noutline:\\\\n\\\\n  # ----------------------------------------------------------\\\\n  # Section 1: Introduction (~1.2 pages)\\\\n  # ----------------------------------------------------------\\\\n  - section: \\\\\\\"1. Introduction\\\\\\\"\\\\n    status: write_now  # 不依赖 pending 结果，核心 framing 已定\\\\n    estimated_length: \\\\\\\"1.2 pages\\\\\\\"\\\\n    key_points:\\\\n      - \\\\\\\"Trace SFT 在代码生成任务上效果不一致 (DCSH, TracePile)，verdict prediction 场景未被探索\\\\\\\"\\\\n      - \\\\\\\"提出核心问题: verdict prediction 的 minimal sufficient diagnostic signal 是什么？\\\\\\\"\\\\n      - \\\\\\\"Reframe verdict prediction 为 fault detection task\\\\\\\"\\\\n      - \\\\\\\"Headline result: exception_only 跨模型 99.83%/99.33% (gap=0.50pp), VOTA gap=14.96pp\\\\\\\"\\\\n      - \\\\\\\"三个 contributions 对应三个 claims\\\\\\\"\\\\n    contributions:\\\\n      - \\\\\\\"首次系统研究 execution trace SFT 在 verdict prediction (binary pass/fail) 上的效果\\\\\\\"\\\\n      - \\\\\\\"发现 exception event 是 model-agnostic diagnostic signal，跨模型 gap=0.50pp\\\\\\\"\\\\n      - \\\\\\\"通过 component ablation 和 loss ablation 揭示 information density (74%) 而非 gradient dilution (26%) 是 trace compression 的主要驱动力\\\\\\\"\\\\n    supporting_experiments: []  # 综合引用全部实验\\\\n    writing_notes: \\\\\\\"开头用 DCSH 'no single trace consistently outperforms' 作为 motivation; 第二段引 TracePile scaling 但 generation-only; 第三段提出 fault detection reframing; 第四段 headline numbers; 第五段 contributions list\\\\\\\"\\\\n\\\\n  # ----------------------------------------------------------\\\\n  # Section 2: Related Work (~1.0 page)\\\\n  # ----------------------------------------------------------\\\\n  - section: \\\\\\\"2. Related Work\\\\\\\"\\\\n    status: write_now\\\\n    estimated_length: \\\\\\\"1.0 page\\\\\\\"\\\\n    subsections:\\\\n      - name: \\\\\\\"2.1 Execution Trace SFT for Code LLMs\\\\\\\"\\\\n        key_refs:\\\\n          - \\\\\\\"DCSH (Wang et al., EMNLP Findings 2025) — 5 trace formats, generation tasks, inconsistent\\\\\\\"\\\\n          - \\\\\\\"TracePile (Chen et al., NeurIPS 2025) — 2.6M samples, generation only\\\\\\\"\\\\n          - \\\\\\\"NExT (Ni et al., ICML 2024) — self-training on trace CoT\\\\\\\"\\\\n          - \\\\\\\"ET-CoT (Eguchi & Akiba, ICML 2025 Workshop) — sub-line trace for Qwen\\\\\\\"\\\\n          - \\\\\\\"TRACED (Ding et al., ICSE 2024) — encoder-based execution-aware pretraining\\\\\\\"\\\\n        positioning: \\\\\\\"先前工作全部评估生成任务 (code generation/repair); 无人测试 verdict classification; 无人做 component ablation\\\\\\\"\\\\n      - name: \\\\\\\"2.2 Code Verdict Prediction\\\\\\\"\\\\n        key_refs:\\\\n          - \\\\\\\"APPT (TSE 2024) — BERT+LSTM patch correctness, 79.7%\\\\\\\"\\\\n          - \\\\\\\"LLM4PatchCorrect (TSE 2024) — zero-shot with trace input, 84.4%\\\\\\\"\\\\n          - \\\\\\\"APSG (Yang et al., 2025) — Graph-LoRA patch correctness\\\\\\\"\\\\n          - \\\\\\\"Calibration (Spiess et al., ICSE 2025) — code LLM calibration\\\\\\\"\\\\n        positioning: \\\\\\\"patch correctness ≠ verdict prediction (不同输入空间); 无人用 SFT + trace signal 做 verdict\\\\\\\"\\\\n      - name: \\\\\\\"2.3 Trace Compression and Selective Execution Analysis\\\\\\\"\\\\n        key_refs:\\\\n          - \\\\\\\"TraceCoder (Huang et al., ICSE 2026) — diagnostic probes vs full trace\\\\\\\"\\\\n          - \\\\\\\"InspectCoder (Wang et al., 2025) — LLM-controlled debugger\\\\\\\"\\\\n          - \\\\\\\"Haque et al. (ACL 2025 Workshop) — raw trace 帮助有限, LLM-optimized format 更好\\\\\\\"\\\\n        positioning: \\\\\\\"selective trace 是趋势但用于 repair; 我们首次量化 component-level 贡献对 verdict 的影响\\\\\\\"\\\\n    writing_notes: \\\\\\\"每个 subsection ~0.33 page; 每篇 1-2 句; 最后一句 bridge 到本文 gap\\\\\\\"\\\\n\\\\n  # ----------------------------------------------------------\\\\n  # Section 3: Method (~1.5 pages)\\\\n  # ----------------------------------------------------------\\\\n  - section: \\\\\\\"3. Experimental Setup\\\\\\\"\\\\n    status: write_now\\\\n    estimated_length: \\\\\\\"1.5 pages\\\\\\\"\\\\n    subsections:\\\\n      - name: \\\\\\\"3.1 Task Definition\\\\\\\"\\\\n        content: \\\\\\\"Verdict prediction: given (code, input, expected_output, [trace]), predict pass/fail\\\\\\\"\\\\n        key_points:\\\\n          - \\\\\\\"Binary classification via SFT (instruction-tuned format)\\\\\\\"\\\\n          - \\\\\\\"不同于 code generation — 输出空间是 {pass, fail}\\\\\\\"\\\\n      - name: \\\\\\\"3.2 Dataset\\\\\\\"\\\\n        content: \\\\\\\"CRUXEval (Gu et al., ICML 2024) — 800 functions, 我们的 split: 4720 train / 1190 test\\\\\\\"\\\\n        key_points:\\\\n          - \\\\\\\"数据集来源: CRUXEval (Wang et al. 即 DCSH 构建的 verdict 版本)\\\\\\\"\\\\n          - \\\\\\\"Trace 生成: Python tracer 提取 full execution trace\\\\\\\"\\\\n          - \\\\\\\"Pass/fail 比例说明\\\\\\\"\\\\n        writing_notes: \\\\\\\"注意引用链: CRUXEval 原始 benchmark (Gu et al., 2024), verdict 数据构建方法 (Wang et al., 2025)\\\\\\\"\\\\n      - name: \\\\\\\"3.3 VOTA Trace Representation\\\\\\\"\\\\n        content: \\\\\\\"Variable-Outcome Trace Abstraction 的三个组件\\\\\\\"\\\\n        key_points:\\\\n          - \\\\\\\"Exception summary: [ERROR] type + message\\\\\\\"\\\\n          - \\\\\\\"Assertion-point (actual/expected): 关键检查点的值快照\\\\\\\"\\\\n          - \\\\\\\"Loop compression: 循环行为模式摘要\\\\\\\"\\\\n          - \\\\\\\"对比 full trace: VOTA 是 targeted extraction 而非 lossy compression\\\\\\\"\\\\n      - name: \\\\\\\"3.4 Experimental Conditions\\\\\\\"\\\\n        content: \\\\\\\"7 conditions 表格 + 2 models\\\\\\\"\\\\n        key_points:\\\\n          - \\\\\\\"Qwen-2.5-Coder-7B: 全部 7 conditions (no_trace, full_trace, VOTA, exception_only, ae_only, loop_only, label_only_loss)\\\\\\\"\\\\n          - \\\\\\\"DeepSeek-Coder-6.7B: 4 conditions (exception_only, VOTA, no_trace, full_trace)\\\\\\\"\\\\n          - \\\\\\\"训练细节: LoRA, epochs, lr, seed\\\\\\\"\\\\n          - \\\\\\\"Evaluation: accuracy, ECE, Brier score\\\\\\\"\\\\n    supporting_experiments:\\\\n      - \\\\\\\"所有实验 IDs\\\\\\\"\\\\n    writing_notes: \\\\\\\"用表格列出 conditions 和 models; VOTA 组件描述要配 example (Figure 1)\\\\\\\"\\\\n\\\\n  # ----------------------------------------------------------\\\\n  # Section 4: Results (~2.5 pages) — 核心\\\\n  # ----------------------------------------------------------\\\\n  - section: \\\\\\\"4. Results\\\\\\\"\\\\n    status: partial  # 核心数据已有, DeepSeek full_trace pending\\\\n    estimated_length: \\\\\\\"2.5 pages\\\\\\\"\\\\n    subsections:\\\\n      - name: \\\\\\\"4.1 Traces Help, Compression Helps More\\\\\\\"\\\\n        status: ready\\\\n        claim: 2\\\\n        key_points:\\\\n          - \\\\\\\"no_trace 75.1% → full_trace 81.8% → VOTA 99.41% (Qwen)\\\\\\\"\\\\n          - \\\\\\\"Label-only loss ablation: full_trace 86.2% (+4.5pp), gradient dilution = 26%\\\\\\\"\\\\n          - \\\\\\\"Information overload = 74% (13pp gap 无法被 loss masking 消除)\\\\\\\"\\\\n        supporting_experiments:\\\\n          - \\\\\\\"full_trace_seed42_v5: 81.8%\\\\\\\"\\\\n          - \\\\\\\"vota_seed42_v5: 99.41%\\\\\\\"\\\\n          - \\\\\\\"full_trace_label_only_seed42: 86.2%\\\\\\\"\\\\n        figures: [fig_2]\\\\n        tables: [tab_1]\\\\n\\\\n      - name: \\\\\\\"4.2 Exception Signal Transfer\\\\\\\"\\\\n        status: ready\\\\n        claim: 1\\\\n        key_points:\\\\n          - \\\\\\\"Component ablation: exception_only 99.83% ≥ VOTA 99.41% (p=0.01)\\\\\\\"\\\\n          - \\\\\\\"Cross-model: Qwen 99.83% ± 0.00 (3 seeds); DeepSeek 2/3 seeds 99.33%, 1 outlier 91.09%\\\\\\\"\\\\n          - \\\\\\\"DeepSeek bimodal: LoRA initialization sensitivity (fail_recall 70.5% vs 100%)\\\\\\\"\\\\n          - \\\\\\\"Even outlier exceeds VOTA 84.45% by 6.64pp\\\\\\\"\\\\n          - \\\\\\\"对比 VOTA gap=14.96pp, no_trace gap=1.77pp\\\\\\\"\\\\n          - \\\\\\\"Qwen seed robustness: 3 seeds 99.83% ± 0.00, irreducible samples (id=901,905)\\\\\\\"\\\\n        supporting_experiments:\\\\n          - \\\\\\\"vota_exception_only_seed42_v2: 99.83%\\\\\\\"\\\\n          - \\\\\\\"deepseek_exception_only_seed42: 99.33% (final) / 99.83% (best)\\\\\\\"\\\\n          - \\\\\\\"deepseek_vota_seed42: 84.45%\\\\\\\"\\\\n          - \\\\\\\"deepseek_no_trace_seed42: 73.36%\\\\\\\"\\\\n          - \\\\\\\"exception_only_seed123: 99.83%\\\\\\\"\\\\n          - \\\\\\\"exception_only_seed456: 99.83%\\\\\\\"\\\\n        figures: [fig_3]\\\\n        tables: [tab_2]\\\\n\\\\n      - name: \\\\\\\"4.3 Two-Tier Diagnostic Hierarchy\\\\\\\"\\\\n        status: ready\\\\n        claim: 3\\\\n        key_points:\\\\n          - \\\\\\\"Tier 1: exception 99.83%, ae_only 99.92% (p=0.80, 统计等价)\\\\\\\"\\\\n          - \\\\\\\"Tier 2: loop_only 85.6% ≈ label_only_loss 86.2%\\\\\\\"\\\\n          - \\\\\\\"Combining Tier 1+2 (VOTA 99.41%) < Tier 1 alone (exception 99.83%): noise from composition\\\\\\\"\\\\n          - \\\\\\\"vota_no_ae 99.41%: ae 移除不影响 VOTA, 冗余确认\\\\\\\"\\\\n        supporting_experiments:\\\\n          - \\\\\\\"vota_ae_only_seed42: 99.92%\\\\\\\"\\\\n          - \\\\\\\"vota_loop_only_seed42: 85.6%\\\\\\\"\\\\n          - \\\\\\\"vota_no_ae_seed42: 99.41%\\\\\\\"\\\\n        figures: [fig_4]\\\\n        tables: [tab_1]\\\\n\\\\n      - name: \\\\\\\"4.4 Calibration Analysis\\\\\\\"\\\\n        status: ready\\\\n        key_points:\\\\n          - \\\\\\\"exception_only ECE=0.003, Brier=0.001 (near-perfect calibration)\\\\\\\"\\\\n          - \\\\\\\"no_trace ECE=0.171, Brier=0.197 (~63x / ~150x gap)\\\\\\\"\\\\n          - \\\\\\\"Tier 1 signals 不仅 accuracy 高，calibration 也近完美\\\\\\\"\\\\n          - \\\\\\\"no_trace 对错误预测过度自信\\\\\\\"\\\\n        supporting_experiments:\\\\n          - \\\\\\\"calibration data for all Qwen conditions\\\\\\\"\\\\n        figures: [fig_5]\\\\n        tables: [tab_3]\\\\n\\\\n    pending_data:\\\\n      - item: \\\\\\\"DeepSeek full_trace v3\\\\\\\"\\\\n        impact: \\\\\\\"补全 cross-model comparison table 第 4 行; 非 blocking\\\\\\\"\\\\n        fallback: \\\\\\\"报告 N/A, Limitations 中说明 chat template bug 根因\\\\\\\"\\\\n\\\\n  # ----------------------------------------------------------\\\\n  # Section 5: Discussion (~1.0 page)\\\\n  # ----------------------------------------------------------\\\\n  - section: \\\\\\\"5. Discussion\\\\\\\"\\\\n    status: write_now  # 大部分可写，D2 假说措辞需谨慎\\\\n    estimated_length: \\\\\\\"1.0 page\\\\\\\"\\\\n    subsections:\\\\n      - name: \\\\\\\"5.1 Why Exception Signal Transfers\\\\\\\"\\\\n        content: \\\\\\\"structural simplicity → model-agnostic; 不需要 trace reasoning capability\\\\\\\"\\\\n        key_points:\\\\n          - \\\\\\\"Exception 是 binary fault indicator, 结构固定 [ERROR] type: ... message: ...\\\\\\\"\\\\n          - \\\\\\\"VOTA 依赖 trace reasoning, 受限于 pretraining-derived inductive bias\\\\\\\"\\\\n          - \\\\\\\"Design principle: 匹配 deployment model 能力下界\\\\\\\"\\\\n      - name: \\\\\\\"5.2 eval_loss vs Verdict Accuracy Decoupling\\\\\\\"\\\\n        content: \\\\\\\"Token-level loss 与 binary accuracy 方向相反; checkpoint selection 启示\\\\\\\"\\\\n        key_points:\\\\n          - \\\\\\\"DeepSeek VOTA: eval_loss +65% 但 accuracy +6.3pp\\\\\\\"\\\\n          - \\\\\\\"推荐 verdict-specific metric 做 checkpoint selection\\\\\\\"\\\\n      - name: \\\\\\\"5.3 CRUXEval Reasoning Gap Hypothesis\\\\\\\"\\\\n        content: \\\\\\\"VOTA gap ∝ CRUXEval execution reasoning gap — 标注为 hypothesis\\\\\\\"\\\\n        key_points:\\\\n          - \\\\\\\"Qwen CRUXEval-I 56.5% vs DeepSeek 39.0% (Δ=17.5pp)\\\\\\\"\\\\n          - \\\\\\\"VOTA gap 14.96pp 数值吻合\\\\\\\"\\\\n          - \\\\\\\"明确标注 N=2, 列出 alternatives (tokenizer, pretraining scale 2.75x, chat template)\\\\\\\"\\\\n      - name: \\\\\\\"5.4 Irreducible Samples\\\\\\\"\\\\n        content: \\\\\\\"3 seeds 2/1190 相同 errors → 数据集理论上限\\\\\\\"\\\\n        key_points:\\\\n          - \\\\\\\"id=901,905 均为 check_dict_case, pass→fail false negatives\\\\\\\"\\\\n          - \\\\\\\"可能是 labeling noise 或 edge-case 行为\\\\\\\"\\\\n    writing_notes: \\\\\\\"5.3 必须用 hedged language (we hypothesize, suggestive, N=2)\\\\\\\"\\\\n\\\\n  # ----------------------------------------------------------\\\\n  # Section 6: Limitations (~0.4 page)\\\\n  # ----------------------------------------------------------\\\\n  - section: \\\\\\\"6. Limitations\\\\\\\"\\\\n    status: write_now\\\\n    estimated_length: \\\\\\\"0.4 page\\\\\\\"\\\\n    key_points:\\\\n      - \\\\\\\"单数据集 (CRUXEval): 需更多 benchmark 验证 generalization\\\\\\\"\\\\n      - \\\\\\\"双模型 (Qwen + DeepSeek): 架构差异充分但 N=2\\\\\\\"\\\\n      - \\\\\\\"单任务 (verdict prediction): exception signal 在 generation/repair 上效果未知\\\\\\\"\\\\n      - \\\\\\\"DeepSeek full_trace collapsed (如未修复则此处披露)\\\\\\\"\\\\n      - \\\\\\\"Calibration 仅 Qwen 1 seed (但 accuracy 3-seed variance=0 支持稳定性)\\\\\\\"\\\\n\\\\n  # ----------------------------------------------------------\\\\n  # Section 7: Conclusion (~0.4 page)\\\\n  # ----------------------------------------------------------\\\\n  - section: \\\\\\\"7. Conclusion\\\\\\\"\\\\n    status: wait  # 等 Results 定稿后写\\\\n    estimated_length: \\\\\\\"0.4 page\\\\\\\"\\\\n    key_points:\\\\n      - \\\\\\\"Exception-based fault detection 是 verdict prediction 的 universal mechanism\\\\\\\"\\\\n      - \\\\\\\"Information density 而非 gradient dilution 驱动 trace compression 价值\\\\\\\"\\\\n      - \\\\\\\"Design principle: extract highest-specificity diagnostic signal, discard the rest\\\\\\\"\\\\n      - \\\\\\\"Future work: 多 benchmark, 更多模型, generation tasks\\\\\\\"\\\\n\\\\n  # ----------------------------------------------------------\\\\n  # Appendix (unlimited)\\\\n  # ----------------------------------------------------------\\\\n  - section: \\\\\\\"Appendix\\\\\\\"\\\\n    status: partial\\\\n    subsections:\\\\n      - name: \\\\\\\"A. Training Details\\\\\\\"\\\\n        content: \\\\\\\"LoRA config, hyperparameters, hardware, training time per condition\\\\\\\"\\\\n      - name: \\\\\\\"B. VOTA Trace Examples\\\\\\\"\\\\n        content: \\\\\\\"完整示例: full trace vs VOTA vs exception_only (pass case + fail case)\\\\\\\"\\\\n      - name: \\\\\\\"C. Full Experimental Results\\\\\\\"\\\\n        content: \\\\\\\"所有 conditions × models × seeds 的完整表格\\\\\\\"\\\\n      - name: \\\\\\\"D. Irreducible Sample Analysis\\\\\\\"\\\\n        content: \\\\\\\"id=901, 905 的代码、trace、模型预测详情\\\\\\\"\\\\n      - name: \\\\\\\"E. Statistical Tests\\\\\\\"\\\\n        content: \\\\\\\"McNemar test details, confidence intervals\\\\\\\"\\\\n      - name: \\\\\\\"F. DeepSeek full_trace Collapse Analysis\\\\\\\"\\\\n        content: \\\\\\\"chat template bug 根因分析 (如 v3 未修复则需要)\\\\\\\"\\\\n\\\\n# ============================================================\\\\n# 图表计划\\\\n# ============================================================\\\\nfigures:\\\\n  - id: fig_1\\\\n    title: \\\\\\\"VOTA Trace Representation Overview\\\\\\\"\\\\n    type: \\\\\\\"schematic/diagram\\\\\\\"\\\\n    description: \\\\\\\"展示 full trace → VOTA 三组件提取过程 (exception, ae, loop)\\\\\\\"\\\\n    data_source: \\\\\\\"手工设计, 用 code example 展示\\\\\\\"\\\\n    section: \\\\\\\"3.3\\\\\\\"\\\\n    status: needs_creation\\\\n    priority: high\\\\n    notes: \\\\\\\"论文核心图, 放在 Method section; 用一个具体 CRUXEval 例子\\\\\\\"\\\\n\\\\n  - id: fig_2\\\\n    title: \\\\\\\"Information Density vs Gradient Dilution Decomposition\\\\\\\"\\\\n    type: \\\\\\\"bar chart / waterfall\\\\\\\"\\\\n    description: \\\\\\\"展示 no_trace → full_trace → label_only → VOTA 的 accuracy 递增, 标注 gradient dilution (26%) 和 information overload (74%) 贡献\\\\\\\"\\\\n    data_source: \\\\\\\"Qwen conditions: no_trace 75.1%, full_trace 81.8%, label_only 86.2%, VOTA 99.41%\\\\\\\"\\\\n    section: \\\\\\\"4.1\\\\\\\"\\\\n    status: needs_creation\\\\n    priority: high\\\\n\\\\n  - id: fig_3\\\\n    title: \\\\\\\"Cross-Model Comparison: Signal Robustness\\\\\\\"\\\\n    type: \\\\\\\"grouped bar chart\\\\\\\"\\\\n    description: \\\\\\\"Qwen vs DeepSeek 在 4 conditions 上的 accuracy 对比, 标注 cross-model gap\\\\\\\"\\\\n    data_source: |\\\\n      exception_only: Qwen 99.83%, DeepSeek 99.33% (gap=0.50pp)\\\\n      VOTA: Qwen 99.41%, DeepSeek 84.45% (gap=14.96pp)\\\\n      no_trace: Qwen 75.13%, DeepSeek 73.36% (gap=1.77pp)\\\\n      full_trace: Qwen 81.8%, DeepSeek TBD (collapsed v1, v3 pending)\\\\n    section: \\\\\\\"4.2\\\\\\\"\\\\n    status: needs_creation  # DeepSeek full_trace pending 不影响其余 3 bars\\\\n    priority: high\\\\n\\\\n  - id: fig_4\\\\n    title: \\\\\\\"Component Ablation: Two-Tier Hierarchy\\\\\\\"\\\\n    type: \\\\\\\"horizontal bar chart\\\\\\\"\\\\n    description: \\\\\\\"7 conditions accuracy 排序, 颜色编码 Tier 1 / Tier 2 / baseline\\\\\\\"\\\\n    data_source: |\\\\n      ae_only 99.92% (Tier 1)\\\\n      exception_only 99.83% (Tier 1)\\\\n      VOTA_no_ae 99.41%\\\\n      VOTA 99.41%\\\\n      label_only_loss 86.2% (ablation)\\\\n      loop_only 85.6% (Tier 2)\\\\n      full_trace 81.8%\\\\n      no_trace 75.1% (baseline)\\\\n    section: \\\\\\\"4.3\\\\\\\"\\\\n    status: needs_creation\\\\n    priority: high\\\\n\\\\n  - id: fig_5\\\\n    title: \\\\\\\"Calibration Reliability Diagram\\\\\\\"\\\\n    type: \\\\\\\"reliability diagram (calibration plot)\\\\\\\"\\\\n    description: \\\\\\\"4 conditions 的 predicted probability vs actual frequency; 对角线=完美校准\\\\\\\"\\\\n    data_source: |\\\\n      exception_only: ECE=0.003, Brier=0.001\\\\n      ae_only: ECE=0.0004, Brier=0.0008\\\\n      VOTA: ECE=0.005, Brier=0.005\\\\n      no_trace: ECE=0.171, Brier=0.197\\\\n    section: \\\\\\\"4.4\\\\\\\"\\\\n    status: needs_creation\\\\n    priority: high\\\\n    notes: \\\\\\\"需要 per-bin calibration data (从 saved predictions 计算); 用 matplotlib reliability_diagram\\\\\\\"\\\\n\\\\n  - id: fig_6\\\\n    title: \\\\\\\"Seed Robustness: Exception-Only 3-Seed Consistency\\\\\\\"\\\\n    type: \\\\\\\"table or compact figure\\\\\\\"\\\\n    description: \\\\\\\"3 seeds 的 accuracy + CI + error overlap\\\\\\\"\\\\n    data_source: \\\\\\\"seed 42/123/456 均 99.83%, 2 errors 完全重叠\\\\\\\"\\\\n    section: \\\\\\\"4.2\\\\\\\"\\\\n    status: ready  # 数据已有\\\\n    priority: medium\\\\n    notes: \\\\\\\"可能并入 Table 2 而非独立 figure; 视版面决定\\\\\\\"\\\\n\\\\n# ============================================================\\\\n# 表格计划\\\\n# ============================================================\\\\ntables:\\\\n  - id: tab_1\\\\n    title: \\\\\\\"Main Results: Verdict Prediction Accuracy\\\\\\\"\\\\n    description: \\\\\\\"Qwen 全部 7 conditions accuracy, 标注 Tier 和 claim 对应关系\\\\\\\"\\\\n    columns: [\\\\\\\"Condition\\\\\\\", \\\\\\\"Trace Components\\\\\\\", \\\\\\\"Accuracy (%)\\\\\\\", \\\\\\\"Tier\\\\\\\", \\\\\\\"Δ vs no_trace\\\\\\\"]\\\\n    section: \\\\\\\"4.1 / 4.3\\\\\\\"\\\\n    status: ready\\\\n    priority: high\\\\n\\\\n  - id: tab_2\\\\n    title: \\\\\\\"Cross-Model Comparison\\\\\\\"\\\\n    description: \\\\\\\"Qwen vs DeepSeek 在可比 conditions 上的对比\\\\\\\"\\\\n    columns: [\\\\\\\"Condition\\\\\\\", \\\\\\\"Qwen Acc (%)\\\\\\\", \\\\\\\"DeepSeek Acc (%)\\\\\\\", \\\\\\\"Gap (pp)\\\\\\\", \\\\\\\"Interpretation\\\\\\\"]\\\\n    rows:\\\\n      - [\\\\\\\"exception_only\\\\\\\", \\\\\\\"99.83\\\\\\\", \\\\\\\"99.33\\\\\\\", \\\\\\\"0.50\\\\\\\", \\\\\\\"Model-agnostic\\\\\\\"]\\\\n      - [\\\\\\\"VOTA\\\\\\\", \\\\\\\"99.41\\\\\\\", \\\\\\\"84.45\\\\\\\", \\\\\\\"14.96\\\\\\\", \\\\\\\"Model-dependent\\\\\\\"]\\\\n      - [\\\\\\\"no_trace\\\\\\\", \\\\\\\"75.13\\\\\\\", \\\\\\\"73.36\\\\\\\", \\\\\\\"1.77\\\\\\\", \\\\\\\"Baseline consistent\\\\\\\"]\\\\n      - [\\\\\\\"full_trace\\\\\\\", \\\\\\\"81.8\\\\\\\", \\\\\\\"TBD\\\\\\\", \\\\\\\"—\\\\\\\", \\\\\\\"DeepSeek v3 pending\\\\\\\"]\\\\n    section: \\\\\\\"4.2\\\\\\\"\\\\n    status: partial  # DeepSeek full_trace pending\\\\n    priority: high\\\\n\\\\n  - id: tab_3\\\\n    title: \\\\\\\"Calibration Metrics\\\\\\\"\\\\n    description: \\\\\\\"ECE + Brier for all Qwen conditions\\\\\\\"\\\\n    columns: [\\\\\\\"Condition\\\\\\\", \\\\\\\"ECE\\\\\\\", \\\\\\\"Brier Score\\\\\\\", \\\\\\\"Relative to exception_only\\\\\\\"]\\\\n    section: \\\\\\\"4.4\\\\\\\"\\\\n    status: ready\\\\n    priority: high\\\\n\\\\n  - id: tab_4\\\\n    title: \\\\\\\"Seed Robustness (Appendix C)\\\\\\\"\\\\n    description: \\\\\\\"3 seeds × exception_only 完整结果\\\\\\\"\\\\n    columns: [\\\\\\\"Seed\\\\\\\", \\\\\\\"Accuracy\\\\\\\", \\\\\\\"95% CI\\\\\\\", \\\\\\\"Errors\\\\\\\", \\\\\\\"Error IDs\\\\\\\"]\\\\n    section: \\\\\\\"Appendix C\\\\\\\"\\\\n    status: ready\\\\n    priority: medium\\\\n\\\\n# ============================================================\\\\n# 文献策略\\\\n# ============================================================\\\\nliterature:\\\\n  core_competitors:\\\\n    - paper: \\\\\\\"DCSH (Wang et al., EMNLP Findings 2025)\\\\\\\"\\\\n      relationship: \\\\\\\"直接前驱; 我们用他们的数据集和 trace 格式作为 baseline\\\\\\\"\\\\n      positioning: \\\\\\\"他们发现 trace 对生成任务帮助不一致; 我们发现对 verdict 任务 exception signal 效果一致且 near-perfect\\\\\\\"\\\\n    - paper: \\\\\\\"TracePile (Chen et al., NeurIPS 2025)\\\\\\\"\\\\n      relationship: \\\\\\\"Trace SFT 最大规模工作\\\\\\\"\\\\n      positioning: \\\\\\\"Scale ≠ effectiveness; 他们只评估生成任务; 我们证明小数据 (4720) + 正确信号 > 大规模低密度数据\\\\\\\"\\\\n    - paper: \\\\\\\"TRACED (Ding et al., ICSE 2024)\\\\\\\"\\\\n      relationship: \\\\\\\"唯一用 trace 做分类相关任务的\\\\\\\"\\\\n      positioning: \\\\\\\"他们是 encoder-based pretraining; 我们是 decoder-based SFT + component ablation\\\\\\\"\\\\n\\\\n  key_benchmarks:\\\\n    - paper: \\\\\\\"CRUXEval (Gu et al., ICML 2024)\\\\\\\"\\\\n      relationship: \\\\\\\"数据来源\\\\\\\"\\\\n      citation_note: \\\\\\\"需同时引用 CRUXEval 原始 benchmark 和 DCSH 的 verdict 扩展\\\\\\\"\\\\n\\\\n  calibration_reference:\\\\n    - paper: \\\\\\\"Spiess et al. (ICSE 2025)\\\\\\\"\\\\n      relationship: \\\\\\\"Code LLM calibration 方法论\\\\\\\"\\\\n      positioning: \\\\\\\"他们发现 code LLM calibration 普遍较差; 我们的 exception_only ECE=0.003 是特殊的好\\\\\\\"\\\\n\\\\n  methodological:\\\\n    - paper: \\\\\\\"Yang et al. (NAACL 2024) — SFT generalization\\\\\\\"\\\\n      relationship: \\\\\\\"跨模型 SFT 理论基础\\\\\\\"\\\\n    - paper: \\\\\\\"Dong et al. (ACL 2024) — SFT data composition\\\\\\\"\\\\n      relationship: \\\\\\\"解释 pretraining scale 对 SFT 的影响\\\\\\\"\\\\n\\\\n  total_expected_refs: \\\\\\\"25-35\\\\\\\"\\\\n\\\\n# ============================================================\\\\n# 写作顺序与时间线\\\\n# ============================================================\\\\nwriting_schedule:\\\\n  phase_1_parallel:  # Day 1-2 (5/15-5/16)\\\\n    description: \\\\\\\"不依赖 pending 数据的 sections 并行写\\\\\\\"\\\\n    tasks:\\\\n      - section: \\\\\\\"3. Experimental Setup\\\\\\\"\\\\n        assignee: \\\\\\\"Paper Agent\\\\\\\"\\\\n        notes: \\\\\\\"最先写; 定义术语和符号供其他 section 引用\\\\\\\"\\\\n      - section: \\\\\\\"2. Related Work\\\\\\\"\\\\n        assignee: \\\\\\\"Paper Agent\\\\\\\"\\\\n        notes: \\\\\\\"literature_map.yaml 已完整, 直接写\\\\\\\"\\\\n      - section: \\\\\\\"Figure 1 (VOTA schematic)\\\\\\\"\\\\n        assignee: \\\\\\\"Figure Agent\\\\\\\"\\\\n        notes: \\\\\\\"需要手工设计 trace example\\\\\\\"\\\\n\\\\n  phase_2_core:  # Day 2-3 (5/16-5/17)\\\\n    description: \\\\\\\"核心 Results sections\\\\\\\"\\\\n    tasks:\\\\n      - section: \\\\\\\"4.1 Traces Help, Compression Helps More\\\\\\\"\\\\n        assignee: \\\\\\\"Paper Agent\\\\\\\"\\\\n        notes: \\\\\\\"数据全部就绪\\\\\\\"\\\\n      - section: \\\\\\\"4.2 Exception Signal: The Universal Diagnostic\\\\\\\"\\\\n        assignee: \\\\\\\"Paper Agent\\\\\\\"\\\\n        notes: \\\\\\\"数据全部就绪; DeepSeek full_trace 行填 TBD\\\\\\\"\\\\n      - section: \\\\\\\"4.3 Two-Tier Diagnostic Hierarchy\\\\\\\"\\\\n        assignee: \\\\\\\"Paper Agent\\\\\\\"\\\\n        notes: \\\\\\\"数据全部就绪\\\\\\\"\\\\n      - section: \\\\\\\"4.4 Calibration Analysis\\\\\\\"\\\\n        assignee: \\\\\\\"Paper Agent\\\\\\\"\\\\n        notes: \\\\\\\"数据全部就绪\\\\\\\"\\\\n      - section: \\\\\\\"Figures 2-5\\\\\\\"\\\\n        assignee: \\\\\\\"Figure Agent\\\\\\\"\\\\n        notes: \\\\\\\"与 Results 写作并行\\\\\\\"\\\\n\\\\n  phase_3_framing:  # Day 3-4 (5/17-5/18)\\\\n    description: \\\\\\\"Introduction + Discussion + Limitations\\\\\\\"\\\\n    tasks:\\\\n      - section: \\\\\\\"1. Introduction\\\\\\\"\\\\n        assignee: \\\\\\\"Paper Agent\\\\\\\"\\\\n        notes: \\\\\\\"Results 写完后再写 intro, 确保 contributions 与 results 一致\\\\\\\"\\\\n      - section: \\\\\\\"5. Discussion\\\\\\\"\\\\n        assignee: \\\\\\\"Paper Agent\\\\\\\"\\\\n        notes: \\\\\\\"5.3 CRUXEval hypothesis 措辞需审慎\\\\\\\"\\\\n      - section: \\\\\\\"6. Limitations\\\\\\\"\\\\n        assignee: \\\\\\\"Paper Agent\\\\\\\"\\\\n\\\\n  phase_4_finalize:  # Day 4-5 (5/18-5/19)\\\\n    description: \\\\\\\"Conclusion + Abstract + Appendix\\\\\\\"\\\\n    tasks:\\\\n      - section: \\\\\\\"7. Conclusion\\\\\\\"\\\\n        assignee: \\\\\\\"Paper Agent\\\\\\\"\\\\n      - section: \\\\\\\"Abstract\\\\\\\"\\\\n        assignee: \\\\\\\"Paper Agent\\\\\\\"\\\\n        notes: \\\\\\\"最后写; 浓缩全文要点\\\\\\\"\\\\n      - section: \\\\\\\"Appendix A-F\\\\\\\"\\\\n        assignee: \\\\\\\"Paper Agent\\\\\\\"\\\\n\\\\n  phase_5_review:  # Day 5-8 (5/19-5/22)\\\\n    description: \\\\\\\"Reviewer 对抗 + 迭代修改\\\\\\\"\\\\n    tasks:\\\\n      - \\\\\\\"内部 review pass 1: claim-evidence 对齐检查\\\\\\\"\\\\n      - \\\\\\\"内部 review pass 2: 统计严谨性 (p-values, CIs, effect sizes)\\\\\\\"\\\\n      - \\\\\\\"内部 review pass 3: 版面优化 (8 page fit)\\\\\\\"\\\\n      - \\\\\\\"Patch DeepSeek full_trace v3 结果 (如就绪)\\\\\\\"\\\\n\\\\n  phase_6_submit:  # Day 9-10 (5/23-5/24)\\\\n    description: \\\\\\\"最终检查 + 提交\\\\\\\"\\\\n    tasks:\\\\n      - \\\\\\\"ARR checklist 填写\\\\\\\"\\\\n      - \\\\\\\"Ethics statement\\\\\\\"\\\\n      - \\\\\\\"LaTeX 编译检查\\\\\\\"\\\\n      - \\\\\\\"Reference 完整性验证\\\\\\\"\\\\n      - \\\\\\\"提交 ARR\\\\\\\"\\\\n\\\\n# ============================================================\\\\n# 待定项 (blocking / non-blocking)\\\\n# ============================================================\\\\npending_items:\\\\n  - item: \\\\\\\"DeepSeek full_trace v3 重训结果\\\\\\\"\\\\n    blocking: false\\\\n    impact: \\\\\\\"补全 Table 2 第 4 行; 无则报 N/A + Limitations 披露\\\\\\\"\\\\n    expected_by: \\\\\\\"2026-05-17\\\\\\\"\\\\n    fallback: \\\\\\\"在 Table 2 标注 '—' 并在 §6 Limitations 说明 chat template 截断 bug\\\\\\\"\\\\n\\\\n  - item: \\\\\\\"DeepSeek exception_only seed123 (额外 seed)\\\\\\\"\\\\n    blocking: false\\\\n    impact: \\\\\\\"增强跨模型 seed robustness; 非必需\\\\\\\"\\\\n    expected_by: \\\\\\\"2026-05-17\\\\\\\"\\\\n\\\\n  - item: \\\\\\\"Per-bin calibration data for reliability diagram\\\\\\\"\\\\n    blocking: false  # 可从 saved predictions 重新计算\\\\n    impact: \\\\\\\"Figure 5 需要 per-bin 数据而非只有 ECE/Brier summary\\\\\\\"\\\\n    expected_by: \\\\\\\"2026-05-16\\\\\\\"\\\\n\\\\n  - item: \\\\\\\"plan_005 第二任务 (DebugBench) 验证\\\\\\\"\\\\n    blocking: false\\\\n    impact: \\\\\\\"如完成可大幅缓解 single-dataset limitation; 时间紧张可能无法完成\\\\\\\"\\\\n    expected_by: \\\\\\\"2026-05-22\\\\\\\"\\\\n    fallback: \\\\\\\"§6 Limitations 中标注, 留作 future work\\\\\\\"\\\\n\\\", \\\"total_chars\\\": 21594, \\\"truncated\\\": false}, \\\"error\\\": null, \\\"metadata\\\": {}}\"}"}]},"parent_tool_use_id":"toolu_01GfHqfCTzpAaAXaKwxRJEZF","session_id":"c099d2b8-39c3-483a-a490-b8b2371065b9","uuid":"923fd60d-3237-4c09-a426-c2fab773f914","timestamp":"2026-05-18T14:01:52.272Z"}
