\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Accuracy vs.\ trace truncation length. Accuracy monotonically decreases with trace length. Even 256 tokens of full trace is harmful ($-$17.1pp vs.\ no trace), while VOTA's ~80 tokens of \emph  {targeted} information yields $+$27.65pp. There is no beneficial truncation point for full traces.}}{5}{table.caption.10}\protected@file@percent }
\newlabel{tab:length_ablation}{{4}{5}{Accuracy vs.\ trace truncation length. Accuracy monotonically decreases with trace length. Even 256 tokens of full trace is harmful ($-$17.1pp vs.\ no trace), while VOTA's ~80 tokens of \emph {targeted} information yields $+$27.65pp. There is no beneficial truncation point for full traces}{table.caption.10}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Cross-model comparison. VOTA lift varies by $4\times $ across models. Full trace collapse is consistent but less severe on DeepSeek-Coder. \textsuperscript  {$\dagger $}Mean across 3 seeds.}}{5}{table.caption.11}\protected@file@percent }
\newlabel{tab:cross_model}{{5}{5}{Cross-model comparison. VOTA lift varies by $4\times $ across models. Full trace collapse is consistent but less severe on DeepSeek-Coder. \textsuperscript {$\dagger $}Mean across 3 seeds}{table.caption.11}{}}
