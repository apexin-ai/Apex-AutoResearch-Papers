\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces Expected calibration error (ECE). VOTA's low ECE is a byproduct of task trivialization (high confidence + high accuracy on a shortcut rule), not genuine uncertainty modeling. Full trace shows catastrophic miscalibration: 88\% average confidence at 28.5\% accuracy.}}{7}{table.caption.16}\protected@file@percent }
\newlabel{tab:calibration}{{8}{7}{Expected calibration error (ECE). VOTA's low ECE is a byproduct of task trivialization (high confidence + high accuracy on a shortcut rule), not genuine uncertainty modeling. Full trace shows catastrophic miscalibration: 88\% average confidence at 28.5\% accuracy}{table.caption.16}{}}
