\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Label-only loss partially alleviates collapse but falls far short of recovery. The problem is not only gradient dilution---trace content itself corrupts the classification signal at inference time.}}{4}{table.caption.9}\protected@file@percent }
