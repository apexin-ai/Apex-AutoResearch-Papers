\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Label-only loss repairs full-trace collapse (28.5\%$\to $76.2\%), confirming gradient dilution as root cause. However, the repaired model only matches no-trace performance, indicating that full traces provide no information gain even as pure context.}}{5}{table.3}\protected@file@percent }
\newlabel{tab:labelonly}{{3}{5}{Label-only loss repairs full-trace collapse (28.5\%$\to $76.2\%), confirming gradient dilution as root cause. However, the repaired model only matches no-trace performance, indicating that full traces provide no information gain even as pure context}{table.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Accuracy declines monotonically with trace length ($r = -0.97$). All truncated conditions fall below the no-trace baseline, and fail-prediction ratio increases steadily toward complete collapse.}}{5}{table.4}\protected@file@percent }
\newlabel{tab:length}{{4}{5}{Accuracy declines monotonically with trace length ($r = -0.97$). All truncated conditions fall below the no-trace baseline, and fail-prediction ratio increases steadily toward complete collapse}{table.4}{}}
