\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces (\textbf  {Left}) Cross-model tail-truncation budget curve ($N{=}1{,}190$, four models). All models remain near baseline at tail-256/384, then jump sharply at 384$\to $512 as the exception traceback is captured (shaded). Dashed: \textit  {exception\_only} range; dotted: \textit  {no\_trace} range. (\textbf  {Right}) Input token length distribution across trace conditions (training set, $N{=}4{,}720$). Dashed line: 2,048-token context window. \textit  {exception\_only} inputs (median 150 tokens) fit entirely within the window, while \textit  {full\_trace} inputs frequently exceed it, triggering truncation.}}{6}{figure.caption.10}\protected@file@percent }
\newlabel{fig:trace_length}{{3}{6}{(\textbf {Left}) Cross-model tail-truncation budget curve ($N{=}1{,}190$, four models). All models remain near baseline at tail-256/384, then jump sharply at 384$\to $512 as the exception traceback is captured (shaded). Dashed: \cond {exception\_only} range; dotted: \cond {no\_trace} range. (\textbf {Right}) Input token length distribution across trace conditions (training set, $N{=}4{,}720$). Dashed line: 2,048-token context window. \cond {exception\_only} inputs (median 150 tokens) fit entirely within the window, while \cond {full\_trace} inputs frequently exceed it, triggering truncation}{figure.caption.10}{}}
\newlabel{fig:token_distribution}{{3}{6}{(\textbf {Left}) Cross-model tail-truncation budget curve ($N{=}1{,}190$, four models). All models remain near baseline at tail-256/384, then jump sharply at 384$\to $512 as the exception traceback is captured (shaded). Dashed: \cond {exception\_only} range; dotted: \cond {no\_trace} range. (\textbf {Right}) Input token length distribution across trace conditions (training set, $N{=}4{,}720$). Dashed line: 2,048-token context window. \cond {exception\_only} inputs (median 150 tokens) fit entirely within the window, while \cond {full\_trace} inputs frequently exceed it, triggering truncation}{figure.caption.10}{}}
