\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces STA overview. \textbf  {(a)}~The formalization pipeline: an LLM translates natural-language (NL) premises into formal logic, verified by an external solver. \textbf  {(b)}~STA removes each component in turn and re-runs the solver; the fraction of necessary components yields ISR. \textbf  {(c)}~Applied post-hoc, ISR detects structural hacking; repurposed as reward, it triggers a Goodhart effect where tautological shortcuts (TS) achieve $\text  {ISR}{=}1$ by construction.}}{4}{figure.caption.5}\protected@file@percent }
\newlabel{fig:sta-overview}{{2}{4}{STA overview. \textbf {(a)}~The formalization pipeline: an LLM translates natural-language (NL) premises into formal logic, verified by an external solver. \textbf {(b)}~STA removes each component in turn and re-runs the solver; the fraction of necessary components yields ISR. \textbf {(c)}~Applied post-hoc, ISR detects structural hacking; repurposed as reward, it triggers a Goodhart effect where tautological shortcuts (TS) achieve $\text {ISR}{=}1$ by construction}{figure.caption.5}{}}
