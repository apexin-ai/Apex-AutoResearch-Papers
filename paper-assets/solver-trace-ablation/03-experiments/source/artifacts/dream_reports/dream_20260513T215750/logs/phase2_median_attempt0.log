{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FqRb9M9wGAKkzt4WhEMTqo","type":"tool_result","content":"1\t# Experiment Plan — solver-trace-ablation\n2\t# Claims reference paper_framing.md\n3\t\n4\texperiments:\n5\t  # === P0: Must-run (headline results) ===\n6\t\n7\t  - id: plan_001\n8\t    claim: 1\n9\t    description: \"FOL single-logic GRPO, execution-only reward (500 steps, K=8, 3 seeds) — baseline for STA comparison\"\n10\t    priority: P0\n11\t    gpu_budget_hours: 3  # ~1h per seed × 3\n12\t    deps: []\n13\t    registry_id: null  # MVP runs were 100-step pilots, need full 500-step\n14\t\n15\t  - id: plan_002\n16\t    claim: 1\n17\t    description: \"FOL single-logic GRPO, execution+STA reward (full STA, 500 steps, K=8, 3 seeds) — primary STA validation\"\n18\t    priority: P0\n19\t    gpu_budget_hours: 4  # ~1.3h per seed × 3 (STA adds ~30% overhead)\n20\t    deps: []\n21\t\n22\t  - id: plan_003\n23\t    claim: 1\n24\t    description: \"FOL held-out evaluation: compare plan_001 vs plan_002 checkpoints on test set using identical full STA metrics (prove_rate, ISR, ISR/PR ratio, hacking taxonomy annotation)\"\n25\t    priority: P0\n26\t    gpu_budget_hours: 1\n27\t    deps: [plan_001, plan_002]\n28\t\n29\t  - id: plan_004\n30\t    claim: 1\n31\t    description: \"STA O(1) vs O(N) ablation: rerun exec+STA with fast_isr_fol to confirm O(1) ineffectiveness at scale (500 steps, 1 seed) — negative result documentation\"\n32\t    priority: P0\n33\t    gpu_budget_hours: 1\n34\t    deps: []\n35\t\n36\t  - id: plan_005\n37\t    claim: 1\n38\t    description: \"STA reward weight ablation: test α/β ratios (0.3/0.7, 0.5/0.5, 0.7/0.3) + sigmoid curriculum vs fixed — isolate optimal STA integration\"\n39\t    priority: P0\n40\t    gpu_budget_hours: 4  # 4 conditions × ~1h\n41\t    deps: []\n42\t\n43\t  # === P1: Important for completeness ===\n44\t\n45\t  - id: plan_006\n46\t    claim: 2\n47\t    description: \"Prolog single-logic GRPO: exec-only vs exec+STA (500 steps, K=8, 1 seed) — second logic type validation\"\n48\t    priority: P1\n49\t    gpu_budget_hours: 3\n50\t    deps: []\n51\t    notes: \"Requires Prolog STA instantiation (rule ablation). SWI-Prolog already installed.\"\n52\t\n53\t  - id: plan_007\n54\t    claim: 2\n55\t    description: \"Multi-logic GRPO (FOL+Prolog): exec-only vs exec+STA (500 steps, K=8, 1 seed) — cross-logic transfer test\"\n56\t    priority: P1\n57\t    gpu_budget_hours: 3\n58\t    deps: [plan_006]\n59\t\n60\t  - id: plan_008\n61\t    claim: 2\n62\t    description: \"Cross-logic transfer evaluation: FOL-trained model on Prolog tasks and vice versa\"\n63\t    priority: P1\n64\t    gpu_budget_hours: 1\n65\t    deps: [plan_001, plan_006]\n66\t\n67\t  - id: plan_009\n68\t    claim: 1\n69\t    description: \"SFT baseline: supervised finetuning on same data (FOLIO 500), compare with GRPO variants\"\n70\t    priority: P1\n71\t    gpu_budget_hours: 1\n72\t    deps: []\n73\t\n74\t  # === P2: Nice-to-have ===\n75\t\n76\t  - id: plan_010\n77\t    claim: 2\n78\t    description: \"SMT-LIB single-logic GRPO: exec-only vs exec+STA — third logic type\"\n79\t    priority: P2\n80\t    gpu_budget_hours: 3\n81\t    deps: []\n82\t    notes: \"Requires SMT-LIB STA instantiation (constraint ablation). Z3 already installed.\"\n83\t\n84\t  - id: plan_011\n85\t    claim: 1\n86\t    description: \"Qwen3-8B scaling: full MLSR on 8B model (1 seed) — model scale effect\"\n87\t    priority: P2\n88\t    gpu_budget_hours: 6\n89\t    deps: [plan_005]\n90\t\n91\t  - id: plan_012\n92\t    claim: 1\n93\t    description: \"Hacking characterization: manual annotation of 200 outputs per condition, categorized by extensional-shortcut taxonomy\"\n94\t    priority: P1\n95\t    gpu_budget_hours: 0  # inference only\n96\t    deps: [plan_003]\n97\t\n98\t# GPU Budget Summary\n99\t# P0: ~13h (plan_001-005)\n100\t# P1: ~8h (plan_006-009, 012)\n101\t# P2: ~9h (plan_010-011)\n102\t# Total: ~30h\n103\t# Available: 2× RTX PRO 6000 96GB, 24/7\n104\t# Wall-clock estimate: P0 ~1.5 days (parallel 2 GPU), P1 ~1 day, P2 ~1 day\n105\t"}]},"parent_tool_use_id":"toolu_01T1B7xak22sQREZCq6w1kk9","session_id":"000d0064-bfbf-480d-8b46-d9416edccb28","uuid":"4da5cf2e-4b3e-493d-b6da-2be7cf6dc62f","timestamp":"2026-05-13T22:04:52.056Z"}
