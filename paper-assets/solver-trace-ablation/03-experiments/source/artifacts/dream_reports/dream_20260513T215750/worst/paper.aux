\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Held-out evaluation. The base model (no training) has the highest structural quality (ISR/PR = 0.53), indicating that GRPO training itself---regardless of reward design---induces structural degeneracy.}}{5}{table.3}\protected@file@percent }
\newlabel{tab:held-out}{{3}{5}{Held-out evaluation. The base model (no training) has the highest structural quality (ISR/PR = 0.53), indicating that GRPO training itself---regardless of reward design---induces structural degeneracy}{table.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces O(1) vs.\ O($N$) ISR comparison at step 500. O(1) tautology-only check has near-zero discriminability (0.02 vs.\ 0.31), confirming that fine-grained ablation is necessary for meaningful structural assessment.}}{5}{table.4}\protected@file@percent }
\newlabel{tab:o1-on}{{4}{5}{O(1) vs.\ O($N$) ISR comparison at step 500. O(1) tautology-only check has near-zero discriminability (0.02 vs.\ 0.31), confirming that fine-grained ablation is necessary for meaningful structural assessment}{table.4}{}}
