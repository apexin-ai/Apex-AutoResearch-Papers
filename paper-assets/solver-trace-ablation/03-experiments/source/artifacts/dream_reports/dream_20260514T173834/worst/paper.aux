\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces $O(1)$ approximation vs.\ $O(N)$ full \textsc  {STA}{}. The fast approximation is 3.3$\times $ faster but produces a noisier ISR signal (0.09 vs.\ 0.23), yielding results comparable to random reward---indicating that full LOO ablation is necessary for reliable ISR computation.}}{6}{table.8}\protected@file@percent }
\newlabel{tab:o1_on}{{8}{6}{$O(1)$ approximation vs.\ $O(N)$ full \STA {}. The fast approximation is 3.3$\times $ faster but produces a noisier ISR signal (0.09 vs.\ 0.23), yielding results comparable to random reward---indicating that full LOO ablation is necessary for reliable ISR computation}{table.8}{}}
