\@writefile{lot}{\contentsline {table}{\numberline {10}{\ignorespaces 1.5B vs.\ 8B model scaling (single seed). Scaling \emph  {exacerbates} rather than mitigates reward hacking: the 8B model achieves higher PR (0.97) but lower genuine rate (5\%), and shows elevated H7 rates under ISR reward (45\% vs.\ 16\%).}}{7}{table.10}\protected@file@percent }
\newlabel{tab:scaling}{{10}{7}{1.5B vs.\ 8B model scaling (single seed). Scaling \emph {exacerbates} rather than mitigates reward hacking: the 8B model achieves higher PR (0.97) but lower genuine rate (5\%), and shows elevated H7 rates under ISR reward (45\% vs.\ 16\%)}{table.10}{}}
