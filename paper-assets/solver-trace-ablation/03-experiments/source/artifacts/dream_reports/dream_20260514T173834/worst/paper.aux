\newlabel{tab:isr_reward_3seed}{{4}{5}{ISR-as-reward ($\beta {=}0.1$) vs.\ random-reward control, 3 seeds. H7 (conclusion duplication) appears exclusively under ISR reward (64.5\% vs.\ 0\% across all random seeds). Random reward achieves higher and more stable PR (0.85$\pm $0.06 vs.\ 0.77$\pm $0.14)}{table.4}{}}
\@writefile{toc}{\contentsline {section}{\numberline {6}Claim 2: ISR-as-Reward Exhibits Meta-Level Goodhart's Law}{5}{section.6}\protected@file@percent }
\newlabel{sec:claim2}{{6}{5}{Claim 2: ISR-as-Reward Exhibits Meta-Level Goodhart's Law}{section.6}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.1}Low Dose ($\beta {=}0.1$): ISR-Specific Gaming}{5}{subsection.6.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {6.2}Premise-Count Confound Analysis}{5}{subsection.6.2}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Premise-count-matched comparison. After controlling for premise count ($n_{\text  {prem}} \geq 3$), ISR reward shows no structural advantage over random reward (1.06$\times $). ISR s42's 15/26 ``genuine'' samples have only 1--2 premises, where ISR $\geq $ 0.5 is a mathematical artifact.}}{5}{table.5}\protected@file@percent }
\newlabel{tab:premise_matched}{{5}{5}{Premise-count-matched comparison. After controlling for premise count ($n_{\text {prem}} \geq 3$), ISR reward shows no structural advantage over random reward (1.06$\times $). ISR s42's 15/26 ``genuine'' samples have only 1--2 premises, where ISR $\geq $ 0.5 is a mathematical artifact}{table.5}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.3}High Dose ($\beta {=}0.3$): Classic Goodhart Collapse}{5}{subsection.6.3}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces High-dose ISR reward ($\beta {=}0.3$) vs.\ random control. ISR reward actively harms training (PR 18\% vs.\ 48\%), demonstrating classic Goodhart collapse.}}{6}{table.6}\protected@file@percent }
\newlabel{tab:high_dose}{{6}{6}{High-dose ISR reward ($\beta {=}0.3$) vs.\ random control. ISR reward actively harms training (PR 18\% vs.\ 48\%), demonstrating classic Goodhart collapse}{table.6}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.4}Dose--Response Summary}{6}{subsection.6.4}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces Complete Goodhart landscape. ISR-as-reward fails at every dose: low dose induces ISR-specific gaming (meta-Goodhart), high dose collapses PR (classic Goodhart).}}{6}{table.7}\protected@file@percent }
\newlabel{tab:dose_response}{{7}{6}{Complete Goodhart landscape. ISR-as-reward fails at every dose: low dose induces ISR-specific gaming (meta-Goodhart), high dose collapses PR (classic Goodhart)}{table.7}{}}
