\@writefile{lot}{\contentsline {table}{\numberline {11}{\ignorespaces Prolog STA 3-seed results. Extreme variance ($\sigma _{\text  {H7}}$=0.55) renders aggregate statistics meaningless. Only 1/3 seeds reproduces the H7 pattern observed in FOL.}}{8}{table.11}\protected@file@percent }
\newlabel{tab:prolog_sta}{{11}{8}{Prolog STA 3-seed results. Extreme variance ($\sigma _{\text {H7}}$=0.55) renders aggregate statistics meaningless. Only 1/3 seeds reproduces the H7 pattern observed in FOL}{table.11}{}}
\@writefile{lot}{\contentsline {table}{\numberline {12}{\ignorespaces Prolog STA s43 training trajectory. Training stagnates after $\sim $100 steps with no meaningful learning signal, consistent with sparse reward in Prolog's constrained semantic space.}}{8}{table.12}\protected@file@percent }
\newlabel{tab:prolog_s43_trajectory}{{12}{8}{Prolog STA s43 training trajectory. Training stagnates after $\sim $100 steps with no meaningful learning signal, consistent with sparse reward in Prolog's constrained semantic space}{table.12}{}}
