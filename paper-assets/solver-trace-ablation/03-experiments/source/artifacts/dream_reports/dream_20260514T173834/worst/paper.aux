\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces Curriculum ablation across schedule types. All configurations fall within a narrow band (PR: 0.62--0.77, ISR: 0.15--0.23). No schedule eliminates the Goodhart dynamics ($\Delta $PR $<$ 5pp across configurations), and no configuration achieves genuine rate above 40\%.}}{7}{table.9}\protected@file@percent }
\newlabel{tab:curriculum}{{9}{7}{Curriculum ablation across schedule types. All configurations fall within a narrow band (PR: 0.62--0.77, ISR: 0.15--0.23). No schedule eliminates the Goodhart dynamics ($\Delta $PR $<$ 5pp across configurations), and no configuration achieves genuine rate above 40\%}{table.9}{}}
