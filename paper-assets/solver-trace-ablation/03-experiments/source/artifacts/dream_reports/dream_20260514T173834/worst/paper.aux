\newlabel{tab:mixed}{{14}{9}{Mixed FOL+Prolog training vs.\ single-logic baselines. FOL PR drops from 0.93 to 0.45 ($-$48pp); Prolog PR drops from 0.83 to 0.22 ($-$61pp). Both logics suffer catastrophic interference}{table.14}{}}
\@writefile{lot}{\contentsline {table}{\numberline {15}{\ignorespaces Zero-shot cross-logic transfer. Models show near-zero transfer (PR $\leq $ 4\%) across logic types, consistent with format-specific overfitting in \textsc  {GRPO}{} training.}}{9}{table.15}\protected@file@percent }
\newlabel{tab:transfer}{{15}{9}{Zero-shot cross-logic transfer. Models show near-zero transfer (PR $\leq $ 4\%) across logic types, consistent with format-specific overfitting in \GRPO {} training}{table.15}{}}
