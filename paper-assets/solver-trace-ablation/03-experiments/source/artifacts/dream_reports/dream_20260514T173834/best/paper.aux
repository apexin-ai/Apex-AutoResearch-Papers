\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces ISR collapse under exec-only GRPO on FOL/Prover9 (seed 42). PR rises while ISR collapses. The SFT baseline achieves low PR but high proved-only ISR, confirming hacking is RL-specific.}}{4}{table.1}\protected@file@percent }
\newlabel{tab:isr_collapse}{{1}{4}{ISR collapse under exec-only GRPO on FOL/Prover9 (seed 42). PR rises while ISR collapses. The SFT baseline achieves low PR but high proved-only ISR, confirming hacking is RL-specific}{table.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces ISR vs.\ random reward at $\beta $\,=\,0.1 (FOL, 3 seeds). ISR reward induces H7 gaming (64.5\% vs.\ 0\%) and \emph  {lower} PR (0.77 vs.\ 0.85). Random reward has higher H1 rates (81.3\%) but zero H7---conclusion embedding is GRPO-universal, but ISR converts H1 into the more extreme H7 mode.}}{4}{table.2}\protected@file@percent }
\newlabel{tab:goodhart_3seed}{{2}{4}{ISR vs.\ random reward at $\beta $\,=\,0.1 (FOL, 3 seeds). ISR reward induces H7 gaming (64.5\% vs.\ 0\%) and \emph {lower} PR (0.77 vs.\ 0.85). Random reward has higher H1 rates (81.3\%) but zero H7---conclusion embedding is GRPO-universal, but ISR converts H1 into the more extreme H7 mode}{table.2}{}}
