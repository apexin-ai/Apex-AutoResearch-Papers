\newlabel{tab:approx}{{8}{8}{$O(1)$ single-component sampling vs.\ $O(N)$ full LOO ablation. The $10\times $ speed gain of $O(1)$ comes at the cost of near-random discrimination (AUROC 0.56). ISR's diagnostic power requires complete ablation}{table.caption.22}{}}
\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces Curriculum ablation within the convex combination formula. Sigmoid scheduling provides marginal improvement (${\sim }$3pp PR) over linear ramp. All variants underperform the additive bonus formulation (Table~\ref {tab:goodhart}), confirming that the convex formula's implicit penalty structure is the first-order problem.}}{8}{table.caption.23}\protected@file@percent }
\newlabel{tab:curriculum}{{9}{8}{Curriculum ablation within the convex combination formula. Sigmoid scheduling provides marginal improvement (${\sim }$3pp PR) over linear ramp. All variants underperform the additive bonus formulation (Table~\ref {tab:goodhart}), confirming that the convex formula's implicit penalty structure is the first-order problem}{table.caption.23}{}}
