\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Per-seed $\beta {=}0.1$ breakdown for s43 and s44. CE\% = conclusion embedding rate. s43: ISR rescues a collapsed baseline (exec-only PR$=$14\%) but effect is weaker than s42. s44: ISR is counterproductive---PR drops below random control.}}{6}{table.caption.19}\protected@file@percent }
\newlabel{tab:perseed}{{5}{6}{Per-seed $\beta {=}0.1$ breakdown for s43 and s44. CE\% = conclusion embedding rate. s43: ISR rescues a collapsed baseline (exec-only PR$=$14\%) but effect is weaker than s42. s44: ISR is counterproductive---PR drops below random control}{table.caption.19}{}}
