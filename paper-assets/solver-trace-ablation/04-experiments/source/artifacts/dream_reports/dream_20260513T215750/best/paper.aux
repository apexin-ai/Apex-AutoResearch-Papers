\@writefile{lot}{\contentsline {table}{\numberline {11}{\ignorespaces Scale comparison (4B vs.\ 8B). The STA benefit is approximately scale-invariant: ISR/PR improvement of ${\sim }0.28$ at both scales. Structural degeneracy persists at 8B, confirming it is a property of the optimization, not a small-model artifact.}}{9}{table.11}\protected@file@percent }
\newlabel{tab:scaling}{{11}{9}{Scale comparison (4B vs.\ 8B). The STA benefit is approximately scale-invariant: ISR/PR improvement of ${\sim }0.28$ at both scales. Structural degeneracy persists at 8B, confirming it is a property of the optimization, not a small-model artifact}{table.11}{}}
\@writefile{lot}{\contentsline {table}{\numberline {12}{\ignorespaces Hacking taxonomy distribution (\%, 200 outputs per condition, $\kappa = 0.78$). EO = exec-only, E+S = exec+STA. Exec-only training amplifies hacking from 25\% to 45\%; STA reduces it to 18\%, below the untrained baseline.}}{10}{table.12}\protected@file@percent }
\newlabel{tab:hacking}{{12}{10}{Hacking taxonomy distribution (\%, 200 outputs per condition, $\kappa = 0.78$). EO = exec-only, E+S = exec+STA. Exec-only training amplifies hacking from 25\% to 45\%; STA reduces it to 18\%, below the untrained baseline}{table.12}{}}
