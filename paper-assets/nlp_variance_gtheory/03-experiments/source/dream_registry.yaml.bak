  dream_20260521T044739:
    dream_id: dream_20260521T044739
    project: nlp_variance_gtheory
    status: done
    review_mode: full
    review_visible: true
    writing_visible: true
    venue: ''
    focus: 'Re-dream #3 after major improvements: (1) Cross-model G-study reveals
      model×item=26.2% as second-largest source, G collapses 0.611→0.073 — strongest
      finding so far; (2) 6 methodological robustness analyses completed (Bernoulli
      non-artifact, fixed/random insensitive, bootstrap=jackknife, temperature stratification,
      D-study verified, IRT vs G-theory 4× gap); (3) Added 4th contribution: practitioner
      toolkit (open-source G-theory pipeline + D-study calculator); (4) 5 concrete
      figures planned; (5) 9 Methodological Defenses (MD1-MD9) explicitly addressing
      every Dream #2 reviewer concern; (6) Claim 1 upgraded from "item dominance"
      to "model-conditional item dominance" based on actual 2-model data; (7) IRT
      vs G-theory comparison as standalone contribution. Key question: do these changes
      push median above weak accept and worst above borderline?'
    what_if: []
