       17.9,\n1002\t            6.4\n1003\t          ]\n1004\t        ]\n1005\t      },\n1006\t      {\n1007\t        \"title\": \"Table 11: IRT vs G-theory Item Requirements for G≥0.80\",\n1008\t        \"columns\": [\n1009\t          \"Benchmark\",\n1010\t          \"IRT_items\",\n1011\t          \"Gtheory_items_practical\",\n1012\t          \"Ratio\",\n1013\t          \"Gtheory_G_at_IRT_items\"\n1014\t        ],\n1015\t        \"rows\": [\n1016\t          [\n1017\t            \"MMLU\",\n1018\t            116,\n1019\t            414,\n1020\t            \"3.6×\",\n1021\t            0.489\n1022\t          ],\n1023\t          [\n1024\t            \"HellaSwag\",\n1025\t            108,\n1026\t            488,\n1027\t            \"4.5×\",\n1028\t            0.442\n1029\t          ],\n1030\t          [\n1031\t            \"GSM8K\",\n1032\t            105,\n1033\t            648,\n1034\t            \"6.2×\",\n1035\t            0.372\n1036\t          ],\n1037\t          [\n1038\t            \"ARC-Challenge\",\n1039\t            98,\n1040\t            682,\n1041\t            \"7.0×\",\n1042\t            0.352\n1043\t          ],\n1044\t          [\n1045\t            \"Mean\",\n1046\t            107,\n1047\t            558,\n1048\t            \"4.1×(MMLU/Hella), 5.3×(all)\"\n1049\t          ]\n1050\t        ]\n1051\t      },\n1052\t      {\n1053\t        \"title\": \"Table 12: Methodological Defense Summary\",\n1054\t        \"columns\": [\n1055\t          \"Defense\",\n1056\t          \"Analysis\",\n1057\t          \"Result\",\n1058\t          \"Conclusion\"\n1059\t        ],\n1060\t        \"rows\": [\n1061\t          [\n1062\t            \"MD1\",\n1063\t            \"Bernoulli correlation\",\n1064\t            \"r=0.38, r²=0.14\",\n1065\t            \"partial mechanical link, not dominant\"\n1066\t          ],\n1067\t          [\n1068\t            \"MD2\",\n1069\t            \"Fixed vs random\",\n1070\t            \"max shift 3.2%\",\n1071\t            \"robust (<5%)\"\n