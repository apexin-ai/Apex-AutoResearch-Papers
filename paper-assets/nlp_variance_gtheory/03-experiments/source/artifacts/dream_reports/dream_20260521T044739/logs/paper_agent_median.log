          4.8,\n124\t            5.8,\n125\t            5.0\n126\t          ],\n127\t          [\n128\t            \"temp_x_item\",\n129\t            3.2,\n130\t            3.8,\n131\t            2.9,\n132\t            4.2,\n133\t            3.5\n134\t          ],\n135\t          [\n136\t            \"ordering_x_item\",\n137\t            1.2,\n138\t            1.5,\n139\t            1.0,\n140\t            1.4,\n141\t            1.3\n142\t          ],\n143\t          [\n144\t            \"other\",\n145\t            2.8,\n146\t            2.9,\n147\t            2.5,\n148\t            2.6,\n149\t            2.7\n150\t          ],\n151\t          [\n152\t            \"residual\",\n153\t            12.9,\n154\t            17.4,\n155\t            13.2,\n156\t            15.4,\n157\t            14.7\n158\t          ]\n159\t        ]\n160\t      },\n161\t      {\n162\t        \"title\": \"Table 2: 4-Model Crossed Variance Decomposition (%, binary correct, model as random facet)\",\n163\t        \"columns\": [\n164\t          \"Component\",\n165\t          \"Pct\",\n166\t          \"Interpretation\"\n167\t        ],\n168\t        \"rows\": [\n169\t          [\n170\t            \"item_id\",\n171\t            41.2,\n172\t            \"largest source but reduced 18.5pp from single-model mean\"\n173\t          ],\n174\t          [\n175\t            \"model\",\n176\t            6.8,\n177\t            \"between-model mean accuracy differences\"\n178\t          ],\n179\t          [\n180\t            \"model_x_item\",\n181\t            16.4,\n182\t            \"second-largest; item difficulty rankings are model-specific\"\n183\t          ],\n184\t          [\n185\t            \"precision_x_item\",\n186\t            3.2,\n187\t            \"precision effects are item-conditional\"\n188\t          ],\n189\t          [\n190\t            \"prompt_x_item\",\n191\t            3.8,\n192\t            \"prompt sensitivity varies across items\"\n193\t          ],\n194\t          [\n195\t     