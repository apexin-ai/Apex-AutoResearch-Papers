\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Cross-benchmark variance fingerprints (4 models, reduced crossing, BF16). Each benchmark produces a qualitatively different variance structure. Item dominance varies only 8.7 pp across benchmarks, but model$\times $item varies 23.2 pp---with no monotonic ordering by any interpretable dimension. $G_{\text  {item}}$ and D-study budgets are benchmark-specific.}}{6}{table.caption.19}\protected@file@percent }
\newlabel{tab:crossbenchmark}{{2}{6}{Cross-benchmark variance fingerprints (4 models, reduced crossing, BF16). Each benchmark produces a qualitatively different variance structure. Item dominance varies only 8.7 pp across benchmarks, but model$\times $item varies 23.2 pp---with no monotonic ordering by any interpretable dimension. $G_{\text {item}}$ and D-study budgets are benchmark-specific}{table.caption.19}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces D-study item requirements for target reliability across benchmarks. Bootstrap 95\% CIs from 1{,}000 resamples. The 4.1$\times $ spread in $G \geq 0.80$ budgets follows no interpretable pattern linked to task type or format.}}{6}{table.caption.24}\protected@file@percent }
\newlabel{tab:dstudy_budgets}{{3}{6}{D-study item requirements for target reliability across benchmarks. Bootstrap 95\% CIs from 1{,}000 resamples. The 4.1$\times $ spread in $G \geq 0.80$ budgets follows no interpretable pattern linked to task type or format}{table.caption.24}{}}
