\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Adaptive vs.\ random-fault comparison by regime. Under random faults, $K_{\text  {eff}}$ is consistently more protective. The gap is largest in weak panels (Cohen's $d = 0.38$, $p = 0.04$) and negligible in strong panels ($d = 0.12$, $p = 0.41$).}}{4}{table.caption.9}\protected@file@percent }
\newlabel{tab:bft_contrast}{{4}{4}{Adaptive vs.\ random-fault comparison by regime. Under random faults, $K_{\text {eff}}$ is consistently more protective. The gap is largest in weak panels (Cohen's $d = 0.38$, $p = 0.04$) and negligible in strong panels ($d = 0.12$, $p = 0.41$)}{table.caption.9}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Per-judge ASR concentration. ``Weak-J \%'': fraction of panel ASR attributable to the weakest judge. In weak panels, the weakest judge absorbs 61\% of successful attacks (Gini $= 0.52$); in strong panels, ASR is nearly uniformly distributed (Gini $= 0.18$).}}{4}{table.caption.10}\protected@file@percent }
\newlabel{tab:concentration}{{5}{4}{Per-judge ASR concentration. ``Weak-J \%'': fraction of panel ASR attributable to the weakest judge. In weak panels, the weakest judge absorbs 61\% of successful attacks (Gini $= 0.52$); in strong panels, ASR is nearly uniformly distributed (Gini $= 0.18$)}{table.caption.10}{}}
