\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Aggregation gradient under three correction methods. Threshold (unanimity) voting amplifies both predictors' significance, while Bayesian calibration attenuates both. Under OLS, Bayesian reverses $\ensuremath  {K_{\text  {eff}}}$ direction (6/7 negative coefficients), but this reversal is attenuated under bootstrap (2/7 negative survive). The ordinal ranking (threshold $>$ majority $>$ weighted $>$ Bayesian for dual-driver significance) is preserved across all correction methods.}}{6}{table.5}\protected@file@percent }
\newlabel{tab:aggregation}{{5}{6}{Aggregation gradient under three correction methods. Threshold (unanimity) voting amplifies both predictors' significance, while Bayesian calibration attenuates both. Under OLS, Bayesian reverses $\keff $ direction (6/7 negative coefficients), but this reversal is attenuated under bootstrap (2/7 negative survive). The ordinal ranking (threshold $>$ majority $>$ weighted $>$ Bayesian for dual-driver significance) is preserved across all correction methods}{table.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Condition-level $\ensuremath  {K_{\text  {eff}}}$ coefficients under Bayesian aggregation. The sign reversal (negative = protective) is robust for MMLU$\times $PI and MMLU$\times $auth under both correction methods, partial for MMLU$\times $syco, and absent for the remaining conditions. ARC$\times $PI does not show the reversal.}}{6}{table.6}\protected@file@percent }
\newlabel{tab:bayesian_flip}{{6}{6}{Condition-level $\keff $ coefficients under Bayesian aggregation. The sign reversal (negative = protective) is robust for MMLU$\times $PI and MMLU$\times $auth under both correction methods, partial for MMLU$\times $syco, and absent for the remaining conditions. ARC$\times $PI does not show the reversal}{table.6}{}}
