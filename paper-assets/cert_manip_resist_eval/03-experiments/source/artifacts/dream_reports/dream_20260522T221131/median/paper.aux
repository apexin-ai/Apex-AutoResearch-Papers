\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Partial correlations and residualized regression confirm $\ensuremath  {\eta _{\max }}$ dominance across analytical approaches. The partial correlation of $\ensuremath  {\eta _{\max }}$ given $\ensuremath  {K_{\text  {eff}}}$ (0.35) is approximately 3$\times $ the reverse (0.12). Residualizing $\ensuremath  {K_{\text  {eff}}}$ on $\ensuremath  {\eta _{\max }}$ eliminates its significance under bootstrap (0/12).}}{4}{table.3}\protected@file@percent }
\newlabel{tab:partial}{{3}{4}{Partial correlations and residualized regression confirm $\etamax $ dominance across analytical approaches. The partial correlation of $\etamax $ given $\keff $ (0.35) is approximately 3$\times $ the reverse (0.12). Residualizing $\keff $ on $\etamax $ eliminates its significance under bootstrap (0/12)}{table.3}{}}
