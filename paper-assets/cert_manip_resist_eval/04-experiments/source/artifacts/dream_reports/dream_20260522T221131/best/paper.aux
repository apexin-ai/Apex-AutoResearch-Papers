\newlabel{tab:extended_attack}{{2}{4}{Extended attack taxonomy (clustered SE). $\eta _{\max }$ remains dominant across all new attack types. GAM taxonomy extends cleanly from 6:6 to 10:8 (targeted:shared-bias). $\checkmark \checkmark $ = significant on both benchmarks}{table.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Random-fault vs.\ adaptive regime contrast. $K_{\text  {eff}}$ is genuinely significant under i.i.d.\ faults (2/2 under all corrections) but artifactual under adaptive attacks (0--1/12 after correction). The $R^2$ gap ($\Delta = 0.48$) quantifies the unpredictability introduced by adaptive adversaries.}}{4}{table.3}\protected@file@percent }
\newlabel{tab:rf_contrast}{{3}{4}{Random-fault vs.\ adaptive regime contrast. $K_{\text {eff}}$ is genuinely significant under i.i.d.\ faults (2/2 under all corrections) but artifactual under adaptive attacks (0--1/12 after correction). The $R^2$ gap ($\Delta = 0.48$) quantifies the unpredictability introduced by adaptive adversaries}{table.3}{}}
