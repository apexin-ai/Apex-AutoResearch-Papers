\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Panel design strategy comparison (mean ASR across 12 conditions). The $\max (K_{\text  {eff}})$ strategy---the intuitive ``maximize diversity'' approach---performs \emph  {worse} than random selection because it introduces weak models. Two-stage provides a marginal 0.7pp improvement over $\min (\eta _{\max })$ alone.}}{6}{table.6}\protected@file@percent }
\newlabel{tab:strategy}{{6}{6}{Panel design strategy comparison (mean ASR across 12 conditions). The $\max (K_{\text {eff}})$ strategy---the intuitive ``maximize diversity'' approach---performs \emph {worse} than random selection because it introduces weak models. Two-stage provides a marginal 0.7pp improvement over $\min (\eta _{\max })$ alone}{table.6}{}}
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces Cross-tier vs.\ within-tier comparison (clustered SE). Controlling for capability reduces confound and reveals $K_{\text  {eff}}$ as a weak but detectable secondary factor (2/12, both in targeted conditions). The dominance ratio narrows from $\infty $ to 2:1, but $\eta _{\max }$ still dominates.}}{6}{table.7}\protected@file@percent }
\newlabel{tab:capability}{{7}{6}{Cross-tier vs.\ within-tier comparison (clustered SE). Controlling for capability reduces confound and reveals $K_{\text {eff}}$ as a weak but detectable secondary factor (2/12, both in targeted conditions). The dominance ratio narrows from $\infty $ to 2:1, but $\eta _{\max }$ still dominates}{table.7}{}}
