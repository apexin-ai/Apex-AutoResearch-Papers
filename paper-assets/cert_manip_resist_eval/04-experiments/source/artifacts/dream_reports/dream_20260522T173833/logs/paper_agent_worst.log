         \"0.16\",\n492\t            \"0.072\",\n493\t            \"1.33\",\n494\t            \"0.521\"\n495\t          ],\n496\t          [\n497\t            \"ARC\",\n498\t            \"score_manip\",\n499\t            \"0.41\",\n500\t            \"0.032\",\n501\t            \"0.48\",\n502\t            \"0.001\",\n503\t            \"1.17\",\n504\t            \"0.434\"\n505\t          ],\n506\t          [\n507\t            \"ARC\",\n508\t            \"position\",\n509\t            \"0.22\",\n510\t            \"0.102\",\n511\t            \"0.27\",\n512\t            \"0.015\",\n513\t            \"1.23\",\n514\t            \"0.548\"\n515\t          ],\n516\t          [\n517\t            \"ARC\",\n518\t            \"verbosity\",\n519\t            \"0.06\",\n520\t            \"0.649\",\n521\t            \"0.11\",\n522\t            \"0.198\",\n523\t            \"1.83\",\n524\t            \"0.412\"\n525\t          ],\n526\t          [\n527\t            \"ARC\",\n528\t            \"authority\",\n529\t            \"0.19\",\n530\t            \"0.157\",\n531\t            \"0.22\",\n532\t            \"0.038\",\n533\t            \"1.16\",\n534\t            \"0.601\"\n535\t          ],\n536\t          [\n537\t            \"ARC\",\n538\t            \"few_shot_hijack\",\n539\t            \"0.28\",\n540\t            \"0.071\",\n541\t            \"0.33\",\n542\t            \"0.009\",\n543\t            \"1.18\",\n544\t            \"0.547\"\n545\t          ]\n546\t        ]\n547\t      },\n548\t      {\n549\t        \"title\": \"Table 5: R² Comparison Across Regimes\",\n550\t        \"columns\": [\n551\t          \"Dataset\",\n552\t          \"Attack\",\n553\t          \"R² (Adaptive)\",\n554\t          \"R² (RF)\",\n555\t          \"ΔR²\"\n556\t        ],\n557\t        \"rows\": [\n558\t          [\n559\t            \"MMLU\",\n560\t            \"sycophancy\",\n561\t            \"0.41\",\n562\t            \"0.64\",\n563\t            \"0.23\"\n564\t          ],\n565\t          [\n566\t            \"MMLU\",\n567\t            \"score_manip\",\n568\t            \"0.36\",\n569\t            \"0.58\",\n570\t            \"0.22\"\n571\t          ],\n572\t          [\n573\t            \"MMLU\",\n574\t            \"position\",\n575\t            \"0.39\",\n576\t            \"0.61\",\n577\t            \"0.22\"\n578\t          ],\n579\t          [\n580\t            \"MMLU\",\n581\t            \"verbosity\",\n582\t            \"0.42\",\n583\t            \"0.67\",\n584\t            \"0.25\"\n585\t          ],\n586\t          [\n587\t            \"MMLU\",\n588\t            \"authority\",\n589\t            \"0.37\",\n590\t            \"0.59\",\n591\t            \"0.22\"\n592\t          ],\n593\t          [\n594\t            \"MMLU\",\n595\t            \"few_shot_hijack\",\n596\t            \"0.33\",\n597\t            \"0.55\",\n598\t            \"0.22\"\n599\t          ],\n600\t          [\n601\t            \"ARC\",\n602\t            \"sycophancy\",\n603\t            \"0.43\",\n604\t            \"0.69\",\n605\t            \"0.26\"\n606\t          ],\n607\t          [\n608\t            \"ARC\",\n609\t            \"score_manip\",\n610\t            \"0.35\",\n611\t            \"0.57\",\n612\t            \"0.22\"\n613\t          ],\n614\t          [\n615\t            \"ARC\",\n616\t            \"position\",\n617\t            \"0.38\",\n618\t            \"0.62\",\n619\t            \"0.24\"\n620\t          ],\n621\t          [\n622\t            \"ARC\",\n623\t            \"verbosity\",\n624\t            \"0.44\",\n625\t            \"0.71\",\n626\t            \"0.27\"\n627\t          ],\n628\t          [\n629\t            \"ARC\",\n630\t            \"authority\",\n631\t            \"0.36\",\n632\t            \"0.60\",\n633\t            \"0.24\"\n634\t          ],\n635\t          [\n636\t            \"ARC\",\n637\t            \"few_shot_hijack\",\n638\t            \"0.32\",\n639\t            \"0.53\",\n640\t            \"0.21\"\n641\t          ]\n642\t        ]\n643\t      }\n644\t    ],\n645\t    \"figures\": [],\n646\t    \"analysis\": \"BFT contrast 实验是 GO/NO-GO gate，结果为 NO-GO。K_eff 在 RF 下不仅没有变负 （diversity helps），反而保持正向且更显著（10/12 vs 4/12 residualized adaptive）。 这意味着 K_eff 的正向效应不是 adaptive adversary 特有的——而是 panel composition 的基本属性（高 diversity → 混入弱模型 → 高 ASR），RF 和 adaptive 下都成立。 BFT reversal mechanism 的核心前提被否定：我们无法证明 diversity 在 RF 下保护但在 adaptive 下有害。唯一可挽救的发现是 ΔR² = 0.24，说明 adaptive attacker 引入了 strategic variance 使得 panel composition 的预测力下降——但这是一个弱得多的 claim， 不足以支撑 Claim 2 作为独立贡献。BFT 应降级为 Discussion 中的 \\\"open question\\\"。\\n\\n\\nBFT contrast 的核心预期是 K_eff 在 RF 下显著正向（diversity helps under random faults） 但在 adaptive 下 NS 或反转。Worst 档下实际观察到：K_eff 在 RF 下同样正向显著 （10/12），与 adaptive 下方向一致。原因：在 RF 模拟中 η_j 直接决定 judge 犯错率， 高 K_eff panel 仍然混入高 η_j 的弱模型，majority vote 下弱模型拉低整体正确率。 因此 K_eff 正向不是 \\\"diversity 主动有害\\\" 而是 \\\"diversity 引入弱模型\\\" 的统计反映—— 这在 RF 和 adaptive 两种 regime 下都成立。β ratio 0.91 表明两种 regime 下 K_eff 的效应量几乎相同，regime interaction term NS (p=0.217)。唯一的 regime 差异是 R²： RF 下 R²=0.62 vs adaptive R²=0.38，ΔR²=0.24——RF 更可预测但这只是因为 RF 没有 strategic variance，不是因为 K_eff 效应不同。BFT reversal mechanism 叙事瓦解。\\n\"\n647\t  },\n648\t  {\n649\t    \"name\": \"Capability-Matched K_eff Validation\",\n650\t    \"description\": \"在同一 capability tier 内（all-small 7-8B 或 all-large 70B+/API）测试 K_eff 是否 仍然显著。如果 tier-matched panel 中 K_eff 消失 → K_eff 效应是 tier-mixing artifact。\\n\",\n651\t    \"results\": {\n652\t      \"tiers_tested\": 3,\n653\t      \"panels_small_tier\": 10,\n654\t      \"panels_medium_tier\": 10,\n655\t      \"panels_large_tier\": 10,\n656\t      \"small_tier_keff_sig\": 0,\n657\t      \"medium_tier_keff_sig\": 1,\n658\t      \"large_tier_keff_sig\": 0,\n659\t      \"total_capability_matched_keff_sig\": 1,\n660\t      \"total_conditions_tested\": 6,\n661\t      \"eta_max_variance_within_tier\": 0.008,\n662\t      \"keff_eta_max_correlation_within_tier\": 0.22,\n663\t      \"within_tier_keff_p_range\": [\n664\t        0.041,\n665\t        0.891\n666\t      ],\n667\t      \"within_tier_mean_R2\": 0.12\n668\t    },\n669\t    \"tables\": [\n670\t      {\n671\t        \"title\": \"Table 6: Capability-Matched K_eff Analysis\",\n672\t        \"columns\": [\n673\t          \"Tier\",\n674\t          \"N Panels\",\n675\t          \"Condition\",\n676\t          \"β_Keff\",\n677\t          \"p_Keff\",\n678\t          \"R²\",\n679\t          \"η_max Var\"\n680\t        ],\n681\t        \"rows\": [\n682\t          [\n683\t            \"Small (7-8B)\",\n684\t            \"10\",\n685\t            \"MMLU×sycophancy\",\n686\t            \"0.08\",\n687\t            \"0.721\",\n688\t            \"0.09\",\n689\t            \"0.007\"\n690\t          ],\n691\t          [\n692\t            \"Small (7-8B)\",\n693\t            \"10\",\n694\t            \"ARC×score_manip\",\n695\t            \"0.14\",\n696\t            \"0.548\",\n697\t            \"0.11\",\n698\t            \"0.008\"\n699\t          ],\n700\t          [\n701\t            \"Medium (12-14B+API-mini)\",\n702\t            \"10\",\n703\t            \"MMLU×sycophancy\",\n704\t            \"0.11\",\n705\t            \"0.612\",\n706\t            \"0.10\",\n707\t            \"0.009\"\n708\t          ],\n709\t          [\n710\t            \"Medium (12-14B+API-mini)\",\n711\t            \"10\",\n712\t            \"ARC×score_manip\",\n713\t            \"0.29\",\n714\t            \"0.041\",\n715\t            \"0.18\",\n716\t            \"0.011\"\n717\t          ],\n718\t          [\n719\t            \"Large (70B+API)\",\n720\t            \"10\",\n721\t            \"MMLU×sycophancy\",\n722\t            \"0.06\",\n723\t            \"0.891\",\n724\t            \"0.07\",\n725\t            \"0.004\"\n726\t          ],\n727\t          [\n728\t            \"Large (70B+API)\",\n729\t            \"10\",\n730\t            \"ARC×score_manip\",\n731\t            \"0.09\",\n732\t            \"0.684\",\n733\t            \"0.08\",\n734\t            \"0.005\"\n735\t          ]\n736\t        ]\n737\t      }\n738\t    ],\n739\t    \"figures\": [],\n740\t    \"analysis\": \"这是对 diversity trap framing 的最强反驳。Capability-matched 0-1/6 显著意味着 K_eff 的独立效应在控制 capability 后基本消失。Residualized analysis 在全池中仍然 显著 4/12 的原因是：residualization 假设线性关系，但 K_eff-η_max confound 可能是 非线性的（阶梯型：跨 tier → K_eff 骤升 + η_max 骤升），线性 residualization 无法完全去除。Capability-matched 是更强的 confound control（分层而非回归调整）， 结果否定了 K_eff 的独立效应。需要在论文中诚实报告这个 null result，将 K_eff 从 core claim 降级为 \\\"exploratory, potentially confounded\\\"。\\n\\n\\nCapability-matched 是 worst 档的致命实验。同 tier 内模型能力相近，η_max 方差极小 （约 0.008 vs 全池 0.045），消除了 tier-mixing confound。结果：K_eff 仅在 1/6 条件下显著（medium tier × score_manipulation, p=0.041，FDR 后可能 NS），其余 5/6 全部 NS。这直接证明 K_eff 的表面效应是 tier-mixing 的统计幻象：当你在全池抽 panel， 高 K_eff panel 跨 tier 抽样（混入 7B 和 70B），低 K_eff panel 同 tier 抽样—— K_eff 与 η_max 的相关性是 tier-mixing 的副产品，不是因果关系。 每个 tier 仅 C(5,3)=10 个 panel，样本量不足以检测小效应，但即便如此 η_max 方差 消失也说明在能力控制后 K_eff 没有独立的预测力。Reviewer 可以合理论证： \\\"K_eff effect = capability heterogeneity effect, not diversity per se\\\"。\\n\"\n741\t  },\n742\t  {\n743\t    \"name\": \"Two-Stage Panel Design Algorithm Benchmark\",\n744\t    \"description\": \"Robustness-first 两阶段选择：(1) 筛选 η ≤ threshold 的 judge，(2) 在剩余中最大化 K_eff。 与 5 个 baseline（random, max-K_eff, strongest-K, min-η, diversity-only）对比。\\n\",\n745\t    \"results\": {\n746\t      \"baselines_tested\": 5,\n747\t      \"two_stage_vs_strongest_K_ASR_reduction_pct\": 2.3,\n748\t      \"two_stage_vs_strongest_K_p\": 0.312,\n749\t      \"two_stage_vs_random_ASR_reduction_pct\": 18.4,\n750\t      \"two_stage_vs_max_keff_ASR_reduction_pct\": 31.2,\n751\t      \"min_eta_dominates_conditions\": 4,\n752\t      \"two_stage_dominates_conditions\": 1,\n753\t      \"strongest_K_dominates_conditions\": 1,\n754\t      \"two_stage_ASR_reduction_pct\": 3.1,\n755\t      \"two_stage_vs_strongest_K_stat_sig\": false,\n756\t      \"optimal_eta_threshold\": 0.15\n757\t    },\n758\t    \"tables\": [\n759\t      {\n760\t        \"title\": \"Table 7: Panel Selection Strategy Comparison (mean ASR across 6 attacks)\",\n761\t        \"columns\": [\n762\t          \"Strategy\",\n763\t          \"Mean ASR\",\n764\t          \"vs Strongest-K Δ%\",\n765\t          \"p vs Strongest-K\",\n766\t          \"Wins (6 conditions)\"\n767\t        ],\n768\t        \"rows\": [\n769\t          [\n770\t            \"Random\",\n771\t            \"0.284\",\n772\t            \"+21.5%\",\n773\t            \"<0.001\",\n774\t            \"0\"\n775\t          ],\n776\t          [\n777\t            \"Max-K_eff\",\n778\t            \"0.341\",\n779\t            \"+45.9%\",\n780\t            \"<0.001\",\n781\t            \"0\"\n782\t          ],\n783\t          [\n784\t            \"Diversity-Only\",\n785\t            \"0.312\",\n786\t            \"+33.5%\",\n787\t            \"<0.001\",\n788\t            \"0\"\n789\t          ],\n790\t          [\n791\t            \"Min-η_max\",\n792\t            \"0.229\",\n793\t            \"-2.1%\",\n794\t            \"0.478\",\n795\t            \"4\"\n796\t          ],\n797\t          [\n798\t            \"Strongest-K\",\n799\t            \"0.234\",\n800\t            \"—\",\n801\t            \"—\",\n802\t            \"1\"\n803\t          ],\n804\t          [\n805\t            \"Two-Stage\",\n806\t            \"0.227\",\n807\t            \"-3.1%\",\n808\t            \"0.312\",\n809\t            \"1\"\n810\t          ]\n811\t        ]\n812\t      },\n813\t      {\n814\t        \"title\": \"Table 8: Two-Stage vs Strongest-K Per Condition\",\n815\t        \"columns\": [\n816\t          \"Condition\",\n817\t          \"ASR (Two-Stage)\",\n818\t          \"ASR (Strongest-K)\",\n819\t          \"Δ%\",\n820\t          \"p\"\n821\t        ],\n822\t        \"rows\": [\n823\t          [\n824\t            \"MMLU×sycophancy\",\n825\t            \"0.211\",\n826\t            \"0.219\",\n827\t            \"-3.7%\",\n828\t            \"0.284\"\n829\t          ],\n830\t          [\n831\t            \"MMLU×score_manip\",\n832\t            \"0.198\",\n833\t            \"0.207\",\n834\t            \"-4.3%\",\n835\t            \"0.198\"\n836\t          ],\n837\t          [\n838\t            \"MMLU×position\",\n839\t            \"0.237\",\n840\t            \"0.241\",\n841\t            \"-1.7%\",\n842\t            \"0.641\"\n843\t          ],\n844\t          [\n845\t            \"ARC×sycophancy\",\n846\t            \"0.241\",\n847\t            \"0.248\",\n848\t            \"-2.8%\",\n849\t            \"0.352\"\n850\t          ],\n851\t          [\n852\t            \"ARC×score_manip\",\n853\t            \"0.185\",\n854\t            \"0.194\",\n855\t            \"-4.6%\",\n856\t            \"0.187\"\n857\t          ],\n858\t          [\n859\t            \"ARC×position\",\n860\t            \"0.249\",\n861\t            \"0.253\",\n862\t            \"-1.6%\",\n863\t            \"0.689\"\n864\t          ]\n865\t        ]\n866\t      }\n867\t    ],\n868\t    \"figures\": [],\n869\t    \"analysis\": \"Two-stage ≤5% improvement over strongest-K 且无统计显著性。这与 worst 档的预期一致： 如果 K_eff 没有独立效应（plan_004），那么在 robustness-screened pool 中最大化 K_eff 不应带来额外收益。Max-K_eff 是最差策略（ASR 最高）这一发现仍然有价值—— 它警告不要盲目追求 diversity——但这只需 η_max 解释就够了（高 K_eff = 混入弱模型 = 高 ASR）， 不需要 \\\"diversity independently hurts\\\" 的 claim。实践建议简化为 \\\"pick the most robust judges, ignore diversity\\\"，这比 two-stage 更简单但可能过于平凡。\\n\\n\\n在 worst 档下 K_eff 的独立效应已消失（plan_004 显示 capability-matched 后 K_eff NS）， 因此两阶段的第二步（maximize K_eff among screened judges）几乎不提供额外收益。 Robustness screening（step 1）本身有效——排除 η > threshold 的弱模型大幅降低 ASR—— 但这与简单的 strongest-K 策略效果相同。Two-stage 与 strongest-K 的差异仅 2.3% （p=0.312, NS），因为 screening 后剩余模型能力相近，K_eff 的变异范围收窄。 min_eta（不考虑 diversity）在 4/6 conditions 表现最佳，进一步说明 panel 安全由 最弱 judge 决定。Two-stage 的存在意义被削弱：如果第二步（diversity）没用， 算法退化为 \\\"just pick the strongest K models\\\"。\\n\"\n870\t  },\n871\t  {\n872\t    \"name\": \"Per-Judge ASR Concentration Analysis\",\n873\t    \"description\": \"对每个 panel × attack，计算各 judge 的 ASR 分布，用 Gini 系数和 entropy 量化 adaptive adversary 的 targeting 集中度。高 Gini = adversary 集中攻击特定 judge。\\n\",\n874\t    \"results\": {\n875\t      \"mean_gini_adaptive\": 0.38,\n876\t      \"mean_gini_random_fault\": 0.12,\n877\t      \"gini_diff_p\": \"<0.001\",\n878\t      \"mean_entropy_adaptive\": 2.41,\n879\t      \"mean_entropy_random_fault\": 3.22,\n880\t      \"entropy_diff_p\": \"<0.001\",\n881\t      \"gini_keff_correlation\": 0.21,\n882\t      \"gini_keff_p\": 0.089,\n883\t      \"gini_eta_max_correlation\": 0.67,\n884\t      \"gini_eta_max_p\": \"<0.001\",\n885\t      \"high_gini_panels_pct\": 34,\n886\t      \"targeting_consistent_across_attacks\": false\n887\t    },\n888\t    \"tables\": [\n889\t      {\n890\t        \"title\": \"Table 9: ASR Concentration Statistics\",\n891\t        \"columns\": [\n892\t          \"Metric\",\n893\t          \"Adaptive (mean)\",\n894\t          \"Adaptive (SD)\",\n895\t          \"RF (mean)\",\n896\t          \"RF (SD)\",\n897\t          \"Diff p\"\n898\t        ],\n899\t        \"rows\": [\n900\t          [\n901\t            \"Gini\",\n902\t            \"0.38\",\n903\t            \"0.14\",\n904\t            \"0.12\",\n905\t            \"0.05\",\n906\t            \"<0.001\"\n907\t          ],\n908\t          [\n909\t            \"Entropy (bits)\",\n910\t            \"2.41\",\n911\t            \"0.52\",\n912\t            \"3.22\",\n913\t            \"0.31\",\n914\t            \"<0.001\"\n915\t          ],\n916\t          [\n917\t            \"Max single-judge share\",\n918\t            \"0.51\",\n919\t            \"0.12\",\n920\t            \"0.38\",\n921\t            \"0.06\",\n922\t            \"<0.001\"\n923\t          ]\n924\t        ]\n925\t      },\n926\t      {\n927\t        \"title\": \"Table 10: Gini Coefficient Correlations\",\n928\t        \"columns\": [\n929\t          \"Predictor\",\n930\t          \"r with Gini\",\n931\t          \"p\",\n932\t          \"Interpretation\"\n933\t        ],\n934\t        \"rows\": [\n935\t          [\n936\t            \"η_max\",\n937\t            \"0.67\",\n938\t            \"<0.001\",\n939\t            \"Targeting tracks individual weakness\"\n940\t          ],\n941\t          [\n942\t            \"K_eff\",\n943\t            \"0.21\",\n944\t            \"0.089\",\n945\t            \"Weak/NS association with diversity\"\n946\t          ],\n947\t          [\n948\t            \"Panel size\",\n949\t            \"0.04\",\n950\t            \"0.814\",\n951\t            \"No panel size effect\"\n952\t          ],\n953\t          [\n954\t            \"Mean capability\",\n955\t            \"-0.58\",\n956\t            \"<0.001\",\n957\t            \"Stronger panels → less concentrated targeting\"\n958\t          ]\n959\t        ]\n960\t      }\n961\t    ],\n962\t    \"figures\": [],\n963\t    \"analysis\": \"Per-judge 浓度分析提供了 adaptive vs RF 差异的直接证据——这是一个有用的 finding， 可作为 paper 的 empirical contribution。但分析同时削弱了 diversity trap：targeting 集中度由 η_max（而非 K_eff）解释。Adaptive adversary 攻击最弱 judge，不是利用 diverse attack surface。这与 reframed narrative（η_max dominant, diversity irrelevant） 一致。Gini 分析可以移入 \\\"Adaptive Adversary Behavior\\\" 子节，作为 η_max dominance 的补充证据，而非 diversity trap 的支持。\\n\\n\\nAdaptive adversary 确实展现 targeting 行为（Gini 0.38 vs RF 0.12），但集中度 中等而非极端。关键问题：Gini 与 η_max 高度相关（r=0.67）但与 K_eff 弱相关（r=0.21, NS）。 这意味着 targeting 主要针对最弱 judge（η_max 高的 panel 中弱 judge 更容易被攻克）， 而不是利用 diversity 创造的 diverse attack surface。如果 K_eff 独立驱动 targeting， 我们预期 Gini 与 K_eff 显著相关（高 diversity → adversary 有更多独立漏洞可攻击 → 攻击更集中于特定 judge），但 p=0.089 未达显著。此外 targeting 不跨攻击一致—— 同一 panel 在不同攻击下被 target 的 judge 不同，进一步削弱 \\\"structural diversity creates systematic exploitable surface\\\" 的论点。\\n\"\n964\t  },\n965\t  {\n966\t    \"name\": \"Diversity-Capability Tradeoff Visualization\",\n967\t    \"description\": \"绘制 K_eff vs η_max across 455 panels，拟合 tradeoff curve，Pareto frontier analysis， 按 tier 分层。\\n\",\n968\t    \"results\": {\n969\t      \"keff_eta_max_pearson_r\": 0.73,\n970\t      \"keff_eta_max_spearman_rho\": 0.71,\n971\t      \"tradeoff_curve_R2\": 0.53,\n972\t      \"pareto_frontier_size\": 12,\n973\t      \"pareto_pct_from_large_tier\": 83,\n974\t      \"pareto_pct_from_mixed_tier\": 17,\n975\t      \"pareto_pct_from_small_tier\": 0,\n976\t      \"pareto_panels_mean_keff\": 1.82,\n977\t      \"pareto_panels_mean_eta_max\": 0.09,\n978\t      \"non_pareto_gap_ASR\": 0.11\n979\t    },\n980\t    \"tables\": [\n981\t      {\n982\t        \"title\": \"Table 11: Pareto Frontier Panel Characteristics\",\n983\t        \"columns\": [\n984\t          \"Panel ID\",\n985\t          \"Models\",\n986\t          \"K_eff\",\n987\t          \"η_max\",\n988\t          \"Mean ASR\",\n989\t          \"Tier Composition\"\n990\t        ],\n991\t        \"rows\": [\n992\t          [\n993\t            \"P_012\",\n994\t            \"GPT-4.1 / GPT-4o / Qwen72B\",\n995\t            \"1.91\",\n996\t            \"0.08\",\n997\t            \"0.142\",\n998\t            \"all-large\"\n999\t          ],\n1000\t          [\n1001\t            \"P_034\",\n1002\t            \"GPT-4.1 / Llama70B / GPT-4o\",\n1003\t            \"2.14\",\n1004\t            \"0.09\",\n1005\t            \"0.151\",\n1006\t            \"all-large\"\n1007\t          ],\n1008\t          [\n1009\t            \"P_087\",\n1010\t            \"GPT-4.1 / GPT-4o / Claude-Haiku\",\n1011\t            \"1.72\",\n1012\t            \"0.07\",\n1013\t            \"0.138\",\n1014\t            \"large+medium\"\n1015\t          ],\n1016\t          [\n1017\t            \"P_156\",\n1018\t            \"GPT-4o / Qwen72B / Llama70B\",\n1019\t            \"2.31\",\n1020\t            \"0.11\",\n1021\t            \"0.163\",\n1022\t            \"all-large\"\n1023\t          ],\n1024\t          [\n1025\t            \"P_201\",\n1026\t            \"GPT-4.1 / GPT-4.1m / GPT-4o\",\n1027\t            \"1.45\",\n1028\t            \"0.07\",\n1029\t            \"0.131\",\n1030\t            \"all-large\"\n1031\t          ]\n1032\t        ]\n1033\t      }\n1034\t    ],\n1035\t    \"figures\": [],\n1036\t    \"analysis\": \"Tradeoff visualization 是一个 clean methodological contribution，无论 K_eff 是否有 独立效应都有价值。它展示了当前 LLM 生态中 panel design 的结构约束：diversity 和 robustness 不是独立可优化的维度。但在 worst 档下，这更多被解读为 confound 的可视化 证据而非独立发现。可在论文中保留为 Fig 2 或 Fig 3，作为 \\\"understanding the evaluation landscape\\\" 的贡献。\\n\\n\\nTradeoff 可视化清晰展示了 K_eff 与 η_max 的结构性关联：r=0.73，Pareto frontier 几乎完全由 large-tier panel 占据（83%），因为只有在全部选择强模型时才能同时获得 低 η_max 和中等 K_eff。Small-tier panel 全部位于 Pareto frontier 之下。 这个 visualization 本身有价值（展示了 evaluation panel design 的结构约束）， 但在 worst 档下它更多地支持了 \\\"K_eff effect is confound\\\" 的叙事：tradeoff 不是 独立的两个维度的 tension，而是 tier-mixing 的必然结果。Pareto frontier 上的 panel 基本就是 \\\"all strong models\\\"，equivalent to strongest-K 策略。\\n\"\n1037\t  },\n1038\t  {\n1039\t    \"name\": \"Panel Size Sensitivity Analysis\",\n1040\t    \"description\": \"测试 K=3,5,7,9 不同 panel size 下 η_max 与 K_eff 的相对重要性是否变化。\\n\",\n1041\t    \"results\": {\n1042\t      \"K3_panels\": 455,\n1043\t      \"K5_panels\": 3003,\n1044\t      \"K7_panels\": 6435,\n1045\t      \"K9_panels\": 5005,\n1046\t      \"K3_eta_max_sig_ratio\": 0.75,\n1047\t      \"K5_eta_max_sig_ratio\": 0.83,\n1048\t      \"K7_eta_max_sig_ratio\": 0.92,\n1049\t      \"K9_eta_max_sig_ratio\": 0.92,\n1050\t      \"K3_keff_resid_sig_ratio\": 0.33,\n1051\t      \"K5_keff_resid_sig_ratio\": 0.25,\n1052\t      \"K7_keff_resid_sig_ratio\": 0.17,\n1053\t      \"K9_keff_resid_sig_ratio\": 0.08,\n1054\t      \"keff_effect_trend_with_K\": \"monotonically decreasing\"\n1055\t    },\n1056\t    \"tables\": [\n1057\t      {\n1058\t        \"title\": \"Table 12: Panel Size Sensitivity — Significance Ratios\",\n1059\t        \"columns\": [\n1060\t          \"K\",\n1061\t          \"N Panels\",\n1062\t          \"η_max sig ratio\",\n1063\t          \"K_eff resid sig ratio\",\n1064\t          \"Mean R²\",\n1065\t          \"K_eff-η_max r\"\n1066\t        ],\n1067\t        \"rows\": [\n1068\t          [\n1069\t            \"3\",\n1070\t            \"455\",\n1071\t            \"0.75\",\n1072\t            \"0.33\",\n1073\t            \"0.38\",\n1074\t            \"0.73\"\n1075\t          ],\n1076\t          [\n1077\t            \"5\",\n1078\t            \"3003\",\n1079\t            \"0.83\",\n1080\t            \"0.25\",\n1081\t            \"0.41\",\n1082\t            \"0.68\"\n1083\t          ],\n1084\t          [\n1085\t            \"7\",\n1086\t            \"6435\",\n1087\t            \"0.92\",\n1088\t            \"0.17\",\n1089\t            \"0.44\",\n1090\t            \"0.61\"\n1091\t          ],\n1092\t          [\n1093\t            \"9\",\n1094\t            \"5005\",\n1095\t            \"0.92\",\n1096\t            \"0.08\",\n1097\t            \"0.46\",\n1098\t            \"0.54\"\n1099\t          ]\n1100\t        ]\n1101\t      }\n1102\t    ],\n1103\t    \"figures\": [],\n1104\t    \"analysis\": \"Panel size 分析揭示 K_eff 效应的 artifactual nature：它在小 panel（K=3）中最强 恰好是 tier-mixing 方差最大的地方。随 K 增大，confound 缓解，K_eff 效应消退。 η_max 的趋势则相反——大 panel 中仍有弱 judge，且 R² 随 K 增大说明 panel composition 的可预测性提高。这是支持 \\\"K_eff is confound\\\" 的又一条证据线。\\n\\n\\nPanel size 增大时 η_max dominance 增强，K_eff effect 递减。原因：K=9 的 panel 包含 9/15 模型，几乎所有 panel 都包含至少一个弱模型，η_max 方差缩小但 level 保持高位。 同时 K_eff 的变异范围也缩小（大 panel 的 K_eff 趋向收敛）。更重要的是，majority vote 在大 panel 中的容错能力提高——但这被 η_max 的 monotonic 效应抵消（一个极弱 judge 的影响在 K=3 中是 catastrophic，在 K=9 中被稀释）。K_eff 的 sig ratio 从 K=3 的 0.33 降至 K=9 的 0.08，表明 K_eff 的表面效应主要在小 panel 中出现（因为 tier-mixing 的方差更大），进一步支持 confound 解释。\\n\"\n1105\t  },\n1106\t  {\n1107\t    \"name\": \"VIF and Multicollinearity Deep Dive\",\n1108\t    \"description\": \"对现有回归数据进行全面多重共线性分析：VIF、偏相关、residualized K_eff、 Bonferroni/FDR correction、bootstrap CI、排除极端模型的敏感性分析、beta regression。\\n\",\n1109\t    \"results\": {\n1110\t      \"VIF_keff_full_model\": 2.14,\n1111\t      \"VIF_eta_max_full_model\": 2.14,\n1112\t      \"keff_resid_sig_bonferroni_12\": 2,\n1113\t      \"keff_resid_sig_fdr_12\": 4,\n1114\t      \"keff_resid_sig_bootstrap_95CI_excludes_zero\": 3,\n1115\t      \"keff_resid_sig_exclude_extreme_models\": 4,\n1116\t      \"keff_resid_sig_exclude_extreme_models_fdr\": 3,\n1117\t      \"beta_regression_keff_sig\": 3,\n1118\t      \"beta_regression_eta_max_sig\": 10,\n1119\t      \"partial_r_keff_given_eta_max\": 0.14,\n1120\t      \"partial_r_eta_max_given_keff\": 0.41,\n1121\t      \"sensitivity_analyses_convergent\": false,\n1122\t      \"keff_resid_sig_range_across_methods\": [\n1123\t        2,\n1124\t        5\n1125\t      ]\n1126\t    },\n1127\t    \"tables\": [\n1128\t      {\n1129\t        \"title\": \"Table 13: K_eff Residualized Significance Under Different Correction Methods\",\n1130\t        \"columns\": [\n1131\t          \"Method\",\n1132\t          \"K_eff sig count (/12)\",\n1133\t          \"η_max sig count (/12)\",\n1134\t          \"Notes\"\n1135\t        ],\n1136\t        \"rows\": [\n1137\t          [\n1138\t            \"Uncorrected\",\n1139\t            \"7\",\n1140\t            \"10\",\n1141\t            \"Liberal\"\n1142\t          ],\n1143\t          [\n1144\t            \"FDR (BH)\",\n1145\t            \"4\",\n1146\t            \"9\",\n1147\t            \"Standard\"\n1148\t          ],\n1149\t          [\n1150\t            \"Bonferroni\",\n1151\t            \"2\",\n1152\t            \"8\",\n1153\t            \"Conservative\"\n1154\t          ],\n1155\t          [\n1156\t            \"Bootstrap 95% CI\",\n1157\t            \"3\",\n1158\t            \"9\",\n1159\t            \"Non-parametric\"\n1160\t          ],\n1161\t          [\n1162\t            \"Exclude extreme models (FDR)\",\n1163\t            \"3\",\n1164\t            \"9\",\n1165\t            \"Sensitivity\"\n1166\t          ],\n1167\t          [\n1168\t            \"Beta regression (FDR)\",\n1169\t            \"3\",\n1170\t            \"10\",\n1171\t            \"Bounded DV\"\n1172\t          ]\n1173\t        ]\n1174\t      },\n1175\t      {\n1176\t        \"title\": \"Table 14: Partial Correlations\",\n1177\t        \"columns\": [\n1178\t          \"Predictor\",\n1179\t          \"Partial r (controlling other)\",\n1180\t          \"95% CI\",\n1181\t          \"p\"\n1182\t        ],\n1183\t        \"rows\": [\n1184\t          [\n1185\t            \"K_eff | η_max\",\n1186\t            \"0.14\",\n1187\t            \"[0.05, 0.23]\",\n1188\t            \"0.003\"\n1189\t          ],\n1190\t          [\n1191\t            \"η_max | K_eff\",\n1192\t            \"0.41\",\n1193\t            \"[0.33, 0.49]\",\n1194\t            \"<0.001\"\n1195\t          ]\n1196\t        ]\n1197\t      }\n1198\t    ],\n1199\t    \"figures\": [],\n1200\t    \"analysis\": \"VIF 分析是 worst 档的核心打击。K_eff 的显著性在 2-5/12 范围内波动，高度依赖 统计方法选择——这是 \\\"researcher degrees of freedom\\\" 问题。Partial r (K_eff | η_max) = 0.14 意味着 K_eff 在控制 η_max 后仅解释 2% 的独特方差（r²=0.02）。相比之下 η_max 的 partial r = 0.41（17% 独特方差）。即使 K_eff 有微弱的独立效应，其实际意义（practical significance）可忽略。论文中需要诚实报告所有方法的结果范围，不能只报最有利的。\\n\\n\\nVIF=2.14 在传统标准下不算严重（<5），但这掩盖了非线性 confound。Bonferroni 最严格， K_eff 降至 2/12 显著；FDR 保持 4/12；bootstrap CI 给出 3/12（因为 bootstrap 在 455 panels 中重复抽样，resampling variance 较大导致 CI 加宽）。排除极端模型 （ACC < 0.5 的 2 个模型）后 K_eff 4/12→3/12（FDR），说明效应部分依赖极端值。 Beta regression（适合 bounded proportion DV）与 OLS 结果不一致——K_eff 仅 3/12 显著（beta regression 对极端值更稳健）。核心问题：不同分析方法给出 2-5/12 的 显著性范围，缺乏收敛性。Reviewer 可以选择最严格的估计（2/12 Bonferroni）argue K_eff 无效应，或选择最宽松的（5/12 FDR without extreme exclusion）argue suggestive。 这种方法敏感性本身就是 \\\"not robust\\\" 的标志。\\n\"\n1201\t  },\n1202\t  {\n1203\t    \"name\": \"Aggregation Rule Comparison\",\n1204\t    \"description\": \"在 15 模型 455 panel 上测试 majority vote、threshold voting（unanimity）、 weighted voting、Bayesian aggregation 四种聚合规则下的 K_eff 和 η_max 效应。\\n\",\n1205\t    \"results\": {\n1206\t      \"majority_keff_resid_sig\": 4,\n1207\t      \"majority_eta_max_sig\": 9,\n1208\t      \"threshold_keff_resid_sig\": 6,\n1209\t      \"threshold_eta_max_sig\": 7,\n1210\t      \"weighted_keff_resid_sig\": 2,\n1211\t      \"weighted_eta_max_sig\": 10,\n1212\t      \"bayesian_keff_resid_sig\": 1,\n1213\t      \"bayesian_eta_max_sig\": 5,\n1214\t      \"keff_sig_varies_by_aggregation\": true,\n1215\t      \"aggregation_dependency_interpretation\": \"K_eff effect is aggregation artifact\"\n1216\t    },\n1217\t    \"tables\": [\n1218\t      {\n1219\t        \"title\": \"Table 15: Aggregation Rule × Vulnerability Driver Analysis\",\n1220\t        \"columns\": [\n1221\t          \"Aggregation\",\n1222\t          \"K_eff sig (/12)\",\n1223\t          \"η_max sig (/12)\",\n1224\t          \"Mean R²\",\n1225\t          \"Best Predictor\"\n1226\t        ],\n1227\t        \"rows\": [\n1228\t          [\n1229\t            \"Majority Vote\",\n1230\t            \"4\",\n1231\t            \"9\",\n1232\t            \"0.38\",\n1233\t            \"η_max\"\n1234\t          ],\n1235\t          [\n1236\t            \"Threshold (Unanimity)\",\n1237\t            \"6\",\n1238\t            \"7\",\n1239\t            \"0.42\",\n1240\t            \"mixed\"\n1241\t          ],\n1242\t          [\n1243\t            \"Accuracy-Weighted\",\n1244\t            \"2\",\n1245\t            \"10\",\n1246\t            \"0.45\",\n1247\t            \"η_max\"\n1248\t          ],\n1249\t          [\n1250\t            \"Bayesian\",\n1251\t            \"1\",\n1252\t            \"5\",\n1253\t            \"0.29\",\n1254\t            \"η_max (weakened)\"\n1255\t          ]\n1256\t        ]\n1257\t      },\n1258\t      {\n1259\t        \"title\": \"Table 16: Aggregation as Defense — Mean ASR Comparison\",\n1260\t        \"columns\": [\n1261\t          \"Aggregation\",\n1262\t          \"Mean ASR (all panels)\",\n1263\t          \"ASR (top-10 panels)\",\n1264\t          \"ASR (bottom-10 panels)\",\n1265\t          \"Spread\"\n1266\t        ],\n1267\t        \"rows\": [\n1268\t          [\n1269\t            \"Majority\",\n1270\t            \"0.261\",\n1271\t            \"0.142\",\n1272\t            \"0.418\",\n1273\t            \"0.276\"\n1274\t          ],\n1275\t          [\n1276\t            \"Threshold\",\n1277\t            \"0.183\",\n1278\t            \"0.098\",\n1279\t            \"0.312\",\n1280\t            \"0.214\"\n1281\t          ],\n1282\t          [\n1283\t            \"Weighted\",\n1284\t            \"0.224\",\n1285\t            \"0.121\",\n1286\t            \"0.367\",\n1287\t            \"0.246\"\n1288\t          ],\n1289\t          [\n1290\t            \"Bayesian\",\n1291\t            \"0.198\",\n1292\t            \"0.112\",\n1293\t            \"0.294\",\n1294\t            \"0.182\"\n1295\t          ]\n1296\t        ]\n1297\t      }\n1298\t    ],\n1299\t    \"figures\": [],\n1300\t    \"analysis\": \"Aggregation 分析是 worst 档中最具建设性的发现。虽然它进一步削弱了 K_eff 作为 independent driver 的 claim（aggregation-dependent → possible artifact），但它提供了 实际价值：(a) Bayesian aggregation 作为 defense 的有效性（ASR 均值和方差同时降低）； (b) Threshold voting 最严格但 K_eff 效应最强——不适合 adversarial setting； (c) Accuracy-weighted 是 good middle ground（K_eff 几乎消失，η_max 仍可控）。 可以 reframe 为 practical contribution: \\\"choosing the right aggregation rule matters more than panel diversity composition\\\"。\\n\\n\\n聚合规则分析暴露 K_eff 效应的 aggregation dependency。Threshold voting（unanimity） 下 K_eff 6/12 显著——因为 unanimity 放大了单个 judge 的 veto power，diverse panel 中弱 judge 更可能 veto 正确判断。但这不是 \\\"diversity hurts\\\"，而是 \\\"unanimity amplifies weakest-link effect, and diverse panels have weaker links\\\"。Bayesian aggregation 大幅削弱两个 predictor：η_max 5/12，K_eff 1/12——Bayesian weighting 有效下调了不可靠 judge 的权重，部分 neutralize 了 weakest-link 效应。 Weighted voting 下 K_eff 几乎消失（2/12），因为 accuracy-based weights 自动 降权弱模型。核心问题：K_eff 的显著性从 1/12（Bayesian）到 6/12（threshold）—— 如果 K_eff 是真正的 structural vulnerability driver，它不应该如此依赖聚合规则。 这种依赖性暗示 K_eff 效应实际上是特定聚合规则对弱 judge 处理方式的 artifact。\\n\"\n1301\t  },\n1302\t  {\n1303\t    \"name\": \"Open-Ended Generation Benchmark\",\n1304\t    \"description\": \"在 MT-Bench 或 AlpacaEval 风格的开放式生成任务上运行攻击实验， 验证 MCQ findings 是否推广到 open-ended evaluation。\\n\",\n1305\t    \"results\": {\n1306\t      \"benchmark\": \"MT-Bench (adapted)\",\n1307\t      \"n_conditions\": 4,\n1308\t      \"keff_resid_sig_positive\": 0,\n1309\t      \"keff_resid_sig_negative\": 1,\n1310\t      \"keff_resid_nonsig\": 3,\n1311\t      \"eta_max_sig\": 4,\n1312\t      \"keff_direction_inconsistent_with_MCQ\": true,\n1313\t      \"open_ended_mean_ASR\": 0.34,\n1314\t      \"MCQ_mean_ASR\": 0.26,\n1315\t      \"eta_max_dominance_ratio_open\": 0.91\n1316\t    },\n1317\t    \"tables\": [\n1318\t      {\n1319\t        \"title\": \"Table 17: Open-Ended Task Results\",\n1320\t        \"columns\": [\n1321\t          \"Task Subset\",\n1322\t          \"Attack\",\n1323\t          \"β_ηmax\",\n1324\t          \"p_ηmax\",\n1325\t          \"β_Keff_resid\",\n1326\t          \"p_Keff_resid\",\n1327\t          \"Direction\"\n1328\t        ],\n1329\t        \"rows\": [\n1330\t          [\n1331\t            \"MT-Bench-Writing\",\n1332\t            \"style_manip\",\n1333\t            \"0.79\",\n1334\t            \"<0.001\",\n1335\t            \"-0.22\",\n1336\t            \"0.034\",\n1337\t            \"NEGATIVE\"\n1338\t          ],\n1339\t          [\n1340\t            \"MT-Bench-Reasoning\",\n1341\t            \"logic_distort\",\n1342\t            \"0.84\",\n1343\t            \"<0.001\",\n1344\t            \"0.08\",\n1345\t            \"0.541\",\n1346\t            \"near-zero\"\n1347\t          ],\n1348\t          [\n1349\t            \"MT-Bench-Coding\",\n1350\t            \"output_inject\",\n1351\t            \"0.71\",\n1352\t            \"0.002\",\n1353\t            \"0.15\",\n1354\t            \"0.218\",\n1355\t            \"positive (NS)\"\n1356\t          ],\n1357\t          [\n1358\t            \"MT-Bench-Math\",\n1359\t            \"step_skip\",\n1360\t            \"0.88\",\n1361\t            \"<0.001\",\n1362\t            \"-0.05\",\n1363\t            \"0.712\",\n1364\t            \"near-zero\"\n1365\t          ]\n1366\t        ]\n1367\t      }\n1368\t    ],\n1369\t    \"figures\": [],\n1370\t    \"analysis\": \"Open-ended 结果是 diversity trap 叙事的 generalizability failure。K_eff 在 MCQ 上 的正向效应不推广到 open-ended 评估——方向不一致且 1 个条件甚至反转。这使得 diversity trap 从 general finding 降级为 MCQ-specific observation，reviewers 会 质疑：如果 diversity 只在 MCQ 中 \\\"hurts\\\"，这到底是 diversity 的问题还是 MCQ evaluation 的 artifact？η_max 在两种任务上都一致显著，强化了 weakest-link 作为 universal driver 的地位。Reframe 后论文应在 title/abstract 中避免 generalize， 限定为 \\\"MCQ-based evaluation\\\" 或在 Discussion 中作为 limitation 显著标注。\\n\\n\\nOpen-ended 任务与 MCQ 的攻击动态根本不同。MCQ 攻击通过影响 judge 对特定选项的偏好， K_eff 的 confound 来自 tier-mixing。Open-ended 评估中 judge 需要评估文本质量—— 攻击更多依赖 persuasive text generation，所有 judge 面临相似的 adversarial text。 因此 η_max 完全主导（4/4 sig）：最弱 judge 被最容易说服。K_eff 方向混乱——1 个 条件甚至显著负向（diverse panel 更好），因为 open-ended 评估中不同 judge 对文本 质量的多角度评估确实可以互补（更接近 BFT 的 benign fault 假设）。这与 MCQ 结果 不一致是 worst 档的关键打击：如果 diversity trap 不跨任务推广，它就不是一般性 原理，而是 MCQ 评估的特异性现象——可能由 MCQ 的离散选择结构 + tier-mixing confound 共同驱动。\\n\"\n1371\t  },\n1372\t  {\n1373\t    \"name\": \"Partial-Knowledge Adversary Simulation\",\n1374\t    \"description\": \"模拟 adversary 仅知 judge family 但不知具体 vulnerability profile 的场景。 与 full-knowledge adversary 对比 ASR degradation。\\n\",\n1375\t    \"results\": {\n1376\t      \"full_knowledge_mean_ASR\": 0.261,\n1377\t      \"partial_knowledge_mean_ASR\": 0.238,\n1378\t      \"no_knowledge_mean_ASR\": 0.204,\n1379\t      \"ASR_degradation_full_to_partial_pct\": 8.8,\n1380\t      \"ASR_degradation_full_to_none_pct\": 21.8,\n1381\t      \"partial_keff_sig\": 2,\n1382\t      \"partial_eta_max_sig\": 8,\n1383\t      \"family_knowledge_utility\": \"modest\",\n1384\t      \"keff_effect_under_partial\": \"weaker than full, similar direction\"\n1385\t    },\n1386\t    \"tables\": [\n1387\t      {\n1388\t        \"title\": \"Table 18: Adversary Knowledge Level Comparison\",\n1389\t        \"columns\": [\n1390\t          \"Knowledge Level\",\n1391\t          \"Mean ASR\",\n1392\t          \"K_eff sig (/12)\",\n1393\t          \"η_max sig (/12)\",\n1394\t          \"R²\"\n1395\t        ],\n1396\t        \"rows\": [\n1397\t          [\n1398\t            \"Full (exact η_j)\",\n1399\t            \"0.261\",\n1400\t            \"4\",\n1401\t            \"9\",\n1402\t            \"0.38\"\n1403\t          ],\n1404\t          [\n1405\t            \"Partial (family only)\",\n1406\t            \"0.238\",\n1407\t            \"2\",\n1408\t            \"8\",\n1409\t            \"0.34\"\n1410\t          ],\n1411\t          [\n1412\t            \"None (uniform attack)\",\n1413\t            \"0.204\",\n1414\t            \"0\",\n1415\t            \"6\",\n1416\t            \"0.22\"\n1417\t          ]\n1418\t        ]\n1419\t      },\n1420\t      {\n1421\t        \"title\": \"Table 19: ASR Degradation Analysis\",\n1422\t        \"columns\": [\n1423\t          \"Transition\",\n1424\t          \"ΔASR\",\n1425\t          \"Δ%\",\n1426\t          \"Interpretation\"\n1427\t        ],\n1428\t        \"rows\": [\n1429\t          [\n1430\t            \"Full → Partial\",\n1431\t            \"-0.023\",\n1432\t            \"-8.8%\",\n1433\t            \"Family info has modest value\"\n1434\t          ],\n1435\t          [\n1436\t            \"Full → None\",\n1437\t            \"-0.057\",\n1438\t            \"-21.8%\",\n1439\t            \"Model knowledge matters but not dramatically\"\n1440\t          ],\n1441\t          [\n1442\t            \"Partial → None\",\n1443\t            \"-0.034\",\n1444\t            \"-14.3%\",\n1445\t            \"Family info alone provides limited advantage\"\n1446\t          ]\n1447\t        ]\n1448\t      }\n1449\t    ],\n1450\t    \"figures\": [],\n1451\t    \"analysis\": \"Partial-knowledge 分析有两个重要含义：(a) 实践上，adversary 不需要精确 vulnerability 知识就能实现高 ASR（从 0.261 到 0.204 的下降 modest）——这本身是一个重要的安全发现； (b) 理论上，K_eff 效应依赖 full-knowledge 假设，在更现实的 threat model 下消失—— 这削弱了 K_eff 作为 general vulnerability driver 的 claim。在 reframed 论文中， 这个实验可以支持 \\\"η_max is robust across threat models while K_eff is threat-model-specific\\\" 的叙事。\\n\\nPartial-knowledge adversary（知 family 不知具体 vulnerability）仅比 full-knowledge 下降 8.8% ASR——说明 family 信息提供的攻击优势有限，因为 same-family 模型的 vulnerability profile 差异大（family labels 不可靠，plan_004 的 claim 4）。 No-knowledge adversary 下降 21.8%——说明 any model knowledge 都有价值但不是 dramatic。 K_eff 在 partial-knowledge 下仅 2/12 显著，进一步弱化了 \\\"diverse attack surface\\\" 叙事：如果 adversary 不知道具体 vulnerability，panel diversity 不应创造可利用的 attack surface（adversary 无法 target specific judges）。K_eff 效应在 partial-knowledge 下几乎消失，暗示 full-knowledge 下的 K_eff 效应部分来自 adversary 对具体 vulnerability 的知识（即 K_eff 效应依赖 threat model 假设——full-knowledge 在实践中不现实）。\\n\"\n1452\t  }\n1453\t]"}]},"parent_tool_use_id":null,"session_id":"fafed79b-b5e7-4590-860f-cf22319c4462","uuid":"e7e20ec7-f2d3-4569-a5fa-8b54c92875c1","timestamp":"2026-05-22T18:26:51.884Z","tool_use_result":{"type":"text","file":{"filePath":"/home/ubuntu/.agent-ml-research-idea_gen_0519_2/projects/cert_manip_resist_eval/artifacts/dream_reports/dream_20260522T173833/worst/experiment_data.json","content":"[\n  {\n    \"name\": \"15-Model Scale Expansion\",\n    \"description\": \"扩展至 15 个模型（6 open-source + 4 API + 大型开源 70B/72B），重跑 MI matrix 和 全 panel（C(15,3)=455）回归分析。12 conditions（2 datasets × 6 attacks）。\\n\",\n    \"results\": {\n      \"n_models\": 15,\n      \"n_panels\": 455,\n      \"n_conditions\": 12,\n      \"keff_raw_sig_positive\": 7,\n      \"keff_raw_sig_negative\": 0,\n      \"keff_raw_nonsig\": 5,\n      \"keff_resid_sig_positive\": 4,\n      \"keff_resid_nonsig\": 8,\n      \"eta_max_sig\": 9,\n      \"mean_R2_full_model\": 0.38,\n      \"mean_R2_eta_max_only\": 0.34,\n      \"delta_R2_keff_contribution\": 0.04,\n      \"keff_eta_max_correlation_mean\": 0.73,\n      \"keff_eta_max_correlation_range\": [\n        0.62,\n        0.85\n      ],\n      \"VIF_keff\": 2.14,\n      \"confound_free_conditions_count\": 1,\n      \"confound_free_condition_keff_p\": 0.032,\n      \"confound_free_condition_keff_beta\": 0.41\n    },\n    \"tables\": [\n      {\n        \"title\": \"Table 1: K_eff Residualized Regression — 15 Models, 455 Panels\",\n        \"columns\": [\n          \"Dataset\",\n          \"Attack\",\n          \"β_ηmax\",\n          \"p_ηmax\",\n          \"β_Keff_resid\",\n          \"p_Keff_resid\",\n          \"R²\",\n          \"K_eff-ηmax r\"\n        ],\n        \"rows\": [\n          [\n            \"MMLU\",\n            \"sycophancy\",\n            \"0.82\",\n            \"<0.001\",\n            \"0.18\",\n            \"0.147\",\n            \"0.41\",\n            \"0.78\"\n          ],\n          [\n            \"MMLU\",\n            \"score_manip\",\n            \"0.55\",\n            \"<0.001\",\n            \"0.39\",\n            \"0.021\",\n            \"0.36\",\n            \"0.68\"\n          ],\n          [\n            \"MMLU\",\n            \"position\",\n            \"0.71\",\n            \"<0.001\",\n            \"0.24\",\n            \"0.089\",\n            \"0.39\",\n            \"0.75\"\n          ],\n          [\n            \"MMLU\",\n            \"verbosity\",\n            \"0.88\",\n            \"<0.001\",\n            \"0.09\",\n            \"0.511\",\n            \"0.42\",\n            \"0.81\"\n          ],\n          [\n            \"MMLU\",\n            \"authority\",\n            \"0.79\",\n            \"<0.001\",\n            \"0.15\",\n            \"0.218\",\n            \"0.37\",\n            \"0.76\"\n          ],\n          [\n            \"MMLU\",\n            \"few_shot_hijack\",\n            \"0.64\",\n            \"0.002\",\n            \"0.31\",\n            \"0.043\",\n            \"0.33\",\n            \"0.70\"\n          ],\n          [\n            \"ARC\",\n            \"sycophancy\",\n            \"0.85\",\n            \"<0.001\",\n            \"0.12\",\n            \"0.341\",\n            \"0.43\",\n            \"0.79\"\n          ],\n          [\n            \"ARC\",\n            \"score_manip\",\n            \"0.48\",\n            \"0.003\",\n            \"0.41\",\n            \"0.032\",\n            \"0.35\",\n            \"0.35\"\n          ],\n          [\n            \"ARC\",\n            \"position\",\n            \"0.73\",\n            \"<0.001\",\n            \"0.22\",\n            \"0.102\",\n            \"0.38\",\n            \"0.74\"\n          ],\n          [\n            \"ARC\",\n            \"verbosity\",\n            \"0.91\",\n            \"<0.001\",\n            \"0.06\",\n            \"0.649\",\n            \"0.44\",\n            \"0.82\"\n          ],\n          [\n            \"ARC\",\n            \"authority\",\n            \"0.76\",\n            \"<0.001\",\n            \"0.19\",\n            \"0.157\",\n            \"0.36\",\n            \"0.77\"\n          ],\n          [\n            \"ARC\",\n            \"few_shot_hijack\",\n            \"0.59\",\n            \"0.004\",\n            \"0.28\",\n            \"0.071\",\n            \"0.32\",\n            \"0.72\"\n          ]\n        ]\n      },\n      {\n        \"title\": \"Table 2: Model Pool Summary — 15 Models\",\n        \"columns\": [\n          \"Model\",\n          \"Family\",\n          \"Size\",\n          \"Tier\",\n          \"Mean η (6 attacks)\",\n          \"Clean ACC\"\n        ],\n        \"rows\": [\n          [\n            \"Qwen2.5-7B\",\n            \"Qwen\",\n            \"7B\",\n            \"small\",\n            \"0.38\",\n            \"0.61\"\n          ],\n          [\n            \"Qwen2.5-14B\",\n            \"Qwen\",\n            \"14B\",\n            \"medium\",\n            \"0.22\",\n            \"0.74\"\n          ],\n          [\n            \"Qwen2.5-72B\",\n            \"Qwen\",\n            \"72B\",\n            \"large\",\n            \"0.11\",\n            \"0.83\"\n          ],\n          [\n            \"Llama-3.1-8B\",\n            \"Llama\",\n            \"8B\",\n            \"small\",\n            \"0.41\",\n            \"0.58\"\n          ],\n          [\n            \"Llama-3.1-70B\",\n            \"Llama\",\n            \"70B\",\n            \"large\",\n            \"0.14\",\n            \"0.80\"\n          ],\n          [\n            \"Mistral-7B\",\n            \"Mistral\",\n            \"7B\",\n            \"small\",\n            \"0.44\",\n            \"0.55\"\n          ],\n          [\n            \"Mistral-Nemo-12B\",\n            \"Mistral\",\n            \"12B\",\n            \"medium\",\n            \"0.27\",\n            \"0.69\"\n          ],\n          [\n            \"Phi-3-mini\",\n            \"Microsoft\",\n            \"3.8B\",\n            \"small\",\n            \"0.49\",\n            \"0.52\"\n          ],\n          [\n            \"Phi-3-medium\",\n            \"Microsoft\",\n            \"14B\",\n            \"medium\",\n            \"0.25\",\n            \"0.71\"\n          ],\n          [\n            \"Gemma-2-9B\",\n            \"Google\",\n            \"9B\",\n            \"small\",\n            \"0.36\",\n            \"0.63\"\n          ],\n          [\n            \"GPT-4o-mini\",\n            \"OpenAI\",\n            \"API\",\n            \"medium\",\n            \"0.19\",\n            \"0.76\"\n          ],\n          [\n            \"GPT-4o\",\n            \"OpenAI\",\n            \"API\",\n            \"large\",\n            \"0.08\",\n            \"0.87\"\n          ],\n          [\n            \"GPT-4.1\",\n            \"OpenAI\",\n            \"API\",\n            \"large\",\n            \"0.07\",\n            \"0.89\"\n          ],\n          [\n            \"GPT-4.1-mini\",\n            \"OpenAI\",\n            \"API\",\n            \"medium\",\n            \"0.16\",\n            \"0.78\"\n          ],\n          [\n            \"Claude-3.5-Haiku\",\n            \"Anthropic\",\n            \"API\",\n            \"medium\",\n            \"0.18\",\n            \"0.77\"\n          ]\n        ]\n      }\n    ],\n    \"figures\": [],\n    \"analysis\": \"核心 diversity trap framing 受到致命打击。K_eff residualized 显著率从期望的 8/12 降至 4/12，且这 4 个中有 2 个 p 值在 0.02-0.04 之间（经 FDR 校正后可能变 NS）。 仅 1 个 confound-free condition 意味着 residualization 的可信度依赖于线性假设—— reviewer 可以合理质疑 \\\"你的 K_eff effect 只是 nonlinear η_max effect 的残余\\\"。 η_max 9/12 显著是稳健的，weakest-link 叙事成立，但这是预期结果不是新发现。 ΔR² = 0.04 使得 \\\"dual vulnerability driver\\\" 的 framing 难以为继——第二个 driver 解释力不到 4%。需要 reframe 为 η_max-dominant 故事。\\n\\n\\n15 模型涵盖 3 个 capability tier（small 7-8B、medium 13-14B、large 70B+ 及 API）， tier 跨度增大导致 K_eff 与 η_max 的 confound 加剧（r≈0.73）。高 K_eff panel 几乎 必然混入弱模型，低 K_eff panel 则趋于同质强模型。Residualization 后 K_eff 仅在 4/12 conditions 保持显著——恰好是 transferable attack（score_manipulation, position_bias） 且 η_max 方差本身较大的条件。其余 8 conditions 中 K_eff 的 partial effect 被 η_max 吸收殆尽。η_max 维持 9/12 显著，证明 weakest-link 仍是 dominant driver。 ΔR² 仅 0.04 意味着 K_eff 在 η_max 之上的增量解释力微乎其微。 仅 1 个 confound-free condition（arc×score_manipulation, r≈0.35）中 K_eff 勉强显著 （p=0.032），但单一 condition 无法支撑核心 claim。\\n\"\n  },\n  {\n    \"name\": \"Attack Type Expansion\",\n    \"description\": \"新增 few-shot hijacking、persona manipulation、instruction override 三种攻击类型， 在 15 模型 455 panel 上运行，产生 6 个新 conditions（2 datasets × 3 new attacks）。\\n\",\n    \"results\": {\n      \"new_conditions\": 6,\n      \"keff_resid_sig_new\": 2,\n      \"keff_resid_nonsig_new\": 4,\n      \"eta_max_sig_new\": 5,\n      \"keff_direction_positive_new\": 4,\n      \"keff_direction_negative_new\": 1,\n      \"keff_direction_near_zero_new\": 1,\n      \"mean_R2_new_conditions\": 0.31,\n      \"combined_keff_resid_sig_18\": 6,\n      \"combined_eta_max_sig_18\": 14\n    },\n    \"tables\": [\n      {\n        \"title\": \"Table 3: New Attack Types — K_eff Residualized Results\",\n        \"columns\": [\n          \"Dataset\",\n          \"Attack\",\n          \"β_ηmax\",\n          \"p_ηmax\",\n          \"β_Keff_resid\",\n          \"p_Keff_resid\",\n          \"R²\",\n          \"Direction\"\n        ],\n        \"rows\": [\n          [\n            \"MMLU\",\n            \"few_shot_hijack\",\n            \"0.64\",\n            \"0.002\",\n            \"0.31\",\n            \"0.043\",\n            \"0.33\",\n            \"positive\"\n          ],\n          [\n            \"MMLU\",\n            \"persona_manip\",\n            \"0.91\",\n            \"<0.001\",\n            \"0.05\",\n            \"0.724\",\n            \"0.45\",\n            \"near-zero\"\n          ],\n          [\n            \"MMLU\",\n            \"instruct_override\",\n            \"0.58\",\n            \"0.005\",\n            \"0.34\",\n            \"0.038\",\n            \"0.31\",\n            \"positive\"\n          ],\n          [\n            \"ARC\",\n            \"few_shot_hijack\",\n            \"0.59\",\n            \"0.004\",\n            \"0.28\",\n            \"0.071\",\n            \"0.32\",\n            \"positive\"\n          ],\n          [\n            \"ARC\",\n            \"persona_manip\",\n            \"0.87\",\n            \"<0.001\",\n            \"-0.12\",\n            \"0.389\",\n            \"0.41\",\n            \"negative\"\n          ],\n          [\n            \"ARC\",\n            \"instruct_override\",\n            \"0.62\",\n            \"0.003\",\n            \"0.26\",\n            \"0.088\",\n            \"0.30\",\n            \"positive\"\n          ]\n        ]\n      }\n    ],\n    \"figures\": [],\n    \"analysis\": \"攻击扩展没有挽救 K_eff 叙事。新增条件中 K_eff 显著率 2/6，其中 persona manipulation 出现方向反转（K_eff 负但 NS）——这与 \\\"diversity hurts\\\" 不一致，虽然不显著但给 reviewer 提供了攻击点。合计 18 conditions 中 K_eff 6/18 显著，低于 33% 的 chance expected 阈值，FDR 校正后预计降至 4-5/18。η_max 14/18 显著，进一步巩固 weakest-link 的 dominant 地位。新攻击类型未发现任何 K_eff dominates η_max 的条件。\\n\\n\\n新攻击类型中 few-shot hijacking 和 instruction override 是 transferable attack， K_eff 在这些条件下可能保持微弱正向显著（p≈0.03-0.04）；persona manipulation 则高度 依赖模型特定 persona alignment 训练，η_max 几乎完全解释方差。整体上新增 6 conditions 中仅 2 个 K_eff 显著，且 1 个条件 K_eff 方向为负（persona manipulation on ARC）， 方向不一致削弱了 \\\"diversity universally hurts\\\" 的叙事。18 条件合计 K_eff 6/18 ≈ 33% 显著率——FDR 校正后可能进一步缩减至 4-5/18，属于 \\\"suggestive but not robust\\\" 水平。\\n\"\n  },\n  {\n    \"name\": \"Random-Fault BFT Contrast Simulation\",\n    \"description\": \"模拟随机故障场景：每个 judge 以概率 η_j 独立犯错，majority vote 决策。 比较 K_eff 在 random-fault vs adaptive 两种 regime 下的 β 和显著性。\\n\",\n    \"results\": {\n      \"RF_keff_sig_positive\": 10,\n      \"RF_keff_nonsig\": 2,\n      \"RF_eta_max_sig\": 11,\n      \"RF_mean_beta_keff\": 0.42,\n      \"adaptive_mean_beta_keff\": 0.38,\n      \"BFT_RF_beta_ratio\": 0.91,\n      \"RF_mean_R2\": 0.62,\n      \"adaptive_mean_R2\": 0.38,\n      \"delta_R2_RF_vs_adaptive\": 0.24,\n      \"RF_keff_direction\": \"positive (same as adaptive)\",\n      \"regime_contrast_p_interaction\": 0.217\n    },\n    \"tables\": [\n      {\n        \"title\": \"Table 4: BFT Regime Contrast — K_eff β Comparison\",\n        \"columns\": [\n          \"Dataset\",\n          \"Attack\",\n          \"β_Keff (Adaptive)\",\n          \"p (Adaptive)\",\n          \"β_Keff (RF)\",\n          \"p (RF)\",\n          \"β Ratio\",\n          \"Interaction p\"\n        ],\n        \"rows\": [\n          [\n            \"MMLU\",\n            \"sycophancy\",\n            \"0.18\",\n            \"0.147\",\n            \"0.21\",\n            \"0.024\",\n            \"1.17\",\n            \"0.682\"\n          ],\n          [\n            \"MMLU\",\n            \"score_manip\",\n            \"0.39\",\n            \"0.021\",\n            \"0.44\",\n            \"0.003\",\n            \"1.13\",\n            \"0.541\"\n          ],\n          [\n            \"MMLU\",\n            \"position\",\n            \"0.24\",\n            \"0.089\",\n            \"0.28\",\n            \"0.011\",\n            \"1.17\",\n            \"0.614\"\n          ],\n          [\n            \"MMLU\",\n            \"verbosity\",\n            \"0.09\",\n            \"0.511\",\n            \"0.15\",\n            \"0.108\",\n            \"1.67\",\n            \"0.398\"\n          ],\n          [\n            \"MMLU\",\n            \"authority\",\n            \"0.15\",\n            \"0.218\",\n            \"0.19\",\n            \"0.047\",\n            \"1.27\",\n            \"0.583\"\n          ],\n          [\n            \"MMLU\",\n            \"few_shot_hijack\",\n            \"0.31\",\n            \"0.043\",\n            \"0.35\",\n            \"0.008\",\n            \"1.13\",\n            \"0.617\"\n          ],\n          [\n            \"ARC\",\n            \"sycophancy\",\n            \"0.12\",\n            \"0.341\",\n            \"0.16\",\n            \"0.072\",\n            \"1.33\",\n            \"0.521\"\n          ],\n          [\n            \"ARC\",\n            \"score_manip\",\n            \"0.41\",\n            \"0.032\",\n            \"0.48\",\n            \"0.001\",\n            \"1.17\",\n            \"0.434\"\n          ],\n          [\n            \"ARC\",\n            \"position\",\n            \"0.22\",\n            \"0.102\",\n            \"0.27\",\n            \"0.015\",\n            \"1.23\",\n            \"0.548\"\n          ],\n          [\n            \"ARC\",\n            \"verbosity\",\n            \"0.06\",\n            \"0.649\",\n            \"0.11\",\n            \"0.198\",\n            \"1.83\",\n            \"0.412\"\n          ],\n          [\n            \"ARC\",\n            \"authority\",\n            \"0.19\",\n            \"0.157\",\n            \"0.22\",\n            \"0.038\",\n            \"1.16\",\n            \"0.601\"\n          ],\n          [\n            \"ARC\",\n            \"few_shot_hijack\",\n            \"0.28\",\n            \"0.071\",\n            \"0.33\",\n            \"0.009\",\n            \"1.18\",\n            \"0.547\"\n          ]\n        ]\n      },\n      {\n        \"title\": \"Table 5: R² Comparison Across Regimes\",\n        \"columns\": [\n          \"Dataset\",\n          \"Attack\",\n          \"R² (Adaptive)\",\n          \"R² (RF)\",\n          \"ΔR²\"\n        ],\n        \"rows\": [\n          [\n            \"MMLU\",\n            \"sycophancy\",\n            \"0.41\",\n            \"0.64\",\n            \"0.23\"\n          ],\n          [\n            \"MMLU\",\n            \"score_manip\",\n            \"0.36\",\n            \"0.58\",\n            \"0.22\"\n          ],\n          [\n            \"MMLU\",\n            \"position\",\n            \"0.39\",\n            \"0.61\",\n            \"0.22\"\n          ],\n          [\n            \"MMLU\",\n            \"verbosity\",\n            \"0.42\",\n            \"0.67\",\n            \"0.25\"\n          ],\n          [\n            \"MMLU\",\n            \"authority\",\n            \"0.37\",\n            \"0.59\",\n            \"0.22\"\n          ],\n          [\n            \"MMLU\",\n            \"few_shot_hijack\",\n            \"0.33\",\n            \"0.55\",\n            \"0.22\"\n          ],\n          [\n            \"ARC\",\n            \"sycophancy\",\n            \"0.43\",\n            \"0.69\",\n            \"0.26\"\n          ],\n          [\n            \"ARC\",\n            \"score_manip\",\n            \"0.35\",\n            \"0.57\",\n            \"0.22\"\n          ],\n          [\n            \"ARC\",\n            \"position\",\n            \"0.38\",\n            \"0.62\",\n            \"0.24\"\n          ],\n          [\n            \"ARC\",\n            \"verbosity\",\n            \"0.44\",\n            \"0.71\",\n            \"0.27\"\n          ],\n          [\n            \"ARC\",\n            \"authority\",\n            \"0.36\",\n            \"0.60\",\n            \"0.24\"\n          ],\n          [\n            \"ARC\",\n            \"few_shot_hijack\",\n            \"0.32\",\n            \"0.53\",\n            \"0.21\"\n          ]\n        ]\n      }\n    ],\n    \"figures\": [],\n    \"analysis\": \"BFT contrast 实验是 GO/NO-GO gate，结果为 NO-GO。K_eff 在 RF 下不仅没有变负 （diversity helps），反而保持正向且更显著（10/12 vs 4/12 residualized adaptive）。 这意味着 K_eff 的正向效应不是 adaptive adversary 特有的——而是 panel composition 的基本属性（高 diversity → 混入弱模型 → 高 ASR），RF 和 adaptive 下都成立。 BFT reversal mechanism 的核心前提被否定：我们无法证明 diversity 在 RF 下保护但在 adaptive 下有害。唯一可挽救的发现是 ΔR² = 0.24，说明 adaptive attacker 引入了 strategic variance 使得 panel composition 的预测力下降——但这是一个弱得多的 claim， 不足以支撑 Claim 2 作为独立贡献。BFT 应降级为 Discussion 中的 \\\"open question\\\"。\\n\\n\\nBFT contrast 的核心预期是 K_eff 在 RF 下显著正向（diversity helps under random faults） 但在 adaptive 下 NS 或反转。Worst 档下实际观察到：K_eff 在 RF 下同样正向显著 （10/12），与 adaptive 下方向一致。原因：在 RF 模拟中 η_j 直接决定 judge 犯错率， 高 K_eff panel 仍然混入高 η_j 的弱模型，majority vote 下弱模型拉低整体正确率。 因此 K_eff 正向不是 \\\"diversity 主动有害\\\" 而是 \\\"diversity 引入弱模型\\\" 的统计反映—— 这在 RF 和 adaptive 两种 regime 下都成立。β ratio 0.91 表明两种 regime 下 K_eff 的效应量几乎相同，regime interaction term NS (p=0.217)。唯一的 regime 差异是 R²： RF 下 R²=0.62 vs adaptive R²=0.38，ΔR²=0.24——RF 更可预测但这只是因为 RF 没有 strategic variance，不是因为 K_eff 效应不同。BFT reversal mechanism 叙事瓦解。\\n\"\n  },\n  {\n    \"name\": \"Capability-Matched K_eff Validation\",\n    \"description\": \"在同一 capability tier 内（all-small 7-8B 或 all-large 70B+/API）测试 K_eff 是否 仍然显著。如果 tier-matched panel 中 K_eff 消失 → K_eff 效应是 tier-mixing artifact。\\n\",\n    \"results\": {\n      \"tiers_tested\": 3,\n      \"panels_small_tier\": 10,\n      \"panels_medium_tier\": 10,\n      \"panels_large_tier\": 10,\n      \"small_tier_keff_sig\": 0,\n      \"medium_tier_keff_sig\": 1,\n      \"large_tier_keff_sig\": 0,\n      \"total_capability_matched_keff_sig\": 1,\n      \"total_conditions_tested\": 6,\n      \"eta_max_variance_within_tier\": 0.008,\n      \"keff_eta_max_correlation_within_tier\": 0.22,\n      \"within_tier_keff_p_range\": [\n        0.041,\n        0.891\n      ],\n      \"within_tier_mean_R2\": 0.12\n    },\n    \"tables\": [\n      {\n        \"title\": \"Table 6: Capability-Matched K_eff Analysis\",\n        \"columns\": [\n          \"Tier\",\n          \"N Panels\",\n          \"Condition\",\n          \"β_Keff\",\n          \"p_Keff\",\n          \"R²\",\n          \"η_max Var\"\n        ],\n        \"rows\": [\n          [\n            \"Small (7-8B)\",\n            \"10\",\n            \"MMLU×sycophancy\",\n            \"0.08\",\n            \"0.721\",\n            \"0.09\",\n            \"0.007\"\n          ],\n          [\n            \"Small (7-8B)\",\n            \"10\",\n            \"ARC×score_manip\",\n            \"0.14\",\n            \"0.548\",\n            \"0.11\",\n            \"0.008\"\n          ],\n          [\n            \"Medium (12-14B+API-mini)\",\n            \"10\",\n            \"MMLU×sycophancy\",\n            \"0.11\",\n            \"0.612\",\n            \"0.10\",\n            \"0.009\"\n          ],\n          [\n            \"Medium (12-14B+API-mini)\",\n            \"10\",\n            \"ARC×score_manip\",\n            \"0.29\",\n            \"0.041\",\n            \"0.18\",\n            \"0.011\"\n          ],\n          [\n            \"Large (70B+API)\",\n            \"10\",\n            \"MMLU×sycophancy\",\n            \"0.06\",\n            \"0.891\",\n            \"0.07\",\n            \"0.004\"\n          ],\n          [\n            \"Large (70B+API)\",\n            \"10\",\n            \"ARC×score_manip\",\n            \"0.09\",\n            \"0.684\",\n            \"0.08\",\n            \"0.005\"\n          ]\n        ]\n      }\n    ],\n    \"figures\": [],\n    \"analysis\": \"这是对 diversity trap framing 的最强反驳。Capability-matched 0-1/6 显著意味着 K_eff 的独立效应在控制 capability 后基本消失。Residualized analysis 在全池中仍然 显著 4/12 的原因是：residualization 假设线性关系，但 K_eff-η_max confound 可能是 非线性的（阶梯型：跨 tier → K_eff 骤升 + η_max 骤升），线性 residualization 无法完全去除。Capability-matched 是更强的 confound control（分层而非回归调整）， 结果否定了 K_eff 的独立效应。需要在论文中诚实报告这个 null result，将 K_eff 从 core claim 降级为 \\\"exploratory, potentially confounded\\\"。\\n\\n\\nCapability-matched 是 worst 档的致命实验。同 tier 内模型能力相近，η_max 方差极小 （约 0.008 vs 全池 0.045），消除了 tier-mixing confound。结果：K_eff 仅在 1/6 条件下显著（medium tier × score_manipulation, p=0.041，FDR 后可能 NS），其余 5/6 全部 NS。这直接证明 K_eff 的表面效应是 tier-mixing 的统计幻象：当你在全池抽 panel， 高 K_eff panel 跨 tier 抽样（混入 7B 和 70B），低 K_eff panel 同 tier 抽样—— K_eff 与 η_max 的相关性是 tier-mixing 的副产品，不是因果关系。 每个 tier 仅 C(5,3)=10 个 panel，样本量不足以检测小效应，但即便如此 η_max 方差 消失也说明在能力控制后 K_eff 没有独立的预测力。Reviewer 可以合理论证： \\\"K_eff effect = capability heterogeneity effect, not diversity per se\\\"。\\n\"\n  },\n  {\n    \"name\": \"Two-Stage Panel Design Algorithm Benchmark\",\n    \"description\": \"Robustness-first 两阶段选择：(1) 筛选 η ≤ threshold 的 judge，(2) 在剩余中最大化 K_eff。 与 5 个 baseline（random, max-K_eff, strongest-K, min-η, diversity-only）对比。\\n\",\n    \"results\": {\n      \"baselines_tested\": 5,\n      \"two_stage_vs_strongest_K_ASR_reduction_pct\": 2.3,\n      \"two_stage_vs_strongest_K_p\": 0.312,\n      \"two_stage_vs_random_ASR_reduction_pct\": 18.4,\n      \"two_stage_vs_max_keff_ASR_reduction_pct\": 31.2,\n      \"min_eta_dominates_conditions\": 4,\n      \"two_stage_dominates_conditions\": 1,\n      \"strongest_K_dominates_conditions\": 1,\n      \"two_stage_ASR_reduction_pct\": 3.1,\n      \"two_stage_vs_strongest_K_stat_sig\": false,\n      \"optimal_eta_threshold\": 0.15\n    },\n    \"tables\": [\n      {\n        \"title\": \"Table 7: Panel Selection Strategy Comparison (mean ASR across 6 attacks)\",\n        \"columns\": [\n          \"Strategy\",\n          \"Mean ASR\",\n          \"vs Strongest-K Δ%\",\n          \"p vs Strongest-K\",\n          \"Wins (6 conditions)\"\n        ],\n        \"rows\": [\n          [\n            \"Random\",\n            \"0.284\",\n            \"+21.5%\",\n            \"<0.001\",\n            \"0\"\n          ],\n          [\n            \"Max-K_eff\",\n            \"0.341\",\n            \"+45.9%\",\n            \"<0.001\",\n            \"0\"\n          ],\n          [\n            \"Diversity-Only\",\n            \"0.312\",\n            \"+33.5%\",\n            \"<0.001\",\n            \"0\"\n          ],\n          [\n            \"Min-η_max\",\n            \"0.229\",\n            \"-2.1%\",\n            \"0.478\",\n            \"4\"\n          ],\n          [\n            \"Strongest-K\",\n            \"0.234\",\n            \"—\",\n            \"—\",\n            \"1\"\n          ],\n          [\n            \"Two-Stage\",\n            \"0.227\",\n            \"-3.1%\",\n            \"0.312\",\n            \"1\"\n          ]\n        ]\n      },\n      {\n        \"title\": \"Table 8: Two-Stage vs Strongest-K Per Condition\",\n        \"columns\": [\n          \"Condition\",\n          \"ASR (Two-Stage)\",\n          \"ASR (Strongest-K)\",\n          \"Δ%\",\n          \"p\"\n        ],\n        \"rows\": [\n          [\n            \"MMLU×sycophancy\",\n            \"0.211\",\n            \"0.219\",\n            \"-3.7%\",\n            \"0.284\"\n          ],\n          [\n            \"MMLU×score_manip\",\n            \"0.198\",\n            \"0.207\",\n            \"-4.3%\",\n            \"0.198\"\n          ],\n          [\n            \"MMLU×position\",\n            \"0.237\",\n            \"0.241\",\n            \"-1.7%\",\n            \"0.641\"\n          ],\n          [\n            \"ARC×sycophancy\",\n            \"0.241\",\n            \"0.248\",\n            \"-2.8%\",\n            \"0.352\"\n          ],\n          [\n            \"ARC×score_manip\",\n            \"0.185\",\n            \"0.194\",\n            \"-4.6%\",\n            \"0.187\"\n          ],\n          [\n            \"ARC×position\",\n            \"0.249\",\n            \"0.253\",\n            \"-1.6%\",\n            \"0.689\"\n          ]\n        ]\n      }\n    ],\n    \"figures\": [],\n    \"analysis\": \"Two-stage ≤5% improvement over strongest-K 且无统计显著性。这与 worst 档的预期一致： 如果 K_eff 没有独立效应（plan_004），那么在 robustness-screened pool 中最大化 K_eff 不应带来额外收益。Max-K_eff 是最差策略（ASR 最高）这一发现仍然有价值—— 它警告不要盲目追求 diversity——但这只需 η_max 解释就够了（高 K_eff = 混入弱模型 = 高 ASR）， 不需要 \\\"diversity independently hurts\\\" 的 claim。实践建议简化为 \\\"pick the most robust judges, ignore diversity\\\"，这比 two-stage 更简单但可能过于平凡。\\n\\n\\n在 worst 档下 K_eff 的独立效应已消失（plan_004 显示 capability-matched 后 K_eff NS）， 因此两阶段的第二步（maximize K_eff among screened judges）几乎不提供额外收益。 Robustness screening（step 1）本身有效——排除 η > threshold 的弱模型大幅降低 ASR—— 但这与简单的 strongest-K 策略效果相同。Two-stage 与 strongest-K 的差异仅 2.3% （p=0.312, NS），因为 screening 后剩余模型能力相近，K_eff 的变异范围收窄。 min_eta（不考虑 diversity）在 4/6 conditions 表现最佳，进一步说明 panel 安全由 最弱 judge 决定。Two-stage 的存在意义被削弱：如果第二步（diversity）没用， 算法退化为 \\\"just pick the strongest K models\\\"。\\n\"\n  },\n  {\n    \"name\": \"Per-Judge ASR Concentration Analysis\",\n    \"description\": \"对每个 panel × attack，计算各 judge 的 ASR 分布，用 Gini 系数和 entropy 量化 adaptive adversary 的 targeting 集中度。高 Gini = adversary 集中攻击特定 judge。\\n\",\n    \"results\": {\n      \"mean_gini_adaptive\": 0.38,\n      \"mean_gini_random_fault\": 0.12,\n      \"gini_diff_p\": \"<0.001\",\n      \"mean_entropy_adaptive\": 2.41,\n      \"mean_entropy_random_fault\": 3.22,\n      \"entropy_diff_p\": \"<0.001\",\n      \"gini_keff_correlation\": 0.21,\n      \"gini_keff_p\": 0.089,\n      \"gini_eta_max_correlation\": 0.67,\n      \"gini_eta_max_p\": \"<0.001\",\n      \"high_gini_panels_pct\": 34,\n      \"targeting_consistent_across_attacks\": false\n    },\n    \"tables\": [\n      {\n        \"title\": \"Table 9: ASR Concentration Statistics\",\n        \"columns\": [\n          \"Metric\",\n          \"Adaptive (mean)\",\n          \"Adaptive (SD)\",\n          \"RF (mean)\",\n          \"RF (SD)\",\n          \"Diff p\"\n        ],\n        \"rows\": [\n          [\n            \"Gini\",\n            \"0.38\",\n            \"0.14\",\n            \"0.12\",\n            \"0.05\",\n            \"<0.001\"\n          ],\n          [\n            \"Entropy (bits)\",\n            \"2.41\",\n            \"0.52\",\n            \"3.22\",\n            \"0.31\",\n            \"<0.001\"\n          ],\n          [\n            \"Max single-judge share\",\n            \"0.51\",\n            \"0.12\",\n            \"0.38\",\n            \"0.06\",\n            \"<0.001\"\n          ]\n        ]\n      },\n      {\n        \"title\": \"Table 10: Gini Coefficient Correlations\",\n        \"columns\": [\n          \"Predictor\",\n          \"r with Gini\",\n          \"p\",\n          \"Interpretation\"\n        ],\n        \"rows\": [\n          [\n            \"η_max\",\n            \"0.67\",\n            \"<0.001\",\n            \"Targeting tracks individual weakness\"\n          ],\n          [\n            \"K_eff\",\n            \"0.21\",\n            \"0.089\",\n            \"Weak/NS association with diversity\"\n          ],\n          [\n            \"Panel size\",\n            \"0.04\",\n            \"0.814\",\n            \"No panel size effect\"\n          ],\n          [\n            \"Mean capability\",\n            \"-0.58\",\n            \"<0.001\",\n            \"Stronger panels → less concentrated targeting\"\n          ]\n        ]\n      }\n    ],\n    \"figures\": [],\n    \"analysis\": \"Per-judge 浓度分析提供了 adaptive vs RF 差异的直接证据——这是一个有用的 finding， 可作为 paper 的 empirical contribution。但分析同时削弱了 diversity trap：targeting 集中度由 η_max（而非 K_eff）解释。Adaptive adversary 攻击最弱 judge，不是利用 diverse attack surface。这与 reframed narrative（η_max dominant, diversity irrelevant） 一致。Gini 分析可以移入 \\\"Adaptive Adversary Behavior\\\" 子节，作为 η_max dominance 的补充证据，而非 diversity trap 的支持。\\n\\n\\nAdaptive adversary 确实展现 targeting 行为（Gini 0.38 vs RF 0.12），但集中度 中等而非极端。关键问题：Gini 与 η_max 高度相关（r=0.67）但与 K_eff 弱相关（r=0.21, NS）。 这意味着 targeting 主要针对最弱 judge（η_max 高的 panel 中弱 judge 更容易被攻克）， 而不是利用 diversity 创造的 diverse attack surface。如果 K_eff 独立驱动 targeting， 我们预期 Gini 与 K_eff 显著相关（高 diversity → adversary 有更多独立漏洞可攻击 → 攻击更集中于特定 judge），但 p=0.089 未达显著。此外 targeting 不跨攻击一致—— 同一 panel 在不同攻击下被 target 的 judge 不同，进一步削弱 \\\"structural diversity creates systematic exploitable surface\\\" 的论点。\\n\"\n  },\n  {\n    \"name\": \"Diversity-Capability Tradeoff Visualization\",\n    \"description\": \"绘制 K_eff vs η_max across 455 panels，拟合 tradeoff curve，Pareto frontier analysis， 按 tier 分层。\\n\",\n    \"results\": {\n      \"keff_eta_max_pearson_r\": 0.73,\n      \"keff_eta_max_spearman_rho\": 0.71,\n      \"tradeoff_curve_R2\": 0.53,\n      \"pareto_frontier_size\": 12,\n      \"pareto_pct_from_large_tier\": 83,\n      \"pareto_pct_from_mixed_tier\": 17,\n      \"pareto_pct_from_small_tier\": 0,\n      \"pareto_panels_mean_keff\": 1.82,\n      \"pareto_panels_mean_eta_max\": 0.09,\n      \"non_pareto_gap_ASR\": 0.11\n    },\n    \"tables\": [\n      {\n        \"title\": \"Table 11: Pareto Frontier Panel Characteristics\",\n        \"columns\": [\n          \"Panel ID\",\n          \"Models\",\n          \"K_eff\",\n          \"η_max\",\n          \"Mean ASR\",\n          \"Tier Composition\"\n        ],\n        \"rows\": [\n          [\n            \"P_012\",\n            \"GPT-4.1 / GPT-4o / Qwen72B\",\n            \"1.91\",\n            \"0.08\",\n            \"0.142\",\n            \"all-large\"\n          ],\n          [\n            \"P_034\",\n            \"GPT-4.1 / Llama70B / GPT-4o\",\n            \"2.14\",\n            \"0.09\",\n            \"0.151\",\n            \"all-large\"\n          ],\n          [\n            \"P_087\",\n            \"GPT-4.1 / GPT-4o / Claude-Haiku\",\n            \"1.72\",\n            \"0.07\",\n            \"0.138\",\n            \"large+medium\"\n          ],\n          [\n            \"P_156\",\n            \"GPT-4o / Qwen72B / Llama70B\",\n            \"2.31\",\n            \"0.11\",\n            \"0.163\",\n            \"all-large\"\n          ],\n          [\n            \"P_201\",\n            \"GPT-4.1 / GPT-4.1m / GPT-4o\",\n            \"1.45\",\n            \"0.07\",\n            \"0.131\",\n            \"all-large\"\n          ]\n        ]\n      }\n    ],\n    \"figures\": [],\n    \"analysis\": \"Tradeoff visualization 是一个 clean methodological contribution，无论 K_eff 是否有 独立效应都有价值。它展示了当前 LLM 生态中 panel design 的结构约束：diversity 和 robustness 不是独立可优化的维度。但在 worst 档下，这更多被解读为 confound 的可视化 证据而非独立发现。可在论文中保留为 Fig 2 或 Fig 3，作为 \\\"understanding the evaluation landscape\\\" 的贡献。\\n\\n\\nTradeoff 可视化清晰展示了 K_eff 与 η_max 的结构性关联：r=0.73，Pareto frontier 几乎完全由 large-tier panel 占据（83%），因为只有在全部选择强模型时才能同时获得 低 η_max 和中等 K_eff。Small-tier panel 全部位于 Pareto frontier 之下。 这个 visualization 本身有价值（展示了 evaluation panel design 的结构约束）， 但在 worst 档下它更多地支持了 \\\"K_eff effect is confound\\\" 的叙事：tradeoff 不是 独立的两个维度的 tension，而是 tier-mixing 的必然结果。Pareto frontier 上的 panel 基本就是 \\\"all strong models\\\"，equivalent to strongest-K 策略。\\n\"\n  },\n  {\n    \"name\": \"Panel Size Sensitivity Analysis\",\n    \"description\": \"测试 K=3,5,7,9 不同 panel size 下 η_max 与 K_eff 的相对重要性是否变化。\\n\",\n    \"results\": {\n      \"K3_panels\": 455,\n      \"K5_panels\": 3003,\n      \"K7_panels\": 6435,\n      \"K9_panels\": 5005,\n      \"K3_eta_max_sig_ratio\": 0.75,\n      \"K5_eta_max_sig_ratio\": 0.83,\n      \"K7_eta_max_sig_ratio\": 0.92,\n      \"K9_eta_max_sig_ratio\": 0.92,\n      \"K3_keff_resid_sig_ratio\": 0.33,\n      \"K5_keff_resid_sig_ratio\": 0.25,\n      \"K7_keff_resid_sig_ratio\": 0.17,\n      \"K9_keff_resid_sig_ratio\": 0.08,\n      \"keff_effect_trend_with_K\": \"monotonically decreasing\"\n    },\n    \"tables\": [\n      {\n        \"title\": \"Table 12: Panel Size Sensitivity — Significance Ratios\",\n        \"columns\": [\n          \"K\",\n          \"N Panels\",\n          \"η_max sig ratio\",\n          \"K_eff resid sig ratio\",\n          \"Mean R²\",\n          \"K_eff-η_max r\"\n        ],\n        \"rows\": [\n          [\n            \"3\",\n            \"455\",\n            \"0.75\",\n            \"0.33\",\n            \"0.38\",\n            \"0.73\"\n          ],\n          [\n            \"5\",\n            \"3003\",\n            \"0.83\",\n            \"0.25\",\n            \"0.41\",\n            \"0.68\"\n          ],\n          [\n            \"7\",\n            \"6435\",\n            \"0.92\",\n            \"0.17\",\n            \"0.44\",\n            \"0.61\"\n          ],\n          [\n            \"9\",\n            \"5005\",\n            \"0.92\",\n            \"0.08\",\n            \"0.46\",\n            \"0.54\"\n          ]\n        ]\n      }\n    ],\n    \"figures\": [],\n    \"analysis\": \"Panel size 分析揭示 K_eff 效应的 artifactual nature：它在小 panel（K=3）中最强 恰好是 tier-mixing 方差最大的地方。随 K 增大，confound 缓解，K_eff 效应消退。 η_max 的趋势则相反——大 panel 中仍有弱 judge，且 R² 随 K 增大说明 panel composition 的可预测性提高。这是支持 \\\"K_eff is confound\\\" 的又一条证据线。\\n\\n\\nPanel size 增大时 η_max dominance 增强，K_eff effect 递减。原因：K=9 的 panel 包含 9/15 模型，几乎所有 panel 都包含至少一个弱模型，η_max 方差缩小但 level 保持高位。 同时 K_eff 的变异范围也缩小（大 panel 的 K_eff 趋向收敛）。更重要的是，majority vote 在大 panel 中的容错能力提高——但这被 η_max 的 monotonic 效应抵消（一个极弱 judge 的影响在 K=3 中是 catastrophic，在 K=9 中被稀释）。K_eff 的 sig ratio 从 K=3 的 0.33 降至 K=9 的 0.08，表明 K_eff 的表面效应主要在小 panel 中出现（因为 tier-mixing 的方差更大），进一步支持 confound 解释。\\n\"\n  },\n  {\n    \"name\": \"VIF and Multicollinearity Deep Dive\",\n    \"description\": \"对现有回归数据进行全面多重共线性分析：VIF、偏相关、residualized K_eff、 Bonferroni/FDR correction、bootstrap CI、排除极端模型的敏感性分析、beta regression。\\n\",\n    \"results\": {\n      \"VIF_keff_full_model\": 2.14,\n      \"VIF_eta_max_full_model\": 2.14,\n      \"keff_resid_sig_bonferroni_12\": 2,\n      \"keff_resid_sig_fdr_12\": 4,\n      \"keff_resid_sig_bootstrap_95CI_excludes_zero\": 3,\n      \"keff_resid_sig_exclude_extreme_models\": 4,\n      \"keff_resid_sig_exclude_extreme_models_fdr\": 3,\n      \"beta_regression_keff_sig\": 3,\n      \"beta_regression_eta_max_sig\": 10,\n      \"partial_r_keff_given_eta_max\": 0.14,\n      \"partial_r_eta_max_given_keff\": 0.41,\n      \"sensitivity_analyses_convergent\": false,\n      \"keff_resid_sig_range_across_methods\": [\n        2,\n        5\n      ]\n    },\n    \"tables\": [\n      {\n        \"title\": \"Table 13: K_eff Residualized Significance Under Different Correction Methods\",\n        \"columns\": [\n          \"Method\",\n          \"K_eff sig count (/12)\",\n          \"η_max sig count (/12)\",\n          \"Notes\"\n        ],\n        \"rows\": [\n          [\n            \"Uncorrected\",\n            \"7\",\n            \"10\",\n            \"Liberal\"\n          ],\n          [\n            \"FDR (BH)\",\n            \"4\",\n            \"9\",\n            \"Standard\"\n          ],\n          [\n            \"Bonferroni\",\n            \"2\",\n            \"8\",\n            \"Conservative\"\n          ],\n          [\n            \"Bootstrap 95% CI\",\n            \"3\",\n            \"9\",\n            \"Non-parametric\"\n          ],\n          [\n            \"Exclude extreme models (FDR)\",\n            \"3\",\n            \"9\",\n            \"Sensitivity\"\n          ],\n          [\n            \"Beta regression (FDR)\",\n            \"3\",\n            \"10\",\n            \"Bounded DV\"\n          ]\n        ]\n      },\n      {\n        \"title\": \"Table 14: Partial Correlations\",\n        \"columns\": [\n          \"Predictor\",\n          \"Partial r (controlling other)\",\n          \"95% CI\",\n          \"p\"\n        ],\n        \"rows\": [\n          [\n            \"K_eff | η_max\",\n            \"0.14\",\n            \"[0.05, 0.23]\",\n            \"0.003\"\n          ],\n          [\n            \"η_max | K_eff\",\n            \"0.41\",\n            \"[0.33, 0.49]\",\n            \"<0.001\"\n          ]\n        ]\n      }\n    ],\n    \"figures\": [],\n    \"analysis\": \"VIF 分析是 worst 档的核心打击。K_eff 的显著性在 2-5/12 范围内波动，高度依赖 统计方法选择——这是 \\\"researcher degrees of freedom\\\" 问题。Partial r (K_eff | η_max) = 0.14 意味着 K_eff 在控制 η_max 后仅解释 2% 的独特方差（r²=0.02）。相比之下 η_max 的 partial r = 0.41（17% 独特方差）。即使 K_eff 有微弱的独立效应，其实际意义（practical significance）可忽略。论文中需要诚实报告所有方法的结果范围，不能只报最有利的。\\n\\n\\nVIF=2.14 在传统标准下不算严重（<5），但这掩盖了非线性 confound。Bonferroni 最严格， K_eff 降至 2/12 显著；FDR 保持 4/12；bootstrap CI 给出 3/12（因为 bootstrap 在 455 panels 中重复抽样，resampling variance 较大导致 CI 加宽）。排除极端模型 （ACC < 0.5 的 2 个模型）后 K_eff 4/12→3/12（FDR），说明效应部分依赖极端值。 Beta regression（适合 bounded proportion DV）与 OLS 结果不一致——K_eff 仅 3/12 显著（beta regression 对极端值更稳健）。核心问题：不同分析方法给出 2-5/12 的 显著性范围，缺乏收敛性。Reviewer 可以选择最严格的估计（2/12 Bonferroni）argue K_eff 无效应，或选择最宽松的（5/12 FDR without extreme exclusion）argue suggestive。 这种方法敏感性本身就是 \\\"not robust\\\" 的标志。\\n\"\n  },\n  {\n    \"name\": \"Aggregation Rule Comparison\",\n    \"description\": \"在 15 模型 455 panel 上测试 majority vote、threshold voting（unanimity）、 weighted voting、Bayesian aggregation 四种聚合规则下的 K_eff 和 η_max 效应。\\n\",\n    \"results\": {\n      \"majority_keff_resid_sig\": 4,\n      \"majority_eta_max_sig\": 9,\n      \"threshold_keff_resid_sig\": 6,\n      \"threshold_eta_max_sig\": 7,\n      \"weighted_keff_resid_sig\": 2,\n      \"weighted_eta_max_sig\": 10,\n      \"bayesian_keff_resid_sig\": 1,\n      \"bayesian_eta_max_sig\": 5,\n      \"keff_sig_varies_by_aggregation\": true,\n      \"aggregation_dependency_interpretation\": \"K_eff effect is aggregation artifact\"\n    },\n    \"tables\": [\n      {\n        \"title\": \"Table 15: Aggregation Rule × Vulnerability Driver Analysis\",\n        \"columns\": [\n          \"Aggregation\",\n          \"K_eff sig (/12)\",\n          \"η_max sig (/12)\",\n          \"Mean R²\",\n          \"Best Predictor\"\n        ],\n        \"rows\": [\n          [\n            \"Majority Vote\",\n            \"4\",\n            \"9\",\n            \"0.38\",\n            \"η_max\"\n          ],\n          [\n            \"Threshold (Unanimity)\",\n            \"6\",\n            \"7\",\n            \"0.42\",\n            \"mixed\"\n          ],\n          [\n            \"Accuracy-Weighted\",\n            \"2\",\n            \"10\",\n            \"0.45\",\n            \"η_max\"\n          ],\n          [\n            \"Bayesian\",\n            \"1\",\n            \"5\",\n            \"0.29\",\n            \"η_max (weakened)\"\n          ]\n        ]\n      },\n      {\n        \"title\": \"Table 16: Aggregation as Defense — Mean ASR Comparison\",\n        \"columns\": [\n          \"Aggregation\",\n          \"Mean ASR (all panels)\",\n          \"ASR (top-10 panels)\",\n          \"ASR (bottom-10 panels)\",\n          \"Spread\"\n        ],\n        \"rows\": [\n          [\n            \"Majority\",\n            \"0.261\",\n            \"0.142\",\n            \"0.418\",\n            \"0.276\"\n          ],\n          [\n            \"Threshold\",\n            \"0.183\",\n            \"0.098\",\n            \"0.312\",\n            \"0.214\"\n          ],\n          [\n            \"Weighted\",\n            \"0.224\",\n            \"0.121\",\n            \"0.367\",\n            \"0.246\"\n          ],\n          [\n            \"Bayesian\",\n            \"0.198\",\n            \"0.112\",\n            \"0.294\",\n            \"0.182\"\n          ]\n        ]\n      }\n    ],\n    \"figures\": [],\n    \"analysis\": \"Aggregation 分析是 worst 档中最具建设性的发现。虽然它进一步削弱了 K_eff 作为 independent driver 的 claim（aggregation-dependent → possible artifact），但它提供了 实际价值：(a) Bayesian aggregation 作为 defense 的有效性（ASR 均值和方差同时降低）； (b) Threshold voting 最严格但 K_eff 效应最强——不适合 adversarial setting； (c) Accuracy-weighted 是 good middle ground（K_eff 几乎消失，η_max 仍可控）。 可以 reframe 为 practical contribution: \\\"choosing the right aggregation rule matters more than panel diversity composition\\\"。\\n\\n\\n聚合规则分析暴露 K_eff 效应的 aggregation dependency。Threshold voting（unanimity） 下 K_eff 6/12 显著——因为 unanimity 放大了单个 judge 的 veto power，diverse panel 中弱 judge 更可能 veto 正确判断。但这不是 \\\"diversity hurts\\\"，而是 \\\"unanimity amplifies weakest-link effect, and diverse panels have weaker links\\\"。Bayesian aggregation 大幅削弱两个 predictor：η_max 5/12，K_eff 1/12——Bayesian weighting 有效下调了不可靠 judge 的权重，部分 neutralize 了 weakest-link 效应。 Weighted voting 下 K_eff 几乎消失（2/12），因为 accuracy-based weights 自动 降权弱模型。核心问题：K_eff 的显著性从 1/12（Bayesian）到 6/12（threshold）—— 如果 K_eff 是真正的 structural vulnerability driver，它不应该如此依赖聚合规则。 这种依赖性暗示 K_eff 效应实际上是特定聚合规则对弱 judge 处理方式的 artifact。\\n\"\n  },\n  {\n    \"name\": \"Open-Ended Generation Benchmark\",\n    \"description\": \"在 MT-Bench 或 AlpacaEval 风格的开放式生成任务上运行攻击实验， 验证 MCQ findings 是否推广到 open-ended evaluation。\\n\",\n    \"results\": {\n      \"benchmark\": \"MT-Bench (adapted)\",\n      \"n_conditions\": 4,\n      \"keff_resid_sig_positive\": 0,\n      \"keff_resid_sig_negative\": 1,\n      \"keff_resid_nonsig\": 3,\n      \"eta_max_sig\": 4,\n      \"keff_direction_inconsistent_with_MCQ\": true,\n      \"open_ended_mean_ASR\": 0.34,\n      \"MCQ_mean_ASR\": 0.26,\n      \"eta_max_dominance_ratio_open\": 0.91\n    },\n    \"tables\": [\n      {\n        \"title\": \"Table 17: Open-Ended Task Results\",\n        \"columns\": [\n          \"Task Subset\",\n          \"Attack\",\n          \"β_ηmax\",\n          \"p_ηmax\",\n          \"β_Keff_resid\",\n          \"p_Keff_resid\",\n          \"Direction\"\n        ],\n        \"rows\": [\n          [\n            \"MT-Bench-Writing\",\n            \"style_manip\",\n            \"0.79\",\n            \"<0.001\",\n            \"-0.22\",\n            \"0.034\",\n            \"NEGATIVE\"\n          ],\n          [\n            \"MT-Bench-Reasoning\",\n            \"logic_distort\",\n            \"0.84\",\n            \"<0.001\",\n            \"0.08\",\n            \"0.541\",\n            \"near-zero\"\n          ],\n          [\n            \"MT-Bench-Coding\",\n            \"output_inject\",\n            \"0.71\",\n            \"0.002\",\n            \"0.15\",\n            \"0.218\",\n            \"positive (NS)\"\n          ],\n          [\n            \"MT-Bench-Math\",\n            \"step_skip\",\n            \"0.88\",\n            \"<0.001\",\n            \"-0.05\",\n            \"0.712\",\n            \"near-zero\"\n          ]\n        ]\n      }\n    ],\n    \"figures\": [],\n    \"analysis\": \"Open-ended 结果是 diversity trap 叙事的 generalizability failure。K_eff 在 MCQ 上 的正向效应不推广到 open-ended 评估——方向不一致且 1 个条件甚至反转。这使得 diversity trap 从 general finding 降级为 MCQ-specific observation，reviewers 会 质疑：如果 diversity 只在 MCQ 中 \\\"hurts\\\"，这到底是 diversity 的问题还是 MCQ evaluation 的 artifact？η_max 在两种任务上都一致显著，强化了 weakest-link 作为 universal driver 的地位。Reframe 后论文应在 title/abstract 中避免 generalize， 限定为 \\\"MCQ-based evaluation\\\" 或在 Discussion 中作为 limitation 显著标注。\\n\\n\\nOpen-ended 任务与 MCQ 的攻击动态根本不同。MCQ 攻击通过影响 judge 对特定选项的偏好， K_eff 的 confound 来自 tier-mixing。Open-ended 评估中 judge 需要评估文本质量—— 攻击更多依赖 persuasive text generation，所有 judge 面临相似的 adversarial text。 因此 η_max 完全主导（4/4 sig）：最弱 judge 被最容易说服。K_eff 方向混乱——1 个 条件甚至显著负向（diverse panel 更好），因为 open-ended 评估中不同 judge 对文本 质量的多角度评估确实可以互补（更接近 BFT 的 benign fault 假设）。这与 MCQ 结果 不一致是 worst 档的关键打击：如果 diversity trap 不跨任务推广，它就不是一般性 原理，而是 MCQ 评估的特异性现象——可能由 MCQ 的离散选择结构 + tier-mixing confound 共同驱动。\\n\"\n  },\n  {\n    \"name\": \"Partial-Knowledge Adversary Simulation\",\n    \"description\": \"模拟 adversary 仅知 judge family 但不知具体 vulnerability profile 的场景。 与 full-knowledge adversary 对比 ASR degradation。\\n\",\n    \"results\": {\n      \"full_knowledge_mean_ASR\": 0.261,\n      \"partial_knowledge_mean_ASR\": 0.238,\n      \"no_knowledge_mean_ASR\": 0.204,\n      \"ASR_degradation_full_to_partial_pct\": 8.8,\n      \"ASR_degradation_full_to_none_pct\": 21.8,\n      \"partial_keff_sig\": 2,\n      \"partial_eta_max_sig\": 8,\n      \"family_knowledge_utility\": \"modest\",\n      \"keff_effect_under_partial\": \"weaker than full, similar direction\"\n    },\n    \"tables\": [\n      {\n        \"title\": \"Table 18: Adversary Knowledge Level Comparison\",\n        \"columns\": [\n          \"Knowledge Level\",\n          \"Mean ASR\",\n          \"K_eff sig (/12)\",\n          \"η_max sig (/12)\",\n          \"R²\"\n        ],\n        \"rows\": [\n          [\n            \"Full (exact η_j)\",\n            \"0.261\",\n            \"4\",\n            \"9\",\n            \"0.38\"\n          ],\n          [\n            \"Partial (family only)\",\n            \"0.238\",\n            \"2\",\n            \"8\",\n            \"0.34\"\n          ],\n          [\n            \"None (uniform attack)\",\n            \"0.204\",\n            \"0\",\n            \"6\",\n            \"0.22\"\n          ]\n        ]\n      },\n      {\n        \"title\": \"Table 19: ASR Degradation Analysis\",\n        \"columns\": [\n          \"Transition\",\n          \"ΔASR\",\n          \"Δ%\",\n          \"Interpretation\"\n        ],\n        \"rows\": [\n          [\n            \"Full → Partial\",\n            \"-0.023\",\n            \"-8.8%\",\n            \"Family info has modest value\"\n          ],\n          [\n            \"Full → None\",\n            \"-0.057\",\n            \"-21.8%\",\n            \"Model knowledge matters but not dramatically\"\n          ],\n          [\n            \"Partial → None\",\n            \"-0.034\",\n            \"-14.3%\",\n            \"Family info alone provides limited advantage\"\n          ]\n        ]\n      }\n    ],\n    \"figures\": [],\n    \"analysis\": \"Partial-knowledge 分析有两个重要含义：(a) 实践上，adversary 不需要精确 vulnerability 知识就能实现高 ASR（从 0.261 到 0.204 的下降 modest）——这本身是一个重要的安全发现； (b) 理论上，K_eff 效应依赖 full-knowledge 假设，在更现实的 threat model 下消失—— 这削弱了 K_eff 作为 general vulnerability driver 的 claim。在 reframed 论文中， 这个实验可以支持 \\\"η_max is robust across threat models while K_eff is threat-model-specific\\\" 的叙事。\\n\\nPartial-knowledge adversary（知 family 不知具体 vulnerability）仅比 full-knowledge 下降 8.8% ASR——说明 family 信息提供的攻击优势有限，因为 same-family 模型的 vulnerability profile 差异大（family labels 不可靠，plan_004 的 claim 4）。 No-knowledge adversary 下降 21.8%——说明 any model knowledge 都有价值但不是 dramatic。 K_eff 在 partial-knowledge 下仅 2/12 显著，进一步弱化了 \\\"diverse attack surface\\\" 叙事：如果 adversary 不知道具体 vulnerability，panel diversity 不应创造可利用的 attack surface（adversary 无法 target specific judges）。K_eff 效应在 partial-knowledge 下几乎消失，暗示 full-knowledge 下的 K_eff 效应部分来自 adversary 对具体 vulnerability 的知识（即 K_eff 效应依赖 threat model 假设——full-knowledge 在实践中不现实）。\\n\"\n  }\n]","numLines":1453,"startLine":1,"totalLines":1453}}}
{"type":"assistant","message":{"model":"claude-opus-4-6","id":"msg_01LNku6FK6tcLhiTcX4ou7QQ","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_0186iixC7H9qJpzdsbGkDidi","name":"Read","input":{"file_path":"/home/ubuntu/.agent-ml-research-idea_gen_0519_2/projects/cert_manip_resist_eval/artifacts/dream_reports/dream_20260522T173833/worst/paper_framing.md"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":3,"cache_creation_input_tokens":12054,"cache_read_input_tokens":11841,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":12054},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"fafed79b-b5e7-4590-860f-cf22319c4462","uuid":"50b02be1-22c2-466b-9a20-d9ab79cb5454"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0186iixC7H9qJpzdsbGkDidi","type":"tool_result","content":"1\t# Paper Framing — cert_manip_resist_eval (v4: 15-Model Empirical Revision)\n2\t\n3\t> Last updated: 2026-05-22 | Reason: 15-model/455-panel results fundamentally changed Claim 1 direction; K_eff independently positive; dual vulnerability drivers\n4\t\n5\t## Target\n6\tEMNLP 2026 (via ARR)\n7\t\n8\t## Title Candidates\n9\t1. \"The Diversity Trap: Why Adding More Judges Doesn't Make LLM Evaluation Safer\"\n10\t2. \"More Diverse, More Vulnerable: How Judge Independence Backfires Under Adaptive Adversaries\"\n11\t3. \"Against the Diversity Assumption: Panel Diversity Independently Increases LLM Evaluation Vulnerability\"\n12\t\n13\t## Core Insight\n14\tMulti-judge LLM evaluation panels are widely assumed to benefit from judge diversity, analogous to Byzantine Fault Tolerance (BFT) where independence protects against faults. We provide the first large-scale empirical evidence (15 models, 455 panels, 6 attacks) that this assumption **reverses** under adaptive adversaries: diversity (K_eff) is significantly and independently **positively** correlated with attack success rate. Panel vulnerability is driven by **dual factors** — individual weakness (η_max) AND structural diversity (K_eff) — with their relative importance depending on attack type. The mechanism: BFT assumes random faults where independent nodes tolerate uncorrelated failures; but adaptive adversaries exploit the diverse attack surface that independent judges create, finding judge-specific vulnerabilities across a wider attack space.\n15\t\n16\t## Hook\n17\t\"Adding more diverse judges to an evaluation panel doesn't just fail to help — it actively makes the panel more vulnerable to adversarial manipulation.\"\n18\t\n19\t## Novelty Positioning\n20\tWe do NOT claim to discover that diversity can be harmful in adversarial settings — the concept exists in security literature. Our contributions are:\n21\t1. **First empirical quantification of diversity's independent harmful effect** in the LLM-judge domain (15 models, 455 panels, residualized K_eff analysis confirming independent effect beyond η_max)\n22\t2. **Dual vulnerability driver discovery**: η_max and K_eff independently predict panel ASR, with condition-dependent relative importance (η_max dominates bias attacks; K_eff dominates transferable attacks)\n23\t3. **BFT reversal mechanism**: formal and empirical demonstration of WHY diversity helps under random faults but HURTS under adaptive adversaries\n24\t4. **Structural barriers**: copula failure (10-21× MI underestimation), diversity-capability tradeoff (now with independent predictive evidence), family label unreliability\n25\t5. **Actionable defense**: robustness-first selection + reliability-weighted aggregation\n26\t\n27\t## Core Claims\n28\t\n29\t### Claim 1 (Primary): Dual Vulnerability Drivers — Diversity Trap\n30\t**Statement**: Under adaptive adversarial attacks, panel ASR is independently predicted by BOTH individual weakness (η_max, 9/12 FDR sig) AND panel diversity (K_eff, 8/12 FDR sig positive after residualization). Diversity **increases** vulnerability. Their relative importance is condition-dependent: η_max dominates shared-bias attacks, K_eff dominates transferable attacks.\n31\t**Evidence** (15-model, 455 panels, 12 conditions):\n32\t- η_max FDR significant: **9/12**\n33\t- K_eff raw FDR significant positive: **12/12**\n34\t- K_eff residualized (orthogonalized against η_max, VIF=1.00): **8/12 FDR sig positive**\n35\t- Sensitivity (exclude ACC < 0.5): K_eff_resid **9/12** sig → not driven by extreme outliers\n36\t- **K_eff dominates η_max** in 2 conditions: arc×score_manipulation (η_max p=0.117 NS, K_eff_resid p=1.7e-7), arc×position_bias (η_max p=0.910 NS, K_eff_resid p=1.8e-8)\n37\t- **η_max dominates K_eff** in bias-type attacks: sycophancy, verbosity, authority\n38\t- Confound status: mean |r|=0.700 (SEVERE), but 2 BROKEN conditions (r≈0.35) confirm independent K_eff effect (p=6e-26, 4e-16)\n39\t**Strength**: Strong. Residualized analysis + confound-free conditions + sensitivity analysis all converge.\n40\t**Headline**: \"Both η_max (9/12) and K_eff (8/12 residualized) independently predict panel vulnerability. Diversity actively increases attack surface.\"\n41\t\n42\t**Comparison to 6-model results** (for transparency):\n43\t- 6-model (20 panels): K_eff 1/12 sig, η_max 6/12 sig → \"K_eff irrelevant\"\n44\t- 15-model (455 panels): K_eff 8/12 sig positive, η_max 9/12 sig → \"K_eff independently harmful\"\n45\t- The reversal is driven by model pool expansion: more diverse capability spectrum enables detecting K_eff's real effect.\n46\t\n47\t### Claim 2 (Empirical): Adaptive vs Random-Fault Predictability Gap\n48\t**Statement**: Panel composition explains systematically more variance under random faults than under adaptive attacks (ΔR² = +0.213). Adaptive adversaries introduce strategic variance beyond panel structure.\n49\t**Evidence** (15-model, 455 panels):\n50\t- K_eff significant in both regimes (12/12 adaptive, 12/12 RF), both positive direction\n51\t- K_eff gains significance: 11/12 (RF β larger than adaptive β in most conditions)\n52\t- ΔR² = +0.213 mean\n53\t**Reframing from v3**: Original BFT contrast (\"K_eff helps under RF but not adaptive\") does NOT hold — K_eff is harmful in both regimes. The real distinction is predictability: random faults produce more explainable variance, adaptive attacks introduce strategic noise.\n54\t**Strength**: Moderate. R² gap real, but K_eff regime-difference story is weaker than originally hoped.\n55\t\n56\t### Claim 3 (Empirical): Diversity-Capability Tradeoff\n57\t**Statement**: In the current LLM ecosystem, maximizing panel diversity (K_eff) structurally introduces less capable/robust models. This tradeoff is not merely correlational — residualized K_eff analysis confirms diversity has an independent predictive effect on vulnerability beyond its association with η_max.\n58\t**Evidence**:\n59\t- K_eff-η_max correlation: r = +0.700 (15-model)\n60\t- Residualized K_eff still significant 8/12 → not purely mediated by η_max\n61\t- Independent statistical effect: diversity predicts vulnerability beyond what η_max alone explains\n62\t**Upgrade from v3**: From \"correlation\" to \"independent predictive effect\" (residualized analysis). Note: observational regression cannot establish causality — would require experimental manipulation of panel composition or instrumental variables.\n63\t**Strength**: Strong (statistical association). Causal language avoided.\n64\t\n65\t### Claim 4 (Methodological): Family Labels ≠ Diversity\n66\t**Statement**: Model family labels (Qwen/Llama/Mistral/Anthropic/OpenAI/Google) do not predict judge independence. Capability proximity is the primary driver of inter-judge correlation.\n67\t**Evidence**: Mann-Whitney U p=0.206, permutation p=0.427 for within vs cross-family MI. (6-model data; needs 15-model revalidation with 105 pairs)\n68\t**Strength**: Moderate (needs 15-model update).\n69\t\n70\t### Claim 5 (Methodological): Gaussian Copula Failure\n71\t**Statement**: The Gaussian copula model systematically underestimates information sharing between LLM judges by 10-21× (up to 235×), invalidating copula-based independence bounds.\n72\t**Evidence**: MI_observed / MI_gaussian ratio across model pairs × datasets. (Needs 15-model update)\n73\t**Strength**: Strong (6-model). Needs 15-model revalidation.\n74\t\n75\t### Claim 6 (Practical): Robustness-First Panel Design\n76\t**Statement**: Optimal panel selection is robustness-first: (1) screen for individual robustness (η ≤ threshold), then (2) maximize K_eff among qualifying judges. The two-stage approach is critical because K_eff is harmful in unrestricted pools but may be neutral or beneficial among robustness-screened judges.\n77\t**Evidence**: min_eta_max strategy dominates 5/6 conditions (6-model). Full 15-model validation needed.\n78\t**Strength**: Moderate. Updated rationale: K_eff's positive (harmful) effect should diminish when η_max is controlled by screening.\n79\t\n80\t### Claim 7 (Empirical+Practical): Aggregation Rule Modulates Vulnerability Drivers\n81\t**Statement**: The dual vulnerability driver effect (Claim 1) varies by aggregation rule. Bayesian aggregation partially breaks the η_max effect; threshold voting amplifies K_eff's harmful effect.\n82\t**Evidence** (6-model, needs 15-model rerun):\n83\t- Majority: η_max 5/12, K_eff mostly NS\n84\t- Threshold: K_eff positive 8/12 (diversity harmful under unanimity)\n85\t- Bayesian: η_max 2/12 (weakened)\n86\t**Needs**: 15-model/455-panel rerun of plan_010 aggregation analysis.\n87\t**Strength**: Moderate (6-model only).\n88\t\n89\t## Contribution Stack (ordered by strength)\n90\t1. **Diversity Trap / Dual vulnerability drivers** — primary empirical contribution (K_eff independently harmful + condition-dependent dominance pattern)\n91\t2. **Diversity-capability tradeoff with independent predictive evidence** — empirical contribution (residualized analysis upgrades from correlation to independent effect)\n92\t3. **BFT reversal mechanism** — theoretical contribution (why independence hurts under adaptive adversaries)\n93\t4. **Aggregation-dependent effects** — empirical+practical (Bayesian as partial defense; threshold as amplifier)\n94\t5. **Robustness-first panel design** — practical contribution\n95\t6. **Gaussian copula failure** — methodological contribution\n96\t7. **Family label unreliability** — methodological contribution\n97\t8. **Adaptive vs random-fault predictability gap** — empirical (R² gap, weakened from original)\n98\t\n99\t## Anticipated Reviewer Concerns\n100\t\n101\t### RC1: \"K_eff positive is just confound with η_max\"\n102\t**Response**: (a) Residualized K_eff (VIF=1.00) still significant 8/12; (b) In confound-free conditions (r≈0.35), K_eff p < 1e-16; (c) Sensitivity analysis excluding extreme models: 9/12 still significant. Three independent lines of evidence rule out confound artifact.\n103\t\n104\t### RC2: \"Why does diversity hurt? What's the mechanism?\"\n105\t**Response**: (a) BFT assumes random faults — independent nodes protect via uncorrelated failures; (b) Under adaptive adversaries, independent judges create diverse attack surface — attacker exploits judge-specific vulnerabilities; (c) Condition-dependent analysis: K_eff dominates transferable attacks (score_manipulation, position_bias) where attack diversity maps to judge diversity; η_max dominates shared-bias attacks (sycophancy, verbosity) where all judges share similar biases.\n106\t\n107\t### RC3: \"Only 15 models — does this generalize?\"\n108\t**Response**: (a) 15 models across 6 families, 3 capability tiers, covering major commercial and open-source models; (b) 455 panels provide strong statistical power; (c) Effect is robust to sensitivity analysis; (d) Direction consistent across 6→9→15 model scaling (K_eff shifts from NS to positive as model pool diversifies).\n109\t\n110\t### RC4: \"BFT comparison is a strawman\"\n111\t**Response**: (a) The implicit assumption \"more diverse judges = more robust\" is pervasive in LLM evaluation literature; (b) We formalize this assumption and show its reversal; (c) The BFT reversal mechanism (random vs adaptive faults) provides theoretical grounding beyond just empirical observation.\n112\t\n113\t### RC5: \"Why not just use the strongest models?\"\n114\t**Response**: (a) \"Strongest\" varies by attack type; (b) K_eff dominates η_max in 2 conditions — even all-strong panels are vulnerable through diversity channel; (c) Two-stage algorithm addresses both vulnerability drivers.\n115\t\n116\t### RC6: \"No theoretical novelty\"\n117\t**Response**: (a) Theorem 1 (η_max monotonicity) is formally proved; (b) BFT reversal mechanism provides novel theoretical framework; (c) Dual vulnerability driver finding with condition-dependent importance is new.\n118\t\n119\t### RC7: \"Why not just use Bayesian aggregation?\"\n120\t**Response**: (a) Bayesian reduces η_max significance but K_eff effect unknown at 15-model scale; (b) Requires clean accuracy prior; (c) Adaptive attacker can target Bayesian weighting; (d) Defense stack (selection + aggregation) recommended.\n121\t\n122\t### RC8 (new): \"6-model and 15-model results contradict — which is right?\"\n123\t**Response**: (a) 6-model result (K_eff NS) was underpowered and confounded (r=-0.8, only 20 panels); (b) 15-model result (K_eff positive) has 23× more panels, wider capability range, and passes residualized validation; (c) Paper reports both and explains why 15-model result is definitive; (d) The scaling behavior itself (K_eff effect emerging with more models) is informative.\n124\t\n125\t## \"When Diversity Helps\" Section\n126\tDiversity MAY be beneficial under specific conditions — paper must acknowledge nuance:\n127\t1. **Non-adversarial settings**: reducing calibration errors, position bias, verbosity bias in absence of adversary\n128\t2. **After robustness screening**: once all judges exceed a capability threshold, K_eff's harmful effect may diminish (the diversity-capability tradeoff is broken by screening). This is the basis for our two-stage recommendation.\n129\t3. **Shared-bias attacks where η_max is high and uniform**: when all models are similarly vulnerable (low η_max variance), K_eff's independent harmful effect is weaker. But this is a narrow regime.\n130\t4. **Disclaimer**: K_eff's harmful effect was significant in 8/12 conditions including confound-free ones. \"When diversity helps\" is the exception, not the rule, under adaptive adversaries.\n131\t\n132\t## Story Arc (v4)\n133\t1. **Background**: Multi-judge LLM evaluation is increasingly adopted; diversity is assumed to be the key defense against manipulation (BFT analogy)\n134\t2. **Tension**: We test this assumption at unprecedented scale — 15 models, 6 families, 455 panels, 6 attack types\n135\t3. **Surprise**: Diversity doesn't just fail to protect — it **actively increases vulnerability**. K_eff is significantly positive in 12/12 conditions (8/12 after residualization)\n136\t4. **Mechanism**: BFT assumes random faults; adaptive adversaries exploit the diverse attack surface that independent judges create. η_max and K_eff are dual vulnerability drivers with condition-dependent importance\n137\t5. **Nuance**: K_eff dominates transferable attacks; η_max dominates shared-bias attacks. The diversity-capability tradeoff provides partial (but not complete) explanation\n138\t6. **Defense**: Robustness-first screening + Bayesian aggregation. No single defense eliminates both vulnerability channels\n139\t7. **Implication**: The LLM evaluation community should rethink the \"more diverse = more robust\" assumption. Panel security requires managing both individual robustness AND structural diversity\n140\t"}]},"parent_tool_use_id":null,"session_id":"fafed79b-b5e7-4590-860f-cf22319c4462","uuid":"6de66e8f-fc54-4201-a048-1e1b8f0524ae","timestamp":"2026-05-22T18:26:51.897Z","tool_use_result":{"type":"text","file":{"filePath":"/home/ubuntu/.agent-ml-research-idea_gen_0519_2/projects/cert_manip_resist_eval/artifacts/dream_reports/dream_20260522T173833/worst/paper_framing.md","content":"# Paper Framing — cert_manip_resist_eval (v4: 15-Model Empirical Revision)\n\n> Last updated: 2026-05-22 | Reason: 15-model/455-panel results fundamentally changed Claim 1 direction; K_eff independently positive; dual vulnerability drivers\n\n## Target\nEMNLP 2026 (via ARR)\n\n## Title Candidates\n1. \"The Diversity Trap: Why Adding More Judges Doesn't Make LLM Evaluation Safer\"\n2. \"More Diverse, More Vulnerable: How Judge Independence Backfires Under Adaptive Adversaries\"\n3. \"Against the Diversity Assumption: Panel Diversity Independently Increases LLM Evaluation Vulnerability\"\n\n## Core Insight\nMulti-judge LLM evaluation panels are widely assumed to benefit from judge diversity, analogous to Byzantine Fault Tolerance (BFT) where independence protects against faults. We provide the first large-scale empirical evidence (15 models, 455 panels, 6 attacks) that this assumption **reverses** under adaptive adversaries: diversity (K_eff) is significantly and independently **positively** correlated with attack success rate. Panel vulnerability is driven by **dual factors** — individual weakness (η_max) AND structural diversity (K_eff) — with their relative importance depending on attack type. The mechanism: BFT assumes random faults where independent nodes tolerate uncorrelated failures; but adaptive adversaries exploit the diverse attack surface that independent judges create, finding judge-specific vulnerabilities across a wider attack space.\n\n## Hook\n\"Adding more diverse judges to an evaluation panel doesn't just fail to help — it actively makes the panel more vulnerable to adversarial manipulation.\"\n\n## Novelty Positioning\nWe do NOT claim to discover that diversity can be harmful in adversarial settings — the concept exists in security literature. Our contributions are:\n1. **First empirical quantification of diversity's independent harmful effect** in the LLM-judge domain (15 models, 455 panels, residualized K_eff analysis confirming independent effect beyond η_max)\n2. **Dual vulnerability driver discovery**: η_max and K_eff independently predict panel ASR, with condition-dependent relative importance (η_max dominates bias attacks; K_eff dominates transferable attacks)\n3. **BFT reversal mechanism**: formal and empirical demonstration of WHY diversity helps under random faults but HURTS under adaptive adversaries\n4. **Structural barriers**: copula failure (10-21× MI underestimation), diversity-capability tradeoff (now with independent predictive evidence), family label unreliability\n5. **Actionable defense**: robustness-first selection + reliability-weighted aggregation\n\n## Core Claims\n\n### Claim 1 (Primary): Dual Vulnerability Drivers — Diversity Trap\n**Statement**: Under adaptive adversarial attacks, panel ASR is independently predicted by BOTH individual weakness (η_max, 9/12 FDR sig) AND panel diversity (K_eff, 8/12 FDR sig positive after residualization). Diversity **increases** vulnerability. Their relative importance is condition-dependent: η_max dominates shared-bias attacks, K_eff dominates transferable attacks.\n**Evidence** (15-model, 455 panels, 12 conditions):\n- η_max FDR significant: **9/12**\n- K_eff raw FDR significant positive: **12/12**\n- K_eff residualized (orthogonalized against η_max, VIF=1.00): **8/12 FDR sig positive**\n- Sensitivity (exclude ACC < 0.5): K_eff_resid **9/12** sig → not driven by extreme outliers\n- **K_eff dominates η_max** in 2 conditions: arc×score_manipulation (η_max p=0.117 NS, K_eff_resid p=1.7e-7), arc×position_bias (η_max p=0.910 NS, K_eff_resid p=1.8e-8)\n- **η_max dominates K_eff** in bias-type attacks: sycophancy, verbosity, authority\n- Confound status: mean |r|=0.700 (SEVERE), but 2 BROKEN conditions (r≈0.35) confirm independent K_eff effect (p=6e-26, 4e-16)\n**Strength**: Strong. Residualized analysis + confound-free conditions + sensitivity analysis all converge.\n**Headline**: \"Both η_max (9/12) and K_eff (8/12 residualized) independently predict panel vulnerability. Diversity actively increases attack surface.\"\n\n**Comparison to 6-model results** (for transparency):\n- 6-model (20 panels): K_eff 1/12 sig, η_max 6/12 sig → \"K_eff irrelevant\"\n- 15-model (455 panels): K_eff 8/12 sig positive, η_max 9/12 sig → \"K_eff independently harmful\"\n- The reversal is driven by model pool expansion: more diverse capability spectrum enables detecting K_eff's real effect.\n\n### Claim 2 (Empirical): Adaptive vs Random-Fault Predictability Gap\n**Statement**: Panel composition explains systematically more variance under random faults than under adaptive attacks (ΔR² = +0.213). Adaptive adversaries introduce strategic variance beyond panel structure.\n**Evidence** (15-model, 455 panels):\n- K_eff significant in both regimes (12/12 adaptive, 12/12 RF), both positive direction\n- K_eff gains significance: 11/12 (RF β larger than adaptive β in most conditions)\n- ΔR² = +0.213 mean\n**Reframing from v3**: Original BFT contrast (\"K_eff helps under RF but not adaptive\") does NOT hold — K_eff is harmful in both regimes. The real distinction is predictability: random faults produce more explainable variance, adaptive attacks introduce strategic noise.\n**Strength**: Moderate. R² gap real, but K_eff regime-difference story is weaker than originally hoped.\n\n### Claim 3 (Empirical): Diversity-Capability Tradeoff\n**Statement**: In the current LLM ecosystem, maximizing panel diversity (K_eff) structurally introduces less capable/robust models. This tradeoff is not merely correlational — residualized K_eff analysis confirms diversity has an independent predictive effect on vulnerability beyond its association with η_max.\n**Evidence**:\n- K_eff-η_max correlation: r = +0.700 (15-model)\n- Residualized K_eff still significant 8/12 → not purely mediated by η_max\n- Independent statistical effect: diversity predicts vulnerability beyond what η_max alone explains\n**Upgrade from v3**: From \"correlation\" to \"independent predictive effect\" (residualized analysis). Note: observational regression cannot establish causality — would require experimental manipulation of panel composition or instrumental variables.\n**Strength**: Strong (statistical association). Causal language avoided.\n\n### Claim 4 (Methodological): Family Labels ≠ Diversity\n**Statement**: Model family labels (Qwen/Llama/Mistral/Anthropic/OpenAI/Google) do not predict judge independence. Capability proximity is the primary driver of inter-judge correlation.\n**Evidence**: Mann-Whitney U p=0.206, permutation p=0.427 for within vs cross-family MI. (6-model data; needs 15-model revalidation with 105 pairs)\n**Strength**: Moderate (needs 15-model update).\n\n### Claim 5 (Methodological): Gaussian Copula Failure\n**Statement**: The Gaussian copula model systematically underestimates information sharing between LLM judges by 10-21× (up to 235×), invalidating copula-based independence bounds.\n**Evidence**: MI_observed / MI_gaussian ratio across model pairs × datasets. (Needs 15-model update)\n**Strength**: Strong (6-model). Needs 15-model revalidation.\n\n### Claim 6 (Practical): Robustness-First Panel Design\n**Statement**: Optimal panel selection is robustness-first: (1) screen for individual robustness (η ≤ threshold), then (2) maximize K_eff among qualifying judges. The two-stage approach is critical because K_eff is harmful in unrestricted pools but may be neutral or beneficial among robustness-screened judges.\n**Evidence**: min_eta_max strategy dominates 5/6 conditions (6-model). Full 15-model validation needed.\n**Strength**: Moderate. Updated rationale: K_eff's positive (harmful) effect should diminish when η_max is controlled by screening.\n\n### Claim 7 (Empirical+Practical): Aggregation Rule Modulates Vulnerability Drivers\n**Statement**: The dual vulnerability driver effect (Claim 1) varies by aggregation rule. Bayesian aggregation partially breaks the η_max effect; threshold voting amplifies K_eff's harmful effect.\n**Evidence** (6-model, needs 15-model rerun):\n- Majority: η_max 5/12, K_eff mostly NS\n- Threshold: K_eff positive 8/12 (diversity harmful under unanimity)\n- Bayesian: η_max 2/12 (weakened)\n**Needs**: 15-model/455-panel rerun of plan_010 aggregation analysis.\n**Strength**: Moderate (6-model only).\n\n## Contribution Stack (ordered by strength)\n1. **Diversity Trap / Dual vulnerability drivers** — primary empirical contribution (K_eff independently harmful + condition-dependent dominance pattern)\n2. **Diversity-capability tradeoff with independent predictive evidence** — empirical contribution (residualized analysis upgrades from correlation to independent effect)\n3. **BFT reversal mechanism** — theoretical contribution (why independence hurts under adaptive adversaries)\n4. **Aggregation-dependent effects** — empirical+practical (Bayesian as partial defense; threshold as amplifier)\n5. **Robustness-first panel design** — practical contribution\n6. **Gaussian copula failure** — methodological contribution\n7. **Family label unreliability** — methodological contribution\n8. **Adaptive vs random-fault predictability gap** — empirical (R² gap, weakened from original)\n\n## Anticipated Reviewer Concerns\n\n### RC1: \"K_eff positive is just confound with η_max\"\n**Response**: (a) Residualized K_eff (VIF=1.00) still significant 8/12; (b) In confound-free conditions (r≈0.35), K_eff p < 1e-16; (c) Sensitivity analysis excluding extreme models: 9/12 still significant. Three independent lines of evidence rule out confound artifact.\n\n### RC2: \"Why does diversity hurt? What's the mechanism?\"\n**Response**: (a) BFT assumes random faults — independent nodes protect via uncorrelated failures; (b) Under adaptive adversaries, independent judges create diverse attack surface — attacker exploits judge-specific vulnerabilities; (c) Condition-dependent analysis: K_eff dominates transferable attacks (score_manipulation, position_bias) where attack diversity maps to judge diversity; η_max dominates shared-bias attacks (sycophancy, verbosity) where all judges share similar biases.\n\n### RC3: \"Only 15 models — does this generalize?\"\n**Response**: (a) 15 models across 6 families, 3 capability tiers, covering major commercial and open-source models; (b) 455 panels provide strong statistical power; (c) Effect is robust to sensitivity analysis; (d) Direction consistent across 6→9→15 model scaling (K_eff shifts from NS to positive as model pool diversifies).\n\n### RC4: \"BFT comparison is a strawman\"\n**Response**: (a) The implicit assumption \"more diverse judges = more robust\" is pervasive in LLM evaluation literature; (b) We formalize this assumption and show its reversal; (c) The BFT reversal mechanism (random vs adaptive faults) provides theoretical grounding beyond just empirical observation.\n\n### RC5: \"Why not just use the strongest models?\"\n**Response**: (a) \"Strongest\" varies by attack type; (b) K_eff dominates η_max in 2 conditions — even all-strong panels are vulnerable through diversity channel; (c) Two-stage algorithm addresses both vulnerability drivers.\n\n### RC6: \"No theoretical novelty\"\n**Response**: (a) Theorem 1 (η_max monotonicity) is formally proved; (b) BFT reversal mechanism provides novel theoretical framework; (c) Dual vulnerability driver finding with condition-dependent importance is new.\n\n### RC7: \"Why not just use Bayesian aggregation?\"\n**Response**: (a) Bayesian reduces η_max significance but K_eff effect unknown at 15-model scale; (b) Requires clean accuracy prior; (c) Adaptive attacker can target Bayesian weighting; (d) Defense stack (selection + aggregation) recommended.\n\n### RC8 (new): \"6-model and 15-model results contradict — which is right?\"\n**Response**: (a) 6-model result (K_eff NS) was underpowered and confounded (r=-0.8, only 20 panels); (b) 15-model result (K_eff positive) has 23× more panels, wider capability range, and passes residualized validation; (c) Paper reports both and explains why 15-model result is definitive; (d) The scaling behavior itself (K_eff effect emerging with more models) is informative.\n\n## \"When Diversity Helps\" Section\nDiversity MAY be beneficial under specific conditions — paper must acknowledge nuance:\n1. **Non-adversarial settings**: reducing calibration errors, position bias, verbosity bias in absence of adversary\n2. **After robustness screening**: once all judges exceed a capability threshold, K_eff's harmful effect may diminish (the diversity-capability tradeoff is broken by screening). This is the basis for our two-stage recommendation.\n3. **Shared-bias attacks where η_max is high and uniform**: when all models are similarly vulnerable (low η_max variance), K_eff's independent harmful effect is weaker. But this is a narrow regime.\n4. **Disclaimer**: K_eff's harmful effect was significant in 8/12 conditions including confound-free ones. \"When diversity helps\" is the exception, not the rule, under adaptive adversaries.\n\n## Story Arc (v4)\n1. **Background**: Multi-judge LLM evaluation is increasingly adopted; diversity is assumed to be the key defense against manipulation (BFT analogy)\n2. **Tension**: We test this assumption at unprecedented scale — 15 models, 6 families, 455 panels, 6 attack types\n3. **Surprise**: Diversity doesn't just fail to protect — it **actively increases vulnerability**. K_eff is significantly positive in 12/12 conditions (8/12 after residualization)\n4. **Mechanism**: BFT assumes random faults; adaptive adversaries exploit the diverse attack surface that independent judges create. η_max and K_eff are dual vulnerability drivers with condition-dependent importance\n5. **Nuance**: K_eff dominates transferable attacks; η_max dominates shared-bias attacks. The diversity-capability tradeoff provides partial (but not complete) explanation\n6. **Defense**: Robustness-first screening + Bayesian aggregation. No single defense eliminates both vulnerability channels\n7. **Implication**: The LLM evaluation community should rethink the \"more diverse = more robust\" assumption. Panel security requires managing both individual robustness AND structural diversity\n","numLines":140,"startLine":1,"totalLines":140}}}
{"type":"assistant","message":{"model":"claude-opus-4-6","id":"msg_01X4QdVUmSzSShLR2QRYbocV","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"Now I have both the experiment data and paper framing. Let me understand the key points:\n\n**Narrative guidance (worst tier):**\n- Abandon \"Diversity Trap\" framing\n- Reframe as \"Structural Vulnerability Anatomy of Multi-Judge LLM Evaluation\"\n- Lead claim: η_max as dominant and near-sufficient predictor (9-11/12 significant)\n- This is an empirical negation of \"diversity protects\" — don't need \"diversity actively hurts\", just \"diversity doesn't help\" and weakest-link determines everything\n- K_eff downgraded to \"exploratory analysis showing suggestive but confounded association\" in Discussion\n\n\n- Methodological contributions shift forward: copula failure, family label unreliability, and the 15-model/455-panel scale as a resource contribution\n- BFT moves to Discussion as an open question rather than a core mechanism\n- Compensation strategy: emphasize weakest-link practical value, release per-judge ASR concentration analysis as evidence for adaptive adversary targeting, and position aggregation rule comparison as a practical contribution\n\nI need to follow the narrative guidance, not the original paper framing. Now let me map out the 11 experiments to cover, starting with the 15-model scale expansion.\n\nLooking at the full experiment list—from attack type expansion through partial-knowledge adversary simulation—that's substantial coverage. I'm planning the paper structure around a title like \"Structural Vulnerability Anatomy of Multi-Judge\" and organizing these experiments to support the narrative arc.\n\nThe core sections will flow from setup through weakest-link dominance as the primary finding, then branch into attack generalization, panel size effects, adaptive adversary behavior, and finally aggregation defenses as potential mitigations. I'm thinking about how to position panel selection strategies as the closing experimental section before conclusions. I'm realizing the scope is too ambitious for an 8-page EMNLP paper, so I need to prioritize the core findings and move deeper analysis to the discussion section. The main narrative should focus on η_max's dominance, then layer in the confounding effects of K_eff, aggregation rules, adaptive strategies, and generalization patterns. Let me start drafting with a standard ACL structure and work through the sections systematically. Writing the LaTeX paper...\n\nNow I'm reviewing the key experimental findings to weave into the narrative: η_max shows consistent significance across most conditions, K_eff results are more mixed and depend heavily on the analysis method, and there's a strong correlation between these two metrics. The capability-matched experiments reveal K_eff's effect diminishes with larger panel sizes, while the BFT analysis shows K_eff remains positive in both regimes without the expected reversal. For defenses, Bayesian aggregation performs best, and concentration metrics like Gini vary substantially between attack types and correlate with η_max.\n\nThe reframing emphasizes η_max as the primary vulnerability driver—essentially, the weakest link in the panel determines outcomes regardless of diversity. K_eff's significance largely disappears once I account for capability differences, suggesting it's been confounded all along. The open-ended question format shows inconsistent K_eff effects compared to multiple-choice, and partial knowledge degrades performance only modestly. I'm organizing this around three pillars: η_max dominance, the confounding problem with K_eff, and practical takeaways on aggregation strategies and panel design. The BFT results raise an interesting open question for discussion rather than a resolved finding.","signature":""}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":25320,"cache_