{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JcajtpKUS5gvPuxQ5Frpu5","type":"tool_result","content":"1\t\"\"\"Unified role-tool registry — single source of truth for which tools each agent role can access.\n2\t\n3\tInstead of scattering tool whitelists across mcp_server.py, session_server.py,\n4\tand session_claude_md.py, all role definitions live here.\n5\t\n6\tUsage:\n7\t    from core.tool_registry import get_tools_for_role, ROLES, TOOL_GROUPS, resolve_tool_groups\n8\t\n9\t    tools = get_tools_for_role(\"agent\")             # whitelist for Agent (34 tools)\n10\t    tools = get_tools_for_role(\"director\")          # whitelist for Director\n11\t    excluded = get_excluded_tools(\"worker\")          # blacklist for Worker\n12\t    expanded = resolve_tool_groups([\"ssh\", \"wandb\"]) # expand groups for spawn_worker\n13\t\"\"\"\n14\t\n15\tfrom __future__ import annotations\n16\t\n17\tfrom dataclasses import dataclass, field\n18\t\n19\t\n20\t@dataclass(frozen=True)\n21\tclass RoleDef:\n22\t    \"\"\"Definition of an agent role and its tool access.\"\"\"\n23\t    name: str\n24\t    label: str\n25\t    phase: str                              # idea | research | review | study\n26\t    mode: str                               # whitelist | blacklist\n27\t    tools: frozenset[str] = frozenset()     # whitelist (mode=whitelist) or blacklist (mode=blacklist)\n28\t    env_var: str = \"\"                       # MCP server env var (e.g. \"DIRECTOR_MODE\")\n29\t    description: str = \"\"\n30\t\n31\t\n32\t# ---------------------------------------------------------------------------\n33\t# Tool sets — defined once, referenced by role definitions\n34\t# ---------------------------------------------------------------------------\n35\t\n36\t_DIRECTOR_TOOLS = frozenset({\n37\t    # Inter-role messaging\n38\t    \"director_post_to_main_agent\",\n39\t    \"director_post_to_paper_agent\",\n40\t    \"director_post_to_manager\",\n41\t    \"director_reply_to_user\",\n42\t    \"keepalive_respond\",\n43\t    \"ralph_respond\",\n44\t    \"director_get_project_overview\",\n45\t    \"get_project_status\",\n46\t    \"get_agent_queue_status\",\n47\t    \"cancel_pending_director_messages\",\n48\t    \"cancel_agent_queue_item\",\n49\t    \"replace_agent_queue\",\n50\t    \"urgent_agent_message\",\n51\t    # Approval\n52\t    \"approve_experiment\",\n53\t    \"reject_experiment\",\n54\t    \"post_to_reviewer\",\n55\t    # Infrastructure\n56\t    \"get_resource_inventory\",\n57\t    \"update_project_config\",\n58\t    # Phase transitions\n59\t    \"request_study_approval\",\n60\t    \"submit_paper_to_review\",\n61\t    # Cross-round review issue tracker — Research Director flips\n62\t    # open → in_progress / in_progress → resolved after Action Matrix.\n63\t    \"update_review_issues\",\n64\t    # Cross-phase Director communication\n65\t    \"research_director_post_to_study_director\",\n66\t    # Workspace management (needed when no project is bound)\n67\t    \"list_projects\",\n68\t    \"list_workspace_projects\",\n69\t    \"load_project_config\",\n70\t    \"update_project_config\",\n71\t    \"create_project\",\n72\t    # Secrets vault — Director manages secrets + approves usage\n73\t    \"store_secret\",\n74\t    \"delete_secret\",\n75\t    \"list_secrets\",\n76\t    \"approve_secret_request\",\n77\t    \"reject_secret_request\",\n78\t    # Utility\n79\t    \"read_local_file\",\n80\t    \"upgrade_to_dual_group\",\n81\t    \"get_resource_inventory\",\n82\t    # Feishu — context recovery after session reset\n83\t    \"feishu_read_chat_history\",\n84\t    \"feishu_upload_file\",\n85\t    # TUM — API key management (Gemini/OpenAI etc.)\n86\t    \"get_tum_config\",\n87\t    \"feishu_send_tum_key_request_card\",\n88\t    \"feishu_read_tum_pending_key\",\n89\t    # Resource management — Director controls infrastructure & spend.\n90\t    # Phase 12: AutoDL/elastic-GPU rental moved fully to Manager — Director\n91\t    # asks for cloud GPU via director_post_to_manager and waits for the\n92\t    # Manager-driven approval card. Director never sees autodl_* tools.\n93\t    \"director_allocate_gpus\",\n94\t    \"list_available_gpus\",\n95\t    \"register_server\",\n96\t    \"remove_server\",\n97\t    \"list_ssh_hosts\",\n98\t    \"check_credentials\",\n99\t    # Roadmap — Director owns the research roadmap\n100\t    \"update_roadmap\",\n101\t    \"read_roadmap\",\n102\t    \"log_decision\",\n103\t    # Knowledge — unified read\n104\t    \"read_project_file\",\n105\t    # Provenance — Director can check impact and trigger provenance\n106\t    \"impact_analysis\",\n107\t    \"auto_build_provenance\",\n108\t    \"check_provenance_completeness\",\n109\t    \"check_paper_consistency\",\n110\t    # Experiment Matrix — Director plans paper targets\n111\t    \"update_matrix\",\n112\t    \"read_matrix\",\n113\t    \"get_matrix_value\",\n114\t    \"sync_matrix_status\",\n115\t    \"matrix_gap_analysis\",\n116\t    # Experiment Plan — Director owns paper_framing.md + experiment_plan.yaml,\n117\t    # consults coverage matrix to decide what experiments to run next.\n118\t    \"read_experiment_plan_with_status\",\n119\t    \"compute_coverage_matrix\",\n120\t    # Dream Tool — async future-experiment simulator (Director-only entry).\n121\t    # Post-MVP forced once + on-demand for major decisions (see DREAM_AGENT_DESIGN §8).\n122\t    \"dream_simulate\",\n123\t    \"get_dream_status\",\n124\t    \"should_skip_dream\",\n125\t    \"get_dream_trend\",\n126\t    # Skill management — Director maintains cross-project knowledge (e.g. ml-experiment-guide)\n127\t    \"update_skill\",\n128\t    # Project lifecycle\n129\t    \"archive_project\",\n130\t    # Image management — Director queries image info for user guidance\n131\t    \"get_image_info\",\n132\t    # MVP — Director designs and approves MVP, then transitions to research\n133\t    \"complete_mvp\",\n134\t    # GPU monitoring (cached, from gpu_monitor_daemon)\n135\t    \"get_gpu_health\",\n136\t    \"get_project_resource_usage\",\n137\t    # S3 backup\n138\t    \"backup_project_to_s3\",\n139\t    \"list_s3_backups\",\n140\t})\n141\t\n142\t_AGENT_TOOLS = frozenset({\n143\t    # ── 实验生命周期 ──\n144\t    \"read_registry\",              # 读实验状态（最高频）\n145\t    \"update_registry\",            # 更新状态/指标/结论\n146\t    \"submit_on_allocated\",        # 提交已分配 GPU 的实验\n147\t    \"submit_training_job\",        # 直接提交训练\n148\t    \"allocate_and_submit\",        # 原子化 GPU 分配+提交\n149\t    \"register_cron\",              # 注册实验监控\n150\t    \"poll_cron\",                  # 手动检查实验状态\n151\t    \"reconcile_crons\",            # session 启动时同步所有 cron\n152\t    \"check_job_status\",           # 查进程是否存活（高频纯查询）\n153\t    \"tail_training_logs\",         # 读日志尾部（高频只读，心跳检查和浅层诊断必用）\n154\t    \"fetch_wandb_metrics\",        # 查 W&B 指标（registry 无指标时 fallback）\n155\t    \"kill_job\",                   # 终止 job\n156\t\n157\t    # ── Worker 调度 ──\n158\t    \"spawn_worker\",               # 委派任务（核心）\n159\t    \"get_worker_status\",          # 读 Worker 结果\n160\t    \"list_workers\",               # 查看活跃 Worker\n161\t    \"approve_worker\",             # 审批高风险 Worker\n162\t    \"cancel_worker\",              # 取消 Worker\n163\t\n164\t    # ── 通信 ──\n165\t    \"main_agent_post_to_director\",  # 向 Director 汇报\n166\t    \"feishu_send_message\",          # 飞书文字通知\n167\t    \"feishu_send_result_card\",      # 实验结果卡片（cron 回调必用）\n168\t    \"feishu_send_approval_card\",    # 请求审批\n169\t    \"get_tum_config\",                    # TUM 服务地址\n170\t    \"feishu_send_tum_key_request_card\",  # TUM key 申请\n171\t    \"feishu_read_tum_pending_key\",      # 读取用户提交的 key\n172\t    \"feishu_send_alert\",                # 健康检查告警通知\n173\t    \"send_progress\",                # 进度条更新\n174\t\n175\t    # ── 知识管理 ──\n176\t    \"read_project_file\",          # 统一读取项目文件（替代 read_memory + read_architecture）\n177\t    \"save_project_file\",          # 统一写入项目文件（当前仅 memory.md）\n178\t    \"read_roadmap\",               # 读研究路线图（只读）\n179\t    \"append_idea\",                # 追加实验想法\n180\t    \"register_artifact\",          # 注册产出物\n181\t    \"list_artifacts\",             # 查看已注册产出物\n182\t    \"pdf_to_images\",              # PDF 转图片（视觉检查论文）\n183\t    \"cleanup_pdf_images\",         # 清理 PDF 转图片的临时文件\n184\t    \"verify_references\",          # LaTeX 引用交叉检查 + OpenAlex 验证\n185\t    \"update_baseline\",            # 更新 baseline\n186\t    \"get_baseline_metrics\",       # 读 baseline 指标\n187\t\n188\t    # ── 项目配置 ──\n189\t    \"load_project_config\",        # 读项目配置\n190\t    \"list_available_gpus\",        # 查 GPU 可用情况\n191\t\n192\t    # ── GPU 监控 ──\n193\t    \"get_gpu_health\",             # 全局 GPU 健康度（缓存）\n194\t    \"get_project_resource_usage\", # 项目级资源使用（分配 vs 实际）\n195\t\n196\t    # ── 镜像管理 ──\n197\t    \"get_image_info\",             # 查镜像信息\n198\t    \"detect_image\",               # 检测服务器镜像\n199\t\n200\t    # ── 密钥 ──\n201\t    \"request_secret\",             # 申请密钥（需审批）\n202\t    \"poll_secret_request\",        # 轮询密钥审批结果\n203\t\n204\t    # ── 论文溯源 ──\n205\t    \"write_paper_section\",        # 写论文章节（含 provenance）\n206\t    \"edit_paper_section\",         # 编辑论文章节（含 provenance）\n207\t    \"impact_analysis\",            # 变更影响分析\n208\t    \"auto_build_provenance\",      # 自动构建溯源\n209\t    \"check_provenance_completeness\",  # 检查溯源覆盖率\n210\t    \"check_paper_consistency\",    # 跨章节一致性（数字 / cite / notation）\n211\t\n212\t    # ── 实验矩阵 ──\n213\t    \"update_matrix\",              # 创建/更新论文目标 + cells\n214\t    \"read_matrix\",                # 读矩阵（支持过滤、summary）\n215\t    \"get_matrix_value\",           # 从 registry 拉数字（按 cell 映射）\n216\t    \"sync_matrix_status\",         # 从 registry 状态同步 cell 状态\n217\t    \"matrix_gap_analysis\",        # 缺口分析\n218\t\n219\t    # ── 实验计划（experiment_plan.yaml）──\n220\t    # Agent 只读：理解 plan 对应的 claim 是什么，以便提交 submit_training_job 时\n221\t    # 关联 plan_id。Plan 本身由 Director 维护，Agent 不写。\n222\t    \"read_experiment_plan_with_status\",\n223\t    \"compute_coverage_matrix\",\n224\t\n225\t    # ── S3 备份 ──\n226\t    \"backup_project_to_s3\",\n227\t    \"list_s3_backups\",\n228\t})\n229\t\n230\t\n231\t# ---------------------------------------------------------------------------\n232\t# Tool Groups — Agent delegates capabilities to Workers by group name\n233\t# ---------------------------------------------------------------------------\n234\t\n235\tTOOL_GROUPS: dict[str, list[str]] = {\n236\t    \"ssh\":       [\"ssh_execute\", \"ssh_read_only\", \"kill_job\", \"detect_image\"],\n237\t    \"wandb\":     [\"fetch_wandb_metrics\", \"get_best_wandb_run\",\n238\t                  \"fetch_wandb_run_history\", \"compare_wandb_runs\", \"list_wandb_runs\"],\n239\t    # Phase 12 §6: AutoDL tools moved to Manager — no autodl_* tools live\n240\t    # on BE anymore. The \"autodl\" group is preserved as an empty list so\n241\t    # spawn_worker callers that pass tool_groups=[\"autodl\"] resolve to a\n242\t    # no-op rather than KeyError; new code should ask Manager directly.\n243\t    \"autodl\":    [],\n244\t    \"git\":       [\"clone_repo\", \"sync_code_to_remote\", \"search_repo\",\n245\t                  \"list_repo_tree\", \"read_repo_file\"],\n246\t    \"knowledge\": [\"read_project_file\", \"save_project_file\",\n247\t                  \"append_idea\"],\n248\t    \"registry\":  [\"read_registry\", \"update_registry\", \"register_artifact\"],\n249\t    \"matrix\":    [\"read_matrix\", \"update_matrix\", \"get_matrix_value\",\n250\t                  \"sync_matrix_status\", \"matrix_gap_analysis\"],\n251\t    \"feishu\":    [\"feishu_create_doc\", \"feishu_upload_file\", \"feishu_fetch_doc\"],\n252\t}\n253\t\n254\t\n255\tdef resolve_tool_groups(\n256\t    tool_groups: list[str] | None = None,\n257\t    tools: list[str] | None = None,\n258\t) -> list[str]:\n259\t    \"\"\"Expand tool group names into a flat, deduplicated tool list.\n260\t\n261\t    Args:\n262\t        tool_groups: Group names to expand (e.g. [\"ssh\", \"wandb\"]).\n263\t        tools:       Individual tool names to include as-is.\n264\t\n265\t    Returns:\n266\t        Sorted, deduplicated list of tool names.\n267\t\n268\t    Raises:\n269\t        ValueError: If an unknown group name is provided.\n270\t    \"\"\"\n271\t    result: set[str] = set()\n272\t    if tool_groups:\n273\t        for group in tool_groups:\n274\t            if group not in TOOL_GROUPS:\n275\t                raise ValueError(\n276\t                    f\"Unknown tool group '{group}'. \"\n277\t                    f\"Available groups: {sorted(TOOL_GROUPS.keys())}\"\n278\t                )\n279\t            result.update(TOOL_GROUPS[group])\n280\t    if tools:\n281\t        result.update(tools)\n282\t    return sorted(result)\n283\t\n284\t_WORKER_EXCLUDED = frozenset({\n285\t    # All inter-role messaging\n286\t    \"main_agent_post_to_director\",\n287\t    \"director_post_to_main_agent\",\n288\t    \"director_post_to_paper_agent\",\n289\t    \"director_post_to_manager\",\n290\t    \"post_to_reviewer\",\n291\t    \"reviewer_post_to_director\",\n292\t    \"review_reviewer_post_to_director\",\n293\t    \"director_post_to_reviewer\",\n294\t    \"submit_review_report_to_research_director\",\n295\t    \"study_director_post_to_study_agent\",\n296\t    \"study_agent_post_to_study_director\",\n297\t    \"post_to_study_reviewer\",\n298\t    \"study_reviewer_post_to_study_director\",\n299\t    \"submit_paper_to_review\",\n300\t    \"request_study_approval\",\n301\t    \"update_study_status\",\n302\t    \"update_claim_status\",\n303\t    # Director-only\n304\t    \"get_project_status\",\n305\t    \"update_project_config\",\n306\t    \"approve_experiment\",\n307\t    \"reject_experiment\",\n308\t    \"director_get_project_overview\",\n309\t    \"move_idea\",\n310\t    \"refine_idea\",\n311\t    # Worker lifecycle (no recursive spawning)\n312\t    \"spawn_worker\",\n313\t    \"approve_worker\",\n314\t    \"cancel_worker\",\n315\t    # Feishu approval (Agent-level only)\n316\t    \"feishu_send_approval_card\",\n317\t    # Resource management\n318\t    \"director_allocate_gpus\",\n319\t    \"allocate_and_submit\",\n320\t    \"register_server\",\n321\t    \"remove_server\",\n322\t    # Phase 12 deleted these MCP tools — entries left here would be no-ops\n323\t    # (you can't blacklist what doesn't exist) but listing them as a\n324\t    # tombstone helps future searches understand \"no, Worker can't\n325\t    # accidentally rent cloud GPUs by sneaking in via tool_groups\".\n326\t    # Skill management — Worker cannot modify skills\n327\t    \"update_skill\",\n328\t    \"create_skill\",\n329\t    \"delete_skill\",\n330\t    # Secrets — Worker cannot access secrets at all\n331\t    \"store_secret\",\n332\t    \"delete_secret\",\n333\t    \"request_secret\",\n334\t    \"poll_secret_request\",\n335\t    \"list_secrets\",\n336\t    \"approve_secret_request\",\n337\t    \"reject_secret_request\",\n338\t})\n339\t\n340\t_REVIEWER_TOOLS = frozenset({\n341\t    \"read_registry\",\n342\t    \"ssh_read_only\",\n343\t    \"tail_training_logs\",\n344\t    \"fetch_wandb_metrics\",\n345\t    \"read_project_file\",\n346\t    \"read_roadmap\",\n347\t    \"reviewer_post_to_director\",\n348\t    \"pdf_to_images\",\n349\t    \"cleanup_pdf_images\",\n350\t    # GPU monitoring (cached, read-only)\n351\t    \"get_gpu_health\",\n352\t    \"get_project_resource_usage\",\n353\t    # Experiment matrix (read-only — review coverage)\n354\t    \"read_matrix\",\n355\t    # Experiment plan (read-only — Reviewer cross-checks claims vs experiments)\n356\t    \"read_experiment_plan_with_status\",\n357\t    \"compute_coverage_matrix\",\n358\t})\n359\t\n360\t# Paper Agent — Research-phase writing coordinator (see prompts/roles/paper-agent.md).\n361\t# Strictly serial pipeline: delegates writing/plotting/literature search to Workers,\n362\t# does Outline / consistency / provenance / refinement orchestration itself.\n363\t# Deliberately NOT included: submit_*, allocate_*, update_registry, register_cron\n364\t# (Paper Agent does not run experiments), impact_analysis (Director-only),\n365\t# feishu_send_approval_card (Paper Agent does not approve experiments).\n366\t_PAPER_AGENT_TOOLS = frozenset({\n367\t    # ── 写作核心 + 溯源 ──\n368\t    \"write_paper_section\",          # 写章节 + 自动构建 provenance\n369\t    \"edit_paper_section\",           # 增量编辑 + provenance 更新\n370\t    \"verify_references\",            # 引用 LaTeX 交叉检查 + OpenAlex 验证\n371\t    \"check_provenance_completeness\",\n372\t    \"check_paper_consistency\",      # Step 4 全局一致性检查（数字 / cite / notation）\n373\t    \"auto_build_provenance\",\n374\t    \"bootstrap_provenance\",\n375\t\n376\t    # ── Worker 调度（仅 spawn + 状态查询，不审批/取消高风险 Worker）──\n377\t    \"spawn_worker\",\n378\t    \"get_worker_status\",\n379\t    \"list_workers\",\n380\t\n381\t    # ── 知识读写（实验数据只读，论文文件可读可写）──\n382\t    \"read_registry\",                # 只读实验数据\n383\t    \"read_project_file\",\n384\t    \"save_project_file\",\n385\t    \"read_roadmap\",\n386\t    \"register_artifact\",\n387\t    \"list_artifacts\",\n388\t    # 实验计划 — Paper Agent 写论文时按 plan 中的 claim/framing_ref 串联实验数据\n389\t    \"read_experiment_plan_with_status\",\n390\t    \"compute_coverage_matrix\",\n391\t\n392\t    # ── PDF / 视觉检查 ──\n393\t    \"pdf_to_images\",\n394\t    \"cleanup_pdf_images\",\n395\t    # 自动 PDF 编译 + 页数/warning 检查（PAPER_WRITING_AGENT_PLAN task 3-3）\n396\t    \"paper_compile_and_check\",\n397\t\n398\t    # ── Overleaf 双向同步（PAPER_WRITING_AGENT_PLAN task 3-2）──\n399\t    # init: 首次绑定 Overleaf git remote\n400\t    # push: 推送本地编辑到 Overleaf\n401\t    # pull: 拉取协作者在 Overleaf 上的编辑\n402\t    # sync: pull→push 一站式双向同步（最常用入口）\n403\t    # status: 只读 — 报告 ahead/behind/dirty\n404\t    \"overleaf_init\",\n405\t    \"overleaf_push\",\n406\t    \"overleaf_pull\",\n407\t    \"overleaf_sync\",\n408\t    \"overleaf_status\",\n409\t\n410\t    # ── 通信（Paper Agent ↔ Director / Reviewer）──\n411\t    \"paper_agent_post_to_director\",\n412\t    \"paper_agent_request_review\",\n413\t\n414\t    # ── 项目配置 ──\n415\t    \"load_project_config\",\n416\t\n417\t    # ── 镜像/图片 ──\n418\t    \"get_image_info\",\n419\t\n420\t    # ── 进度上报（B 群运维群可见）──\n421\t    \"send_progress\",\n422\t})\n423\t\n424\t_IDEA_REVIEWER_TOOLS = frozenset({\n425\t    \"refine_idea\",\n426\t    \"generate_ideas\",\n427\t    \"submit_idea_review\",\n428\t    \"list_pending_ideas\",          # Query idea details for context in follow-up conversations\n429\t    \"list_projects\",               # Know what projects exist for context\n430\t})\n431\t\n432\t# Agent without project: workspace management + idea brainstorming only.\n433\t# No SSH, registry, cron, worker, artifact — those need a project.\n434\t_NO_PROJECT_AGENT_TOOLS = frozenset({\n435\t    # Workspace management\n436\t    \"list_projects\",\n437\t    \"list_workspace_projects\",\n438\t    \"load_project_config\",\n439\t    \"create_project\",\n440\t    \"switch_project\",\n441\t    # Idea tools\n442\t    \"append_idea\",\n443\t    \"generate_ideas\",\n444\t    # Knowledge (read-only, for cross-project reference)\n445\t    \"read_project_file\",\n446\t    # Communication\n447\t    \"send_progress\",\n448\t    # Resource visibility (read-only)\n449\t    \"list_ssh_hosts\",\n450\t    \"check_credentials\",\n451\t    \"list_available_gpus\",\n452\t})\n453\t\n454\t_REVIEW_DIRECTOR_TOOLS = frozenset({\n455\t    \"director_post_to_reviewer\",\n456\t    \"submit_review_report_to_research_director\",\n457\t    \"request_study_approval\",\n458\t    \"director_get_project_overview\",\n459\t    \"read_local_file\",\n460\t    \"read_project_file\",\n461\t    # Cross-round issue tracker — Review Director records new/recurring\n462\t    # findings after Step 4 report synthesis.  Reads via read_local_file.\n463\t    \"update_review_issues\",\n464\t    # External review (paperreview.ai)\n465\t    \"request_external_review\",\n466\t    \"get_external_review_status\",\n467\t})\n468\t\n469\t# Dream Review Director — same base, but write to dream_reports only.\n470\t# Skip the cross-round issue tracker (Dream is one-shot, no continuity),\n471\t# skip external review (too slow for Dream), skip Study approval (no Study\n472\t# phase trigger), and swap submission tool for the Dream-specific one that\n473\t# delivers the report straight back to Dream Tool, no 5-step protocol.\n474\t# See DREAM_AGENT_DESIGN.md §6.4.\n475\t_DREAM_REVIEW_DIRECTOR_TOOLS = frozenset({\n476\t    \"director_post_to_reviewer\",\n477\t    \"submit_dream_review_report\",\n478\t    \"director_get_project_overview\",\n479\t    \"read_local_file\",\n480\t    \"read_project_file\",\n481\t})\n482\t\n483\t_REVIEW_REVIEWER_TOOLS = frozenset({\n484\t    \"review_reviewer_post_to_director\",\n485\t    # 审稿只看投稿材料 (PDF + 补充材料), 不能看 Research 阶段内部产出。\n486\t    # 不给 read_local_file / ssh_read_only / read_project_file:\n487\t    # read_project_file 的白名单恰好就是 Reviewer 不该看的研究内部文件\n488\t    # (memory.md / report.md / ROADMAP.md / decisions / ideas /\n489\t    # paper_provenance / ARCHITECTURE.md 等), 给了等于自动泄漏。\n490\t    # 论文 PDF 通过 pdf_to_images(path) 直接读, 路径由 CLAUDE.md 的\n491\t    # ## 投稿材料 section 显式列出 (build_session_prompt 从 project\n492\t    # config 的 review_paper_path 加载, 锁定本轮论文)。\n493\t    \"pdf_to_images\",\n494\t    \"cleanup_pdf_images\",\n495\t    \"verify_references\",\n496\t})\n497\t\n498\t# Dream Review Reviewer — identical tool surface to the normal Review\n499\t# Reviewer (a reviewer just needs to read the PDF and respond). The\n500\t# difference is purely session-key isolation + a Dream-mode dispatch\n501\t# message from the Dream Review Director. Kept as its own constant so\n502\t# future tweaks (e.g. dropping verify_references) don't bleed into the\n503\t# real-review path.\n504\t_DREAM_REVIEW_REVIEWER_TOOLS = _REVIEW_REVIEWER_TOOLS\n505\t\n506\t_STUDY_DIRECTOR_TOOLS = frozenset({\n507\t    \"study_director_post_to_study_agent\",\n508\t    \"study_director_post_to_research_director\",\n509\t    \"post_to_study_reviewer\",\n510\t    \"update_study_status\",\n511\t    \"update_verification_item_status\",\n512\t    \"get_verification_package_status\",\n513\t    \"director_get_project_overview\",\n514\t    \"read_local_file\",\n515\t    \"read_project_file\",\n516\t    \"spawn_worker\",\n517\t    \"get_worker_status\",\n518\t    \"list_workers\",\n519\t})\n520\t\n521\t_STUDY_AGENT_TOOLS = frozenset({\n522\t    \"study_agent_post_to_study_director\",\n523\t    \"update_study_status\",\n524\t    \"assemble_verification_part\",\n525\t    \"write_verification_part\",\n526\t    \"run_verifier\",\n527\t    \"read_local_file\",\n528\t    \"write_local_file\",\n529\t    \"read_registry\",\n530\t    \"read_project_file\",\n531\t    \"ssh_read_only\",\n532\t    \"pdf_to_images\",\n533\t    \"cleanup_pdf_images\",\n534\t    \"write_narrative_scene\",\n535\t    \"render_and_send_narrative\",\n536\t})\n537\t\n538\t_STUDY_REVIEWER_TOOLS = frozenset({\n539\t    \"study_reviewer_post_to_study_director\",\n540\t    \"get_verification_package_status\",\n541\t    \"read_local_file\",\n542\t    \"read_project_file\",\n543\t    \"ssh_read_only\",\n544\t    \"pdf_to_images\",\n545\t    \"cleanup_pdf_images\",\n546\t})\n547\t\n548\t# Briefer — visitor/read-only role for non-official groups & DMs that\n549\t# /p into a project. No writes, no approvals, no experiment actions.\n550\t# Unlike Director/Reviewer, briefer's plain-text output is surfaced to\n551\t# the user (no silent-reply contract). See _send_to_briefer.\n552\t_BRIEFER_TOOLS = frozenset({\n553\t    # Project state (read-only)\n554\t    \"read_registry\",\n555\t    \"read_project_file\",\n556\t    \"read_roadmap\",\n557\t    \"load_project_config\",\n558\t    \"list_projects\",\n559\t    \"list_workspace_projects\",\n560\t    \"list_artifacts\",\n561\t    # Experiment queries\n562\t    \"check_job_status\",\n563\t    \"tail_training_logs\",\n564\t    \"fetch_wandb_metrics\",\n565\t    \"get_best_wandb_run\",\n566\t    \"fetch_wandb_run_history\",\n567\t    \"compare_wandb_runs\",\n568\t    \"list_wandb_runs\",\n569\t    # Provenance / baseline (read-only)\n570\t    \"check_provenance_completeness\",\n571\t    \"check_paper_consistency\",\n572\t    \"impact_analysis\",\n573\t    \"get_baseline_metrics\",\n574\t    # Experiment matrix (read-only)\n575\t    \"read_matrix\",\n576\t    # Experiment plan (read-only — Briefer reports on plan coverage)\n577\t    \"read_experiment_plan_with_status\",\n578\t    \"compute_coverage_matrix\",\n579\t    # Status queries\n580\t    \"get_project_status\",\n581\t    \"get_agent_queue_status\",\n582\t    \"get_worker_status\",\n583\t    \"list_workers\",\n584\t    \"list_available_gpus\",\n585\t    # Idea queries (no write, no gen)\n586\t    \"list_pending_ideas\",\n587\t    # Resource visibility (read-only).\n588\t    # Phase 12 §6: cloud-GPU read tools (autodl_check_balance / availability /\n589\t    # list_instances) moved to Manager — Briefer can no longer surface\n590\t    # cross-tenant cloud spend from the BE side; for that visibility users\n591\t    # talk to Manager Agent directly.\n592\t    \"list_ssh_hosts\",\n593\t    \"check_credentials\",\n594\t    # Image info\n595\t    \"get_image_info\",\n596\t    # Paper / references\n597\t    \"verify_references\",\n598\t    \"pdf_to_images\",\n599\t    \"cleanup_pdf_images\",\n600\t})\n601\t\n602\t# ---------------------------------------------------------------------------\n603\t# Role definitions — the single source of truth\n604\t# ---------------------------------------------------------------------------\n605\t\n606\tROLES: dict[str, RoleDef] = {\n607\t    # ── Research phase ──\n608\t    \"director\": RoleDef(\n609\t        name=\"director\", label=\"Research Director\", phase=\"research\",\n610\t        mode=\"whitelist\", tools=_DIRECTOR_TOOLS,\n611\t        env_var=\"DIRECTOR_MODE\",\n612\t        description=\"PI 角色：方向决策、资源管理、审批实验\",\n613\t    ),\n614\t    \"director_no_project\": RoleDef(\n615\t        name=\"director_no_project\", label=\"Director (Idea Phase)\", phase=\"idea\",\n616\t        mode=\"whitelist\", tools=_DIRECTOR_TOOLS,\n617\t        env_var=\"DIRECTOR_MODE\",\n618\t        description=\"立项前 Director：讨论方向、创建项目\",\n619\t    ),\n620\t    \"agent\": RoleDef(\n621\t        name=\"agent\", label=\"Main Agent\", phase=\"research\",\n622\t        mode=\"whitelist\", tools=_AGENT_TOOLS,\n623\t        env_var=\"\",  # default mode\n624\t        description=\"执行层：协调实验、调度 Worker、维护 registry\",\n625\t    ),\n626\t    \"reviewer\": RoleDef(\n627\t        name=\"reviewer\", label=\"Research Reviewer\", phase=\"research\",\n628\t        mode=\"whitelist\", tools=_REVIEWER_TOOLS,\n629\t        env_var=\"REVIEWER_MODE\",\n630\t        description=\"只读审查：科学性核查、实验评审\",\n631\t    ),\n632\t    \"paper_agent\": RoleDef(\n633\t        name=\"paper_agent\", label=\"Paper Agent\", phase=\"research\",\n634\t        mode=\"whitelist\", tools=_PAPER_AGENT_TOOLS,\n635\t        env_var=\"PAPER_AGENT_MODE\",\n636\t        description=\"论文写作协调者：Outline / 图表 / 文献 / 章节 / 迭代修改的串行编排\",\n637\t    ),\n638\t    \"worker\": RoleDef(\n639\t        name=\"worker\", label=\"Worker\", phase=\"research\",\n640\t        mode=\"blacklist\", tools=_WORKER_EXCLUDED,\n641\t        env_var=\"\",  # dynamic via WORKER_TOOLS\n642\t        description=\"短命任务：SSH/分析/写代码，由 Main Agent 派遣\",\n643\t    ),\n644\t    # ── Idea phase ──\n645\t    \"no_project\": RoleDef(\n646\t        name=\"no_project\", label=\"Agent (Idea Phase)\", phase=\"idea\",\n647\t        mode=\"whitelist\", tools=_NO_PROJECT_AGENT_TOOLS,\n648\t        env_var=\"NO_PROJECT_MODE\",\n649\t        description=\"无项目 Agent：workspace 管理、idea brainstorm\",\n650\t    ),\n651\t    \"idea_reviewer\": RoleDef(\n652\t        name=\"idea_reviewer\", label=\"Idea Reviewer\", phase=\"idea\",\n653\t        mode=\"whitelist\", tools=_IDEA_REVIEWER_TOOLS,\n654\t        env_var=\"IDEA_REVIEWER_MODE\",\n655\t        description=\"Idea 评审：评估研究方向可行性\",\n656\t    ),\n657\t    # ── Review phase ──\n658\t    \"review_director\": RoleDef(\n659\t        name=\"review_director\", label=\"Review Director\", phase=\"review\",\n660\t        mode=\"whitelist\", tools=_REVIEW_DIRECTOR_TOOLS,\n661\t        env_var=\"REVIEW_DIRECTOR_MODE\",\n662\t        description=\"审稿流程编排：安排一审二审、汇总报告、投递给 Research Director\",\n663\t    ),\n664\t    \"review_reviewer\": RoleDef(\n665\t        name=\"review_reviewer\", label=\"Review Reviewer\", phase=\"review\",\n666\t        mode=\"whitelist\", tools=_REVIEW_REVIEWER_TOOLS,\n667\t        env_var=\"REVIEW_REVIEWER_MODE\",\n668\t        description=\"圆桌 Reviewer：按 Director 分配的侧重点审稿\",\n669\t    ),\n670\t    # Dream-mode counterparts — separate role definitions so MCP whitelists\n671\t    # and prompt builders can vary even though the underlying behaviour\n672\t    # (roundtable / per-reviewer focus) is shared.\n673\t    \"dream_review_director\": RoleDef(\n674\t        name=\"dream_review_director\", label=\"Dream Review Director\", phase=\"review\",\n675\t        mode=\"whitelist\", tools=_DREAM_REVIEW_DIRECTOR_TOOLS,\n676\t        env_var=\"DREAM_REVIEW_DIRECTOR_MODE\",\n677\t        description=\"Dream 模拟论文审稿编排：精简工具集，报告直接回传给 Dream Tool\",\n678\t    ),\n679\t    \"dream_review_reviewer\": RoleDef(\n680\t        name=\"dream_review_reviewer\", label=\"Dream Review Reviewer\", phase=\"review\",\n681\t        mode=\"whitelist\", tools=_DREAM_REVIEW_REVIEWER_TOOLS,\n682\t        env_var=\"DREAM_REVIEW_REVIEWER_MODE\",\n683\t        description=\"Dream 圆桌 Reviewer：独立 session，按 Dream Review Director 分配的侧重点审稿\",\n684\t    ),\n685\t    # ── Study phase ──\n686\t    \"study_director\": RoleDef(\n687\t        name=\"study_director\", label=\"Study Director\", phase=\"study\",\n688\t        mode=\"whitelist\", tools=_STUDY_DIRECTOR_TOOLS,\n689\t        env_var=\"STUDY_DIRECTOR_MODE\",\n690\t        description=\"学习流程编排、验证协调\",\n691\t    ),\n692\t    \"study_agent\": RoleDef(\n693\t        name=\"study_agent\", label=\"Study Agent\", phase=\"study\",\n694\t        mode=\"whitelist\", tools=_STUDY_AGENT_TOOLS,\n695\t        env_var=\"STUDY_AGENT_MODE\",\n696\t        description=\"生成学习资料包、组装验证内容\",\n697\t    ),\n698\t    \"study_reviewer\": RoleDef(\n699\t        name=\"study_reviewer\", label=\"Study Reviewer\", phase=\"study\",\n700\t        mode=\"whitelist\", tools=_STUDY_REVIEWER_TOOLS,\n701\t        env_var=\"STUDY_REVIEWER_MODE\",\n702\t        description=\"审核学习资料包质量\",\n703\t    ),\n704\t    # ── Visitor (any phase) ──\n705\t    \"briefer\": RoleDef(\n706\t        name=\"briefer\", label=\"Briefer (Visitor/Read-Only)\", phase=\"any\",\n707\t        mode=\"whitelist\", tools=_BRIEFER_TOOLS,\n708\t        env_var=\"BRIEFER_MODE\",\n709\t        description=\"访客只读模式：非官方群/DM 查询项目状态，不可执行副作用\",\n710\t    ),\n711\t}\n712\t\n713\t\n714\t# ---------------------------------------------------------------------------\n715\t# Public API\n716\t# ---------------------------------------------------------------------------\n717\t\n718\tdef get_tools_for_role(role: str) -> frozenset[str]:\n719\t    \"\"\"Return the tool set for a role (whitelist roles only).\n720\t\n721\t    Supports dynamic reviewer roles: review_reviewer_N falls back to\n722\t    the generic ``review_reviewer`` definition. Dream-mode reviewer roles\n723\t    (``dream_review_reviewer_N``) similarly fall back to\n724\t    ``dream_review_reviewer``.\n725\t    \"\"\"\n726\t    role_def = ROLES.get(role)\n727\t    # Dynamic fallback: review_reviewer_3 → review_reviewer,\n728\t    # dream_review_reviewer_2 → dream_review_reviewer.\n729\t    if not role_def and role.startswith(\"dream_review_reviewer_\") and role[len(\"dream_review_reviewer_\"):].isdigit():\n730\t        role_def = ROLES.get(\"dream_review_reviewer\")\n731\t    elif not role_def and role.startswith(\"review_reviewer_\") and role[16:].isdigit():\n732\t        role_def = ROLES.get(\"review_reviewer\")\n733\t    if not role_def or role_def.mode != \"whitelist\":\n734\t        return frozenset()\n735\t    return role_def.tools\n736\t\n737\t\n738\tdef get_excluded_tools(role: str) -> frozenset[str]:\n739\t    \"\"\"Return tools to exclude for a role (blacklist roles only).\"\"\"\n740\t    role_def = ROLES.get(role)\n741\t    if not role_def or role_def.mode != \"blacklist\":\n742\t        return frozenset()\n743\t    return role_def.tools\n744\t\n745\t\n746\tdef get_env_var(role: str) -> str:\n747\t    \"\"\"Return the MCP env var name for a role (empty for default mode).\"\"\"\n748\t    role_def = ROLES.get(role)\n749\t    return role_def.env_var if role_def else \"\"\n750\t\n751\t\n752\t# ---------------------------------------------------------------------------\n753\t# SAFE_MODE built-in tool allowlist\n754\t# ---------------------------------------------------------------------------\n755\t\n756\t# Read-only Claude built-in tools safe to auto-approve in SAFE_MODE.\n757\t# Bash / Write / Edit / MultiEdit / NotebookEdit are intentionally excluded —\n758\t# SAFE_MODE exists specifically to gate those behind human approval.\n759\t_SAFE_MODE_BUILTINS: frozenset[str] = frozenset({\n760\t    \"Read\", \"Glob\", \"Grep\", \"WebSearch\", \"WebFetch\", \"TodoWrite\",\n761\t})\n762\t\n763\t\n764\tdef get_safe_mode_builtin_tools(role: str) -> list[str]:  # noqa: ARG001\n765\t    \"\"\"Return Claude built-in tools auto-approved in SAFE_MODE for any role.\n766\t\n767\t    All roles share the same conservative set — read-only + web research only.\n768\t    Bash / Write / Edit are never included regardless of role.\n769\t    \"\"\"\n770\t    return sorted(_SAFE_MODE_BUILTINS)\n771\t"}]},"parent_tool_use_id":"toolu_01ATD3Eexf43tUXSera5hnLE","session_id":"7a809893-9edf-45cd-a05c-395ee786b54e","uuid":"1a46cd2a-c9b3-4087-bc3b-d33e6927624a","timestamp":"2026-05-11T23:47:31.874Z"}
