\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces CLS repo-level results. $\Delta _\text  {maj}$: gap over majority baseline (73.0\%). DeepSeek CLS achieves 77.2\% mean accuracy across two seeds, above the majority baseline but 7.6pp below Qwen3-8B. Best DeepSeek checkpoint: step 800 (eval loss 0.38).}}{5}{table.caption.9}\protected@file@percent }
\newlabel{tab:cls_repo}{{3}{5}{CLS repo-level results. $\Delta _\text {maj}$: gap over majority baseline (73.0\%). DeepSeek CLS achieves 77.2\% mean accuracy across two seeds, above the majority baseline but 7.6pp below Qwen3-8B. Best DeepSeek checkpoint: step 800 (eval loss 0.38)}{table.caption.9}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces CWM repo-level results. Unparseable outputs render CWM ineffective at repository-level. Qwen3 produces 93\% unparseable outputs; DeepSeek reduces this to 52\% but still falls below the majority baseline. Parseable DeepSeek samples reach 71.8\% accuracy, near the majority baseline.}}{5}{table.caption.10}\protected@file@percent }
\newlabel{tab:cwm_repo}{{4}{5}{CWM repo-level results. Unparseable outputs render CWM ineffective at repository-level. Qwen3 produces 93\% unparseable outputs; DeepSeek reduces this to 52\% but still falls below the majority baseline. Parseable DeepSeek samples reach 71.8\% accuracy, near the majority baseline}{table.caption.10}{}}
