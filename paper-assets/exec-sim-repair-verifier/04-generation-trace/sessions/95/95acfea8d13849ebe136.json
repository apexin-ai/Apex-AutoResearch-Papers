              "text": "{\"result\":\"{\\\"success\\\": true, \\\"data\\\": {\\\"stdout\\\": \\\"#!/bin/bash\\\\n# Eval DeepSeek CWM repo-level s456-v2 — final epoch checkpoint\\\\n# Run on GPU 1 after training completes\\\\nset -e\\\\ncd /home/sonny/exec-sim-repair-verifier\\\\n\\\\nCKPT_DIR=\\\\\\\"/root/autodl-tmp/checkpoints_deepseek_cwm_repo_s456_v2\\\\\\\"\\\\nFINAL_CKPT=$(ls -d ${CKPT_DIR}/checkpoint-* 2>/dev/null | awk -F'checkpoint-' '{print $NF, $0}' | sort -n | tail -1 | cut -d' ' -f2-)\\\\nif [ -z \\\\\\\"$FINAL_CKPT\\\\\\\" ]; then\\\\n    echo \\\\\\\"ERROR: No checkpoint found in ${CKPT_DIR}\\\\\\\"\\\\n    exit 1\\\\nfi\\\\necho \\\\\\\"Using checkpoint: $FINAL_CKPT\\\\\\\"\\\\n\\\\nOUTDIR=\\\\\\\"/root/autodl-tmp/eval_results/deepseek_cwm_repo_s456_v2_eval\\\\\\\"\\\\nmkdir -p \\\\\\\"$OUTDIR\\\\\\\"\\\\n\\\\nCUDA_VISIBLE_DEVICES=1 /root/miniconda3/bin/python eval_repo_cwm.py \\\\\\\\\\\\n    --checkpoint_dir \\\\\\\"$FINAL_CKPT\\\\\\\" \\\\\\\\\\\\n    --model_name /root/autodl-tmp/models/deepseek-ai/deepseek-coder-6.7b-instruct \\\\\\\\\\\\n    --split test \\\\\\\\\\\\n    --device cuda:0 \\\\\\\\\\\\n    --max_seq_length 4096 \\\\\\\\\\\\n    --max_new_tokens 512 \\\\\\\\\\\\n    --batch_size 4 \\\\\\\\\\\\n    --output_dir \\\\\\\"$OUTDIR\\\\\\\"\\\\n\\\\necho \\\\\\\"Eval complete. Results in $OUTDIR\\\\\\\"\\\\npython3 -c \\\\\\\"\\\\nimport json\\\\nresults = [json.loads(l) for l in open('${OUTDIR}/results_incremental.jsonl')]\\\\ntotal = len(results)\\\\nunparseable = sum(1 for r in results if r.get('unparseable', False))\\\\ncorrect = sum(1 for r in results if r.get('correct', False) and not r.get('unparseable', False))\\\\nprint(f'Total: {total}, Correct: {correct} ({100*correct/total:.2f}%), Unparseable: {unparseable} ({100*unparseable/total:.2f}%)')\\\\nif total > unparseable:\\\\n    print(f'Accuracy (excl unparseable): {100*correct/(total-unparseable):.2f}%')\\\\nsample = results[0]\\\\ngen_len = len(sample.get('gen_text', ''))\\\\nprint(f'Sample gen_text length: {gen_len} chars (expect >100 for repo-level CWM)')\\\\n\\\\\\\"\\\\n\\\", \\\"stderr\\\": \\\"\\\", \\\"return_code\\\": 0}, \\\"error\\\": null, \\\"metadata\\\": {\\\"elapsed_seconds\\\": 0.43}}\"}"
