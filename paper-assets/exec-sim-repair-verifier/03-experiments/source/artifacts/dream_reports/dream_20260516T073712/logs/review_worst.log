ion.\n118\t\\newblock In \\emph{ICML}.\n119\t\n120\t\\bibitem[{Raffel et~al.(2020)Raffel, Shazeer, Roberts, Lee, Narang, Matena,\n121\t  Zhou, Li, and Liu}]{raffel2020t5}\n122\tColin Raffel, Noam Shazeer, Adam Roberts, Katherine Lee, Sharan Narang, Michael\n123\t  Matena, Yanqi Zhou, Wei Li, and Peter~J Liu. 2020.\n124\t\\newblock Exploring the limits of transfer learning with a unified text-to-text\n125\t  transformer.\n126\t\\newblock \\emph{JMLR}, 21(140):1--67.\n127\t\n128\t\\bibitem[{Rajpurkar et~al.(2016)Rajpurkar, Zhang, Lopyrev, and\n129\t  Liang}]{rajpurkar2016squad}\n130\tPranav Rajpurkar, Jian Zhang, Konstantin Lopyrev, and Percy Liang. 2016.\n131\t\\newblock {SQuAD}: 100,000+ questions for machine comprehension of text.\n132\t\\newblock In \\emph{EMNLP}.\n133\t\n134\t\\bibitem[{Schuirmann(1987)}]{schuirmann1987tost}\n135\tDonald~J Schuirmann. 1987.\n136\t\\newblock A comparison of the two one-sided tests procedure and the power\n137\t  approach for assessing the equivalence of average bioavailability.\n138\t\\newblock \\emph{Journal of Pharmacokinetics and Biopharmaceutics},\n139\t  15(6):657--680.\n140\t\n141\t\\bibitem[{Shrout and Fleiss(1979)}]{shrout1979icc}\n142\tPatrick~E Shrout and Joseph~L Fleiss. 1979.\n143\t\\newblock \\href {https://doi.org/10.1037/0033-2909.86.2.420} {Intraclass\n144\t  correlations: Uses in assessing rater reliability}.\n145\t\\newblock \\emph{Psychological Bulletin}, 86(2):420--428.\n146\t\n147\t\\bibitem[{Shum et~al.(2025)Shum, Hui, Chen, Zhang, Yang, Huang, Lin, and\n148\t  He}]{shum2025swerm}\n149\tKaShun Shum, Binyuan Hui, Jiawei Chen, Lei Zhang, Jiaxi Yang, Yuzhen Huang,\n150\t  Junyang Lin, and Junxian He. 2025.\n151\t\\newblock {SWE-RM}: Execution-free feedback for software engineering agents.\n152\t\\newblock \\emph{arXiv preprint arXiv:2512.21919}.\n153\t\n154\t\\bibitem[{Snell et~al.(2025)Snell, Lee, Xu, and Kumar}]{snell2024scaling}\n155\tCharlie Snell, Jaehoon Lee, Kelvin Xu, and Aviral Kumar. 2025.\n156\t\\newblock Scaling {LLM} test-time compute optimally can be more effective than\n157\t  scaling model parameters.\n158\t\\newblock In \\emph{ICLR}.\n159\t\\newblock Oral.\n160\t\n161\t\\bibitem[{Xia et~al.(2025)Xia, Deng, Dunn, and Zhang}]{xia2024agentless}\n162\tChunqiu~Steven Xia, Yinlin Deng, Soren Dunn, and Lingming Zhang. 2025.\n163\t\\newblock Agentless: Demystifying {LLM}-based software engineering agents.\n164\t\\newblock In \\emph{FSE}.\n165\t\\newblock Distinguished Paper.\n166\t\n167\t\\bibitem[{Xu et~al.(2025)Xu, Tan, Liu, Peng, Gao, and He}]{xu2025patchreasoner}\n168\tJunjielong Xu, Boyin Tan, Xiaoyuan Liu, Chao Peng, Pengfei Gao, and Pinjia He.\n169\t  2025.\n170\t\\newblock Scalable supervising software agents with patch reasoner.\n171\t\\newblock \\emph{arXiv preprint arXiv:2510.22775}.\n172\t\n173\t\\bibitem[{Yang et~al.(2025{\\natexlab{a}})Yang, Li, Yang, Zhang, Hui\n174\t  et~al.}]{qwen2025qwen3}\n175\tAn~Yang, Anfeng Li, Baosong Yang, Beichen Zhang, Binyuan Hui, and 1 others.\n176\t  2025{\\natexlab{a}}.\n177\t\\newblock {Qwen3} technical report.\n178\t\\newblock \\emph{arXiv preprint arXiv:2505.09388}.\n179\t\n180\t\\bibitem[{Yang et~al.(2025{\\natexlab{b}})Yang, Cai, Liu, Le, Zhang,\n181\t  Bissyand{\\'e}, Liu, and Tian}]{yang2025aprsurvey}\n182\tBoyang Yang, Zijian Cai, Fengling Liu, Bach Le, Lingming Zhang,\n183\t  Tegawend{\\'e}~F. Bissyand{\\'e}, Yang Liu, and Haoye Tian. 2025{\\natexlab{b}}.\n184\t\\newblock A survey of {LLM}-based automated program repair: Taxonomies, design\n185\t  paradigms, and applications.\n186\t\\newblock \\emph{arXiv preprint arXiv:2506.23749}.\n187\t\n188\t\\bibitem[{Yang et~al.(2024)Yang, Jimenez, Wettig, Lieret, Yao, Narasimhan, and\n189\t  Press}]{yang2024sweagent}\n190\tJohn Yang, Carlos~E Jimenez, Alexander Wettig, Kilian Lieret, Shunyu Yao,\n191\t  Karthik Narasimhan, and Ofir Press. 2024.\n192\t\\newblock {SWE-agent}: Agent-computer interfaces enable automated software\n193\t  engineering.\n194\t\\newblock In \\emph{NeurIPS}.\n195\t\n196\t\\end{thebibliography}\n197\t"}]},"parent_tool_use_id":"toolu_01A559eZPhoFF4kZVPkScFsS","session_id":"d1877127-5380-427b-bef7-ba16c8f39205","uuid":"dd1b5527-10a7-4c57-a58d-ebe807a508a6","timestamp":"2026-05-16T08:30:32.990Z"}
