r Real Faults in Software Testing?},\n270\t  author={Just, Ren{\\'e} and Jalali, Darioush and Inozemtseva, Laura and Ernst, Michael D and Holmes, Reid and Fraser, Gordon},\n271\t  booktitle={FSE},\n272\t  pages={654--665},\n273\t  year={2014}\n274\t}\n275\t\n276\t% === Sampling and Consistency ===\n277\t\n278\t@inproceedings{wang2023selfconsistency,\n279\t  title={Self-Consistency Improves Chain of Thought Reasoning in Language Models},\n280\t  author={Wang, Xuezhi and Wei, Jason and Schuurmans, Dale and Le, Quoc and Chi, Ed and Narang, Sharan and Chowdhery, Aakanksha and Zhou, Denny},\n281\t  booktitle={ICLR},\n282\t  year={2023}\n283\t}\n284\t\n285\t% === Statistical Methods ===\n286\t\n287\t@article{schuirmann1987tost,\n288\t  title={A Comparison of the Two One-Sided Tests Procedure and the Power Approach for Assessing the Equivalence of Average Bioavailability},\n289\t  author={Schuirmann, Donald J},\n290\t  journal={Journal of Pharmacokinetics and Biopharmaceutics},\n291\t  volume={15},\n292\t  number={6},\n293\t  pages={657--680},\n294\t  year={1987}\n295\t}\n296\t\n297\t@book{davison1997bootstrap,\n298\t  title={Bootstrap Methods and their Application},\n299\t  author={Davison, Anthony C and Hinkley, David V},\n300\t  publisher={Cambridge University Press},\n301\t  year={1997}\n302\t}\n303\t\n304\t@article{shrout1979icc,\n305\t  title={Intraclass Correlations: Uses in Assessing Rater Reliability},\n306\t  author={Shrout, Patrick E and Fleiss, Joseph L},\n307\t  journal={Psychological Bulletin},\n308\t  volume={86},\n309\t  number={2},\n310\t  pages={420--428},\n311\t  year={1979},\n312\t  doi={10.1037/0033-2909.86.2.420}\n313\t}\n314\t\n315\t% === Code Evaluation Metrics ===\n316\t\n317\t@inproceedings{zhuo2024icescore,\n318\t  title={{ICE-Score}: Instructing Large Language Models to Evaluate Code},\n319\t  author={Zhuo, Terry Yue},\n320\t  booktitle={Findings of EACL},\n321\t  year={2024}\n322\t}\n323\t\n324\t@article{dong2024codescore,\n325\t  title={{CodeScore}: Evaluating Code Generation by Learning Code Execution},\n326\t  author={Dong, Yihong and Ding, Jiazheng and Jiang, Xue and Li, Ge and Li, Zhuo and Jin, Zhi},\n327\t  journal={ACM Transactions on Software Engineering and Methodology},\n328\t  volume={33},\n329\t  number={8},\n330\t  year={2024}\n331\t}\n332\t\n333\t@inproceedings{zhou2023codebertscore,\n334\t  title={{CodeBERTScore}: Evaluating Code Generation with Pretrained Models of Code},\n335\t  author={Zhou, Shuyan and Alon, Uri and Agarwal, Sumit and Neubig, Graham},\n336\t  booktitle={EMNLP},\n337\t  year={2023}\n338\t}\n339\t\n340\t% === Code Reward Models ===\n341\t\n342\t@inproceedings{ye2025prlcoder,\n343\t  title={Process-Supervised Reinforcement Learning for Code Generation},\n344\t  author={Ye, Yufan and Zhang, Ting and Jiang, Wenbin and Huang, Hua},\n345\t  booktitle={EMNLP},\n346\t  year={2025}\n347\t}\n348\t\n349\t@article{dreamprm2025code,\n350\t  title={{DreamPRM-Code}: Function-as-Step Process Reward Model with Label Correction for {LLM} Coding},\n351\t  author={Zhang, Ruiyi and Qin, Peijia and Cao, Qi and Xie, Pengtao},\n352\t  journal={arXiv preprint arXiv:2512.15000},\n353\t  year={2025}\n354\t}\n355\t\n356\t% === Mutation Testing ===\n357\t\n358\t@inproceedings{jain2023contextual,\n359\t  title={Contextual Predictive Mutation Testing},\n360\t  author={Jain, Kush and Barik, Ristimoy and Le Goues, Claire},\n361\t  booktitle={ESEC/FSE},\n362\t  year={2023}\n363\t}\n364\t\n365\t@article{wang2024llmmutation,\n366\t  title={A Comprehensive Study on Large Language Models for Mutation Testing},\n367\t  author={Wang, Bo and Chen, Mingda and Deng, Ming and Lin, Youfang and Harman, Mark and Papadakis, Mike and Zhang, Jie M.},\n368\t  journal={ACM Transactions on Software Engineering and Methodology},\n369\t  year={2025}\n370\t}\n371\t\n372\t% === Code Generation Systems ===\n373\t\n374\t@techreport{alphacode2023team,\n375\t  title={{AlphaCode} 2 Technical Report},\n376\t  author={{AlphaCode Team}},\n377\t  institution={Google DeepMind},\n378\t  year={2023},\n379\t  url={https://storage.googleapis.com/deepmind-media/AlphaCode2/AlphaCode2_Tech_Report.pdf}\n380\t}\n381\t"}]},"parent_tool_use_id":"toolu_01S9jdEfjtr9TtQWrYKjNWLa","session_id":"2ec43eb0-267d-4891-8215-c57a95dc449f","uuid":"4b58a59e-439f-450f-aadb-ce3887b820c9","timestamp":"2026-05-18T18:02:52.335Z"}
