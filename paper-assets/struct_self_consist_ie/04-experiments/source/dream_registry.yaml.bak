  dream_20260516T113255:
    dream_id: dream_20260516T113255
    project: struct_self_consist_ie
    status: done
    review_mode: full
    review_visible: true
    writing_visible: true
    venue: EMNLP 2026 Main Conference
    focus: 'D116 DUAL CONTRIBUTION reframe: (A) QE positive (AUROC 0.82) + (B) selection
      diagnostic (multi-causal: degeneracy + LP compression + rank=8 shows necessary-not-sufficient).
      Key updates since last Dream: (1) Table 2 fixed to macro F1 — selection ≈ greedy
      (+0.2pp, p=.29), not "greedy surpasses all"; (2) exp-023 LoRA rank=8 done —
      degeneracy 7.2% but selection still fails, strongest experiment per last Dream;
      (3) trained verifier baseline (logistic regression) in progress; (4) R²=0.94
      on n=3 downgraded to qualitative illustration; (5) "capability trap" renamed
      to "capability-degeneracy tradeoff"; (6) QE-vs-selection decoupling identified
      as most novel insight. Question: does the dual-contribution reframe + trained
      verifier + rank=8 multi-causal evidence push from 3.0 to ≥3.5 (Main Conference)?'
    what_if: []
    pid: 479068
    chat_id: oc_1b56445332d8ca2b4964b30f300f0e00
