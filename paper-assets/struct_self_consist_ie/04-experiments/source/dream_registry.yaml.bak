  dream_20260515T092545:
    dream_id: dream_20260515T092545
    project: struct_self_consist_ie
    status: done
    review_mode: full
    review_visible: true
    writing_visible: true
    venue: EMNLP 2026 Findings
    focus: 'Paper has been reframed from "systematic comparison + negative finding"
      to "identifying, diagnosing, and experimentally verifying a regime-specific
      selection bottleneck caused by constrained decoding". The breakthrough experiment
      is free-form decoding ablation (exp-018) that proves score compression is the
      mechanism. Evaluate whether this reframing + new experiment breaks through the
      3.0/5 plateau to 3.5+. Key question: does the constrained decoding bottleneck
      story have enough intellectual depth for Findings acceptance?'
    what_if: []
    pid: 257492
    chat_id: oc_1b56445332d8ca2b4964b30f300f0e00
