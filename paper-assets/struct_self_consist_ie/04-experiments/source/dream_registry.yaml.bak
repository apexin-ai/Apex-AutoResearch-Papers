  dream_20260514T105303:
    dream_id: dream_20260514T105303
    project: struct_self_consist_ie
    status: done
    review_mode: full
    review_visible: true
    writing_visible: true
    venue: ''
    focus: 'Post-revision dream. Key change: paper now compares 4 confidence signal
      families (log-prob, exact-match, FK, SJ) rather than just SJ vs FK. Reviewers
      in previous dream unanimously flagged missing baselines as #1 issue. This revision
      should address: (1) baseline completeness, (2) evaluation metric breadth (rho
      + AUROC + calibration + tau), (3) reframed contribution as systematic comparison
      + diagnostic analysis. Watch for: does the broader baseline set change the novelty
      assessment? Does SJ-vs-logprob become the new critical question?'
    what_if: []
