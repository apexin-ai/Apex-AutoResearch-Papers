\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Selection results on SciERC ($N=8$, $T=1.0$). $\Delta $ in percentage points vs.\ greedy. NER LP: bootstrap $p = 0.39$, 95\% CI $[-3.0, +4.2]$pp, Cohen's $d = 0.038$. Oracle headroom is 13--18pp but no signal captures more than 0.6pp.}}{3}{table.caption.11}\protected@file@percent }
\newlabel{tab:selection}{{2}{3}{Selection results on SciERC ($N=8$, $T=1.0$). $\Delta $ in percentage points vs.\ greedy. NER LP: bootstrap $p = 0.39$, 95\% CI $[-3.0, +4.2]$pp, Cohen's $d = 0.038$. Oracle headroom is 13--18pp but no signal captures more than 0.6pp}{table.caption.11}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces LLaMA-3.1-8B on CoNLL-2003 ($N=8$, $T=1.0$). QE correlations ($\rho = 0.31$--$0.43$) match Qwen3-8B ($\rho = 0.44$), confirming model-agnostic QE. Selection gains $\leq 0.2$pp with 2.1pp oracle headroom. Instance degeneracy: 56\%.}}{3}{table.caption.12}\protected@file@percent }
\newlabel{tab:llama_conll}{{3}{3}{LLaMA-3.1-8B on CoNLL-2003 ($N=8$, $T=1.0$). QE correlations ($\rho = 0.31$--$0.43$) match Qwen3-8B ($\rho = 0.44$), confirming model-agnostic QE. Selection gains $\leq 0.2$pp with 2.1pp oracle headroom. Instance degeneracy: 56\%}{table.caption.12}{}}
