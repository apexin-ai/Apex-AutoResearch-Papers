emantic_scholar_id: ''\\\\n    verified: true\\\\n    added_by: paper-research:lit_batch2\\\\n    added_at: '2026-05-14T18:10:52.000Z'\\\\n  xiao2019uncertainty:\\\\n    title: Quantifying Uncertainties in Natural Language Processing Tasks\\\\n    authors:\\\\n    - Yijun Xiao\\\\n    - William Yang Wang\\\\n    year: 2019\\\\n    venue: AAAI 2019\\\\n    url: https://arxiv.org/abs/1811.07253\\\\n    doi: 10.1609/aaai.v33i01.33017322\\\\n    bibtex_key: xiao2019uncertainty\\\\n    category: token_span_uncertainty_ner\\\\n    role: foundation\\\\n    relevance: Pioneers Bayesian uncertainty quantification for NLP tasks including NER, showing that modeling data and model\\\\n      uncertainty improves both performance and reliability for token-level predictions.\\\\n    abstract: ''\\\\n    semantic_scholar_id: ''\\\\n    verified: true\\\\n    added_by: paper-research:lit_batch2\\\\n    added_at: '2026-05-14T18:10:52.000Z'\\\\n  shelmanov2021active:\\\\n    title: Active Learning for Sequence Tagging with Deep Pre-trained Models and Bayesian Uncertainty Estimates\\\\n    authors:\\\\n    - Artem Shelmanov\\\\n    - Dmitri Puzyrev\\\\n    - Lyubov Kupriyanova\\\\n    - Denis Belyakov\\\\n    - Daniil Larionov\\\\n    - Nikita Khromov\\\\n    - Olga Kozlova\\\\n    - Ekaterina Artemova\\\\n    - Dmitry V. Dylov\\\\n    - Alexander Panchenko\\\\n    year: 2021\\\\n    venue: EACL 2021\\\\n    url: https://arxiv.org/abs/2101.08133\\\\n    doi: 10.18653/v1/2021.eacl-main.145\\\\n    bibtex_key: shelmanov2021active\\\\n    category: token_span_uncertainty_ner\\\\n    role: foundation\\\\n    relevance: Extensive empirical study of Bayesian uncertainty estimation (MC dropout variants) for sequence tagging with\\\\n      pre-trained models. Establishes best practices for uncertainty-guided active learning in NER.\\\\n    abstract: ''\\\\n    semantic_scholar_id: ''\\\\n    verified: true\\\\n    added_by: paper-research:lit_batch2\\\\n    added_at: '2026-05-14T18:10:52.000Z'