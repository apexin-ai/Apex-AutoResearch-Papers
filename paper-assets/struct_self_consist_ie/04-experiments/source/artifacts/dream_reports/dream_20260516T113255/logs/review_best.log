{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HAjgdaZxgAn3aoJbS1215y","type":"tool_result","content":"{\"result\":\"{\\\"success\\\": true, \\\"data\\\": {\\\"path\\\": \\\"/home/ubuntu/.agent-ml-research-idea_gen_0514_1/projects/struct_self_consist_ie/literature_map.yaml\\\", \\\"content\\\": \\\"meta:\\\\n  last_updated: '2026-05-14T21:00:00.000Z'\\\\n  total_papers: 55\\\\ncategories: []\\\\npapers:\\\\n  wang2023selfconsistency:\\\\n    title: Self-Consistency Improves Chain of Thought Reasoning in Language Models\\\\n    authors:\\\\n    - Xuezhi Wang\\\\n    - Jason Wei\\\\n    - Dale Schuurmans\\\\n    - Quoc Le\\\\n    - Ed Chi\\\\n    - Sharan Narang\\\\n    - Aakanksha Chowdhery\\\\n    - Denny Zhou\\\\n    year: 2023\\\\n    venue: ICLR 2023\\\\n    url: https://arxiv.org/abs/2203.11171\\\\n    doi: ''\\\\n    bibtex_key: wang2023selfconsistency\\\\n    category: self_consistency_reasoning\\\\n    role: foundation\\\\n    relevance: 'Foundation paper: introduces self-consistency voting over diverse reasoning paths. We extend this paradigm\\\\n      from closed-form answers to structured IE outputs.'\\\\n    abstract: ''\\\\n    semantic_scholar_id: ''\\\\n    verified: true\\\\n    added_by: paper-research:cluster1\\\\n    added_at: '2026-05-14T15:47:22.188Z'\\\\n  taubenfeld2025cisc:\\\\n    title: Confidence Improves Self-Consistency in LLMs\\\\n    authors:\\\\n    - Amir Taubenfeld\\\\n    - Tom Sheffer\\\\n    - Eran Ofek\\\\n    - Amir Feder\\\\n    - Ariel Goldstein\\\\n    - Zorik Gekhman\\\\n    - Gal Yona\\\\n    year: 2025\\\\n    venue: ACL Findings 2025\\\\n    url: https://arxiv.org/abs/2502.06233\\\\n    doi: 10.18653/v1/2025.findings-acl.1030\\\\n    bibtex_key: taubenfeld2025cisc\\\\n    category: self_consistency_reasoning\\\\n    role: direct-competitor\\\\n    relevance: 'CISC: confidence-weighted majority vote reduces required samples by 40%. Direct competitor — we address the\\\\n      same \\\\\\\"strong predictor, weak selector\\\\\\\" gap but for structured outputs.'\\\\n    abstract: ''\\\\n    semantic_scholar_id: ''\\\\n    verified: true\\\\n    added_by: paper-research:cluster1\\\\n    added_at: '2026-05-14T15:47:22.188Z'\\\\n  kang2025selfcertainty:\\\\n    title: Scalable Best-of-N Selection for Large Language Models via Self-Certainty\\\\n    authors:\\\\n    - Zhewei Kang\\\\n    - Xuandong Zhao\\\\n    - Dawn Song\\\\n    year: 2025\\\\n    venue: NeurIPS 2025\\\\n    url: https://arxiv.org/abs/2502.18581\\\\n    doi: ''\\\\n    bibtex_key: kang2025selfcertainty\\\\n    category: self_consistency_reasoning\\\\n    role: direct-competitor\\\\n    relevance: Self-certainty metric for BoN selection using output probability distributions. Direct competitor — reward-free\\\\n      quality estimation that we compare against for structured IE.\\\\n    abstract: ''\\\\n    semantic_scholar_id: ''\\\\n    verified: true\\\\n    added_by: paper-research:cluster1\\\\n    added_at: '2026-05-14T15:47:22.188Z'\\\\n  kim2026reasc:\\\\n    title: Reliability-Aware Adaptive Self-Consistency for Efficient Sampling in LLM Reasoning\\\\n    authors:\\\\n    - Junseok Kim\\\\n    - Nakyeong Yang\\\\n    - Kyungmin Min\\\\n    - Kyomin Jung\\\\n    year: 2026\\\\n    venue: ACL 2026\\\\n    url: https://arxiv.org/abs/2601.02970\\\\n    doi: ''\\\\n    bibtex_key: kim2026reasc\\\\n    category: self_consistency_reasoning\\\\n    role: direct-competitor\\\\n    relevance: 'ReASC: two-stage adaptive sampling using response-level confidence for evidence sufficiency. Reduces cost\\\\n      by 70% on GSM8K. Directly relevant to our efficiency analysis.'\\\\n    abstract: ''\\\\n    semantic_scholar_id: ''\\\\n    verified: true\\\\n    added_by: paper-research:cluster1\\\\n    added_at: '2026-05-14T15:47:22.188Z'\\\\n  thirukovalluru2024atomic:\\\\n    title: Atomic Self-Consistency for Better Long Form Generations\\\\n    authors:\\\\n    - Raghuveer Thirukovalluru\\\\n    - Yukun Huang\\\\n    - Bhuwan Dhingra\\\\n    year: 2024\\\\n    venue: EMNLP 2024\\\\n    url: https://aclanthology.org/2024.emnlp-main.706/\\\\n    doi: 10.18653/v1/2024.emnlp-main.706\\\\n    bibtex_key: thirukovalluru2024atomic\\\\n    category: self_consistency_reasoning\\\\n    role: background\\\\n    relevance: Extends self-consistency to long-form generation by merging atomic subparts from multiple samples. Related\\\\n      to our structured output aggregation approach.\\\\n    abstract: ''\\\\n    semantic_scholar_id: ''\\\\n    verified: true\\\\n    added_by: paper-research:cluster1\\\\n    added_at: '2026-05-14T15:47:22.188Z'\\\\n  chen2024usc:\\\\n    title: Universal Self-Consistency for Large Language Model Generation\\\\n    authors:\\\\n    - Xinyun Chen\\\\n    - Renat Aksitov\\\\n    - Uri Alon\\\\n    - Jie Ren\\\\n    - Kefan Xiao\\\\n    - Pengcheng Yin\\\\n    - Sushant Prakash\\\\n    - Charles Sutton\\\\n    - Xuezhi Wang\\\\n    - Denny Zhou\\\\n    year: 2024\\\\n    venue: arXiv preprint (ICML 2024 Workshop ICL)\\\\n    url: https://arxiv.org/abs/2311.17311\\\\n    doi: ''\\\\n    bibtex_key: chen2024usc\\\\n    category: self_consistency_reasoning\\\\n    role: background\\\\n    relevance: 'USC: uses LLM itself to select most consistent answer among candidates, extending SC beyond closed-form answers\\\\n      to free-form generation. Precursor to our structured consistency approach.'\\\\n    abstract: ''\\\\n    semantic_scholar_id: ''\\\\n    verified: true\\\\n    added_by: paper-research:cluster1\\\\n    added_at: '2026-05-14T15:47:22.188Z'\\\\n  manakul2023selfcheckgpt:\\\\n    title: 'SelfCheckGPT: Zero-Resource Black-Box Hallucination Detection for Generative Large Language Models'\\\\n    authors:\\\\n    - Potsawee Manakul\\\\n    - Adian Liusie\\\\n    - Mark Gales\\\\n    year: 2023\\\\n    venue: EMNLP 2023\\\\n    url: https://aclanthology.org/2023.emnlp-main.557/\\\\n    doi: 10.18653/v1/2023.emnlp-main.557\\\\n    bibtex_key: manakul2023selfcheckgpt\\\\n    category: self_consistency_reasoning\\\\n    role: background\\\\n    relevance: Uses cross-sample consistency for hallucination detection — if LLM knows a fact, samples are consistent; hallucinations\\\\n      diverge. Motivates our consistency-based quality signal for IE.\\\\n    abstract: ''\\\\n    semantic_scholar_id: ''\\\\n    verified: true\\\\n    added_by: paper-research:cluster1\\\\n    added_at: '2026-05-14T15:47:22.188Z'\\\\n  wan2025rasc:\\\\n    title: 'Reasoning Aware Self-Consistency: Leveraging Reasoning Paths for Efficient LLM Sampling'\\\\n    authors:\\\\n    - Guangya Wan\\\\n    - Yuqi Wu\\\\n    - Jie Chen\\\\n    - Sheng Li\\\\n    year: 2025\\\\n    venue: NAACL 2025\\\\n    url: https://aclanthology.org/2025.naacl-long.184/\\\\n    doi: 10.18653/v1/2025.naacl-long.184\\\\n    bibtex_key: wan2025rasc\\\\n    category: self_consistency_reasoning\\\\n    role: background\\\\n    relevance: 'RASC: quality-aware selection using reasoning path assessment + consistency-driven stopping. Reduces samples\\\\n      by ~70%. Complements our approach of structured quality-aware aggregation.'\\\\n    abstract: ''\\\\n    semantic_scholar_id: ''\\\\n    verified: true\\\\n    added_by: paper-research:cluster1\\\\n    added_at: '2026-05-14T15:47:22.188Z'\\\\n  nedellec2026consistency:\\\\n    title: 'Consistency-accuracy correlation in hard-prompted LLMs for entity and relation extraction: empirical findings\\\\n      from plant-health data'\\\\n    authors:\\\\n    - Claire Nédellec\\\\n    - Jingbo Xia\\\\n    year: 2026\\\\n    venue: Genomics & Informatics\\\\n    url: https://pmc.ncbi.nlm.nih.gov/articles/PMC12888769/\\\\n    doi: 10.1186/s44342-025-00063-2\\\\n    bibtex_key: nedellec2026consistency\\\\n    category: consistency_structured_ie\\\\n    role: direct-competitor\\\\n    relevance: 'Most direct competitor: systematically measures consistency-accuracy correlation for LLM-based entity and\\\\n      relation extraction on plant-health data, validating consistency as a reliability signal for structured IE.'\\\\n    abstract: ''\\\\n    semantic_scholar_id: ''\\\\n    verified: true\\\\n    added_by: paper-research:lit_batch1\\\\n    added_at: '2026-05-14T17:52:10.000Z'\\\\n  vashurin2025cocoa:\\\\n    title: 'Uncertainty Quantification for LLMs through Minimum Bayes Risk: Bridging Confidence and Consistency'\\\\n    authors:\\\\n    - Roman Vashurin\\\\n    - Maiya Goloburda\\\\n    - Albina Ilina\\\\n    - Aleksandr Rubashevskii\\\\n    - Preslav Nakov\\\\n    - Artem Shelmanov\\\\n    - Maxim Panov\\\\n    year: 2025\\\\n    venue: NeurIPS 2025\\\\n    url: https://arxiv.org/abs/2502.04964\\\\n    doi: ''\\\\n    bibtex_key: vashurin2025cocoa\\\\n    category: consistency_structured_ie\\\\n    role: background\\\\n    relevance: CoCoA framework unifies token-level confidence and sample-level consistency via MBR for uncertainty quantification.\\\\n      Provides theoretical grounding for our dual-signal approach in structured IE.\\\\n    abstract: ''\\\\n    semantic_scholar_id: ''\\\\n    verified: true\\\\n    added_by: paper-research:lit_batch1\\\\n    added_at: '2026-05-14T17:52:10.000Z'\\\\n  hobelsberger2025systematic:\\\\n    title: Systematic Evaluation of Uncertainty Estimation Methods in Large Language Models\\\\n    authors:\\\\n    - Christian Hobelsberger\\\\n    - Theresa Winner\\\\n    - Andreas Nawroth\\\\n    - Oliver Mitevski\\\\n    - Anna-Carolina Haensch\\\\n    year: 2025\\\\n    venue: arXiv preprint\\\\n    url: https://arxiv.org/abs/2510.20460\\\\n    doi: ''\\\\n    bibtex_key: hobelsberger2025systematic\\\\n    category: consistency_structured_ie\\\\n    role: background\\\\n    relevance: Systematic comparison of VCE, MSP, self-consistency, and CoCoA for LLM uncertainty estimation. Shows hybrid\\\\n      CoCoA yields best calibration, supporting our multi-signal aggregation design.\\\\n    abstract: ''\\\\n    semantic_scholar_id: ''\\\\n    verified: true\\\\n    added_by: paper-research:lit_batch1\\\\n    added_at: '2026-05-14T17:52:10.000Z'\\\\n  geng2024confidence:\\\\n    title: A Survey of Confidence Estimation and Calibration in Large Language Models\\\\n    authors:\\\\n    - Jiahui Geng\\\\n    - Fengyu Cai\\\\n    - Yuxia Wang\\\\n    - Heinz Koeppl\\\\n    - Preslav Nakov\\\\n    - Iryna Gurevych\\\\n    year: 2024\\\\n    venue: NAACL 2024\\\\n    url: https://arxiv.org/abs/2311.08298\\\\n    doi: 10.18653/v1/2024.naacl-long.366\\\\n    bibtex_key: geng2024confidence\\\\n    category: confidence_surveys\\\\n    role: survey\\\\n    relevance: Comprehensive survey of LLM confidence estimation and calibration techniques. Provides taxonomic context for\\\\n      positioning our consistency-based confidence approach within the broader landscape.\\\\n    abstract: ''\\\\n    semantic_scholar_id: ''\\\\n    verified: true\\\\n    added_by: paper-research:lit_batch1\\\\n    added_at: '2026-05-14T17:52:10.000Z'\\\\n  wen2025know:\\\\n    title: 'Know Your Limits: A Survey of Abstention in Large Language Models'\\\\n    authors:\\\\n    - Bingbing Wen\\\\n    - Jihan Yao\\\\n    - Shangbin Feng\\\\n    - Chenjun Xu\\\\n    - Yulia Tsvetkov\\\\n    - Bill Howe\\\\n    - Lucy Lu Wang\\\\n    year: 2025\\\\n    venue: TACL 2025\\\\n    url: https://arxiv.org/abs/2407.18418\\\\n    doi: 10.1162/tacl_a_00754\\\\n    bibtex_key: wen2025know\\\\n    category: confidence_surveys\\\\n    role: supplementary\\\\n    relevance: 'Survey on LLM abstention from query, model, and human-values perspectives. Our consistency-based filtering\\\\n      can be viewed as a structured-IE-specific abstention mechanism. [SUPPLEMENTARY: overlaps with geng2024 main survey]'\\\\n    abstract: ''\\\\n    semantic_scholar_id: ''\\\\n    verified: true\\\\n    added_by: paper-research:lit_batch1\\\\n    added_at: '2026-05-14T17:52:10.000Z'\\\\n  xia2025survey:\\\\n    title: A Survey of Uncertainty Estimation Methods on Large Language Models\\\\n    authors:\\\\n    - Zhiqiu Xia\\\\n    - Jinxuan Xu\\\\n    - Yuqian Zhang\\\\n    - Hang Liu\\\\n    year: 2025\\\\n    venue: ACL Findings 2025\\\\n    url: https://aclanthology.org/2025.findings-acl.1101/\\\\n    doi: ''\\\\n    bibtex_key: xia2025survey\\\\n    category: confidence_surveys\\\\n    role: supplementary\\\\n    relevance: 'Most comprehensive LLM uncertainty estimation survey with novel taxonomy (verbalizing, latent, consistency-based,\\\\n      semantic clustering). Directly contextualizes our method within the consistency-based branch. [SUPPLEMENTARY: overlaps\\\\n      with geng2024 main survey]'\\\\n    abstract: ''\\\\n    semantic_scholar_id: ''\\\\n    verified: true\\\\n    added_by: paper-research:lit_batch1\\\\n    added_at: '2026-05-14T17:52:10.000Z'\\\\n  liu2025uqcalibration:\\\\n    title: 'Uncertainty Quantification and Confidence Calibration in Large Language Models: A Survey'\\\\n    authors:\\\\n    - Xiaoou Liu\\\\n    - Tiejin Chen\\\\n    - Longchao Da\\\\n    - Chacha Chen\\\\n    - Zhen Lin\\\\n    - Hua Wei\\\\n    year: 2025\\\\n    venue: KDD 2025\\\\n    url: https://arxiv.org/abs/2503.15850\\\\n    doi: 10.1145/3711896.3736569\\\\n    bibtex_key: liu2025uqcalibration\\\\n    category: confidence_surveys\\\\n    role: supplementary\\\\n    relevance: 'Survey analyzing UQ through input, reasoning, parameter, and prediction uncertainty dimensions. Complements\\\\n      other surveys with focus on calibration techniques applicable to our structured IE setting. [SUPPLEMENTARY: overlaps\\\\n      with geng2024 main survey]'\\\\n    abstract: ''\\\\n    semantic_scholar_id: ''\\\\n    verified: true\\\\n    added_by: paper-research:lit_batch1\\\\n    added_at: '2026-05-14T17:52:10.000Z'\\\\n  kuhn2023semantic:\\\\n    title: 'Semantic Uncertainty: Linguistic Invariances for Uncertainty Estimation in Natural Language Generation'\\\\n    authors:\\\\n    - Lorenz Kuhn\\\\n    - Yarin Gal\\\\n    - Sebastian Far