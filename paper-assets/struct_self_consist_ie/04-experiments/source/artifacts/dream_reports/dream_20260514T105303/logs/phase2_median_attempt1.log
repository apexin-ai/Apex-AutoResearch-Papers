{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GhTnHcmGntqpRXvwNX6PPQ","type":"tool_result","content":"1\t\"\"\"Multi-sample inference module for structured IE with vLLM + XGrammar constrained decoding.\n2\t\n3\tProvides VLLMSampler for batch sampling, prompt construction for UIE tasks,\n4\tand a full pipeline that produces SampledInstance dicts.\n5\t\"\"\"\n6\t\n7\tfrom __future__ import annotations\n8\t\n9\timport json\n10\timport os\n11\tfrom typing import Any\n12\t\n13\t\n14\t# ---------------------------------------------------------------------------\n15\t# UIE JSON schema for XGrammar constrained decoding\n16\t# ---------------------------------------------------------------------------\n17\t\n18\tUIE_JSON_SCHEMA: dict[str, Any] = {\n19\t    \"type\": \"object\",\n20\t    \"properties\": {\n21\t        \"entities\": {\n22\t            \"type\": \"array\",\n23\t            \"items\": {\n24\t                \"type\": \"object\",\n25\t                \"properties\": {\n26\t                    \"text\": {\"type\": \"string\"},\n27\t                    \"type\": {\"type\": \"string\"},\n28\t                    \"start\": {\"type\": \"integer\"},\n29\t                    \"end\": {\"type\": \"integer\"},\n30\t                },\n31\t                \"required\": [\"text\", \"type\", \"start\", \"end\"],\n32\t            },\n33\t        },\n34\t        \"relations\": {\n35\t            \"type\": \"array\",\n36\t            \"items\": {\n37\t                \"type\": \"object\",\n38\t                \"properties\": {\n39\t                    \"head\": {\"type\": \"string\"},\n40\t                    \"tail\": {\"type\": \"string\"},\n41\t                    \"type\": {\"type\": \"string\"},\n42\t                    \"head_start\": {\"type\": \"integer\"},\n43\t                    \"head_end\": {\"type\": \"integer\"},\n44\t                    \"tail_start\": {\"type\": \"integer\"},\n45\t                    \"tail_end\": {\"type\": \"integer\"},\n46\t                },\n47\t                \"required\": [\"head\", \"tail\", \"type\", \"head_start\", \"head_end\",\n48\t                             \"tail_start\", \"tail_end\"],\n49\t            },\n50\t        },\n51\t        \"events\": {\n52\t            \"type\": \"array\",\n53\t            \"items\": {\n54\t                \"type\": \"object\",\n55\t                \"properties\": {\n56\t                    \"trigger\": {\n57\t                        \"type\": \"object\",\n58\t                        \"properties\": {\n59\t                            \"text\": {\"type\": \"string\"},\n60\t                            \"type\": {\"type\": \"string\"},\n61\t                            \"start\": {\"type\": \"integer\"},\n62\t                            \"end\": {\"type\": \"integer\"},\n63\t                        },\n64\t                        \"required\": [\"text\", \"type\", \"start\", \"end\"],\n65\t                    },\n66\t                    \"arguments\": {\n67\t                        \"type\": \"array\",\n68\t                        \"items\": {\n69\t                            \"type\": \"object\",\n70\t                            \"properties\": {\n71\t                                \"text\": {\"type\": \"string\"},\n72\t                                \"role\": {\"type\": \"string\"},\n73\t                                \"start\": {\"type\": \"integer\"},\n74\t                                \"end\": {\"type\": \"integer\"},\n75\t                            },\n76\t                            \"required\": [\"text\", \"role\", \"start\", \"end\"],\n77\t                        },\n78\t                    },\n79\t                },\n80\t                \"required\": [\"trigger\", \"arguments\"],\n81\t            },\n82\t        },\n83\t    },\n84\t    \"required\": [\"entities\", \"relations\", \"events\"],\n85\t}\n86\t\n87\t_EMPTY_EXTRACTION: dict[str, list] = {\"entities\": [], \"relations\": [], \"events\": []}\n88\t\n89\t\n90\t# ---------------------------------------------------------------------------\n91\t# VLLMSampler\n92\t# ---------------------------------------------------------------------------\n93\t\n94\tclass VLLMSampler:\n95\t    \"\"\"Batch sampler backed by vLLM with optional XGrammar JSON constrained decoding.\"\"\"\n96\t\n97\t    def __init__(\n98\t        self,\n99\t        model_path: str,\n100\t        tensor_parallel_size: int = 1,"}]},"parent_tool_use_id":"toolu_0156ax1NzDJVhoRiaWcQ6P7T","session_id":"36d6115a-ae29-42f3-9a64-d29d87dc39c5","uuid":"1a27e336-10d5-46ea-93d0-155774e5fc81","timestamp":"2026-05-14T11:14:21.679Z"}
