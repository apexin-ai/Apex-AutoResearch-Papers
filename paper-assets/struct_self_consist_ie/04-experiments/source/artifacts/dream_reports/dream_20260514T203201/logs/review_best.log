er-research:lit_batch4\\\\n    added_at: '2026-05-14T21:00:00.000Z'\\\\n  fleiss1971agreement:\\\\n    title: Measuring Nominal Scale Agreement Among Many Raters\\\\n    authors:\\\\n    - Joseph L. Fleiss\\\\n    year: 1971\\\\n    venue: Psychological Bulletin\\\\n    url: https://psycnet.apa.org/record/1972-05083-001\\\\n    doi: 10.1037/h0031619\\\\n    bibtex_key: fleiss1971agreement\\\\n    category: agreement_metrics\\\\n    role: foundation\\\\n    relevance: 'Introduces Fleiss kappa for measuring inter-rater agreement on nominal scales with multiple raters. Foundation\\\\n      metric for quantifying cross-sample consistency in our multi-generation IE aggregation.'\\\\n    abstract: ''\\\\n    semantic_scholar_id: ''\\\\n    verified: true\\\\n    added_by: paper-research:lit_batch4\\\\n    added_at: '2026-05-14T21:00:00.000Z'\\\\n  jaccard1901distribution:\\\\n    title: Étude comparative de la distribution florale dans une portion des Alpes et du Jura\\\\n    authors:\\\\n    - Paul Jaccard\\\\n    year: 1901\\\\n    venue: Bulletin de la Société Vaudoise des Sciences Naturelles\\\\n    url: https://www.researchgate.net/publication/225035806\\\\n    doi: ''\\\\n    bibtex_key: jaccard1901distribution\\\\n    category: agreement_metrics\\\\n    role: foundation\\\\n    relevance: 'Introduces the Jaccard similarity coefficient for set comparison. Foundation metric for measuring pairwise overlap\\\\n      between extracted entity/relation sets across multiple LLM samples.'\\\\n    abstract: ''\\\\n    semantic_scholar_id: ''\\\\n    verified: true\\\\n    added_by: paper-research:lit_batch4\\\\n    added_at: '2026-05-14T21:00:00.000Z'\\\\n  wang2025rankedvoting:\\\\n    title: Ranked Voting based Self-Consistency of Large Language Models\\\\n    authors:\\\\n    - Weiqin Wang\\\\n    - Yile Wang\\\\n    - Hui Huang\\\\n    year: 2025\\\\n    venue: ACL Findings 2025\\\\n    url: https://arxiv.org/abs/2505.10772\\\\n    doi: ''\\\\n    bibtex_key: wang2025rankedvoting\\\\n    category: self_consistency_reasoning\\\\n    role: background\\\\n    relevance: 'Extends SC from single-answer majority vote to ranked answer lists with instant-runoff and Borda count voting.\\\\n      Relevant to our multi-candidate aggregation strategy for structured IE outputs.'\\\\n    abstract: ''\\\\n    semantic_scholar_id: ''\\\\n    verified: true\\\\n    added_by: paper-research:lit_batch4\\\\n    added_at: '2026-05-14T21:00:00.000Z'\\\\n  oh2025latentsc:\\\\n    title: 'Latent Self-Consistency for Reliable Majority-Set Selection in Short- and Long-Answer Reasoning'\\\\n    authors:\\\\n    - Jungsuk Oh\\\\n    - Jay-Yoon Lee\\\\n    year: 2025\\\\n    venue: arXiv preprint\\\\n    url: https://arxiv.org/abs/2508.18395\\\\n    doi: ''\\\\n    bibtex_key: oh2025latentsc\\\\n    category: self_consistency_reasoning\\\\n    role: background\\\\n    relevance: 'LSC: uses learnable summary token embeddings to compute semantic consistency across samples without text matching.\\\\n      Extends SC to long-form outputs with negligible overhead, relevant to our structured output consistency measurement.'\\\\n    abstract: ''\\\\n    semantic_scholar_id: ''\\\\n    verified: true\\\\n    added_by: paper-research:lit_batch4\\\\n    added_at: '2026-05-14T21:00:00.000Z'\\\\n  zhou2024uniner:\\\\n    title: 'UniversalNER: Targeted Distillation from Large Language Models for Open Named Entity Recognition'\\\\n    authors:\\\\n    - Wenxuan Zhou\\\\n    - Sheng Zhang\\\\n    - Yu Gu\\\\n    - Muhao Chen\\\\n    - Hoifung Poon\\\\n    year: 2024\\\\n    venue: ICLR 2024\\\\n    url: https://arxiv.org/abs/2308.03279\\\\n    doi: ''\\\\n    bibtex_key: zhou2024uniner\\\\n    category: generative_ie\\\\n    role: foundation\\\\n    relevance: 'UniNER: distills ChatGPT NER capabilities into smaller models via targeted distillation on diverse entity types.\\\\n      Demonstrates LLM-based generative NER at scale. Directly relevant as representative LLM-based NER baseline.'\\\\n    abstract: ''\\\\n    semantic_scholar_id: ''\\\\n    verified: true\\\\n    added_by: paper-agent:manual\\\\n    added_at: '2026-05-14T21:05:00.000Z'\\\\n  josifoski2022genie:\\\\n    title: 'GenIE: Generative Information Extraction'\\\\n    authors:\\\\n    - Martin Josifoski\\\\n    - Nicola De Cao\\\\n    - Maxime Peyrard\\\\n    - Fabio Petroni\\\\n    - Robert West\\\\n    year: 2022\\\\n    venue: NAACL 2022\\\\n    url: https://arxiv.org/abs/2112.08340\\\\n    doi: 10.18653/v1/2022.naacl-main.342\\\\n    bibtex_key: josifoski2022genie\\\\n    category: generative_ie\\\\n    role: foundation\\\\n    relevance: 'First end-to-end autoregressive formulation of closed IE with bi-level constrained decoding (high-level triplet\\\\n      structure + prefix-trie entity/relation constraints). Directly relevant as the foundational constrained decoding approach for structured IE.'\\\\n    abstract: ''\\\\n    semantic_scholar_id: ''\\\\n    verified: true\\\\n    added_by: paper-agent:manual\\\\n    added_at: '2026-05-14T22:00:00.000Z'\\\\n  li2023codeie:\\\\n    title: 'CodeIE: Large Code Generation Models are Better Few-Shot Information Extractors'\\\\n    authors:\\\\n    - Peng Li\\\\n    - Tianxiang Sun\\\\n    - Qiong Tang\\\\n    - Hang Yan\\\\n    - Yuanbin Wu\\\\n    - Xuanjing Huang\\\\n    - Xipeng Qiu\\\\n    year: 2023\\\\n    venue: ACL 2023\\\\n    url: https://arxiv.org/abs/2305.05711\\\\n    doi: 10.18653/v1/2023.acl-long.855\\\\n    bibtex_key: li2023codeie\\\\n    category: generative_ie\\\\n    role: background\\\\n    relevance: 'Recasts IE as code generation, leveraging Code-LLMs structural output capabilities for NER and RE. Demonstrates\\\\n      alternative structured generation approach complementary to constrained decoding.'\\\\n    abstract: ''\\\\n    semantic_scholar_id: ''\\\\n    verified: true\\\\n    added_by: paper-agent:manual\\\\n    added_at: '2026-05-14T22:00:00.000Z'\\\\n  wang2023instructuie:\\\\n    title: 'InstructUIE: Multi-task Instruction Tuning for Unified Information Extraction'\\\\n    authors:\\\\n    - Xiao Wang\\\\n    - Weikang Zhou\\\\n    - Can Zu\\\\n    - Han Xia\\\\n    - Tianze Chen\\\\n    - Yuansen Zhang\\\\n    - Rui Zheng\\\\n    - Junjie Ye\\\\n    - Qi Zhang\\\\n    - Tao Gui\\\\n    - Jihua Kang\\\\n    - Jingsheng Yang\\\\n    - Siyuan Li\\\\n    - Chunsai Du\\\\n    year: 2023\\\\n    venue: arXiv preprint\\\\n    url: https://arxiv.org/abs/2304.08085\\\\n    doi: ''\\\\n    bibtex_key: wang2023instructuie\\\\n    category: generative_ie\\\\n    role: foundation\\\\n    relevance: 'Unified instruction-tuned IE framework covering NER, RE, EE across 32 datasets. Demonstrates multi-task generative\\\\n      IE with instruction tuning, directly relevant as representative LLM-based unified IE system.'\\\\n    abstract: ''\\\\n    semantic_scholar_id: ''\\\\n    verified: true\\\\n    added_by: paper-agent:manual\\\\n    added_at: '2026-05-14T22:00:00.000Z'\\\\n\\\", \\\"total_chars\\\": 43664, \\\"truncated\\\": false}, \\\"error\\\": null, \\\"metadata\\\": {}}\"}"}]},"parent_tool_use_id":"toolu_01BVRyxqJN2EPHcPpCiYp6P1","session_id":"e5f10f0e-4112-4acf-bcc8-7fa2b85fb642","uuid":"67cb294f-69bf-4b7a-b3d8-3a5e30286f4a","timestamp":"2026-05-14T21:19:17.862Z"}
