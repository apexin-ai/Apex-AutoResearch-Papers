guage Models\\\\n    authors:\\\\n    - Zhiqiu Xia\\\\n    - Jinxuan Xu\\\\n    - Yuqian Zhang\\\\n    - Hang Liu\\\\n    year: 2025\\\\n    venue: ACL Findings 2025\\\\n    url: https://aclanthology.org/2025.findings-acl.1101/\\\\n    doi: ''\\\\n    bibtex_key: xia2025survey\\\\n    category: confidence_surveys\\\\n    role: supplementary\\\\n    relevance: 'Most comprehensive LLM uncertainty estimation survey with novel taxonomy (verbalizing, latent, consistency-based,\\\\n      semantic clustering). Directly contextualizes our method within the consistency-based branch. [SUPPLEMENTARY: overlaps\\\\n      with geng2024 main survey]'\\\\n    abstract: ''\\\\n    semantic_scholar_id: ''\\\\n    verified: true\\\\n    added_by: paper-research:lit_batch1\\\\n    added_at: '2026-05-14T17:52:10.000Z'\\\\n  liu2025uqcalibration:\\\\n    title: 'Uncertainty Quantification and Confidence Calibration in Large Language Models: A Survey'\\\\n    authors:\\\\n    - Xiaoou Liu\\\\n    - Tiejin Chen\\\\n    - Longchao Da\\\\n    - Chacha Chen\\\\n    - Zhen Lin\\\\n    - Hua Wei\\\\n    year: 2025\\\\n    venue: KDD 2025\\\\n    url: https://arxiv.org/abs/2503.15850\\\\n    doi: 10.1145/3711896.3736569\\\\n    bibtex_key: liu2025uqcalibration\\\\n    category: confidence_surveys\\\\n    role: supplementary\\\\n    relevance: 'Survey analyzing UQ through input, reasoning, parameter, and prediction uncertainty dimensions. Complements\\\\n      other surveys with focus on calibration techniques applicable to our structured IE setting. [SUPPLEMENTARY: overlaps\\\\n      with geng2024 main survey]'\\\\n    abstract: ''\\\\n    semantic_scholar_id: ''\\\\n    verified: true\\\\n    added_by: paper-research:lit_batch1\\\\n    added_at: '2026-05-14T17:52:10.000Z'\\\\n  kuhn2023semantic:\\\\n    title: 'Semantic Uncertainty: Linguistic Invariances for Uncertainty Estimation in Natural Language Generation'\\\\n    authors:\\\\n    - Lorenz Kuhn\\\\n    - Yarin Gal\\\\n    - Sebastian Far