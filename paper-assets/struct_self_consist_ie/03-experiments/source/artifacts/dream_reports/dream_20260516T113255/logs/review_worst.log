\\\n    role: Selection F1 data (right panel)\\\\n- id: fig:signal_heatmap\\\\n  section: experiments\\\\n  caption: Quality estimation heatmap (Spearman ρ) across five signals and four configurations\\\\n  evidence:\\\\n  - exp_id: exp_015_metrics_expansion\\\\n    role: Full set ρ values for SciERC NER/RE (Qwen, N=8)\\\\n  - exp_id: exp_002\\\\n    role: CoNLL Qwen full set ρ values\\\\n  - exp_id: exp_001_ner_n16_scierc\\\\n    role: Conditional set ρ values\\\\n- id: fig:selection_gap\\\\n  section: experiments\\\\n  caption: The correlation-selection gap on SciERC (N=8)\\\\n  evidence:\\\\n  - exp_id: exp_016_signal_ensemble\\\\n    role: Best-of-N selection F1 bars and quality estimation ρ line\\\\n- id: fig:temperature_robustness\\\\n  section: experiments\\\\n  caption: Temperature robustness on SciERC (N=8)\\\\n  evidence:\\\\n  - exp_id: exp_005\\\\n    role: SJ, FK ρ values at T=0.7 and T=1.0\\\\n- id: fig:reliability\\\\n  section: experiments\\\\n  caption: Reliability diagrams on SciERC (N=8, T=1.0)\\\\n  evidence:\\\\n  - exp_id: exp_015_metrics_expansion\\\\n    role: Calibration/ECE data for all signals\\\\n  - exp_id: exp_002\\\\n    role: ECE values across signals\\\\n_completeness:\\\\n  coverage: 58/68\\\\n  claims: 63\\\\n  tables: 4\\\\n  figures: 5\\\\n  tier_counts:\\\\n    tier1: 0\\\\n    tier2: 58\\\\n    tier3: 10\\\\n    tierX: 0\\\\n  last_checked: '2026-05-16T10:05:35.019798+00:00'\\\\n\\\", \\\"total_chars\\\": 27187, \\\"truncated\\\": false}, \\\"error\\\": null, \\\"metadata\\\": {}}\"}"}]},"parent_tool_use_id":"toolu_017WkXRNczfczKngFzyJwyzJ","session_id":"b72398d7-e431-4137-b17e-51fc8746e976","uuid":"bb8779c0-b175-4f8f-8ca9-9c82263c6de1","timestamp":"2026-05-16T12:13:21.955Z"}
