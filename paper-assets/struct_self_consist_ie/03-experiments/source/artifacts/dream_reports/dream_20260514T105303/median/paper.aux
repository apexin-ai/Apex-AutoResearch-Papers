\newlabel{tab:main-ner}{{1}{4}{Confidence signal comparison across three NER datasets ($N$=8, $T$=0.7 for consistency signals; Qwen3-8B). Bold marks the best signal per dataset-metric. \SJ {} is the best consistency-based signal on all datasets; \LP {} is competitive and wins on CoNLL-2003. The rightmost column reports bootstrap $p$-values for \SJ {} vs each signal on WNUT-17}{table.caption.15}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Multi-metric comparison on SciERC NER. \textsc  {SJ}{} wins on discrimination metrics ($\rho $, $\tau $, AUROC); \textsc  {LogProb}{} wins on calibration (ECE). LOO-\textsc  {SJ}{} shows minimal circularity impact ($\Delta \rho $=$-$0.014).}}{4}{table.caption.16}\protected@file@percent }
