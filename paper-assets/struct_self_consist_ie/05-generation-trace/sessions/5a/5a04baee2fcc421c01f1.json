es = extract_entities(instance[\\\\\\\"greedy\\\\\\\"])\\\\n            tp, fp, fn = entity_f1_counts(greedy_entities, gold_entities)\\\\n            greedy_tp += tp; greedy_fp += fp; greedy_fn += fn\\\\n\\\\n            samples = instance[\\\\\\\"samples\\\n…[truncated 658 chars]"
