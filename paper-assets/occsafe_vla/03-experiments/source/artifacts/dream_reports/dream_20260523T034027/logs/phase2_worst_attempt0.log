ity: P1\n    gpu_budget_hours: 13\n    deps: [\"plan_017\"]\n\n  # === P0 Analysis: Gradient-Level Evidence (Reviewer R3 Response) ===\n\n  - id: plan_023\n    claim: \"C1\"\n    description: \"Gradient norm + cosine analysis: 1-epoch forward+backward pass on existing 50K checkpoints for Full OCC/Detach/Vanilla/Random. Record per-layer gradient norms and cosine similarity between action and aux head gradients. Directly tests Hypothesis 3 (gradient diversity). Uses existing checkpoints, no training needed.\"\n    priority: P0\n    gpu_budget_hours: 2\n    deps: []\n\n  - id: plan_024\n    claim: \"C1\"\n    description: \"CKA representation analysis: compare encoder intermediate layer representations across Full OCC/Detach/Vanilla/Random at 50K checkpoint. Tests Hypothesis 1 (feature preservation). Uses existing checkpoints, no training needed.\"\n    priority: P0\n    gpu_budget_hours: 1\n    deps: []\n\n  # === P1 Training: Temporal Dynamics + Mechanism Discrimination ===\n\n  - id: plan_025\n    claim: \"C1\"\n    description: \"Reverse cutoff: start WITHOUT occ_loss, enable at step 35K — tests whether late-stage gradient flow alone provides protection. Combined with cutoff@35K creates 2×2 design: {early, late, both, neither}.\"\n    priority: P1\n    gpu_budget_hours: 13\n    deps: [\"plan_017\"]\n\n  - id: plan_026\n    claim: \"C1\"\n    description: \"Multi-cutoff cutoff@25K — at least 1 extra point to show temporal dose-response trend\"\n    priority: P1\n    gpu_budget_hours: 13\n    deps: [\"plan_017\"]\n\n  - id: plan_027\n    claim: \"C1\"\n    description: \"Detach + LayerNorm OccHead: replace BatchNorm2d with LayerNorm in OccHead under detach mode. Tests whether Detach harm is from gradient flow absence or BatchNorm running stats artifact. If still hurts → gradient flow is the cause. If doesn't hurt → BatchNorm artifact.\"\n    priority: P1\n    gpu_budget_hours: 13\n    deps: [\"plan_007\"]\n\n  # === P2 Generalizability ===\n\n  - id: plan_028\n    cl