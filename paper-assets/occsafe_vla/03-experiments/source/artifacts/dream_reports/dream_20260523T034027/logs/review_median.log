{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016r1rQNMaRn2fDVe6uMoyk3","type":"tool_result","content":"1\t# experiment_plan.yaml — occsafe_vla\n2\t# Director 维护 | 最后更新: 2026-05-23\n3\t# paper_framing.md Claims:\n4\t#   C1: Gradient flow is necessary to prevent auxiliary head harm\n5\t#   C2: 6-condition factorial study methodology\n6\t#   C3: Practical guidance — keep gradient flow when adding auxiliary heads\n7\t\n8\texperiments:\n9\t  # === C1 Core Evidence: Gradient Flow Conditions ===\n10\t\n11\t  - id: plan_001\n12\t    claim: \"C1\"\n13\t    description: \"Full OCC 3-seed (BEV occupancy with gradient flow)\"\n14\t    priority: P0\n15\t    registry_id: \"mvp_occ_s0\"\n16\t    gpu_budget_hours: 13\n17\t    deps: []\n18\t\n19\t  - id: plan_002\n20\t    claim: \"C1\"\n21\t    description: \"Full OCC 3-seed — seed 43\"\n22\t    priority: P0\n23\t    registry_id: \"occ_s1_fresh\"\n24\t    gpu_budget_hours: 13\n25\t    deps: []\n26\t\n27\t  - id: plan_003\n28\t    claim: \"C1\"\n29\t    description: \"Full OCC 3-seed — seed 44\"\n30\t    priority: P0\n31\t    registry_id: \"mvp_occ_s2\"\n32\t    gpu_budget_hours: 13\n33\t    deps: []\n34\t\n35\t  # === C1 Core Evidence: Vanilla Baseline ===\n36\t\n37\t  - id: plan_004\n38\t    claim: \"C1\"\n39\t    description: \"Vanilla baseline 3-seed (no auxiliary head)\"\n40\t    priority: P0\n41\t    registry_id: \"mvp_vanilla_s0\"\n42\t    gpu_budget_hours: 13\n43\t    deps: []\n44\t\n45\t  - id: plan_005\n46\t    claim: \"C1\"\n47\t    description: \"Vanilla baseline — seed 43\"\n48\t    priority: P0\n49\t    registry_id: \"mvp_vanilla_s1\"\n50\t    gpu_budget_hours: 13\n51\t    deps: []\n52\t\n53\t  - id: plan_006\n54\t    claim: \"C1\"\n55\t    description: \"Vanilla baseline — seed 44\"\n56\t    priority: P0\n57\t    registry_id: \"mvp_vanilla_s2\"\n58\t    gpu_budget_hours: 13\n59\t    deps: []\n60\t\n61\t  # === C1 Core Evidence: Detach (Gradient Flow Necessity Proof) ===\n62\t\n63\t  - id: pl