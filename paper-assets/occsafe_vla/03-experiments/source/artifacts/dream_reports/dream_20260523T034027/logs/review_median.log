_015\n132\t    claim: \"C1\"\n133\t    description: \"Depth — seed 44\"\n134\t    priority: P0\n135\t    registry_id: \"depth_s2\"\n136\t    gpu_budget_hours: 13\n137\t    deps: []\n138\t\n139\t  - id: plan_016\n140\t    claim: \"C1\"\n141\t    description: \"Depth — seed 45\"\n142\t    priority: P0\n143\t    registry_id: \"depth_s3\"\n144\t    gpu_budget_hours: 13\n145\t    deps: []\n146\t\n147\t  # === C1 Supporting: Cutoff (Temporal Dynamics) ===\n148\t\n149\t  - id: plan_017\n150\t    claim: \"C1\"\n151\t    description: \"Cutoff 3-seed (OCC loss cutoff@35K, temporal dynamics)\"\n152\t    priority: P0\n153\t    registry_id: \"cutoff_s0\"\n154\t    gpu_budget_hours: 13\n155\t    deps: []\n156\t\n157\t  - id: plan_018\n158\t    claim: \"C1\"\n159\t    description: \"Cutoff — seed 43\"\n160\t    priority: P0\n161\t    registry_id: \"cutoff_s1\"\n162\t    gpu_budget_hours: 13\n163\t    deps: []\n164\t\n165\t  - id: plan_019\n166\t    claim: \"C1\"\n167\t    description: \"Cutoff — seed 44 (3rd seed for statistical consistency)\"\n168\t    priority: P0\n169\t    registry_id: \"cutoff_s2\"\n170\t    gpu_budget_hours: 13\n171\t    deps: []\n172\t\n173\t  # === Research Phase: Strengthening Experiments ===\n174\t\n175\t  - id: plan_020\n176\t    claim: \"C1\"\n177\t    description: \"Multi-cutoff dose-response: cutoff@15K — tests minimum gradient flow duration needed for protection\"\n178\t    priority: P1\n179\t    gpu_budget_hours: 13\n180\t    deps: [\"plan_017\"]\n181\t\n182\t  - id: plan_021\n183\t    claim: \"C1\"\n184\t    description: \"Multi-cutoff dose-response: cutoff@25K — intermediate cutoff point\"\n185\t    priority: P1\n186\t    gpu_budget_hours: 13\n187\t    deps: [\"plan_017\"]\n188\t\n189\t  - id: plan_022\n190\t    claim: \"C1\"\n191\t    description: \"Multi-cutoff dose-response: cutoff@45K — near-full training cutoff\"\n192\t    priority: P1\n193\t    gpu_budget_hours: 13\n194\t    deps: [\"plan_017\"]\n195\t\n196\t  # === P0 Analysis: Gradient-Level Evidence (Reviewer R3 Response) ===\n197\t\n198\t  - id: plan_023\n199\t    claim: \"C1\"\n200\t    description: \"Gradient norm + cosine analysis: 1-epoch forward+backward pass on existing 50K checkpoints for Full OCC/Detach/Vanilla/Random. Record per-layer gradient norms and cosine similarity between action and aux head gradients. Directly tests Hypothesis 3 (gradient diversity). Uses existing checkpoints, no training needed.\"\n201\t    priority: P0\n202\t    gpu_budget_hours: 2\n203\t    deps: []\n204\t\n205\t  - id: plan_024\n206\t    claim: \"C1\"\n207\t    description: \"CKA representation analysis: compare encoder intermediate layer representations across Full OCC/Detach/Vanilla/Random at 50K checkpoint. Tests Hypothesis 1 (feature preservation). Uses existing checkpoints, no training needed.\"\n208\t    priority: P0\n209\t    gpu_budget_hours: 1\n210\t    deps: []\n211\t\n212\t  # === P1 Training: Temporal Dynamics + Mechanism Discrimination ===\n213\t\n214\t  - id: plan_025\n215\t    claim: \"C1\"\n216\t    description: \"Reverse cutoff: start WITHOUT occ_loss, enable at step 35K — tests whether late-stage gradient flow alone provides protection. Combined with cutoff@35K creates 2×2 design: {early, late, both, neither}.\"\n217\t    priority: P1\n218\t    gpu_budget_hours: 13\n219\t    deps: [\"plan_017\"]\n220\t\n221\t  - id: plan_026\n222\t    claim: \"C1\"\n223\t    description: \"Multi-cutoff cutoff@25K — at least 1 extra point to show temporal dose-response trend\"\n224\t    priority: P1\n225\t    gpu_budget_hours: 13\n226\t    deps: [\"plan_017\"]\n227\t\n228\t  - id: plan_027\n229\t    claim: \"C1\"\n230\t    description: \"Detach + LayerNorm OccHead: replace BatchNorm2d with LayerNorm in OccHead under detach mode. Tests whether Detach harm is from gradient flow absence or BatchNorm running stats artifact. If still hurts → gradient flow is the cause. If doesn't hurt → BatchNorm artifact.\"\n231\t    priority: P1\n232\t    gpu_budget_hours: 13\n233\t    deps: [\"plan_007\"]\n234\t\n235\t  # === P2 Generalizability ===\n236\t\n237\t  - id: plan_028\n238\t    claim: \"C1\"\n239\t    description: \"Second benchmark: SafeLIBERO LIBERO-Object or LIBERO-Goal to test generalizability beyond LIBERO-Spatial\"\n240\t    priority: P2\n241\t    gpu_budget_hours: 78\n242\t    deps: []\n243\t\n244\t  - id: plan_029\n245\t    claim: \"C1\"\n246\t    description: \"Multi-cutoff cutoff@15K — minimum gradient flow duration needed\"\n247\t    priority: P2\n248\t    gpu_budget_hours: 13\n249\t    deps: [\"plan_017\"]\n250\t\n251\t  - id: plan_030\n252\t    claim: \"C1\"\n253\t    description: \"Multi-cutoff cutoff@45K — near-full training\"\n254\t    priority: P2\n255\t    gpu_budget_hours: 13\n256\t    deps: [\"plan_017\"]\n257\t"}]},"parent_tool_use_id":"toolu_01BLa5NK7aRBL7Mn9B28a4cv","session_id":"d0b8a538-408e-485b-8d42-e69bd1c2f218","uuid":"60074331-c2c4-478e-ac5e-8b6279a344eb","timestamp":"2026-05-23T04:37:46.520Z"}
