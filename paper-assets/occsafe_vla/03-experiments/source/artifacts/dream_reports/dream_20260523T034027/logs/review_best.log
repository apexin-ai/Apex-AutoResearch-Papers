periment_setup\\\\n    paragraph: 0\\\\n    sentence: 0\\\\n  text: 50 rollouts per task yields per-task CI of approximately ±13pp\\\\n  type: statistical\\\\n  evidence:\\\\n  - 'paper_framing.md: 50r CI ~±13pp vs 20r ~±21pp'\\\\n  decisions: []\\\\n  deprecated: false\\\\n- id: C249\\\\n  location:\\\\n    section: experiment_setup\\\\n    paragraph: 0\\\\n    sentence: 0\\\\n  text: 'Training configuration: LoRA rank 32, alpha 16, batch 8, lr 5e-4, 50005 steps'\\\\n  type: experimental\\\\n  evidence:\\\\n  - paper_framing.md Architecture Facts\\\\n  - memory.md Training Configuration\\\\n  decisions: []\\\\n  deprecated: false\\\\ntables: []\\\\nfigures: []\\\\n_completeness:\\\\n  coverage: 16/17\\\\n  claims: 17\\\\n  tables: 0\\\\n  figures: 0\\\\n  tier_counts:\\\\n    tier1: 0\\\\n    tier2: 16\\\\n    tier3: 1\\\\n    tierX: 0\\\\n  last_checked: '2026-05-22T13:28:28.464530+00:00'\\\\n\\\", \\\"total_chars\\\": 17551, \\\"truncated\\\": false}, \\\"error\\\": null, \\\"metadata\\\": {}}\"}"}]},"parent_tool_use_id":"toolu_01Tiuv7BknzVCPhTpc13ZXwG","session_id":"6fd64fbd-040e-43dd-8257-d68950227536","uuid":"6d77230d-eb9e-47c6-b380-6f4c302d243c","timestamp":"2026-05-23T04:29:04.854Z"}
