\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces BatchNorm vs.\ LayerNorm in the detached auxiliary head. Replacing BN with LN eliminates 100\% of the Detach degradation, confirming the BN artifact as the sole cause.}}{4}{table.caption.6}\protected@file@percent }
