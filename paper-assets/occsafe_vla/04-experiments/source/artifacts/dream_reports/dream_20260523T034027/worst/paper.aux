\@writefile{toc}{\contentsline {subsection}{\numberline {4.5}Dose-Response: Gradient Flow Duration}{6}{subsection.4.5}\protected@file@percent }
\newlabel{sec:doseresponse}{{4.5}{6}{Dose-Response: Gradient Flow Duration}{subsection.4.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces Dose-response analysis: CAR as a function of gradient flow duration. The non-monotonic pattern (lowest CAR at intermediate cutoff points) contradicts a gradient flow hypothesis but matches the BatchNorm mismatch prediction. All cutoff conditions except @35K are single-seed.}}{6}{table.caption.13}\protected@file@percent }
\newlabel{tab:dose}{{8}{6}{Dose-response analysis: CAR as a function of gradient flow duration. The non-monotonic pattern (lowest CAR at intermediate cutoff points) contradicts a gradient flow hypothesis but matches the BatchNorm mismatch prediction. All cutoff conditions except @35K are single-seed}{table.caption.13}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.6}Temporal 2$\times $2 Design: Early vs.\ Late Gradient Flow}{6}{subsection.4.6}\protected@file@percent }
\newlabel{sec:temporal}{{4.6}{6}{Temporal 2$\times $2 Design: Early vs.\ Late Gradient Flow}{subsection.4.6}{}}
\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces 2$\times $2 temporal design. Reverse Cutoff $\approx $ Vanilla, and only early-stopping (Cutoff@35K) causes harm---consistent with BN mismatch, not gradient flow timing. Cutoff@35K uses 3 seeds; Reverse Cutoff uses 1 seed.}}{7}{table.caption.14}\protected@file@percent }
\newlabel{tab:temporal}{{9}{7}{2$\times $2 temporal design. Reverse Cutoff $\approx $ Vanilla, and only early-stopping (Cutoff@35K) causes harm---consistent with BN mismatch, not gradient flow timing. Cutoff@35K uses 3 seeds; Reverse Cutoff uses 1 seed}{table.caption.14}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.7}Cutoff@35K Seed Instability}{7}{subsection.4.7}\protected@file@percent }
\newlabel{sec:cutoff_instability}{{4.7}{7}{Cutoff@35K Seed Instability}{subsection.4.7}{}}
\@writefile{lot}{\contentsline {table}{\numberline {10}{\ignorespaces Cutoff@35K per-seed results. Seed 44 shows partial collapse with dramatically lower TSR and CAR, consistent with the BN distribution shift amplifying stochastic instabilities.}}{7}{table.caption.15}\protected@file@percent }
\newlabel{tab:cutoff_seeds}{{10}{7}{Cutoff@35K per-seed results. Seed 44 shows partial collapse with dramatically lower TSR and CAR, consistent with the BN distribution shift amplifying stochastic instabilities}{table.caption.15}{}}
\@writefile{lot}{\contentsline {table}{\numberline {11}{\ignorespaces Cutoff@35K seed 44 per-task collapse. The pattern mirrors Detach+BN failures, suggesting a shared BN artifact mechanism.}}{7}{table.caption.16}\protected@file@percent }
\newlabel{tab:cutoff_pertask}{{11}{7}{Cutoff@35K seed 44 per-task collapse. The pattern mirrors Detach+BN failures, suggesting a shared BN artifact mechanism}{table.caption.16}{}}
