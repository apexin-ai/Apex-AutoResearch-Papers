\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Gradient analysis on shared encoder layers at 50K checkpoint. Action and OCC gradients are nearly orthogonal ($\cos \approx 0$), and the OCC gradient norm is less than half the action gradient norm.}}{5}{table.caption.11}\protected@file@percent }
