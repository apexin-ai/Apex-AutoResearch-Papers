\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Per-layer gradient analysis decomposed into amplitude and direction (v1 codebase checkpoint, seed 42, 200 batches). \textbf  {Top (a--b):} Action gradient norm heatmap (log scale). Gradient-flow conditions (Vanilla, Full OCC, Random OCC) maintain comparable norms; Detach shows substantially reduced norms across all layers, a v1-specific artifact not reproduced under v2 (see Appendix~\ref {app:codebase}). \textbf  {Bottom (c--d):} Gradient conflict rate between action and auxiliary losses. DINOv2 maintains $\sim $46\% conflict (near-orthogonal), while SigLIP late layers drop to 19--25\% (cooperative alignment). Both amplitude and directional patterns are identical for Full OCC and Random OCC, confirming architectural rather than label-dependent structure. Directional findings are confirmed under v2; the Detach amplitude suppression (a--b) is a v1 code-path artifact. Conflict rates approach ${\approx }$46\% in early and middle layers; late SigLIP layers show lower conflict rates (${\approx }$25\%), consistent with weak alignment rather than conflict.}}{15}{figure.caption.11}\protected@file@percent }
\newlabel{fig:per_layer_combined}{{4}{15}{Per-layer gradient analysis decomposed into amplitude and direction (v1 codebase checkpoint, seed 42, 200 batches). \textbf {Top (a--b):} Action gradient norm heatmap (log scale). Gradient-flow conditions (Vanilla, Full OCC, Random OCC) maintain comparable norms; Detach shows substantially reduced norms across all layers, a v1-specific artifact not reproduced under v2 (see Appendix~\ref {app:codebase}). \textbf {Bottom (c--d):} Gradient conflict rate between action and auxiliary losses. DINOv2 maintains $\sim $46\% conflict (near-orthogonal), while SigLIP late layers drop to 19--25\% (cooperative alignment). Both amplitude and directional patterns are identical for Full OCC and Random OCC, confirming architectural rather than label-dependent structure. Directional findings are confirmed under v2; the Detach amplitude suppression (a--b) is a v1 code-path artifact. Conflict rates approach ${\approx }$46\% in early and middle layers; late SigLIP layers show lower conflict rates (${\approx }$25\%), consistent with weak alignment rather than conflict}{figure.caption.11}{}}
