            "tool_args": {
              "server": "westd-33183",
              "command": "source /root/miniconda3/etc/profile.d/conda.sh && conda activate base && python3 -c \"\nfrom scipy.stats import levene\nimport numpy as np\n\n# Per-seed F1 from round7_seed_level_stats.json\n# DD OOD Full\nnine_class_dd = [1.0, 1.0, 0.990362]\nvanilla_dd = [0.2845, 0.3048, 0.3477]\n\n# AA (ActorAttack) Full\nnine_class_aa = [0.990362, 0.934956, 0.990362]\nvanilla_aa = [0.257507, 0.257507, 0.257507]\n\nprint('='*60)\nprint('Levene Test: 9-class vs Vanilla F1 Variance')\nprint('='*60)\n\n# DD OOD\nprint('\\n--- DD OOD (Deceptive Delight) ---')\nprint(f'9-class seeds: {nine_class_dd}')\nprint(f'  mean={np.mean(nine_class_dd):.6f}, std={np.std(nine_class_dd, ddof=1):.6f}')\nprint(f'Vanilla seeds: {vanilla_dd}')\nprint(f'  mean={np.mean(vanilla_dd):.6f}, std={np.std(vanilla_dd, ddof=1):.6f}')\nstat_dd, p_dd = levene(nine_class_dd, vanilla_dd)\nprint(f'Levene statistic: {stat_dd:.6f}')\nprint(f'p-value: {p_dd:.6f}')\n\n# AA\nprint('\\n--- AA (ActorAttack) ---')\nprint(f'9-class seeds: {nine_class_aa}')\nprint(f'  mean={np.mean(nine_class_aa):.6f}, std={np.std(nine_class_aa, ddof=1):.6f}')\nprint(f'Vanilla seeds: {vanilla_aa}')\nprint(f'  mean={np.mean(vanilla_aa):.6f}, std={np.std(vanilla_aa, ddof=1):.6f}')\n\n# Check if vanilla_aa has zero variance\nif np.std(vanilla_aa) == 0:\n    print('WARNING: Vanilla AA has zero variance (all values identical)')\n    print('Levene test is degenerate when one group has zero variance.')\n    # Still run it\n    try:\n        stat_aa, p_aa = levene(nine_class_aa, vanilla_aa)\n        print(f'Levene statistic: {stat_aa:.6f}')\n        print(f'p-value: {p_aa:.6f}')\n    except Exception as e:\n        print(f'Error: {e}')\nelse:\n    stat_aa, p_aa = levene(nine_class_aa, vanilla_aa)\n    print(f'Levene statistic: {stat_aa:.6f}')\n    print(f'p-value: {p_aa:.6f}')\n\n# Power analysis note\nprint('\\n--- Statistical Power Note ---')\nprint('n=3 per group -> df1=1, df2=4')\nprint('For Levene test with n=3, power is extremely low.')\nprint('Even large variance ratios may not reach significance.')\nprint('Rule of thumb: need n>=20-30 per group for adequate power (~0.80)')\n\n# Variance ratio for descriptive purposes\nvar_9c_dd = np.var(nine_class_dd, ddof=1)\nvar_v_dd = np.var(vanilla_dd, ddof=1)\nvar_9c_aa = np.var(nine_class_aa, ddof=1)\nvar_v_aa = np.var(vanilla_aa, ddof=1)\n\nprint('\\n--- Descriptive Variance Comparison ---')\nprint(f'DD: 9-class var={var_9c_dd:.8f}, Vanilla var={var_v_dd:.8f}')\nif var_v_dd > 0:\n    print(f'  Ratio (Vanilla/9-class): {var_v_dd/var_9c_dd:.2f}')\nprint(f'AA: 9-class var={var_9c_aa:.8f}, Vanilla var={var_v_aa:.8f}')\nif var_9c_aa > 0 and var_v_aa > 0:\n    print(f'  Ratio: {max(var_9c_aa, var_v_aa)/min(var_9c_aa, var_v_aa):.2f}')\nelif var_v_aa == 0:\n    print(f'  Vanilla variance is 0 (degenerate)')\n\"\n",
