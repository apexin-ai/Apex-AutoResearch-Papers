\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces TF-IDF + Logistic Regression performance. The lexical baseline achieves near-perfect detection across data sources, confirming inherent lexical separability between jailbreak and benign conversations. DisPeD{}'s value lies in dimensions where bag-of-words methods cannot follow: perturbation robustness and interpretability.}}{5}{table.1}\protected@file@percent }
\newlabel{tab:tfidf}{{1}{5}{TF-IDF + Logistic Regression performance. The lexical baseline achieves near-perfect detection across data sources, confirming inherent lexical separability between jailbreak and benign conversations. \ours {}'s value lies in dimensions where bag-of-words methods cannot follow: perturbation robustness and interpretability}{table.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces IID detection performance (3-seed mean). DisPeD{} treatment shows zero variance across seeds; Baseline K=1 variance is $\pm $0.033. All methods converge at $K \geq 3$, confirming IID is a sanity check, not a differentiating evaluation.}}{5}{table.2}\protected@file@percent }
\newlabel{tab:iid}{{2}{5}{IID detection performance (3-seed mean). \ours {} treatment shows zero variance across seeds; Baseline K=1 variance is $\pm $0.033. All methods converge at $K \geq 3$, confirming IID is a sanity check, not a differentiating evaluation}{table.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.3}Evaluation Protocol}{5}{subsection.4.3}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {5}Results}{5}{section.5}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {5.1}Lexical Baseline and IID Performance}{5}{subsection.5.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {5.2}Cross-Attack Zero-Shot Generalization}{5}{subsection.5.2}\protected@file@percent }
\newlabel{sec:cross_attack}{{5.2}{5}{Cross-Attack Zero-Shot Generalization}{subsection.5.2}{}}
\citation{gururangan2018annotation}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Cross-attack zero-shot generalization. Models trained on Crescendo, evaluated on Deceptive Delight (DD) and FITD without retraining. The vanilla baseline collapses on DD (F1=0.28) while DisPeD{} maintains F1=1.0 (+72pp). FITD shows saturation for all methods, limiting generalization claims to attack types sufficiently different from training data.}}{6}{table.3}\protected@file@percent }
\newlabel{tab:cross}{{3}{6}{Cross-attack zero-shot generalization. Models trained on Crescendo, evaluated on Deceptive Delight (DD) and FITD without retraining. The vanilla baseline collapses on DD (F1=0.28) while \ours {} maintains F1=1.0 (+72pp). FITD shows saturation for all methods, limiting generalization claims to attack types sufficiently different from training data}{table.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Ablation on label quality. Scrambled labels reduce DeBERTa persuasion accuracy from 79.6\% to 64.4\% (near chance for 9 classes) but downstream detection drops only 1.3pp IID and 6.5pp OOD. Binary persuasion-presence labels match the full 9-class model within 1pp. Both far exceed the vanilla baseline, confirming that persuasion-domain fine-tuning, not label precision, drives cross-attack robustness.}}{6}{table.4}\protected@file@percent }
\newlabel{tab:ablation_labels}{{4}{6}{Ablation on label quality. Scrambled labels reduce DeBERTa persuasion accuracy from 79.6\% to 64.4\% (near chance for 9 classes) but downstream detection drops only 1.3pp IID and 6.5pp OOD. Binary persuasion-presence labels match the full 9-class model within 1pp. Both far exceed the vanilla baseline, confirming that persuasion-domain fine-tuning, not label precision, drives cross-attack robustness}{table.4}{}}
