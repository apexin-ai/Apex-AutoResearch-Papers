\citation{nasr2025adaptive}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Robustness under adversarial perturbation (synonym substitution, restructuring, register shifting; BERTScore=0.92, lexical overlap=0.20). At full conversation, DisPeD{} shows zero degradation while the baseline drops 11.8pp. The TF-IDF gap is small at full conversation (1.3pp) but widens at K=1 early detection: DisPeD{} loses 2.6pp vs.\ 9.6pp for TF-IDF, a 7pp advantage.}}{7}{table.5}\protected@file@percent }
\newlabel{tab:perturbation}{{5}{7}{Robustness under adversarial perturbation (synonym substitution, restructuring, register shifting; BERTScore=0.92, lexical overlap=0.20). At full conversation, \ours {} shows zero degradation while the baseline drops 11.8pp. The TF-IDF gap is small at full conversation (1.3pp) but widens at K=1 early detection: \ours {} loses 2.6pp vs.\ 9.6pp for TF-IDF, a 7pp advantage}{table.5}{}}
\@writefile{toc}{\contentsline {paragraph}{Checkpoint sensitivity.}{7}{section*.13}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {5.4}Adversarial Perturbation Robustness}{7}{subsection.5.4}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {5.5}Persuasion Strategy Trajectory Analysis}{7}{subsection.5.5}\protected@file@percent }
\newlabel{sec:trajectories}{{5.5}{7}{Persuasion Strategy Trajectory Analysis}{subsection.5.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Strategy trajectory statistics. Crescendo exhibits monotonic escalation (mean strategy index 0.86$\to $5.64) with high slope (0.68) across all 8 strategy types. Benign conversations lack structured escalation (slope 0.12). FITD uses fewer strategies (4) reflecting its simpler escalation pattern.}}{8}{table.6}\protected@file@percent }
\newlabel{tab:trajectories}{{6}{8}{Strategy trajectory statistics. Crescendo exhibits monotonic escalation (mean strategy index 0.86$\to $5.64) with high slope (0.68) across all 8 strategy types. Benign conversations lack structured escalation (slope 0.12). FITD uses fewer strategies (4) reflecting its simpler escalation pattern}{table.6}{}}
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces False positive rate on WildChat hard negatives (high-drift benign conversations). DisPeD{} achieves lower FPR than the vanilla baseline but higher than TF-IDF. Some false positives arise from benign conversations with persuasion-like pragmatic patterns (persistent requests, escalating emotional language).}}{8}{table.7}\protected@file@percent }
\newlabel{tab:wildchat}{{7}{8}{False positive rate on WildChat hard negatives (high-drift benign conversations). \ours {} achieves lower FPR than the vanilla baseline but higher than TF-IDF. Some false positives arise from benign conversations with persuasion-like pragmatic patterns (persistent requests, escalating emotional language)}{table.7}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.6}False Positive Analysis}{8}{subsection.5.6}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {5.7}DeepContext Proxy and LLM-as-Judge}{8}{subsection.5.7}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces DeepContext proxy comparison. BERT and DeBERTa vanilla encoders both collapse on OOD DD data (F1=0.26--0.28), confirming the gap is due to absence of persuasion fine-tuning, not encoder architecture. We could not reproduce DeepContext (no public code) and report a controlled proxy.}}{9}{table.8}\protected@file@percent }
\newlabel{tab:deepcontext}{{8}{9}{DeepContext proxy comparison. BERT and DeBERTa vanilla encoders both collapse on OOD DD data (F1=0.26--0.28), confirming the gap is due to absence of persuasion fine-tuning, not encoder architecture. We could not reproduce DeepContext (no public code) and report a controlled proxy}{table.8}{}}
\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces LLM-as-judge zero-shot jailbreak detection. GPT-5.5 achieves perfect precision but very low recall ($\leq $29\%), with unparseable response rates of 30--47\%. Even under a charitable correction assuming all unparseable responses would have been correct, estimated F1 reaches 0.7--0.8, still well below DisPeD{} (F1=1.0). Single zero-shot prompt; chain-of-thought or few-shot prompting was not tested.}}{9}{table.9}\protected@file@percent }
\newlabel{tab:llm_judge}{{9}{9}{LLM-as-judge zero-shot jailbreak detection. GPT-5.5 achieves perfect precision but very low recall ($\leq $29\%), with unparseable response rates of 30--47\%. Even under a charitable correction assuming all unparseable responses would have been correct, estimated F1 reaches 0.7--0.8, still well below \ours {} (F1=1.0). Single zero-shot prompt; chain-of-thought or few-shot prompting was not tested}{table.9}{}}
