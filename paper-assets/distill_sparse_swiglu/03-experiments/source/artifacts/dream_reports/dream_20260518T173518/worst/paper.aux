\@writefile{toc}{\contentsline {subsection}{\numberline {4.5}Long-Context Evaluation}{6}{subsection.4.5}\protected@file@percent }
\newlabel{sec:longbench}{{4.5}{6}{Long-Context Evaluation}{subsection.4.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces LongBench English subset results by task category. KL 30\% retains 61\% of dense performance (overall 14.0 vs.\ 23.0). The KL vs.\ BCE+comp gap is compressed to 1.1 points (14.0 vs.\ 12.9) in the long-context setting, compared to larger gaps at standard context length. Summarization is the best-preserved category ($-$20\% vs.\ dense), while single-document QA degrades most ($-$46\%).}}{6}{table.caption.21}\protected@file@percent }
\newlabel{tab:longbench}{{5}{6}{LongBench English subset results by task category. KL 30\% retains 61\% of dense performance (overall 14.0 vs.\ 23.0). The KL vs.\ BCE+comp gap is compressed to 1.1 points (14.0 vs.\ 12.9) in the long-context setting, compared to larger gaps at standard context length. Summarization is the best-preserved category ($-$20\% vs.\ dense), while single-document QA degrades most ($-$46\%)}{table.caption.21}{}}
