\@writefile{toc}{\contentsline {section}{\numberline {A}MT-Bench Evaluation}{8}{appendix.A}\protected@file@percent }
\newlabel{app:mtbench}{{A}{8}{MT-Bench Evaluation}{appendix.A}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces MT-Bench scores (GPT-4o judge). Dense baseline 3.8 is near the quality floor for base models. All sparsity conditions fall within 1.5--4.0, with differences likely within scoring noise. KL 30\% vs.\ BCE+comp 30\% gap is only 0.2 points. Math is the worst-affected category (KL 30\% = 1.2, $-$40\% vs.\ dense 2.0). These results have low discriminative power due to the base model limitation.}}{8}{table.caption.26}\protected@file@percent }
\newlabel{tab:mtbench}{{6}{8}{MT-Bench scores (GPT-4o judge). Dense baseline 3.8 is near the quality floor for base models. All sparsity conditions fall within 1.5--4.0, with differences likely within scoring noise. KL 30\% vs.\ BCE+comp 30\% gap is only 0.2 points. Math is the worst-affected category (KL 30\% = 1.2, $-$40\% vs.\ dense 2.0). These results have low discriminative power due to the base model limitation}{table.caption.26}{}}
\@writefile{toc}{\contentsline {section}{\numberline {B}RULER Long-Context Evaluation}{8}{appendix.B}\protected@file@percent }
\newlabel{app:ruler}{{B}{8}{RULER Long-Context Evaluation}{appendix.B}{}}
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces RULER evaluation at 4K and 16K context lengths. KL 30\% retention drops from 80\% (4K) to 55\% (16K). Variable Tracking is the most affected task type, requiring cross-token state maintenance that sparse FFN disrupts. KL 50\% at 16K (15.0 average) approaches random performance.}}{8}{table.caption.27}\protected@file@percent }
\newlabel{tab:ruler}{{7}{8}{RULER evaluation at 4K and 16K context lengths. KL 30\% retention drops from 80\% (4K) to 55\% (16K). Variable Tracking is the most affected task type, requiring cross-token state maintenance that sparse FFN disrupts. KL 50\% at 16K (15.0 average) approaches random performance}{table.caption.27}{}}
