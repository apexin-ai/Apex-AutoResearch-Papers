\@writefile{toc}{\contentsline {subsection}{\numberline {4.2}Operating Point Comparison at 30\% Sparsity}{4}{subsection.4.2}\protected@file@percent }
\newlabel{sec:main-results}{{4.2}{4}{Operating Point Comparison at 30\% Sparsity}{subsection.4.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Recommended operating point comparison at 30\% uniform sparsity on Llama-3.1-8B. PPL = WikiText-2 perplexity. Comp. = requires compensation network. BCE 30\% achieves PPL 9.15, closing the gap with KL to $\Delta $=0.33. Downstream gaps are larger: ARC-c $-$4.2pp, WinoGrande $-$2.4pp, MMLU $-$0.7pp.}}{4}{table.caption.14}\protected@file@percent }
\newlabel{tab:operating-point}{{2}{4}{Recommended operating point comparison at 30\% uniform sparsity on Llama-3.1-8B. PPL = WikiText-2 perplexity. Comp. = requires compensation network. BCE 30\% achieves PPL 9.15, closing the gap with KL to $\Delta $=0.33. Downstream gaps are larger: ARC-c $-$4.2pp, WinoGrande $-$2.4pp, MMLU $-$0.7pp}{table.caption.14}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.3}Causal Ablation: Gradient Coupling vs.\ Mask Quality}{5}{subsection.4.3}\protected@file@percent }
\newlabel{sec:c1-ablation}{{4.3}{5}{Causal Ablation: Gradient Coupling vs.\ Mask Quality}{subsection.4.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Causal ablation of gradient coupling vs.\ mask quality across three seeds. BCE+KL-t = BCE trained on KL-derived oracle masks, evaluated under TEAL 50\% uniform protocol. Oracle Agree. = mask agreement between BCE+KL-targets and original KL predictor. The PPL gap ($\Delta $) is seed-dependent: 0.00 for s42 (exact match), 0.85 for s123, 0.60 for s456. Gradient coupling contributes 0\%--18\% depending on seed; target mask quality is the dominant driver (82\%--100\%).}}{5}{table.caption.15}\protected@file@percent }
\newlabel{tab:c1-ablation}{{3}{5}{Causal ablation of gradient coupling vs.\ mask quality across three seeds. BCE+KL-t = BCE trained on KL-derived oracle masks, evaluated under TEAL 50\% uniform protocol. Oracle Agree. = mask agreement between BCE+KL-targets and original KL predictor. The PPL gap ($\Delta $) is seed-dependent: 0.00 for s42 (exact match), 0.85 for s123, 0.60 for s456. Gradient coupling contributes 0\%--18\% depending on seed; target mask quality is the dominant driver (82\%--100\%)}{table.caption.15}{}}
\@writefile{toc}{\contentsline {paragraph}{Interpretation.}{5}{section*.16}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.4}Sparsity Regime Analysis}{5}{subsection.4.4}\protected@file@percent }
\newlabel{sec:regime}{{4.4}{5}{Sparsity Regime Analysis}{subsection.4.4}{}}
\@writefile{toc}{\contentsline {paragraph}{Non-monotonic PPL behavior.}{5}{section*.18}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Six-point sparsity regime analysis with KL predictors on Llama-3.1-8B. Each sparsity level uses a dedicated predictor. Uniform PPL exhibits non-monotonic behavior (decreasing from 25\% to 40\%) due to per-level predictor optimization effects, with a sharp cliff at 40\%--45\%. Downstream metrics show a different cliff location: MMLU drops 10.8pp between 35\% and 40\%.}}{6}{table.caption.17}\protected@file@percent }
\newlabel{tab:regime}{{4}{6}{Six-point sparsity regime analysis with KL predictors on Llama-3.1-8B. Each sparsity level uses a dedicated predictor. Uniform PPL exhibits non-monotonic behavior (decreasing from 25\% to 40\%) due to per-level predictor optimization effects, with a sharp cliff at 40\%--45\%. Downstream metrics show a different cliff location: MMLU drops 10.8pp between 35\% and 40\%}{table.caption.17}{}}
\@writefile{toc}{\contentsline {paragraph}{PPL-downstream dissociation.}{6}{section*.19}\protected@file@percent }
