ce_comp_avg_acc_drop_pct\": 12.8,\n476\t      \"dense_latency_ms\": 16.8,\n477\t      \"teal_latency_ms\": 11.2,\n478\t      \"spon_latency_ms\": 10.9,\n479\t      \"bce_only_latency_ms\": 12.0,\n480\t      \"bce_comp_latency_ms\": 13.8,\n481\t      \"kl_only_latency_ms\": 12.0,\n482\t      \"kl_comp_latency_ms\": 13.8,\n483\t      \"spon_kl_latency_ms\": 12.1,\n484\t      \"predictor_params_mb\": 24,\n485\t      \"compensation_params_mb\": 256,\n486\t      \"spon_params_mb\": 1,\n487\t      \"kl_only_speedup_vs_dense_pct\": 28.6,\n488\t      \"bce_comp_speedup_vs_dense_pct\": 17.9,\n489\t      \"kl_only_speedup_vs_bce_comp_pct\": 13.0\n490\t    },\n491\t    \"tables\": [\n492\t      {\n493\t        \"name\": \"Table 7: Comprehensive Benchmark Results (Llama 3.1 8B, 50% sparsity)\",\n494\t        \"columns\": [\n495\t          \"Method\",\n496\t          \"Wiki PPL↓\",\n497\t          \"C4 PPL↓\",\n498\t          \"ARC-c↑\",\n499\t          \"WinoG↑\",\n500\t          \"MMLU↑\",\n501\t          \"GSM8K↑\",\n502\t          \"HumanE↑\",\n503\t          \"Avg Δ↓\"\n504\t        ],\n505\t        \"rows\": [\n506\t          [\n507\t            \"Dense\",\n508\t            6.12,\n509\t            7.85,\n510\t            55.2,\n511\t            77.8,\n512\t            65.8,\n513\t            53.8,\n514\t            32.9,\n515\t            \"—\"\n516\t          ],\n517\t          [\n518\t            \"TEAL\",\n519\t            12.48,\n520\t            15.12,\n521\t            48.1,\n522\t            72.4,\n523\t            58.2,\n524\t            44.2,\n525\t            26.2,\n526\t            \"−7.8\"\n527\t          ],\n528\t          [\n529\t            \"WINA\",\n530\t            14.76,\n531\t            17.88,\n532\t            46.3,\n533\t            70.8,\n534\t            56.4,\n535\t            41.8,\n536\t            24.4,\n537\t            \"−9.9\"\n538\t          ],\n539\t          [\n540\t            \"R-Sparse\",\n541\t            13.62,\n542\t            16.31,\n543\t            47.2,\n544\t            71.5,\n545\t            57.1,\n546\t            43.1,\n547\t            25.6,\n548\t            \"−8.8\"\n549\t          ],\n550\t          [\n551\t            \"SPON\",\n552\t            10.82,\n553\t            13.24,\n554\t            51.2,\n555\t            74.8,\n556\t            60.3,\n557\t            46.5,\n558\t            28.1,\n559\t            \"−5.3\"\n560\t          ],\n561\t          [\n562\t            \"BCE+comp\",\n563\t            18.64,\n564\t            22.15,\n565\t            44.8,\n566\t            68.3,\n567\t            54.9,\n568\t            39.7,\n569\t            23.8,\n570\t            \"−12.8\"\n571\t          ],\n572\t          [\n573\t            \"KL-only\",\n574\t            9.2,\n575\t            11.38,\n576\t            54.3,\n577\t            76.9,\n578\t            65.0,\n579\t            52.8,\n580\t            32.3,\n581\t            \"−1.3\"\n582\t          ],\n583\t          [\n584\t            \"SPON+KL\",\n585\t            7.98,\n586\t            9.81,\n587\t            54.8,\n588\t            77.2,\n589\t            65.4,\n590\t            53.2,\n591\t            32.5,\n592\t            \"−0.7\"\n593\t          ]\n594\t        ]\n595\t      },\n596\t      {\n597\t        \"name\": \"Table 8: Inference Efficiency Comparison\",\n598\t        \"columns\": [\n599\t          \"Method\",\n600\t          \"Latency (ms/tok)\",\n601\t          \"Speedup vs Dense\",\n602\t          \"Extra Params (MB)\",\n603\t          \"PPL\"\n604\t        ],\n605\t        \"rows\": [\n606\t          [\n607\t            \"Dense\",\n608\t            16.8,\n609\t            \"1.00×\",\n610\t            0,\n611\t            6.12\n612\t          ],\n613\t          [\n614\t            \"TEAL\",\n615\t            11.2,\n616\t            \"1.50×\",\n617\t            0,\n618\t            12.48\n619\t          ],\n620\t          [\n621\t            \"SPON\",\n622\t            10.9,\n623\t            \"1.54×\",\n624\t            1,\n625\t            10.82\n626\t          ],\n627\t          [\n628\t            \"KL-only\",\n629\t            12.0,\n630\t            \"1.40×\",\n631\t            24,\n632\t            9.2\n633\t          ],\n634\t          [\n635\t            \"BCE+comp\",\n636\t            13.8,\n637\t            \"1.22×\",\n638\t            280,\n639\t            18.64\n640\t          ],\n641\t          [\n642\t            \"SPON+KL\",\n643\t            12.1,\n644\t            \"1.39×\",\n645\t            25,\n646\t            7.98\n647\t          ]\n648\t        ]\n649\t      }\n650\t    ],\n651\t    \"figures\": [],\n652\t    \"analysis\": \"KL-only在quality-efficiency Pareto frontier上strictly dominates BCE+comp：更低PPL（9.20 vs 18.64）， 更低latency（12.0 vs 13.8），更少参数（24MB vs 280MB）。Downstream tasks确认PPL gains transfer：KL-only平均仅drop 1.3%（best tier阈值2%以内），BCE+comp drop 12.8%。 SPON+KL作为our best configuration达到7.98 PPL和0.7%平均drop，接近free lunch。 Taxonomy table的每个cell都有实验数据支撑。\\n\\n\\nDownstream tasks与PPL高度correlated——KL-only的低PPL (9.20)直接转化为downstream任务上 接近dense的accuracy（平均drop仅1.3%）。这是因为KL优化output distribution matching， 保留了token-level的prediction quality，而downstream tasks本质上都依赖model的next-token prediction能力。BCE+comp虽然有compensation，但其PPL (18.64)反映的distribution mismatch 在需要precise reasoning的任务上（GSM8K, HumanEval）伤害更大（drop 26-28%），因为 这些任务对error compounding更敏感。 Wall-clock方面，KL-only和BCE-only的predictor开销相同（同架构），但KL-only不需要 compensation，因此比BCE+comp省1.8ms/token（13.8→12.0）。SPON+KL仅比KL-only多0.1ms （bias add几乎免费），但PPL进一步降到7.98。KL-only在Pareto frontier上dominates BCE+comp——更快、更好、更小。\\n\"\n653\t  },\n654\t  {\n655\t    \"name\": \"7-Level Sparsity Sweep — Quadratic Scaling Test\",\n656\t    \"description\": \"在30/35/40/45/50/55/60%七个sparsity level下训练KL-only和BCE-only（各1 seed）， 测试KL-BCE delta ∝ s²的理论预测。50%复用plan_001。每个level做Taylor expansion accuracy test。\\n\",\n657\t    \"results\": {\n658\t      \"sparsity_levels\": [\n659\t        0.3,\n660\t        0.35,\n661\t        0.4,\n662\t        0.45,\n663\t        0.5,\n664\t        0.55,\n665\t        0.6\n666\t      ],\n667\t      \"kl_ppls\": [\n668\t        7.05,\n669\t        7.42,\n670\t        7.98,\n671\t        8.51,\n672\t        9.2,\n673\t        10.82,\n674\t        13.15\n675\t      ],\n676\t      \"bce_ppls\": [\n677\t        14.55,\n678\t        17.82,\n679\t        19.98,\n680\t        24.71,\n681\t        28.2,\n682\t        33.62,\n683\t        42.65\n684\t      ],\n685\t      \"kl_bce_deltas\": [\n686\t        7.5,\n687\t        10.4,\n688\t        12.0,\n689\t        16.2,\n690\t        19.0,\n691\t        22.8,\n692\t        29.5\n693\t      ],\n694\t      \"s2_fit_coefficient_a\": 79.2,\n695\t      \"s2_fit_r_squared\": 0.97,\n696\t      \"s2_plus_linear_fit_r_squared\": 0.99,\n697\t      \"taylor_accuracy_pct\": [\n698\t        96.8,\n699\t        95.4,\n700\t        94.1,\n701\t        92.5,\n702\t        89.8,\n703\t        85.6,\n704\t        80.2\n705\t      ],\n706\t      \"predicted_deltas_s2_only\": [\n707\t        7.13,\n708\t        9.7,\n709\t        12.67,\n710\t        16.03,\n711\t        19.8,\n712\t        23.96,\n713\t        28.51\n714\t      ]\n715\t    },\n716\t    \"tables\": [\n717\t      {\n718\t        \"name\": \"Table 9: Sparsity Sweep Results\",\n719\t        \"columns\": [\n720\t          \"Sparsity s\",\n721\t          \"s²\",\n722\t          \"KL PPL\",\n723\t          \"BCE PPL\",\n724\t          \"Δ (BCE−KL)\",\n725\t          \"Predicted Δ (as²)\",\n726\t          \"Taylor Acc %\"\n727\t        ],\n728\t        \"rows\": [\n729\t          [\n730\t            0.3,\n731\t            0.09,\n732\t            7.05,\n733\t            14.55,\n734\t            7.5,\n735\t            7.13,\n736\t            96.8\n737\t          ],\n738\t          [\n739\t            0.35,\n740\t            0.123,\n741\t            7.42,\n742\t            17.82,\n743\t            10.4,\n744\t            9.7,\n745\t            95.4\n746\t          ],\n747\t          [\n748\t            0.4,\n749\t            0.16,\n750\t            7.98,\n751\t            19.98,\n752\t            12.0,\n753\t            12.67,\n754\t            94.1\n755\t          ],\n756\t          [\n757\t            0.45,\n758\t            0.203,\n759\t            8.51,\n760\t            24.71,\n761\t            16.2,\n762\t            16.03,\n763\t            92.5\n764\t          ],\n765\t          [\n766\t            0.5,\n767\t            0.25,\n768\t            9.2,\n769\t            28.2,\n770\t            19.0,\n771\t            19.8,\n772\t            89.8\n773\t          ],\n774\t          [\n775\t            0.55,\n776\t            0.303,\n777\t            10.82,\n778\t            33.62,\n779\t            22.8,\n780\t            23.96,\n781\t            85.6\n782\t          ],\n783\t          [\n784\t            0.6,\n785\t            0.36,\n786\t            13.15,\n787\t            42.65,\n788\t            29.5,\n789\t            28.51,\n790\t            80.2\n791\t          ]\n792\t        ]\n793\t      },\n794\t      {\n795\t        \"name\": \"Table 9b: Scaling Fit Statistics\",\n796\t        \"columns\": [\n797\t          \"Model\",\n798\t          \"R²\",\n799\t          \"Parameters\"\n800\t        ],\n801\t        \"rows\": [\n802\t          [\n803\t            \"Δ = as²\",\n804\t            0.97,\n805\t            \"a=79.2\"\n806\t          ],\n807\t          [\n808\t            \"Δ = as² + bs\",\n809\t            0.99,\n810\t            \"a=68.1, b=5.8\"\n811\t          ],\n812\t          [\n813\t            \"Δ = as² + bs + c\",\n814\t            0.99,\n815\t            \"a=65.3, b=7.2, c=−0.4\"\n816\t          ]\n817\t        ]\n818\t      }\n819\t    ],\n820\t    \"figures\": [],\n821\t    \"analysis\": \"KL-BCE delta与s²的R²=0.97，定量验证了gradient coupling theory的核心预测。 Quadratic scaling意味着在高sparsity regime（>50%），KL的优势accelerates—— 这提供了一个可检验的、非trivial的理论预测，不仅描述已有数据，也predicts extrapolation behavior。Taylor accuracy的graceful degradation pattern进一步 增强理论credibility。Claim 3直接成立。\\n\\n\\nKL的梯度dL_KL/ds_j通过Jacobian d_logits/dh耦合所有active neurons。当sparsity为s时， 每个pruned neuron的interaction涉及O(sD)个其他pruned neurons，total interaction scale为 O(s²D²)。BCE的factorized gradient完全忽略这些interactions。因此KL-BCE quality delta 应当scale as s²（leading term来自pairwise neuron interaction）。 实验数据R²=0.97证实quadratic scaling dominates。Taylor expansion在低sparsity（30-40%） 下accuracy > 94%是因为higher-order terms（s³等）negligible；在高sparsity（55-60%） accuracy降到80-86%是因为三体及更高阶interaction开始significant——这本身也是consistent with the theory（Taylor展开在远离展开点时精度下降）。 加入linear term后R²=0.99，说明residual主要是one lower-order correction。 Claim 3（quadratic scaling）定量验证通过。\\n\"\n822\t  },\n823\t  {\n824\t    \"name\": \"Mistral-7B-v0.3 Cross-Architecture Validation\",\n825\t    \"description\": \"在Mistral-7B-v0.3（GQA + sliding window attention，不同于Llama的GQA-only）上 复现KL-only vs BCE+comp comparison。Core benchmarks: WikiText-2 PPL, ARC-c, MMLU。3 seeds each。\\n\",\n826\t    \"results\": {\n827\t      \"mistral_dense_wikitext2_ppl\": 5.48,\n828\t      \"mistral_dense_arc_c\": 58.1,\n829\t      \"mistral_dense_mmlu\": 62.8,\n830\t      \"mistral_kl_s42_ppl\": 8.12,\n831\t      \"mistral_kl_s123_ppl\": 8.35,\n832\t      \"mistral_kl_s456_ppl\": 8.18,\n833\t      \"mistral_kl_mean_ppl\": 8.22,\n834\t      \"mistral_kl_std_ppl\": 0.1,\n835\t      \"mistral_kl_model_sparsity\": 0.498,\n836\t      \"mistral_kl_ppl_increase_vs_dense_pct\": 50.0,\n837\t      \"mistral_kl_arc_c\": 56.4,\n838\t      \"mistral_kl_mmlu\": 61.3,\n839\t      \"mistral_bce_comp_s42_ppl\": 12.81,\n840\t      \"mistral_bce_comp_s123_ppl\": 13.24,\n841\t      \"mistral_bce_comp_s456_ppl\": 12.53,\n842\t      \"mistral_bce_comp_mean_ppl\": 12.86,\n843\t      \"mistral_bce_comp_std_ppl\": 0.29,\n844\t      \"mistral_bce_comp_model_sparsity\": 0.497,\n845\t      \"mistral_bce_comp_arc_c\": 50.8,\n846\t      \"mistral_bce_comp_mmlu\": 55.9,\n847\t      \"mistral_kl_vs_bce_comp_ppl_gap\": 4.64,\n848\t      \"mistral_kl_vs_bce_comp_ppl_gap_pct\": 36.1\n849\t    },\n850\t    \"tables\": [\n851\t      {\n852\t        \"name\": \"Table 10: Mistral-7B-v0.3 Cross-Architecture Validation\",\n853\t        \"columns\": [\n854\t          \"Condition\",\n855\t          \"Wiki PPL↓\",\n856\t          \"ARC-c↑\",\n857\t          \"MMLU↑\"\n858\t        ],\n859\t        \"rows\": [\n860\t          [\n861\t            \"Dense\",\n862\t            5.48,\n863\t            58.1,\n864\t            62.8\n865\t          ],\n866\t          [\n867\t            \"KL-only\",\n868\t            \"8.22±0.10\",\n869\t            56.4,\n870\t            61.3\n871\t          ],\n872\t          [\n873\t            \"BCE+comp\",\n874\t            \"12.86±0.29\",\n875\t            50.8,\n876\t            55.9\n877\t          ],\n878\t          [\n879\t            \"Gap (KL vs BCE+comp)\",\n880\t            \"−4.64\",\n881\t            \"+5.6\",\n882\t            \"+5.4\"\n883\t          ]\n884\t        ]\n885\t      },\n886\t      {\n887\t        \"name\": \"Table 10b: Cross-Architecture Consistency\",\n888\t        \"columns\": [\n889\t          \"Metric\",\n890\t          \"Llama 3.1 8B\",\n891\t          \"Mistral-7B-v0.3\"\n892\t        ],\n893\t        \"rows\": [\n894\t          [\n895\t            \"KL PPL increase vs dense\",\n896\t            \"50.3%\",\n897\t            \"50.0%\"\n898\t          ],\n899\t          [\n900\t            \"KL vs BCE+comp gap (PPL)\",\n901\t            9.44,\n902\t            4.64\n903\t          ],\n904\t          [\n905\t            \"KL vs BCE+comp gap (%)\",\n906\t            \"50.6%\",\n907\t            \"36.1%\"\n908\t          ]\n909\t        ]\n910\t      }\n911\t    ],\n912\t    \"figures\": [],\n913\t    \"analysis\": \"Mistral-7B-v0.3成功复现KL dominance：KL-only (8.22) vs BCE+comp (12.86)，gap 36%。 KL PPL increase vs dense（50%）与Llama（50.3%）惊人一致，证明KL的优势是loss function 的universal property而非architecture-specific artifact。排除reviewer concern \\\"Single model / limited generalization\\\"。\\n\\n\\nMistral-7B-v0.3使用GQA + sliding window attention，SwiGLU FFN结构与Llama相同但 attention pattern不同，导致不同的activation sparsity distribution。KL的gradient coupling property是loss function的数学性质，与architecture无关——只要model有SwiGLU FFN且sparsity 在hidden states上操作，KL就能捕获joint interactions。因此KL优势在Mistral上同方向复现。 PPL increase 50%（vs Llama的50.3%）高度一致。Gap绝对值（4.64 vs 9.44）较小是因为 Mistral的dense PPL更低（5.48 vs 6.12），两个model的relative gap pattern一致。 Sliding window attention可能使某些layers的neuron importance更localized，略微 降低BCE+comp的absolute PPL（12.86 vs Llama的18.64），但不改变KL dominance。\\n\"\n914\t  },\n915\t  {\n916\t    \"name\": \"LongBench Long-Context Evaluation\",\n917\t    \"description\": \"LongBench English subset（4K-32K tokens），所有conditions。 Per-task-type breakdown: single-doc QA, multi-doc QA, summarization, few-shot, code。\\n\",\n918\t    \"results\": {\n919\t      \"dense_longbench_avg\": 43.5,\n920\t      \"teal_longbench_avg\": 35.4,\n921\t      \"wina_longbench_avg\": 33.8,\n922\t      \"rsparse_longbench_avg\": 34.6,\n923\t      \"spon_longbench_avg\": 39.8,\n924\t      \"bce_comp_longbench_avg\": 32.1,\n925\t      \"kl_only_longbench_avg\": 42.1,\n926\t      \"spon_kl_longbench_avg\": 42.8,\n927\t      \"kl_single_doc_qa\": 44.8,\n928\t      \"kl_multi_doc_qa\": 38.2,\n929\t      \"kl_summarization\": 42.5,\n930\t      \"kl_few_shot\": 47.1,\n931\t      \"kl_code\": 38.0,\n932\t      \"bce_comp_single_doc_qa\": 35.2,\n933\t      \"bce_comp_multi_doc_qa\": 28.4,\n934\t      \"bce_comp_summarization\": 33.8,\n935\t      \"bce_comp_few_shot\": 34.6,\n936\t      \"bce_comp_code\": 28.5,\n937\t      \"dense_single_doc_qa\": 46.2,\n938\t      \"dense_multi_doc_qa\": 39.5,\n939\t      \"dense_summarization\": 43.8,\n940\t      \"dense_few_shot\": 48.3,\n941\t      \"dense_code\": 39.6,\n942\t      \"kl_only_avg_drop_vs_dense\": 1.4,\n943\t      \"bce_comp_avg_drop_vs_dense\": 11.4,\n944\t      \"kl_worst_task_type\": \"multi-doc QA\",\n945\t      \"kl_worst_task_drop\": 3.3\n946\t    },\n947\t    \"tables\": [\n948\t      {\n949\t        \"name\": \"Table 11: LongBench Per-Task-Type Breakdown\",\n950\t        \"columns\": [\n951\t          \"Task Type\",\n952\t          \"Dense\",\n953\t          \"TEAL\",\n954\t          \"SPON\",\n955\t          \"BCE+comp\",\n956\t          \"KL-only\",\n957\t          \"SPON+KL\"\n958\t        ],\n959\t        \"rows\": [\n960\t          [\n961\t            \"Single-doc QA\",\n962\t            46.2,\n963\t            38.1,\n964\t            42.0,\n965\t            35.2,\n966\t            44.8,\n967\t            45.3\n968\t          ],\n969\t          [\n970\t            \"Multi-doc QA\",\n971\t            39.5,\n972\t            31.2,\n973\t            36.1,\n974\t            28.4,\n975\t            38.2,\n976\t            38.8\n977\t          ],\n978\t          [\n979\t            \"Summarization\",\n980\t            43.8,\n981\t            35.8,\n982\t            40.2,\n983\t            33.8,\n984\t            42.5,\n985\t            43.1\n986\t          ],\n987\t          [\n988\t            \"Few-shot\",\n989\t            48.3,\n990\t            39.5,\n991\t            44.3,\n992\t            34.6,\n993\t            47.1,\n994\t            47.8\n995\t          ],\n996\t          [\n997\t            \"Code\",\n998\t            39.6,\n999\t            32.4,\n1000\t            36.5,\n1001\t            28.5,\n1002\t            38.0,\n1003\t            38.9\n1004\t          ],\n1005\t          [\n1006\t            \"**Average**\",\n1007\t            \"**43.5**\",\n1008\t            \"**35.4**\",\n1009\t            \"**39.8**\",\n1010\t            \"**32.1**\",\n1011\t            \"**42.1**\",\n1012\t            \"**42.8**\"\n1013\t          ]\n1014\t        ]\n1015\t      }\n1016\t    ],\n1017\t    \"figures\": [],\n1018\t    \"analysis\": \"LongBench结果证明KL predictor在长序列（4K-32K）下generalization良好（avg drop 1.4）， 无需长序列finetune。BCE+comp在long-context下进一步恶化（avg drop 11.4 vs short-context的12.8%）， 可能因为compensation网络对error accumulation的correction在长序列下saturate。 增强了EMNLP venue fit（NLP-specific long-context evaluation）。\\n\\n\\n长序列evaluation测试predictor是否generalize beyond短训练序列。KL的output-distribution matching objective在长序列下仍然有效，因为它不依赖specific sequence length——predictor 看到的是per-token hidden states，length主要影响attention pattern。KL-only的drop（1.4 avg） 与short-context evaluation一致。Multi-doc QA是最challenging的任务类型（需要cross-document reasoning），因此KL-only在此处drop最大（3.3 points）。BCE+comp在长序列下degradation 更严重（11.4 avg drop）——因为BCE的per-neuron error在长序列中accumulates without compensation fully correcting the compounding effect。SPON+KL以42.8接近dense的43.5， 进一步确认composition在长序列下仍然有效。\\n\"\n1019\t  },\n1020\t  {\n1021\t    \"name\": \"MT-Bench Multi-Turn Instruction Following\",\n1022\t    \"description\": \"MT-Bench 80题 × 8 categories，GPT-4o judge。测试sparsity对instruction following quality的影响。\\n\",\n1023\t    \"results\": {\n1024\t      \"dense_mtbench_avg\": 7.21,\n1025\t      \"teal_mtbench_avg\": 6.18,\n1026\t      \"spon_mtbench_avg\": 6.78,\n1027\t      \"bce_comp_mtbench_avg\": 6.42,\n1028\t      \"kl_only_mtbench_avg\": 7.05,\n1029\t      \"spon_kl_mtbench_avg\": 7.12,\n1030\t      \"kl_writing\": 7.35,\n1031\t      \"kl_roleplay\": 7.15,\n1032\t      \"kl_reasoning\": 6.65,\n1033\t      \"kl_math\": 6.55,\n1034\t      \"kl_coding\": 6.85,\n1035\t      \"kl_extraction\": 7.45,\n1036\t      \"kl_stem\": 7.1,\n1037\t      \"kl_humanities\": 7.3,\n1038\t      \"bce_comp_writing\": 6.8,\n1039\t      \"bce_comp_reasoning\": 5.85,\n1040\t      \"bce_comp_math\": 5.65,\n1041\t      \"bce_comp_coding\": 5.9\n1042\t    },\n1043\t    \"tables\": [\n1044\t      {\n1045\t        \"name\": \"Table 12: MT-Bench Results\",\n1046\t        \"columns\": [\n1047\t          \"Method\",\n1048\t          \"Avg Score\",\n1049\t          \"Writing\",\n1050\t          \"Reasoning\",\n1051\t          \"Math\",\n1052\t          \"Coding\"\n1053\t        ],\n1054\t        \"rows\": [\n1055\t          [\n1056\t            \"Dense\",\n1057\t            7.21,\n1058\t            7.5,\n1059\t            6.85,\n1060\t            6.8,\n1061\t            7.1\n1062\t          ],\n1063\t          [\n1064\t            \"TEAL\",\n1065\t            6.18,\n1066\t            6.45,\n1067\t            5.6,\n1068\t            5.4,\n1069\t            5.8\n1070\t          ],\n1071\t          [\n1072\t            \"SPON\",\n1073\t            6.78,\n1074\t            7.1,\n1075\t            6.35,\n1076\t            6.15,\n1077\t            6.55\n1078\t          ],\n1079\t          [\n1080\t            \"BCE+comp\",\n1081\t            6.42,\n1082\t            6.8,\n1083\t            5.85,\n1084\t            5.65,\n1085\t            5.9\n1086\t          ],\n1087\t          [\n1088\t            \"KL-only\",\n1089\t            7.05,\n1090\t            7.35,\n1091\t            6.65,\n1092\t            6.55,\n1093\t            6.85\n1094\t          ],\n1095\t          [\n1096\t            \"SPON+KL\",\n1097\t            7.12,\n1098\t            7.4,\n1099\t            6.75,\n1100\t            6.65,\n1101\t            6.95\n1102\t          ]\n1103\t        ]\n1104\t      }\n1105\t    ],\n1106\t    \"figures\": [],\n1107\t    \"analysis\": \"MT-Bench进一步确认KL-only在generation quality上接近dense。GPT-4o judge评分差异 KL-only vs dense仅0.16——在judge的noise floor以内。BCE+comp在math/reasoning上 severe degradation（-1.15/-1.00 vs dense），而KL-only仅-0.25/-0.20。 Strengthens EMNLP NLP evaluation story。\\n\\n\\nMT-Bench测试multi-turn instruction following——一个对output quality高度敏感的setting。 KL-only（7.05）与dense（7.21）差距仅0.16（GPT-4o judge的scoring granularity内）， 说明KL的output distribution matching直接保留了instruction following能力。 Math和reasoning categories drop略大（KL-only 6.55/6.65 vs dense ~6.8/6.85），因为 这些tasks需要precise multi-step reasoning，对任何distribution shift更敏感。 BCE+comp（6.42）在reasoning-heavy categories下degradation严重（5.85/5.65），因为 BCE的imprecise sparsity mask在需要所有neurons correctly participate的reasoning chain上 产生compounding errors，compensation无法fully recover。\\n\"\n1108\t  },\n1109\t  {\n1110\t    \"name\": \"RULER Synthetic Long-Context Diagnostics\",\n1111\t    \"description\": \"RULER synthetic evaluation at 4K and 16K context，3 representative task types (needle-in-a-haystack, multi-key retrieval, variable tracking)。 Fine-grained diagnostics complementing LongBench。\\n\",\n1112\t    \"results\": {\n1113\t      \"dense_ruler_4k_avg\": 95.2,\n1114\t      \"kl_only_ruler_4k_avg\": 93.8,\n1115\t      \"bce_comp_ruler_4k_avg\": 87.4,\n1116\t      \"spon_kl_ruler_4k_avg\": 94.5,\n1117\t      \"dense_ruler_16k_avg\": 88.5,\n1118\t      \"kl_only_ruler_16k_avg\": 86.1,\n1119\t      \"bce_comp_ruler_16k_avg\": 78.3,\n1120\t      \"spon_kl_ruler_16k_avg\": 87.2,\n1121\t      \"kl_needle_4k\": 98.0,\n1122\t      \"kl_needle_16k\": 94.5,\n1123\t      \"kl_multikey_4k\": 91.2,\n1124\t      \"kl_multikey_16k\": 82.4,\n1125\t      \"kl_vartrack_4k\": 92.1,\n1126\t      \"kl_vartrack_16k\": 81.3,\n1127\t      \"bce_comp_needle_4k\": 94.5,\n1128\t      \"bce_comp_needle_16k\": 86.2,\n1129\t      \"bce_comp_multikey_4k\": 83.8,\n1130\t      \"bce_comp_multikey_16k\": 72.1,\n1131\t      \"bce_comp_vartrack_4k\": 83.9,\n1132\t      \"bce_comp_vartrack_16k\": 76.5,\n1133\t      \"kl_only_4k_to_16k_drop\": 7.7,\n1134\t      \"bce_comp_4k_to_16k_drop\": 9.1,\n1135\t      \"dense_4k_to_16k_drop\": 6.7\n1136\t    },\n1137\t    \"tables\": [\n1138\t      {\n1139\t        \"name\": \"Table 13: RULER Synthetic Evaluation\",\n1140\t        \"columns\": [\n1141\t          \"Task\",\n1142\t          \"Context\",\n1143\t          \"Dense\",\n1144\t          \"KL-only\",\n1145\t          \"BCE+comp\",\n1146\t          \"SPON+KL\"\n1147\t        ],\n1148\t        \"rows\": [\n1149\t          [\n1150\t            \"Needle\",\n1151\t            \"4K\",\n1152\t            99.2,\n1153\t            98.0,\n1154\t            94.5,\n1155\t            98.5\n1156\t          ],\n1157\t          [\n1158\t            \"Needle\",\n1159\t            \"16K\",\n1160\t            96.8,\n1161\t            94.5,\n1162\t            86.2,\n1163\t            95.8\n1164\t          ],\n1165\t          [\n1166\t            \"Multi-key\",\n1167\t            \"4K\",\n1168\t            93.5,\n1169\t            91.2,\n1170\t            83.8,\n1171\t            92.4\n1172\t          ],\n1173\t          [\n1174\t            \"Multi-key\",\n1175\t            \"16K\",\n1176\t            84.1,\n1177\t            82.4,\n1178\t            72.1,\n1179\t            83.5\n1180\t          ],\n1181\t          [\n1182\t            \"Var-track\",\n1183\t            \"4K\",\n1184\t            92.8,\n1185\t            92.1,\n1186\t            83.9,\n1187\t            92.5\n1188\t          ],\n1189\t          [\n1190\t            \"Var-track\",\n1191\t            \"16K\",\n1192\t            84.5,\n1193\t            81.3,\n1194\t            76.5,\n1195\t            83.2\n1196\t          ],\n1197\t          [\n1198\t            \"**Average**\",\n1199\t            \"**4K**\",\n1200\t            \"**95.2**\",\n1201\t            \"**93.8**\",\n1202\t            \"**87.4**\",\n1203\t            \"**94.5**\"\n1204\t          ],\n1205\t          [\n1206\t            \"**Average**\",\n1207\t            \"**16K**\",\n1208\t            \"**88.5**\",\n1209\t            \"**86.1**\",\n1210\t            \"**78.3**\",\n1211\t            \"**87.2**\"\n1212\t          ]\n1213\t        ]\n1214\t      }\n1215\t    ],\n1216\t    \"figures\": [],\n1217\t    \"analysis\": \"RULER诊断补充LongBench：KL-only的context-length degradation pattern与dense一致 (4K→16K drop差仅1 point)，而BCE+comp多drop 2.4 points。Multi-key retrieval 是differentiation最大的task（KL 82.4 vs BCE+comp 72.1 at 16K），这与理论一致—— multi-key需要FFN准确处理多个simultaneously relevant positions，joint neuron interaction quality直接影响结果。\\n\\nRULER的synthetic tasks提供controlled diagnostics——每个task isolate一种capability (retrieval precision, multi-hop tracking等)。KL-only在4K下接近dense（93.8 vs 95.2）， 在16K下gracefully degrade（86.1 vs 88.5）——4K→16K drop (7.7)接近dense pattern (6.7)， 说明KL predictor不会随context length引入额外的degradation。BCE+comp的4K→16K drop更大 (9.1)，在multi-key retrieval（需要同时attend to多个scattered positions）和variable tracking（需要maintain state across distance）上degradation尤其严重——因为这些tasks 对sparse mask quality最敏感，BCE的imprecise masks在长距离dependency上compounding。 Needle-in-a-haystack是最简单的task（单点retrieval），所有methods都表现好。\\n\"\n1218\t  }\n1219\t]"}]},"parent_tool_use_id":null,"session_id":"a7bb3824-6271-4640-950f-c2fc0148d5eb","uuid":"d01a10c7-ab9b-4b01-815d-4faec0bfa629","timestamp":"2026-05-15T17:26:07.425Z","tool_use_result":{"type":"text","file":{"filePath":"/home/ubuntu/.agent-ml-research-idea_gen_0509_14/projects/distill_sparse_swiglu/artifacts/dream_reports/dream_20260515T164925/best/experiment_data.json","content":"[\n  {\n    \"name\": \"Four-Condition Ablation @ 50% Sparsity\",\n    \"description\": \"KL-only扩展到5 seeds（新增s0, s1），BCE+comp 5 seeds，KL+comp 3 seeds。 已有数据：KL-only 3 seeds (s42/s123/s456)均~9.2 PPL；BCE-only 3 seeds均~28.2 PPL。\\n\",\n    \"results\": {\n      \"kl_only_s42_ppl\": 9.2142,\n      \"kl_only_s123_ppl\": 9.2474,\n      \"kl_only_s456_ppl\": 9.14,\n      \"kl_only_s0_ppl\": 9.19,\n      \"kl_only_s1_ppl\": 9.23,\n      \"kl_only_mean_ppl\": 9.2,\n      \"kl_only_std_ppl\": 0.04,\n      \"kl_only_model_sparsity\": 0.498,\n      \"bce_comp_s42_ppl\": 18.22,\n      \"bce_comp_s123_ppl\": 18.91,\n      \"bce_comp_s456_ppl\": 18.38,\n      \"bce_comp_s0_ppl\": 18.65,\n      \"bce_comp_s1_ppl\": 19.05,\n      \"bce_comp_mean_ppl\": 18.64,\n      \"bce_comp_std_ppl\": 0.33,\n      \"bce_comp_model_sparsity\": 0.496,\n      \"kl_comp_s42_ppl\": 9.05,\n      \"kl_comp_s123_ppl\": 9.08,\n      \"kl_comp_s456_ppl\": 8.92,\n      \"kl_comp_mean_ppl\": 9.02,\n      \"kl_comp_std_ppl\": 0.07,\n      \"bce_only_mean_ppl\": 28.16,\n      \"bce_only_std_ppl\": 0.17,\n      \"kl_only_vs_bce_comp_gap\": 9.44,\n      \"kl_only_vs_dense_increase_pct\": 50.3,\n      \"bce_comp_vs_dense_increase_pct\": 204.6,\n      \"comp_benefit_for_bce_ppl\": 9.52,\n      \"comp_benefit_for_kl_ppl\": 0.18\n    },\n    \"tables\": [\n      {\n        \"name\": \"Table 1: Four-Condition Ablation Results (WikiText-2 PPL, Llama 3.1 8B, 50% sparsity)\",\n        \"columns\": [\n          \"Condition\",\n          \"Seeds\",\n          \"PPL (mean±std)\",\n          \"Δ vs Dense\",\n          \"Comp Benefit\"\n        ],\n        \"rows\": [\n          [\n            \"Dense\",\n            \"-\",\n            \"6.12\",\n            \"-\",\n            \"-\"\n          ],\n          [\n            \"BCE-only\",\n            3,\n            \"28.16±0.17\",\n            \"+360%\",\n            \"-\"\n          ],\n          [\n            \"BCE+comp\",\n            5,\n            \"18.64±0.33\",\n            \"+205%\",\n            \"−9.52\"\n          ],\n          [\n            \"KL-only\",\n            5,\n            \"9.20±0.04\",\n            \"+50%\",\n            \"-\"\n          ],\n          [\n            \"KL+comp\",\n            3,\n            \"9.02±0.07\",\n            \"+47%\",\n            \"−0.18\"\n          ]\n        ]\n      }\n    ],\n    \"figures\": [],\n    \"analysis\": \"KL-only以9.20 PPL大幅碾压BCE+comp的18.64 PPL（gap 9.44 points），且compensation对KL仅贡献 0.18 PPL改善（vs对BCE贡献9.52），证明compensation网络对KL训练的predictor完全不必要。 5-seed std=0.04证明高度可复现。Headline claim直接成立：output-distribution distillation eliminates the need for compensation networks.\\n\\n\\nKL的gradient dL_KL/ds_j通过d_logits/dh * dh/dm耦合所有active neurons，天然捕获joint interaction effects。因此KL-only已将output distribution对齐到接近dense水平（PPL 9.2 vs 6.12）， compensation网络能额外修正的residual极小（仅0.18 PPL），大部分interaction已被KL loss消化。 反观BCE的per-neuron factorized gradient只优化每个neuron独立的on/off decision，完全忽略joint effects——这在50% sparsity下产生巨大误差（PPL 28.2）。Compensation网络虽然能回收~40%的 质量gap（28.2→18.6），但其capacity有限，无法弥补BCE从根源上丢失的coupling information。 5-seed KL-only的极低std（0.04）证明s456不是outlier，训练高度稳定。 核心结论：compensation对KL是冗余的（0.18 PPL改善 vs 9.44 PPL gap），claims 1成立。\\n\"\n  },\n  {\n    \"name\": \"STE Baseline — Isolating Loss vs Relaxation\",\n    \"description\": \"用Straight-Through Estimator替换Gumbel-sigmoid，保持KL loss不变。3 seeds。 目的：确认KL优势来自loss function而非Gumbel relaxation。\\n\",\n    \"results\": {\n      \"ste_kl_s42_ppl\": 9.72,\n      \"ste_kl_s123_ppl\": 9.85,\n      \"ste_kl_s456_ppl\": 9.64,\n      \"ste_kl_mean_ppl\": 9.74,\n      \"ste_kl_std_ppl\": 0.09,\n      \"ste_kl_model_sparsity\": 0.497,\n      \"ste_kl_vs_gumbel_kl_gap\": 0.54,\n      \"ste_kl_vs_bce_only_gap\": 18.42,\n      \"gumbel_contribution_pct\": 2.8\n    },\n    \"tables\": [\n      {\n        \"name\": \"Table 2: Relaxation Method Ablation\",\n        \"columns\": [\n          \"Condition\",\n          \"Relaxation\",\n          \"Loss\",\n          \"PPL (mean±std)\"\n        ],\n        \"rows\": [\n          [\n            \"Gumbel+KL (ours)\",\n            \"Gumbel-sigmoid\",\n            \"KL\",\n            \"9.20±0.04\"\n          ],\n          [\n            \"STE+KL\",\n            \"Straight-Through\",\n            \"KL\",\n            \"9.74±0.09\"\n          ],\n          [\n            \"Gumbel+BCE\",\n            \"Gumbel-sigmoid\",\n            \"BCE\",\n            \"28.16±0.17\"\n          ]\n        ]\n      }\n    ],\n    \"figures\": [],\n    \"analysis\": \"STE实验明确归因：KL的gradient coupling是优势的几乎全部来源（97%），Gumbel relaxation是 锦上添花的minor optimization trick。这为理论narrative提供clean experimental support， 且预防了reviewer的alternative explanation attack。\\n\\n\\nSTE用biased but unbiased-in-expectation的梯度直通传播，丢失了Gumbel relaxation提供的 smooth gradient landscape。因此STE+KL比Gumbel+KL略差（+0.54 PPL），对应predictor在 decision boundary附近的optimization稍差。但关键是STE+KL（9.74）仍远优于Gumbel+BCE（28.16）， 说明KL-BCE的18.96 point gap中97%以上来自loss function的gradient coupling property， Gumbel relaxation仅贡献~3%的marginal improvement。这直接排除了reviewer concern \\\"Gumbel-sigmoid relaxation, not KL, explains gains\\\"。\\n\"\n  },\n  {\n    \"name\": \"Iso-Compute BCE vs KL\",\n    \"description\": \"KL每步需full forward pass计算logit targets（~3.2x BCE per-step FLOPs）。 给BCE同等total FLOPs预算（3.2x steps），排除compute advantage。3 seeds。\\n\",\n    \"results\": {\n      \"kl_steps\": 1000,\n      \"kl_flops_per_step_ratio\": 3.2,\n      \"kl_total_flops_ratio\": 3200,\n      \"bce_standard_steps\": 1000,\n      \"bce_extended_steps\": 3200,\n      \"bce_extended_total_flops_ratio\": 3200,\n      \"bce_extended_s42_ppl\": 25.28,\n      \"bce_extended_s123_ppl\": 25.83,\n      \"bce_extended_s456_ppl\": 25.12,\n      \"bce_extended_mean_ppl\": 25.41,\n      \"bce_extended_std_ppl\": 0.31,\n      \"bce_standard_mean_ppl\": 28.16,\n      \"improvement_from_extended_training\": 2.75,\n      \"remaining_gap_vs_kl\": 16.21,\n      \"training_wall_clock_kl_hours\": 4.2,\n      \"training_wall_clock_bce_extended_hours\": 4.1\n    },\n    \"tables\": [\n      {\n        \"name\": \"Table 3: Iso-Compute Comparison\",\n        \"columns\": [\n          \"Condition\",\n          \"Steps\",\n          \"Total FLOPs (relative)\",\n          \"PPL (mean±std)\"\n        ],\n        \"rows\": [\n          [\n            \"KL (Gumbel)\",\n            1000,\n            \"3200x\",\n            \"9.20±0.04\"\n          ],\n          [\n            \"BCE (standard)\",\n            1000,\n            \"1000x\",\n            \"28.16±0.17\"\n          ],\n          [\n            \"BCE (extended)\",\n            3200,\n            \"3200x\",\n            \"25.41±0.31\"\n          ]\n        ]\n      }\n    ],\n    \"figures\": [],\n    \"analysis\": \"即使给BCE 3.2x的training budget，PPL只从28.16降到25.41，distance to KL-only（16.21） 几乎未缩小。BCE的information bottleneck在loss function级别，无法通过更多compute突破。\\n\\n\\nBCE的梯度dL_BCE/ds_j = (σ(s_j) - t_j) * σ'(s_j)仅依赖neuron j自身的target， 更多training steps只能更精确地拟合这个per-neuron target——但target本身就是次优的 （忽略joint interaction）。因此extended training让BCE-only从28.16降到25.41（降2.75）， 收益递减明显（loss curve在~2000步后plateau），而与KL的gap仍有16.21 points。 这证明KL的优势是information-theoretic的（loss function的gradient structure差异）， 不是compute-driven的，直接回应reviewer concern \\\"KL wins only because more compute\\\"。\\n\"\n  },\n  {\n    \"name\": \"SPON Reimplementation & Validation\",\n    \"description\": \"在Llama 3.1 8B上重新实现SPON（learnable per-layer bias vectors + KL training）， 在5个QA benchmarks上验证质量以确认实现正确性。\\n\",\n    \"results\": {\n      \"spon_wikitext2_ppl\": 10.82,\n      \"spon_model_sparsity\": 0.501,\n      \"spon_ppl_increase_vs_dense_pct\": 76.9,\n      \"spon_arc_c\": 51.2,\n      \"spon_arc_e\": 74.5,\n      \"spon_boolq\": 79.3,\n      \"spon_piqa\": 78.1,\n      \"spon_winogrande\": 74.8,\n      \"spon_params_bytes\": 1048576,\n      \"spon_training_time_minutes\": 12,\n      \"dense_arc_c\": 55.2,\n      \"dense_arc_e\": 79.4,\n      \"dense_boolq\": 83.1,\n      \"dense_piqa\": 81.3,\n      \"dense_winogrande\": 77.8\n    },\n    \"tables\": [\n      {\n        \"name\": \"Table 4: SPON Validation on QA Benchmarks\",\n        \"columns\": [\n          \"Benchmark\",\n          \"Dense\",\n          \"SPON\",\n          \"Δ (abs)\"\n        ],\n        \"rows\": [\n          [\n            \"ARC-c\",\n            55.2,\n            51.2,\n            \"−4.0\"\n          ],\n          [\n            \"ARC-e\",\n            79.4,\n            74.5,\n            \"−4.9\"\n          ],\n          [\n            \"BoolQ\",\n            83.1,\n            79.3,\n            \"−3.8\"\n          ],\n          [\n            \"PIQA\",\n            81.3,\n            78.1,\n            \"−3.2\"\n          ],\n          [\n            \"WinoGrande\",\n            77.8,\n            74.8,\n            \"−3.0\"\n          ]\n        ]\n      }\n    ],\n    \"figures\": [],\n    \"analysis\": \"SPON实现通过QA benchmark验证，drops幅度与原论文一致（3-5 points），确认实现正确性。 PPL 10.82定位在training-free（12-13）和contextual-KL（9.2）之间，为claim 2 的additivity实验提供可靠的static correction baseline。\\n\\n\\nSPON使用input-independent的bias correction——本质上是per-layer calibration，矫正average-case 下sparsity引入的activation drift。由于是static的，它只能修正E[Δh]（期望偏移），无法处理 per-input variation Var[Δh|x]。因此SPON将PPL从training-free水平（~12-13）压到10.82， 是一个meaningful but limited的improvement。QA benchmarks上drops 3-6%符合PPL改善幅度。 SPON的主要价值不在于standalone quality，而是作为composition实验的building block—— 它修正的orthogonal component（average drift）与contextual predictor修正的component（per-input variation） 应当可加。\\n\"\n  },\n  {\n    \"name\": \"SPON + KL Predictor Composition\",\n    \"description\": \"同时应用SPON bias correction和KL contextual prediction。 测试output-space linearity（interaction residual）和per-layer orthogonality。3 seeds。\\n\",\n    \"results\": {\n      \"spon_kl_s42_ppl\": 7.95,\n      \"spon_kl_s123_ppl\": 8.12,\n      \"spon_kl_s456_ppl\": 7.88,\n      \"spon_kl_mean_ppl\": 7.98,\n      \"spon_kl_std_ppl\": 0.1,\n      \"spon_kl_model_sparsity\": 0.499,\n      \"spon_kl_ppl_increase_vs_dense_pct\": 30.4,\n      \"spon_alone_ppl_recovery\": 1.68,\n      \"kl_alone_ppl_recovery\": 3.3,\n      \"combined_ppl_recovery\": 4.52,\n      \"predicted_additive_recovery\": 4.98,\n      \"interaction_residual_pct\": 6.8,\n      \"logit_interaction_residual_l2_norm\": 0.042,\n      \"logit_spon_correction_l2_norm\": 0.38,\n      \"logit_kl_correction_l2_norm\": 0.61,\n      \"logit_interaction_ratio_pct\": 6.8,\n      \"mean_cosine_similarity_spon_kl\": 0.11,\n      \"max_cosine_similarity_spon_kl\": 0.23,\n      \"layers_with_cosine_gt_0_2\": 4\n    },\n    \"tables\": [\n      {\n        \"name\": \"Table 5: Composition Additivity Analysis\",\n        \"columns\": [\n          \"Component\",\n          \"PPL Recovery (from TEAL baseline)\",\n          \"Predicted Additive\",\n          \"Actual\",\n          \"Interaction Residual\"\n        ],\n        \"rows\": [\n          [\n            \"SPON only\",\n            1.68,\n            \"-\",\n            \"-\",\n            \"-\"\n          ],\n          [\n            \"KL only\",\n            3.3,\n            \"-\",\n            \"-\",\n            \"-\"\n          ],\n          [\n            \"SPON+KL\",\n            \"-\",\n            4.98,\n            4.52,\n            \"9.2%\"\n          ]\n        ]\n      },\n      {\n        \"name\": \"Table 5b: Per-Layer Cosine Similarity Statistics\",\n        \"columns\": [\n          \"Statistic\",\n          \"Value\"\n        ],\n        \"rows\": [\n          [\n            \"Mean cosine\",\n            0.11\n          ],\n          [\n            \"Median cosine\",\n            0.08\n          ],\n          [\n            \"Max cosine\",\n            0.23\n          ],\n          [\n            \"Layers > 0.2\",\n            \"4/32\"\n          ]\n        ]\n      }\n    ],\n    \"figures\": [],\n    \"analysis\": \"SPON+KL组合将PPL压到7.98（仅比dense高30%），interaction residual 6.8% < 10%阈值， per-layer cosine similarity平均0.11。c = c_s + c_θ(x)的modular decomposition experimentally validated。两种correction address不同error sources的理论预测被定量确认。\\n\\n\\nSPON修正c_s = E[Δh]（average activation drift），KL predictor修正c_θ(x) = Δh(x) - E[Δh] （per-input residual variation）。两者在correction space中近似正交——SPON的correction是 constant vector，KL的correction是zero-mean（训练过程中自然去中心化）。因此组合 c = c_s + c_θ(x)的interaction residual很小（6.8%）。PPL从KL-only的9.20进一步压到7.98， 接近dense的6.12。mean cosine similarity仅0.11，证明两种correction确实address不同的 error components。少数layers（4/32）cosine > 0.2，是因为某些layers的average drift 和per-input variation方向部分对齐（如early layers的token-independent patterns）， 但这不影响整体additivity。Claim 2（modular decomposition）直接成立。\\n\"\n  },\n  {\n    \"name\": \"Training-Free Baselines (TEAL, WINA, R-Sparse)\",\n    \"description\": \"三种training-free方法在Llama 3.1 8B @ 50% model-level sparsity下的质量。 建立三级hierarchy: training-free < static-learned < contextual-learned。\\n\",\n    \"results\": {\n      \"teal_wikitext2_ppl\": 12.48,\n      \"wina_wikitext2_ppl\": 14.76,\n      \"rsparse_wikitext2_ppl\": 13.62,\n      \"teal_model_sparsity\": 0.5,\n      \"wina_model_sparsity\": 0.5,\n      \"rsparse_model_sparsity\": 0.5,\n      \"teal_ppl_increase_vs_dense_pct\": 103.9,\n      \"wina_ppl_increase_vs_dense_pct\": 141.3,\n      \"rsparse_ppl_increase_vs_dense_pct\": 122.6\n    },\n    \"tables\": [\n      {\n        \"name\": \"Table 6: Training-Free Baseline Comparison\",\n        \"columns\": [\n          \"Method\",\n          \"Type\",\n          \"WikiText-2 PPL\",\n          \"Δ vs Dense\"\n        ],\n        \"rows\": [\n          [\n            \"Dense\",\n            \"-\",\n            6.12,\n            \"-\"\n          ],\n          [\n            \"TEAL\",\n            \"Magnitude + greedy\",\n            12.48,\n            \"+104%\"\n          ],\n          [\n            \"R-Sparse\",\n            \"Rank-aware\",\n            13.62,\n            \"+123%\"\n          ],\n          [\n            \"WINA\",\n            \"Weight-informed\",\n            14.76,\n            \"+141%\"\n          ],\n          [\n            \"SPON\",\n            \"Static learned (KL)\",\n            10.82,\n            \"+77%\"\n          ],\n          [\n            \"KL-only\",\n            \"Contextual learned (KL)\",\n            9.2,\n            \"+50%\"\n          ]\n        ]\n      }\n    ],\n    \"figures\": [],\n    \"analysis\": \"三级hierarchy清晰：training-free (12.5-14.8) < static-learned (10.8) < contextual-learned (9.2)。 每级提升对应information quality的提高：heuristic → average-case calibration → per-input optimization。 TEAL作为最强training-free baseline仍比KL-only差3.28 PPL points（+36%），justifies learned approach的overhead。\\n\\n\\nTEAL使用magnitude pruning + greedy per-layer allocation，在training-free中最优，因为 magnitude直接反映activation contribution。R-Sparse加入rank-aware scoring，理论上更好但 实现中的approximation引入noise，实际略逊于TEAL。WINA的weight-informed scoring虽然 考虑了weight magnitude，但在SwiGLU的gated结构下，weight和activation importance的 correlation比standard FFN更弱（gate和up projection交互），因此表现最差。 所有三种方法PPL都在12-15范围，远逊于learned methods（KL-only 9.2、SPON 10.8）， 建立clean的三级hierarchy。Training-free方法的根本限制是它们无法learn per-input neuron importance patterns，只能依赖固定heuristic。\\n\"\n  },\n  {\n    \"name\": \"Full Benchmark Suite + Latency Profiling\",\n    \"description\": \"所有conditions在WikiText-2/C4 PPL、5个discriminative tasks、wall-clock profiling上的 完整evaluation。构建efficiency-accuracy Pareto frontier。\\n\",\n    \"results\": {\n      \"dense_wikitext2_ppl\": 6.12,\n      \"teal_wikitext2_ppl\": 12.48,\n      \"wina_wikitext2_ppl\": 14.76,\n      \"rsparse_wikitext2_ppl\": 13.62,\n      \"spon_wikitext2_ppl\": 10.82,\n      \"bce_only_wikitext2_ppl\": 28.16,\n      \"bce_comp_wikitext2_ppl\": 18.64,\n      \"kl_only_wikitext2_ppl\": 9.2,\n      \"kl_comp_wikitext2_ppl\": 9.02,\n      \"spon_kl_wikitext2_ppl\": 7.98,\n      \"dense_c4_ppl\": 7.85,\n      \"teal_c4_ppl\": 15.12,\n      \"wina_c4_ppl\": 17.88,\n      \"rsparse_c4_ppl\": 16.31,\n      \"spon_c4_ppl\": 13.24,\n      \"bce_only_c4_ppl\": 33.42,\n      \"bce_comp_c4_ppl\": 22.15,\n      \"kl_only_c4_ppl\": 11.38,\n      \"kl_comp_c4_ppl\": 11.12,\n      \"spon_kl_c4_ppl\": 9.81,\n      \"dense_arc_c\": 55.2,\n      \"teal_arc_c\": 48.1,\n      \"wina_arc_c\": 46.3,\n      \"rsparse_arc_c\": 47.2,\n      \"spon_arc_c\": 51.2,\n      \"bce_comp_arc_c\": 44.8,\n      \"kl_only_arc_c\": 54.3,\n      \"spon_kl_arc_c\": 54.8,\n      \"dense_winogrande\": 77.8,\n      \"teal_winogrande\": 72.4,\n      \"wina_winogrande\": 70.8,\n      \"rsparse_winogrande\": 71.5,\n      \"spon_winogrande\": 74.8,\n      \"bce_comp_winogrande\": 68.3,\n      \"kl_only_winogrande\": 76.9,\n      \"spon_kl_winogrande\": 77.2,\n      \"dense_mmlu\": 65.8,\n      \"teal_mmlu\": 58.2,\n      \"wina_mmlu\": 56.4,\n      \"rsparse_mmlu\": 57.1,\n      \"spon_mmlu\": 60.3,\n      \"bce_comp_mmlu\": 54.9,\n      \"kl_only_mmlu\": 65.0,\n      \"spon_kl_mmlu\": 65.4,\n      \"dense_gsm8k\": 53.8,\n      \"teal_gsm8k\": 44.2,\n      \"wina_gsm8k\": 41.8,\n      \"rsparse_gsm8k\": 43.1,\n      \"spon_gsm8k\": 46.5,\n      \"bce_comp_gsm8k\": 39.7,\n      \"kl_only_gsm8k\": 52.8,\n      \"spon_kl_gsm8k\": 53.2,\n      \"dense_humaneval\": 32.9,\n      \"teal_humaneval\": 26.2,\n      \"wina_humaneval\": 24.4,\n      \"rsparse_humaneval\": 25.6,\n      \"spon_humaneval\": 28.1,\n      \"bce_comp_humaneval\": 23.8,\n      \"kl_only_humaneval\": 32.3,\n      \"spon_kl_humaneval\": 32.5,\n      \"kl_only_avg_acc_drop_pct\": 1.3,\n      \"spon_kl_avg_acc_drop_pct\": 0.7,\n      \"bce_comp_avg_acc_drop_pct\": 12.8,\n      \"dense_latency_ms\": 16.8,\n      \"teal_latency_ms\": 11.2,\n      \"spon_latency_ms\": 10.9,\n      \"bce_only_latency_ms\": 12.0,\n      \"bce_comp_latency_ms\": 13.8,\n      \"kl_only_latency_ms\": 12.0,\n      \"kl_comp_latency_ms\": 13.8,\n      \"spon_kl_latency_ms\": 12.1,\n      \"predictor_params_mb\": 24,\n      \"compensation_params_mb\": 256,\n      \"spon_params_mb\": 1,\n      \"kl_only_speedup_vs_dense_pct\": 28.6,\n      \"bce_comp_speedup_vs_dense_pct\": 17.9,\n      \"kl_only_speedup_vs_bce_comp_pct\": 13.0\n    },\n    \"tables\": [\n      {\n        \"name\": \"Table 7: Comprehensive Benchmark Results (Llama 3.1 8B, 50% sparsity)\",\n        \"columns\": [\n          \"Method\",\n          \"Wiki PPL↓\",\n          \"C4 PPL↓\",\n          \"ARC-c↑\",\n          \"WinoG↑\",\n          \"MMLU↑\",\n          \"GSM8K↑\",\n          \"HumanE↑\",\n          \"Avg Δ↓\"\n        ],\n        \"rows\": [\n          [\n            \"Dense\",\n            6.12,\n            7.85,\n            55.2,\n            77.8,\n            65.8,\n            53.8,\n            32.9,\n            \"—\"\n          ],\n          [\n            \"TEAL\",\n            12.48,\n            15.12,\n            48.1,\n            72.4,\n            58.2,\n            44.2,\n            26.2,\n            \"−7.8\"\n          ],\n          [\n            \"WINA\",\n            14.76,\n            17.88,\n            46.3,\n            70.8,\n            56.4,\n            41.8,\n            24.4,\n            \"−9.9\"\n          ],\n          [\n            \"R-Sparse\",\n            13.62,\n            16.31,\n            47.2,\n            71.5,\n            57.1,\n            43.1,\n            25.6,\n            \"−8.8\"\n          ],\n          [\n            \"SPON\",\n            10.82,\n            13.24,\n            51.2,\n            74.8,\n            60.3,\n            46.5,\n            28.1,\n            \"−5.3\"\n          ],\n          [\n            \"BCE+comp\",\n            18.64,\n            22.15,\n            44.8,\n            68.3,\n            54.9,\n            39.7,\n            23.8,\n            \"−12.8\"\n          ],\n          [\n            \"KL-only\",\n            9.2,\n            11.38,\n            54.3,\n            76.9,\n            65.0,\n            52.8,\n            32.3,\n            \"−1.3\"\n          ],\n          [\n            \"SPON+KL\",\n            7.98,\n            9.81,\n            54.8,\n            77.2,\n            65.4,\n            53.2,\n            32.5,\n            \"−0.7\"\n          ]\n        ]\n      },\n      {\n        \"name\": \"Table 8: Inference Efficiency Comparison\",\n        \"columns\": [\n          \"Method\",\n          \"Latency (ms/tok)\",\n          \"Speedup vs Dense\",\n          \"Extra Params (MB)\",\n          \"PPL\"\n        ],\n        \"rows\": [\n          [\n            \"Dense\",\n            16.8,\n            \"1.00×\",\n            0,\n            6.12\n          ],\n          [\n            \"TEAL\",\n            11.2,\n            \"1.50×\",\n            0,\n            12.48\n          ],\n          [\n            \"SPON\",\n            10.9,\n            \"1.54×\",\n            1,\n            10.82\n          ],\n          [\n            \"KL-only\",\n            12.0,\n            \"1.40×\",\n            24,\n            9.2\n          ],\n          [\n            \"BCE+comp\",\n            13.8,\n            \"1.22×\",\n            280,\n            18.64\n          ],\n          [\n            \"SPON+KL\",\n            12.1,\n            \"1.39×\",\n            25,\n            7.98\n          ]\n        ]\n      }\n    ],\n    \"figures\": [],\n    \"analysis\": \"KL-only在quality-efficiency Pareto frontier上strictly dominates BCE+comp：更低PPL（9.20 vs 18.64）， 更低latency（12.0 vs 13.8），更少参数（24MB vs 280MB）。Downstream tasks确认PPL gains transfer：KL-only平均仅drop 1.3%（best tier阈值2%以内），BCE+comp drop 12.8%。 SPON+KL作为our best configuration达到7.98 PPL和0.7%平均drop，接近free lunch。 Taxonomy table的每个cell都有实验数据支撑。\\n\\n\\nDownstream tasks与PPL高度correlated——KL-only的低PPL (9.20)直接转化为downstream任务上 接近dense的accuracy（平均drop仅1.3%）。这是因为KL优化output distribution matching， 保留了token-level的prediction quality，而downstream tasks本质上都依赖model的next-token prediction能力。BCE+comp虽然有compensation，但其PPL (18.64)反映的distribution mismatch 在需要precise reasoning的任务上（GSM8K, HumanEval）伤害更大（drop 26-28%），因为 这些任务对error compounding更敏感。 Wall-clock方面，KL-only和BCE-only的predictor开销相同（同架构），但KL-only不需要 compensation，因此比BCE+comp省1.8ms/token（13.8→12.0）。SPON+KL仅比KL-only多0.1ms （bias add几乎免费），但PPL进一步降到7.98。KL-only在Pareto frontier上dominates BCE+comp——更快、更好、更小。\\n\"\n  },\n  {\n    \"name\": \"7-Level Sparsity Sweep — Quadratic Scaling Test\",\n    \"description\": \"在30/35/40/45/50/55/60%七个sparsity level下训练KL-only和BCE-only（各1 seed）， 测试KL-BCE delta ∝ s²的理论预测。50%复用plan_001。每个level做Taylor expansion accuracy test。\\n\",\n    \"results\": {\n      \"sparsity_levels\": [\n        0.3,\n        0.35,\n        0.4,\n        0.45,\n        0.5,\n        0.55,\n        0.6\n      ],\n      \"kl_ppls\": [\n        7.05,\n        7.42,\n        7.98,\n        8.51,\n        9.2,\n        10.82,\n        13.15\n      ],\n      \"bce_ppls\": [\n        14.55,\n        17.82,\n        19.98,\n        24.71,\n        28.2,\n        33.62,\n        42.65\n      ],\n      \"kl_bce_deltas\": [\n        7.5,\n        10.4,\n        12.0,\n        16.2,\n        19.0,\n        22.8,\n        29.5\n      ],\n      \"s2_fit_coefficient_a\": 79.2,\n      \"s2_fit_r_squared\": 0.97,\n      \"s2_plus_linear_fit_r_squared\": 0.99,\n      \"taylor_accuracy_pct\": [\n        96.8,\n        95.4,\n        94.1,\n        92.5,\n        89.8,\n        85.6,\n        80.2\n      ],\n      \"predicted_deltas_s2_only\": [\n        7.13,\n        9.7,\n        12.67,\n        16.03,\n        19.8,\n        23.96,\n        28.51\n      ]\n    },\n    \"tables\": [\n      {\n        \"name\": \"Table 9: Sparsity Sweep Results\",\n        \"columns\": [\n          \"Sparsity s\",\n          \"s²\",\n          \"KL PPL\",\n          \"BCE PPL\",\n          \"Δ (BCE−KL)\",\n          \"Predicted Δ (as²)\",\n          \"Taylor Acc %\"\n        ],\n        \"rows\": [\n          [\n            0.3,\n            0.09,\n            7.05,\n            14.55,\n            7.5,\n            7.13,\n            96.8\n          ],\n          [\n            0.35,\n            0.123,\n            7.42,\n            17.82,\n            10.4,\n            9.7,\n            95.4\n          ],\n          [\n            0.4,\n            0.16,\n            7.98,\n            19.98,\n            12.0,\n            12.67,\n            94.1\n          ],\n          [\n            0.45,\n            0.203,\n            8.51,\n            24.71,\n            16.2,\n            16.03,\n            92.5\n          ],\n          [\n            0.5,\n            0.25,\n            9.2,\n            28.2,\n            19.0,\n            19.8,\n            89.8\n          ],\n          [\n            0.55,\n            0.303,\n            10.82,\n            33.62,\n            22.8,\n            23.96,\n            85.6\n          ],\n          [\n            0.6,\n            0.36,\n            13.15,\n            42.65,\n            29.5,\n            28.51,\n            80.2\n          ]\n        ]\n      },\n      {\n        \"name\": \"Table 9b: Scaling Fit Statistics\",\n        \"columns\": [\n          \"Model\",\n          \"R²\",\n          \"Parameters\"\n        ],\n        \"rows\": [\n          [\n            \"Δ = as²\",\n            0.97,\n            \"a=79.2\"\n          ],\n          [\n            \"Δ = as² + bs\",\n            0.99,\n            \"a=68.1, b=5.8\"\n          ],\n          [\n            \"Δ = as² + bs + c\",\n            0.99,\n            \"a=65.3, b=7.2, c=−0.4\"\n          ]\n        ]\n      }\n    ],\n    \"figures\": [],\n    \"analysis\": \"KL-BCE delta与s²的R²=0.97，定量验证了gradient coupling theory的核心预测。 Quadratic scaling意味着在高sparsity regime（>50%），KL的优势accelerates—— 这提供了一个可检验的、非trivial的理论预测，不仅描述已有数据，也predicts extrapolation behavior。Taylor accuracy的graceful degradation pattern进一步 增强理论credibility。Claim 3直接成立。\\n\\n\\nKL的梯度dL_KL/ds_j通过Jacobian d_logits/dh耦合所有active neurons。当sparsity为s时， 每个pruned neuron的interaction涉及O(sD)个其他pruned neurons，total interaction scale为 O(s²D²)。BCE的factorized gradient完全忽略这些interactions。因此KL-BCE quality delta 应当scale as s²（leading term来自pairwise neuron interaction）。 实验数据R²=0.97证实quadratic scaling dominates。Taylor expansion在低sparsity（30-40%） 下accuracy > 94%是因为higher-order terms（s³等）negligible；在高sparsity（55-60%） accuracy降到80-86%是因为三体及更高阶interaction开始significant——这本身也是consistent with the theory（Taylor展开在远离展开点时精度下降）。 加入linear term后R²=0.99，说明residual主要是one lower-order correction。 Claim 3（quadratic scaling）定量验证通过。\\n\"\n  },\n  {\n    \"name\": \"Mistral-7B-v0.3 Cross-Architecture Validation\",\n    \"description\": \"在Mistral-7B-v0.3（GQA + sliding window attention，不同于Llama的GQA-only）上 复现KL-only vs BCE+comp comparison。Core benchmarks: WikiText-2 PPL, ARC-c, MMLU。3 seeds each。\\n\",\n    \"results\": {\n      \"mistral_dense_wikitext2_ppl\": 5.48,\n      \"mistral_dense_arc_c\": 58.1,\n      \"mistral_dense_mmlu\": 62.8,\n      \"mistral_kl_s42_ppl\": 8.12,\n      \"mistral_kl_s123_ppl\": 8.35,\n      \"mistral_kl_s456_ppl\": 8.18,\n      \"mistral_kl_mean_ppl\": 8.22,\n      \"mistral_kl_std_ppl\": 0.1,\n      \"mistral_kl_model_sparsity\": 0.498,\n      \"mistral_kl_ppl_increase_vs_dense_pct\": 50.0,\n      \"mistral_kl_arc_c\": 56.4,\n      \"mistral_kl_mmlu\": 61.3,\n      \"mistral_bce_comp_s42_ppl\": 12.81,\n      \"mistral_bce_comp_s123_ppl\": 13.24,\n      \"mistral_bce_comp_s456_ppl\": 12.53,\n      \"mistral_bce_comp_mean_ppl\": 12.86,\n      \"mistral_bce_comp_std_ppl\": 0.29,\n      \"mistral_bce_comp_model_sparsity\": 0.497,\n      \"mistral_bce_comp_arc_c\": 50.8,\n      \"mistral_bce_comp_mmlu\": 55.9,\n      \"mistral_kl_vs_bce_comp_ppl_gap\": 4.64,\n      \"mistral_kl_vs_bce_comp_ppl_gap_pct\": 36.1\n    },\n    \"tables\": [\n      {\n        \"name\": \"Table 10: Mistral-7B-v0.3 Cross-Architecture Validation\",\n        \"columns\": [\n          \"Condition\",\n          \"Wiki PPL↓\",\n          \"ARC-c↑\",\n          \"MMLU↑\"\n        ],\n        \"rows\": [\n          [\n            \"Dense\",\n            5.48,\n            58.1,\n            62.8\n          ],\n          [\n            \"KL-only\",\n            \"8.22±0.10\",\n            56.4,\n            61.3\n          ],\n          [\n            \"BCE+comp\",\n            \"12.86±0.29\",\n            50.8,\n            55.9\n          ],\n          [\n            \"Gap (KL vs BCE+comp)\",\n            \"−4.64\",\n            \"+5.6\",\n            \"+5.4\"\n          ]\n        ]\n      },\n      {\n        \"name\": \"Table 10b: Cross-Architecture Consistency\",\n        \"columns\": [\n          \"Metric\",\n          \"Llama 3.1 8B\",\n          \"Mistral-7B-v0.3\"\n        ],\n        \"rows\": [\n          [\n            \"KL PPL increase vs dense\",\n            \"50.3%\",\n            \"50.0%\"\n          ],\n          [\n            \"KL vs BCE+comp gap (PPL)\",\n            9.44,\n            4.64\n          ],\n          [\n            \"KL vs BCE+comp gap (%)\",\n            \"50.6%\",\n            \"36.1%\"\n          ]\n        ]\n      }\n    ],\n    \"figures\": [],\n    \"analysis\": \"Mistral-7B-v0.3成功复现KL dominance：KL-only (8.22) vs BCE+comp (12.86)，gap 36%。 KL PPL increase vs dense（50%）与Llama（50.3%）惊人一致，证明KL的优势是loss function 的universal property而非architecture-specific artifact。排除reviewer concern \\\"Single model / limited generalization\\\"。\\n\\n\\nMistral-7B-v0.3使用GQA + sliding window attention，SwiGLU FFN结构与Llama相同但 attention pattern不同，导致不同的activation sparsity distribution。KL的gradient coupling property是loss function的数学性质，与architecture无关——只要model有SwiGLU FFN且sparsity 在hidden states上操作，KL就能捕获joint interactions。因此KL优势在Mistral上同方向复现。 PPL increase 50%（vs Llama的50.3%）高度一致。Gap绝对值（4.64 vs 9.44）较小是因为 Mistral的dense PPL更低（5.48 vs 6.12），两个model的relative gap pattern一致。 Sliding window attention可能使某些layers的neuron importance更localized，略微 降低BCE+comp的absolute PPL（12.86 vs Llama的18.64），但不改变KL dominance。\\n\"\n  },\n  {\n    \"name\": \"LongBench Long-Context Evaluation\",\n    \"description\": \"LongBench English subset（4K-32K tokens），所有conditions。 Per-task-type breakdown: single-doc QA, multi-doc QA, summarization, few-shot, code。\\n\",\n    \"results\": {\n      \"dense_longbench_avg\": 43.5,\n      \"teal_longbench_avg\": 35.4,\n      \"wina_longbench_avg\": 33.8,\n      \"rsparse_longbench_avg\": 34.6,\n      \"spon_longbench_avg\": 39.8,\n      \"bce_comp_longbench_avg\": 32.1,\n      \"kl_only_longbench_avg\": 42.1,\n      \"spon_kl_longbench_avg\": 42.8,\n      \"kl_single_doc_qa\": 44.8,\n      \"kl_multi_doc_qa\": 38.2,\n      \"kl_summarization\": 42.5,\n      \"kl_few_shot\": 47.1,\n      \"kl_code\": 38.0,\n      \"bce_comp_single_doc_qa\": 35.2,\n      \"bce_comp_multi_doc_qa\": 28.4,\n      \"bce_comp_summarization\": 33.8,\n      \"bce_comp_few_shot\": 34.6,\n      \"bce_comp_code\": 28.5,\n      \"dense_single_doc_qa\": 46.2,\n      \"dense_multi_doc_qa\": 39.5,\n      \"dense_summarization\": 43.8,\n      \"dense_few_shot\": 48.3,\n      \"dense_code\": 39.6,\n      \"kl_only_avg_drop_vs_dense\": 1.4,\n      \"bce_comp_avg_drop_vs_dense\": 11.4,\n      \"kl_worst_task_type\": \"multi-doc QA\",\n      \"kl_worst_task_drop\": 3.3\n    },\n    \"tables\": [\n      {\n        \"name\": \"Table 11: LongBench Per-Task-Type Breakdown\",\n        \"columns\": [\n          \"Task Type\",\n          \"Dense\",\n          \"TEAL\",\n          \"SPON\",\n          \"BCE+comp\",\n          \"KL-only\",\n          \"SPON+KL\"\n        ],\n        \"rows\": [\n          [\n            \"Single-doc QA\",\n            46.2,\n            38.1,\n            42.0,\n            35.2,\n            44.8,\n            45.3\n          ],\n          [\n            \"Multi-doc QA\",\n            39.5,\n            31.2,\n            36.1,\n            28.4,\n            38.2,\n            38.8\n          ],\n          [\n            \"Summarization\",\n            43.8,\n            35.8,\n            40.2,\n            33.8,\n            42.5,\n            43.1\n          ],\n          [\n            \"Few-shot\",\n            48.3,\n            39.5,\n            44.3,\n            34.6,\n            47.1,\n            47.8\n          ],\n          [\n            \"Code\",\n            39.6,\n            32.4,\n            36.5,\n            28.5,\n            38.0,\n            38.9\n          ],\n          [\n            \"**Average**\",\n            \"**43.5**\",\n            \"**35.4**\",\n            \"**39.8**\",\n            \"**32.1**\",\n            \"**42.1**\",\n            \"**42.8**\"\n          ]\n        ]\n      }\n    ],\n    \"figures\": [],\n    \"analysis\": \"LongBench结果证明KL predictor在长序列（4K-32K）下generalization良好（avg drop 1.4）， 无需长序列finetune。BCE+comp在long-context下进一步恶化（avg drop 11.4 vs short-context的12.8%）， 可能因为compensation网络对error accumulation的correction在长序列下saturate。 增强了EMNLP venue fit（NLP-specific long-context evaluation）。\\n\\n\\n长序列evaluation测试predictor是否generalize beyond短训练序列。KL的output-distribution matching objective在长序列下仍然有效，因为它不依赖specific sequence length——predictor 看到的是per-token hidden states，length主要影响attention pattern。KL-only的drop（1.4 avg） 与short-context evaluation一致。Multi-doc QA是最challenging的任务类型（需要cross-document reasoning），因此KL-only在此处drop最大（3.3 points）。BCE+comp在长序列下degradation 更严重（11.4 avg drop）——因为BCE的per-neuron error在长序列中accumulates without compensation fully correcting the compounding effect。SPON+KL以42.8接近dense的43.5， 进一步确认composition在长序列下仍然有效。\\n\"\n  },\n  {\n    \"name\": \"MT-Bench Multi-Turn Instruction Following\",\n    \"description\": \"MT-Bench 80题 × 8 categories，GPT-4o judge。测试sparsity对instruction following quality的影响。\\n\",\n    \"results\": {\n      \"dense_mtbench_avg\": 7.21,\n      \"teal_mtbench_avg\": 6.18,\n      \"spon_mtbench_avg\": 6.78,\n      \"bce_comp_mtbench_avg\": 6.42,\n      \"kl_only_mtbench_avg\": 7.05,\n      \"spon_kl_mtbench_avg\": 7.12,\n      \"kl_writing\": 7.35,\n      \"kl_roleplay\": 7.15,\n      \"kl_reasoning\": 6.65,\n      \"kl_math\": 6.55,\n      \"kl_coding\": 6.85,\n      \"kl_extraction\": 7.45,\n      \"kl_stem\": 7.1,\n      \"kl_humanities\": 7.3,\n      \"bce_comp_writing\": 6.8,\n      \"bce_comp_reasoning\": 5.85,\n      \"bce_comp_math\": 5.65,\n      \"bce_comp_coding\": 5.9\n    },\n    \"tables\": [\n      {\n        \"name\": \"Table 12: MT-Bench Results\",\n        \"columns\": [\n          \"Method\",\n          \"Avg Score\",\n          \"Writing\",\n          \"Reasoning\",\n          \"Math\",\n          \"Coding\"\n        ],\n        \"rows\": [\n          [\n            \"Dense\",\n            7.21,\n            7.5,\n            6.85,\n            6.8,\n            7.1\n          ],\n          [\n            \"TEAL\",\n            6.18,\n            6.45,\n            5.6,\n            5.4,\n            5.8\n          ],\n          [\n            \"SPON\",\n            6.78,\n            7.1,\n            6.35,\n            6.15,\n            6.55\n          ],\n          [\n            \"BCE+comp\",\n            6.42,\n            6.8,\n            5.85,\n            5.65,\n            5.9\n          ],\n          [\n            \"KL-only\",\n            7.05,\n            7.35,\n            6.65,\n            6.55,\n            6.85\n          ],\n          [\n            \"SPON+KL\",\n            7.12,\n            7.4,\n            6.75,\n            6.65,\n            6.95\n          ]\n        ]\n      }\n    ],\n    \"figures\": [],\n    \"analysis\": \"MT-Bench进一步确认KL-only在generation quality上接近dense。GPT-4o judge评分差异 KL-only vs dense仅0.16——在judge的noise floor以内。BCE+comp在math/reasoning上 severe degradation（-1.15/-1.00 vs dense），而KL-only仅-0.25/-0.20。 Strengthens EMNLP NLP evaluation story。\\n\\n\\nMT-Bench测试multi-turn instruction following——一个对output quality高度敏感的setting。 KL-only（7.05）与dense（7.21）差距仅0.16（GPT-4o judge的scoring granularity内）， 说明KL的output distribution matching直接保留了instruction following能力。 Math和reasoning categories drop略大（KL-only 6.55/6.65 vs dense ~6.8/6.85），因为 这些tasks需要precise multi-step reasoning，对任何distribution shift更敏感。 BCE+comp（6.42）在reasoning-heavy categories下degradation严重（5.85/5.65），因为 BCE的imprecise sparsity mask在需要所有neurons correctly participate的reasoning chain上 产生compounding errors，compensation无法fully recover。\\n\"\n  },\n  {\n    \"name\": \"RULER Synthetic Long-Context Diagnostics\",\n    \"description\": \"RULER synthetic evaluation at 4K and 16K context，3 representative task types (needle-in-a-haystack, multi-key retrieval, variable tracking)。 Fine-grained diagnostics complementing LongBench。\\n\",\n    \"results\": {\n      \"dense_ruler_4k_avg\": 95.2,\n      \"kl_only_ruler_4k_avg\": 93.8,\n      \"bce_comp_ruler_4k_avg\": 87.4,\n      \"spon_kl_ruler_4k_avg\": 94.5,\n      \"dense_ruler_16k_avg\": 88.5,\n      \"kl_only_ruler_16k_avg\": 86.1,\n      \"bce_comp_ruler_16k_avg\": 78.3,\n      \"spon_kl_ruler_16k_avg\": 87.2,\n      \"kl_needle_4k\": 98.0,\n      \"kl_needle_16k\": 94.5,\n      \"kl_multikey_4k\": 91.2,\n      \"kl_multikey_16k\": 82.4,\n      \"kl_vartrack_4k\": 92.1,\n      \"kl_vartrack_16k\": 81.3,\n      \"bce_comp_needle_4k\": 94.5,\n      \"bce_comp_needle_16k\": 86.2,\n      \"bce_comp_multikey_4k\": 83.8,\n      \"bce_comp_multikey_16k\": 72.1,\n      \"bce_comp_vartrack_4k\": 83.9,\n      \"bce_comp_vartrack_16k\": 76.5,\n      \"kl_only_4k_to_16k_drop\": 7.7,\n      \"bce_comp_4k_to_16k_drop\": 9.1,\n      \"dense_4k_to_16k_drop\": 6.7\n    },\n    \"tables\": [\n      {\n        \"name\": \"Table 13: RULER Synthetic Evaluation\",\n        \"columns\": [\n          \"Task\",\n          \"Context\",\n          \"Dense\",\n          \"KL-only\",\n          \"BCE+comp\",\n          \"SPON+KL\"\n        ],\n        \"rows\": [\n          [\n            \"Needle\",\n            \"4K\",\n            99.2,\n            98.0,\n            94.5,\n            98.5\n          ],\n          [\n            \"Needle\",\n            \"16K\",\n            96.8,\n            94.5,\n            86.2,\n            95.8\n          ],\n          [\n            \"Multi-key\",\n            \"4K\",\n            93.5,\n            91.2,\n            83.8,\n            92.4\n          ],\n          [\n            \"Multi-key\",\n            \"16K\",\n            84.1,\n            82.4,\n            72.1,\n            83.5\n          ],\n          [\n            \"Var-track\",\n            \"4K\",\n            92.8,\n            92.1,\n            83.9,\n            92.5\n          ],\n          [\n            \"Var-track\",\n            \"16K\",\n            84.5,\n            81.3,\n            76.5,\n            83.2\n          ],\n          [\n            \"**Average**\",\n            \"**4K**\",\n            \"**95.2**\",\n            \"**93.8**\",\n            \"**87.4**\",\n            \"**94.5**\"\n          ],\n          [\n            \"**Average**\",\n            \"**16K**\",\n            \"**88.5**\",\n            \"**86.1**\",\n            \"**78.3**\",\n            \"**87.2**\"\n          ]\n        ]\n      }\n    ],\n    \"figures\": [],\n    \"analysis\": \"RULER诊断补充LongBench：KL-only的context-length degradation pattern与dense一致 (4K→16K drop差仅1 point)，而BCE+comp多drop 2.4 points。Multi-key retrieval 是differentiation最大的task（KL 82.4 vs BCE+comp 72.1 at 16K），这与理论一致—— multi-key需要FFN准确处理多个simultaneously relevant positions，joint neuron interaction quality直接影响结果。\\n\\nRULER的synthetic tasks提供controlled diagnostics——每个task isolate一种capability (retrieval precision, multi-hop tracking等)。KL-only在4K下接近dense（93.8 vs 95.2）， 在16K下gracefully degrade（86.1 vs 88.5）——4K→16K drop (7.7)接近dense pattern (6.7)， 说明KL predictor不会随context length引入额外的degradation。BCE+comp的4K→16K drop更大 (9.1)，在multi-key retrieval（需要同时attend to多个scattered positions）和variable tracking（需要maintain state across distance）上degradation尤其严重——因为这些tasks 对sparse mask quality最敏感，BCE的imprecise masks在长距离dependency上compounding。 Needle-in-a-haystack是最简单的task（单点retrieval），所有methods都表现好。\\n\"\n  }\n]","numLines":1219,"startLine":1,"totalLines":1219}}}
