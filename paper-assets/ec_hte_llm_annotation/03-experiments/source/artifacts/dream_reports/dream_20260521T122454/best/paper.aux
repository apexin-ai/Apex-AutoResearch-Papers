\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Bias identity empirical verification. $R^2$ measures the proportion of observed subgroup bias variance explained by the $\Delta \pi \times \Delta \tau $ product. Tightness ratio $= |\text  {observed}|/|\text  {predicted}|$; values near 1.0 confirm an exact identity, not a bound. Slight $R^2$ reduction for $K{=}4$ reflects accumulated MC noise across 4 cross-terms, not bound looseness.}}{3}{table.caption.3}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{tab:bias_verify}{{1}{3}{Bias identity empirical verification. $R^2$ measures the proportion of observed subgroup bias variance explained by the $\dpi \times \dtau $ product. Tightness ratio $= |\text {observed}|/|\text {predicted}|$; values near 1.0 confirm an exact identity, not a bound. Slight $R^2$ reduction for $K{=}4$ reflects accumulated MC noise across 4 cross-terms, not bound looseness}{table.caption.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Bias amplification ratio ($|\text  {global bias}|/|\text  {naive bias}|$) by parameter region. Ratios $> 1$ indicate global correction increases bias. DIM estimator: $K{=}2$ amplification exceeds $K{=}4$ because heterogeneity concentrates in one contrast. CausalForest reverses this pattern (Table~\ref {tab:cf_hurts}).}}{3}{table.caption.4}\protected@file@percent }
\newlabel{tab:amplification}{{2}{3}{Bias amplification ratio ($|\text {global bias}|/|\text {naive bias}|$) by parameter region. Ratios $> 1$ indicate global correction increases bias. DIM estimator: $K{=}2$ amplification exceeds $K{=}4$ because heterogeneity concentrates in one contrast. CausalForest reverses this pattern (Table~\ref {tab:cf_hurts})}{table.caption.4}{}}
\newlabel{prop:hurts}{{1}{3}{Debiasing Can Hurt}{proposition.1}{}}
