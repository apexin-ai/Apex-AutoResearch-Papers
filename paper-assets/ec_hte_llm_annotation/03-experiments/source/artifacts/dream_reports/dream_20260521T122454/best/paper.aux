\@writefile{lot}{\contentsline {table}{\numberline {16}{\ignorespaces Allocation strategy comparison ($K{=}4$, extreme regime). CATE-weighted allocation achieves 8--15\% RMSE improvement over uniform at $n{=}100$; gains diminish at larger budgets ($n{=}500$: 2--5\%).}}{9}{table.caption.30}\protected@file@percent }
\newlabel{tab:allocation}{{16}{9}{Allocation strategy comparison ($K{=}4$, extreme regime). CATE-weighted allocation achieves 8--15\% RMSE improvement over uniform at $n{=}100$; gains diminish at larger budgets ($n{=}500$: 2--5\%)}{table.caption.30}{}}
\@writefile{lot}{\contentsline {table}{\numberline {17}{\ignorespaces Coverage under misspecified subgroup structure. HB maintains 0.945--0.960 coverage across all noise levels, gracefully converging to global correction at 50\% noise (when subgroup labels are effectively random).}}{9}{table.caption.31}\protected@file@percent }
\newlabel{tab:robustness}{{17}{9}{Coverage under misspecified subgroup structure. HB maintains 0.945--0.960 coverage across all noise levels, gracefully converging to global correction at 50\% noise (when subgroup labels are effectively random)}{table.caption.31}{}}
\@writefile{lot}{\contentsline {table}{\numberline {18}{\ignorespaces Threshold analysis for the diagnostic criterion (leave-one-setting-out CV). The optimal threshold of 0.035 balances sensitivity and specificity. The asymmetric cost structure (false negatives = unnecessary global correction; false positives = extra expert labels) favors moderate thresholds.}}{9}{table.caption.32}\protected@file@percent }
\newlabel{tab:threshold}{{18}{9}{Threshold analysis for the diagnostic criterion (leave-one-setting-out CV). The optimal threshold of 0.035 balances sensitivity and specificity. The asymmetric cost structure (false negatives = unnecessary global correction; false positives = extra expert labels) favors moderate thresholds}{table.caption.32}{}}
