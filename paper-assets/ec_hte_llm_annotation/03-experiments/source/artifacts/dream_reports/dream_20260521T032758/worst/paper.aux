\newlabel{tab:llm_echte}{{5}{6}{EC-HTE vs.\ global correction by LLM ($n_{\text {expert}}=500$, $K=4$). EC-HTE achieves modest bias reductions (8--22\%) but at substantial RMSE cost (1.7--2.1$\times $). In the homogeneous regime, the bias reduction does not justify the variance increase}{table.caption.16}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Robustness to subgroup label noise (synthetic extreme, $K=4$, $n_{\text  {expert}}=500$). $^\dagger $Ratio vs.\ clean EC-HTE. HB partial pooling provides graceful degradation up to 20\% noise; at 30\%, RMSE becomes 1.58$\times $ the clean baseline.}}{6}{table.caption.17}\protected@file@percent }
\newlabel{tab:robustness_noise}{{6}{6}{Robustness to subgroup label noise (synthetic extreme, $K=4$, $n_{\text {expert}}=500$). $^\dagger $Ratio vs.\ clean EC-HTE. HB partial pooling provides graceful degradation up to 20\% noise; at 30\%, RMSE becomes 1.58$\times $ the clean baseline}{table.caption.17}{}}
