\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces CATE estimates by target demographic subgroup on UC Berkeley Hate Speech data. Mis.\ Rate = GPT-4.1 misclassification rate. Shift = $|\hat  {\tau }^{\text  {global}} - \hat  {\tau }^{\text  {EC-HTE}}|$ in standard error units. EC-HTE shifts CATEs back toward naive estimates for high-error subgroups, consistent with global correction over-correcting these subgroups.}}{6}{table.3}\protected@file@percent }
\newlabel{tab:hate_speech}{{3}{6}{CATE estimates by target demographic subgroup on UC Berkeley Hate Speech data. Mis.\ Rate = GPT-4.1 misclassification rate. Shift = $|\hat {\tau }^{\text {global}} - \hat {\tau }^{\text {EC-HTE}}|$ in standard error units. EC-HTE shifts CATEs back toward naive estimates for high-error subgroups, consistent with global correction over-correcting these subgroups}{table.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Robustness analysis. RMSE and Bias Ratios are relative to correctly-specified EC-HTE. EC-HTE degrades gracefully: up to 20\% label noise retains advantage over global correction; irrelevant subgroups cause minimal harm due to HB shrinkage.}}{6}{table.4}\protected@file@percent }
\newlabel{tab:robustness}{{4}{6}{Robustness analysis. RMSE and Bias Ratios are relative to correctly-specified EC-HTE. EC-HTE degrades gracefully: up to 20\% label noise retains advantage over global correction; irrelevant subgroups cause minimal harm due to HB shrinkage}{table.4}{}}
