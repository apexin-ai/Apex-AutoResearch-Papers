\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces HB shrinkage weights toward the global mean under misspecification. Higher values indicate more pooling. Under irrelevant subgroups, the model correctly pools almost entirely, collapsing to near-global correction.}}{7}{table.5}\protected@file@percent }
\newlabel{tab:shrinkage}{{5}{7}{HB shrinkage weights toward the global mean under misspecification. Higher values indicate more pooling. Under irrelevant subgroups, the model correctly pools almost entirely, collapsing to near-global correction}{table.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Expert annotation allocation strategies ($K\!=\!4$ extreme regime). CATE-weighted allocation concentrates labels on high-error minority subgroups ($S_2$, $S_3$), reducing worst-subgroup RMSE by 15--25\% at $n_{\text  {expert}}\!=\!250$.}}{7}{table.6}\protected@file@percent }
\newlabel{tab:allocation}{{6}{7}{Expert annotation allocation strategies ($K\!=\!4$ extreme regime). CATE-weighted allocation concentrates labels on high-error minority subgroups ($S_2$, $S_3$), reducing worst-subgroup RMSE by 15--25\% at $n_{\text {expert}}\!=\!250$}{table.6}{}}
