{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EezTskrZvA1vUteupwkfkr","type":"tool_result","content":"{\"result\":\"{\\\"success\\\": true, \\\"data\\\": {\\\"path\\\": \\\"/home/ubuntu/.agent-ml-research-idea_gen_0520/projects/ec_hte_llm_annotation/literature_map.yaml\\\", \\\"content\\\": \\\"meta:\\\\n  last_updated: '2026-05-21T12:00:00Z'\\\\n  total_papers: 33\\\\ncategories:\\\\n  - ppi-debiasing\\\\n  - causal-inference-hte\\\\n  - llm-measurement-error\\\\n  - active-annotation\\\\n  - classical-measurement-error\\\\n  - bayesian-annotation\\\\n  - css-methodology\\\\npapers:\\\\n  mozer2026ppi:\\\\n    title: \\\\\\\"PPI is the Difference Estimator: Recognizing the Survey Sampling Roots of Prediction-Powered Inference\\\\\\\"\\\\n    authors:\\\\n      - \\\\\\\"Mozer, Reagan\\\\\\\"\\\\n    year: 2026\\\\n    venue: arXiv\\\\n    url: \\\\\\\"https://arxiv.org/abs/2603.19160\\\\\\\"\\\\n    doi: \\\\\\\"\\\\\\\"\\\\n    bibtex_key: mozer2026ppi\\\\n    category: ppi-debiasing\\\\n    role: foundation\\\\n    relevance: \\\\\\\"CRITICAL. Proves pooled PPI rectifiers induce irreducible ATE bias under differential LLM prediction error; proposes arm-specific rectifiers. We extend from ATE to CATE with mismeasured effect modifiers.\\\\\\\"\\\\n    semantic_scholar_id: \\\\\\\"\\\\\\\"\\\\n    verified: false\\\\n    added_by: director\\\\n\\\\n  egami2024dsl:\\\\n    title: \\\\\\\"Using Imperfect Surrogates for Downstream Inference: Design-based Supervised Learning for Social Science Applications of Large Language Models\\\\\\\"\\\\n    authors:\\\\n      - \\\\\\\"Egami, Naoki\\\\\\\"\\\\n      - \\\\\\\"Hinck, Musashi\\\\\\\"\\\\n      - \\\\\\\"Stewart, Brandon\\\\\\\"\\\\n      - \\\\\\\"Wei, Hanying\\\\\\\"\\\\n    year: 2024\\\\n    venue: NeurIPS\\\\n    url: \\\\\\\"\\\\\\\"\\\\n    doi: \\\\\\\"\\\\\\\"\\\\n    bibtex_key: egami2024dsl\\\\n    category: ppi-debiasing\\\\n    role: direct-competitor\\\\n    relevance: \\\\\\\"DSL framework for unbiased population-level estimates using LLM annotations. Handles aggregate estimands only, not CATE with mismeasured effect modifiers.\\\\\\\"\\\\n    semantic_scholar_id: \\\\\\\"\\\\\\\"\\\\n    verified: false\\\\n    added_by: director\\\\n\\\\n  angelopoulos2023ppi:\\\\n    title: \\\\\\\"Prediction-Powered Inference\\\\\\\"\\\\n    authors:\\\\n      - \\\\\\\"Angelopoulos, Anastasios N.\\\\\\\"\\\\n      - \\\\\\\"Bates, Stephen\\\\\\\"\\\\n      - \\\\\\\"Candès, Emmanuel J.\\\\\\\"\\\\n      - \\\\\\\"Jordan, Michael I.\\\\\\\"\\\\n      - \\\\\\\"Lei, Lihua\\\\\\\"\\\\n    year: 2023\\\\n    venue: Science\\\\n    url: \\\\\\\"\\\\\\\"\\\\n    doi: \\\\\\\"\\\\\\\"\\\\n    bibtex_key: angelopoulos2023ppi\\\\n    category: ppi-debiasing\\\\n    role: foundation\\\\n    relevance: \\\\\\\"Foundational PPI framework combining ML predictions with small labeled dataset for valid inference. We build on this for CATE-level correction.\\\\\\\"\\\\n    semantic_scholar_id: \\\\\\\"\\\\\\\"\\\\n    verified: false\\\\n    added_by: director\\\\n\\\\n  wager2018causal:\\\\n    title: \\\\\\\"Estimation and Inference of Heterogeneous Treatment Effects using Random Forests\\\\\\\"\\\\n    authors:\\\\n      - \\\\\\\"Wager, Stefan\\\\\\\"\\\\n      - \\\\\\\"Athey, Susan\\\\\\\"\\\\n    year: 2018\\\\n    venue: JASA\\\\n    url: \\\\\\\"\\\\\\\"\\\\n    doi: \\\\\\\"\\\\\\\"\\\\n    bibtex_key: wager2018causal\\\\n    category: causal-inference-hte\\\\n    role: method-component\\\\n    relevance: \\\\\\\"Honest causal forests — the CATE estimator we preserve and augment with error-corrected pseudo-outcomes and variance-adjusted inference.\\\\\\\"\\\\n    semantic_scholar_id: \\\\\\\"\\\\\\\"\\\\n    verified: false\\\\n    added_by: director\\\\n\\\\n  kennedy2023dr:\\\\n    title: \\\\\\\"Towards Optimal Doubly Robust Estimation of Heterogeneous Causal Effects\\\\\\\"\\\\n    authors:\\\\n      - \\\\\\\"Kennedy, Edward H.\\\\\\\"\\\\n    year: 2023\\\\n    venue: Electronic Journal of Statistics\\\\n    url: \\\\\\\"\\\\\\\"\\\\n    doi: \\\\\\\"\\\\\\\"\\\\n    bibtex_key: kennedy2023dr\\\\n    category: causal-inference-hte\\\\n    role: method-component\\\\n    relevance: \\\\\\\"DR-learner for CATE estimation. Assumes clean covariates — our correction targets this gap when effect modifiers are LLM-annotated.\\\\\\\"\\\\n    semantic_scholar_id: \\\\\\\"\\\\\\\"\\\\n    verified: false\\\\n    added_by: director\\\\n\\\\n  ashwin2025bias:\\\\n    title: \\\\\\\"Using Large Language Models for Qualitative Analysis can Introduce Serious Bias\\\\\\\"\\\\n    authors:\\\\n      - \\\\\\\"Ashwin, Aditya\\\\\\\"\\\\n      - \\\\\\\"Swanson, Becca\\\\\\\"\\\\n      - \\\\\\\"Blair, Robert\\\\\\\"\\\\n      - \\\\\\\"Samii, Cyrus\\\\\\\"\\\\n    year: 2025\\\\n    venue: Sociological Methods & Research\\\\n    url: \\\\\\\"\\\\\\\"\\\\n    doi: \\\\\\\"\\\\\\\"\\\\n    bibtex_key: ashwin2025bias\\\\n    category: llm-measurement-error\\\\n    role: evaluation\\\\n    relevance: \\\\\\\"Shows LLM error rates vary by refugee status, gender, education. Their Rohingya dataset is our real-data validation target.\\\\\\\"\\\\n    semantic_scholar_id: \\\\\\\"\\\\\\\"\\\\n    verified: false\\\\n    added_by: director\\\\n\\\\n  audinet2025benchmark:\\\\n    title: \\\\\\\"Benchmarking Debiasing Methods for LLM-based Parameter Estimates\\\\\\\"\\\\n    authors:\\\\n      - \\\\\\\"Audinet de Pieuchon, Josias\\\\\\\"\\\\n      - \\\\\\\"Egami, Naoki\\\\\\\"\\\\n      - \\\\\\\"Alizadeh, Meysam\\\\\\\"\\\\n      - \\\\\\\"Gilardi, Fabrizio\\\\\\\"\\\\n    year: 2025\\\\n    venue: EMNLP\\\\n    url: \\\\\\\"\\\\\\\"\\\\n    doi: \\\\\\\"\\\\\\\"\\\\n    bibtex_key: audinet2025benchmark\\\\n    category: ppi-debiasing\\\\n    role: direct-competitor\\\\n    relevance: \\\\\\\"Benchmarks DSL vs PPI for LLM debiasing. Finds DSL outperforms on bias but less consistent. Only targets aggregate estimands.\\\\\\\"\\\\n    semantic_scholar_id: \\\\\\\"\\\\\\\"\\\\n    verified: false\\\\n    added_by: director\\\\n\\\\n  zrnic2024active:\\\\n    title: \\\\\\\"Active Statistical Inference\\\\\\\"\\\\n    authors:\\\\n      - \\\\\\\"Zrnic, Tijana\\\\\\\"\\\\n      - \\\\\\\"Candès, Emmanuel J.\\\\\\\"\\\\n    year: 2024\\\\n    venue: ICML\\\\n    url: \\\\\\\"\\\\\\\"\\\\n    doi: \\\\\\\"\\\\\\\"\\\\n    bibtex_key: zrnic2024active\\\\n    category: active-annotation\\\\n    role: direct-competitor\\\\n    relevance: \\\\\\\"Active label allocation where model uncertainty is highest. Optimizes population-level interval width, not CATE accuracy — our allocation criterion is novel.\\\\\\\"\\\\n    semantic_scholar_id: \\\\\\\"\\\\\\\"\\\\n    verified: false\\\\n    added_by: director\\\\n\\\\n  bu2023forestiv:\\\\n    title: \\\\\\\"Achieving Reliable Causal Inference with Data-Mined Variables: A Random Forest Approach to the Measurement Error Problem\\\\\\\"\\\\n    authors:\\\\n      - \\\\\\\"Bu, Zhexin\\\\\\\"\\\\n      - \\\\\\\"Almond, David\\\\\\\"\\\\n      - \\\\\\\"Bhatt, Siddhartha\\\\\\\"\\\\n      - \\\\\\\"Goldsmith-Pinkham, Paul\\\\\\\"\\\\n    year: 2023\\\\n    venue: INFORMS Journal on Data Science\\\\n    url: \\\\\\\"\\\\\\\"\\\\n    doi: \\\\\\\"\\\\\\\"\\\\n    bibtex_key: bu2023forestiv\\\\n    category: causal-inference-hte\\\\n    role: direct-competitor\\\\n    relevance: \\\\\\\"ForestIV corrects ML-covariate measurement error in regression, but NOT in CATE estimation. Closest prior work to our problem.\\\\\\\"\\\\n    semantic_scholar_id: \\\\\\\"\\\\\\\"\\\\n    verified: false\\\\n    added_by: director\\\\n\\\\n  sui2026ppci:\\\\n    title: \\\\\\\"Prediction-Powered Conditional Inference\\\\\\\"\\\\n    authors:\\\\n      - \\\\\\\"Sui, Yijun\\\\\\\"\\\\n    year: 2026\\\\n    venue: arXiv\\\\n    url: \\\\\\\"https://arxiv.org/abs/2603.05575\\\\\\\"\\\\n    doi: \\\\\\\"\\\\\\\"\\\\n    bibtex_key: sui2026ppci\\\\n    category: ppi-debiasing\\\\n    role: direct-competitor\\\\n    relevance: \\\\\\\"PPCI extends PPI to conditional functionals via kernel-based localization. Key differentiator: PPCI handles outcome-side correction for conditional means, we handle covariate-side measurement error in effect modifiers defining subgroup structure.\\\\\\\"\\\\n    semantic_scholar_id: \\\\\\\"\\\\\\\"\\\\n    verified: false\\\\n    added_by: director\\\\n\\\\n  mehrotra2026perspective:\\\\n    title: \\\\\\\"Multi-Perspective LLM Annotations for Valid Analyses in Subjective Tasks\\\\\\\"\\\\n    authors:\\\\n      - \\\\\\\"Mehrotra, Aayush\\\\\\\"\\\\n    year: 2026\\\\n    venue: arXiv\\\\n    url: \\\\\\\"\\\\\\\"\\\\n    doi: \\\\\\\"\\\\\\\"\\\\n    bibtex_key: mehrotra2026perspective\\\\n    category: active-annotation\\\\n    role: direct-competitor\\\\n    relevance: \\\\\\\"Perspective-driven adaptive sampling for subjective annotation. Targets perspective-level estimands, not CATE with mismeasured effect modifiers.\\\\\\\"\\\\n    semantic_scholar_id: \\\\\\\"\\\\\\\"\\\\n    verified: false\\\\n    added_by: director\\\\n\\\\n  fuller1987measurement:\\\\n    title: \\\\\\\"Measurement Error Models\\\\\\\"\\\\n    authors:\\\\n      - \\\\\\\"Fuller, Wayne A.\\\\\\\"\\\\n    year: 1987\\\\n    venue: Wiley\\\\n    url: \\\\\\\"\\\\\\\"\\\\n    doi: \\\\\\\"\\\\\\\"\\\\n    bibtex_key: fuller1987measurement\\\\n    category: classical-measurement-error\\\\n    role: foundation\\\\n    relevance: \\\\\\\"Classical reference on measurement error correction. Sec 2.3 shows misspecified corrections can amplify MSE — our Δπ×Δτ product form is a CATE-specific quantification of this phenomenon.\\\\\\\"\\\\n    semantic_scholar_id: \\\\\\\"\\\\\\\"\\\\n    verified: false\\\\n    added_by: director\\\\n\\\\n  carroll2006measurement:\\\\n    title: \\\\\\\"Measurement Error in Nonlinear Models: A Modern Perspective\\\\\\\"\\\\n    authors:\\\\n      - \\\\\\\"Carroll, Raymond J.\\\\\\\"\\\\n      - \\\\\\\"Ruppert, David\\\\\\\"\\\\n      - \\\\\\\"Stefanski, Leonard A.\\\\\\\"\\\\n      - \\\\\\\"Crainiceanu, Ciprian M.\\\\\\\"\\\\n    year: 2006\\\\n    venue: Chapman & Hall/CRC\\\\n    url: \\\\\\\"\\\\\\\"\\\\n    doi: \\\\\\\"\\\\\\\"\\\\n    bibtex_key: carroll2006measurement\\\\n    category: classical-measurement-error\\\\n    role: foundation\\\\n    relevance: \\\\\\\"Ch. 4 on misclassification in regression. Key antecedent — our contribution extends from regression to CATE with subgroup-heterogeneous error.\\\\\\\"\\\\n    semantic_scholar_id: \\\\\\\"\\\\\\\"\\\\n    verified: false\\\\n    added_by: director\\\\n\\\\n  dawid1979skene:\\\\n    title: \\\\\\\"Maximum Likelihood Estimation of Observer Error-Rates Using the EM Algorithm\\\\\\\"\\\\n    authors:\\\\n      - \\\\\\\"Dawid, A. Philip\\\\\\\"\\\\n      - \\\\\\\"Skene, Allan M.\\\\\\\"\\\\n    year: 1979\\\\n    venue: Applied Statistics\\\\n    url: \\\\\\\"\\\\\\\"\\\\n    doi: \\\\\\\"\\\\\\\"\\\\n    bibtex_key: dawid1979skene\\\\n    category: bayesian-annotation\\\\n    role: method-component\\\\n    relevance: \\\\\\\"Foundational Bayesian annotation model for estimating annotator confusion matrices. Our HB Dirichlet estimation is a hierarchical extension.\\\\\\\"\\\\n    semantic_scholar_id: \\\\\\\"\\\\\\\"\\\\n    verified: false\\\\n    added_by: director\\\\n\\\\n  imai2010causal:\\\\n    title: \\\\\\\"Causal Inference with Differential Measurement Error: Nonparametric Identification and Sensitivity Analysis\\\\\\\"\\\\n    authors:\\\\n      - \\\\\\\"Imai, Kosuke\\\\\\\"\\\\n      - \\\\\\\"Yamamoto, Teppei\\\\\\\"\\\\n    year: 2010\\\\n    venue: American Journal of Political Science\\\\n    url: \\\\\\\"\\\\\\\"\\\\n    doi: \\\\\\\"\\\\\\\"\\\\n    bibtex_key: imai2010causal\\\\n    category: causal-inference-hte\\\\n    role: foundation\\\\n    relevance: \\\\\\\"Causal mediation with measurement error — closest prior work linking measurement error to causal heterogeneity. Our contribution: mismeasured variable defines heterogeneity structure itself.\\\\\\\"\\\\n    semantic_scholar_id: \\\\\\\"\\\\\\\"\\\\n    verified: false\\\\n    added_by: director\\\\n\\\\n  tornberg2024llm:\\\\n    title: \\\\\\\"ChatGPT-4 Outperforms Experts and Crowd Workers in Annotating Political Twitter Messages with Zero-Shot Learning\\\\\\\"\\\\n    authors:\\\\n      - \\\\\\\"Törnberg, Petter\\\\\\\"\\\\n    year: 2024\\\\n    venue: arXiv\\\\n    url: \\\\\\\"\\\\\\\"\\\\n    doi: \\\\\\\"\\\\\\\"\\\\n    bibtex_key: tornberg2024llm\\\\n    category: llm-measurement-error\\\\n    role: evaluation\\\\n    relevance: \\\\\\\"Shows GPT-4 outperforms crowd workers on political text annotation but with systematic error patterns. Documents the heterogeneous misclassification our method corrects.\\\\\\\"\\\\n    semantic_scholar_id: \\\\\\\"\\\\\\\"\\\\n    verified: false\\\\n    added_by: director\\\\n\\\\n  gilardi2023chatgpt:\\\\n    title: \\\\\\\"ChatGPT Outperforms Crowd-Workers for Text-Annotation Tasks\\\\\\\"\\\\n    authors:\\\\n      - \\\\\\\"Gilardi, Fabrizio\\\\\\\"\\\\n      - \\\\\\\"Alizadeh, Meysam\\\\\\\"\\\\n      - \\\\\\\"Kubli, Maël\\\\\\\"\\\\n    year: 2023\\\\n    venue: PNAS\\\\n    url: \\\\\\\"\\\\\\\"\\\\n    doi: \\\\\\\"\\\\\\\"\\\\n    bibtex_key: gilardi2023chatgpt\\\\n    category: llm-measurement-error\\\\n    role: evaluation\\\\n    relevance: \\\\\\\"Landmark study on LLM annotation quality across CSS tasks. Documents per-category accuracy variation — the heterogeneity our framework targets.\\\\\\\"\\\\n    semantic_scholar_id: \\\\\\\"\\\\\\\"\\\\n    verified: false\\\\n    added_by: director\\\\n\\\\n  ziems2024css:\\\\n    title: \\\\\\\"Can Large Language Models Transform Computational Social Science?\\\\\\\"\\\\n    authors:\\\\n      - \\\\\\\"Ziems, Caleb\\\\\\\"\\\\n      - \\\\\\\"Held, William\\\\\\\"\\\\n      - \\\\\\\"Shaikh, Omar\\\\\\\"\\\\n      - \\\\\\\"Chen, Jiaao\\\\\\\"\\\\n      - \\\\\\\"Zhang, Zhehao\\\\\\\"\\\\n      - \\\\\\\"Yang, Diyi\\\\\\\"\\\\n    year: 2024\\\\n    venue: Computational Linguistics\\\\n    url: \\\\\\\"\\\\\\\"\\\\n    doi: \\\\\\\"\\\\\\\"\\\\n    bibtex_key: ziems2024css\\\\n    category: llm-measurement-error\\\\n    role: evaluation\\\\n    relevance: \\\\\\\"Comprehensive survey of LLM applications in CSS — positions our work in the broader context of LLM-annotated social science research.\\\\\\\"\\\\n    semantic_scholar_id: \\\\\\\"\\\\\\\"\\\\n    verified: false\\\\n    added_by: director\\\\n\\\\n  hovy2013annotation:\\\\n    title: \\\\\\\"Learning Whom to Trust with MACE\\\\\\\"\\\\n    authors:\\\\n      - \\\\\\\"Hovy, Dirk\\\\\\\"\\\\n      - \\\\\\\"Berg-Kirkpatrick, Taylor\\\\\\\"\\\\n      - \\\\\\\"Vaswani, Ashish\\\\\\\"\\\\n      - \\\\\\\"Hovy, Eduard\\\\\\\"\\\\n    year: 2013\\\\n    venue: NAACL\\\\n    url: \\\\\\\"\\\\\\\"\\\\n    doi: \\\\\\\"\\\\\\\"\\\\n    bibtex_key: hovy2013mace\\\\n    category: bayesian-annotation\\\\n    role: method-component\\\\n    relevance: \\\\\\\"IRT-style annotation model. Alternative to Dawid-Skene for estimating annotator competence — relevant baseline for confusion matrix estimation.\\\\\\\"\\\\n    semantic_scholar_id: \\\\\\\"\\\\\\\"\\\\n    verified: false\\\\n    added_by: director\\\\n\\\\n  passonneau2014carpenter:\\\\n    title: \\\\\\\"The Benefits of a Model of Annotation\\\\\\\"\\\\n    authors:\\\\n      - \\\\\\\"Passonneau, Rebecca J.\\\\\\\"\\\\n      - \\\\\\\"Carpenter, Bob\\\\\\\"\\\\n    year: 2014\\\\n    venue: TACL\\\\n    url: \\\\\\\"\\\\\\\"\\\\n    doi: \\\\\\\"\\\\\\\"\\\\n    bibtex_key: passonneau2014annotation\\\\n    category: bayesian-annotation\\\\n    role: method-component\\\\n    relevance: \\\\\\\"Bayesian annotation model with item difficulty. Relevant to our hierarchical estimation of per-subgroup confusion matrices.\\\\\\\"\\\\n    semantic_scholar_id: \\\\\\\"\\\\\\\"\\\\n    verified: false\\\\n    added_by: director\\\\n\\\\n  chernozhukov2018dml:\\\\n    title: \\\\\\\"Double/Debiased Machine Learning for Treatment and Structural Parameters\\\\\\\"\\\\n    authors:\\\\n      - \\\\\\\"Chernozhukov, Victor\\\\\\\"\\\\n      - \\\\\\\"Chetverikov, Denis\\\\\\\"\\\\n      - \\\\\\\"Demirer, Mert\\\\\\\"\\\\n      - \\\\\\\"Duflo, Esther\\\\\\\"\\\\n      - \\\\\\\"Hansen, Christian\\\\\\\"\\\\n      - \\\\\\\"Newey, Whitney\\\\\\\"\\\\n      - \\\\\\\"Robins, James\\\\\\\"\\\\n    year: 2018\\\\n    venue: Econometrics Journal\\\\n    url: \\\\\\\"\\\\\\\"\\\\n    doi: \\\\\\\"\\\\\\\"\\\\n    bibtex_key: chernozhukov2018dml\\\\n    category: causal-inference-hte\\\\n    role: foundation\\\\n    relevance: \\\\\\\"DML framework for treatment effect estimation with ML nuisance parameters. Foundation for our doubly-robust pseudo-outcome construction.\\\\\\\"\\\\n    semantic_scholar_id: \\\\\\\"\\\\\\\"\\\\n    verified: false\\\\n    added_by: director\\\\n\\\\n  # ===== NEW ENTRIES (added 2026-05-21) =====\\\\n\\\\n  # --- Classical measurement error ---\\\\n\\\\n  gustafson2003measurement:\\\\n    title: \\\\\\\"Measurement Error and Misclassification in Statistics and Epidemiology: Impacts and Bayesian Adjustments\\\\\\\"\\\\n    authors:\\\\n      - \\\\\\\"Gustafson, Paul\\\\\\\"\\\\n    year: 2003\\\\n    venue: Chapman & Hall/CRC\\\\n    url: \\\\\\\"https://doi.org/10.1201/9780203502761\\\\\\\"\\\\n    doi: \\\\\\\"10.1201/9780203502761\\\\\\\"\\\\n    bibtex_key: gustafson2003measurement\\\\n    category: classical-measurement-error\\\\n    role: foundation\\\\n    relevance: \\\\\\\"Bayesian treatment of misclassification in discrete covariates. Directly relevant to our hierarchical Bayesian confusion matrix estimation for LLM annotation error.\\\\\\\"\\\\n    semantic_scholar_id: \\\\\\\"\\\\\\\"\\\\n    verified: false\\\\n    added_by: agent\\\\n\\\\n  hu2008nonclassical:\\\\n    title: \\\\\\\"Instrumental Variable Treatment of Nonclassical Measurement Error Models\\\\\\\"\\\\n    authors:\\\\n      - \\\\\\\"Hu, Yingyao\\\\\\\"\\\\n      - \\\\\\\"Schennach, Susanne M.\\\\\\\"\\\\n    year: 2008\\\\n    venue: Econometrica\\\\n    url: \\\\\\\"https://doi.org/10.1111/j.0012-9682.2008.00823.x\\\\\\\"\\\\n    doi: \\\\\\\"10.1111/j.0012-9682.2008.00823.x\\\\\\\"\\\\n    bibtex_key: hu2008nonclassical\\\\n    category: classical-measurement-error\\\\n    role: foundation\\\\n    relevance: \\\\\\\"Identifies nonclassical measurement error models via IV. Key theoretical antecedent — LLM annotation errors are nonclassical (correlated with true label), which our framework explicitly handles.\\\\\\\"\\\\n    semantic_scholar_id: \\\\\\\"\\\\\\\"\\\\n    verified: false\\\\n    added_by: agent\\\\n\\\\n  # --- PPI extensions ---\\\\n\\\\n  angelopoulos2023ppiplus:\\\\n    title: \\\\\\\"PPI++: Efficient Prediction-Powered Inference\\\\\\\"\\\\n    authors:\\\\n      - \\\\\\\"Angelopoulos, Anastasios N.\\\\\\\"\\\\n      - \\\\\\\"Bates, Stephen\\\\\\\"\\\\n      - \\\\\\\"Candès, Emmanuel J.\\\\\\\"\\\\n      - \\\\\\\"Jordan, Michael I.\\\\\\\"\\\\n      - \\\\\\\"Lei, Lihua\\\\\\\"\\\\n    year: 2023\\\\n    venue: arXiv\\\\n    url: \\\\\\\"https://arxiv.org/abs/2311.01453\\\\\\\"\\\\n    doi: \\\\\\\"\\\\\\\"\\\\n    bibtex_key: angelopoulos2023ppiplus\\\\n    category: ppi-debiasing\\\\n    role: method-component\\\\n    relevance: \\\\\\\"Adaptive tuning parameter for PPI that automatically adjusts to prediction quality. We build on PPI++ for our arm-specific rectifier implementation.\\\\\\\"\\\\n    semantic_scholar_id: \\\\\\\"\\\\\\\"\\\\n    verified: false\\\\n    added_by: agent\\\\n\\\\n  zrnic2024crossppi:\\\\n    title: \\\\\\\"Cross-Prediction-Powered Inference\\\\\\\"\\\\n    authors:\\\\n      - \\\\\\\"Zrnic, Tijana\\\\\\\"\\\\n      - \\\\\\\"Candès, Emmanuel J.\\\\\\\"\\\\n    year: 2024\\\\n    venue: PNAS\\\\n    url: \\\\\\\"https://doi.org/10.1073/pnas.2322083121\\\\\\\"\\\\n    doi: \\\\\\\"10.1073/pnas.2322083121\\\\\\\"\\\\n    bibtex_key: zrnic2024crossppi\\\\n    category: ppi-debiasing\\\\n    role: method-component\\\\n    relevance: \\\\\\\"Cross-fitting variant of PPI that uses the labeled data for both training and debiasing via sample splitting. Relevant alternative to our approach when the prediction model is trained in-house.\\\\\\\"\\\\n    semantic_scholar_id: \\\\\\\"\\\\\\\"\\\\n    verified: false\\\\n    added_by: agent\\\\n\\\\n  # --- LLM-as-annotator ---\\\\n\\\\n  pangakis2023annotation:\\\\n    title: \\\\\\\"Automated Annotation with Generative AI Requires Validation\\\\\\\"\\\\n    authors:\\\\n      - \\\\\\\"Pangakis, Nicholas\\\\\\\"\\\\n      - \\\\\\\"Wolken, Samuel\\\\\\\"\\\\n      - \\\\\\\"Fasching, Neil\\\\\\\"\\\\n    year: 2023\\\\n    venue: arXiv\\\\n    url: \\\\\\\"https://arxiv.org/abs/2306.00176\\\\\\\"\\\\n    doi: \\\\\\\"\\\\\\\"\\\\n    bibtex_key: pangakis2023annotation\\\\n    category: llm-measurement-error\\\\n    role: context\\\\n    relevance: \\\\\\\"Replicates 27 annotation tasks showing LLM performance is task-dependent. Reinforces our premise that naive LLM substitution without correction introduces heterogeneous bias.\\\\\\\"\\\\n    semantic_scholar_id: \\\\\\\"\\\\\\\"\\\\n    verified: false\\\\n    added_by: agent\\\\n\\\\n  reiss2023chatgpt:\\\\n    title: \\\\\\\"Testing the Reliability of ChatGPT for Text Annotation and Classification: A Cautionary Remark\\\\\\\"\\\\n    authors:\\\\n      - \\\\\\\"Reiss, Michael V.\\\\\\\"\\\\n    year: 2023\\\\n    venue: arXiv\\\\n    url: \\\\\\\"https://arxiv.org/abs/2304.11085\\\\\\\"\\\\n    doi: \\\\\\\"\\\\\\\"\\\\n    bibtex_key: reiss2023chatgpt\\\\n    category: llm-measurement-error\\\\n    role: context\\\\n    relevance: \\\\\\\"Documents non-determinism and prompt sensitivity of ChatGPT annotations. Motivates our framework's treatment of LLM output as a noisy measurement requiring statistical correction.\\\\\\\"\\\\n    semantic_scholar_id: \\\\\\\"\\\\\\\"\\\\n    verified: false\\\\n    added_by: agent\\\\n\\\\n  # --- HTE/CATE methods ---\\\\n\\\\n  nie2021rlearner:\\\\n    title: \\\\\\\"Quasi-Oracle Estimation of Heterogeneous Treatment Effects\\\\\\\"\\\\n    authors:\\\\n      - \\\\\\\"Nie, Xinkun\\\\\\\"\\\\n      - \\\\\\\"Wager, Stefan\\\\\\\"\\\\n    year: 2021\\\\n    venue: Biometrika\\\\n    url: \\\\\\\"https://doi.org/10.1093/biomet/asaa076\\\\\\\"\\\\n    doi: \\\\\\\"10.1093/biomet/asaa076\\\\\\\"\\\\n    bibtex_key: nie2021rlearner\\\\n    category: causal-inference-hte\\\\n    role: method-component\\\\n    relevance: \\\\\\\"R-learner for CATE estimation with quasi-oracle property. Key metalearner alternative to DR-learner; assumes clean covariates — our correction extends applicability to mismeasured effect modifiers.\\\\\\\"\\\\n    semantic_scholar_id: \\\\\\\"\\\\\\\"\\\\n    verified: false\\\\n    added_by: agent\\\\n\\\\n  kunzel2019metalearners:\\\\n    title: \\\\\\\"Metalearners for Estimating Heterogeneous Treatment Effects Using Machine Learning\\\\\\\"\\\\n    authors:\\\\n      - \\\\\\\"Künzel, Sören R.\\\\\\\"\\\\n      - \\\\\\\"Sekhon, Jasjeet S.\\\\\\\"\\\\n      - \\\\\\\"Bickel, Peter J.\\\\\\\"\\\\n      - \\\\\\\"Yu, Bin\\\\\\\"\\\\n    year: 2019\\\\n    venue: PNAS\\\\n    url: \\\\\\\"https://doi.org/10.1073/pnas.1804597116\\\\\\\"\\\\n    doi: \\\\\\\"10.1073/pnas.1804597116\\\\\\\"\\\\n    bibtex_key: kunzel2019metalearners\\\\n    category: causal-inference-hte\\\\n    role: method-component\\\\n    relevance: \\\\\\\"Unifying framework for S/T/X-learners. Defines the metalearner taxonomy our CATE estimation pipeline builds upon. None address covariate measurement error.\\\\\\\"\\\\n    semantic_scholar_id: \\\\\\\"\\\\\\\"\\\\n    verified: false\\\\n    added_by: agent\\\\n\\\\n  athey2016recursive:\\\\n    title: \\\\\\\"Recursive Partitioning for Heterogeneous Causal Effects\\\\\\\"\\\\n    authors:\\\\n      - \\\\\\\"Athey, Susan\\\\\\\"\\\\n      - \\\\\\\"Imbens, Guido\\\\\\\"\\\\n    year: 2016\\\\n    venue: PNAS\\\\n    url: \\\\\\\"https://doi.org/10.1073/pnas.1510489113\\\\\\\"\\\\n    doi: \\\\\\\"10.1073/pnas.1510489113\\\\\\\"\\\\n    bibtex_key: athey2016recursive\\\\n    category: causal-inference-hte\\\\n    role: foundation\\\\n    relevance: \\\\\\\"Introduces honest causal trees with valid inference for HTE. Precursor to causal forests (Wager & Athey 2018). Establishes the partition-based HTE framework our method corrects.\\\\\\\"\\\\n    semantic_scholar_id: \\\\\\\"\\\\\\\"\\\\n    verified: false\\\\n    added_by: agent\\\\n\\\\n  # --- CSS methodology ---\\\\n\\\\n  grimmer2022textasdata:\\\\n    title: \\\\\\\"Text as Data: A New Framework for Machine Learning and the Social Sciences\\\\\\\"\\\\n    authors:\\\\n      - \\\\\\\"Grimmer, Justin\\\\\\\"\\\\n      - \\\\\\\"Roberts, Margaret E.\\\\\\\"\\\\n      - \\\\\\\"Stewart, Brandon M.\\\\\\\"\\\\n    year: 2022\\\\n    venue: Princeton University Press\\\\n    url: \\\\\\\"https://press.princeton.edu/books/hardcover/9780691207544/text-as-data\\\\\\\"\\\\n    doi: \\\\\\\"\\\\\\\"\\\\n    bibtex_key: grimmer2022textasdata\\\\n    category: css-methodology\\\\n    role: context\\\\n    relevance: \\\\\\\"Defines the text-as-data paradigm in social science. Frames measurement, discovery, and causal inference as sequential steps — our work addresses the measurement error propagation between these steps.\\\\\\\"\\\\n    semantic_scholar_id: \\\\\\\"\\\\\\\"\\\\n    verified: false\\\\n    added_by: agent\\\\n\\\\n  tornberg2023llmguide:\\\\n    title: \\\\\\\"How to Use Large Language Models for Text Analysis\\\\\\\"\\\\n    authors:\\\\n      - \\\\\\\"Törnberg, Petter\\\\\\\"\\\\n    year: 2023\\\\n    venue: arXiv\\\\n    url: \\\\\\\"https://arxiv.org/abs/2307.13106\\\\\\\"\\\\n    doi: \\\\\\\"\\\\\\\"\\\\n    bibtex_key: tornberg2023llmguide\\\\n    category: css-methodology\\\\n    role: context\\\\n    relevance: \\\\\\\"Practical guide for LLM-based text analysis in social science. Documents the emerging workflow our framework corrects: prompt LLM, collect labels, use in downstream analysis without error adjustment.\\\\\\\"\\\\n    semantic_scholar_id: \\\\\\\"\\\\\\\"\\\\n    verified: false\\\\n    added_by: agent\\\\n\\\\n  # --- Bayesian annotation ---\\\\n\\\\n  paun2018bayesian:\\\\n    title: \\\\\\\"Comparing Bayesian Models of Annotation\\\\\\\"\\\\n    authors:\\\\n      - \\\\\\\"Paun, Silviu\\\\\\\"\\\\n      - \\\\\\\"Carpenter, Bob\\\\\\\"\\\\n      - \\\\\\\"Chamberlain, Jon\\\\\\\"\\\\n      - \\\\\\\"Hovy, Dirk\\\\\\\"\\\\n      - \\\\\\\"Kruschwitz, Udo\\\\\\\"\\\\n      - \\\\\\\"Poesio, Massimo\\\\\\\"\\\\n    year: 2018\\\\n    venue: TACL\\\\n    url: \\\\\\\"https://doi.org/10.1162/tacl_a_00040\\\\\\\"\\\\n    doi: \\\\\\\"10.1162/tacl_a_00040\\\\\\\"\\\\n    bibtex_key: paun2018bayesian\\\\n    category: bayesian-annotation\\\\n    role: method-component\\\\n    relevance: \\\\\\\"Systematic comparison of Bayesian annotation models including Dawid-Skene extensions. Informs our choice of hierarchical model for LLM confusion matrix estimation.\\\\\\\"\\\\n    semantic_scholar_id: \\\\\\\"\\\\\\\"\\\\n    verified: false\\\\n    added_by: agent\\\\n\\\", \\\"total_chars\\\": 20836, \\\"truncated\\\": false}, \\\"error\\\": null, \\\"metadata\\\": {}}\"}"}]},"parent_tool_use_id":"toolu_01N3dJcrSJw8fGd5EAvrcF1g","session_id":"5a7fea04-88c6-4f40-a7d8-de32a19d47e7","uuid":"a6c1bf01-6329-499d-8590-c35e9eba1bd4","timestamp":"2026-05-23T20:12:45.359Z"}
