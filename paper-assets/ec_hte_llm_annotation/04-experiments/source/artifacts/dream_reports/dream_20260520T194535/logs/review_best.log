{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01G38XVLDMWGC92yJNWB2Rn6","type":"tool_result","content":"{\"result\":\"{\\\"success\\\": true, \\\"data\\\": {\\\"path\\\": \\\"/home/ubuntu/.agent-ml-research-idea_gen_0520/projects/ec_hte_llm_annotation/literature_map.yaml\\\", \\\"content\\\": \\\"meta:\\\\n  last_updated: '2026-05-20T17:20:00Z'\\\\n  total_papers: 12\\\\ncategories:\\\\n  - ppi-debiasing\\\\n  - causal-inference-hte\\\\n  - llm-measurement-error\\\\n  - active-annotation\\\\npapers:\\\\n  mozer2026ppi:\\\\n    title: \\\\\\\"PPI is the Difference Estimator: Recognizing the Survey Sampling Roots of Prediction-Powered Inference\\\\\\\"\\\\n    authors:\\\\n      - \\\\\\\"Mozer, Reagan\\\\\\\"\\\\n    year: 2026\\\\n    venue: arXiv\\\\n    url: \\\\\\\"https://arxiv.org/abs/2603.19160\\\\\\\"\\\\n    doi: \\\\\\\"\\\\\\\"\\\\n    bibtex_key: mozer2026ppi\\\\n    category: ppi-debiasing\\\\n    role: foundation\\\\n    relevance: \\\\\\\"CRITICAL. Proves pooled PPI rectifiers induce irreducible ATE bias under differential LLM prediction error; proposes arm-specific rectifiers. We extend from ATE to CATE with mismeasured effect modifiers.\\\\\\\"\\\\n    semantic_scholar_id: \\\\\\\"\\\\\\\"\\\\n    verified: false\\\\n    added_by: director\\\\n\\\\n  egami2024dsl:\\\\n    title: \\\\\\\"Using Imperfect Surrogates for Downstream Inference: Design-based Supervised Learning for Social Science Applications of Large Language Models\\\\\\\"\\\\n    authors:\\\\n      - \\\\\\\"Egami, Naoki\\\\\\\"\\\\n      - \\\\\\\"Hinck, Musashi\\\\\\\"\\\\n      - \\\\\\\"Stewart, Brandon\\\\\\\"\\\\n      - \\\\\\\"Wei, Hanying\\\\\\\"\\\\n    year: 2024\\\\n    venue: NeurIPS\\\\n    url: \\\\\\\"\\\\\\\"\\\\n    doi: \\\\\\\"\\\\\\\"\\\\n    bibtex_key: egami2024dsl\\\\n    category: ppi-debiasing\\\\n    role: direct-competitor\\\\n    relevance: \\\\\\\"DSL framework for unbiased population-level estimates using LLM annotations. Handles aggregate estimands only, not CATE with mismeasured effect modifiers.\\\\\\\"\\\\n    semantic_scholar_id: \\\\\\\"\\\\\\\"\\\\n    verified: false\\\\n    added_by: director\\\\n\\\\n  angelopoulos2023ppi:\\\\n    title: \\\\\\\"Prediction-Powered Inference\\\\\\\"\\\\n    authors:\\\\n      - \\\\\\\"Angelopoulos, Anastasios N.\\\\\\\"\\\\n      - \\\\\\\"Bates, Stephen\\\\\\\"\\\\n      - \\\\\\\"Candès, Emmanuel J.\\\\\\\"\\\\n      - \\\\\\\"Jordan, Michael I.\\\\\\\"\\\\n      - \\\\\\\"Lei, Lihua\\\\\\\"\\\\n    year: 2023\\\\n    venue: Science\\\\n    url: \\\\\\\"\\\\\\\"\\\\n    doi: \\\\\\\"\\\\\\\"\\\\n    bibtex_key: angelopoulos2023ppi\\\\n    category: ppi-debiasing\\\\n    role: foundation\\\\n    relevance: \\\\\\\"Foundational PPI framework combining ML predictions with small labeled dataset for valid inference. We build on this for CATE-level correction.\\\\\\\"\\\\n    semantic_scholar_id: \\\\\\\"\\\\\\\"\\\\n    verified: false\\\\n    added_by: director\\\\n\\\\n  wager2018causal:\\\\n    title: \\\\\\\"Estimation and Inference of Heterogeneous Treatment Effects using Random Forests\\\\\\\"\\\\n    authors:\\\\n      - \\\\\\\"Wager, Stefan\\\\\\\"\\\\n      - \\\\\\\"Athey, Susan\\\\\\\"\\\\n    year: 2018\\\\n    venue: JASA\\\\n    url: \\\\\\\"\\\\\\\"\\\\n    doi: \\\\\\\"\\\\\\\"\\\\n    bibtex_key: wager2018causal\\\\n    category: causal-inference-hte\\\\n    role: method-component\\\\n    relevance: \\\\\\\"Honest causal forests — the CATE estimator we preserve and augment with error-corrected pseudo-outcomes and variance-adjusted inference.\\\\\\\"\\\\n    semantic_scholar_id: \\\\\\\"\\\\\\\"\\\\n    verified: false\\\\n    added_by: director\\\\n\\\\n  kennedy2023dr:\\\\n    title: \\\\\\\"Towards Optimal Doubly Robust Estimation of Heterogeneous Causal Effects\\\\\\\"\\\\n    authors:\\\\n      - \\\\\\\"Kennedy, Edward H.\\\\\\\"\\\\n    year: 2023\\\\n    venue: Electronic Journal of Statistics\\\\n    url: \\\\\\\"\\\\\\\"\\\\n    doi: \\\\\\\"\\\\\\\"\\\\n    bibtex_key: kennedy2023dr\\\\n    category: causal-inference-hte\\\\n    role: method-component\\\\n    relevance: \\\\\\\"DR-learner for CATE estimation. Assumes clean covariates — our correction targets this gap when effect modifiers are LLM-annotated.\\\\\\\"\\\\n    semantic_scholar_id: \\\\\\\"\\\\\\\"\\\\n    verified: false\\\\n    added_by: director\\\\n\\\\n  ashwin2025bias:\\\\n    title: \\\\\\\"Using Large Language Models for Qualitative Analysis can Introduce Serious Bias\\\\\\\"\\\\n    authors:\\\\n      - \\\\\\\"Ashwin, Aditya\\\\\\\"\\\\n      - \\\\\\\"Swanson, Becca\\\\\\\"\\\\n      - \\\\\\\"Blair, Robert\\\\\\\"\\\\n      - \\\\\\\"Samii, Cyrus\\\\\\\"\\\\n    year: 2025\\\\n    venue: Sociological Methods & Research\\\\n    url: \\\\\\\"\\\\\\\"\\\\n    doi: \\\\\\\"\\\\\\\"\\\\n    bibtex_key: ashwin2025bias\\\\n    category: llm-measurement-error\\\\n    role: evaluation\\\\n    relevance: \\\\\\\"Shows LLM error rates vary by refugee status, gender, education. Their Rohingya dataset is our real-data validation target.\\\\\\\"\\\\n    semantic_scholar_id: \\\\\\\"\\\\\\\"\\\\n    verified: false\\\\n    added_by: director\\\\n\\\\n  audinet2025benchmark:\\\\n    title: \\\\\\\"Benchmarking Debiasing Methods for LLM-based Parameter Estimates\\\\\\\"\\\\n    authors:\\\\n      - \\\\\\\"Audinet de Pieuchon, Josias\\\\\\\"\\\\n      - \\\\\\\"Egami, Naoki\\\\\\\"\\\\n      - \\\\\\\"Alizadeh, Meysam\\\\\\\"\\\\n      - \\\\\\\"Gilardi, Fabrizio\\\\\\\"\\\\n    year: 2025\\\\n    venue: EMNLP\\\\n    url: \\\\\\\"\\\\\\\"\\\\n    doi: \\\\\\\"\\\\\\\"\\\\n    bibtex_key: audinet2025benchmark\\\\n    category: ppi-debiasing\\\\n    role: direct-competitor\\\\n    relevance: \\\\\\\"Benchmarks DSL vs PPI for LLM debiasing. Finds DSL outperforms on bias but less consistent. Only targets aggregate estimands.\\\\\\\"\\\\n    semantic_scholar_id: \\\\\\\"\\\\\\\"\\\\n    verified: false\\\\n    added_by: director\\\\n\\\\n  zrnic2024active:\\\\n    title: \\\\\\\"Active Statistical Inference\\\\\\\"\\\\n    authors:\\\\n      - \\\\\\\"Zrnic, Tijana\\\\\\\"\\\\n      - \\\\\\\"Candès, Emmanuel J.\\\\\\\"\\\\n    year: 2024\\\\n    venue: ICML\\\\n    url: \\\\\\\"\\\\\\\"\\\\n    doi: \\\\\\\"\\\\\\\"\\\\n    bibtex_key: zrnic2024active\\\\n    category: active-annotation\\\\n    role: direct-competitor\\\\n    relevance: \\\\\\\"Active label allocation where model uncertainty is highest. Optimizes population-level interval width, not CATE accuracy — our allocation criterion is novel.\\\\\\\"\\\\n    semantic_scholar_id: \\\\\\\"\\\\\\\"\\\\n    verified: false\\\\n    added_by: director\\\\n\\\\n  bu2023forestiv:\\\\n    title: \\\\\\\"Achieving Reliable Causal Inference with Data-Mined Variables: A Random Forest Approach to the Measurement Error Problem\\\\\\\"\\\\n    authors:\\\\n      - \\\\\\\"Bu, Zhexin\\\\\\\"\\\\n      - \\\\\\\"Almond, David\\\\\\\"\\\\n      - \\\\\\\"Bhatt, Siddhartha\\\\\\\"\\\\n      - \\\\\\\"Goldsmith-Pinkham, Paul\\\\\\\"\\\\n    year: 2023\\\\n    venue: INFORMS Journal on Data Science\\\\n    url: \\\\\\\"\\\\\\\"\\\\n    doi: \\\\\\\"\\\\\\\"\\\\n    bibtex_key: bu2023forestiv\\\\n    category: causal-inference-hte\\\\n    role: direct-competitor\\\\n    relevance: \\\\\\\"ForestIV corrects ML-covariate measurement error in regression, but NOT in CATE estimation. Closest prior work to our problem.\\\\\\\"\\\\n    semantic_scholar_id: \\\\\\\"\\\\\\\"\\\\n    verified: false\\\\n    added_by: director\\\\n\\\\n  sui2026ppci:\\\\n    title: \\\\\\\"Prediction-Powered Conditional Inference\\\\\\\"\\\\n    authors:\\\\n      - \\\\\\\"Sui, Yijun\\\\\\\"\\\\n    year: 2026\\\\n    venue: arXiv\\\\n    url: \\\\\\\"https://arxiv.org/abs/2603.05575\\\\\\\"\\\\n    doi: \\\\\\\"\\\\\\\"\\\\n    bibtex_key: sui2026ppci\\\\n    category: ppi-debiasing\\\\n    role: direct-competitor\\\\n    relevance: \\\\\\\"PPCI extends PPI to conditional functionals via kernel-based localization. Key differentiator: PPCI handles outcome-side correction for conditional means, we handle covariate-side measurement error in effect modifiers defining subgroup structure.\\\\\\\"\\\\n    semantic_scholar_id: \\\\\\\"\\\\\\\"\\\\n    verified: false\\\\n    added_by: director\\\\n\\\\n  mehrotra2026perspective:\\\\n    title: \\\\\\\"Multi-Perspective LLM Annotations for Valid Analyses in Subjective Tasks\\\\\\\"\\\\n    authors:\\\\n      - \\\\\\\"Mehrotra, Aayush\\\\\\\"\\\\n    year: 2026\\\\n    venue: arXiv\\\\n    url: \\\\\\\"\\\\\\\"\\\\n    doi: \\\\\\\"\\\\\\\"\\\\n    bibtex_key: mehrotra2026perspective\\\\n    category: active-annotation\\\\n    role: direct-competitor\\\\n    relevance: \\\\\\\"Perspective-driven adaptive sampling for subjective annotation. Targets perspective-level estimands, not CATE with mismeasured effect modifiers.\\\\\\\"\\\\n    semantic_scholar_id: \\\\\\\"\\\\\\\"\\\\n    verified: false\\\\n    added_by: director\\\\n\\\\n  chernozhukov2018dml:\\\\n    title: \\\\\\\"Double/Debiased Machine Learning for Treatment and Structural Parameters\\\\\\\"\\\\n    authors:\\\\n      - \\\\\\\"Chernozhukov, Victor\\\\\\\"\\\\n      - \\\\\\\"Chetverikov, Denis\\\\\\\"\\\\n      - \\\\\\\"Demirer, Mert\\\\\\\"\\\\n      - \\\\\\\"Duflo, Esther\\\\\\\"\\\\n      - \\\\\\\"Hansen, Christian\\\\\\\"\\\\n      - \\\\\\\"Newey, Whitney\\\\\\\"\\\\n      - \\\\\\\"Robins, James\\\\\\\"\\\\n    year: 2018\\\\n    venue: Econometrics Journal\\\\n    url: \\\\\\\"\\\\\\\"\\\\n    doi: \\\\\\\"\\\\\\\"\\\\n    bibtex_key: chernozhukov2018dml\\\\n    category: causal-inference-hte\\\\n    role: foundation\\\\n    relevance: \\\\\\\"DML framework for treatment effect estimation with ML nuisance parameters. Foundation for our doubly-robust pseudo-outcome construction.\\\\\\\"\\\\n    semantic_scholar_id: \\\\\\\"\\\\\\\"\\\\n    verified: false\\\\n    added_by: director\\\\n\\\", \\\"total_chars\\\": 7393, \\\"truncated\\\": false}, \\\"error\\\": null, \\\"metadata\\\": {}}\"}"}]},"parent_tool_use_id":"toolu_017CF8j9mavTxWyd4xGEWngg","session_id":"243f7ab5-0b31-4460-862b-4acef4243b5d","uuid":"9d2ff29b-2086-45ce-af29-b28a85ab90c1","timestamp":"2026-05-20T20:17:59.396Z"}
