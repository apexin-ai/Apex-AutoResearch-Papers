\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces ROC curves for the $\Delta \tau $-free diagnostic (Proposition~\ref {prop:debiasing_hurts}): $|\delta _s|/((1{-}2\bar  \pi )\cdot \pi _s)>1$. (A)~Setting-level ROC (AUC $= 0.89$), compared with the $|\Delta \pi \times \Delta \tau |$ product (AUC $= 0.89$) and $\mathrm  {CV}(\pi _s)$ (AUC $= 0.97$). (B)~Subgroup-level ROC: the $\Delta \pi $-only condition (AUC $= 0.86$) substantially outperforms the $|\Delta \pi \times \Delta \tau |$ product (AUC $= 0.73$). The $\Delta \tau $-free diagnostic depends only on estimable misclassification rates, breaking the circular dependency that would arise if CATE heterogeneity were required.}}{14}{figure.caption.36}\protected@file@percent }
\newlabel{fig:roc}{{6}{14}{ROC curves for the $\Delta \tau $-free diagnostic (Proposition~\ref {prop:debiasing_hurts}): $|\delta _s|/((1{-}2\bar \pi )\cdot \pi _s)>1$. (A)~Setting-level ROC (AUC $= 0.89$), compared with the $|\Delta \pi \times \Delta \tau |$ product (AUC $= 0.89$) and $\mathrm {CV}(\pi _s)$ (AUC $= 0.97$). (B)~Subgroup-level ROC: the $\Delta \pi $-only condition (AUC $= 0.86$) substantially outperforms the $|\Delta \pi \times \Delta \tau |$ product (AUC $= 0.73$). The $\Delta \tau $-free diagnostic depends only on estimable misclassification rates, breaking the circular dependency that would arise if CATE heterogeneity were required}{figure.caption.36}{}}
