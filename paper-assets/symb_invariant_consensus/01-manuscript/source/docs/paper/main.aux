\@writefile{lot}{\contentsline {table}{\numberline {11}{\ignorespaces MAX-SAT vs.\ count-only agreement across constraint weight $\alpha \in [0,1]$ on FOLIO ($n = 204$). Mistral-7B (BR $= 4.97\times $, seed 42); Qwen2.5-14B (BR $= 3.93\times $, seed 123). $\alpha {=}0$: pure Z3 satisfiability (no source-attribution); $\alpha {=}1$: full source-attribution penalty. Agreement $\geq 99\%$ at all $\alpha $ including endpoints, confirming vacuity is weight-insensitive.}}{16}{table.caption.45}\protected@file@percent }
\newlabel{tab:alpha-ablation}{{11}{16}{MAX-SAT vs.\ count-only agreement across constraint weight $\alpha \in [0,1]$ on FOLIO ($n = 204$). Mistral-7B (BR $= 4.97\times $, seed 42); Qwen2.5-14B (BR $= 3.93\times $, seed 123). $\alpha {=}0$: pure Z3 satisfiability (no source-attribution); $\alpha {=}1$: full source-attribution penalty. Agreement $\geq 99\%$ at all $\alpha $ including endpoints, confirming vacuity is weight-insensitive}{table.caption.45}{}}
