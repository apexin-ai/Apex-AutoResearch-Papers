\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces SICA vs.\ SC across all non-degenerate self-extraction conditions (sorted by SC). Two conditions show significant degradation after Benjamini--Hochberg (BH) correction ($m{=}6$ confirmatory; remaining exploratory); no condition shows a significant gain. $\Delta $ = SICA $-$ SC (pp). PW: ProofWriter. $^b$gold ICL; \textbf  {bold}: $p < 0.05$; {*}\,BH adj.\ $p = 0.042$; $^{3s}$/$^{4s}$\,multi-seed aggregates; $^\dagger $\,4-seed replication (Table~\ref {tab:multi-seed}); $^\ddagger $\,pilot ($n{\leq }30$). Unmarked: single-seed exploratory (seed 123, not selected post hoc). Degenerate conditions and power analysis in Appendices~\ref {app:oracle} and~\ref {app:power}.}}{4}{table.caption.5}\protected@file@percent }
\newlabel{tab:main_results}{{1}{4}{SICA vs.\ SC across all non-degenerate self-extraction conditions (sorted by SC). Two conditions show significant degradation after Benjamini--Hochberg (BH) correction ($m{=}6$ confirmatory; remaining exploratory); no condition shows a significant gain. $\Delta $ = SICA $-$ SC (pp). PW: ProofWriter. $^b$gold ICL; \textbf {bold}: $p < 0.05$; {*}\,BH adj.\ $p = 0.042$; $^{3s}$/$^{4s}$\,multi-seed aggregates; $^\dagger $\,4-seed replication (Table~\ref {tab:multi-seed}); $^\ddagger $\,pilot ($n{\leq }30$). Unmarked: single-seed exploratory (seed 123, not selected post hoc). Degenerate conditions and power analysis in Appendices~\ref {app:oracle} and~\ref {app:power}}{table.caption.5}{}}
