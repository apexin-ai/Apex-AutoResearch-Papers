\@writefile{lot}{\contentsline {table}{\numberline {42}{\ignorespaces Multi-seed replication results across six model$\times $dataset conditions. Each row uses an independent seed with fresh traces ($K{=}12$, $T{=}0.7$). Mistral-7B$\times $FOLIO shows directionally unstable $\Delta $ ($+0.16 \pm 2.70$\,pp). Mistral-7B, LLaMA-8B, and Qwen2.5-14B show consistently negative $\Delta $ on ProofWriter ($p < .001$ for LLaMA-8B and Mistral-7B); Qwen3-14B shows negligible mixed-sign $\Delta $ ($+0.92 \pm 1.14$\,pp, all n.s.), consistent with its high SC baseline minimizing correctable errors (\S  \ref {sec:discussion}).}}{28}{table.caption.102}\protected@file@percent }
\newlabel{tab:multi-seed}{{42}{28}{Multi-seed replication results across six model$\times $dataset conditions. Each row uses an independent seed with fresh traces ($K{=}12$, $T{=}0.7$). Mistral-7B$\times $FOLIO shows directionally unstable $\Delta $ ($+0.16 \pm 2.70$\,pp). Mistral-7B, LLaMA-8B, and Qwen2.5-14B show consistently negative $\Delta $ on ProofWriter ($p < .001$ for LLaMA-8B and Mistral-7B); Qwen3-14B shows negligible mixed-sign $\Delta $ ($+0.92 \pm 1.14$\,pp, all n.s.), consistent with its high SC baseline minimizing correctable errors (\S \ref {sec:discussion})}{table.caption.102}{}}
