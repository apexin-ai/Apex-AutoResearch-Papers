              "content": "{\"result\":\"{\\\"success\\\": true, \\\"data\\\": {\\\"stdout\\\": \\\"#!/bin/bash\\\\n# exp-010: Mistral-7B-Instruct-v0.3 SICA evaluation (cross-family validation)\\\\n# D012: 30 FOLIO + 30 ProofWriter D5, K=12, T=0.7, max_tokens=4096\\\\n# Claim 2 cross-model-family validation (non-Qwen architecture)\\\\nset -e\\\\ncd /root/symb_invariant_consensus\\\\nsource /root/miniconda3/etc/profile.d/conda.sh && conda activate base\\\\n\\\\nMODEL=\\\\\\\"/root/autodl-tmp/models/Mistral-7B-Instruct-v0.3\\\\\\\"\\\\nPORT=8000\\\\nRESULTS_DIR=\\\\\\\"results/exp010_mistral\\\\\\\"\\\\nmkdir -p \\\\\\\"$RESULTS_DIR\\\\\\\"\\\\n\\\\n# Step 1: Start vLLM in background\\\\necho \\\\\\\"=== [$(date)] Starting vLLM (Mistral-7B-Instruct-v0.3) on port $PORT ===\\\\\\\"\\\\npython -m vllm.entrypoints.openai.api_server \\\\\\\\\\\\n    --model \\\\\\\"$MODEL\\\\\\\" \\\\\\\\\\\\n    --max-model-len 8192 \\\\\\\\\\\\n    --gpu-memory-utilization 0.90 \\\\\\\\\\\\n    --port $PORT \\\\\\\\\\\\n    --trust-remote-code \\\\\\\\\\\\n    --dtype auto > /tmp/vllm_exp010.log 2>&1 &\\\\nVLLM_PID=$!\\\\necho \\\\\\\"vLLM PID: $VLLM_PID\\\\\\\"\\\\n\\\\n# Step 2: Wait for vLLM ready (up to 180s)\\\\necho \\\\\\\"Waiting for vLLM to be ready...\\\\\\\"\\\\nfor i in $(seq 1 180); do\\\\n    if curl -s http://localhost:$PORT/v1/models > /dev/null 2>&1; then\\\\n        echo \\\\\\\"vLLM ready after ${i}s\\\\\\\"\\\\n        break\\\\n    fi\\\\n    if ! kill -0 $VLLM_PID 2>/dev/null; then\\\\n        echo \\\\\\\"ERROR: vLLM process died. Check /tmp/vllm_exp010.log\\\\\\\"\\\\n        cat /tmp/vllm_exp010.log | tail -20\\\\n        exit 1\\\\n    fi\\\\n    sleep 1\\\\ndone\\\\n\\\\nif ! curl -s http://localhost:$PORT/v1/models > /dev/null 2>&1; then\\\\n    echo \\\\\\\"ERROR: vLLM did not start within 180s\\\\\\\"\\\\n    kill $VLLM_PID 2>/dev/null\\\\n    exit 1\\\\nfi\\\\n\\\\n# Step 3: Run SICA pipeline\\\\necho \\\\\\\"=== [$(date)] Running SICA pipeline: K=12, T=0.7, 60 problems ===\\\\\\\"\\\\npython3 run_full_mvp.py \\\\\\\\\\\\n    --mode vllm \\\\\\\\\\\\n    --k 12 \\\\\\\\\\\\n    --temperature 0.7 \\\\\\\\\\\\n    --max-tokens 4096 \\\\\\\\\\\\n    --api-base \\\\\\\"http://localhost:$PORT/v1\\\\\\\" \\\\\\\\\\\\n    --math-data data/empty.json \\\\\\\\\\\\n    --pw-data data/proofwriter_30.json \\\\\\\\\\\\n    --folio-data data/folio_30.json \\\\\\\\\\\\n    --output \\\\\\\"$RESULTS_DIR/exp010_results.json\\\\\\\" \\\\\\\\\\\\n    --save-intermediates \\\\\\\\\\\\n    --seed 42\\\\n\\\\n# Step 4: Cleanup\\\\necho \\\\\\\"=== [$(date)] Stopping vLLM ===\\\\\\\"\\\\nkill $VLLM_PID 2>/dev/null || true\\\\nwait $VLLM_PID 2>/dev/null || true\\\\necho \\\\\\\"EXP010_DONE\\\\\\\"\\\\n\\\", \\\"stderr\\\": \\\"\\\", \\\"return_code\\\": 0}, \\\"error\\\": null, \\\"metadata\\\": {\\\"elapsed_seconds\\\": 1.2}}\"}"
