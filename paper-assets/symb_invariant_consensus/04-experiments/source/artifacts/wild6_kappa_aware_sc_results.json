  "wild6_kappa_aware_sc": {
    "description": "kappa-aware adaptive SC threshold analysis across 11 experiments, 5 models, 2 datasets",
    "conclusion": "NEGATIVE RESULT: No adaptive threshold strategy beats standard SC. Accuracy monotonically increases with agreement level across all experiments.",
    "key_findings": [
      "Accuracy is monotonically increasing with majority fraction in ALL 11 experiments",
      "No groupthink effect observed: unanimous consensus = highest accuracy (70-93%)",
      "Weak agreement regime has lowest accuracy (25-60%)",
      "Anti-groupthink strategies (abstaining on high-agreement) always hurt accuracy",
      "Confidence thresholds only trade coverage for conditional accuracy, never improve overall accuracy",
      "This validates the CJT assumption underlying SC: higher agreement -> higher correctness"
    ],
