{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UeCmoWER4PvybS5UvuRkKN","type":"tool_result","content":"{\"result\":\"{\\\"success\\\": true, \\\"data\\\": {\\\"path\\\": \\\"/home/ubuntu/.agent-ml-research-idea_gen_0513_3/projects/symb_invariant_consensus/literature_map.yaml\\\", \\\"content\\\": \\\"# Literature Map — symb_invariant_consensus (SICA)\\\\n# Last updated: 2026-05-16\\\\n# Purpose: Track related work coverage for EMNLP 2026 submission\\\\n\\\\ndimensions:\\\\n\\\\n  self_consistency_and_variants:\\\\n    description: \\\\\\\"Self-Consistency (SC) decoding and improvements\\\\\\\"\\\\n    papers:\\\\n      - id: wang2023sc\\\\n        title: \\\\\\\"Self-Consistency Improves Chain of Thought Reasoning in Language Models\\\\\\\"\\\\n        authors: \\\\\\\"Wang et al.\\\\\\\"\\\\n        venue: \\\\\\\"ICLR 2023\\\\\\\"\\\\n        arxiv: \\\\\\\"2203.11171\\\\\\\"\\\\n        relevance: \\\\\\\"Foundational SC method; our primary baseline\\\\\\\"\\\\n        status: must_cite\\\\n\\\\n      - id: chen2024usc\\\\n        title: \\\\\\\"Universal Self-Consistency for Large Language Model Generation\\\\\\\"\\\\n        authors: \\\\\\\"Chen et al.\\\\\\\"\\\\n        venue: \\\\\\\"ICML 2024\\\\\\\"\\\\n        arxiv: \\\\\\\"2311.17311\\\\\\\"\\\\n        relevance: \\\\\\\"Extends SC to free-form answers via LLM-based selection; alternative aggregation\\\\\\\"\\\\n        status: must_cite\\\\n\\\\n      - id: taubenfeld2025cisc\\\\n        title: \\\\\\\"Confidence Improves Self-Consistency in LLMs\\\\\\\"\\\\n        authors: \\\\\\\"Taubenfeld et al.\\\\\\\"\\\\n        venue: \\\\\\\"ACL Findings 2025\\\\\\\"\\\\n        arxiv: \\\\\\\"2502.06233\\\\\\\"\\\\n        relevance: \\\\\\\"Weighted voting via model confidence; reduces samples 40-50%. Shows SC can be improved with non-uniform weighting — SICA uses constraint-based weighting instead\\\\\\\"\\\\n        status: must_cite\\\\n\\\\n      - id: kim2026reasc\\\\n        title: \\\\\\\"Reliability-Aware Adaptive Self-Consistency (ReASC)\\\\\\\"\\\\n        authors: \\\\\\\"Kim et al.\\\\\\\"\\\\n        venue: \\\\\\\"2026\\\\\\\"\\\\n        relevance: \\\\\\\"Response-level confidence for early halting; 70-80% cost saving vs naive SC\\\\\\\"\\\\n        status: should_cite\\\\n\\\\n      - id: loo2025reevaluating\\\\n        title: \\\\\\\"Reevaluating Self-Consistency Scaling in Multi-Agent Systems\\\\\\\"\\\\n        authors: \\\\\\\"Loo et al.\\\\\\\"\\\\n        venue: \\\\\\\"arXiv 2025\\\\\\\"\\\\n        arxiv: \\\\\\\"2511.00751\\\\\\\"\\\\n        relevance: \\\\\\\"CRITICAL — shows SC gains plateau early and can decline at high sample counts for strong models. Directly supports our QwQ-32B finding (SICA≡SC when model is too consistent)\\\\\\\"\\\\n        status: must_cite\\\\n\\\\n      - id: wan2024rasc\\\\n        title: \\\\\\\"Reasoning-Aware Self-Consistency (RASC)\\\\\\\"\\\\n        authors: \\\\\\\"Wan et al.\\\\\\\"\\\\n        venue: \\\\\\\"2024\\\\\\\"\\\\n        relevance: \\\\\\\"Combines answer-level and rationale-level features; reduces samples ~88%\\\\\\\"\\\\n        status: should_cite\\\\n\\\\n      - id: dsc2025\\\\n        title: \\\\\\\"Difficulty-Adaptive Self-Consistency\\\\\\\"\\\\n        authors: \\\\\\\"Various\\\\\\\"\\\\n        venue: \\\\\\\"NAACL Findings 2025\\\\\\\"\\\\n        relevance: \\\\\\\"Ranks problem difficulty to allocate sampling budget; complementary efficiency approach\\\\\\\"\\\\n        status: optional\\\\n\\\\n  symbolic_reasoning_llm:\\\\n    description: \\\\\\\"Neuro-symbolic methods combining LLMs with formal solvers\\\\\\\"\\\\n    papers:\\\\n      - id: pan2023logiclm\\\\n        title: \\\\\\\"Logic-LM: Empowering Large Language Models with Symbolic Solvers for Faithful Logical Reasoning\\\\\\\"\\\\n        authors: \\\\\\\"Pan et al.\\\\\\\"\\\\n        venue: \\\\\\\"EMNLP Findings 2023\\\\\\\"\\\\n        arxiv: \\\\\\\"2305.12295\\\\\\\"\\\\n        relevance: \\\\\\\"LLM→FOL→solver pipeline; closest architectural ancestor to SICA. Key difference: Logic-LM uses single-path translation, SICA aggregates across multiple paths\\\\\\\"\\\\n        status: must_cite\\\\n\\\\n      - id: xu2026dylos\\\\n        title: \\\\\\\"Adaptive LLM-Symbolic Reasoning via Dynamic Logical Solver Composition (DyLoS)\\\\\\\"\\\\n        authors: \\\\\\\"Xu et al.\\\\\\\"\\\\n        venue: \\\\\\\"EACL 2026\\\\\\\"\\\\n        arxiv: \\\\\\\"2510.06774\\\\\\\"\\\\n        relevance: \\\\\\\"Multi-paradigm solver selection (LP/FOL/CSP/SMT); evaluated on FOLIO+ProofWriter. Outperforms Logic-LM. Key difference: DyLoS selects solver type, SICA aggregates constraints across paths\\\\\\\"\\\\n        status: must_cite\\\\n\\\\n      - id: fover2025\\\\n        title: \\\\\\\"FoVer: First-Order Logic Verification for Natural Language Reasoning\\\\\\\"\\\\n        authors: \\\\\\\"Various\\\\\\\"\\\\n        venue: \\\\\\\"TACL 2025\\\\\\\"\\\\n        relevance: \\\\\\\"FOL verification for NL reasoning; strong results on ProofWriter+FOLIO. Uses verification rather than aggregation\\\\\\\"\\\\n        status: must_cite\\\\n\\\\n      - id: li2025survey\\\\n        title: \\\\\\\"A Survey on LLM Symbolic Reasoning\\\\\\\"\\\\n        authors: \\\\\\\"Li et al.\\\\\\\"\\\\n        venue: \\\\\\\"2025 (under review)\\\\\\\"\\\\n        relevance: \\\\\\\"Comprehensive survey; positions SICA within the broader landscape\\\\\\\"\\\\n        status: should_cite\\\\n\\\\n      - id: constraintllm2025\\\\n        title: \\\\\\\"ConstraintLLM: A Neuro-Symbolic Framework for Industrial Constraint Programming\\\\\\\"\\\\n        authors: \\\\\\\"Various\\\\\\\"\\\\n        venue: \\\\\\\"EMNLP 2025\\\\\\\"\\\\n        relevance: \\\\\\\"Multi-instruction SFT for constraint extraction; different domain (industrial) but related extraction methodology\\\\\\\"\\\\n        status: optional\\\\n\\\\n  maxsat_constraint_nlp:\\\\n    description: \\\\\\\"MAX-SAT and constraint satisfaction applied to NLP/reasoning\\\\\\\"\\\\n    papers:\\\\n      - id: llm_meets_cp2025\\\\n        title: \\\\\\\"Large Language Model Meets Constraint Propagation\\\\\\\"\\\\n        authors: \\\\\\\"Various\\\\\\\"\\\\n        venue: \\\\\\\"IJCAI 2025\\\\\\\"\\\\n        relevance: \\\\\\\"LLM+constraint propagation integration; validates feasibility of constraint-based reasoning with LLMs\\\\\\\"\\\\n        status: should_cite\\\\n\\\\n      - id: satbench2025\\\\n        title: \\\\\\\"SATBench: Benchmarking LLMs' Logical Reasoning via SAT Problems\\\\\\\"\\\\n        authors: \\\\\\\"Various\\\\\\\"\\\\n        venue: \\\\\\\"EMNLP 2025\\\\\\\"\\\\n        relevance: \\\\\\\"Evaluates LLMs on SAT-formulated problems; establishes that LLMs struggle with pure SAT but can benefit from solver integration\\\\\\\"\\\\n        status: should_cite\\\\n\\\\n      - id: maxsat_local_search2025\\\\n        title: \\\\\\\"Optimizing Local Search-based Partial MaxSAT Solving via Initial Assignment Prediction\\\\\\\"\\\\n        authors: \\\\\\\"Various\\\\\\\"\\\\n        venue: \\\\\\\"Science China Information Sciences 2025\\\\\\\"\\\\n        relevance: \\\\\\\"Solver-side advances in partial MaxSAT; technical reference for our WPMS formulation\\\\\\\"\\\\n        status: optional\\\\n\\\\n  folio_proofwriter_sota:\\\\n    description: \\\\\\\"State-of-the-art methods on FOLIO and ProofWriter benchmarks\\\\\\\"\\\\n    papers:\\\\n      - id: logicagent2025\\\\n        title: \\\\\\\"From Ambiguity to Verdict: A Semiotic-Grounded Multi-Perspective Agent for LLM Logical Reasoning (LogicAgent)\\\\\\\"\\\\n        authors: \\\\\\\"Various\\\\\\\"\\\\n        venue: \\\\\\\"2025\\\\\\\"\\\\n        arxiv: \\\\\\\"2509.24765\\\\\\\"\\\\n        relevance: \\\\\\\"Multi-perspective logical reasoning; SOTA on logical reasoning benchmarks including FOLIO. +7.05% average gain\\\\\\\"\\\\n        status: must_cite\\\\n\\\\n      - id: aristotle2025\\\\n        title: \\\\\\\"Aristotle: Mastering Logical Reasoning with A Logic-Complete Decompose-Search-Resolve Framework\\\\\\\"\\\\n        authors: \\\\\\\"Various\\\\\\\"\\\\n        venue: \\\\\\\"ACL 2025\\\\\\\"\\\\n        relevance: \\\\\\\"Logic-complete decomposition framework; strong ProofWriter/FOLIO results\\\\\\\"\\\\n        status: must_cite\\\\n\\\\n      - id: qi2025symbolic_provers\\\\n        title: \\\\\\\"Large Language Models Meet Symbolic Provers for Logical Reasoning Evaluation\\\\\\\"\\\\n        authors: \\\\\\\"Qi et al.\\\\\\\"\\\\n        venue: \\\\\\\"ICLR 2025\\\\\\\"\\\\n        arxiv: \\\\\\\"2502.06563\\\\\\\"\\\\n        relevance: \\\\\\\"LLM+symbolic prover combination; evaluated on FOLIO\\\\\\\"\\\\n        status: should_cite\\\\n\\\\n      - id: dissecting2025\\\\n        title: \\\\\\\"Dissecting Logical Reasoning in LLMs: A Fine-Grained Evaluation\\\\\\\"\\\\n        authors: \\\\\\\"Various\\\\\\\"\\\\n        venue: \\\\\\\"EMNLP Findings 2025\\\\\\\"\\\\n        arxiv: \\\\\\\"2506.04810\\\\\\\"\\\\n        relevance: \\\\\\\"Fine-grained analysis of LLM logical reasoning capabilities on ProofWriter/FOLIO\\\\\\\"\\\\n        status: optional\\\\n\\\\n  reasoning_model_diversity:\\\\n    description: \\\\\\\"Trace diversity in reasoning vs non-reasoning models; supports our QwQ-32B finding\\\\\\\"\\\\n    papers:\\\\n      - id: loo2025reevaluating\\\\n        title: \\\\\\\"Reevaluating Self-Consistency Scaling in Multi-Agent Systems\\\\\\\"\\\\n        authors: \\\\\\\"Loo et al.\\\\\\\"\\\\n        venue: \\\\\\\"arXiv 2025\\\\\\\"\\\\n        arxiv: \\\\\\\"2511.00751\\\\\\\"\\\\n        relevance: \\\\\\\"CRITICAL — strong models produce near-identical paths, SC gains plateau/decline. Direct support for SICA≡SC on QwQ-32B\\\\\\\"\\\\n        status: must_cite\\\\n\\\\n      - id: diversity_aware_tts2025\\\\n        title: \\\\\\\"Diversity-Aware Training for Test-Time Scaling\\\\\\\"\\\\n        authors: \\\\\\\"Various\\\\\\\"\\\\n        venue: \\\\\\\"Under review 2025\\\\\\\"\\\\n        relevance: \\\\\\\"Independent reasoning attempts collapse into similar solutions; diversity training needed to unlock test-time scaling. Supports our claim that non-reasoning models have more useful diversity\\\\\\\"\\\\n        status: must_cite\\\\n\\\\n      - id: snell2025scaling_tts\\\\n        title: \\\\\\\"Scaling LLM Test-Time Compute Optimally Can be More Effective than Scaling Parameters\\\\\\\"\\\\n        authors: \\\\\\\"Snell et al.\\\\\\\"\\\\n        venue: \\\\\\\"ICLR 2025 (Oral)\\\\\\\"\\\\n        arxiv: \\\\\\\"2408.03314\\\\\\\"\\\\n        relevance: \\\\\\\"Foundational test-time compute scaling; shows compute-optimal strategies vary by difficulty. Contextualizes why SICA needs diverse paths\\\\\\\"\\\\n        status: should_cite\\\\n\\\\n      - id: deepseek_r1_2025\\\\n        title: \\\\\\\"DeepSeek-R1: Incentivizing Reasoning Capability in LLMs via Reinforcement Learning\\\\\\\"\\\\n        authors: \\\\\\\"DeepSeek-AI\\\\\\\"\\\\n        venue: \\\\\\\"Nature 2025\\\\\\\"\\\\n        arxiv: \\\\\\\"2501.12948\\\\\\\"\\\\n        relevance: \\\\\\\"Defines the reasoning model paradigm (RL-trained extended thinking); reference for why these models are highly self-consistent\\\\\\\"\\\\n        status: must_cite\\\\n\\\\n      - id: base_models_reason2025\\\\n        title: \\\\\\\"Base Models Know How to Reason, Thinking Models Learn When\\\\\\\"\\\\n        authors: \\\\\\\"Various\\\\\\\"\\\\n        venue: \\\\\\\"2025\\\\\\\"\\\\n        arxiv: \\\\\\\"2510.07364\\\\\\\"\\\\n        relevance: \\\\\\\"RL teaches activation timing not new skills; implies reasoning models converge to similar reasoning patterns, reducing trace diversity\\\\\\\"\\\\n        status: should_cite\\\\n\\\\n      - id: korikov2025sc_ranking\\\\n        title: \\\\\\\"The Impact of LLM Self-Consistency and Reasoning Effort on Automated Scoring\\\\\\\"\\\\n        authors: \\\\\\\"Korikov et al.\\\\\\\"\\\\n        venue: \\\\\\\"arXiv 2026\\\\\\\"\\\\n        arxiv: \\\\\\\"2604.26954\\\\\\\"\\\\n        relevance: \\\\\\\"Temperature sampling helps but ensemble size (1→7) produces no significant gains; supports diminishing returns of naive SC\\\\\\\"\\\\n        status: optional\\\\n\\\\n  multi_path_aggregation:\\\\n    description: \\\\\\\"Methods for aggregating multiple reasoning paths beyond majority voting\\\\\\\"\\\\n    papers:\\\\n      - id: rc2025\\\\n        title: \\\\\\\"Representation Consistency for Accurate and Coherent LLM Answer Aggregation\\\\\\\"\\\\n        authors: \\\\\\\"Various\\\\\\\"\\\\n        venue: \\\\\\\"arXiv 2025\\\\\\\"\\\\n        arxiv: \\\\\\\"2506.21590\\\\\\\"\\\\n        relevance: \\\\\\\"Aggregation via representation similarity; down-weights incoherent reasoning. Semantic alternative to SICA's symbolic approach\\\\\\\"\\\\n        status: should_cite\\\\n\\\\n      - id: multi_path_plan2025\\\\n        title: \\\\\\\"Enhancing Long Chain-of-Thought Reasoning through Multi-Path Plan Aggregation\\\\\\\"\\\\n        authors: \\\\\\\"Various\\\\\\\"\\\\n        venue: \\\\\\\"2025\\\\\\\"\\\\n        arxiv: \\\\\\\"2510.11620\\\\\\\"\\\\n        relevance: \\\\\\\"Multi-path aggregation at plan level rather than answer level\\\\\\\"\\\\n        status: optional\\\\n\\\\n      - id: crest2025\\\\n        title: \\\\\\\"Improving LLMs' Reasoning with Consistency-Driven Self-Training (CREST)\\\\\\\"\\\\n        authors: \\\\\\\"Various\\\\\\\"\\\\n        venue: \\\\\\\"NAACL 2025\\\\\\\"\\\\n        relevance: \\\\\\\"Consistency as training signal rather than inference-time aggregation\\\\\\\"\\\\n        status: optional\\\\n\\\\ngaps:\\\\n  resolved: []\\\\n  remaining:\\\\n    - dimension: \\\\\\\"reasoning_model_diversity\\\\\\\"\\\\n      gap: \\\\\\\"No published paper explicitly studies QwQ-32B trace diversity collapse under temperature sampling. Our empirical finding (3.6% multi-candidate across 83 problems) is novel but needs positioning against Loo et al. 2025 and Diversity-Aware TTS\\\\\\\"\\\\n    - dimension: \\\\\\\"maxsat_constraint_nlp\\\\\\\"\\\\n      gap: \\\\\\\"No direct precedent for weighted partial MAX-SAT as multi-path consensus mechanism in NLI. SICA's formulation appears novel — must frame clearly in Related Work\\\\\\\"\\\\n    - dimension: \\\\\\\"self_consistency_and_variants\\\\\\\"\\\\n      gap: \\\\\\\"Should verify if CRAFT (mentioned in project docs) is a real published method or internal shorthand\\\\\\\"\\\\n\\\", \\\"total_chars\\\": 11286, \\\"truncated\\\": false}, \\\"error\\\": null, \\\"metadata\\\": {}}\"}"}]},"parent_tool_use_id":"toolu_01KovTdP32jQALZZ31kqF98v","session_id":"d75fd3e3-4be2-4907-b321-108d486cc320","uuid":"91e75609-757a-4286-be64-f793e09a4bd9","timestamp":"2026-05-17T15:46:51.812Z"}
