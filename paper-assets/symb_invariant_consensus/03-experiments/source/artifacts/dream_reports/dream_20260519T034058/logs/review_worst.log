{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016bUSPFeyWTKYMwQSiKW7Js","type":"tool_result","content":"{\"result\":\"{\\\"success\\\": true, \\\"data\\\": {\\\"path\\\": \\\"/home/ubuntu/.agent-ml-research-idea_gen_0513_3/projects/symb_invariant_consensus/literature_map.yaml\\\", \\\"content\\\": \\\"# Literature Map — symb_invariant_consensus (SICA)\\\\n# Last updated: 2026-05-16\\\\n# Purpose: Track related work coverage for EMNLP 2026 submission\\\\n\\\\ndimensions:\\\\n\\\\n  self_consistency_and_variants:\\\\n    description: \\\\\\\"Self-Consistency (SC) decoding and improvements\\\\\\\"\\\\n    papers:\\\\n      - id: wang2023sc\\\\n        title: \\\\\\\"Self-Consistency Improves Chain of Thought Reasoning in Language Models\\\\\\\"\\\\n        authors: \\\\\\\"Wang et al.\\\\\\\"\\\\n        venue: \\\\\\\"ICLR 2023\\\\\\\"\\\\n        arxiv: \\\\\\\"2203.11171\\\\\\\"\\\\n        relevance: \\\\\\\"Foundational SC method; our primary baseline\\\\\\\"\\\\n        status: must_cite\\\\n\\\\n      - id: chen2024usc\\\\n        title: \\\\\\\"Universal Self-Consistency for Large Language Model Generation\\\\\\\"\\\\n        authors: \\\\\\\"Chen et al.\\\\\\\"\\\\n        venue: \\\\\\\"ICML 2024\\\\\\\"\\\\n        arxiv: \\\\\\\"2311.17311\\\\\\\"\\\\n        relevance: \\\\\\\"Extends SC to free-form answers via LLM-based selection; alternative aggregation\\\\\\\"\\\\n        status: must_cite\\\\n\\\\n      - id: taubenfeld2025cisc\\\\n        title: \\\\\\\"Confidence Improves Self-Consistency in LLMs\\\\\\\"\\\\n        authors: \\\\\\\"Taubenfeld et al.\\\\\\\"\\\\n        venue: \\\\\\\"ACL Findings 2025\\\\\\\"\\\\n        arxiv: \\\\\\\"2502.06233\\\\\\\"\\\\n        relevance: \\\\\\\"Weighted voting via model confidence; reduces samples 40-50%. Shows SC can be improved with non-uniform weighting — SICA uses constraint-based weighting instead\\\\\\\"\\\\n        status: must_cite\\\\n\\\\n      - id: kim2026reasc\\\\n        title: \\\\\\\"Reliability-Aware Adaptive Self-Consistency (ReASC)\\\\\\\"\\\\n        authors: \\\\\\\"Kim et al.\\\\\\\"\\\\n        venue: \\\\\\\"2026\\\\\\\"\\\\n        relevance: \\\\\\\"Response-level confidence for early halting; 70-80% cost saving vs naive SC\\\\\\\"\\\\n        status: should_cite\\\\n\\\\n      - id: loo2025reevaluating\\\\n        title: \\\\\\\"Reevaluating Self-Consistency Scaling in Multi-Agent Systems\\\\\\\"\\\\n        authors: \\\\\\\"Loo et al.\\\\\\\"\\\\n        venue: \\\\\\\"arXiv 2025\\\\\\\"\\\\n        arxiv: \\\\\\\"2511.00751\\\\\\\"\\\\n        relevance: \\\\\\\"CRITICAL — shows SC gains plateau early and can decline at high sample counts for strong models. Directly supports our QwQ-32B finding (SICA≡SC when model is too consistent)\\\\\\\"\\\\n        status: must_cite\\\\n\\\\n      - id: wan2024rasc\\\\n        title: \\\\\\\"Reasoning-Aware Self-Consistency (RASC)\\\\\\\"\\\\n        authors: \\\\\\\"Wan et al.\\\\\\\"\\\\n        venue: \\\\\\\"2024\\\\\\\"\\\\n        relevance: \\\\\\\"Combines answer-level and rationale-level features; reduces samples ~88%\\\\\\\"\\\\n        status: should_cite\\\\n\\\\n      - id: li2023diverse\\\\n        title: \\\\\\\"Making Language Models Better Reasoners with Step-Aware Verifier\\\\\\\"\\\\n        authors: \\\\\\\"Li et al.\\\\\\\"\\\\n        venue: \\\\\\\"ACL 2023\\\\\\\"\\\\n        arxiv: \\\\\\\"2206.02336\\\\\\\"\\\\n        relevance: \\\\\\\"DiVeRSe: diverse prompts + step-aware verification for SC improvement. Combines diversity generation with trained verifier — shows diversity alone insufficient without verification quality.\\\\\\\"\\\\n        status: must_cite\\\\n        verified: true\\\\n\\\\n      - id: dsc2025\\\\n        title: \\\\\\\"Difficulty-Adaptive Self-Consistency\\\\\\\"\\\\n        authors: \\\\\\\"Various\\\\\\\"\\\\n        venue: \\\\\\\"NAACL Findings 2025\\\\\\\"\\\\n        relevance: \\\\\\\"Ranks problem difficulty to allocate sampling budget; complementary efficiency approach\\\\\\\"\\\\n        status: optional\\\\n\\\\n  symbolic_reasoning_llm:\\\\n    description: \\\\\\\"Neuro-symbolic methods combining LLMs with formal solvers\\\\\\\"\\\\n    papers:\\\\n      - id: olausson2023linc\\\\n        title: \\\\\\\"LINC: A Neurosymbolic Approach for Logical Reasoning by Combining Language Models with First-Order Logic Provers\\\\\\\"\\\\n        authors: \\\\\\\"Olausson et al.\\\\\\\"\\\\n        venue: \\\\\\\"EMNLP 2023\\\\\\\"\\\\n        arxiv: \\\\\\\"2310.15164\\\\\\\"\\\\n        relevance: \\\\\\\"LLM translates NL to FOL, external prover verifies; same-model translation pipeline like Logic-LM. Documents translation error rates (~40% on FOLIO). Key reference for self-extraction quality issues.\\\\\\\"\\\\n        status: must_cite\\\\n        verified: true\\\\n\\\\n      - id: pan2023logiclm\\\\n        title: \\\\\\\"Logic-LM: Empowering Large Language Models with Symbolic Solvers for Faithful Logical Reasoning\\\\\\\"\\\\n        authors: \\\\\\\"Pan et al.\\\\\\\"\\\\n        venue: \\\\\\\"EMNLP Findings 2023\\\\\\\"\\\\n        arxiv: \\\\\\\"2305.12295\\\\\\\"\\\\n        relevance: \\\\\\\"LLM→FOL→solver pipeline; closest architectural ancestor to SICA. Key difference: Logic-LM uses single-path translation, SICA aggregates across multiple paths\\\\\\\"\\\\n        status: must_cite\\\\n\\\\n      - id: xu2026dylos\\\\n        title: \\\\\\\"Adaptive LLM-Symbolic Reasoning via Dynamic Logical Solver Composition (DyLoS)\\\\\\\"\\\\n        authors: \\\\\\\"Xu et al.\\\\\\\"\\\\n        venue: \\\\\\\"EACL 2026\\\\\\\"\\\\n        arxiv: \\\\\\\"2510.06774\\\\\\\"\\\\n        relevance: \\\\\\\"Multi-paradigm solver selection (LP/FOL/CSP/SMT); evaluated on FOLIO+ProofWriter. Outperforms Logic-LM. Key difference: DyLoS selects solver type, SICA aggregates constraints across paths\\\\\\\"\\\\n        status: must_cite\\\\n\\\\n      - id: fover2025\\\\n        title: \\\\\\\"FoVer: First-Order Logic Verification for Natural Language Reasoning\\\\\\\"\\\\n        authors: \\\\\\\"Various\\\\\\\"\\\\n        venue: \\\\\\\"TACL 2025\\\\\\\"\\\\n        relevance: \\\\\\\"FOL verification for NL reasoning; strong results on ProofWriter+FOLIO. Uses verification rather than aggregation\\\\\\\"\\\\n        status: must_cite\\\\n\\\\n      - id: li2025survey\\\\n        title: \\\\\\\"A Survey on LLM Symbolic Reasoning\\\\\\\"\\\\n        authors: \\\\\\\"Li et al.\\\\\\\"\\\\n        venue: \\\\\\\"2025 (under review)\\\\\\\"\\\\n        relevance: \\\\\\\"Comprehensive survey; positions SICA within the broader landscape\\\\\\\"\\\\n        status: should_cite\\\\n\\\\n      - id: constraintllm2025\\\\n        title: \\\\\\\"ConstraintLLM: A Neuro-Symbolic Framework for Industrial Constraint Programming\\\\\\\"\\\\n        authors: \\\\\\\"Various\\\\\\\"\\\\n        venue: \\\\\\\"EMNLP 2025\\\\\\\"\\\\n        relevance: \\\\\\\"Multi-instruction SFT for constraint extraction; different domain (industrial) but related extraction methodology\\\\\\\"\\\\n        status: optional\\\\n\\\\n  maxsat_constraint_nlp:\\\\n    description: \\\\\\\"MAX-SAT and constraint satisfaction applied to NLP/reasoning\\\\\\\"\\\\n    papers:\\\\n      - id: demoura2008z3\\\\n        title: \\\\\\\"Z3: An Efficient SMT Solver\\\\\\\"\\\\n        authors: \\\\\\\"de Moura and Bjorner\\\\\\\"\\\\n        venue: \\\\\\\"TACAS 2008\\\\\\\"\\\\n        relevance: \\\\\\\"Z3 SMT solver; our core constraint satisfaction engine for weighted partial MAX-SAT evaluation.\\\\\\\"\\\\n        status: must_cite\\\\n        verified: true\\\\n\\\\n      - id: llm_meets_cp2025\\\\n        title: \\\\\\\"Large Language Model Meets Constraint Propagation\\\\\\\"\\\\n        authors: \\\\\\\"Various\\\\\\\"\\\\n        venue: \\\\\\\"IJCAI 2025\\\\\\\"\\\\n        relevance: \\\\\\\"LLM+constraint propagation integration; validates feasibility of constraint-based reasoning with LLMs\\\\\\\"\\\\n        status: should_cite\\\\n\\\\n      - id: satbench2025\\\\n        title: \\\\\\\"SATBench: Benchmarking LLMs' Logical Reasoning via SAT Problems\\\\\\\"\\\\n        authors: \\\\\\\"Various\\\\\\\"\\\\n        venue: \\\\\\\"EMNLP 2025\\\\\\\"\\\\n        relevance: \\\\\\\"Evaluates LLMs on SAT-formulated problems; establishes that LLMs struggle with pure SAT but can benefit from solver integration\\\\\\\"\\\\n        status: should_cite\\\\n\\\\n      - id: maxsat_local_search2025\\\\n        title: \\\\\\\"Optimizing Local Search-based Partial MaxSAT Solving via Initial Assignment Prediction\\\\\\\"\\\\n        authors: \\\\\\\"Various\\\\\\\"\\\\n        venue: \\\\\\\"Science China Information Sciences 2025\\\\\\\"\\\\n        relevance: \\\\\\\"Solver-side advances in partial MaxSAT; technical reference for our WPMS formulation\\\\\\\"\\\\n        status: optional\\\\n\\\\n  folio_proofwriter_sota:\\\\n    description: \\\\\\\"State-of-the-art methods on FOLIO and ProofWriter benchmarks\\\\\\\"\\\\n    papers:\\\\n      - id: logicagent2025\\\\n        title: \\\\\\\"From Ambiguity to Verdict: A Semiotic-Grounded Multi-Perspective Agent for LLM Logical Reasoning (LogicAgent)\\\\\\\"\\\\n        authors: \\\\\\\"Various\\\\\\\"\\\\n        venue: \\\\\\\"2025\\\\\\\"\\\\n        arxiv: \\\\\\\"2509.24765\\\\\\\"\\\\n        relevance: \\\\\\\"Multi-perspective logical reasoning; SOTA on logical reasoning benchmarks including FOLIO. +7.05% average gain\\\\\\\"\\\\n        status: must_cite\\\\n\\\\n      - id: aristotle2025\\\\n        title: \\\\\\\"Aristotle: Mastering Logical Reasoning with A Logic-Complete Decompose-Search-Resolve Framework\\\\\\\"\\\\n        authors: \\\\\\\"Various\\\\\\\"\\\\n        venue: \\\\\\\"ACL 2025\\\\\\\"\\\\n        relevance: \\\\\\\"Logic-complete decomposition framework; strong ProofWriter/FOLIO results\\\\\\\"\\\\n        status: must_cite\\\\n\\\\n      - id: qi2025symbolic_provers\\\\n        title: \\\\\\\"Large Language Models Meet Symbolic Provers for Logical Reasoning Evaluation\\\\\\\"\\\\n        authors: \\\\\\\"Qi et al.\\\\\\\"\\\\n        venue: \\\\\\\"ICLR 2025\\\\\\\"\\\\n        arxiv: \\\\\\\"2502.06563\\\\\\\"\\\\n        relevance: \\\\\\\"LLM+symbolic prover combination; evaluated on FOLIO\\\\\\\"\\\\n        status: should_cite\\\\n\\\\n      - id: dissecting2025\\\\n        title: \\\\\\\"Dissecting Logical Reasoning in LLMs: A Fine-Grained Evaluation\\\\\\\"\\\\n        authors: \\\\\\\"Various\\\\\\\"\\\\n        venue: \\\\\\\"EMNLP Findings 2025\\\\\\\"\\\\n        arxiv: \\\\\\\"2506.04810\\\\\\\"\\\\n        relevance: \\\\\\\"Fine-grained analysis of LLM logical reasoning capabilities on ProofWriter/FOLIO\\\\\\\"\\\\n        status: optional\\\\n\\\\n  reasoning_model_diversity:\\\\n    description: \\\\\\\"Trace diversity in reasoning vs non-reasoning models; supports our QwQ-32B finding\\\\\\\"\\\\n    papers:\\\\n      - id: loo2025reevaluating\\\\n        title: \\\\\\\"Reevaluating Self-Consistency Scaling in Multi-Agent Systems\\\\\\\"\\\\n        authors: \\\\\\\"Loo et al.\\\\\\\"\\\\n        venue: \\\\\\\"arXiv 2025\\\\\\\"\\\\n        arxiv: \\\\\\\"2511.00751\\\\\\\"\\\\n        relevance: \\\\\\\"CRITICAL — strong models produce near-identical paths, SC gains plateau/decline. Direct support for SICA≡SC on QwQ-32B\\\\\\\"\\\\n        status: must_cite\\\\n\\\\n      - id: diversity_aware_tts2025\\\\n        title: \\\\\\\"Diversity-Aware Training for Test-Time Scaling\\\\\\\"\\\\n        authors: \\\\\\\"Various\\\\\\\"\\\\n        venue: \\\\\\\"Under review 2025\\\\\\\"\\\\n        relevance: \\\\\\\"Independent reasoning attempts collapse into similar solutions; diversity training needed to unlock test-time scaling. Supports our claim that non-reasoning models have more useful diversity\\\\\\\"\\\\n        status: must_cite\\\\n\\\\n      - id: snell2025scaling_tts\\\\n        title: \\\\\\\"Scaling LLM Test-Time Compute Optimally Can be More Effective than Scaling Parameters\\\\\\\"\\\\n        authors: \\\\\\\"Snell et al.\\\\\\\"\\\\n        venue: \\\\\\\"ICLR 2025 (Oral)\\\\\\\"\\\\n        arxiv: \\\\\\\"2408.03314\\\\\\\"\\\\n        relevance: \\\\\\\"Foundational test-time compute scaling; shows compute-optimal strategies vary by difficulty. Contextualizes why SICA needs diverse paths\\\\\\\"\\\\n        status: should_cite\\\\n\\\\n      - id: deepseek_r1_2025\\\\n        title: \\\\\\\"DeepSeek-R1: Incentivizing Reasoning Capability in LLMs via Reinforcement Learning\\\\\\\"\\\\n        authors: \\\\\\\"DeepSeek-AI\\\\\\\"\\\\n        venue: \\\\\\\"Nature 2025\\\\\\\"\\\\n        arxiv: \\\\\\\"2501.12948\\\\\\\"\\\\n        relevance: \\\\\\\"Defines the reasoning model paradigm (RL-trained extended thinking); reference for why these models are highly self-consistent\\\\\\\"\\\\n        status: must_cite\\\\n\\\\n      - id: base_models_reason2025\\\\n        title: \\\\\\\"Base Models Know How to Reason, Thinking Models Learn When\\\\\\\"\\\\n        authors: \\\\\\\"Various\\\\\\\"\\\\n        venue: \\\\\\\"2025\\\\\\\"\\\\n        arxiv: \\\\\\\"2510.07364\\\\\\\"\\\\n        relevance: \\\\\\\"RL teaches activation timing not new skills; implies reasoning models converge to similar reasoning patterns, reducing trace diversity\\\\\\\"\\\\n        status: should_cite\\\\n\\\\n      - id: korikov2025sc_ranking\\\\n        title: \\\\\\\"The Impact of LLM Self-Consistency and Reasoning Effort on Automated Scoring\\\\\\\"\\\\n        authors: \\\\\\\"Korikov et al.\\\\\\\"\\\\n        venue: \\\\\\\"arXiv 2026\\\\\\\"\\\\n        arxiv: \\\\\\\"2604.26954\\\\\\\"\\\\n        relevance: \\\\\\\"Temperature sampling helps but ensemble size (1→7) produces no significant gains; supports diminishing returns of naive SC\\\\\\\"\\\\n        status: optional\\\\n\\\\n  multi_path_aggregation:\\\\n    description: \\\\\\\"Methods for aggregating multiple reasoning paths beyond majority voting\\\\\\\"\\\\n    papers:\\\\n      - id: rc2025\\\\n        title: \\\\\\\"Representation Consistency for Accurate and Coherent LLM Answer Aggregation\\\\\\\"\\\\n        authors: \\\\\\\"Various\\\\\\\"\\\\n        venue: \\\\\\\"arXiv 2025\\\\\\\"\\\\n        arxiv: \\\\\\\"2506.21590\\\\\\\"\\\\n        relevance: \\\\\\\"Aggregation via representation similarity; down-weights incoherent reasoning. Semantic alternative to SICA's symbolic approach\\\\\\\"\\\\n        status: should_cite\\\\n\\\\n      - id: multi_path_plan2025\\\\n        title: \\\\\\\"Enhancing Long Chain-of-Thought Reasoning through Multi-Path Plan Aggregation\\\\\\\"\\\\n        authors: \\\\\\\"Various\\\\\\\"\\\\n        venue: \\\\\\\"2025\\\\\\\"\\\\n        arxiv: \\\\\\\"2510.11620\\\\\\\"\\\\n        relevance: \\\\\\\"Multi-path aggregation at plan level rather than answer level\\\\\\\"\\\\n        status: optional\\\\n\\\\n      - id: crest2025\\\\n        title: \\\\\\\"Improving LLMs' Reasoning with Consistency-Driven Self-Training (CREST)\\\\\\\"\\\\n        authors: \\\\\\\"Various\\\\\\\"\\\\n        venue: \\\\\\\"NAACL 2025\\\\\\\"\\\\n        relevance: \\\\\\\"Consistency as training signal rather than inference-time aggregation\\\\\\\"\\\\n        status: optional\\\\n\\\\n  verification_reranking:\\\\n    description: \\\\\\\"Verification and reranking methods for LLM outputs (ORM, PRM)\\\\\\\"\\\\n    papers:\\\\n      - id: cobbe2021gsm8k\\\\n        title: \\\\\\\"Training Verifiers to Solve Math Word Problems\\\\\\\"\\\\n        authors: \\\\\\\"Cobbe et al.\\\\\\\"\\\\n        venue: \\\\\\\"arXiv 2021\\\\\\\"\\\\n        arxiv: \\\\\\\"2110.14168\\\\\\\"\\\\n        relevance: \\\\\\\"Defines ORM (Outcome Reward Model) paradigm; trained verifier selects among candidate solutions. Alternative to symbolic constraint aggregation.\\\\\\\"\\\\n        status: must_cite\\\\n        verified: true\\\\n\\\\n      - id: lightman2023prm\\\\n        title: \\\\\\\"Let's Verify Step by Step\\\\\\\"\\\\n        authors: \\\\\\\"Lightman et al.\\\\\\\"\\\\n        venue: \\\\\\\"ICLR 2024\\\\\\\"\\\\n        arxiv: \\\\\\\"2305.20050\\\\\\\"\\\\n        relevance: \\\\\\\"Process Reward Models (PRM) verify each reasoning step. Shows step-level verification outperforms outcome-level. Trained verifier approach contrasts with SICA's self-extraction.\\\\\\\"\\\\n        status: must_cite\\\\n        verified: true\\\\n\\\\n      - id: wang2024mathshepherd\\\\n        title: \\\\\\\"Math-Shepherd: Verify and Reinforce LLMs Step-by-step without Human Annotations\\\\\\\"\\\\n        authors: \\\\\\\"Wang et al.\\\\\\\"\\\\n        venue: \\\\\\\"ACL 2024\\\\\\\"\\\\n        arxiv: \\\\\\\"2312.08935\\\\\\\"\\\\n        relevance: \\\\\\\"Automatic process reward model training without human labels. Achieves strong verification without manual annotation.\\\\\\\"\\\\n        status: must_cite\\\\n        verified: true\\\\n\\\\n      - id: hosseini2024vstar\\\\n        title: \\\\\\\"V-STaR: Training Verifiers for Self-Taught Reasoners\\\\\\\"\\\\n        authors: \\\\\\\"Hosseini et al.\\\\\\\"\\\\n        venue: \\\\\\\"NeurIPS 2024\\\\\\\"\\\\n        arxiv: \\\\\\\"2402.06457\\\\\\\"\\\\n        relevance: \\\\\\\"Iteratively trains verifier alongside generator; verification quality scales with data.\\\\\\\"\\\\n        status: should_cite\\\\n\\\\n  debate_multi_agent:\\\\n    description: \\\\\\\"Debate and multi-agent aggregation methods for LLM reasoning\\\\\\\"\\\\n    papers:\\\\n      - id: liang2023encouraging\\\\n        title: \\\\\\\"Encouraging Divergent Thinking in Large Language Models through Multi-Agent Debate\\\\\\\"\\\\n        authors: \\\\\\\"Liang et al.\\\\\\\"\\\\n        venue: \\\\\\\"arXiv 2023\\\\\\\"\\\\n        arxiv: \\\\\\\"2305.19118\\\\\\\"\\\\n        relevance: \\\\\\\"Multi-agent debate improves factuality and reasoning via iterative refinement. Alternative multi-path aggregation mechanism.\\\\\\\"\\\\n        status: must_cite\\\\n        verified: true\\\\n\\\\n      - id: du2023improving\\\\n        title: \\\\\\\"Improving Factuality and Reasoning in Language Models through Multiagent Debate\\\\\\\"\\\\n        authors: \\\\\\\"Du et al.\\\\\\\"\\\\n        venue: \\\\\\\"ICML 2024\\\\\\\"\\\\n        arxiv: \\\\\\\"2305.14325\\\\\\\"\\\\n        relevance: \\\\\\\"Multi-agent debate for reasoning; shows consensus-seeking improves accuracy. Contrast: debate uses natural language, SICA uses formal constraints.\\\\\\\"\\\\n        status: must_cite\\\\n        verified: true\\\\n\\\\n      - id: khan2024debating\\\\n        title: \\\\\\\"Debating with More Persuasive LLMs Leads to More Truthful Answers\\\\\\\"\\\\n        authors: \\\\\\\"Khan et al.\\\\\\\"\\\\n        venue: \\\\\\\"ICML 2024\\\\\\\"\\\\n        arxiv: \\\\\\\"2402.06782\\\\\\\"\\\\n        relevance: \\\\\\\"Debate quality depends on model capability; stronger debaters improve consensus.\\\\\\\"\\\\n        status: should_cite\\\\n\\\\n  benchmarks_and_datasets:\\\\n    description: \\\\\\\"Benchmark datasets used in our evaluation\\\\\\\"\\\\n    papers:\\\\n      - id: han2022folio\\\\n        title: \\\\\\\"FOLIO: Natural Language Reasoning with First-Order Logic\\\\\\\"\\\\n        authors: \\\\\\\"Han et al.\\\\\\\"\\\\n        venue: \\\\\\\"arXiv 2022\\\\\\\"\\\\n        arxiv: \\\\\\\"2209.00840\\\\\\\"\\\\n        relevance: \\\\\\\"FOLIO benchmark with expert-annotated FOL; our primary formal logic evaluation dataset (n=204).\\\\\\\"\\\\n        status: must_cite\\\\n        verified: true\\\\n\\\\n      - id: tafjord2021proofwriter\\\\n        title: \\\\\\\"ProofWriter: Generating Implications, Proofs, and Abductive Statements over Natural Language\\\\\\\"\\\\n        authors: \\\\\\\"Tafjord et al.\\\\\\\"\\\\n        venue: \\\\\\\"ACL Findings 2021\\\\\\\"\\\\n        arxiv: \\\\\\\"2012.13048\\\\\\\"\\\\n        relevance: \\\\\\\"ProofWriter dataset for deductive reasoning; our primary large-N evaluation (n=600).\\\\\\\"\\\\n        status: must_cite\\\\n        verified: true\\\\n\\\\n      - id: geva2021strategyqa\\\\n        title: \\\\\\\"Did Aristotle Use a Laptop? A Question Answering Benchmark with Implicit Reasoning Strategies\\\\\\\"\\\\n        authors: \\\\\\\"Geva et al.\\\\\\\"\\\\n        venue: \\\\\\\"TACL 2021\\\\\\\"\\\\n        arxiv: \\\\\\\"2101.02235\\\\\\\"\\\\n        relevance: \\\\\\\"StrategyQA benchmark for commonsense multi-hop reasoning (Yes/No); our cross-domain validation (n=200).\\\\\\\"\\\\n        status: must_cite\\\\n        verified: true\\\\n\\\\n      - id: liu2020logiqa\\\\n        title: \\\\\\\"LogiQA: A Challenge Dataset for Machine Reading Comprehension with Logical Reasoning\\\\\\\"\\\\n        authors: \\\\\\\"Liu et al.\\\\\\\"\\\\n        venue: \\\\\\\"IJCAI 2020\\\\\\\"\\\\n        arxiv: \\\\\\\"2007.08124\\\\\\\"\\\\n        relevance: \\\\\\\"LogiQA benchmark for logical reasoning in reading comprehension; our cross-domain validation for Type B (non-formalizable) analysis (n=200).\\\\\\\"\\\\n        status: must_cite\\\\n        verified: true\\\\n\\\\n      - id: clark2018arc\\\\n        title: \\\\\\\"Think you have Solved Question Answering? Try ARC, the AI2 Reasoning Challenge\\\\\\\"\\\\n        authors: \\\\\\\"Clark et al.\\\\\\\"\\\\n        venue: \\\\\\\"arXiv 2018\\\\\\\"\\\\n        arxiv: \\\\\\\"1803.05457\\\\\\\"\\\\n        relevance: \\\\\\\"ARC-Challenge science QA benchmark; our cross-domain validation for multiple-choice (n=60).\\\\\\\"\\\\n        status: must_cite\\\\n        verified: true\\\\n\\\\n  negative_results_analysis:\\\\n    description: \\\\\\\"Precedents for negative-result and analysis papers in NLP\\\\\\\"\\\\n    papers:\\\\n      - id: huang2024selfcorrect\\\\n        title: \\\\\\\"Large Language Models Cannot Self-Correct Reasoning Yet\\\\\\\"\\\\n        authors: \\\\\\\"Huang et al.\\\\\\\"\\\\n        venue: \\\\\\\"ICLR 2024\\\\\\\"\\\\n        arxiv: \\\\\\\"2310.01798\\\\\\\"\\\\n        relevance: \\\\\\\"Key precedent: shows LLM self-correction fails without external feedback. Structural parallel to our finding (self-extraction fails without external verification). Same 'self-X fails' narrative.\\\\\\\"\\\\n        status: must_cite\\\\n        verified: true\\\\n\\\\n      - id: mirzadeh2024gsmsymbolic\\\\n        title: \\\\\\\"GSM-Symbolic: Understanding the Limitations of Mathematical Reasoning in Large Language Models\\\\\\\"\\\\n        authors: \\\\\\\"Mirzadeh et al.\\\\\\\"\\\\n        venue: \\\\\\\"arXiv 2024\\\\\\\"\\\\n        arxiv: \\\\\\\"2410.05229\\\\\\\"\\\\n        relevance: \\\\\\\"Systematic negative result: apparent LLM reasoning gains are fragile under symbolic perturbation. Establishes precedent for rigorous negative-result methodology in LLM reasoning.\\\\\\\"\\\\n        status: should_cite\\\\n        verified: true\\\\n\\\\n  oracle_upper_bound_experiments:\\\\n    description: \\\\\\\"Papers using oracle/gold-data substitution to diagnose pipeline bottlenecks\\\\\\\"\\\\n    papers:\\\\n      - id: press2023compositionality\\\\n        title: \\\\\\\"Measuring and Narrowing the Compositionality Gap in Language Models\\\\\\\"\\\\n        authors: \\\\\\\"Press et al.\\\\\\\"\\\\n        venue: \\\\\\\"EMNLP Findings 2023\\\\\\\"\\\\n        arxiv: \\\\\\\"2210.03350\\\\\\\"\\\\n        relevance: \\\\\\\"Measures compositionality gap: fraction of cases where model answers sub-questions correctly (oracle decomposition) but fails at composition. Diagnoses compositional reasoning, not knowledge, as bottleneck. Direct methodological parallel to our oracle FOL experiment.\\\\\\\"\\\\n        status: should_cite\\\\n        verified: true\\\\n\\\\n      - id: trivedi2023ircot\\\\n        title: \\\\\\\"Interleaving Retrieval with Chain-of-Thought Reasoning for Knowledge-Intensive Multi-Step Questions\\\\\\\"\\\\n        authors: \\\\\\\"Trivedi et al.\\\\\\\"\\\\n        venue: \\\\\\\"ACL 2023\\\\\\\"\\\\n        arxiv: \\\\\\\"2212.10509\\\\\\\"\\\\n        relevance: \\\\\\\"Uses gold supporting paragraphs as oracle retrieval upper bound to diagnose that retrieval quality is the primary bottleneck in multi-step QA. Same diagnostic design as our oracle experiment: replace one pipeline component with gold data to isolate the bottleneck.\\\\\\\"\\\\n        status: should_cite\\\\n        verified: true\\\\n\\\\n      - id: saparov2023greedy\\\\n        title: \\\\\\\"Language Models Are Greedy Reasoners: A Systematic Formal Analysis of Chain-of-Thought\\\\\\\"\\\\n        authors: \\\\\\\"Saparov and He\\\\\\\"\\\\n        venue: \\\\\\\"ICLR 2023\\\\\\\"\\\\n        arxiv: \\\\\\\"2210.01240\\\\\\\"\\\\n        relevance: \\\\\\\"Uses synthetic data with gold FOL proofs to formally analyze where CoT reasoning fails. Isolates proof planning (not individual deduction) as bottleneck. Closest methodological parallel: uses formal logic ground truth to diagnose LLM reasoning limitations.\\\\\\\"\\\\n        status: should_cite\\\\n        verified: true\\\\n\\\\n  condorcet_voting_theory:\\\\n    description: \\\\\\\"Condorcet Jury Theorem, voting theory, and ensemble independence\\\\\\\"\\\\n    papers:\\\\n      - id: condorcet1785\\\\n        title: \\\\\\\"Essai sur l'application de l'analyse à la probabilité des décisions rendues à la pluralité des voix\\\\\\\"\\\\n        authors: \\\\\\\"Marquis de Condorcet\\\\\\\"\\\\n        venue: \\\\\\\"Paris: Imprimerie Royale, 1785\\\\\\\"\\\\n        relevance: \\\\\\\"The original Jury Theorem: majority voting among independent voters each with p>0.5 converges to correct answer as group size grows. Foundation for our theoretical framing of SC as majority voting over reasoning traces\\\\\\\"\\\\n        status: must_cite\\\\n        verified: true\\\\n\\\\n      - id: austensmith1996\\\\n        title: \\\\\\\"Information Aggregation, Rationality, and the Condorcet Jury Theorem\\\\\\\"\\\\n        authors: \\\\\\\"Austen-Smith, David and Banks, Jeffrey S.\\\\\\\"\\\\n        venue: \\\\\\\"American Political Science Review, 90(1), 34-45, 1996\\\\\\\"\\\\n        relevance: \\\\\\\"Key modern formalization of CJT; explicitly introduces the independence requirement and shows sincere voting is not always rational. Provides the formal basis for why trace independence matters in SC aggregation\\\\\\\"\\\\n        status: must_cite\\\\n        verified: true\\\\n\\\\n      - id: lefort2024condorcet_llm\\\\n        title: \\\\\\\"Examining Independence in Ensemble Sentiment Analysis: A Study on the Limits of Large Language Models Using the Condorcet Jury Theorem\\\\\\\"\\\\n        authors: \\\\\\\"Lefort, Baptiste and Benhamou, Eric and Ohana, Jean-Jacques and Guez, Beatrice and Saltiel, David and Jacquot, Thomas\\\\\\\"\\\\n        venue: \\\\\\\"arXiv 2024\\\\\\\"\\\\n        arxiv: \\\\\\\"2409.00094\\\\\\\"\\\\n        relevance: \\\\\\\"CLOSEST PRIOR WORK applying CJT to LLM aggregation. Tests cross-model ensembles via majority voting for sentiment analysis; finds marginal gains due to lack of independence among advanced LLMs. Key difference from SICA: they study cross-model ensembles, we study within-model trace independence and propose Fleiss kappa + Effective-K to quantify it\\\\\\\"\\\\n        status: must_cite\\\\n        verified: true\\\\n\\\\n      - id: ladha1992correlated\\\\n        title: \\\\\\\"The Condorcet Jury Theorem, Free Speech, and Correlated Votes\\\\\\\"\\\\n        authors: \\\\\\\"Ladha, Krishna K.\\\\\\\"\\\\n        venue: \\\\\\\"American Journal of Political Science, 36(3), 617-634, 1992\\\\\\\"\\\\n        relevance: \\\\\\\"Generalizes CJT to correlated voters; shows majority-rule effectiveness decreases as vote correlation increases. Directly supports our Effective-K concept: correlated traces reduce the effective number of independent voters below nominal K\\\\\\\"\\\\n        status: should_cite\\\\n        verified: true\\\\n\\\\n      - id: fleiss1971kappa\\\\n        title: \\\\\\\"Measuring Nominal Scale Agreement among Many Raters\\\\\\\"\\\\n        authors: \\\\\\\"Fleiss, Joseph L.\\\\\\\"\\\\n        venue: \\\\\\\"Psychological Bulletin, 76(5), 378-382, 1971\\\\\\\"\\\\n        relevance: \\\\\\\"Defines Fleiss kappa for multi-rater agreement on nominal categories. Our framework uses Fleiss kappa to quantify inter-trace agreement as a proxy for trace independence in SC sampling\\\\\\\"\\\\n        status: should_cite\\\\n        verified: true\\\\n\\\\ngaps:\\\\n  resolved:\\\\n    - dimension: \\\\\\\"verification_reranking\\\\\\\"\\\\n      gap: \\\\\\\"Added ORM, PRM, Math-Shepherd, V-STaR (2026-05-17)\\\\\\\"\\\\n    - dimension: \\\\\\\"debate_multi_agent\\\\\\\"\\\\n      gap: \\\\\\\"Added Liang 2023, Du 2023, Khan 2024 (2026-05-17)\\\\\\\"\\\\n    - dimension: \\\\\\\"benchmarks_and_datasets\\\\\\\"\\\\n      gap: \\\\\\\"Added FOLIO, ProofWriter, StrategyQA, ARC (2026-05-17)\\\\\\\"\\\\n    - dimension: \\\\\\\"negative_results_analysis\\\\\\\"\\\\n      gap: \\\\\\\"Added Huang 2024 (self-correct), Mirzadeh 2024 (GSM-Symbolic) (2026-05-17)\\\\\\\"\\\\n    - dimension: \\\\\\\"symbolic_reasoning_llm\\\\\\\"\\\\n      gap: \\\\\\\"Added LINC (Olausson et al. 2023) (2026-05-17)\\\\\\\"\\\\n    - dimension: \\\\\\\"self_consistency_and_variants\\\\\\\"\\\\n      gap: \\\\\\\"Added DiVeRSe (Li et al. 2023) (2026-05-17)\\\\\\\"\\\\n    - dimension: \\\\\\\"oracle_upper_bound_experiments\\\\\\\"\\\\n      gap: \\\\\\\"Added Press 2023 (compositionality gap), Trivedi 2023 (IRCoT oracle retrieval), Saparov & He 2023 (greedy reasoners) (2026-05-17)\\\\\\\"\\\\n    - dimension: \\\\\\\"condorcet_voting_theory\\\\\\\"\\\\n      gap: \\\\\\\"Added Condorcet 1785, Austen-Smith & Banks 1996, Lefort et al. 2024 (arXiv:2409.00094), Ladha 1992, Fleiss 1971 (2026-05-19)\\\\\\\"\\\\n  remaining: []\\\\n\\\", \\\"total_chars\\\": 23779, \\\"truncated\\\": false}, \\\"error\\\": null, \\\"metadata\\\": {}}\"}"}]},"parent_tool_use_id":"toolu_016Hb6xFUswTjtRS1U7uZuVP","session_id":"ff4131df-0538-40e9-a5d8-d0234a1df865","uuid":"79b5f096-35bc-4eb8-8753-08d90c5bb15c","timestamp":"2026-05-19T04:49:26.772Z"}
