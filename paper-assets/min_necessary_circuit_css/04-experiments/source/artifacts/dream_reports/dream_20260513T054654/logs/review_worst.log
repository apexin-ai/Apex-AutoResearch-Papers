{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Smu7rPdSWTBTtYGZBfUhtA","type":"tool_result","content":"1\t{\n2\t  \"methods\": [\n3\t    \"acdc\",\n4\t    \"eap_ig\",\n5\t    \"edge_pruning\"\n6\t  ],\n7\t  \"K\": 3,\n8\t  \"per_method_edges\": {\n9\t    \"acdc\": 254,\n10\t    \"eap_ig\": 200,\n11\t    \"edge_pruning\": 252\n12\t  },\n13\t  \"total_union\": 437,\n14\t  \"pairwise_jaccard\": {\n15\t    \"acdc vs eap_ig\": 0.27887323943661974,\n16\t    \"acdc vs edge_pruning\": 0.30749354005167956,\n17\t    \"eap_ig vs edge_pruning\": 0.2840909090909091\n18\t  },\n19\t  \"pairwise_overlap_coefficient\": {\n20\t    \"acdc vs eap_ig\": 0.495,\n21\t    \"acdc vs edge_pruning\": 0.4722222222222222,\n22\t    \"eap_ig vs edge_pruning\": 0.5\n23\t  },\n24\t  \"css_cross_tabulation\": {\n25\t    \"agree_all_in\": 49,\n26\t    \"agree_all_out_of_union\": 0,\n27\t    \"off_diagonal\": 388,\n28\t    \"total_union\": 437,\n29\t    \"off_diagonal_pct\": 0.8878718535469108,\n30\t    \"methods\": [\n31\t      \"acdc\",\n32\t      \"eap_ig\",\n33\t      \"edge_pruning\"\n34\t    ]\n35\t  },\n36\t  \"css_cell_counts\": {\n37\t    \"(0, 1, 0)\": 50,\n38\t    \"(1, 1, 0)\": 50,\n39\t    \"(1, 0, 1)\": 70,\n40\t    \"(1, 1, 1)\": 49,\n41\t    \"(0, 0, 1)\": 82,\n42\t    \"(1, 0, 0)\": 85,\n43\t    \"(0, 1, 1)\": 51\n44\t  },\n45\t  \"off_diagonal_pct\": 0.8878718535469108,\n46\t  \"circus_tiers\": {\n47\t    \"contingent\": 227,\n48\t    \"noise\": 227,\n49\t    \"core\": 46\n50\t  },\n51\t  \"circus_cross_table\": {\n52\t    \"stable_core\": 10,\n53\t    \"method_specific\": 36,\n54\t    \"cross_unstable\": 39,\n55\t    \"noise\": 415,\n56\t    \"core_total\": 46,\n57\t    \"off_diagonal_pct\": 0.782608695652174\n58\t  },\n59\t  \"acdc_sensitivity\": [\n60\t    {\n61\t      \"tau\": 0.01,\n62\t      \"acdc_size\": 254,\n63\t      \"off_diagonal\": 388,\n64\t      \"off_diagonal_pct\": 0.8878718535469108,\n65\t      \"total_union\": 437\n66\t    },\n67\t    {\n68\t      \"tau\": 0.03,\n69\t      \"acdc_size\": 210,\n70\t      \"off_diagonal\": 382,\n71\t      \"off_diagonal_pct\": 0.9009433962264151,\n72\t      \"total_union\": 424\n73\t    },\n74\t    {\n75\t      \"tau\": 0.05,\n76\t      \"acdc_size\": 145,\n77\t      \"off_diagonal\": 377,\n78\t      \"off_diagonal_pct\": 0.9354838709677419,\n79\t      \"total_union\": 403\n80\t    },\n81\t    {\n82\t      \"tau\": 0.1,\n83\t      \"acdc_size\": 97,\n84\t      \"off_diagonal\": 367,\n85\t      \"off_diagonal_pct\": 0.9532467532467532,\n86\t      \"total_union\": 385\n87\t    },\n88\t    {\n89\t      \"tau\": 0.3,\n90\t      \"acdc_size\": 97,\n91\t      \"off_diagonal\": 367,\n92\t      \"off_diagonal_pct\": 0.9532467532467532,\n93\t      \"total_union\": 385\n94\t    }\n95\t  ],\n96\t  \"gate\": {\n97\t    \"verdict\": \"PASS_MAIN\",\n98\t    \"action\": \"Off-diagonal 78.3% >= 10% \\u2192 Main track\"\n99\t  }\n100\t}"}]},"parent_tool_use_id":"toolu_011DsfFpvo1Urbe6HV8guPNd","session_id":"36c8d43b-79cf-4a56-8499-4a4c6523d7de","uuid":"eb303406-8e9f-448e-afc7-a7229602e7a7","timestamp":"2026-05-13T06:35:41.026Z"}
