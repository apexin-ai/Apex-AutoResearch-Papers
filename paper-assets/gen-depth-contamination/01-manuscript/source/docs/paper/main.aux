\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Cross-model transfer heatmap (three continuation-mode models plus Qwen-rewrite). \textbf  {(a)} 6-class ordinal accuracy when trained on the row model and evaluated on the column model; diagonal entries (highlighted) are in-domain baselines. \textbf  {(b)} Retention rate (off-diagonal accuracy divided by in-domain accuracy). Continuation-mode pairs retain 80--92\%; Qwen-rw transfers at 61--63\% to other architectures but 82\% to Qwen-cont, consistent with a mode-specific artifact.}}{6}{figure.caption.11}\protected@file@percent }
\newlabel{fig:transfer_heatmap}{{4}{6}{Cross-model transfer heatmap (three continuation-mode models plus Qwen-rewrite). \textbf {(a)} 6-class ordinal accuracy when trained on the row model and evaluated on the column model; diagonal entries (highlighted) are in-domain baselines. \textbf {(b)} Retention rate (off-diagonal accuracy divided by in-domain accuracy). Continuation-mode pairs retain 80--92\%; Qwen-rw transfers at 61--63\% to other architectures but 82\% to Qwen-cont, consistent with a mode-specific artifact}{figure.caption.11}{}}
