{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DHD9YTq299sKhmwnrruuCQ","type":"tool_result","content":"1244\tdef submit_dream_review_report(\n1245\t    report: str,\n1246\t    project: str,\n1247\t    tier: str,\n1248\t    dream_id: str,\n1249\t    overall_score: str = \"\",\n1250\t    review_chat_id: str = \"\",\n1251\t    review_visible: bool = True,\n1252\t) -> ToolResult:\n1253\t    \"\"\"Persist a Dream-mode review report and signal completion.\n1254\t\n1255\t    Used by the Dream Review Director in place of\n1256\t    ``submit_review_report_to_research_director``. Differences from the real\n1257\t    submission tool (DREAM_AGENT_DESIGN.md §6.4):\n1258\t\n1259\t    * Writes only to ``dream_reports/{dream_id}/{tier}/review_report.md`` —\n1260\t      no ``review_reports/round_N.md``, no ``review_issues.yaml``.\n1261\t    * Does NOT send the report to Research Director. The Dream Tool\n1262\t      orchestrator reads the file once the subprocess exits.\n1263\t    * Skips the roster / cross-sharing guards — those are Research-side\n1264\t      protocol that Dream's simplified pipeline doesn't enforce.\n1265\t    * ``review_visible=False`` suppresses the Group C visibility card.\n1266\t\n1267\t    Args:\n1268\t        report: Full review report text (consolidated from all reviewers).\n1269\t        project: Project name.\n1270\t        tier: Which Dream tier this report covers (best/median/worst).\n1271\t        dream_id: Dream invocation id (must include the ``dream_`` prefix\n1272\t            stripped — caller passes the raw id, not the ``dream_xxx``\n1273\t            segment).\n1274\t        overall_score: Optional headline assessment (\"strong reject\", etc.).\n1275\t        review_chat_id: Group C chat_id (loaded from project config if empty).\n1276\t        review_visible: When False, skip Group C post.\n1277\t    \"\"\"\n1278\t    if not project:\n1279\t        return ToolResult(success=False, data={}, error=\"project is required\")\n1280\t    if not dream_id:\n1281\t        return ToolResult(success=False, data={}, error=\"dream_id is required\")\n1282\t    if tier not in {\"best\", \"median\", \"worst\"}:\n1283\t        return ToolResult(\n1284\t            success=False, data={},\n1285\t            error=f\"tier must be one of best/median/worst, got {tier!r}\",\n1286\t        )\n1287\t    if not report or not report.strip():\n1288\t        return ToolResult(success=False, data={}, error=\"report must be non-empty\")\n1289\t\n1290\t    from core import paths as _paths_mod\n1291\t\n1292\t    # Normalize: callers occasionally pass the full session segment.\n1293\t    dream_id = dream_id.removeprefix(\"dream_\")\n1294\t    canonical_id = f\"dream_{dream_id}\"\n1295\t\n1296\t    output_dir = _paths_mod.dream_report_dir(project, canonical_id) / tier\n1297\t    output_dir.mkdir(parents=True, exist_ok=True)\n1298\t    report_path = output_dir / \"review_report.md\"\n1299\t\n1300\t    import datetime as _dt\n1301\t    header = (\n1302\t        f\"---\\n\"\n1303\t        f\"dream_id: {canonical_id}\\n\"\n1304\t        f\"tier: {tier}\\n\"\n1305\t        f\"overall_score: {overall_score}\\n\"\n1306\t        f\"timestamp: {_dt.datetime.now(_dt.timezone.utc).isoformat()}\\n\"\n1307\t        f\"---\\n\\n\"\n1308\t    )\n1309\t    try:\n1310\t        report_path.write_text(header + report, encoding=\"utf-8\")\n1311\t        logger.info(\n1312\t            \"[submit_dream_review_report] wrote %s (%d bytes)\",\n1313\t            report_path, report_path.stat().st_size,\n1314\t        )\n1315\t    except Exception as exc:\n1316\t        logger.exception(\n1317\t            \"[submit_dream_review_report] failed to write %s\", report_path,\n1318\t        )\n1319\t        return ToolResult(success=False, data={}, error=str(exc))\n1320\t\n1321\t    # Optional Group C visibility — mirrors the real submission tool but\n1322\t    # without the Research Director routing step.\n1323\t    if review_visible:"}]},"parent_tool_use_id":null,"session_id":"23a92ae3-d412-49aa-a360-fb90b813cfb5","uuid":"9bee040d-22b0-4e90-bb63-0910f2b9fcb5","timestamp":"2026-05-12T20:43:23.523Z","tool_use_result":{"type":"text","file":{"filePath":"/home/ubuntu/agent-ml-research/core/tools/feishu_group.py","content":"def submit_dream_review_report(\n    report: str,\n    project: str,\n    tier: str,\n    dream_id: str,\n    overall_score: str = \"\",\n    review_chat_id: str = \"\",\n    review_visible: bool = True,\n) -> ToolResult:\n    \"\"\"Persist a Dream-mode review report and signal completion.\n\n    Used by the Dream Review Director in place of\n    ``submit_review_report_to_research_director``. Differences from the real\n    submission tool (DREAM_AGENT_DESIGN.md §6.4):\n\n    * Writes only to ``dream_reports/{dream_id}/{tier}/review_report.md`` —\n      no ``review_reports/round_N.md``, no ``review_issues.yaml``.\n    * Does NOT send the report to Research Director. The Dream Tool\n      orchestrator reads the file once the subprocess exits.\n    * Skips the roster / cross-sharing guards — those are Research-side\n      protocol that Dream's simplified pipeline doesn't enforce.\n    * ``review_visible=False`` suppresses the Group C visibility card.\n\n    Args:\n        report: Full review report text (consolidated from all reviewers).\n        project: Project name.\n        tier: Which Dream tier this report covers (best/median/worst).\n        dream_id: Dream invocation id (must include the ``dream_`` prefix\n            stripped — caller passes the raw id, not the ``dream_xxx``\n            segment).\n        overall_score: Optional headline assessment (\"strong reject\", etc.).\n        review_chat_id: Group C chat_id (loaded from project config if empty).\n        review_visible: When False, skip Group C post.\n    \"\"\"\n    if not project:\n        return ToolResult(success=False, data={}, error=\"project is required\")\n    if not dream_id:\n        return ToolResult(success=False, data={}, error=\"dream_id is required\")\n    if tier not in {\"best\", \"median\", \"worst\"}:\n        return ToolResult(\n            success=False, data={},\n            error=f\"tier must be one of best/median/worst, got {tier!r}\",\n        )\n    if not report or not report.strip():\n        return ToolResult(success=False, data={}, error=\"report must be non-empty\")\n\n    from core import paths as _paths_mod\n\n    # Normalize: callers occasionally pass the full session segment.\n    dream_id = dream_id.removeprefix(\"dream_\")\n    canonical_id = f\"dream_{dream_id}\"\n\n    output_dir = _paths_mod.dream_report_dir(project, canonical_id) / tier\n    output_dir.mkdir(parents=True, exist_ok=True)\n    report_path = output_dir / \"review_report.md\"\n\n    import datetime as _dt\n    header = (\n        f\"---\\n\"\n        f\"dream_id: {canonical_id}\\n\"\n        f\"tier: {tier}\\n\"\n        f\"overall_score: {overall_score}\\n\"\n        f\"timestamp: {_dt.datetime.now(_dt.timezone.utc).isoformat()}\\n\"\n        f\"---\\n\\n\"\n    )\n    try:\n        report_path.write_text(header + report, encoding=\"utf-8\")\n        logger.info(\n            \"[submit_dream_review_report] wrote %s (%d bytes)\",\n            report_path, report_path.stat().st_size,\n        )\n    except Exception as exc:\n        logger.exception(\n            \"[submit_dream_review_report] failed to write %s\", report_path,\n        )\n        return ToolResult(success=False, data={}, error=str(exc))\n\n    # Optional Group C visibility — mirrors the real submission tool but\n    # without the Research Director routing step.\n    if review_visible:","numLines":80,"startLine":1244,"totalLines":2413}}}
