{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015cgwzQ3TZMmeoCcyKMqhFK","type":"tool_result","content":"4913\tdef submit_dream_review_report(\n4914\t    report: str,\n4915\t    project: str,\n4916\t    tier: str,\n4917\t    dream_id: str,\n4918\t    overall_score: str = \"\",\n4919\t    review_chat_id: str = \"\",\n4920\t    review_visible: bool = True,\n4921\t) -> str:\n4922\t    \"\"\"Deliver a Dream-mode review report (Dream Review Director only).\n4923\t\n4924\t    Persists the review to ``dream_reports/{dream_id}/{tier}/review_report.md``\n4925\t    and (optionally) posts a Group C visibility card. The Dream Tool reads\n4926\t    the file once your subprocess exits — there is NO Research Director\n4927\t    delivery, NO ``review_reports/round_N.md``, NO ``review_issues.yaml``,\n4928\t    and NO 5-step protocol attached.\n4929\t\n4930\t    Use this in place of ``submit_review_report_to_research_director`` for\n4931\t    Dream-mode roundtable Step 4. See DREAM_AGENT_DESIGN.md §6.4.\n4932\t\n4933\t    Args:\n4934\t        report: Consolidated review report text (covers all Dream reviewers).\n4935\t        project: Current project name.\n4936\t        tier: Which Dream tier this report covers — ``best`` / ``median``\n4937\t            / ``worst``.\n4938\t        dream_id: Dream invocation id (with or without the ``dream_`` prefix —\n4939\t            both accepted).\n4940\t        overall_score: Optional headline assessment (\"strong reject\",\n4941\t            \"borderline accept\", etc.).\n4942\t        review_chat_id: Group C chat_id (loaded from project config when empty).\n4943\t        review_visible: When True (default) posts a visibility card to Group C\n4944\t            with a ``[Dream]`` prefix. Set False for silent submission.\n4945\t    \"\"\"\n4946\t    result = feishu_group_mod.submit_dream_review_report(\n4947\t        report=report,\n4948\t        project=project,\n4949\t        tier=tier,\n4950\t        dream_id=dream_id,\n4951\t        overall_score=overall_score,\n4952\t        review_chat_id=review_chat_id,\n4953\t        review_visible=review_visible,\n4954\t    )\n4955\t    return _tool_result_to_str(result)\n4956\t\n4957\t\n4958\t@mcp.tool()\n4959\tdef request_external_review(\n4960\t    project: str,\n4961\t    paper_pdf_path: str,\n4962\t    venue: str = \"\",\n4963\t    note: str = \"\",\n4964\t    chat_id: str = \"\",\n4965\t    reminder_hours: int = 8,\n4966\t) -> str:\n4967\t    \"\"\"Request human-assisted external review via Stanford Agentic Reviewer (paperreview.ai).\n4968\t\n4969\t    Sends an interactive card to the user group (Group A) with instructions\n4970\t    to manually submit the paper PDF on paperreview.ai.  A reminder is\n4971\t    automatically scheduled after ``reminder_hours`` to follow up.\n4972\t"}]},"parent_tool_use_id":null,"session_id":"23a92ae3-d412-49aa-a360-fb90b813cfb5","uuid":"aabcf254-4801-4107-a398-cb295dfd7e3f","timestamp":"2026-05-12T20:43:02.424Z","tool_use_result":{"type":"text","file":{"filePath":"/home/ubuntu/agent-ml-research/core/mcp_server.py","content":"def submit_dream_review_report(\n    report: str,\n    project: str,\n    tier: str,\n    dream_id: str,\n    overall_score: str = \"\",\n    review_chat_id: str = \"\",\n    review_visible: bool = True,\n) -> str:\n    \"\"\"Deliver a Dream-mode review report (Dream Review Director only).\n\n    Persists the review to ``dream_reports/{dream_id}/{tier}/review_report.md``\n    and (optionally) posts a Group C visibility card. The Dream Tool reads\n    the file once your subprocess exits — there is NO Research Director\n    delivery, NO ``review_reports/round_N.md``, NO ``review_issues.yaml``,\n    and NO 5-step protocol attached.\n\n    Use this in place of ``submit_review_report_to_research_director`` for\n    Dream-mode roundtable Step 4. See DREAM_AGENT_DESIGN.md §6.4.\n\n    Args:\n        report: Consolidated review report text (covers all Dream reviewers).\n        project: Current project name.\n        tier: Which Dream tier this report covers — ``best`` / ``median``\n            / ``worst``.\n        dream_id: Dream invocation id (with or without the ``dream_`` prefix —\n            both accepted).\n        overall_score: Optional headline assessment (\"strong reject\",\n            \"borderline accept\", etc.).\n        review_chat_id: Group C chat_id (loaded from project config when empty).\n        review_visible: When True (default) posts a visibility card to Group C\n            with a ``[Dream]`` prefix. Set False for silent submission.\n    \"\"\"\n    result = feishu_group_mod.submit_dream_review_report(\n        report=report,\n        project=project,\n        tier=tier,\n        dream_id=dream_id,\n        overall_score=overall_score,\n        review_chat_id=review_chat_id,\n        review_visible=review_visible,\n    )\n    return _tool_result_to_str(result)\n\n\n@mcp.tool()\ndef request_external_review(\n    project: str,\n    paper_pdf_path: str,\n    venue: str = \"\",\n    note: str = \"\",\n    chat_id: str = \"\",\n    reminder_hours: int = 8,\n) -> str:\n    \"\"\"Request human-assisted external review via Stanford Agentic Reviewer (paperreview.ai).\n\n    Sends an interactive card to the user group (Group A) with instructions\n    to manually submit the paper PDF on paperreview.ai.  A reminder is\n    automatically scheduled after ``reminder_hours`` to follow up.\n","numLines":60,"startLine":4913,"totalLines":5855}}}
