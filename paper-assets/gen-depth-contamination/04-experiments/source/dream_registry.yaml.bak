  dream_20260518T122223:
    dream_id: dream_20260518T122223
    project: gen-depth-contamination
    status: failed
    review_mode: simple
    review_visible: true
    writing_visible: true
    venue: ''
    focus: 包含 exp_026 arXiv graduated filtering 的负向结果，诚实报告。Section 5 增加 arXiv null
      result，Discussion 增加 K* ≠ data utility 洞察。评估加入这个 honest negative 是否提升论文可信度和审稿得分。
    what_if:
    - name: exp_026_arxiv_filtering_integrated
      claim: C3
      description: 'arXiv graduated filtering negative result integrated into paper:
        graduated ≈ no_filter on arXiv K*=3 (paired t-test p>0.24), binary has metric-specific
        trade-off (MMLU -0.23pp p=0.005, HellaSwag +0.41pp p<0.00001). Section 5 adds
        arXiv null result table. Discussion adds key insight: K* characterizes signal
        discriminability not data utility — depth 2-3 text is statistically distinguishable
        but not necessarily beneficial for training. Appendix includes full 15-run
        table with paired t-tests.'
      estimated_gpu_hours: 0.0
