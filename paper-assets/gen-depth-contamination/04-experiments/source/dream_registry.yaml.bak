  dream_20260519T090934:
    dream_id: dream_20260519T090934
    project: gen-depth-contamination
    status: reviewing
    review_mode: full
    review_visible: true
    writing_visible: true
    venue: ''
    focus: 'Code domain cross-model results now include LLaMA-8B K*=2 (cross-family
      confirmed) + cross-scorer validation K*=2 (D079). Mistral-7B and Qwen-7B Code
      still RUNNING. Domain hierarchy: Wiki=1, C4=Code=2, arXiv=3. Retrain K*=7 (two
      families). Focus on: (1) whether 4-domain + 6-architecture-family coverage is
      sufficient for EMNLP accept; (2) C3 filtering weakness (negative results on
      arXiv/Pythia); (3) Excitement score — is domain ceiling framework + one-wash
      laundering concept enough to push from 3.5 to 4.0?'
    what_if: []
    pid: 974168
