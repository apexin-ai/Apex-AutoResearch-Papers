\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Top-3 features by single-feature $\text  {AUC}$ ranking. Bold: shared across all continuation-mode models. Spearman $\rho $ (continuation pairs): Pythia--OLMo 0.95, Pythia--Qwen-cont 0.91, OLMo--Qwen-cont 0.85.}}{10}{table.caption.26}\protected@file@percent }
\newlabel{tab:top_features}{{6}{10}{Top-3 features by single-feature $\auc $ ranking. Bold: shared across all continuation-mode models. Spearman $\rho $ (continuation pairs): Pythia--OLMo 0.95, Pythia--Qwen-cont 0.91, OLMo--Qwen-cont 0.85}{table.caption.26}{}}
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces Cross-model transfer accuracy matrix. Each cell reports the six-class depth classification accuracy of a detector trained on one model's outputs (row) and evaluated on another model's outputs (column). Diagonal entries (\textbf  {bold}) indicate within-model performance. Transfer retention is computed as the ratio of off-diagonal accuracy to the geometric mean of the two corresponding diagonal entries.}}{11}{table.caption.27}\protected@file@percent }
\newlabel{tab:s1_transfer}{{7}{11}{Cross-model transfer accuracy matrix. Each cell reports the six-class depth classification accuracy of a detector trained on one model's outputs (row) and evaluated on another model's outputs (column). Diagonal entries (\textbf {bold}) indicate within-model performance. Transfer retention is computed as the ratio of off-diagonal accuracy to the geometric mean of the two corresponding diagonal entries}{table.caption.27}{}}
\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces Pairwise AUC with bootstrap 95\% CIs across depth pairs for four decoding configurations (all using Qwen2.5-1.5B-Instruct in rewrite mode; 10{,}000 bootstrap resamples). The horizontal rule between depth pairs 1\,vs.\,2 and 2\,vs.\,3 marks the empirical detectability boundary ${K^*_{\text  {empirical}}}=2$. Bottom rows report cross-configuration Spearman $\rho $ on per-feature discriminative-power rankings.}}{11}{table.caption.28}\protected@file@percent }
\newlabel{tab:s2_decoding}{{8}{11}{Pairwise AUC with bootstrap 95\% CIs across depth pairs for four decoding configurations (all using Qwen2.5-1.5B-Instruct in rewrite mode; 10{,}000 bootstrap resamples). The horizontal rule between depth pairs 1\,vs.\,2 and 2\,vs.\,3 marks the empirical detectability boundary $\Kempirical =2$. Bottom rows report cross-configuration Spearman $\rho $ on per-feature discriminative-power rankings}{table.caption.28}{}}
\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces Extended pairwise $\text  {AUC}$ with bootstrap 95\% CIs for all model configurations including new additions. This table extends Table~\ref {tab:kstar_ci} in the main text with Qwen-base, LLaMA-8B, Mistral-7B, Pythia-6.9B (nucleus), and Gemma-2-2B configurations. ${K^*_{\text  {empirical}}}= 2$ holds for 6/10 conditions at $\theta {=}0.60$ (OLMo-1B, Mistral-7B, Pythia-6.9B, Gemma-2-2B: ${K^*_{\text  {empirical}}}{=}1$).}}{11}{table.caption.29}\protected@file@percent }
\newlabel{tab:kstar_ci_extended}{{9}{11}{Extended pairwise $\auc $ with bootstrap 95\% CIs for all model configurations including new additions. This table extends Table~\ref {tab:kstar_ci} in the main text with Qwen-base, LLaMA-8B, Mistral-7B, Pythia-6.9B (nucleus), and Gemma-2-2B configurations. $\Kempirical = 2$ holds for 6/10 conditions at $\theta {=}0.60$ (OLMo-1B, Mistral-7B, Pythia-6.9B, Gemma-2-2B: $\Kempirical {=}1$)}{table.caption.29}{}}
\@writefile{lot}{\contentsline {table}{\numberline {10}{\ignorespaces LLM zero-shot depth classification: $5{\times }5$ confusion matrices (Exp-011). Both frontier LLMs achieve high binary detection accuracy (GPT-5.5: 0.8780; Claude Opus~4.6: 0.8818) but near-chance 5-class accuracy (${\sim }0.33$ vs.\ OBD-LightGBM baseline 0.386, evaluated on the full test set $N{=}5{,}000$). GPT-5.5 strongly identifies depth-0 text (recall${=}0.7700$) but collapses on depth-4 (recall${=}0.0800$), misclassifying 50/100 depth-4 samples as depth-2. Claude Opus~4.6 shows more uniform errors across depths 1--4, with depth-4 recall (0.3700) substantially exceeding GPT-5.5. Per-depth recall comparison with OBD-LightGBM in Table~\ref {tab:s3c_perdepth}.}}{12}{table.caption.30}\protected@file@percent }
\newlabel{tab:s3_llm_zeroshot}{{10}{12}{LLM zero-shot depth classification: $5{\times }5$ confusion matrices (Exp-011). Both frontier LLMs achieve high binary detection accuracy (GPT-5.5: 0.8780; Claude Opus~4.6: 0.8818) but near-chance 5-class accuracy (${\sim }0.33$ vs.\ OBD-LightGBM baseline 0.386, evaluated on the full test set $N{=}5{,}000$). GPT-5.5 strongly identifies depth-0 text (recall${=}0.7700$) but collapses on depth-4 (recall${=}0.0800$), misclassifying 50/100 depth-4 samples as depth-2. Claude Opus~4.6 shows more uniform errors across depths 1--4, with depth-4 recall (0.3700) substantially exceeding GPT-5.5. Per-depth recall comparison with OBD-LightGBM in Table~\ref {tab:s3c_perdepth}}{table.caption.30}{}}
\newlabel{tab:s3a_gpt55}{{10a}{12}{GPT-5.5 ($N{=}500$, acc${=}0.332$, MAE${=}1.102$)}{table.caption.30}{}}
\newlabel{sub@tab:s3a_gpt55}{{a}{12}{GPT-5.5 ($N{=}500$, acc${=}0.332$, MAE${=}1.102$)}{table.caption.30}{}}
\newlabel{tab:s3b_claude}{{10b}{12}{Claude Opus~4.6 ($N{=}499$, acc${=}0.331$, MAE${=}1.150$)}{table.caption.30}{}}
\newlabel{sub@tab:s3b_claude}{{b}{12}{Claude Opus~4.6 ($N{=}499$, acc${=}0.331$, MAE${=}1.150$)}{table.caption.30}{}}
\@writefile{lot}{\contentsline {table}{\numberline {11}{\ignorespaces Per-depth recall (\%) on balanced $N{=}500$ test set. OBD's nominal overall accuracy gap originates from depth-0; all methods fail at depths $\geq 2$, consistent with ${K^*_{\text  {empirical}}}= 2$.}}{13}{table.caption.31}\protected@file@percent }
\newlabel{tab:s3c_perdepth}{{11}{13}{Per-depth recall (\%) on balanced $N{=}500$ test set. OBD's nominal overall accuracy gap originates from depth-0; all methods fail at depths $\geq 2$, consistent with $\Kempirical = 2$}{table.caption.31}{}}
\@LN@col{2}
\@writefile{lot}{\contentsline {table}{\numberline {12}{\ignorespaces Mean subword token count per depth and EOS truncation rate (\%) for depth~1+ across all model configurations (generation limit: 256 tokens). Depth~0 (human text) is shared across configurations. Depths 1--5 show no systematic length trend within any model; the 0v1 length asymmetry (human texts shorter) makes detection \emph  {more conservative}, not inflated. See Section~\ref {sec:length_confound} for discussion.}}{14}{table.caption.32}\protected@file@percent }
\newlabel{tab:token_length}{{12}{14}{Mean subword token count per depth and EOS truncation rate (\%) for depth~1+ across all model configurations (generation limit: 256 tokens). Depth~0 (human text) is shared across configurations. Depths 1--5 show no systematic length trend within any model; the 0v1 length asymmetry (human texts shorter) makes detection \emph {more conservative}, not inflated. See Section~\ref {sec:length_confound} for discussion}{table.caption.32}{}}
\@LN@col{1}
\@LN{731}{14}
\@writefile{toc}{\contentsline {section}{\numberline {C}Supplementary Details}{15}{appendix.C}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {13}{\ignorespaces Dataset statistics for the generational depth corpus. Depth~0 contains human-written seed texts sampled from the C4 English validation split and truncated to 256 subword tokens. Depths~1--5 are recursively generated by Qwen2.5-1.5B-Instruct (nucleus sampling, $p{=}0.95$, $T{=}1.0$). Token counts use whitespace tokenization. Statistics shown for the primary Qwen-rewrite corpus; the other three model-mode configurations (Pythia-cont, OLMo-cont, Qwen-cont) share the same generation pipeline and corpus structure.}}{15}{table.caption.33}\protected@file@percent }
\newlabel{tab:s4_dataset_stats}{{13}{15}{Dataset statistics for the generational depth corpus. Depth~0 contains human-written seed texts sampled from the C4 English validation split and truncated to 256 subword tokens. Depths~1--5 are recursively generated by Qwen2.5-1.5B-Instruct (nucleus sampling, $p{=}0.95$, $T{=}1.0$). Token counts use whitespace tokenization. Statistics shown for the primary Qwen-rewrite corpus; the other three model-mode configurations (Pythia-cont, OLMo-cont, Qwen-cont) share the same generation pipeline and corpus structure}{table.caption.33}{}}
\@writefile{lot}{\contentsline {table}{\numberline {14}{\ignorespaces Complete description of the 15-dimensional feature set used by the OBD classifier. Features are grouped into three families: surprisal statistics (9~dims) computed from Qwen2.5-1.5B token-level log-probabilities, lexical diversity (3~dims), and frequency tail shape (3~dims). All features are computed per document.}}{16}{table.caption.34}\protected@file@percent }
\newlabel{tab:s5_features}{{14}{16}{Complete description of the 15-dimensional feature set used by the OBD classifier. Features are grouped into three families: surprisal statistics (9~dims) computed from Qwen2.5-1.5B token-level log-probabilities, lexical diversity (3~dims), and frequency tail shape (3~dims). All features are computed per document}{table.caption.34}{}}
\@writefile{lot}{\contentsline {table}{\numberline {15}{\ignorespaces LightGBM hyperparameters for the pairwise OBD (Ordinal Binary Decomposition) classifier used throughout the paper. One binary classifier is trained per adjacent depth pair $(k, k{+}1)$; 5-fold GroupKFold cross-validation is grouped by \texttt  {doc\_id} to prevent data leakage from the same seed document appearing in both train and test.}}{16}{table.caption.35}\protected@file@percent }
\newlabel{tab:s6_lgbm_params}{{15}{16}{LightGBM hyperparameters for the pairwise OBD (Ordinal Binary Decomposition) classifier used throughout the paper. One binary classifier is trained per adjacent depth pair $(k, k{+}1)$; 5-fold GroupKFold cross-validation is grouped by \texttt {doc\_id} to prevent data leakage from the same seed document appearing in both train and test}{table.caption.35}{}}
\@writefile{lot}{\contentsline {table}{\numberline {16}{\ignorespaces Neural probe architecture and training details (Exp-015). Applied to all three model families (Qwen2.5-1.5B, Pythia-1.4B, OLMo-1B): each model's frozen hidden states are average-pooled into document embeddings and classified by a two-hidden-layer MLP.}}{16}{table.caption.35}\protected@file@percent }
\newlabel{tab:s7_neural_probe}{{16}{16}{Neural probe architecture and training details (Exp-015). Applied to all three model families (Qwen2.5-1.5B, Pythia-1.4B, OLMo-1B): each model's frozen hidden states are average-pooled into document embeddings and classified by a two-hidden-layer MLP}{table.caption.35}{}}
\@writefile{lot}{\contentsline {table}{\numberline {17}{\ignorespaces Pairwise AUC with bootstrap 95\% confidence intervals for four model-mode configurations (Exp-007, 1{,}000 bootstrap resamples). The horizontal rule separates depth pairs above and below the detectability threshold $\theta = 0.60$. Permutation $p$-values test $H_0\colon  \text  {AUC}= 0.50$. All pairs are significant at $p < 0.01$ except OLMo 1\,vs.\,2 through 4\,vs.\,5 (all $p > 0.09$), consistent with ${K^*_{\text  {empirical}}}{=}1$ for OLMo.}}{17}{table.caption.36}\protected@file@percent }
\newlabel{tab:s8_cv_folds}{{17}{17}{Pairwise AUC with bootstrap 95\% confidence intervals for four model-mode configurations (Exp-007, 1{,}000 bootstrap resamples). The horizontal rule separates depth pairs above and below the detectability threshold $\theta = 0.60$. Permutation $p$-values test $H_0\colon \auc = 0.50$. All pairs are significant at $p < 0.01$ except OLMo 1\,vs.\,2 through 4\,vs.\,5 (all $p > 0.09$), consistent with $\Kempirical {=}1$ for OLMo}{table.caption.36}{}}
\@writefile{lot}{\contentsline {table}{\numberline {18}{\ignorespaces Spearman rank correlation ($\rho $) between binary detector confidence scores and true generational depth, and 6-class depth classification accuracy (Exp-012). Three metrics: log-PPL from the reference model (DivEye), log-PPL from the observer model, and PPL ratio (Binoculars; observer: Pythia-1.4B, performer: OLMo-1B). Random baseline for 6-class accuracy: 0.167. While statistically significant, correlations are driven by the 0v1 boundary; confidence scores do not monotonically track depth beyond generation~1. Qwen-rewrite exhibits reversed sign ($\rho > 0$), indicating that generation mode alters the direction of binary confidence's relationship with depth.}}{17}{table.caption.37}\protected@file@percent }
\newlabel{tab:s9_binary_spearman}{{18}{17}{Spearman rank correlation ($\rho $) between binary detector confidence scores and true generational depth, and 6-class depth classification accuracy (Exp-012). Three metrics: log-PPL from the reference model (DivEye), log-PPL from the observer model, and PPL ratio (Binoculars; observer: Pythia-1.4B, performer: OLMo-1B). Random baseline for 6-class accuracy: 0.167. While statistically significant, correlations are driven by the 0v1 boundary; confidence scores do not monotonically track depth beyond generation~1. Qwen-rewrite exhibits reversed sign ($\rho > 0$), indicating that generation mode alters the direction of binary confidence's relationship with depth}{table.caption.37}{}}
\@writefile{lot}{\contentsline {table}{\numberline {19}{\ignorespaces Pairwise $\text  {AUC}$ with bootstrap 95\% CIs across depth pairs for Pythia-1.4B under four decoding configurations (Exp-020; 10{,}000 bootstrap resamples). Complements Table~\ref {tab:s2_decoding} (Qwen-rewrite) with a second model family. $^\dagger $Greedy decoding triggers repetition collapse in Pythia-1.4B (4-gram repeat rate: $d_0{=}0.01 \to d_1{=}0.72$), inflating 0v1 and 1v2 AUC via lexical degeneracy rather than depth-discriminative features.}}{17}{table.caption.38}\protected@file@percent }
\newlabel{tab:s10_pythia_decoding}{{19}{17}{Pairwise $\auc $ with bootstrap 95\% CIs across depth pairs for Pythia-1.4B under four decoding configurations (Exp-020; 10{,}000 bootstrap resamples). Complements Table~\ref {tab:s2_decoding} (Qwen-rewrite) with a second model family. $^\dagger $Greedy decoding triggers repetition collapse in Pythia-1.4B (4-gram repeat rate: $d_0{=}0.01 \to d_1{=}0.72$), inflating 0v1 and 1v2 AUC via lexical degeneracy rather than depth-discriminative features}{table.caption.38}{}}
\@writefile{lot}{\contentsline {table}{\numberline {20}{\ignorespaces Pairwise $\text  {AUC}$ across depth pairs for three segment lengths (Exp-021; Qwen2.5-1.5B base, continuation mode). ${K^*_{\text  {empirical}}}{=}2$ is confirmed for 128 and 256 tokens; 512 tokens yields point estimate ${K^*_{\text  {empirical}}}{=}2$ but the 1v2 bootstrap CI lower bound falls marginally below $\theta $.}}{17}{table.caption.39}\protected@file@percent }
\newlabel{tab:s11_length_ablation}{{20}{17}{Pairwise $\auc $ across depth pairs for three segment lengths (Exp-021; Qwen2.5-1.5B base, continuation mode). $\Kempirical {=}2$ is confirmed for 128 and 256 tokens; 512 tokens yields point estimate $\Kempirical {=}2$ but the 1v2 bootstrap CI lower bound falls marginally below $\theta $}{table.caption.39}{}}
\@writefile{lot}{\contentsline {table}{\numberline {21}{\ignorespaces Pairwise $\text  {AUC}$ across depth pairs for three text domains (Qwen2.5-1.5B-Instruct, continuation mode). Tests generalization of ${K^*_{\text  {empirical}}}{=}2$ beyond C4 web text to structured and technical domains.}}{18}{table.caption.40}\protected@file@percent }
\newlabel{tab:s12_domain_ablation}{{21}{18}{Pairwise $\auc $ across depth pairs for three text domains (Qwen2.5-1.5B-Instruct, continuation mode). Tests generalization of $\Kempirical {=}2$ beyond C4 web text to structured and technical domains}{table.caption.40}{}}
\@writefile{lot}{\contentsline {table}{\numberline {22}{\ignorespaces Scorer sensitivity: ${K^*_{\text  {empirical}}}$ under self-scoring vs.\ cross-scoring. Self-scorer uses the generator's own model family for feature extraction; cross-scorer uses alternative models (Pythia-1.4B, OLMo-1B). ${K^*_{\text  {empirical}}}$ agreement across scorer conditions indicates the boundary is governed by the generation process. Cross-scoring reduces ${K^*_{\text  {empirical}}}$ only for the most marginal self-scorer condition (Qwen-continuation).}}{18}{table.caption.41}\protected@file@percent }
\newlabel{tab:s13_scorer_sensitivity}{{22}{18}{Scorer sensitivity: $\Kempirical $ under self-scoring vs.\ cross-scoring. Self-scorer uses the generator's own model family for feature extraction; cross-scorer uses alternative models (Pythia-1.4B, OLMo-1B). $\Kempirical $ agreement across scorer conditions indicates the boundary is governed by the generation process. Cross-scoring reduces $\Kempirical $ only for the most marginal self-scorer condition (Qwen-continuation)}{table.caption.41}{}}
