{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GMz1D4GzHmA5br8jaVpsuZ","type":"tool_result","content":"1\texperiments:\n2\t  # === Claim 1: Vision Encoder Dominance ===\n3\t  - id: plan_001\n4\t    claim: 1\n5\t    description: \"SigLIP+Projector RSA vs Full VLA vs DINO — 证明 action-relevant 结构源自 frozen vision encoder\"\n6\t    priority: P0\n7\t    gpu_budget_hours: 1\n8\t    deps: []\n9\t    registry_id: d027_siglip_only_rsa\n10\t    status: done\n11\t    result: \"RSA=0.615 >> VLA 0.488 >> DINO 0.388\"\n12\t\n13\t  - id: plan_002\n14\t    claim: 1\n15\t    description: \"DINO baseline RSA — standalone vision model 参照\"\n16\t    priority: P0\n17\t    gpu_budget_hours: 0.5\n18\t    deps: []\n19\t    registry_id: dinov2_baseline\n20\t    status: done\n21\t    result: \"RSA=0.388\"\n22\t\n23\t  # === Claim 2: LLM Degrades Action Alignment ===\n24\t  - id: plan_003\n25\t    claim: 2\n26\t    description: \"Per-layer RSA degradation curve — 追踪 RSA 从 projector output 到 LLM 各层的衰减轨迹\"\n27\t    priority: P1\n28\t    gpu_budget_hours: 0\n29\t    deps: [plan_001]\n30\t    registry_id: plan_003_perlayer_degradation\n31\t    status: done\n32\t    result: \"Non-monotonic degradation, Proj→L1 primary drop 20-40%, total degradation ~0.13\"\n33\t\n34\t  - id: plan_004\n35\t    claim: 2\n36\t    description: \"Output head analysis — SigLIP+projector frozen 确认, LLM 权重变化不传导到表征\"\n37\t    priority: P0\n38\t    gpu_budget_hours: 0.5\n39\t    deps: []\n40\t    registry_id: d021_output_head_analysis\n41\t    status: done\n42\t    result: \"Projector frozen (cos_sim=1.0), LLM 32层 rel_change 均匀分布\"\n43\t\n44\t  # === Claim 3: Training and Instruction Invariance ===\n45\t  - id: plan_005\n46\t    claim: 3\n47\t    description: \"6 probing methods × 2 benchmarks — 系统性验证 trained ≈ untrained\"\n48\t    priority: P0\n49\t    gpu_budget_hours: 8\n50\t    deps: []\n51\t    registry_id: \"mvp_probe_trained, mvp_probe_untrained, mvp2_action_trained, mvp2_action_untrained, mvp2_action_dino, mvp2_delta_trained, mvp2_delta_untrained, mvp2_delta_dino, lg_rsa_analysis\"\n52\t    status: done\n53\t    result: \"All 6 methods consistent: trained ≈ untrained >> DINO\"\n54\t\n55\t  - id: plan_006\n56\t    claim: 3\n57\t    description: \"Instruction ablation — 去掉 instruction text 测 RSA 变化\"\n58\t    priority: P0\n59\t    gpu_budget_hours: 2\n60\t    deps: []\n61\t    registry_id: d021_instruction_ablation\n62\t    status: done\n63\t    result: \"Δ=0.004 << 0.10 threshold, instruction has no effect\"\n64\t\n65\t  - id: plan_007\n66\t    claim: 3\n67\t    description: \"2×2 matrix (training × instruction) — 四条件全收敛\"\n68\t    priority: P0\n69\t    gpu_budget_hours: 1\n70\t    deps: [plan_006]\n71\t    registry_id: d027_trained_no_inst_rsa\n72\t    status: done\n73\t    result: \"All 4 cells ≈ 0.48-0.49, Bootstrap CI includes 0\"\n74\t\n75\t  - id: plan_008\n76\t    claim: 3\n77\t    description: \"Random instruction control — 用随机/无意义 instruction 替代真实 instruction，验证 instruction content 不影响 RSA\"\n78\t    priority: P1\n79\t    gpu_budget_hours: 2\n80\t    deps: [plan_006]\n81\t    registry_id: plan_008_random_inst_control\n82\t    status: done\n83\t    result: \"All conditions within ±0.017: normal 0.489, random 0.484, shuffled 0.483, empty 0.472. Instruction content invariant.\"\n84\t    note: \"排除 trivial separability 攻击面 (D024). 三重不变性完备：training + instruction presence + instruction content.\"\n85\t\n86\t  # === Functional Validation (D030 Dream feedback) ===\n87\t  - id: plan_011\n88\t    claim: [1, 2]\n89\t    description: \"Functional action probe — 在 projector output / LLM best layer / DINO 特征上训练 linear action predictor，比较 R²。验证 representational degradation 是否对应 functional degradation\"\n90\t    priority: P0\n91\t    gpu_budget_hours: 1\n92\t    deps: [plan_001]\n93\t    registry_id: \"p0_functional_action_probe, p0_functional_action_delta_probe\"\n94\t    status: planned\n95\t    note: \"Dream 三档一致 #1 问题。make-or-break：projector R² ≥ LLM best → functional validation PASS。Reviewer 要求修正：(1) gate 改 bootstrap CI 不用硬编码阈值 (2) 加 DINO probe 三方对比\"\n96\t\n97\t  - id: plan_012\n98\t    claim: [1, 2]\n99\t    description: \"CLIP-ViT pretraining control — 用 CLIP ViT-L 替代 SigLIP，区分 VL pretraining 贡献 vs encoder quality\"\n100\t    priority: P1\n101\t    gpu_budget_hours: 2\n102\t    deps: [plan_001]\n103\t    registry_id: plan_012_clip_vit_control\n104\t    status: done\n105\t    result: \"CLIP RSA=0.557 >> DINO 0.388, close to SigLIP+proj 0.615. VL pretraining is the key factor. Action probe R² pending.\"\n106\t    note: \"Confirms VL pretraining generalizes across encoders (CLIP + SigLIP both >> DINO).\"\n107\t\n108\t  # === Supplementary / Robustness ===\n109\t  - id: plan_009\n110\t    claim: [1, 2]\n111\t    description: \"CKA verification — 用 CKA 指标重复 RSA 发现，确保不是指标依赖\"\n112\t    priority: P2\n113\t    gpu_budget_hours: 0\n114\t    deps: [plan_001]\n115\t    registry_id: plan_009_cka_verification\n116\t    status: done\n117\t    result: \"PARTIAL: CKA ordering reversal vs RSA (untrained > trained > projector > DINO). Hypothesis partially negated — CKA does NOT replicate RSA ordering. But dissociation itself is a finding: RSA=geometric alignment (LLM degrades), CKA=global structure (LLM preserves). last_preaction CKA=0.127 highest.\"\n118\t    note: \"CPU-only. RSA-CKA dissociation = new finding. Claim 2 must scope as 'geometric degradation'.\"\n119\t\n120\t  - id: plan_010\n121\t    claim: [1, 2, 3]\n122\t    description: \"LIBERO-Spatial benchmark 扩展 — 第三个 benchmark 交叉验证\"\n123\t    priority: P2\n124\t    gpu_budget_hours: 4\n125\t    deps: []\n126\t    registry_id: null\n127\t    status: planned\n128\t    note: \"时间允许才做\"\n129\t\n130\tgpu_budget_total_hours: 22\n131\tgpu_budget_remaining_hours: 9\n132\tnote: \"plan_011 (P0 functional probe) 为最高优先级。plan_012 (CLIP-ViT) P1。plan_008/009/010 按序。\"\n133\t"}]},"parent_tool_use_id":"toolu_01SfF3XocMDWSbNFdtEZgwW6","session_id":"f97ff991-0e8f-42e6-bed2-f413306c2d1e","uuid":"6e24537a-42da-43d9-968d-e6a47924d4c7","timestamp":"2026-05-16T01:42:54.025Z"}
