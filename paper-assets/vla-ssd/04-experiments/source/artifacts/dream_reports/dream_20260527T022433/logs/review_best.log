ny and Johnston, Scott and Jones, Andy and Kernion, Jackson and Lovitt, Liane and Ndousse, Kamal and Amodei, Dario and Brown, Tom and Clark, Jack and Kaplan, Jared and McCandlish, Sam and Olah, Chris},\n273\t  journal   = {arXiv preprint arXiv:2209.11895},\n274\t  year      = {2022},\n275\t}\n276\t\n277\t@inproceedings{wang2023_ioi,\n278\t  title     = {Interpretability in the Wild: a Circuit for Indirect Object Identification in {GPT-2} Small},\n279\t  author    = {Wang, Kevin and Variengien, Alexandre and Conmy, Arthur and Shlegeris, Buck and Steinhardt, Jacob},\n280\t  booktitle = {International Conference on Learning Representations (ICLR)},\n281\t  year      = {2023},\n282\t}\n283\t\n284\t@inproceedings{conmy2023,\n285\t  title     = {Towards Automated Circuit Discovery for Mechanistic Interpretability},\n286\t  author    = {Conmy, Arthur and Mavor-Parker, Augustine N. and Lynch, Aengus and Heimersheim, Stefan and Garriga-Alonso, Adri{\\`a}},\n287\t  booktitle = {Advances in Neural Information Processing Systems (NeurIPS)},\n288\t  year      = {2023},\n289\t}\n290\t\n291\t% === Attention Analysis ===\n292\t\n293\t@inproceedings{clark2019,\n294\t  title     = {What Does {BERT} Look At? {An} Analysis of {BERT}'s Attention},\n295\t  author    = {Clark, Kevin and Khandelwal, Urvashi and Levy, Omer and Manning, Christopher D.},\n296\t  booktitle = {Workshop on Analyzing and Interpreting Neural Networks for NLP (BlackboxNLP)},\n297\t  pages     = {276--286},\n298\t  year      = {2019},\n299\t}\n300\t\n301\t% === Probe Methodology ===\n302\t\n303\t@inproceedings{hewitt2019control,\n304\t  title     = {Designing and Interpreting Probes with Control Tasks},\n305\t  author    = {Hewitt, John and Liang, Percy},\n306\t  booktitle = {Conference on Empirical Methods in Natural Language Processing (EMNLP)},\n307\t  pages     = {2733--2743},\n308\t  year      = {2019},\n309\t  doi       = {10.18653/v1/D19-1275},\n310\t}\n311\t\n312\t% === RSA Toolbox ===\n313\t\n314\t@article{