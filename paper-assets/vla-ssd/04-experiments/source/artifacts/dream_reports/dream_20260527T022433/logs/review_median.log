i, Tao and Li, Zhenyu and Zhang, Hao and Guo, Yifeng and Zhang, Liangjun},\n360\t  journal   = {arXiv preprint arXiv:2602.17659},\n361\t  year      = {2026},\n362\t}\n363\t\n364\t% === VLA Fine-tuning and Reasoning ===\n365\t\n366\t@article{fang2025,\n367\t  title     = {{DualVLA}: Building a Generalizable Embodied Agent via Partial Decoupling of Reasoning and Action},\n368\t  author    = {Fang, Zhen and Liu, Zhuoyang and Liu, Jiaming and Chen, Hao and Zeng, Yu and Huang, Shiting and Chen, Zehui and Chen, Lin and Zhang, Shanghang and Zhao, Feng},\n369\t  journal   = {arXiv preprint arXiv:2511.22134},\n370\t  year      = {2025},\n371\t}\n372\t\n373\t% === LLM Backbone ===\n374\t\n375\t@article{touvron2023_llama2,\n376\t  title     = {{Llama} 2: Open Foundation and Fine-Tuned Chat Models},\n377\t  author    = {Touvron, Hugo and Martin, Louis and Stone, Kevin and Albert, Peter and Almahairi, Amjad and Babaei, Yasmine and Bashlykov, Nikolay and Batra, Soumya and Bhargava, Prajjwal and Bhosale, Shruti and others},\n378\t  journal   = {arXiv preprint arXiv:2307.09288},\n379\t  year      = {2023},\n380\t}\n381\t\n382\t% === Dataset ===\n383\t\n384\t@inproceedings{padalkar2023_oxe,\n385\t  title     = {Open {X-Embodiment}: Robotic Learning Datasets and {RT-X} Models},\n386\t  author    = {Padalkar, Abhishek and Poolber, Acorn and Bewley, Ajinkya and others},\n387\t  booktitle = {IEEE International Conference on Robotics and Automation (ICRA)},\n388\t  year      = {2024},\n389\t}\n390\t\n391\t% === VLA Foundation Models ===\n392\t\n393\t@inproceedings{black2024_pi0,\n394\t  title     = {$\\pi_0$: A Vision-Language-Action Flow Model for General Robot Control},\n395\t  author    = {Black, Kevin and Brown, Noah and Driess, Danny and Esmail, Adnan and Equi, Michael and Finn, Chelsea and Fusai, Niccolo and Groom, Lachy and Hausman, Karol and Ichter, Brian and Jakubczak, Szymon and Jones, Tim and Ke, Liyiming and Levine, Sergey and Li-Bell, Adrian and Mothukuri, Mohith and Nair, Suraj and Pertsch, Karl and Shi, Lucy Xiaoyang and Tanner, James and Vuong, Quan and Walling, Anna and Wang, Haohuan and Zhilinsky, Ury},\n396\t  booktitle = {Robotics: Science and Systems},\n397\t  year      = {2025},\n398\t}\n399\t\n400\t@inproceedings{ghosh2024_octo,\n401\t  title     = {Octo: An Open-Source Generalist Robot Policy},\n402\t  author    = {Ghosh, Dibya and Walke, Homer and Pertsch, Karl and Black, Kevin and Mees, Oier and Dasari, Sudeep and Hejna, Joey and Kreiman, Tobias and Xu, Charles and You, Jianlan and Wu, Joey and Finn, Chelsea and Kumar, Aviral and Hausman, Karol and Levine, Sergey},\n403\t  booktitle = {Robotics: Science and Systems},\n404\t  year      = {2024},\n405\t}\n406\t\n407\t% === Attention Head Pruning ===\n408\t\n409\t@inproceedings{michel2019sixteen,\n410\t  title     = {Are Sixteen Heads Really Better than One?},\n411\t  author    = {Michel, Paul and Levy, Omer and Neubig, Graham},\n412\t  booktitle = {Advances in Neural Information Processing Systems (NeurIPS)},\n413\t  volume    = {32},\n414\t  year      = {2019},\n415\t}\n416\t\n417\t% === Instruction Tuning ===\n418\t\n419\t@inproceedings{wei2022finetuned,\n420\t  title     = {Finetuned Language Models Are Zero-Shot Learners},\n421\t  author    = {Wei, Jason and Bosma, Maarten and Zhao, Vincent and Guu, Kelvin and Yu, Adams Wei and Lester, Brian and Du, Nan and Dai, Andrew M and Le, Quoc V},\n422\t  booktitle = {International Conference on Learning Representations (ICLR)},\n423\t  year      = {2022},\n424\t}\n425\t\n426\t@inproceedings{ouyang2022training,\n427\t  title     = {Training language models to follow instructions with human feedback},\n428\t  author    = {Ouyang, Long and Wu, Jeffrey and Jiang, Xu and Almeida, Diogo and Wainwright, Carroll and Mishkin, Pamela and Zhang, Chong and Agarwal, Sandhini and Slama, Katarina and Ray, Alex and others},\n429\t  booktitle = {Advances in Neural Information Processing Systems (NeurIPS)},\n430\t  year      = {2022},\n431\t}\n432