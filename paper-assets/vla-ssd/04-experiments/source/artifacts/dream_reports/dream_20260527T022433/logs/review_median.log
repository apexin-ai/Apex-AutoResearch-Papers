{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BoyXUFKnY7sDvnjtfrfVQB","type":"tool_result","content":"1\t\\documentclass{article}\n2\t\n3\t\\usepackage{corl_2026}\n4\t\n5\t\\usepackage[utf8]{inputenc}\n6\t\\usepackage[T1]{fontenc}\n7\t\\usepackage{lmodern}\n8\t\\usepackage{url}\n9\t\\usepackage{booktabs}\n10\t\\usepackage{amsfonts}\n11\t\\usepackage{amsmath}\n12\t\\usepackage{nicefrac}\n13\t\\usepackage[expansion=false]{microtype}\n14\t\\usepackage{graphicx}\n15\t\\usepackage{enumitem}\n16\t\\usepackage{wrapfig}\n17\t\n18\t\\title{Instruction Routing in Fine-Tuned Vision-Language-Action Models:\\\\ A Cross-Architecture Analysis}\n19\t\n20\t\\author{Anonymous}\n21\t\n22\t\\begin{document}\n23\t\n24\t\\maketitle\n25\t\n26\t\\begin{abstract}\n27\t\\input{abstract}\n28\t\\end{abstract}\n29\t\n30\t\\keywords{Vision-Language-Action models, representational analysis, attention routing, fine-tuning}\n31\t\n32\t\\input{introduction}\n33\t\\input{related_work}\n34\t\\input{method}\n35\t\\input{experiments}\n36\t\\input{discussion}\n37\t\n38\t\\bibliography{references}\n39\t\n40\t\\input{appendix}\n41\t\n42\t\\end{document}\n43\t"}]},"parent_tool_use_id":"toolu_01PgUbf2GtzpaJ7DKZXZBReG","session_id":"fc4ce46a-8c3b-459f-bd12-119e3d710a0a","uuid":"6d2c95e9-0356-4f61-8791-1854e5087cb7","timestamp":"2026-05-27T03:26:49.185Z"}
