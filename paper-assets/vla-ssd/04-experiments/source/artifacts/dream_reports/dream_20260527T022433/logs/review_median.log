{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UB486CJy462DXZcmMNu2Us","type":"tool_result","content":"1\t\\documentclass{article}\n2\t\n3\t\\usepackage{corl_2026}\n4\t\n5\t\\usepackage[utf8]{inputenc}\n6\t\\usepackage[T1]{fontenc}\n7\t\\usepackage{url}\n8\t\\usepackage{booktabs}\n9\t\\usepackage{amsfonts}\n10\t\\usepackage{amsmath}\n11\t\\usepackage{nicefrac}\n12\t\\usepackage[expansion=false]{microtype}\n13\t\\usepackage{graphicx}\n14\t\\usepackage{enumitem}\n15\t\\usepackage{wrapfig}\n16\t\n17\t\\title{Instruction Routing in Fine-Tuned Vision-Language-Action Models:\\\\ A Cross-Architecture Analysis}\n18\t\n19\t\\author{Anonymous}\n20\t\n21\t\\begin{document}\n22\t\n23\t\\maketitle\n24\t\n25\t\\begin{abstract}\n26\t\\input{abstract}\n27\t\\end{abstract}\n28\t\n29\t\\keywords{Vision-Language-Action models, representational analysis, attention routing, fine-tuning}\n30\t\n31\t\\input{introduction}\n32\t\\input{related_work}\n33\t\\input{method}\n34\t\\input{experiments}\n35\t\\input{discussion}\n36\t\n37\t\\bibliography{references}\n38\t\n39\t\\input{appendix}\n40\t\n41\t\\end{document}\n42\t"}]},"parent_tool_use_id":"toolu_018pWsj3F71Y5fPHh353Y6H9","session_id":"fc4ce46a-8c3b-459f-bd12-119e3d710a0a","uuid":"aa4fc5cf-177b-4be5-ac75-c706824238e1","timestamp":"2026-05-27T03:27:16.583Z"}
