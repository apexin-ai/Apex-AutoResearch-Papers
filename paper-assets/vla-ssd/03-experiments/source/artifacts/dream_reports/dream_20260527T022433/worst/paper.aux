\@writefile{lot}{\contentsline {table}{\numberline {10}{\ignorespaces R$^2$ exit collapse matrix: VLM$\to $VLA vs.\ VLA$\to $VLA transitions across architectures and task suites. VLM$\to $VLA transition produces substantial collapse in 6/6 cells ($\Delta = 0.138$--$0.691$); VLA$\to $VLA fine-tuning produces no cell above the $\Delta > 0.10$ threshold (0/4 cells, $\Delta = 0.033$--$0.086$). MCCV v3 corrects prior train-test leakage.}}{7}{table.caption.26}\protected@file@percent }
