\@writefile{lot}{\contentsline {table}{\numberline {15}{\ignorespaces Head ablation results. Instruction-dominant heads show no disproportionate functional role: their per-head effect ($d = 0.027$) is comparable to random heads ($d = 0.025$), and ground-truth action quality is unaffected ($\Delta $MSE $= -0.001$, $p = 0.52$). Specificity ratio of 1.08$\times $ is negligible.}}{9}{table.caption.36}\protected@file@percent }
\newlabel{tab:head_ablation}{{15}{9}{Head ablation results. Instruction-dominant heads show no disproportionate functional role: their per-head effect ($d = 0.027$) is comparable to random heads ($d = 0.025$), and ground-truth action quality is unaffected ($\Delta $MSE $= -0.001$, $p = 0.52$). Specificity ratio of 1.08$\times $ is negligible}{table.caption.36}{}}
