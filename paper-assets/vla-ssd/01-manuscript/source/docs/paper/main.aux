\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {Layer-wise action-probe $R^2$ (LIBERO-Goal, readout token).} Solid blue: trained; dashed orange: reference; dotted gray: NLP finetuning control ($R^2 = 0.155$, matching backbone family). VLM-to-VLA transitions exhibit pronounced peak-to-exit drops ($\Delta R^2 = 0.16$--$0.46$); VLA-to-VLA remains flat ($< 0.09$); NLP controls produce flat profiles ($\Delta R^2 = 0.000$). Demo-level splitting; see Table~\ref {tab:cross_arch_matrix}.}}{7}{figure.6}\protected@file@percent }
\newlabel{fig:r2_collapse}{{6}{7}{\textbf {Layer-wise action-probe $R^2$ (LIBERO-Goal, readout token).} Solid blue: trained; dashed orange: reference; dotted gray: NLP finetuning control ($R^2 = 0.155$, matching backbone family). VLM-to-VLA transitions exhibit pronounced peak-to-exit drops ($\Delta R^2 = 0.16$--$0.46$); VLA-to-VLA remains flat ($< 0.09$); NLP controls produce flat profiles ($\Delta R^2 = 0.000$). Demo-level splitting; see Table~\ref {tab:cross_arch_matrix}}{figure.6}{}}
