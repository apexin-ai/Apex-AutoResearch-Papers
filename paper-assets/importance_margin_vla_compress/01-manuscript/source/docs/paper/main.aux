\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Scoring method comparison at $k{=}0.9$ across three models and four LIBERO suites. Cell color encodes SR as a fraction of unpruned baseline; blue bars mark the best method per condition; dashed borders indicate method-indifferent cells ($\Delta {<}3.5$\,pp). $\pi _{0.5}$'s linear connector strongly favors L2 selection, while X-VLA's BART encoder is largely method-indifferent. SmolVLA collapses to 0\% regardless of method. Compact 2$\times $2 summary in Appendix Table~\ref {tab:scoring_crossover_summary}.}}{13}{figure.caption.29}\protected@file@percent }
\newlabel{fig:scoring_crossover}{{7}{13}{Scoring method comparison at $k{=}0.9$ across three models and four LIBERO suites. Cell color encodes SR as a fraction of unpruned baseline; blue bars mark the best method per condition; dashed borders indicate method-indifferent cells ($\Delta {<}3.5$\,pp). $\pi _{0.5}$'s linear connector strongly favors L2 selection, while X-VLA's BART encoder is largely method-indifferent. SmolVLA collapses to 0\% regardless of method. Compact 2$\times $2 summary in Appendix Table~\ref {tab:scoring_crossover_summary}}{figure.caption.29}{}}
\@writefile{toc}{\contentsline {paragraph}{Limitations (extended).}{13}{section*.31}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Non-monotonicity as structural property.}{13}{section*.32}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Importance margin (L2 $-$ Random SR) on $\pi _{0.5}$ Long across retention ratios (multi-seed mean $\pm $ s.d.; $n{=}5$). The margin peaks sharply at $k{=}0.9$ (46.8\,pp) where random pruning is maximally destructive, then declines asymmetrically: one step above the peak ($k{=}0.95$: 25.6\,pp) versus four steps below before crossing zero at $k{\approx }0.71$. At $k{=}0.5$, L2 and Random converge ($|\Delta |{\approx }1.3$\,pp), indicating that scoring method choice matters only in the moderate-pruning window.}}{14}{figure.caption.30}\protected@file@percent }
\newlabel{fig:margin_profile}{{8}{14}{Importance margin (L2 $-$ Random SR) on $\pi _{0.5}$ Long across retention ratios (multi-seed mean $\pm $ s.d.; $n{=}5$). The margin peaks sharply at $k{=}0.9$ (46.8\,pp) where random pruning is maximally destructive, then declines asymmetrically: one step above the peak ($k{=}0.95$: 25.6\,pp) versus four steps below before crossing zero at $k{\approx }0.71$. At $k{=}0.5$, L2 and Random converge ($|\Delta |{\approx }1.3$\,pp), indicating that scoring method choice matters only in the moderate-pruning window}{figure.caption.30}{}}
