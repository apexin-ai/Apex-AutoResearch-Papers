{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01F6TqszbFU54bi44LwTzxjJ","type":"tool_result","content":"{\"result\":\"{\\\"success\\\": true, \\\"data\\\": {\\\"path\\\": \\\"/home/ubuntu/.agent-ml-research-be-idea-gen-0515-2/projects/importance_margin_vla_compress/literature_map.yaml\\\", \\\"content\\\": \\\"# Literature Map — importance_margin_vla_compress\\\\n# Generated: 2026-05-17\\\\n# Citation budget: 35\\\\n\\\\npapers:\\\\n\\\\n  # ============================================================\\\\n  # Cluster: VLA Models (target: 6)\\\\n  # ============================================================\\\\n  - bibtex_key: shukor2025smolvla\\\\n    title: \\\\\\\"SmolVLA: A Vision-Language-Action Model for Affordable and Efficient Robotics\\\\\\\"\\\\n    authors: \\\\\\\"Shukor, Mustafa and Aubakirova, Dana and Casas, Adrien and others\\\\\\\"\\\\n    year: 2025\\\\n    venue: \\\\\\\"arXiv preprint\\\\\\\"\\\\n    arxiv_id: \\\\\\\"2506.01844\\\\\\\"\\\\n    category: \\\\\\\"VLA Models\\\\\\\"\\\\n    role: foundation\\\\n    verified: true\\\\n    key_finding: \\\\\\\"450M-param VLA combining compact VLM (SigLIP+Qwen2) with flow matching action expert; 87.3% SR on LIBERO with batch size 64.\\\\\\\"\\\\n    pruning_stats: null\\\\n    notes: \\\\\\\"Our experimental platform. SigLIP encoder produces 128 vision tokens.\\\\\\\"\\\\n\\\\n  - bibtex_key: kim2024openvla\\\\n    title: \\\\\\\"OpenVLA: An Open-Source Vision-Language-Action Model\\\\\\\"\\\\n    authors: \\\\\\\"Kim, Moo Jin and Pertsch, Karl and Karamcheti, Siddharth and others\\\\\\\"\\\\n    year: 2024\\\\n    venue: \\\\\\\"CoRL 2024\\\\\\\"\\\\n    arxiv_id: \\\\\\\"2406.09246\\\\\\\"\\\\n    category: \\\\\\\"VLA Models\\\\\\\"\\\\n    role: foundation\\\\n    verified: true\\\\n    key_finding: \\\\\\\"7B-param open-source VLA trained on 970K episodes from Open X-Embodiment; supports parameter-efficient fine-tuning.\\\\\\\"\\\\n\\\\n  - bibtex_key: zitkovich2023rt2\\\\n    title: \\\\\\\"RT-2: Vision-Language-Action Models Transfer Web Knowledge to Robotic Control\\\\\\\"\\\\n    authors: \\\\\\\"Zitkovich, Brianna and Yu, Tianhe and Xu, Sichun and others\\\\\\\"\\\\n    year: 2023\\\\n    venue: \\\\\\\"CoRL 2023\\\\\\\"\\\\n    arxiv_id: \\\\\\\"2307.15818\\\\\\\"\\\\n    category: \\\\\\\"VLA Models\\\\\\\"\\\\n    role: foundation\\\\n    verified: true\\\\n    key_finding: \\\\\\\"Co-fine-tunes VLM on robotic trajectory data; actions expressed as text tokens; emergent semantic reasoning via chain of thought.\\\\\\\"\\\\n\\\\n  - bibtex_key: ghosh2024octo\\\\n    title: \\\\\\\"Octo: An Open-Source Generalist Robot Policy\\\\\\\"\\\\n    authors: \\\\\\\"Ghosh, Dibya and Walke, Homer and Pertsch, Karl and others\\\\\\\"\\\\n    year: 2024\\\\n    venue: \\\\\\\"arXiv preprint\\\\\\\"\\\\n    arxiv_id: \\\\\\\"2405.12213\\\\\\\"\\\\n    category: \\\\\\\"VLA Models\\\\\\\"\\\\n    role: background\\\\n    verified: true\\\\n    key_finding: \\\\\\\"Transformer-based generalist policy trained on 800K trajectories from Open X-Embodiment; effective fine-tuning across 9 robot platforms.\\\\\\\"\\\\n\\\\n  - bibtex_key: black2024pi0\\\\n    title: \\\\\\\"pi0: A Vision-Language-Action Flow Model for General Robot Control\\\\\\\"\\\\n    authors: \\\\\\\"Black, Kevin and Brown, Noah and Driess, Danny and others\\\\\\\"\\\\n    year: 2024\\\\n    venue: \\\\\\\"arXiv preprint\\\\\\\"\\\\n    arxiv_id: \\\\\\\"2410.24164\\\\\\\"\\\\n    category: \\\\\\\"VLA Models\\\\\\\"\\\\n    role: foundation\\\\n    verified: true\\\\n    key_finding: \\\\\\\"3.3B VLA using flow matching for 50Hz action generation; trained on 10K+ hours of robot data across 7 platforms and 68 tasks.\\\\\\\"\\\\n\\\\n  - bibtex_key: openxembodiment2024\\\\n    title: \\\\\\\"Open X-Embodiment: Robotic Learning Datasets and RT-X Models\\\\\\\"\\\\n    authors: \\\\\\\"Open X-Embodiment Collaboration\\\\\\\"\\\\n    year: 2024\\\\n    venue: \\\\\\\"ICRA 2024\\\\\\\"\\\\n    arxiv_id: \\\\\\\"2310.08864\\\\\\\"\\\\n    category: \\\\\\\"VLA Models\\\\\\\"\\\\n    role: background\\\\n    verified: true\\\\n    key_finding: \\\\\\\"1M+ real robot trajectories spanning 22 embodiments; RT-1-X shows 50% improvement over single-embodiment baselines.\\\\\\\"\\\\n\\\\n  # ============================================================\\\\n  # Cluster: VLM/LLM Token Efficiency (target: 8)\\\\n  # ============================================================\\\\n  - bibtex_key: chen2024fastv\\\\n    title: \\\\\\\"An Image is Worth 1/2 Tokens After Layer 2: Plug-and-Play Inference Acceleration for Large Vision-Language Models\\\\\\\"\\\\n    authors: \\\\\\\"Chen, Liang and others\\\\\\\"\\\\n    year: 2024\\\\n    venue: \\\\\\\"ECCV 2024 (Oral)\\\\\\\"\\\\n    arxiv_id: null\\\\n    category: \\\\\\\"VLM/LLM Token Efficiency\\\\\\\"\\\\n    role: direct-competitor\\\\n    verified: true\\\\n    key_finding: \\\\\\\"Plug-and-play visual token pruning for VLMs; prunes tokens in deep layers based on attention patterns from early layers.\\\\\\\"\\\\n    pruning_stats: \\\\\\\"Prunes ~50% visual tokens with minimal accuracy loss on VLM benchmarks.\\\\\\\"\\\\n\\\\n  - bibtex_key: zhang2023h2o\\\\n    title: \\\\\\\"H2O: Heavy-Hitter Oracle for Efficient Generative Inference of Large Language Models\\\\\\\"\\\\n    authors: \\\\\\\"Zhang, Zhenyu and others\\\\\\\"\\\\n    year: 2023\\\\n    venue: \\\\\\\"NeurIPS 2023\\\\\\\"\\\\n    arxiv_id: \\\\\\\"2306.14048\\\\\\\"\\\\n    category: \\\\\\\"VLM/LLM Token Efficiency\\\\\\\"\\\\n    role: background\\\\n    verified: true\\\\n    key_finding: \\\\\\\"KV cache eviction retaining heavy-hitter tokens; 20% heavy hitters achieve up to 29x throughput improvement.\\\\\\\"\\\\n\\\\n  - bibtex_key: xiao2024streamingllm\\\\n    title: \\\\\\\"Efficient Streaming Language Models with Attention Sinks\\\\\\\"\\\\n    authors: \\\\\\\"Xiao, Guangxuan and Tian, Yuandong and Chen, Beidi and Han, Song and Lewis, Mike\\\\\\\"\\\\n    year: 2024\\\\n    venue: \\\\\\\"ICLR 2024\\\\\\\"\\\\n    arxiv_id: \\\\\\\"2309.17453\\\\\\\"\\\\n    category: \\\\\\\"VLM/LLM Token Efficiency\\\\\\\"\\\\n    role: background\\\\n    verified: true\\\\n    key_finding: \\\\\\\"Attention sink phenomenon: keeping KV of initial tokens recovers window attention performance; enables stable LLM inference over 4M+ tokens.\\\\\\\"\\\\n\\\\n  - bibtex_key: hsu2025vlacache\\\\n    title: \\\\\\\"VLA-Cache: Efficient Vision-Language-Action Manipulation via Adaptive Token Caching\\\\\\\"\\\\n    authors: \\\\\\\"Hsu, Siyu and others\\\\\\\"\\\\n    year: 2025\\\\n    venue: \\\\\\\"NeurIPS 2025\\\\\\\"\\\\n    arxiv_id: \\\\\\\"2502.02175\\\\\\\"\\\\n    category: \\\\\\\"VLM/LLM Token Efficiency\\\\\\\"\\\\n    role: direct-competitor\\\\n    verified: true\\\\n    key_finding: \\\\\\\"Training-free VLA acceleration via temporal KV caching of static visual tokens; 1.7x speedup with negligible SR loss.\\\\\\\"\\\\n    notes: \\\\\\\"Exploits temporal continuity, not token removal. Key difference from our study: caches rather than removes tokens.\\\\\\\"\\\\n\\\\n  - bibtex_key: wang2026vlaiap\\\\n    title: \\\\\\\"VLA-IAP: Training-Free Visual Token Pruning via Interaction Alignment for Vision-Language-Action Models\\\\\\\"\\\\n    authors: \\\\\\\"Wang, others\\\\\\\"\\\\n    year: 2026\\\\n    venue: \\\\\\\"arXiv preprint\\\\\\\"\\\\n    arxiv_id: \\\\\\\"2603.22991\\\\\\\"\\\\n    category: \\\\\\\"VLM/LLM Token Efficiency\\\\\\\"\\\\n    role: direct-competitor\\\\n    verified: true\\\\n    key_finding: \\\\\\\"Geometric prior + dynamic scheduling for VLA token pruning; 97.8% SR with 1.54x speedup. Claims to preserve manipulation-critical tokens.\\\\\\\"\\\\n    notes: \\\\\\\"Reports successful VLA token pruning. Key contrast with our findings. Uses OpenVLA, not SmolVLA.\\\\\\\"\\\\n\\\\n  - bibtex_key: yang2025efficientvla\\\\n    title: \\\\\\\"EfficientVLA: Training-Free Acceleration and Compression for Vision-Language-Action Models\\\\\\\"\\\\n    authors: \\\\\\\"Yang, Yantai and Wang, Yuhao and Wen, Zichen and others\\\\\\\"\\\\n    year: 2025\\\\n    venue: \\\\\\\"arXiv preprint\\\\\\\"\\\\n    arxiv_id: \\\\\\\"2506.10100\\\\\\\"\\\\n    category: \\\\\\\"VLM/LLM Token Efficiency\\\\\\\"\\\\n    role: direct-competitor\\\\n    verified: true\\\\n    key_finding: \\\\\\\"Synergistic layer pruning + task-aware visual token selection + temporal caching on CogACT (7B); 1.93x speedup with 0.6% SR drop on SIMPLER.\\\\\\\"\\\\n    notes: \\\\\\\"Combines three orthogonal efficiency strategies. Uses CogACT not SmolVLA. Layer pruning and temporal caching are complementary to our token-level analysis.\\\\\\\"\\\\n\\\\n  - bibtex_key: liu2025vlapruner\\\\n    title: \\\\\\\"VLA-Pruner: Temporal-Aware Dual-Level Visual Token Pruning for Efficient Vision-Language-Action Inference\\\\\\\"\\\\n    authors: \\\\\\\"Liu, Ziyan and Chen, Yeqiu and Cai, Hongyi and others\\\\\\\"\\\\n    year: 2025\\\\n    venue: \\\\\\\"arXiv preprint\\\\\\\"\\\\n    arxiv_id: \\\\\\\"2511.16449\\\\\\\"\\\\n    category: \\\\\\\"VLM/LLM Token Efficiency\\\\\\\"\\\\n    role: direct-competitor\\\\n    verified: true\\\\n    key_finding: \\\\\\\"Dual-level importance criterion combining prefill attention (semantic) and temporally-smoothed action decode attention for VLA token pruning.\\\\\\\"\\\\n    notes: \\\\\\\"VLA-specific pruning exploiting temporal continuity. Directly relevant as it separates semantic vs action-level token importance.\\\\\\\"\\\\n\\\\n  - bibtex_key: shang2024prumerge\\\\n    title: \\\\\\\"LLaVA-PruMerge: Adaptive Token Reduction for Efficient Large Multimodal Models\\\\\\\"\\\\n    authors: \\\\\\\"Shang, Yuzhang and Cai, Mu and Xu, Bingxin and Lee, Yong Jae and Yan, Yan\\\\\\\"\\\\n    year: 2024\\\\n    venue: \\\\\\\"ICCV 2025\\\\\\\"\\\\n    arxiv_id: \\\\\\\"2403.15388\\\\\\\"\\\\n    category: \\\\\\\"VLM/LLM Token Efficiency\\\\\\\"\\\\n    role: direct-competitor\\\\n    verified: true\\\\n    key_finding: \\\\\\\"Adaptive visual token pruning + merging for LMMs; reduces tokens by 4x (to 5.5% with PruMerge) with comparable performance on VQA/reasoning tasks.\\\\\\\"\\\\n    notes: \\\\\\\"VLM token reduction via CLS attention importance + similarity-based merging. Establishes prune-then-merge paradigm for visual tokens in VLMs.\\\\\\\"\\\\n\\\\n  # ============================================================\\\\n  # Cluster: ViT Token Pruning/Merging (target: 7)\\\\n  # ============================================================\\\\n  - bibtex_key: rao2021dynamicvit\\\\n    title: \\\\\\\"DynamicViT: Efficient Vision Transformers with Dynamic Token Sparsification\\\\\\\"\\\\n    authors: \\\\\\\"Rao, Yongming and Zhao, Wenliang and Liu, Benlin and Lu, Jiwen and Zhou, Jie and Hsieh, Cho-Jui\\\\\\\"\\\\n    year: 2021\\\\n    venue: \\\\\\\"NeurIPS 2021\\\\\\\"\\\\n    arxiv_id: \\\\\\\"2106.02034\\\\\\\"\\\\n    category: \\\\\\\"ViT Token Pruning/Merging\\\\\\\"\\\\n    role: foundation\\\\n    verified: true\\\\n    key_finding: \\\\\\\"Hierarchical token pruning for ViT; removes 66% tokens with only 0.5% accuracy drop on ImageNet; 31-37% FLOPs reduction.\\\\\\\"\\\\n    pruning_stats: \\\\\\\"66% token removal, <0.5% accuracy drop, 40%+ throughput improvement.\\\\\\\"\\\\n\\\\n  - bibtex_key: bolya2023tome\\\\n    title: \\\\\\\"Token Merging: Your ViT But Faster\\\\\\\"\\\\n    authors: \\\\\\\"Bolya, Daniel and Fu, Cheng-Yang and Dai, Xiaoliang and Zhang, Peizhao and Feichtenhofer, Christoph and Hoffman, Judy\\\\\\\"\\\\n    year: 2023\\\\n    venue: \\\\\\\"ICLR 2023 (Oral)\\\\\\\"\\\\n    arxiv_id: \\\\\\\"2210.09461\\\\\\\"\\\\n    category: \\\\\\\"ViT Token Pruning/Merging\\\\\\\"\\\\n    role: foundation\\\\n    verified: true\\\\n    key_finding: \\\\\\\"Training-free token merging via bipartite matching; 2x throughput on ViT-L with only 0.2-0.3% accuracy drop.\\\\\\\"\\\\n    pruning_stats: \\\\\\\"2x throughput, 0.2-0.3% accuracy drop. Merges redundant foreground + background tokens.\\\\\\\"\\\\n\\\\n  - bibtex_key: liang2022evit\\\\n    title: \\\\\\\"Not All Patches are What You Need: Expediting Vision Transformers via Token Reorganizations\\\\\\\"\\\\n    authors: \\\\\\\"Liang, Youwei and Ge, Chongjian and Tong, Zhan and Song, Yibing and Wang, Jue and Xie, Pengtao\\\\\\\"\\\\n    year: 2022\\\\n    venue: \\\\\\\"ICLR 2022\\\\\\\"\\\\n    arxiv_id: \\\\\\\"2202.07800\\\\\\\"\\\\n    category: \\\\\\\"ViT Token Pruning/Merging\\\\\\\"\\\\n    role: foundation\\\\n    verified: true\\\\n    key_finding: \\\\\\\"Token reorganization guided by CLS attention; 50% speedup with 0.3% accuracy drop on DeiT-S. Fuses inattentive tokens.\\\\\\\"\\\\n    pruning_stats: \\\\\\\"50% speedup, 0.3% accuracy drop on ImageNet.\\\\\\\"\\\\n\\\\n  - bibtex_key: yin2022avit\\\\n    title: \\\\\\\"A-ViT: Adaptive Tokens for Efficient Vision Transformer\\\\\\\"\\\\n    authors: \\\\\\\"Yin, Hongxu and Vahdat, Arash and Alvarez, Jose M. and Mallya, Arun and Kautz, Jan and Molchanov, Pavlo\\\\\\\"\\\\n    year: 2022\\\\n    venue: \\\\\\\"CVPR 2022 (Oral)\\\\\\\"\\\\n    arxiv_id: \\\\\\\"2112.07658\\\\\\\"\\\\n    category: \\\\\\\"ViT Token Pruning/Merging\\\\\\\"\\\\n    role: background\\\\n    verified: true\\\\n    key_finding: \\\\\\\"Per-token adaptive depth via ACT halting — tokens exit at different layers based on learned halting probability. 62% throughput gain on DeiT-T, 38% on DeiT-S with 0.3% accuracy drop.\\\\\\\"\\\\n    pruning_stats: \\\\\\\"62% throughput improvement (DeiT-T), 38% (DeiT-S), 0.3% accuracy drop. No extra parameters.\\\\\\\"\\\\n    notes: \\\\\\\"Complements fixed-layer pruning (DynamicViT, EViT) and merging (ToMe) by introducing depth-adaptive token halting. Relevant to our analysis of how token importance varies across transformer depth.\\\\\\\"\\\\n\\\\n  # ============================================================\\\\n  # Cluster: Closed-Loop Evaluation (target: 5)\\\\n  # ============================================================\\\\n  - bibtex_key: liu2023libero\\\\n    title: \\\\\\\"LIBERO: Benchmarking Knowledge Transfer for Lifelong Robot Learning\\\\\\\"\\\\n    authors: \\\\\\\"Liu, Bo and Zhu, Yifeng and Gao, Chongkai and Feng, Yihao and Liu, Qiang and Zhu, Yuke and Stone, Peter\\\\\\\"\\\\n    year: 2023\\\\n    venue: \\\\\\\"NeurIPS 2023\\\\\\\"\\\\n    arxiv_id: \\\\\\\"2306.03310\\\\\\\"\\\\n    category: \\\\\\\"Closed-Loop Evaluation\\\\\\\"\\\\n    role: foundation\\\\n    verified: true\\\\n    key_finding: \\\\\\\"130 manipulation tasks across 4 suites; evaluates knowledge transfer in lifelong robot learning with teleoperated demonstrations.\\\\\\\"\\\\n    notes: \\\\\\\"Our evaluation benchmark. We use Object/Spatial/Goal suites (10 tasks each, 50 episodes/task).\\\\\\\"\\\\n\\\\n  - bibtex_key: mees2022calvin\\\\n    title: \\\\\\\"CALVIN: A Benchmark for Language-Conditioned Policy Learning for Long-Horizon Robot Manipulation Tasks\\\\\\\"\\\\n    authors: \\\\\\\"Mees, Oier and Hermann, Lukas and Rosete-Beas, Erick and Burgard, Wolfram\\\\\\\"\\\\n    year: 2022\\\\n    venue: \\\\\\\"IEEE RA-L\\\\\\\"\\\\n    arxiv_id: \\\\\\\"2112.03227\\\\\\\"\\\\n    category: \\\\\\\"Closed-Loop Evaluation\\\\\\\"\\\\n    role: background\\\\n    verified: true\\\\n    key_finding: \\\\\\\"Long-horizon language-conditioned manipulation benchmark; 24h teleoperated play data with 20K language directives.\\\\\\\"\\\\n\\\\n  - bibtex_key: chi2023diffusionpolicy\\\\n    title: \\\\\\\"Diffusion Policy: Visuomotor Policy Learning via Action Diffusion\\\\\\\"\\\\n    authors: \\\\\\\"Chi, Cheng and Feng, Siyuan and Du, Yilun and Xu, Zhenjia and Cousineau, Eric and Burchfiel, Benjamin and Song, Shuran\\\\\\\"\\\\n    year: 2023\\\\n    venue: \\\\\\\"RSS 2023\\\\\\\"\\\\n    arxiv_id: \\\\\\\"2303.04137\\\\\\\"\\\\n    category: \\\\\\\"Closed-Loop Evaluation\\\\\\\"\\\\n    role: background\\\\n    verified: true\\\\n    key_finding: \\\\\\\"Conditional denoising diffusion for robot policy; 46.9% average improvement across 12 tasks; handles multimodal action distributions.\\\\\\\"\\\\n\\\\n  # ============================================================\\\\n  # Cluster: Negative Results & Evaluation Pitfalls (target: 5)\\\\n  # ============================================================\\\\n  - bibtex_key: zeng2023transformers_tsf\\\\n    title: \\\\\\\"Are Transformers Effective for Time Series Forecasting?\\\\\\\"\\\\n    authors: \\\\\\\"Zeng, Ailing and Chen, Muxi and Zhang, Lei and Xu, Qiang\\\\\\\"\\\\n    year: 2023\\\\n    venue: \\\\\\\"AAAI 2023\\\\\\\"\\\\n    arxiv_id: \\\\\\\"2205.13504\\\\\\\"\\\\n    category: \\\\\\\"Negative Results & Evaluation Pitfalls\\\\\\\"\\\\n    role: foundation\\\\n    verified: true\\\\n    key_finding: \\\\\\\"Simple linear models outperform sophisticated Transformer-based LTSF models on all 9 datasets, often by 20-50%. Challenges the Transformer paradigm for time series.\\\\\\\"\\\\n\\\\n  - bibtex_key: bouthillier2024negative\\\\n    title: \\\\\\\"Position: Embracing Negative Results in Machine Learning\\\\\\\"\\\\n    authors: \\\\\\\"Bouthillier, Xavier and others\\\\\\\"\\\\n    year: 2024\\\\n    venue: \\\\\\\"ICML 2024\\\\\\\"\\\\n    arxiv_id: \\\\\\\"2406.03980\\\\\\\"\\\\n    category: \\\\\\\"Negative Results & Evaluation Pitfalls\\\\\\\"\\\\n    role: background\\\\n    verified: true\\\\n    key_finding: \\\\\\\"Position paper arguing for publication of negative results to improve ML research efficiency; predictive performance alone is insufficient for evaluating contributions.\\\\\\\"\\\\n\\\\n  # ============================================================\\\\n  # Background / Architecture\\\\n  # ============================================================\\\\n  - bibtex_key: zhai2023siglip\\\\n    title: \\\\\\\"Sigmoid Loss for Language Image Pre-Training\\\\\\\"\\\\n    authors: \\\\\\\"Zhai, Xiaohua and Mustafa, Basil and Kolesnikov, Alexander and Beyer, Lucas\\\\\\\"\\\\n    year: 2023\\\\n    venue: \\\\\\\"ICCV 2023\\\\\\\"\\\\n    arxiv_id: \\\\\\\"2303.15343\\\\\\\"\\\\n    category: \\\\\\\"VLA Models\\\\\\\"\\\\n    role: foundation\\\\n    verified: true\\\\n    key_finding: \\\\\\\"Pairwise sigmoid loss for image-text pretraining; optimal at batch size 32K; 84.5% ImageNet zero-shot with only 4 TPUv4 chips.\\\\\\\"\\\\n    notes: \\\\\\\"Vision encoder used in SmolVLA. Produces spatial patch tokens without CLS token.\\\\\\\"\\\\n\\\\n  - bibtex_key: yang2024qwen2\\\\n    title: \\\\\\\"Qwen2 Technical Report\\\\\\\"\\\\n    authors: \\\\\\\"Yang, An and others\\\\\\\"\\\\n    year: 2024\\\\n    venue: \\\\\\\"arXiv preprint\\\\\\\"\\\\n    arxiv_id: \\\\\\\"2407.10671\\\\\\\"\\\\n    category: \\\\\\\"VLA Models\\\\\\\"\\\\n    role: background\\\\n    verified: true\\\\n    key_finding: \\\\\\\"0.5B-72B parameter LLM family; Qwen2-1.5B is the LLM backbone in SmolVLA.\\\\\\\"\\\\n\\\\n  - bibtex_key: lipman2023flow\\\\n    title: \\\\\\\"Flow Matching for Generative Modeling\\\\\\\"\\\\n    authors: \\\\\\\"Lipman, Yaron and Chen, Ricky T. Q. and Ben-Hamu, Heli and Nickel, Maximilian and Le, Matt\\\\\\\"\\\\n    year: 2023\\\\n    venue: \\\\\\\"ICLR 2023\\\\\\\"\\\\n    arxiv_id: \\\\\\\"2210.02747\\\\\\\"\\\\n    category: \\\\\\\"VLA Models\\\\\\\"\\\\n    role: foundation\\\\n    verified: true\\\\n    key_finding: \\\\\\\"Simulation-free CNF training via regressing conditional probability path vector fields; OT displacement interpolation enables faster training and sampling.\\\\\\\"\\\\n    notes: \\\\\\\"Action generation mechanism in SmolVLA and pi0.\\\\\\\"\\\\n\\\\n  # ============================================================\\\\n  # Cluster: Vision Connectors & Token Compression (target: 6)\\\\n  # ============================================================\\\\n  - bibtex_key: li2023blip2\\\\n    title: \\\\\\\"BLIP-2: Bootstrapping Language-Image Pre-training with Frozen Image Encoders and Large Language Models\\\\\\\"\\\\n    authors: \\\\\\\"Li, Junnan and Li, Dongxu and Savarese, Silvio and Hoi, Steven\\\\\\\"\\\\n    year: 2023\\\\n    venue: \\\\\\\"ICML 2023\\\\\\\"\\\\n    arxiv_id: \\\\\\\"2301.12597\\\\\\\"\\\\n    category: \\\\\\\"Vision Connectors & Token Compression\\\\\\\"\\\\n    role: foundation\\\\n    verified: true\\\\n    key_finding: \\\\\\\"Querying Transformer (Q-Former) compresses visual tokens into fixed number of query tokens; outperforms Flamingo80B on zero-shot VQAv2 with 54x fewer trainable parameters.\\\\\\\"\\\\n    notes: \\\\\\\"Exemplar of learned cross-attention compression for vision-language bridging. Our proposed cross-attention compression draws on this principle.\\\\\\\"\\\\n\\\\n  - bibtex_key: alayrac2022flamingo\\\\n    title: \\\\\\\"Flamingo: a Visual Language Model for Few-Shot Learning\\\\\\\"\\\\n    authors: \\\\\\\"Alayrac, Jean-Baptiste and Donahue, Jeff and Luc, Pauline and others\\\\\\\"\\\\n    year: 2022\\\\n    venue: \\\\\\\"NeurIPS 2022\\\\\\\"\\\\n    arxiv_id: \\\\\\\"2204.14198\\\\\\\"\\\\n    category: \\\\\\\"Vision Connectors & Token Compression\\\\\\\"\\\\n    role: foundation\\\\n    verified: true\\\\n    key_finding: \\\\\\\"Perceiver Resampler maps variable-size spatio-temporal visual features to fixed number of output tokens via cross-attention with learnable queries.\\\\\\\"\\\\n    notes: \\\\\\\"Another learned cross-attention connector. Together with BLIP-2, establishes the cross-attention connector paradigm that contrasts with MLP/pixel_shuffle approaches.\\\\\\\"\\\\n\\\\n  - bibtex_key: liu2023llava\\\\n    title: \\\\\\\"Visual Instruction Tuning\\\\\\\"\\\\n    authors: \\\\\\\"Liu, Haotian and Li, Chunyuan and Wu, Qingyang and Lee, Yong Jae\\\\\\\"\\\\n    year: 2023\\\\n    venue: \\\\\\\"NeurIPS 2023\\\\\\\"\\\\n    arxiv_id: \\\\\\\"2304.08485\\\\\\\"\\\\n    category: \\\\\\\"Vision Connectors & Token Compression\\\\\\\"\\\\n    role: foundation\\\\n    verified: true\\\\n    key_finding: \\\\\\\"Simple linear/MLP projection connects vision encoder to LLM; LLaVA-1.5 shows two-layer MLP projector is surprisingly effective and data-efficient.\\\\\\\"\\\\n    notes: \\\\\\\"Key reference for the MLP projector approach used in OpenVLA. Our finding that MLP projector enables graceful degradation under token pruning connects to this design choice.\\\\\\\"\\\\n\\\\n  - bibtex_key: shi2016subpixel\\\\n    title: \\\\\\\"Real-Time Single Image and Video Super-Resolution Using an Efficient Sub-Pixel Convolutional Neural Network\\\\\\\"\\\\n    authors: \\\\\\\"Shi, Wenzhe and Caballero, Jose and Huszar, Ferenc and Totz, Johannes and Aitken, Andrew P. and Bishop, Rob and Rueckert, Daniel and Wang, Zehan\\\\\\\"\\\\n    year: 2016\\\\n    venue: \\\\\\\"CVPR 2016\\\\\\\"\\\\n    arxiv_id: \\\\\\\"1609.05158\\\\\\\"\\\\n    category: \\\\\\\"Vision Connectors & Token Compression\\\\\\\"\\\\n    role: background\\\\n    verified: true\\\\n    key_finding: \\\\\\\"Introduces sub-pixel convolution (pixel shuffle) that rearranges spatial resolution and channel dimensions; enables real-time 1080p super-resolution.\\\\\\\"\\\\n    notes: \\\\\\\"Origin of the pixel_shuffle operation adopted by SmolVLA and InternVL as vision connector. Central to our cliff-edge failure analysis.\\\\\\\"\\\\n\\\\n  - bibtex_key: chen2024internvl\\\\n    title: \\\\\\\"How Far Are We to GPT-4V? Closing the Gap to Commercial Multimodal Models with Open-Source Suites\\\\\\\"\\\\n    authors: \\\\\\\"Chen, Zhe and Wang, Weiyun and Tian, Hao and others\\\\\\\"\\\\n    year: 2024\\\\n    venue: \\\\\\\"arXiv preprint\\\\\\\"\\\\n    arxiv_id: \\\\\\\"2404.16821\\\\\\\"\\\\n    category: \\\\\\\"Vision Connectors & Token Compression\\\\\\\"\\\\n    role: background\\\\n    verified: true\\\\n    key_finding: \\\\\\\"InternVL 1.5 uses 2x2 pixel unshuffle to compress 1024 visual tokens to 256 per tile; supports dynamic high-resolution up to 4K with up to 40 tiles.\\\\\\\"\\\\n    notes: \\\\\\\"Another VLM using pixel_shuffle connector, confirming its adoption beyond SmolVLA. Strengthens generality of our cliff-edge finding.\\\\\\\"\\\\n\\\\n  - bibtex_key: oquab2024dinov2\\\\n    title: \\\\\\\"DINOv2: Learning Robust Visual Features without Supervision\\\\\\\"\\\\n    authors: \\\\\\\"Oquab, Maxime and Darcet, Timothee and Moutakanni, Theo and others\\\\\\\"\\\\n    year: 2024\\\\n    venue: \\\\\\\"TMLR 2024\\\\\\\"\\\\n    arxiv_id: \\\\\\\"2304.07193\\\\\\\"\\\\n    category: \\\\\\\"Vision Connectors & Token Compression\\\\\\\"\\\\n    role: foundation\\\\n    verified: true\\\\n    key_finding: \\\\\\\"Self-supervised ViT producing all-purpose visual features; scaled to ViT-g with curated LVD-142M dataset; strong transfer across tasks without finetuning.\\\\\\\"\\\\n    notes: \\\\\\\"Vision encoder used in OpenVLA (DinoSigLIP). Its feature structure interacts with the MLP projector to determine token-level importance distribution.\\\\\\\"\\\\n\\\", \\\"total_chars\\\": 20166, \\\"truncated\\\": false}, \\\"error\\\": null, \\\"metadata\\\": {}}\"}"}]},"parent_tool_use_id":"toolu_01STXSqAQ3t5rr6naL2y5ZvK","session_id":"47b17614-1ae9-46bc-87bd-87205f677c45","uuid":"1b97235d-5a72-4246-b26b-b089e29852af","timestamp":"2026-05-25T06:20:09.504Z"}
