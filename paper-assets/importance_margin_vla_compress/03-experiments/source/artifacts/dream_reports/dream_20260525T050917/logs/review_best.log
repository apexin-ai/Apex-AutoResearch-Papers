{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FmHWBwsbJjNyqebQFL1bpF","type":"tool_result","content":"1\t\\documentclass{article}\n2\t\n3\t\\usepackage{corl_2026} % Submission version: anonymous, line numbers enabled.\n4\t% \\usepackage[final]{corl_2026} % Uncomment for camera-ready.\n5\t\n6\t\\usepackage{amsmath,amssymb}\n7\t\\usepackage{graphicx}\n8\t\\usepackage{booktabs}\n9\t\\usepackage{multirow}\n10\t\\usepackage{enumitem}\n11\t\\usepackage{subcaption}\n12\t\n13\t\\title{Why Token Pruning Crashes Some Robot Policies but Not Others:\\\\Vision Connectors and VLA Token Compressibility}\n14\t\n15\t\\begin{document}\n16\t\\maketitle\n17\t\n18\t\\input{abstract}\n19\t\n20\t\\keywords{vision-language-action models, token pruning, robot learning}\n21\t\n22\t\\input{introduction}\n23\t\n24\t\\input{related_work}\n25\t\n26\t\\input{method}\n27\t\n28\t\\input{experiments}\n29\t\n30\t\\input{conclusion}\n31\t\n32\t\\bibliography{references}\n33\t\n34\t\\input{appendix}\n35\t\n36\t\\end{document}\n37\t"}]},"parent_tool_use_id":"toolu_01HPBhBkhNpoJAnoeFT78ayv","session_id":"eee2ebdf-357f-4a4d-85c6-2bc7a2b292e5","uuid":"893fcf9a-900c-48d1-b0f2-90500fc4871f","timestamp":"2026-05-25T05:59:46.527Z"}
