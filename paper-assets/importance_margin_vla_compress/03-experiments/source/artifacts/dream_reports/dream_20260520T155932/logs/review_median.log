07\\\\n  location:\\\\n    section: conclusion\\\\n    paragraph: 0\\\\n    sentence: 0\\\\n  text: 44.8% to ~60%, 61.6% at 75% reduction\\\\n  type: quantitative\\\\n  evidence:\\\\n  - exp_id: smart_compress_m32\\\\n    metric: success_rate\\\\n  - exp_id: eval_stage1_only\\\\n    metric: success_rate\\\\n  decisions: []\\\\n  deprecated: false\\\\n- id: C408\\\\n  location:\\\\n    section: appendix\\\\n    paragraph: 0\\\\n    sentence: 0\\\\n  text: Smart Compress M=32 achieves 53.2% on LIBERO-Spatial\\\\n  type: quantitative\\\\n  evidence:\\\\n  - exp_id: smart_compress_m32_spatial\\\\n    metric: success_rate\\\\n  decisions: []\\\\n  deprecated: false\\\\n- id: C409\\\\n  location:\\\\n    section: appendix\\\\n    paragraph: 0\\\\n    sentence: 0\\\\n  text: Smart Compress M=32 achieves 56.4% on LIBERO-Goal\\\\n  type: quantitative\\\\n  evidence:\\\\n  - exp_id: smart_compress_m32_goal\\\\n    metric: success_rate\\\\n  decisions: []\\\\n  deprecated: false\\\\n- id: C410\\\\n  location:\\\\n    section: results\\\\n    paragraph: 0\\\\n    sentence: 0\\\\n  text: X-VLA cliff threshold lies in k=0.7-0.9 interval (35-45 of 50 tokens)\\\\n  type: quantitative\\\\n  evidence: 'eval_xvla results: k=0.9 98.3±0.8%, k=0.7 57.2±1.6%'\\\\n  decisions: []\\\\n  deprecated: false\\\\n- id: C411\\\\n  location:\\\\n    section: results\\\\n    paragraph: 0\\\\n    sentence: 0\\\\n  text: X-VLA k=0.5 3-seed mean 43.7±1.0%\\\\n  type: quantitative\\\\n  evidence: 3-seed mean including seed44 k=0.5=44.4%\\\\n  decisions: []\\\\n  deprecated: false\\\\n- id: C412\\\\n  location:\\\\n    section: analysis\\\\n    paragraph: 0\\\\n    sentence: 0\\\\n  text: X-VLA cross-seed std <= 1.6pp across all retention ratios (3 seeds x 500 episodes),\\\\n    confirming pruning sensitivity is intrinsic architectural property\\\\n  type: quantitative\\\\n  evidence: k=0.9 std=0.8pp, k=0.7 std=1.6pp, k=0.5 std=1.0pp\\\\n  decisions: []\\\\n  deprecated: false\\\\n- id: C413\\\\n  location:\\\\n    section: analysis\\\\n    paragraph: 0\\\\n    sentence: 0\\\\n  text: Scale ordering (450M<880M<3.3B<7B) is non-monotonic with pruning tolerance\\\\n    ordering (SmolVLA<OpenVLA<X-VLA<pi0), sharing only the minimum\\\\n  type: quantitative\\\\n  evidence: pi0 3.3B immune, OpenVLA 7B vulnerable; CV tracks connector complexity\\\\n    not scale\\\\n  decisions: []\\\\n  deprecated: false\\\\n- id: C414\\\\n  location:\\\\n    section: analysis\\\\n    paragraph: 0\\\\n    sentence: 0\\\\n  text: 'Matched-scale experiment not feasible: no public VLA pair shares identical\\\\n    backbone with different connectors'\\\\n  type: quantitative\\\\n  evidence: Survey of available VLA models\\\\n  decisions: []\\\\n  deprecated: false\\\\n- id: C415\\\\n  location:\\\\n    section: abstract\\\\n    paragraph: 0\\\\n    sentence: 0\\\\n  text: 'X-VLA k=0.9 3-seed: 97.8±0.4% SR'\\\\n  type: quantitative\\\\n  evidence: seed42=97.6%, seed43=97.6%, seed44=98.2%\\\\n  decisions: []\\\\n  deprecated: false\\\\n- id: C416\\\\n  location:\\\\n    section: introduction\\\\n    paragraph: 0\\\\n    sentence: 0\\\\n  text: 'X-VLA k=0.9 3-seed: 97.8±0.4% SR'\\\\n  type: quantitative\\\\n  evidence: seed42=97.6%, seed43=97.6%, seed44=98.2%\\\\n  decisions: []\\\\n  deprecated: false\\\\n- id: C417\\\\n  location:\\\\n    section: results\\\\n    paragraph: 0\\\\n    sentence: 0\\\\n  text: 'X-VLA k=0.9 3-seed: 97.8±0.4% SR'\\\\n  type: quantitative\\\\n  evidence: seed42=97.6%, seed43=97.6%, seed44=98.2%\\\\n  decisions: []\\\\n  deprecated: false\\\\ntables:\\\\n- id: tab:smart_compress\\\\n  location:\\\\n    section: results\\\\n    table_number: 0\\\\n  caption: ''\\\\n  cells:\\\\n  - row: Smart Compress M=64\\\\n    col: SR\\\\n    value: '61.6'\\\\n    source:\\\\n      exp_id: eval_smart_compress_m64\\\\n      metric: overall_success_rate\\\\n  - row: Smart Compress M=32\\\\n    col: SR\\\\n    value: '61.6'\\\\n    source:\\\\n      exp_id: eval_smart_compress_m32\\\\n      metric: overall_success_rate\\\\n  - row: Smart Compress M=64\\\\n    col: Episodes\\\\n    value: '500'\\\\n    source:\\\\n      exp_id: eval_smart_compress_m64\\\\n      metric: total_episodes\\\\n  - row: Smart Compress M=32\\\\n    col: Episodes\\\\n    value: '500'\\\\n    source:\\\\n      exp_id: eval_smart_compress_m32\\\\n      metric: total_episodes\\\\n  deprecated: true\\\\n- id: tab:smolvla_baseline_pertask\\\\n  location:\\\\n    section: appendix\\\\n    table_number: 0\\\\n  caption: ''\\\\n  cells:\\\\n  - row: overall\\\\n    col: SR\\\\n    value: '44.8'\\\\n    source:\\\\n      exp_id: baseline_bypass_object\\\\n      metric: overall_sr\\\\n  deprecated: false\\\\n- id: tab:openvla_pertask\\\\n  location:\\\\n    section: appendix\\\\n    table_number: 0\\\\n  caption: ''\\\\n  cells:\\\\n  - row: overall\\\\n    col: SR\\\\n    value: '37.4'\\\\n    source:\\\\n      exp_id: eval_openvla_pruning_k05\\\\n      metric: overall_sr\\\\n  deprecated: false\\\\n- id: tab:smart_compress_pertask\\\\n  location:\\\\n    section: appendix\\\\n    table_number: 0\\\\n  caption: ''\\\\n  cells:\\\\n  - row: overall_m32\\\\n    col: SR\\\\n    value: '61.6'\\\\n    source:\\\\n      exp_id: eval_smart_compress_m32\\\\n      metric: overall_sr\\\\n  - row: overall_m64\\\\n    col: SR\\\\n    value: '61.6'\\\\n    source:\\\\n      exp_id: eval_smart_compress_m64\\\\n      metric: overall_sr\\\\n  deprecated: false\\\\nfigures: []\\\\n_completeness:\\\\n  coverage: 58/60\\\\n  claims: 60\\\\n  tables: 3\\\\n  figures: 0\\\\n  tier_counts:\\\\n    tier1: 0\\\\n    tier2: 58\\\\n    tier3: 2\\\\n    tierX: 0\\\\n  last_checked: '2026-05-20T16:43:23.728785+00:00'\\\\n\\\", \\\"total_chars\\\": 40490, \\\"truncated\\\": false}, \\\"error\\\": null, \\\"metadata\\\": {}}\"}"}]},"parent_tool_use_id":"toolu_016qTfa5WJ7EXvtPwdsm26dN","session_id":"2be1a920-1f7c-4c94-bc45-d01d7138d885","uuid":"00baf46a-3012-48cb-8e69-33496f67fe89","timestamp":"2026-05-20T16