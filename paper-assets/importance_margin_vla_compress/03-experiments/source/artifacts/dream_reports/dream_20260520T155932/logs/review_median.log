{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01S5yyJCmXaBHwg9aZvhWEpL","type":"tool_result","content":"1\t\\documentclass{article}\n2\t\n3\t\\usepackage{corl_2026} % Submission version: anonymous, line numbers enabled.\n4\t% \\usepackage[final]{corl_2026} % Uncomment for camera-ready.\n5\t\n6\t\\usepackage{amsmath,amssymb}\n7\t\\usepackage{graphicx}\n8\t\\usepackage{booktabs}\n9\t\\usepackage{enumitem}\n10\t\\usepackage{subcaption}\n11\t\n12\t\\title{Why Token Pruning Crashes Some Robot Policies but Not Others:\\\\Vision Connectors and VLA Token Compressibility}\n13\t\n14\t\\begin{document}\n15\t\\maketitle\n16\t\n17\t\\input{abstract}\n18\t\n19\t\\keywords{vision-language-action models, token pruning, robot learning}\n20\t\n21\t\\input{introduction}\n22\t\n23\t\\input{related_work}\n24\t\n25\t\\input{experimental_setup}\n26\t\n27\t\\input{results}\n28\t\n29\t\\input{analysis}\n30\t\n31\t\\input{conclusion}\n32\t\n33\t\\bibliography{references}\n34\t\n35\t\\input{appendix}\n36\t\n37\t\\end{document}\n38\t"}]},"parent_tool_use_id":"toolu_01TVHfHT9rZJfyGh37iYNgYg","session_id":"2be1a920-1f7c-4c94-bc45-d01d7138d885","uuid":"880ec14b-4828-4a24-8156-13961e87bf1b","timestamp":"2026-05-20T16:47:03.821Z"}
