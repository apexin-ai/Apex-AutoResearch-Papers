laim: \"core\"\n    priority: 4\n    depends_on: [exp_sft_baseline, exp_posthoc_nli, exp_grpo_provenance]\n    metrics: [\"re_f1_delta\", \"evi_f1_delta\", \"degeneration_rate\", \"diversity_score\"]\n    registry_id: null\n",
