\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Method overview. We construct parallel EN/ZH conflict data from ConflictQA with COMET-validated translations, extract per-layer residual stream representations, train logistic regression probes in four transfer directions (EN$\to $EN, ZH$\to $ZH, EN$\to $ZH, ZH$\to $EN), and apply confound exclusion controls before causal steering validation.}}{4}{figure.caption.5}\protected@file@percent }
\newlabel{fig:pipeline}{{2}{4}{Method overview. We construct parallel EN/ZH conflict data from ConflictQA with COMET-validated translations, extract per-layer residual stream representations, train logistic regression probes in four transfer directions (EN$\to $EN, ZH$\to $ZH, EN$\to $ZH, ZH$\to $EN), and apply confound exclusion controls before causal steering validation}{figure.caption.5}{}}
