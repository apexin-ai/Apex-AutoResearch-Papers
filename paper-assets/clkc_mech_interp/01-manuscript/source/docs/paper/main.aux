\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Steering significance across layers and models. Each point shows the best $-\log _{10}(p)$ (Fisher exact test) across six $\alpha $ values at a given layer. Filled circles: significant after per-layer Bonferroni correction ($k{=}6$, threshold $p < 0.0083$). Only Llama shows significant causal effects, concentrated at L13 ($p < 0.001$) with attenuation through L14 ($p = 0.002$) and L16 ($p = 0.005$). Qwen (L13--L15) and Gemma (L16--L18) show no significant effects at comparable relative depths (36--43\%), despite high probe accuracy.}}{8}{figure.caption.17}\protected@file@percent }
\newlabel{fig:steering_viz}{{5}{8}{Steering significance across layers and models. Each point shows the best $-\log _{10}(p)$ (Fisher exact test) across six $\alpha $ values at a given layer. Filled circles: significant after per-layer Bonferroni correction ($k{=}6$, threshold $p < 0.0083$). Only Llama shows significant causal effects, concentrated at L13 ($p < 0.001$) with attenuation through L14 ($p = 0.002$) and L16 ($p = 0.005$). Qwen (L13--L15) and Gemma (L16--L18) show no significant effects at comparable relative depths (36--43\%), despite high probe accuracy}{figure.caption.17}{}}
\@LN@col{1}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Representation steering results (Llama: original experiment, $N{=}136$, 10-value $\alpha $ grid; Qwen/Gemma: 6-value grid). Flip rate: fraction of test samples switching answer category. Control: random-direction perturbation of equal magnitude. Bonferroni threshold $p < 0.005$ ($k = 10$) for Llama, $p < 0.0083$ ($k = 6$) for Qwen/Gemma. Significant results in bold.$^{\dagger }$}}{8}{table.caption.21}\protected@file@percent }
\newlabel{tab:steering}{{3}{8}{Representation steering results (Llama: original experiment, $N{=}136$, 10-value $\alpha $ grid; Qwen/Gemma: 6-value grid). Flip rate: fraction of test samples switching answer category. Control: random-direction perturbation of equal magnitude. Bonferroni threshold $p < 0.005$ ($k = 10$) for Llama, $p < 0.0083$ ($k = 6$) for Qwen/Gemma. Significant results in bold.$^{\dagger }$}{table.caption.21}{}}
