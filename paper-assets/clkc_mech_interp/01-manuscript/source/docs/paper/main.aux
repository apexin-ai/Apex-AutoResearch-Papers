\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Layer-wise probe balanced accuracy for Llama-3.1-8B (left), Qwen3-8B (center), and Gemma-2-9B-IT (right). Solid lines: residual stream probes; dashed lines (Llama and Qwen only): multilayer perceptron (MLP) sublayer probes. Stars mark peak layers. In the Llama panel, the vertical annotation at L13 marks the layer where steering produces significant causal influence (Fisher $p < 0.001$), near the EN$\to $EN probe peak (L15). In the Gemma panel, L17 and L21 are annotated as steering-negative layers.}}{6}{figure.caption.10}\protected@file@percent }
\newlabel{fig:layer_probe}{{3}{6}{Layer-wise probe balanced accuracy for Llama-3.1-8B (left), Qwen3-8B (center), and Gemma-2-9B-IT (right). Solid lines: residual stream probes; dashed lines (Llama and Qwen only): multilayer perceptron (MLP) sublayer probes. Stars mark peak layers. In the Llama panel, the vertical annotation at L13 marks the layer where steering produces significant causal influence (Fisher $p < 0.001$), near the EN$\to $EN probe peak (L15). In the Gemma panel, L17 and L21 are annotated as steering-negative layers}{figure.caption.10}{}}
\@LN@col{1}
