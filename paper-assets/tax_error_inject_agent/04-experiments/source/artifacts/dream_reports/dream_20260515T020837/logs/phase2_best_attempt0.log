{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01E2Sib2V86y3AQS9ZLtMKgm","type":"tool_result","content":"1\t# experiment_plan.yaml — tax_error_inject_agent\n2\t# 基于 paper_framing.md 的 Supplementary Experiments\n3\t# 生成时间: 2026-05-14\n4\t\n5\t# ==================== 已完成基线 ====================\n6\t# vanilla-react-baseline: 42.6% (Qwen3-8B zero-shot)\n7\t# v4 Vanilla SFT: 65.3% ± 3.2pp (seeds 42/0/123)\n8\t# v4 TaxEI SFT: 54.3% ± 10.5pp (seeds 42/0, seed=123 训练中)\n9\t# v4 Random SFT: 60.7% ± 7.6pp (seeds 42/0, seed=123 训练中)\n10\t# Recovery eval (seed=42): Vanilla 61.7%, TaxEI 59.6%, Random 63.8%\n11\t# Detection rate: 0% across all methods\n12\t\n13\texperiments:\n14\t  # ============================================================\n15\t  # P1: 投稿前必须完成\n16\t  # ============================================================\n17\t\n18\t  - id: \"p1-multiseed-train\"\n19\t    name: \"Multi-seed 补齐训练 (TaxEI/Random seed=123)\"\n20\t    priority: P1\n21\t    category: \"multi-seed\"\n22\t    hypothesis: \"补齐第 3 个 seed，使 TaxEI/Random 达到与 Vanilla 相同的 3-seed 覆盖，获得可靠的均值和方差估计\"\n23\t    method: \"v4 同源数据 (9,029 samples)，LoRA rank=16, 3 epochs, lr=1e-4, seed=123。与 seed=42/0 完全相同的超参。\"\n24\t    data: \"sft_taxei_v4.jsonl (9,029), sft_random_v4.jsonl (9,029)\"\n25\t    gpu: \"cuda:0 (TaxEI), cuda:1 (Random), 各 ~110min\"\n26\t    status: \"running\"\n27\t    registry_id: \"v4-taxei-seed123, v4-random-seed123\"\n28\t    supports_claim: [\"Claim 1\", \"Claim 2\", \"Claim 3\"]\n29\t\n30\t  - id: \"p1-multiseed-eval\"\n31\t    name: \"Multi-seed seed=123 Clean Eval\"\n32\t    priority: P1\n33\t    category: \"multi-seed\"\n34\t    hypothesis: \"seed=123 的 clean eval 结果应与 seed=42/0 方向一致 (TaxEI ≤ Vanilla)\"\n35\t    method: \"recovery.py --no_inject，47 tasks (valid_unseen)，对 seed=123 checkpoints 跑 clean eval\"\n36\t    data: \"ALFWorld valid_unseen 47 tasks\"\n37\t    gpu: \"cuda:0 + cuda:1, 各 ~25min\"\n38\t    depends_on: [\"p1-multiseed-train\"]\n39\t    status: \"planned\"\n40\t    supports_claim: [\"Claim 1\", \"Claim 2\", \"Claim 3\"]\n41\t\n42\t  - id: \"p1-3seed-stats\"\n43\t    name: \"3-seed 统计更新\"\n44\t    priority: P1\n45\t    category: \"analysis\"\n46\t    hypothesis: \"3-seed 结果将提高统计功效，使 TaxEI vs Vanilla 的 p 值更可靠\"\n47\t    method: \"multiseed_stats.py: 更新 paired permutation test, bootstrap CI, 方差比较。3 seeds × 3 methods。\"\n48\t    data: \"所有 3-seed eval 结果 JSON\"\n49\t    gpu: \"无 (CPU 分析)\"\n50\t    depends_on: [\"p1-multiseed-eval\"]\n51\t    status: \"planned\"\n52\t    supports_claim: [\"Claim 1\", \"Claim 2\", \"Claim 3\"]\n53\t\n54\t  - id: \"p1-ablation-datagen\"\n55\t    name: \"Injection Ratio Ablation 数据生成\"\n56\t    priority: P1\n57\t    category: \"ablation\"\n58\t    hypothesis: \"固定总数据量 ~9K samples，变化注入比例 (10%/25%/50%)，如果低比例缓解退化则支持 'noise overwhelms signal' 假设\"\n59\t    method: |\n60\t      Fixed-size 方案: 总量固定 ~9,029 samples\n61\t      - 10% injection: ~903 injected + ~8,126 clean\n62\t      - 25% injection: ~2,257 injected + ~6,772 clean\n63\t      - 50% injection: 已有 (v4 数据, 4,671 injected + 4,358 clean)\n64\t      从现有 4,671 条 injected_variants 中随机采样，TaxEI/Random 各自格式化。\n65\t    data: \"data/mini_pipeline_v4/injected_variants + clean trajectories\"\n66\t    gpu: \"无 (CPU 数据处理)\"\n67\t    status: \"planned\"\n68\t    supports_claim: [\"Claim 1\", \"Claim 2\"]\n69\t\n70\t  - id: \"p1-ablation-train-10pct\"\n71\t    name: \"Injection Ratio 10% 训练 (TaxEI + Random)\"\n72\t    priority: P1\n73\t    category: \"ablation\"\n74\t    hypothesis: \"10% 注入比例下 TaxEI/Random 退化幅度显著小于 50%\"\n75\t    method: \"与 v4 相同超参 (LoRA rank=16, 3 epochs, lr=1e-4, seed=42), 仅数据不同\"\n76\t    data: \"~9,029 samples (10% injection)\"\n77\t    gpu: \"cuda:0 (TaxEI-10%), cuda:1 (Random-10%), 各 ~110min\"\n78\t    depends_on: [\"p1-ablation-datagen\"]\n79\t    status: \"planned\"\n80\t    supports_claim: [\"Claim 1\", \"Claim 2\"]\n81\t\n82\t  - id: \"p1-ablation-train-25pct\"\n83\t    name: \"Injection Ratio 25% 训练 (TaxEI + Random)\"\n84\t    priority: P1\n85\t    category: \"ablation\"\n86\t    hypothesis: \"25% 注入比例是 noise vs signal 的转折点\"\n87\t    method: \"与 v4 相同超参, 仅数据不同\"\n88\t    data: \"~9,029 samples (25% injection)\"\n89\t    gpu: \"cuda:2 (TaxEI-25%), cuda:3 (Random-25%), 各 ~110min\"\n90\t    depends_on: [\"p1-ablation-datagen\"]\n91\t    status: \"planned\"\n92\t    supports_claim: [\"Claim 1\", \"Claim 2\"]\n93\t\n94\t  - id: \"p1-ablation-eval\"\n95\t    name: \"Injection Ratio Ablation Eval (4 组新 + 2 组复用)\"\n96\t    priority: P1\n97\t    category: \"ablation\"\n98\t    hypothesis: \"低注入比例 (10%/25%) 下 TaxEI/Random 性能接近或优于 Vanilla (65.3%)\"\n99\t    method: |\n100\t      Clean eval (--no_inject) 对 4 个新 checkpoint:\n101\t      - TaxEI-10%, Random-10%, TaxEI-25%, Random-25%\n102\t      50% 复用已有 v4 seed=42 结果: TaxEI 61.7%, Random 66.0%\n103\t    data: \"ALFWorld valid_unseen 47 tasks\"\n104\t    gpu: \"4 卡并行, 各 ~25min\"\n105\t    depends_on: [\"p1-ablation-train-10pct\", \"p1-ablation-train-25pct\"]\n106\t    status: \"planned\"\n107\t    supports_claim: [\"Claim 1\", \"Claim 2\"]\n108\t\n109\t  - id: \"p1-training-dynamics\"\n110\t    name: \"Training Dynamics 分析 (Loss 曲线)\"\n111\t    priority: P1\n112\t    category: \"analysis\"\n113\t    hypothesis: \"注入样本的 training loss 系统性高于 clean 样本，且随 epoch 不收敛，说明模型无法有效学习注入 pattern\"\n114\t    method: |\n115\t      从现有 logging.jsonl 提取:\n116\t      1. 逐 step loss 曲线 (Vanilla vs TaxEI vs Random)\n117\t      2. 如可区分 clean/injected batch: 分别画 loss 子曲线\n118\t      3. 方差随 epoch 的变化趋势\n119\t      不需要新训练——从已有 v4 seed=42 的 logging.jsonl 提取。\n120\t    data: \"checkpoints/mini_*_sft_v4/*/logging.jsonl\"\n121\t    gpu: \"无 (CPU 分析 + matplotlib)\"\n122\t    status: \"planned\"\n123\t    supports_claim: [\"Claim 3\"]\n124\t\n125\t  # ============================================================\n126\t  # P2: 显著增强论文\n127\t  # ============================================================\n128\t\n129\t  - id: \"p2-webshop\"\n130\t    name: \"第二环境验证 (WebShop)\"\n131\t    priority: P2\n132\t    category: \"environment\"\n133\t    hypothesis: \"如果 error injection 在 WebShop 同样失败，boundary condition claim 更强；如果成功，则发现 ALFWorld 特异性\"\n134\t    method: |\n135\t      需要:\n136\t      1. WebShop 环境部署 + trajectory collection pipeline\n137\t      2. Error taxonomy 适配 (WebShop 是 web 购物, 不同 action space)\n138\t      3. TaxEI/Vanilla/Random 三组 SFT + eval\n139\t      工程量大 (~3-5 天), 但对 Claim 6 支撑力极强。\n140\t      注: EEF (arXiv 2504.13145) 已在 WebShop 上做过类似实验, 需要差异化。\n141\t    data: \"WebShop dataset (需要新采集)\"\n142\t    gpu: \"4 卡, 预计 2-3 天 (含 pipeline 开发)\"\n143\t    status: \"planned\"\n144\t    supports_claim: [\"Claim 6\"]\n145\t\n146\t  - id: \"p2-failure-analysis\"\n147\t    name: \"定性 Failure 分析\"\n148\t    priority: P2\n149\t    category: \"analysis\"\n150\t    hypothesis: \"TaxEI failure cases 呈现特定 pattern: 注入训练导致模型在复杂任务中产生 incoherent plans 而非简单 wrong actions\"\n151\t    method: |\n152\t      从 v4 TaxEI seed=42 eval 结果中:\n153\t      1. 收集 TaxEI 失败但 Vanilla 成功的 cases (约 5-8 个)\n154\t      2. 收集 TaxEI 失败且 Vanilla 也失败的 cases\n155\t      3. 分析失败模式: action incoherence vs wrong object vs wrong location vs timeout\n156\t      4. 与 Vanilla failure cases 对比\n157\t      目标: 20+ cases 手动标注。\n158\t    data: \"eval_results/v4_taxei_eval.json + eval trajectory logs\"\n159\t    gpu: \"无 (人工分析)\"\n160\t    status: \"planned\"\n161\t    supports_claim: [\"Claim 1\", \"Claim 4\", \"Claim 6\"]\n162\t\n163\t  # ============================================================\n164\t  # P3: 锦上添花\n165\t  # ============================================================\n166\t\n167\t  - id: \"p3-scale-ablation\"\n168\t    name: \"Scale Ablation (25K/50K trajectories)\"\n169\t    priority: P3\n170\t    category: \"ablation\"\n171\t    hypothesis: \"PALADIN 在 50K+ scale 成功, 可能是规模而非 task structure 决定效果; 如果 scaling 仍然无效则排除此混淆\"\n172\t    method: |\n173\t      需要:\n174\t      1. 额外采集 ~20K-45K GPT-5.2 trajectories (当前只有 501 条)\n175\t      2. 对应的 injection + recovery 数据生成\n176\t      3. 训练 + eval\n177\t      API 成本高 (~$80-400), 时间长 (~2-5 天 trajectory collection)\n178\t    data: \"需新采集 25K/50K trajectories\"\n179\t    gpu: \"4 卡, 训练时间随数据量线性增长\"\n180\t    status: \"planned\"\n181\t    supports_claim: [\"Claim 6\"]\n182\t\n183\t  - id: \"p3-fewshot-recovery\"\n184\t    name: \"Few-shot Recovery (In-context, 非 SFT)\"\n185\t    priority: P3\n186\t    category: \"analysis\"\n187\t    hypothesis: \"如果 in-context recovery examples 能提升性能, 说明问题不在 knowledge 而在 SFT training signal corruption\"\n188\t    method: |\n189\t      在 eval 时在 prompt 中加入 2-3 个 recovery 示例 (从训练数据采样):\n190\t      - Vanilla + few-shot recovery examples\n191\t      - 对比 Vanilla (无 few-shot) 和 TaxEI SFT\n192\t      不需要新训练, 只修改 eval 的 prompt template。\n193\t    data: \"ALFWorld valid_unseen 47 tasks + recovery exemplars from training data\"\n194\t    gpu: \"1 卡, ~30min\"\n195\t    status: \"planned\"\n196\t    supports_claim: [\"Claim 4\", \"Claim 6\"]\n197\t\n198\t  - id: \"p3-per-operator-deep\"\n199\t    name: \"Per-operator Recovery Deep Dive (多 seed)\"\n200\t    priority: P3\n201\t    category: \"multi-seed\"\n202\t    hypothesis: \"C4 observation_masking 上 TaxEI 的 +9.1pp 优势是真实效应还是 seed 噪声\"\n203\t    method: |\n204\t      对 seed=0, seed=123 的 checkpoints 也跑 recovery eval (injected_eval.py),\n205\t      得到 3-seed per-operator recovery rates, 检验 C4 优势是否跨 seed 稳定。\n206\t    data: \"ALFWorld valid_unseen 47 tasks × 3 seeds × 3 methods\"\n207\t    gpu: \"1 卡/run, ~30min/run, 总计 6 runs (TaxEI/Random seed=0,123 + Vanilla seed=0,123)\"\n208\t    depends_on: [\"p1-multiseed-train\"]\n209\t    status: \"planned\"\n210\t    supports_claim: [\"Claim 4\"]\n211\t\n212\t# ============================================================\n213\t# GPU 排班计划 (autodl-5090, cuda:0-3)\n214\t# ============================================================\n215\t#\n216\t# Phase 1 (当前, ~100min 剩余):\n217\t#   cuda:0: v4-taxei-seed123 训练 (运行中)\n218\t#   cuda:1: v4-random-seed123 训练 (运行中)\n219\t#   cuda:2: 空闲\n220\t#   cuda:3: 空闲\n221\t#\n222\t# Phase 2 (seed=123 训练完成后, ~25min):\n223\t#   cuda:0: p1-multiseed-eval TaxEI seed=123\n224\t#   cuda:1: p1-multiseed-eval Random seed=123\n225\t#   cuda:2: 空闲 (可跑 p1-training-dynamics 分析)\n226\t#   cuda:3: 空闲\n227\t#\n228\t# Phase 3 (数据生成, ~30min, CPU):\n229\t#   p1-ablation-datagen: 生成 10%/25% fixed-size 数据集\n230\t#   p1-3seed-stats: 3-seed 统计分析\n231\t#\n232\t# Phase 4 (ablation 训练, ~110min):\n233\t#   cuda:0: TaxEI-10%\n234\t#   cuda:1: Random-10%\n235\t#   cuda:2: TaxEI-25%\n236\t#   cuda:3: Random-25%\n237\t#\n238\t# Phase 5 (ablation eval, ~25min):\n239\t#   cuda:0-3: 4 组 ablation eval 并行\n240\t#\n241\t# 总预计时间: ~5-6 小时 (P1 全部完成)\n242\t"}]},"parent_tool_use_id":null,"session_id":"d06f5680-6689-4967-a196-427856276f08","uuid":"9c140e72-4596-4e52-8d7c-3d38fc9e0dab","timestamp":"2026-05-15T02:14:08.394Z","tool_use_result":{"type":"text","file":{"filePath":"/home/ubuntu/.agent-ml-research-idea_gen_0514_2/projects/tax_error_inject_agent/artifacts/_project/intermediate/experiment_plan.yaml","content":"# experiment_plan.yaml — tax_error_inject_agent\n# 基于 paper_framing.md 的 Supplementary Experiments\n# 生成时间: 2026-05-14\n\n# ==================== 已完成基线 ====================\n# vanilla-react-baseline: 42.6% (Qwen3-8B zero-shot)\n# v4 Vanilla SFT: 65.3% ± 3.2pp (seeds 42/0/123)\n# v4 TaxEI SFT: 54.3% ± 10.5pp (seeds 42/0, seed=123 训练中)\n# v4 Random SFT: 60.7% ± 7.6pp (seeds 42/0, seed=123 训练中)\n# Recovery eval (seed=42): Vanilla 61.7%, TaxEI 59.6%, Random 63.8%\n# Detection rate: 0% across all methods\n\nexperiments:\n  # ============================================================\n  # P1: 投稿前必须完成\n  # ============================================================\n\n  - id: \"p1-multiseed-train\"\n    name: \"Multi-seed 补齐训练 (TaxEI/Random seed=123)\"\n    priority: P1\n    category: \"multi-seed\"\n    hypothesis: \"补齐第 3 个 seed，使 TaxEI/Random 达到与 Vanilla 相同的 3-seed 覆盖，获得可靠的均值和方差估计\"\n    method: \"v4 同源数据 (9,029 samples)，LoRA rank=16, 3 epochs, lr=1e-4, seed=123。与 seed=42/0 完全相同的超参。\"\n    data: \"sft_taxei_v4.jsonl (9,029), sft_random_v4.jsonl (9,029)\"\n    gpu: \"cuda:0 (TaxEI), cuda:1 (Random), 各 ~110min\"\n    status: \"running\"\n    registry_id: \"v4-taxei-seed123, v4-random-seed123\"\n    supports_claim: [\"Claim 1\", \"Claim 2\", \"Claim 3\"]\n\n  - id: \"p1-multiseed-eval\"\n    name: \"Multi-seed seed=123 Clean Eval\"\n    priority: P1\n    category: \"multi-seed\"\n    hypothesis: \"seed=123 的 clean eval 结果应与 seed=42/0 方向一致 (TaxEI ≤ Vanilla)\"\n    method: \"recovery.py --no_inject，47 tasks (valid_unseen)，对 seed=123 checkpoints 跑 clean eval\"\n    data: \"ALFWorld valid_unseen 47 tasks\"\n    gpu: \"cuda:0 + cuda:1, 各 ~25min\"\n    depends_on: [\"p1-multiseed-train\"]\n    status: \"planned\"\n    supports_claim: [\"Claim 1\", \"Claim 2\", \"Claim 3\"]\n\n  - id: \"p1-3seed-stats\"\n    name: \"3-seed 统计更新\"\n    priority: P1\n    category: \"analysis\"\n    hypothesis: \"3-seed 结果将提高统计功效，使 TaxEI vs Vanilla 的 p 值更可靠\"\n    method: \"multiseed_stats.py: 更新 paired permutation test, bootstrap CI, 方差比较。3 seeds × 3 methods。\"\n    data: \"所有 3-seed eval 结果 JSON\"\n    gpu: \"无 (CPU 分析)\"\n    depends_on: [\"p1-multiseed-eval\"]\n    status: \"planned\"\n    supports_claim: [\"Claim 1\", \"Claim 2\", \"Claim 3\"]\n\n  - id: \"p1-ablation-datagen\"\n    name: \"Injection Ratio Ablation 数据生成\"\n    priority: P1\n    category: \"ablation\"\n    hypothesis: \"固定总数据量 ~9K samples，变化注入比例 (10%/25%/50%)，如果低比例缓解退化则支持 'noise overwhelms signal' 假设\"\n    method: |\n      Fixed-size 方案: 总量固定 ~9,029 samples\n      - 10% injection: ~903 injected + ~8,126 clean\n      - 25% injection: ~2,257 injected + ~6,772 clean\n      - 50% injection: 已有 (v4 数据, 4,671 injected + 4,358 clean)\n      从现有 4,671 条 injected_variants 中随机采样，TaxEI/Random 各自格式化。\n    data: \"data/mini_pipeline_v4/injected_variants + clean trajectories\"\n    gpu: \"无 (CPU 数据处理)\"\n    status: \"planned\"\n    supports_claim: [\"Claim 1\", \"Claim 2\"]\n\n  - id: \"p1-ablation-train-10pct\"\n    name: \"Injection Ratio 10% 训练 (TaxEI + Random)\"\n    priority: P1\n    category: \"ablation\"\n    hypothesis: \"10% 注入比例下 TaxEI/Random 退化幅度显著小于 50%\"\n    method: \"与 v4 相同超参 (LoRA rank=16, 3 epochs, lr=1e-4, seed=42), 仅数据不同\"\n    data: \"~9,029 samples (10% injection)\"\n    gpu: \"cuda:0 (TaxEI-10%), cuda:1 (Random-10%), 各 ~110min\"\n    depends_on: [\"p1-ablation-datagen\"]\n    status: \"planned\"\n    supports_claim: [\"Claim 1\", \"Claim 2\"]\n\n  - id: \"p1-ablation-train-25pct\"\n    name: \"Injection Ratio 25% 训练 (TaxEI + Random)\"\n    priority: P1\n    category: \"ablation\"\n    hypothesis: \"25% 注入比例是 noise vs signal 的转折点\"\n    method: \"与 v4 相同超参, 仅数据不同\"\n    data: \"~9,029 samples (25% injection)\"\n    gpu: \"cuda:2 (TaxEI-25%), cuda:3 (Random-25%), 各 ~110min\"\n    depends_on: [\"p1-ablation-datagen\"]\n    status: \"planned\"\n    supports_claim: [\"Claim 1\", \"Claim 2\"]\n\n  - id: \"p1-ablation-eval\"\n    name: \"Injection Ratio Ablation Eval (4 组新 + 2 组复用)\"\n    priority: P1\n    category: \"ablation\"\n    hypothesis: \"低注入比例 (10%/25%) 下 TaxEI/Random 性能接近或优于 Vanilla (65.3%)\"\n    method: |\n      Clean eval (--no_inject) 对 4 个新 checkpoint:\n      - TaxEI-10%, Random-10%, TaxEI-25%, Random-25%\n      50% 复用已有 v4 seed=42 结果: TaxEI 61.7%, Random 66.0%\n    data: \"ALFWorld valid_unseen 47 tasks\"\n    gpu: \"4 卡并行, 各 ~25min\"\n    depends_on: [\"p1-ablation-train-10pct\", \"p1-ablation-train-25pct\"]\n    status: \"planned\"\n    supports_claim: [\"Claim 1\", \"Claim 2\"]\n\n  - id: \"p1-training-dynamics\"\n    name: \"Training Dynamics 分析 (Loss 曲线)\"\n    priority: P1\n    category: \"analysis\"\n    hypothesis: \"注入样本的 training loss 系统性高于 clean 样本，且随 epoch 不收敛，说明模型无法有效学习注入 pattern\"\n    method: |\n      从现有 logging.jsonl 提取:\n      1. 逐 step loss 曲线 (Vanilla vs TaxEI vs Random)\n      2. 如可区分 clean/injected batch: 分别画 loss 子曲线\n      3. 方差随 epoch 的变化趋势\n      不需要新训练——从已有 v4 seed=42 的 logging.jsonl 提取。\n    data: \"checkpoints/mini_*_sft_v4/*/logging.jsonl\"\n    gpu: \"无 (CPU 分析 + matplotlib)\"\n    status: \"planned\"\n    supports_claim: [\"Claim 3\"]\n\n  # ============================================================\n  # P2: 显著增强论文\n  # ============================================================\n\n  - id: \"p2-webshop\"\n    name: \"第二环境验证 (WebShop)\"\n    priority: P2\n    category: \"environment\"\n    hypothesis: \"如果 error injection 在 WebShop 同样失败，boundary condition claim 更强；如果成功，则发现 ALFWorld 特异性\"\n    method: |\n      需要:\n      1. WebShop 环境部署 + trajectory collection pipeline\n      2. Error taxonomy 适配 (WebShop 是 web 购物, 不同 action space)\n      3. TaxEI/Vanilla/Random 三组 SFT + eval\n      工程量大 (~3-5 天), 但对 Claim 6 支撑力极强。\n      注: EEF (arXiv 2504.13145) 已在 WebShop 上做过类似实验, 需要差异化。\n    data: \"WebShop dataset (需要新采集)\"\n    gpu: \"4 卡, 预计 2-3 天 (含 pipeline 开发)\"\n    status: \"planned\"\n    supports_claim: [\"Claim 6\"]\n\n  - id: \"p2-failure-analysis\"\n    name: \"定性 Failure 分析\"\n    priority: P2\n    category: \"analysis\"\n    hypothesis: \"TaxEI failure cases 呈现特定 pattern: 注入训练导致模型在复杂任务中产生 incoherent plans 而非简单 wrong actions\"\n    method: |\n      从 v4 TaxEI seed=42 eval 结果中:\n      1. 收集 TaxEI 失败但 Vanilla 成功的 cases (约 5-8 个)\n      2. 收集 TaxEI 失败且 Vanilla 也失败的 cases\n      3. 分析失败模式: action incoherence vs wrong object vs wrong location vs timeout\n      4. 与 Vanilla failure cases 对比\n      目标: 20+ cases 手动标注。\n    data: \"eval_results/v4_taxei_eval.json + eval trajectory logs\"\n    gpu: \"无 (人工分析)\"\n    status: \"planned\"\n    supports_claim: [\"Claim 1\", \"Claim 4\", \"Claim 6\"]\n\n  # ============================================================\n  # P3: 锦上添花\n  # ============================================================\n\n  - id: \"p3-scale-ablation\"\n    name: \"Scale Ablation (25K/50K trajectories)\"\n    priority: P3\n    category: \"ablation\"\n    hypothesis: \"PALADIN 在 50K+ scale 成功, 可能是规模而非 task structure 决定效果; 如果 scaling 仍然无效则排除此混淆\"\n    method: |\n      需要:\n      1. 额外采集 ~20K-45K GPT-5.2 trajectories (当前只有 501 条)\n      2. 对应的 injection + recovery 数据生成\n      3. 训练 + eval\n      API 成本高 (~$80-400), 时间长 (~2-5 天 trajectory collection)\n    data: \"需新采集 25K/50K trajectories\"\n    gpu: \"4 卡, 训练时间随数据量线性增长\"\n    status: \"planned\"\n    supports_claim: [\"Claim 6\"]\n\n  - id: \"p3-fewshot-recovery\"\n    name: \"Few-shot Recovery (In-context, 非 SFT)\"\n    priority: P3\n    category: \"analysis\"\n    hypothesis: \"如果 in-context recovery examples 能提升性能, 说明问题不在 knowledge 而在 SFT training signal corruption\"\n    method: |\n      在 eval 时在 prompt 中加入 2-3 个 recovery 示例 (从训练数据采样):\n      - Vanilla + few-shot recovery examples\n      - 对比 Vanilla (无 few-shot) 和 TaxEI SFT\n      不需要新训练, 只修改 eval 的 prompt template。\n    data: \"ALFWorld valid_unseen 47 tasks + recovery exemplars from training data\"\n    gpu: \"1 卡, ~30min\"\n    status: \"planned\"\n    supports_claim: [\"Claim 4\", \"Claim 6\"]\n\n  - id: \"p3-per-operator-deep\"\n    name: \"Per-operator Recovery Deep Dive (多 seed)\"\n    priority: P3\n    category: \"multi-seed\"\n    hypothesis: \"C4 observation_masking 上 TaxEI 的 +9.1pp 优势是真实效应还是 seed 噪声\"\n    method: |\n      对 seed=0, seed=123 的 checkpoints 也跑 recovery eval (injected_eval.py),\n      得到 3-seed per-operator recovery rates, 检验 C4 优势是否跨 seed 稳定。\n    data: \"ALFWorld valid_unseen 47 tasks × 3 seeds × 3 methods\"\n    gpu: \"1 卡/run, ~30min/run, 总计 6 runs (TaxEI/Random seed=0,123 + Vanilla seed=0,123)\"\n    depends_on: [\"p1-multiseed-train\"]\n    status: \"planned\"\n    supports_claim: [\"Claim 4\"]\n\n# ============================================================\n# GPU 排班计划 (autodl-5090, cuda:0-3)\n# ============================================================\n#\n# Phase 1 (当前, ~100min 剩余):\n#   cuda:0: v4-taxei-seed123 训练 (运行中)\n#   cuda:1: v4-random-seed123 训练 (运行中)\n#   cuda:2: 空闲\n#   cuda:3: 空闲\n#\n# Phase 2 (seed=123 训练完成后, ~25min):\n#   cuda:0: p1-multiseed-eval TaxEI seed=123\n#   cuda:1: p1-multiseed-eval Random seed=123\n#   cuda:2: 空闲 (可跑 p1-training-dynamics 分析)\n#   cuda:3: 空闲\n#\n# Phase 3 (数据生成, ~30min, CPU):\n#   p1-ablation-datagen: 生成 10%/25% fixed-size 数据集\n#   p1-3seed-stats: 3-seed 统计分析\n#\n# Phase 4 (ablation 训练, ~110min):\n#   cuda:0: TaxEI-10%\n#   cuda:1: Random-10%\n#   cuda:2: TaxEI-25%\n#   cuda:3: Random-25%\n#\n# Phase 5 (ablation eval, ~25min):\n#   cuda:0-3: 4 组 ablation eval 并行\n#\n# 总预计时间: ~5-6 小时 (P1 全部完成)\n","numLines":242,"startLine":1,"totalLines":242}}}
