{"type":"assistant","message":{"model":"claude-opus-4-6","id":"msg_01EG6doGyTxXr8CWjmC1Wf7X","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_019mJimLcyXjSjuKhW2FZncn","name":"mcp__agent-ml-research__read_project_file","input":{"project":"tax_error_inject_agent","file":"literature_map.yaml","max_chars":0},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":3,"cache_creation_input_tokens":1270,"cache_read_input_tokens":15256,"cache_creation":{"ephemeral_5m_input_tokens":1270,"ephemeral_1h_input_tokens":0},"output_tokens":45,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":"toolu_012ubrrVpxLRhm1bwpL8HYe2","session_id":"3dbddd0c-fe11-423e-bc66-5161ab0e513e","uuid":"107957ce-9da3-4204-baf5-65d44c4c7e91"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019mJimLcyXjSjuKhW2FZncn","type":"tool_result","content":"{\"result\":\"{\\\"success\\\": true, \\\"data\\\": {\\\"path\\\": \\\"/home/ubuntu/.agent-ml-research-idea_gen_0514_2/projects/tax_error_inject_agent/literature_map.yaml\\\", \\\"content\\\": \\\"# Literature Map: Dose-Response / Threshold Effects in Data Augmentation\\\\n# Updated: 2026-05-15\\\\n\\\\nentries:\\\\n  # === Category: dose-response / threshold ===\\\\n\\\\n  - id: rolnick2017robust\\\\n    title: \\\\\\\"Deep Learning is Robust to Massive Label Noise\\\\\\\"\\\\n    authors: \\\\\\\"Rolnick, Veit, Belongie, Shavit\\\\\\\"\\\\n    year: 2017\\\\n    venue: arXiv 1705.10694\\\\n    category: dose-response\\\\n    role: background\\\\n    key_finding: \\\\\\\"DNNs maintain >90% accuracy on MNIST even when correct labels are diluted 100:1, as long as correct label remains most likely by a small margin.\\\\\\\"\\\\n    relevance: \\\\\\\"Contrasts with our finding: image classification is robust to extreme noise, while embodied planning shows sharp degradation at 25%. Task complexity mediates noise tolerance.\\\\\\\"\\\\n\\\\n  - id: yuan2024early_stopping\\\\n    title: \\\\\\\"Early Stopping Against Label Noise Without Validation Data\\\\\\\"\\\\n    authors: \\\\\\\"Yuan, Feng, Liu\\\\\\\"\\\\n    year: 2024\\\\n    venue: ICLR 2024\\\\n    category: dose-response\\\\n    role: background\\\\n    key_finding: \\\\\\\"Identifies phase transition where DNNs shift from fitting clean to fitting mislabeled examples. Proposes Label Wave to detect this transition during training.\\\\\\\"\\\\n    relevance: \\\\\\\"Supports existence of phase transition in learning dynamics. Our 10-25% threshold may correspond to such a transition point in the SFT regime.\\\\\\\"\\\\n\\\\n  - id: dohmatob2025collapse\\\\n    title: \\\\\\\"Strong Model Collapse\\\\\\\"\\\\n    authors: \\\\\\\"Dohmatob, Feng, Subramonian, Kempe\\\\\\\"\\\\n    year: 2025\\\\n    venue: ICLR 2025\\\\n    category: threshold\\\\n    role: background\\\\n    key_finding: \\\\\\\"Even 0.1% synthetic data can cause model collapse in supervised regression. Past interpolation threshold, larger models become more robust (double-descent).\\\\\\\"\\\\n    relevance: \\\\\\\"Demonstrates extreme sensitivity to data quality in certain regimes. Our 10-25% threshold is analogous—small quality shifts cause nonlinear degradation.\\\\\\\"\\\\n\\\\n  - id: beyond_clean_data2024\\\\n    title: \\\\\\\"Beyond Clean Data: Exploring the Effects of Label Noise on Object Detection Performance\\\\\\\"\\\\n    authors: \\\\\\\"Freire, de S. Silva, de Andrade, Fernandes\\\\\\\"\\\\n    year: 2024\\\\n    venue: Knowledge-Based Systems\\\\n    category: dose-response\\\\n    role: background\\\\n    key_finding: \\\\\\\"Systematically varies noise levels in training and validation for object detection, mapping convergence limits and degradation thresholds.\\\\\\\"\\\\n    relevance: \\\\\\\"Methodologically similar—varies noise proportion to find degradation curves. Shows task-specific threshold behavior.\\\\\\\"\\\\n\\\\n  # === Category: error-injection / failure augmentation ===\\\\n\\\\n  - id: wang2024learning_from_failure\\\\n    title: \\\\\\\"Learning From Failure: Integrating Negative Examples when Fine-tuning Large Language Models as Agents\\\\\\\"\\\\n    authors: \\\\\\\"Wang, Li, Han, Zhang, Baldwin\\\\\\\"\\\\n    year: 2024\\\\n    venue: arXiv 2402.11651\\\\n    category: error-injection\\\\n    role: evaluation\\\\n    key_finding: \\\\\\\"Failed trajectories provide valuable signal for LLM agents via contrastive learning. Negative examples improve math, QA, strategic tasks when properly structured.\\\\\\\"\\\\n    relevance: \\\\\\\"Directly related—injects negative trajectories into agent SFT. Key difference: they use contrastive framing, not raw mixing. Our work shows raw mixing has narrow safe window.\\\\\\\"\\\\n\\\\n  - id: song2024eto\\\\n    title: \\\\\\\"Trial and Error: Exploration-Based Trajectory Optimization for LLM Agents\\\\\\\"\\\\n    authors: \\\\\\\"Song, Yin, Yue, Huang, Li, Lin\\\\\\\"\\\\n    year: 2024\\\\n    venue: ACL 2024\\\\n    category: error-injection\\\\n    role: evaluation\\\\n    key_finding: \\\\\\\"Iteratively collects failure trajectories, uses DPO-style contrastive learning on success-failure pairs. +8% WebShop, +9.5% ScienceWorld vs SFT.\\\\\\\"\\\\n    relevance: \\\\\\\"Uses failure trajectories via preference optimization (DPO), not direct SFT mixing. Avoids our threshold problem by never training directly on failures.\\\\\\\"\\\\n\\\\n  - id: paladin2025\\\\n    title: \\\\\\\"PALADIN: Self-Correcting Language Model Agents to Cure Tool-Failure Cases\\\\\\\"\\\\n    authors: \\\\\\\"Vuddanti, Shah et al.\\\\\\\"\\\\n    year: 2025\\\\n    venue: arXiv 2509.25238\\\\n    category: error-injection\\\\n    role: evaluation\\\\n    key_finding: \\\\\\\"Trains on 50K+ recovery-annotated failure trajectories via LoRA. +57pp recovery rate vs vanilla (32.76%→89.68%), +13.6pp vs CRITIC baseline. Taxonomy of 7 error classes. Includes inference-time retrieval.\\\\\\\"\\\\n    relevance: \\\\\\\"Most similar to our approach (taxonomy-guided error injection). Key difference: they pair failures with recovery demos; we inject standalone error trajectories.\\\\\\\"\\\\n\\\\n  - id: agentHER2025\\\\n    title: \\\\\\\"AgentHER: Hindsight Experience Replay for LLM Agent Trajectory Relabeling\\\\\\\"\\\\n    authors: \\\\\\\"Ding\\\\\\\"\\\\n    year: 2025\\\\n    venue: arXiv 2603.21357\\\\n    category: error-injection\\\\n    role: evaluation\\\\n    key_finding: \\\\\\\"Converts failed trajectories to valid training data by relabeling—failure for task A becomes success for task B.\\\\\\\"\\\\n    relevance: \\\\\\\"Avoids noise problem by redefining failure as success for different goals. Contrasts with our direct injection approach.\\\\\\\"\\\\n\\\\n  # === Category: data-mixing ===\\\\n\\\\n  - id: dong2024composition\\\\n    title: \\\\\\\"How Abilities in Large Language Models are Affected by Supervised Fine-tuning Data Composition\\\\\\\"\\\\n    authors: \\\\\\\"Dong, Yuan et al.\\\\\\\"\\\\n    year: 2024\\\\n    venue: ACL 2024\\\\n    category: data-mixing\\\\n    role: background\\\\n    key_finding: \\\\\\\"Data amount per domain matters more than ratio. Low-data mixing enables cross-domain transfer; high-data mixing causes ability conflicts.\\\\\\\"\\\\n    relevance: \\\\\\\"Documents ability-conflict at high data amounts—analogous to our threshold. Ratio secondary to amount suggests our threshold may be absolute-count driven.\\\\\\\"\\\\n\\\\n  - id: ye2025mixing_laws\\\\n    title: \\\\\\\"Data Mixing Laws: Optimizing Data Mixtures by Predicting Language Modeling Performance\\\\\\\"\\\\n    authors: \\\\\\\"Ye et al.\\\\\\\"\\\\n    year: 2025\\\\n    venue: ICLR 2025\\\\n    category: data-mixing\\\\n    role: background\\\\n    key_finding: \\\\\\\"Discovers quantitative scaling laws L=f(r) for mixture proportions. Accurately predicts critical proportion avoiding catastrophic forgetting.\\\\\\\"\\\\n    relevance: \\\\\\\"Their 'critical proportion for catastrophic forgetting' is conceptually identical to our threshold—both mark a phase transition in mixing.\\\\\\\"\\\\n\\\\n  - id: li2025mixing_optimization\\\\n    title: \\\\\\\"Data Mixing Optimization for Supervised Fine-Tuning of Large Language Models\\\\\\\"\\\\n    authors: \\\\\\\"Li et al.\\\\\\\"\\\\n    year: 2025\\\\n    venue: ICML 2025\\\\n    category: data-mixing\\\\n    role: background\\\\n    key_finding: \\\\\\\"SFT mixing as optimization with scaling-law parameterization. Optimal weights depend on model size and data scale.\\\\\\\"\\\\n    relevance: \\\\\\\"Optimal mixing is model-size dependent—our 7B model may have different threshold than larger models. Finding is scale-specific.\\\\\\\"\\\\n\\\\n  - id: seddik2024synthetic_bound\\\\n    title: \\\\\\\"How Bad is Training on Synthetic Data? A Statistical Analysis of Language Model Collapse\\\\\\\"\\\\n    authors: \\\\\\\"Seddik et al.\\\\\\\"\\\\n    year: 2024\\\\n    venue: arXiv 2404.05090\\\\n    category: data-mixing\\\\n    role: background\\\\n    key_finding: \\\\\\\"Theoretical upper bounds on low-quality data proportion before collapse. Real data proportion must remain high.\\\\\\\"\\\\n    relevance: \\\\\\\"Theoretical grounding for hard thresholds in quality mixing. Our empirical 10-25% window is consistent with their predictions.\\\\\\\"\\\\n\\\\n  # === Category: curriculum / quality threshold ===\\\\n\\\\n  - id: curriculum_robust2021\\\\n    title: \\\\\\\"Robust Curriculum Learning: from Clean Label Detection to Noisy Label Self-Correction\\\\\\\"\\\\n    authors: \\\\\\\"Zhou, Wang, Bilmes\\\\\\\"\\\\n    year: 2021\\\\n    venue: ICLR 2021\\\\n    category: curriculum\\\\n    role: background\\\\n    key_finding: \\\\\\\"Networks learn simple patterns first, then overfit noisy labels. Loss-based curriculum selection is unstable; errors accumulate multiplicatively.\\\\\\\"\\\\n    relevance: \\\\\\\"Explains WHY threshold exists: once noisy proportion exceeds implicit curriculum capacity, errors accumulate. Our 25% may exceed model's capacity.\\\\\\\"\\\\n\\\\n  - id: agentprm2025\\\\n    title: \\\\\\\"Process Reward Models for LLM Agents: Practical Framework and Directions\\\\\\\"\\\\n    authors: \\\\\\\"Choudhury\\\\\\\"\\\\n    year: 2025\\\\n    venue: arXiv 2502.10325\\\\n    category: curriculum\\\\n    role: evaluation\\\\n    key_finding: \\\\\\\"Best-of-N with process reward model achieves 91.0% on ALFWorld (N=16, base policy 88.1%). Shows reward-guided search outperforms SFT alone.\\\\\\\"\\\\n    relevance: \\\\\\\"ALFWorld SOTA reference. Our 65.3% SFT-only baseline is reasonable given AgentPRM uses test-time search.\\\\\\\"\\\\n\\\\n  - id: wkm2024alfworld\\\\n    title: \\\\\\\"Agent Planning with World Knowledge Model\\\\\\\"\\\\n    authors: \\\\\\\"Qiao, Fang, Zhang, Zhu, Chen et al.\\\\\\\"\\\\n    year: 2024\\\\n    venue: NeurIPS 2024\\\\n    category: curriculum\\\\n    role: evaluation\\\\n    key_finding: \\\\\\\"World knowledge models reduce hallucinatory actions in ALFWorld. SFT on expert trajectories prone to overfitting.\\\\\\\"\\\\n    relevance: \\\\\\\"ALFWorld baseline showing SFT quality sensitivity. Hallucination increase from poor training data parallels our error-injection degradation.\\\\\\\"\\\\n\\\\n  # === Category: training-dynamics / memorization ===\\\\n\\\\n  - id: arpit2017memorization\\\\n    title: \\\\\\\"A Closer Look at Memorization in Deep Networks\\\\\\\"\\\\n    authors: \\\\\\\"Arpit, Jastrzębski, Ballas, Krueger, Bengio, Kanwal, Maharaj, Fischer, Courville, Bengio, Lacoste-Julien\\\\\\\"\\\\n    year: 2017\\\\n    venue: ICML 2017\\\\n    category: training-dynamics\\\\n    role: background\\\\n    key_finding: \\\\\\\"DNNs first learn clean patterns (early learning phase), then memorize noise. Training loss/accuracy improve on noisy data but generalization degrades. Dataset-independent capacity concepts are insufficient.\\\\\\\"\\\\n    relevance: \\\\\\\"Directly explains our '50% injection → lowest train loss but worst eval' paradox. Higher injection = more noisy samples to memorize, better train metrics but worse generalization.\\\\\\\"\\\\n\\\\n  - id: liu2020early_learning_reg\\\\n    title: \\\\\\\"Early-Learning Regularization Prevents Memorization of Noisy Labels\\\\\\\"\\\\n    authors: \\\\\\\"Liu, Niles-Weed, Razavian, Fernandez-Granda\\\\\\\"\\\\n    year: 2020\\\\n    venue: NeurIPS 2020\\\\n    category: training-dynamics\\\\n    role: background\\\\n    key_finding: \\\\\\\"Formalizes early learning phenomenon: models predict true labels for mislabeled examples early in training, then memorize wrong labels. ELR regularization exploits this window.\\\\\\\"\\\\n    relevance: \\\\\\\"Our error-injected samples may be correctly handled early in training but memorized later, degrading clean-data generalization. Explains why more epochs could worsen the gap.\\\\\\\"\\\\n\\\\n  - id: zhou2023lima\\\\n    title: \\\\\\\"LIMA: Less Is More for Alignment\\\\\\\"\\\\n    authors: \\\\\\\"Zhou, Liu, Xu, Iyer, Sun, Mao, Ma, Efrat, Yu, Yu, Zhang, Ghosh, Lewis, Zettlemoyer, Levy\\\\\\\"\\\\n    year: 2023\\\\n    venue: NeurIPS 2023\\\\n    category: training-dynamics\\\\n    role: background\\\\n    key_finding: \\\\\\\"Superficial Alignment Hypothesis: LLM knowledge/capability comes from pretraining; SFT only teaches output style/format. Limited SFT data suffices.\\\\\\\"\\\\n    relevance: \\\\\\\"Explains why lower SFT loss ≠ better downstream capability. Error injection improves surface-level fitting (lower loss) but doesn't enhance—and may damage—pretrained planning capability.\\\\\\\"\\\\n\\\\n  - id: luo2023catastrophic_forgetting\\\\n    title: \\\\\\\"An Empirical Study of Catastrophic Forgetting in Large Language Models During Continual Fine-tuning\\\\\\\"\\\\n    authors: \\\\\\\"Luo, Yang, Meng, Li, Zhou, Zhang\\\\\\\"\\\\n    year: 2023\\\\n    venue: arXiv 2308.08747\\\\n    category: training-dynamics\\\\n    role: background\\\\n    key_finding: \\\\\\\"SFT is off-policy learning prone to overfit training distribution and forget pretraining knowledge. Forgetting severity increases with divergence between fine-tuning and pretraining distributions.\\\\\\\"\\\\n    relevance: \\\\\\\"Error injection increases distributional gap from pretraining data, accelerating catastrophic forgetting. 50% injection → maximal divergence → most forgetting of planning capability.\\\\\\\"\\\\n\\\\n  - id: longpre2020augmentation\\\\n    title: \\\\\\\"How Effective is Task-Agnostic Data Augmentation for Pretrained Transformers?\\\\\\\"\\\\n    authors: \\\\\\\"Longpre, Wang, DuBois\\\\\\\"\\\\n    year: 2020\\\\n    venue: Findings of EMNLP 2020\\\\n    category: training-dynamics\\\\n    role: background\\\\n    key_finding: \\\\\\\"Data augmentation provides minimal benefit for pretrained transformers; pretrained representations already capture augmentation diversity. Augmentation can hurt when it introduces distribution shift.\\\\\\\"\\\\n    relevance: \\\\\\\"Pretrained LLMs may already have robust representations; error injection adds noise without new information, explaining why augmentation-style injection fails for embodied planning.\\\\\\\"\\\\n\\\\n  # === Category: training-instability ===\\\\n\\\\n  - id: mccoy2020seeds\\\\n    title: \\\\\\\"BERTs of a feather do not generalize together: Large variability in generalization across models with similar test set performance\\\\\\\"\\\\n    authors: \\\\\\\"McCoy, Min, Linzen\\\\\\\"\\\\n    year: 2020\\\\n    venue: \\\\\\\"BlackboxNLP Workshop at EMNLP 2020\\\\\\\"\\\\n    category: training-instability\\\\n    role: background\\\\n    key_finding: \\\\\\\"Fine-tuning 100 BERT instances on MNLI yields near-identical dev accuracy (83.6-84.8%) but wildly different syntactic generalization (0-66.2% on HANS), demonstrating extreme seed-dependent generalization.\\\\\\\"\\\\n    relevance: \\\\\\\"与我们方差梯度发现的关系：error injection 放大了 McCoy 描述的 seed sensitivity\\\\\\\"\\\\n\\\\n  - id: mosbach2021stability\\\\n    title: \\\\\\\"On the Stability of Fine-tuning BERT: Misconceptions, Explanations, and Strong Baselines\\\\\\\"\\\\n    authors: \\\\\\\"Mosbach, Andriushchenko, Klakow\\\\\\\"\\\\n    year: 2021\\\\n    venue: \\\\\\\"ICLR 2021\\\\\\\"\\\\n    category: training-instability\\\\n    role: background\\\\n    key_finding: \\\\\\\"BERT fine-tuning instability的根因是vanishing gradients导致的优化困难，而非此前假设的catastrophic forgetting或数据集过小。\\\\\\\"\\\\n    relevance: \\\\\\\"fine-tuning 不稳定性的基础文献，我们的 TaxEI 方差梯度扩展了这一发现到 error-augmented agent training\\\\\\\"\\\\n\\\\n  - id: damour2022underspecification\\\\n    title: \\\\\\\"Underspecification Presents Challenges for Credibility in Modern Machine Learning\\\\\\\"\\\\n    authors: \\\\\\\"D'Amour, Heller, Moldovan, Adlam, Alipanahi, Beutel, Chen, Deaton, Eisenstein, Hoffman et al.\\\\\\\"\\\\n    year: 2022\\\\n    venue: \\\\\\\"Journal of Machine Learning Research, Vol. 23, No. 226\\\\\\\"\\\\n    category: training-instability\\\\n    role: background\\\\n    key_finding: \\\\\\\"ML pipeline underspecification导致测试性能相当的模型在部署域行为截然不同，涵盖CV、NLP、医学等多领域实证。\\\\\\\"\\\\n    relevance: \\\\\\\"我们的 3 seeds 中 2 个 match vanilla + 1 个 collapse 是 underspecification 的典型表现\\\\\\\"\\\\n\\\\n  # === Category: alfworld-methods ===\\\\n\\\\n  - id: shridhar2021alfworld\\\\n    title: \\\\\\\"ALFWorld: Aligning Text and Embodied Environments for Interactive Learning\\\\\\\"\\\\n    authors: \\\\\\\"Shridhar, Yuan, Côté, Bisk, Trischler, Hausknecht\\\\\\\"\\\\n    year: 2021\\\\n    venue: \\\\\\\"ICLR 2021\\\\\\\"\\\\n    arxiv: \\\\\\\"2010.03768\\\\\\\"\\\\n    category: alfworld-methods\\\\n    role: evaluation\\\\n    key_finding: \\\\\\\"Aligns TextWorld text-based environment with ALFRED embodied benchmark, enabling abstract policy learning that transfers to visual grounding.\\\\\\\"\\\\n    relevance: \\\\\\\"我们的实验环境；134 tasks across 6 task types benchmark\\\\\\\"\\\\n\\\\n  - id: yao2023react\\\\n    title: \\\\\\\"ReAct: Synergizing Reasoning and Acting in Language Models\\\\\\\"\\\\n    authors: \\\\\\\"Yao, Zhao, Yu, Du, Shafran, Narasimhan, Cao\\\\\\\"\\\\n    year: 2023\\\\n    venue: \\\\\\\"ICLR 2023\\\\\\\"\\\\n    arxiv: \\\\\\\"2210.03629\\\\\\\"\\\\n    category: alfworld-methods\\\\n    role: evaluation\\\\n    key_finding: \\\\\\\"Interleaved reasoning traces and actions enable LLMs to ground decisions, achieving 75% on ALFWorld (single-trial).\\\\\\\"\\\\n    relevance: \\\\\\\"我们使用的 prompting paradigm（ReAct format）\\\\\\\"\\\\n\\\\n  - id: shinn2023reflexion\\\\n    title: \\\\\\\"Reflexion: Language Agents with Verbal Reinforcement Learning\\\\\\\"\\\\n    authors: \\\\\\\"Shinn, Cassano, Berman, Gopinath, Narasimhan, Yao\\\\\\\"\\\\n    year: 2023\\\\n    venue: \\\\\\\"NeurIPS 2023\\\\\\\"\\\\n    arxiv: \\\\\\\"2303.11366\\\\\\\"\\\\n    category: alfworld-methods\\\\n    role: evaluation\\\\n    key_finding: \\\\\\\"Verbal self-reflection in episodic memory achieves 97% on ALFWorld (12 trials, 130/134 tasks solved) without weight updates.\\\\\\\"\\\\n    relevance: \\\\\\\"Inference-time reflection 成功 where training-time injection 失败——对比 key point\\\\\\\"\\\\n\\\\n  - id: kim2025coex\\\\n    title: \\\\\\\"CoEx -- Co-evolving World-model and Exploration\\\\\\\"\\\\n    authors: \\\\\\\"Kim, Hwang\\\\\\\"\\\\n    year: 2025\\\\n    venue: \\\\\\\"Findings of EMNLP 2025\\\\\\\"\\\\n    arxiv: \\\\\\\"2507.22281\\\\\\\"\\\\n    category: alfworld-methods\\\\n    role: evaluation\\\\n    key_finding: \\\\\\\"Hierarchical state abstraction with dynamically updated neurosymbolic world model achieves 93.28% on ALFWorld.\\\\\\\"\\\\n    relevance: \\\\\\\"ALFWorld SOTA 参考；co-evolving world model 对比我们的 static SFT 方法\\\\\\\"\\\\n\\\\n  # === Category: error-injection (补充) ===\\\\n\\\\n  - id: eef2025\\\\n    title: \\\\\\\"Exploring Expert Failures Improves LLM Agent Tuning\\\\\\\"\\\\n    authors: \\\\\\\"Lan, Bai, Cheng, Hsieh, Zhou\\\\\\\"\\\\n    year: 2025\\\\n    venue: \\\\\\\"arXiv 2504.13145\\\\\\\"\\\\n    category: error-injection\\\\n    role: evaluation\\\\n    key_finding: \\\\\\\"从失败 expert trajectories 中提取有益 actions（plans、key actions），用于引导 agent exploration，WebShop SOTA 0.81，SciWorld 81/100。\\\\\\\"\\\\n    relevance: \\\\\\\"从失败中提取正向信号（非注入负信号），成功 on WebShop。与我们的直接注入形成对比——方向相反的 failure utilization。\\\\\\\"\\\\n\\\\n  - id: agentdebug2025\\\\n    title: \\\\\\\"Where LLM Agents Fail and How They can Learn From Failures\\\\\\\"\\\\n    authors: \\\\\\\"Zhu, Liu, Li, Tian et al.\\\\\\\"\\\\n    year: 2025\\\\n    venue: \\\\\\\"arXiv 2509.25370\\\\\\\"\\\\n    category: error-injection\\\\n    role: evaluation\\\\n    key_finding: \\\\\\\"5-dimension AgentErrorTaxonomy（memory, reflection, planning, action, system-level）+ AgentErrorBench 标注数据集 + AgentDebug 纠错框架，跨 ALFWorld/GAIA/WebShop 提升 24% all-correct accuracy。\\\\\\\"\\\\n    relevance: \\\\\\\"ALFWorld 的另一个 error taxonomy（5维 vs 我们的 4 operator）。对比点：不同 taxonomy 设计选择。\\\\\\\"\\\\n\\\\n  # === Category: data-mixing / curriculum (补充) ===\\\\n\\\\n  - id: bengio2009curriculum\\\\n    title: \\\\\\\"Curriculum Learning\\\\\\\"\\\\n    authors: \\\\\\\"Bengio, Louradour, Collobert, Weston\\\\\\\"\\\\n    year: 2009\\\\n    venue: \\\\\\\"ICML 2009\\\\\\\"\\\\n    category: curriculum\\\\n    role: background\\\\n    key_finding: \\\\\\\"按难度递增顺序呈现训练样本可加速收敛并改善非凸优化的局部最优质量；curriculum 本质是一种 continuation method。\\\\\\\"\\\\n    relevance: \\\\\\\"Curriculum learning 中 difficult example proportion 的 threshold 概念与我们的 dose-response 阈值平行——训练数据中困难/噪声样本超过阈值后性能崩溃\\\\\\\"\\\\n\\\\n  - id: madry2018adversarial\\\\n    title: \\\\\\\"Towards Deep Learning Models Resistant to Adversarial Attacks\\\\\\\"\\\\n    authors: \\\\\\\"Madry, Makelov, Schmidt, Tsipras, Vladu\\\\\\\"\\\\n    year: 2018\\\\n    venue: \\\\\\\"ICLR 2018\\\\\\\"\\\\n    category: data-mixing\\\\n    role: background\\\\n    key_finding: \\\\\\\"基于 PGD 的 adversarial training 通过 robust optimization 框架显著提升对抗鲁棒性，但以 clean accuracy 下降为代价。\\\\\\\"\\\\n    relevance: \\\\\\\"Adversarial training 的 accuracy-robustness tradeoff 是 dose-response 型——增加 adversarial perturbation 强度提升鲁棒性但降低 clean accuracy，与我们的 injection ratio vs clean eval tradeoff 结构相似\\\\\\\"\\\\n\\\", \\\"total_chars\\\": 17888, \\\"truncated\\\": false}, \\\"error\\\": null, \\\"metadata\\\": {}}\"}"}]},"parent_tool_use_id":"toolu_012ubrrVpxLRhm1bwpL8HYe2","session_id":"3dbddd0c-fe11-423e-bc66-5161ab0e513e","uuid":"e13a791e-ff29-48d6-bd4d-21acd77213b0","timestamp":"2026-05-16T16:17:01.265Z"}
