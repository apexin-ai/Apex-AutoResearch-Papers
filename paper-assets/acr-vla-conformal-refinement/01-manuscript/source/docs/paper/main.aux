\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Calibrated gating pipeline. $K{=}2$ action samples are drawn from the frozen VLA; their pairwise $L_2$ distance forms a calibrated uncertainty score. When the score falls below $\tau $ (confident step), the argmin-to-centroid sample is output directly. When it exceeds $\tau $ (uncertain step), a lightweight Correction Residual Module (CRM) applies bounded correction ($\|\boldsymbol  {\delta }\|_2 \leq \varepsilon $).}}{2}{figure.1}\protected@file@percent }
\newlabel{fig:pipeline}{{1}{2}{Calibrated gating pipeline. $K{=}2$ action samples are drawn from the frozen VLA; their pairwise $L_2$ distance forms a calibrated uncertainty score. When the score falls below $\tau $ (confident step), the argmin-to-centroid sample is output directly. When it exceeds $\tau $ (uncertain step), a lightweight Correction Residual Module (CRM) applies bounded correction ($\|\boldsymbol {\delta }\|_2 \leq \varepsilon $)}{figure.1}{}}
