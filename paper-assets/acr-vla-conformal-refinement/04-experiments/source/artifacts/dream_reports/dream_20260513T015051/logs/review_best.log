{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WANVQJT7Pqdkm8Qxy8YGyA","type":"tool_result","content":"305:def _ensure_dream_review_director_mcp_config() -> Path:\n310:    `mcp_server.py` --dream-review-director hook strips the normal\n314:        \"dream_review_director\",\n315:        cli_flag=\"--dream-review-director\",\n941:                role = \"dream_review_director\" if _is_dream else \"review_director\"\n948:                role = \"dream_review_director\" if _is_dream else \"review_director\"\n969:            \"dream_review_director\": _ensure_dream_review_director_mcp_config,","is_error":false}]},"parent_tool_use_id":"toolu_01NiRzqjhP8M1n3pL3ukiVdd","session_id":"bdddd11e-d286-40ab-b887-efee4a12ef04","uuid":"cebaaed8-b6c3-4fef-9fe0-5466e430f813","timestamp":"2026-05-13T02:22:42.140Z"}
