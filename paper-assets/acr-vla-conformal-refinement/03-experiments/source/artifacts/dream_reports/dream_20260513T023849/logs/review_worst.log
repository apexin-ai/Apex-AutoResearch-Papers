{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FSGTCTMrhVSx7yW4AAe5mR","type":"tool_result","content":"1\texperiments:\n2\t  # === Completed ===\n3\t  - id: plan_000\n4\t    claim: 1\n5\t    description: \"Motivating experiment: 3D point-reaching, per-DOF vs scalar vs no uncertainty conditioning\"\n6\t    priority: P0\n7\t    gpu_budget_hours: 0.5\n8\t    deps: []\n9\t    registry_id: mvp-point-reaching\n10\t\n11\t  # === Primary Experiments (P0) — headline results ===\n12\t  - id: plan_001\n13\t    claim: 1\n14\t    description: \"ACR-VLA full pipeline on SmolVLA base: CGS + ACI/COC + CRM. Train CRM on LIBERO demos + synthetic augmentation. Evaluate on LIBERO (nominal preservation) + LIBERO-Plus L3-L5 (robustness gain).\"\n15\t    priority: P0\n16\t    gpu_budget_hours: 25\n17\t    deps: []\n18\t\n19\t  - id: plan_002\n20\t    claim: 1\n21\t    description: \"Ablation A3 — CRM without conformal features (observation-conditioned residual only, equivalent to A2C2-style generic residual). MAKE-OR-BREAK for Claim 1.\"\n22\t    priority: P0\n23\t    gpu_budget_hours: 8\n24\t    deps: [plan_001]\n25\t\n26\t  - id: plan_003\n27\t    claim: 1\n28\t    description: \"Ablation A4 — CRM with scalar uncertainty (Euclidean distance like ReconVLA) replacing 45D per-DOF features. Validates per-DOF > scalar.\"\n29\t    priority: P0\n30\t    gpu_budget_hours: 8\n31\t    deps: [plan_001]\n32\t\n33\t  - id: plan_004\n34\t    claim: 3\n35\t    description: \"ACR-VLA stacked on SRPO-finetuned VLA. Train new CRM on SRPO checkpoint + LIBERO demos. Evaluate on LIBERO-Plus. Primary impact argument: orthogonal to training-time optimization.\"\n36\t    priority: P0\n37\t    gpu_budget_hours: 18\n38\t    deps: [plan_001]\n39\t\n40\t  # === Important Experiments (P1) — ablations & analysis ===\n41\t  - id: plan_005\n42\t    claim: 2\n43\t    description: \"COC signal validation: (a) Spearman ρ between episode COC coverage fraction and task success, (b) ACI convergence plot, (c) ellipsoid volume comparison vs static calibration at matched coverage.\"\n44\t    priority: P1\n45\t    gpu_budget_hours: 15\n46\t    deps: [plan_001]\n47\t\n48\t  - id: plan_006\n49\t    claim: 2\n50\t    description: \"Ablation A1 — CRM without ACI (static CGS calibration, no online adaptation). Isolates ACI contribution.\"\n51\t    priority: P1\n52\t    gpu_budget_hours: 8\n53\t    deps: [plan_001]\n54\t\n55\t  - id: plan_007\n56\t    claim: 2\n57\t    description: \"Ablation A2 — ACI without CRM (CGS + COC + sample selection only, extending ReconVLA to multivariate). Isolates CRM contribution.\"\n58\t    priority: P1\n59\t    gpu_budget_hours: 8\n60\t    deps: [plan_001]\n61\t\n62\t  - id: plan_008\n63\t    claim: 1\n64\t    description: \"Per-perturbation-dimension breakdown: ACR-VLA gain across 7 LIBERO-Plus dimensions (camera, noise, robot-state, light, background, layout, language). Hypothesis: largest gains on camera/noise/robot-state.\"\n65\t    priority: P1\n66\t    gpu_budget_hours: 20\n67\t    deps: [plan_001]\n68\t\n69\t  # === Nice-to-have (P2) — bonus experiments ===\n70\t  - id: plan_009\n71\t    claim: 1\n72\t    description: \"Ablation A5 — CGS (joint Mahalanobis) vs per-DOF Bonferroni correction. Validates multivariate CP advantage.\"\n73\t    priority: P2\n74\t    gpu_budget_hours: 5\n75\t    deps: [plan_001]\n76\t\n77\t  - id: plan_010\n78\t    claim: 2\n79\t    description: \"Ablation A6 — COC signal vs episode-level task success for ACI update. Validates self-referential per-step signal.\"\n80\t    priority: P2\n81\t    gpu_budget_hours: 8\n82\t    deps: [plan_005]\n83\t\n84\t  - id: plan_011\n85\t    claim: 1\n86\t    description: \"Ablation A7 — CRM with DiU aleatoric features replacing CGS epistemic features. Also test combined epistemic+aleatoric 52D input. Validates epistemic-vs-aleatoric distinction.\"\n87\t    priority: P2\n88\t    gpu_budget_hours: 10\n89\t    deps: [plan_001]\n90\t\n91\t  - id: plan_012\n92\t    claim: 1\n93\t    description: \"Feature importance analysis: CRM gradient magnitude w.r.t. 45 uncertainty features, broken down by perturbation type. Validates dimension-selective correction mechanism.\"\n94\t    priority: P2\n95\t    gpu_budget_hours: 2\n96\t    deps: [plan_001, plan_008]\n97\t\n98\t  - id: plan_013\n99\t    claim: 1\n100\t    description: \"SnapFlow integration: K=10 × 1-step distilled generation. Test sample diversity preservation and inference speedup.\"\n101\t    priority: P2\n102\t    gpu_budget_hours: 5\n103\t    deps: [plan_001]\n104\t\n105\t# GPU Budget Summary\n106\t# P0: 25 + 8 + 8 + 18 = 59h H100 (+ 0.5h MVP done)\n107\t# P1: 15 + 8 + 8 + 20 = 51h H100\n108\t# P2: 5 + 8 + 10 + 2 + 5 = 30h H100\n109\t# Total: ~140h H100 (within 200h budget, ~60h buffer)\n110\t# On 1x RTX 4090: ~280-420h (2-3x slower), P0 alone ~5-7.5 days\n111\t"}]},"parent_tool_use_id":"toolu_01U6BBV3mx4ktHfYbR5GdLQQ","session_id":"01d718a6-ac11-4c69-ac4b-36f76b2791b4","uuid":"a6ca14b8-19cb-47f1-9a12-005c51f066d8","timestamp":"2026-05-13T03:21:50.722Z"}
