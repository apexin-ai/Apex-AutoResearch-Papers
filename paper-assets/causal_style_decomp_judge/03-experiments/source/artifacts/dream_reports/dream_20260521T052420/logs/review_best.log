{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Y97TMX2uVJFrJW4TAZ5BQo","type":"tool_result","content":"1\tfrom __future__ import annotations\n2\t\"\"\"ATE (Average Treatment Effect) analysis for style bias quantification.\n3\t\n4\tSupports multiple style axes: formality (formal/casual), verbosity (verbose/concise).\n5\tATE = score(pole_a) - score(pole_b), where pole_a is the expected-preferred pole.\n6\t\n7\tInput:  scored.jsonl (with score_original, score_counterfactual, score_double_rewrite)\n8\tOutput: CSV summary + visualizations (ATE bar chart, score violin plot)\n9\tDeps:   scipy, pandas, numpy, matplotlib, seaborn\n10\t\"\"\"\n11\t\n12\timport argparse\n13\timport json\n14\timport os\n15\t\n16\tAXIS_CONFIG = {\n17\t    \"formality\": {\"poles\": (\"formal\", \"casual\"), \"field\": \"original_formality\"},\n18\t    \"verbosity\": {\"poles\": (\"verbose\", \"concise\"), \"field\": \"original_verbosity\"},\n19\t    \"tone\": {\"poles\": (\"assertive\", \"hedging\"), \"field\": \"original_tone\"},\n20\t    \"rate_control\": {\"poles\": (\"original\", \"rewritten\"), \"field\": \"rate_role\"},\n21\t    \"register\": {\"poles\": (\"academic\", \"conversational\"), \"field\": \"original_register\"},\n22\t}\n23\t\n24\t_AXIS = \"formality\"\n25\t\n26\t\n27\tdef load_scored(path: str) -> pd.DataFrame:\n28\t    records = []\n29\t    with open(path) as f:\n30\t        for line in f:\n31\t            if line.strip():\n32\t                records.append(json.loads(line))\n33\t    df = pd.DataFrame(records)\n34\t    # Drop rows with missing scores\n35\t    for col in [\"score_original\", \"score_counterfactual\", \"score_double_rewrite\"]:\n36\t        df = df[df[col].notna()]\n37\t    df[\"score_original\"] = df[\"score_original\"].astype(float)\n38\t    df[\"score_counterfactual\"] = df[\"score_counterfactual\"].astype(float)\n39\t    df[\"score_double_rewrite\"] = df[\"score_double_rewrite\"].astype(float)\n40\t    return df\n41\t\n42\t\n43\tdef compute_ate(df: pd.DataFrame, alpha: float = 0.05) -> dict:\n44\t    \"\"\"ATE as style premium: score(pole_a) - score(pole_b).\"\"\"\n45\t    cfg = AXIS_CONFIG[_AXIS]\n46\t    pole_b = cfg[\"poles\"][1]\n47\t    field = cfg[\"field\"]\n48\t    is_pole_b = (df[field] == pole_b).values\n49\t\n50\t    score_formal = np.where(is_pole_b, df[\"score_counterfactual\"].values, df[\"score_original\"].values)\n51\t    score_casual = np.where(is_pole_b, df[\"score_original\"].values, df[\"score_counterfactual\"].values)\n52\t    diff = pd.Series(score_formal - score_casual, index=df.index)\n53\t\n54\t    n = len(diff)\n55\t    raw_ate = diff.mean()\n56\t    raw_se = diff.std(ddof=1) / np.sqrt(n)\n57\t    t_crit = stats.t.ppf(1 - alpha / 2, df=n - 1)\n58\t    raw_ci = (raw_ate - t_crit * raw_se, raw_ate + t_crit * raw_se)\n59\t    _, p_val = stats.ttest_1samp(diff, 0)\n60\t    cohens_d = raw_ate / diff.std(ddof=1) if diff.std(ddof=1) > 0 else 0.0\n61\t\n62\t    # RATE correction: flip rewrite bias for pole_a originals so direction matches\n63\t    raw_rewrite_bias = (df[\"score_double_rewrite\"] - df[\"score_original\"]).values\n64\t    rewrite_bias_vec = pd.Series(np.where(is_pole_b, raw_rewrite_bias, -raw_rewrite_bias), index=df.index)\n65\t    rewrite_bias = rewrite_bias_vec.mean()\n66\t    corrected_ate = raw_ate - rewrite_bias\n67\t\n68\t    corrected_diff = diff - rewrite_bias_vec\n69\t    corrected_se = corrected_diff.std(ddof=1) / np.sqrt(n)\n70\t    corrected_ci = (corrected_ate - t_crit * corrected_se, corrected_ate + t_crit * corrected_se)\n71\t    _, p_corr = stats.ttest_1samp(corrected_diff, 0)\n72\t    cohens_d_corr = corrected_ate / corrected_diff.std(ddof=1) if corrected_diff.std(ddof=1) > 0 else 0.0\n73\t\n74\t    return {\n75\t        \"n\": n,\n76\t        \"raw_ate\": raw_ate,\n77\t        \"raw_se\": raw_se,\n78\t        \"raw_ci_lo\": raw_ci[0],\n79\t        \"raw_ci_hi\": raw_ci[1],\n80\t        \"raw_p\": p_val,\n81\t        \"raw_cohens_d\": cohens_d,\n82\t        \"rewrite_bias\": rewrite_bias,\n83\t        \"corrected_ate\": corrected_ate,\n84\t        \"corrected_se\": corrected_se,\n85\t        \"corrected_ci_lo\": corrected_ci[0],\n86\t        \"corrected_ci_hi\": corrected_ci[1],\n87\t        \"corrected_p\": p_corr,\n88\t        \"corrected_cohens_d\": cohens_d_corr,\n89\t    }\n90\t\n91\t\n92\tdef directional_analysis(df: pd.DataFrame, alpha: float) -> pd.DataFrame:\n93\t    cfg = AXIS_CONFIG[_AXIS]\n94\t    pole_a, pole_b = cfg[\"poles\"]\n95\t    field = cfg[\"field\"]\n96\t    rows = []\n97\t    for direction in [pole_a, pole_b]:\n98\t        sub = df[df[field] == direction]\n99\t        if len(sub) < 2:\n100\t            continue\n101\t        result = compute_ate(sub, alpha)\n102\t        target = pole_b if direction == pole_a else pole_a\n103\t        result[\"direction\"] = f\"{direction}→{target}\"\n104\t        rows.append(result)\n105\t    return pd.DataFrame(rows)\n106\t\n107\t\n108\tdef plot_ate_bar(results: dict, dir_df: pd.DataFrame, output_dir: str):\n109\t    fig, ax = plt.subplots(figsize=(8, 5))\n110\t\n111\t    labels = [\"Overall (raw)\", \"Overall (corrected)\"]\n112\t    ates = [results[\"raw_ate\"], results[\"corrected_ate\"]]\n113\t    errors = [\n114\t        [results[\"raw_ate\"] - results[\"raw_ci_lo\"]],\n115\t        [results[\"corrected_ate\"] - results[\"corrected_ci_lo\"]],\n116\t    ]\n117\t    errors_hi = [\n118\t        [results[\"raw_ci_hi\"] - results[\"raw_ate\"]],\n119\t        [results[\"corrected_ci_hi\"] - results[\"corrected_ate\"]],\n120\t    ]\n121\t\n122\t    for _, row in dir_df.iterrows():\n123\t        labels.append(row[\"direction\"])\n124\t        ates.append(row[\"corrected_ate\"])\n125\t        errors.append([row[\"corrected_ate\"] - row[\"corrected_ci_lo\"]])\n126\t        errors_hi.append([row[\"corrected_ci_hi\"] - row[\"corrected_ate\"]])\n127\t\n128\t    err_lo = [e[0] for e in errors]\n129\t    err_hi = [e[0] for e in errors_hi]\n130\t\n131\t    x = np.arange(len(labels))\n132\t    colors = [\"#4C72B0\", \"#DD8452\"] + [\"#55A868\"] * len(dir_df)\n133\t    ax.barh(x, ates, xerr=[err_lo, err_hi], color=colors[:len(labels)], capsize=4, height=0.6)\n134\t    ax.axvline(0, color=\"black\", linewidth=0.8, linestyle=\"--\")\n135\t    ax.set_yticks(x)\n136\t    ax.set_yticklabels(labels)\n137\t    ax.set_xlabel(\"ATE (score difference)\")\n138\t    ax.set_title(\"Style Bias: Average Treatment Effect\")\n139\t    plt.tight_layout()\n140\t    fig.savefig(os.path.join(output_dir, \"ate_bar.png\"), dpi=150)\n141\t    plt.close(fig)\n142\t\n143\t\n144\tdef plot_score_violin(df: pd.DataFrame, output_dir: str):\n145\t    fig, ax = plt.subplots(figsize=(8, 5))\n146\t\n147\t    plot_data = pd.DataFrame({\n148\t        \"Score\": pd.concat([df[\"score_original\"], df[\"score_counterfactual\"]], ignore_index=True),\n149\t        \"Version\": [\"Original\"] * len(df) + [\"Counterfactual\"] * len(df),\n150\t    })\n151\t\n152\t    sns.violinplot(data=plot_data, x=\"Version\", y=\"Score\", ax=ax, inner=\"box\", palette=\"Set2\")\n153\t    ax.set_title(\"Score Distribution: Original vs Counterfactual\")\n154\t    ax.set_ylim(0.5, 10.5)\n155\t    plt.tight_layout()\n156\t    fig.savefig(os.path.join(output_dir, \"score_violin.png\"), dpi=150)\n157\t    plt.close(fig)\n158\t\n159\t\n160\tdef run_analysis(df: pd.DataFrame, alpha: float, output_dir: str, prefix: str = \"ate\"):\n161\t    \"\"\"Run full ATE analysis pipeline on a dataframe and save results.\"\"\"\n162\t    os.makedirs(output_dir, exist_ok=True)\n163\t\n164\t    results = compute_ate(df, alpha)\n165\t\n166\t    print(f\"\\n{'='*60}\")\n167\t    print(f\"  Overall ATE Analysis — {prefix}\")\n168\t    print(f\"{'='*60}\")\n169\t    print(f\"  N = {results['n']}\")\n170\t    print(f\"  Raw ATE          = {results['raw_ate']:+.4f}  (SE={results['raw_se']:.4f})\")\n171\t    print(f\"  Raw 95% CI       = [{results['raw_ci_lo']:+.4f}, {results['raw_ci_hi']:+.4f}]\")\n172\t    print(f\"  Raw p-value      = {results['raw_p']:.6f}\")\n173\t    print(f\"  Raw Cohen's d    = {results['raw_cohens_d']:+.4f}\")\n174\t    print(f\"  Rewrite bias     = {results['rewrite_bias']:+.4f}\")\n175\t    print(f\"  Corrected ATE    = {results['corrected_ate']:+.4f}  (SE={results['corrected_se']:.4f})\")\n176\t    print(f\"  Corrected 95% CI = [{results['corrected_ci_lo']:+.4f}, {results['corrected_ci_hi']:+.4f}]\")\n177\t    print(f\"  Corrected p      = {results['corrected_p']:.6f}\")\n178\t    print(f\"  Corrected d      = {results['corrected_cohens_d']:+.4f}\")\n179\t\n180\t    dir_df = directional_analysis(df, alpha)\n181\t    if not dir_df.empty:\n182\t        print(f\"\\n{'='*60}\")\n183\t        print(\"  Directional Analysis\")\n184\t        print(f\"{'='*60}\")\n185\t        for _, row in dir_df.iterrows():\n186\t            print(f\"\\n  {row['direction']}  (n={row['n']})\")\n187\t            print(f\"    Corrected ATE = {row['corrected_ate']:+.4f}, p = {row['corrected_p']:.6f}, d = {row['corrected_cohens_d']:+.4f}\")\n188\t\n189\t    strat_rows = []\n190\t    if \"nli_cf\" in df.columns:\n191\t        nli_sub = df[df[\"nli_cf\"] >= 0.90]\n192\t        label = \"primary: nli_cf≥0.90 (n={})\".format(len(nli_sub))\n193\t        if len(nli_sub) >= 3:\n194\t            nli_result = compute_ate(nli_sub, alpha)\n195\t            nli_result[\"group\"] = label\n196\t            strat_rows.append(nli_result)\n197\t\n198\t    if \"bertscore_cf\" in df.columns:\n199\t        for bs_thresh in [0.85, 0.88, 0.90, 0.92]:\n200\t            sub = df[df[\"bertscore_cf\"] >= bs_thresh]\n201\t            label = \"secondary: bertscore_cf≥{:.2f} (n={})\".format(bs_thresh, len(sub))\n202\t            if len(sub) >= 3:\n203\t                bs_result = compute_ate(sub, alpha)\n204\t                bs_result[\"group\"] = label\n205\t                strat_rows.append(bs_result)\n206\t\n207\t    all_label = \"tertiary: all (n={})\".format(len(df))\n208\t    all_result = compute_ate(df, alpha)\n209\t    all_result[\"group\"] = all_label\n210\t    strat_rows.append(all_result)\n211\t\n212\t    print(f\"\\n{'='*60}\")\n213\t    print(\"  Stratified Analysis\")\n214\t    print(f\"{'='*60}\")\n215\t    for row in strat_rows:\n216\t        print(f\"  {row['group']}: ATE={row['corrected_ate']:+.4f}, p={row['corrected_p']:.6f}, d={row['corrected_cohens_d']:+.4f}\")\n217\t\n218\t    summary_rows = [{\"group\": \"overall\", **results}]\n219\t    for _, row in dir_df.iterrows():\n220\t        summary_rows.append({\"group\": row[\"direction\"], **row.to_dict()})\n221\t    for row in strat_rows:\n222\t        summary_rows.append(row)\n223\t    summary_df = pd.DataFrame(summary_rows)\n224\t    csv_path = os.path.join(output_dir, f\"{prefix}_summary.csv\")\n225\t    summary_df.to_csv(csv_path, index=False)\n226\t    print(f\"\\nSaved summary to {csv_path}\")\n227\t\n228\t    plot_ate_bar(results, dir_df, output_dir)\n229\t    plot_score_violin(df, output_dir)\n230\t    print(f\"Saved plots to {output_dir}/\")\n231\t\n232\t    return results, dir_df, strat_rows\n233\t\n234\t\n235\tdef winsorize_score_diff(df: pd.DataFrame, sigma: float = 3.0) -> pd.DataFrame:\n236\t    \"\"\"Winsorize the pole_a-pole_b score difference at ±sigma standard deviations.\"\"\"\n237\t    cfg = AXIS_CONFIG[_AXIS]\n238\t    pole_b = cfg[\"poles\"][1]\n239\t    field = cfg[\"field\"]\n240\t    df = df.copy()\n241\t    is_pole_b = (df[field] == pole_b).values\n242\t    score_formal = np.where(is_pole_b, df[\"score_counterfactual\"].values, df[\"score_original\"].values)\n243\t    score_casual = np.where(is_pole_b, df[\"score_original\"].values, df[\"score_counterfactual\"].values)\n244\t    diff = score_formal - score_casual\n245\t\n246\t    mu, sd = diff.mean(), diff.std(ddof=1)\n247\t    lo, hi = mu - sigma * sd, mu + sigma * sd\n248\t    clipped = np.clip(diff, lo, hi)\n249\t    n_clipped = int(np.sum((diff < lo) | (diff > hi)))\n250\t    print(f\"  Winsorize at {sigma}σ: bounds=[{lo:+.2f}, {hi:+.2f}], clipped {n_clipped} values\")\n251\t\n252\t    new_formal = score_casual + clipped\n253\t    df.loc[is_pole_b, \"score_counterfactual\"] = new_formal[is_pole_b]\n254\t    df.loc[~is_pole_b, \"score_original\"] = new_formal[~is_pole_b]\n255\t\n256\t    # Also winsorize double_rewrite diff\n257\t    dr_diff = df[\"score_double_rewrite\"].values - df[\"score_original\"].values\n258\t    dr_mu, dr_sd = dr_diff.mean(), dr_diff.std(ddof=1)\n259\t    dr_lo, dr_hi = dr_mu - sigma * dr_sd, dr_mu + sigma * dr_sd\n260\t    dr_clipped = np.clip(dr_diff, dr_lo, dr_hi)\n261\t    df[\"score_double_rewrite\"] = df[\"score_original\"].values + dr_clipped\n262\t\n263\t    return df\n264\t\n265\t\n266\tdef main():\n267\t    parser = argparse.ArgumentParser(description=\"ATE analysis for style bias\")\n268\t    parser.add_argument(\"--input-file\", required=True)\n269\t    parser.add_argument(\"--output-dir\", required=True)\n270\t    parser.add_argument(\"--alpha\", type=float, default=0.05)\n271\t    parser.add_argument(\"--sensitivity\", action=\"store_true\",\n272\t                        help=\"Run pre-registered sensitivity analyses (primary + sens1 + sens2)\")\n273\t    parser.add_argument(\"--axis\", default=\"formality\", choices=list(AXIS_CONFIG.keys()),\n274\t                        help=\"Style axis (default: formality)\")\n275\t    args = parser.parse_args()\n276\t\n277\t    global _AXIS\n278\t    _AXIS = args.axis\n279\t\n280\t    import matplotlib\n281\t    matplotlib.use(\"Agg\")\n282\t    import matplotlib.pyplot as plt\n283\t    import numpy as np\n284\t    import pandas as pd\n285\t    import seaborn as sns\n286\t    from scipy import stats\n287\t\n288\t    for name, obj in [(\"pd\", pd), (\"np\", np), (\"stats\", stats), (\"plt\", plt), (\"sns\", sns)]:\n289\t        globals()[name] = obj\n290\t\n291\t    os.makedirs(args.output_dir, exist_ok=True)\n292\t\n293\t    df = load_scored(args.input_file)\n294\t    print(f\"Loaded {len(df)} scored records\")\n295\t\n296\t    if not args.sensitivity:\n297\t        run_analysis(df, args.alpha, args.output_dir, prefix=\"ate\")\n298\t    else:\n299\t        # Pre-registered exclusion protocol: 3 analysis sets\n300\t        # Primary: NLI ≥ 0.90, no exclusion\n301\t        if \"nli_cf\" in df.columns:\n302\t            df_primary = df[df[\"nli_cf\"] >= 0.90].copy()\n303\t        else:\n304\t            df_primary = df.copy()\n305\t        print(f\"\\n{'#'*60}\")\n306\t        print(f\"  PRIMARY ANALYSIS (NLI≥0.90, n={len(df_primary)})\")\n307\t        print(f\"{'#'*60}\")\n308\t        run_analysis(df_primary, args.alpha, args.output_dir, prefix=\"ate_primary\")\n309\t\n310\t        # Sensitivity 1: primary + exclude NLI < 0.50\n311\t        if \"nli_cf\" in df.columns:\n312\t            df_sens1 = df[(df[\"nli_cf\"] >= 0.90) & (df[\"nli_cf\"] >= 0.50)].copy()\n313\t        else:\n314\t            df_sens1 = df_primary.copy()\n315\t        print(f\"\\n{'#'*60}\")\n316\t        print(f\"  SENSITIVITY 1: exclude NLI<0.50 (n={len(df_sens1)})\")\n317\t        print(f\"{'#'*60}\")\n318\t        run_analysis(df_sens1, args.alpha, args.output_dir, prefix=\"ate_sens1\")\n319\t\n320\t        # Sensitivity 2: primary + winsorize score_diff at 3σ\n321\t        df_sens2 = winsorize_score_diff(df_primary, sigma=3.0)\n322\t        print(f\"\\n{'#'*60}\")\n323\t        print(f\"  SENSITIVITY 2: winsorize at 3σ (n={len(df_sens2)})\")\n324\t        print(f\"{'#'*60}\")\n325\t        run_analysis(df_sens2, args.alpha, args.output_dir, prefix=\"ate_sens2\")\n326\t\n327\t        # Also run on ALL records for reference\n328\t        print(f\"\\n{'#'*60}\")\n329\t        print(f\"  REFERENCE: all records (n={len(df)})\")\n330\t        print(f\"{'#'*60}\")\n331\t        run_analysis(df, args.alpha, args.output_dir, prefix=\"ate_all\")\n332\t\n333\t\n334\tif __name__ == \"__main__\":\n335\t    main()\n336\t"}]},"parent_tool_use_id":"toolu_01FJcotXASHd7kdeVDZSpUAd","session_id":"e3b839b6-f829-41eb-a911-4574b0a14ec9","uuid":"671171dc-afe0-4e31-b883-12b8c29d87bc","timestamp":"2026-05-21T05:53:45.989Z"}
