{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01YVBvL92hSBb7nmTVHSiKsv","type":"tool_result","content":"1\t\"\"\"Pairwise comparison scoring via GPT-4o with position bias control.\n2\t\n3\tEach record is evaluated twice (pole_a-first and pole_b-first). Only consistent\n4\tjudgments count; inconsistent pairs are ties. Uses sign test for significance.\n5\tSupports multiple style axes: formality (formal/casual), verbosity (verbose/concise).\n6\t\n7\tInput:  verified.jsonl (all records, no filtering)\n8\tOutput: pairwise_results.jsonl — per-record with trial1/trial2/consistent/pole_a_wins\n9\t        pairwise_summary.csv — aggregated stats\n10\tDeps:   openai (async client), asyncio, scipy\n11\t\"\"\"\n12\t\n13\timport argparse\n14\timport asyncio\n15\timport csv\n16\timport json\n17\timport logging\n18\timport os\n19\timport re\n20\timport time\n21\t\n22\tlogger = logging.getLogger(__name__)\n23\t\n24\tAXIS_CONFIG = {\n25\t    \"formality\": {\"poles\": (\"formal\", \"casual\"), \"field\": \"original_formality\"},\n26\t    \"verbosity\": {\"poles\": (\"verbose\", \"concise\"), \"field\": \"original_verbosity\"},\n27\t    \"tone\": {\"poles\": (\"assertive\", \"hedging\"), \"field\": \"original_tone\"},\n28\t    \"rate_control\": {\"poles\": (\"original\", \"rewritten\"), \"field\": \"rate_role\"},\n29\t    \"register\": {\"poles\": (\"academic\", \"conversational\"), \"field\": \"original_register\"},\n30\t}\n31\t\n32\tPAIRWISE_SYSTEM = (\n33\t    \"You are an expert evaluator of AI assistant responses. \"\n34\t    \"Compare the two responses below and pick the better one.\"\n35\t)\n36\t\n37\tPAIRWISE_USER_TEMPLATE = \"\"\"Instruction: {instruction}\n38\t\n39\tResponse A:\n40\t{response_a}\n41\t\n42\tResponse B:\n43\t{response_b}\n44\t\n45\tWhich response is better in terms of overall quality (helpfulness, accuracy, completeness, coherence)?\n46\tOutput ONLY \"A\" or \"B\".\"\"\"\n47\t\n48\t\n49\tdef parse_choice(text: str) -> str | None:\n50\t    text = text.strip().upper()\n51\t    if text in (\"A\", \"B\"):\n52\t        return text\n53\t    m = re.search(r\"\\b([AB])\\b\", text)\n54\t    return m.group(1) if m else None\n55\t\n56\t\n57\tclass RateLimiter:\n58\t    def __init__(self, max_per_minute: int):\n59\t        self._interval = 60.0 / max_per_minute\n60\t        self._last = 0.0\n61\t        self._lock = asyncio.Lock()\n62\t\n63\t    async def acquire(self):\n64\t        async with self._lock:\n65\t            now = time.monotonic()\n66\t            wait = self._interval - (now - self._last)\n67\t            if wait > 0:\n68\t                await asyncio.sleep(wait)\n69\t            self._last = time.monotonic()\n70\t\n71\t\n72\tasync def compare_one(\n73\t    client, model: str, instruction: str,\n74\t    response_a: str, response_b: str,\n75\t    limiter: RateLimiter, max_retries: int = 3,\n76\t) -> str | None:\n77\t    messages = [\n78\t        {\"role\": \"system\", \"content\": PAIRWISE_SYSTEM},\n79\t        {\"role\": \"user\", \"content\": PAIRWISE_USER_TEMPLATE.format(\n80\t            instruction=instruction, response_a=response_a, response_b=response_b\n81\t        )},\n82\t    ]\n83\t    for attempt in range(max_retries):\n84\t        await limiter.acquire()\n85\t        try:\n86\t            resp = await client.chat.completions.create(\n87\t                model=model, messages=messages, temperature=0.0, max_tokens=8,\n88\t            )\n89\t            text = resp.choices[0].message.content.strip()\n90\t            choice = parse_choice(text)\n91\t            if choice is not None:\n92\t                return choice\n93\t            logger.warning(\"Could not parse choice from '%s', retrying\", text)\n94\t        except Exception as e:\n95\t            logger.warning(\"API error (attempt %d/%d): %s\", attempt + 1, max_retries, e)\n96\t            if attempt < max_retries - 1:\n97\t                await asyncio.sleep(2 ** attempt)\n98\t    return None\n99\t\n100\t\n101\tasync def score_record_dual(\n102\t    client, model: str, rec: dict,\n103\t    semaphore: asyncio.Semaphore, limiter: RateLimiter, max_retries: int,\n104\t    axis: str = \"formality\",\n105\t) -> dict:\n106\t    \"\"\"Run two trials per record: pole_a-first and pole_b-first.\"\"\"\n107\t    cfg = AXIS_CONFIG[axis]\n108\t    pole_a, pole_b = cfg[\"poles\"]\n109\t    field = cfg[\"field\"]\n110\t\n111\t    async with semaphore:\n112\t        instruction = rec[\"instruction\"]\n113\t        original_pole = rec[field]\n114\t\n115\t        if original_pole == pole_a:\n116\t            text_a = rec[\"original_text\"]\n117\t            text_b = rec[\"counterfactual_text\"]\n118\t        else:\n119\t            text_a = rec[\"counterfactual_text\"]\n120\t            text_b = rec[\"original_text\"]\n121\t\n122\t        # Trial 1: A=pole_a, B=pole_b\n123\t        t1_raw = await compare_one(\n124\t            client, model, instruction, text_a, text_b, limiter, max_retries\n125\t        )\n126\t        t1_prefers_a = (t1_raw == \"A\") if t1_raw else None\n127\t\n128\t        # Trial 2: A=pole_b, B=pole_a\n129\t        t2_raw = await compare_one(\n130\t            client, model, instruction, text_b, text_a, limiter, max_retries\n131\t        )\n132\t        t2_prefers_a = (t2_raw == \"B\") if t2_raw else None\n133\t\n134\t        if t1_prefers_a is not None and t2_prefers_a is not None:\n135\t            consistent = (t1_prefers_a == t2_prefers_a)\n136\t            pole_a_wins = t1_prefers_a if consistent else None\n137\t        else:\n138\t            consistent = None\n139\t            pole_a_wins = None\n140\t\n141\t        return {\n142\t            \"id\": rec[\"id\"],\n143\t            \"instruction\": rec[\"instruction\"],\n144\t            f\"original_{axis}\": original_pole,\n145\t            \"nli_cf\": rec.get(\"nli_cf\"),\n146\t            \"bertscore_cf\": rec.get(\"bertscore_cf\"),\n147\t            \"trial1_choice\": t1_raw,\n148\t            f\"trial1_prefers_{pole_a}\": t1_prefers_a,\n149\t            \"trial2_choice\": t2_raw,\n150\t            f\"trial2_prefers_{pole_a}\": t2_prefers_a,\n151\t            \"consistent\": consistent,\n152\t            f\"{pole_a}_wins\": pole_a_wins,\n153\t        }\n154\t\n155\t\n156\tdef load_processed_ids(output_file: str) -> set[str]:\n157\t    ids = set()\n158\t    if os.path.exists(output_file):\n159\t        with open(output_file) as f:\n160\t            for line in f:\n161\t                if line.strip():\n162\t                    ids.add(json.loads(line)[\"id\"])\n163\t    return ids\n164\t\n165\t\n166\tasync def run(args):\n167\t    api_key = [REDACTED] or os.environ.get(\"OPENAI_API_KEY\")\n168\t    if not api_key:[REDACTED]        raise ValueError(\"Set OPENAI_API_KEY or pass --api-key\")\n170\t\n171\t    from openai import AsyncOpenAI\n172\t    base_url = args.base_url or os.environ.get(\"OPENAI_BASE_URL\")\n173\t    client = AsyncOpenAI(api_key=[REDACTED], base_url=base_url) if base_url else AsyncOpenAI(api_key=[REDACTED]    with open(args.input_file) as f:\n176\t        records = [json.loads(line) for line in f if line.strip()]\n177\t\n178\t    processed_ids = load_processed_ids(args.output_file)\n179\t    todo = [r for r in records if r[\"id\"] not in processed_ids]\n180\t    logger.info(\"Total: %d, already done: %d, to score: %d\", len(records), len(processed_ids), len(todo))\n181\t\n182\t    if not todo:\n183\t        logger.info(\"Nothing to do\")\n184\t        return\n185\t\n186\t    semaphore = asyncio.Semaphore(args.max_concurrent)\n187\t    limiter = RateLimiter(args.rate_limit)\n188\t\n189\t    tasks = [\n190\t        score_record_dual(client, args.model, rec, semaphore, limiter, args.retry, axis=args.axis)\n191\t        for rec in todo\n192\t    ]\n193\t\n194\t    os.makedirs(os.path.dirname(args.output_file) or \".\", exist_ok=True)\n195\t\n196\t    with open(args.output_file, \"a\") as fout:\n197\t        for coro in asyncio.as_completed(tasks):\n198\t            result = await coro\n199\t            fout.write(json.dumps(result, ensure_ascii=False) + \"\\n\")\n200\t            fout.flush()\n201\t            pole_a = AXIS_CONFIG[args.axis][\"poles\"][0]\n202\t            logger.info(\n203\t                \"Compared %s: t1=%s t2=%s consistent=%s %s_wins=%s\",\n204\t                result[\"id\"], result[\"trial1_choice\"], result[\"trial2_choice\"],\n205\t                result[\"consistent\"], pole_a, result.get(f\"{pole_a}_wins\"),\n206\t            )\n207\t\n208\t\n209\tdef analyze(input_file: str, output_dir: str, axis: str = \"formality\"):\n210\t    from scipy import stats\n211\t\n212\t    cfg = AXIS_CONFIG[axis]\n213\t    pole_a, pole_b = cfg[\"poles\"]\n214\t    field = cfg[\"field\"]\n215\t    wins_key = f\"{pole_a}_wins\"\n216\t\n217\t    with open(input_file) as f:\n218\t        records = [json.loads(line) for line in f if line.strip()]\n219\t\n220\t    total = len(records)\n221\t    valid = [r for r in records if r.get(\"trial1_choice\") and r.get(\"trial2_choice\")]\n222\t    consistent = [r for r in valid if r.get(\"consistent\") is True]\n223\t    ties = [r for r in valid if r.get(\"consistent\") is False]\n224\t\n225\t    print(f\"\\n{'='*60}\")\n226\t    print(f\"  Pairwise Comparison (Position-Controlled) — {axis}\")\n227\t    print(f\"{'='*60}\")\n228\t    print(f\"  Total records: {total}\")\n229\t    print(f\"  Valid (both trials): {len(valid)}\")\n230\t    print(f\"  Consistent: {len(consistent)} ({len(consistent)/len(valid)*100:.1f}%)\")\n231\t    print(f\"  Ties (inconsistent): {len(ties)} ({len(ties)/len(valid)*100:.1f}%)\")\n232\t\n233\t    t1_a = sum(1 for r in valid if r[\"trial1_choice\"] == \"A\")\n234\t    t2_a = sum(1 for r in valid if r[\"trial2_choice\"] == \"A\")\n235\t    print(f\"\\n  Position bias:\")\n236\t    print(f\"    Trial 1 chose A: {t1_a}/{len(valid)} ({t1_a/len(valid)*100:.1f}%)\")\n237\t    print(f\"    Trial 2 chose A: {t2_a}/{len(valid)} ({t2_a/len(valid)*100:.1f}%)\")\n238\t    total_a = t1_a + t2_a\n239\t    total_trials = 2 * len(valid)\n240\t    print(f\"    Overall A rate: {total_a}/{total_trials} ({total_a/total_trials*100:.1f}%)\")\n241\t\n242\t    n_consistent = len(consistent)\n243\t    a_wins = sum(1 for r in consistent if r[wins_key] is True)\n244\t    b_wins = n_consistent - a_wins\n245\t\n246\t    print(f\"\\n{'='*60}\")\n247\t    print(f\"  Overall Results (consistent pairs only)\")\n248\t    print(f\"{'='*60}\")\n249\t    print(f\"  N = {n_consistent}\")\n250\t    print(f\"  {pole_a} wins: {a_wins} ({a_wins/n_consistent*100:.1f}%)\")\n251\t    print(f\"  {pole_b} wins: {b_wins} ({b_wins/n_consistent*100:.1f}%)\")\n252\t\n253\t    sign_p = stats.binomtest(a_wins, n_consistent, 0.5).pvalue\n254\t    win_rate = a_wins / n_consistent\n255\t    z = 1.96\n256\t    denom = 1 + z**2 / n_consistent\n257\t    center = (win_rate + z**2 / (2 * n_consistent)) / denom\n258\t    spread = z * (win_rate * (1 - win_rate) / n_consistent + z**2 / (4 * n_consistent**2))**0.5 / denom\n259\t    ci_lo, ci_hi = max(0, center - spread), min(1, center + spread)\n260\t\n261\t    print(f\"  {pole_a} win rate: {win_rate:.4f}\")\n262\t    print(f\"  95% CI (Wilson): [{ci_lo:.4f}, {ci_hi:.4f}]\")\n263\t    print(f\"  Sign test p-value: {sign_p:.6f}\")\n264\t\n265\t    print(f\"\\n{'='*60}\")\n266\t    print(\"  Directional Analysis (consistent only)\")\n267\t    print(f\"{'='*60}\")\n268\t    dir_rows = []\n269\t    for direction in [pole_a, pole_b]:\n270\t        sub = [r for r in consistent if r.get(field) == direction]\n271\t        if not sub:\n272\t            continue\n273\t        ns = len(sub)\n274\t        fw = sum(1 for r in sub if r[wins_key] is True)\n275\t        wr = fw / ns if ns > 0 else 0\n276\t        bp = stats.binomtest(fw, ns, 0.5).pvalue\n277\t        target = pole_b if direction == pole_a else pole_a\n278\t        label = f\"{direction}→{target}\"\n279\t        print(f\"\\n  {label} (n={ns})\")\n280\t        print(f\"    {pole_a} wins: {fw} ({fw/ns*100:.1f}%), p={bp:.6f}\")\n281\t        if direction == pole_a:\n282\t            print(f\"    ({pole_a}=original, {pole_b}=rewrite → {pole_a} win = prefer original)\")\n283\t        else:\n284\t            print(f\"    ({pole_b}=original, {pole_a}=rewrite → {pole_a} win = prefer rewrite)\")\n285\t        dir_rows.append({\"group\": label, \"n\": ns, f\"{pole_a}_wins\": fw,\n286\t                         \"win_rate\": wr, \"p_value\": bp})\n287\t\n288\t    print(f\"\\n{'='*60}\")\n289\t    print(\"  NLI-Stratified Analysis (consistent only)\")\n290\t    print(f\"{'='*60}\")\n291\t    strat_rows = []\n292\t    for label, filt in [\n293\t        (\"NLI≥0.90\", lambda r: r.get(\"nli_cf\", 0) >= 0.90),\n294\t        (\"All\", lambda r: True),\n295\t    ]:\n296\t        sub = [r for r in consistent if filt(r)]\n297\t        ns = len(sub)\n298\t        if ns == 0:\n299\t            continue\n300\t        fw = sum(1 for r in sub if r[wins_key] is True)\n301\t        wr = fw / ns\n302\t        bp = stats.binomtest(fw, ns, 0.5).pvalue\n303\t        print(f\"  {label} (n={ns}): {pole_a} wins {fw} ({fw/ns*100:.1f}%), p={bp:.6f}\")\n304\t        strat_rows.append({\"group\": label, \"n\": ns, f\"{pole_a}_wins\": fw,\n305\t                           \"win_rate\": wr, \"p_value\": bp})\n306\t\n307\t    os.makedirs(output_dir, exist_ok=True)\n308\t    summary_rows = [\n309\t        {\"group\": \"overall\", \"n\": n_consistent, f\"{pole_a}_wins\": a_wins,\n310\t         f\"{pole_b}_wins\": b_wins, \"win_rate\": win_rate, \"ci_lo\": ci_lo,\n311\t         \"ci_hi\": ci_hi, \"sign_test_p\": sign_p, \"ties\": len(ties),\n312\t         \"consistency_rate\": len(consistent) / len(valid) if valid else 0,\n313\t         \"position_a_rate\": total_a / total_trials if total_trials else 0},\n314\t    ]\n315\t    csv_path = os.path.join(output_dir, \"pairwise_summary.csv\")\n316\t    fieldnames = list(summary_rows[0].keys())\n317\t    with open(csv_path, \"w\", newline=\"\") as f:\n318\t        writer = csv.DictWriter(f, fieldnames=fieldnames)\n319\t        writer.writeheader()\n320\t        writer.writerow(summary_rows[0])\n321\t    print(f\"\\nSaved summary to {csv_path}\")\n322\t\n323\t    detail_path = os.path.join(output_dir, \"pairwise_detailed.csv\")\n324\t    detail_fields = [\"group\", \"n\", f\"{pole_a}_wins\", \"win_rate\", \"p_value\"]\n325\t    with open(detail_path, \"w\", newline=\"\") as f:\n326\t        writer = csv.DictWriter(f, fieldnames=detail_fields)\n327\t        writer.writeheader()\n328\t        for row in dir_rows + strat_rows:\n329\t            writer.writerow(row)\n330\t    print(f\"Saved detailed to {detail_path}\")\n331\t\n332\t\n333\tdef main():\n334\t    parser = argparse.ArgumentParser(description=\"Position-controlled pairwise comparison scoring\")\n335\t    parser.add_argument(\"--input-file\", required=True)\n336\t    parser.add_argument(\"--output-file\", required=True)\n337\t    parser.add_argument(\"--model\", default=\"gpt-4o\")\n338\t    parser.add_argument(\"--api-key\", default=None)\n339\t    parser.add_argument(\"--base-url\", default=\"http://47.94.22.126/v1\")\n340\t    parser.add_argument(\"--max-concurrent\", type=int, default=5)\n341\t    parser.add_argument(\"--rate-limit\", type=int, default=60)\n342\t    parser.add_argument(\"--retry\", type=int, default=3)\n343\t    parser.add_argument(\"--analyze-only\", action=\"store_true\")\n344\t    parser.add_argument(\"--analysis-dir\", default=None)\n345\t    parser.add_argument(\"--axis\", default=\"formality\", choices=list(AXIS_CONFIG.keys()),\n346\t                        help=\"Style axis (default: formality)\")\n347\t    args = parser.parse_args()\n348\t\n349\t    logging.basicConfig(level=logging.INFO, format=\"%(asctime)s %(levelname)s %(message)s\")\n350\t\n351\t    if args.analyze_only:\n352\t        analysis_dir = args.analysis_dir or os.path.dirname(args.output_file) or \".\"\n353\t        analyze(args.output_file, analysis_dir, axis=args.axis)\n354\t    else:\n355\t        asyncio.run(run(args))\n356\t        analysis_dir = args.analysis_dir or os.path.dirname(args.output_file) or \".\"\n357\t        analyze(args.output_file, analysis_dir, axis=args.axis)\n358\t\n359\t\n360\tif __name__ == \"__main__\":\n361\t    main()\n362\t"}]},"parent_tool_use_id":"toolu_01FJcotXASHd7kdeVDZSpUAd","session_id":"e3b839b6-f829-41eb-a911-4574b0a14ec9","uuid":"32d1bdb9-678b-40a6-ba38-7fb372c84362","timestamp":"2026-05-21T05:53:46.825Z"}
