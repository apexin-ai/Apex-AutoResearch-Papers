{"type":"assistant","message":{"model":"claude-opus-4-6","id":"msg_01Kdvfg5QXW93KfMeAJmfarx","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_011UdzbLSvYjG13upF1zF3dj","name":"Read","input":{"file_path":"/home/ubuntu/.agent-ml-research-idea_gen_0514_5/projects/causal_style_decomp_judge/artifacts/csd_pipeline/exp010_binarized_likert.py"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":20671,"cache_read_input_tokens":36256,"cache_creation":{"ephemeral_5m_input_tokens":20671,"ephemeral_1h_input_tokens":0},"output_tokens":4,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":"toolu_01FJcotXASHd7kdeVDZSpUAd","session_id":"e3b839b6-f829-41eb-a911-4574b0a14ec9","uuid":"79fda988-da40-4fa7-899b-85784afabaa0"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011UdzbLSvYjG13upF1zF3dj","type":"tool_result","content":"1\t\"\"\"exp-010: Binarized Likert Sign Test — C2 Critical Control.\n2\t\n3\tIsolates whether the Likert-vs-Pairwise sensitivity gap (C2) is due to\n4\tmeasurement structure (forced choice vs rating scale) or statistical test\n5\tchoice (paired t-test vs sign test).\n6\t\n7\tBinarizes Likert scores per pair: formal_score > casual_score → formal_wins.\n8\tApplies sign test (binomial) on non-tie pairs, matching the pairwise protocol.\n9\t\n10\tInput:  scored_32b.jsonl (with score_original, score_counterfactual, original_formality)\n11\tOutput: Console report + optional CSV\n12\t\"\"\"\n13\t\n14\timport argparse\n15\timport json\n16\timport os\n17\timport sys\n18\t\n19\tfrom scipy import stats\n20\t\n21\t\n22\tdef load_scored(path: str) -> list[dict]:\n23\t    records = []\n24\t    with open(path) as f:\n25\t        for line in f:\n26\t            if line.strip():\n27\t                rec = json.loads(line)\n28\t                if rec.get(\"score_original\") is not None and rec.get(\"score_counterfactual\") is not None:\n29\t                    records.append(rec)\n30\t    return records\n31\t\n32\t\n33\tdef binarized_analysis(records: list[dict], axis: str = \"formality\", nli_threshold: float | None = None):\n34\t    axis_config = {\n35\t        \"formality\": {\"poles\": (\"formal\", \"casual\"), \"field\": \"original_formality\"},\n36\t        \"verbosity\": {\"poles\": (\"verbose\", \"concise\"), \"field\": \"original_verbosity\"},\n37\t        \"tone\": {\"poles\": (\"assertive\", \"hedging\"), \"field\": \"original_tone\"},\n38\t        \"register\": {\"poles\": (\"academic\", \"conversational\"), \"field\": \"original_register\"},\n39\t    }\n40\t    cfg = axis_config[axis]\n41\t    pole_a, pole_b = cfg[\"poles\"]\n42\t    field = cfg[\"field\"]\n43\t\n44\t    if nli_threshold is not None:\n45\t        records = [r for r in records if r.get(\"nli_cf\", 0) >= nli_threshold]\n46\t\n47\t    formal_wins = 0\n48\t    casual_wins = 0\n49\t    ties = 0\n50\t\n51\t    for rec in records:\n52\t        s_orig = float(rec[\"score_original\"])\n53\t        s_cf = float(rec[\"score_counterfactual\"])\n54\t        is_pole_b = rec[field] == pole_b\n55\t\n56\t        if is_pole_b:\n57\t            score_a = s_cf\n58\t            score_b = s_orig\n59\t        else:\n60\t            score_a = s_orig\n61\t            score_b = s_cf\n62\t\n63\t        if score_a > score_b:\n64\t            formal_wins += 1\n65\t        elif score_b > score_a:\n66\t            casual_wins += 1\n67\t        else:\n68\t            ties += 1\n69\t\n70\t    n_total = len(records)\n71\t    n_non_tie = formal_wins + casual_wins\n72\t\n73\t    print(f\"\\n{'='*60}\")\n74\t    label = f\"NLI≥{nli_threshold}\" if nli_threshold else \"all\"\n75\t    print(f\"  Binarized Likert Sign Test ({label}, n={n_total})\")\n76\t    print(f\"{'='*60}\")\n77\t    print(f\"  {pole_a} > {pole_b}: {formal_wins}\")\n78\t    print(f\"  {pole_b} > {pole_a}: {casual_wins}\")\n79\t    print(f\"  Ties (equal):    {ties} ({ties/n_total*100:.1f}%)\")\n80\t    print(f\"  Non-tie pairs:   {n_non_tie}\")\n81\t\n82\t    if n_non_tie < 2:\n83\t        print(\"  Too few non-tie pairs for sign test\")\n84\t        return None\n85\t\n86\t    win_rate = formal_wins / n_non_tie\n87\t    sign_p = stats.binomtest(formal_wins, n_non_tie, 0.5).pvalue\n88\t\n89\t    z = 1.96\n90\t    denom = 1 + z**2 / n_non_tie\n91\t    center = (win_rate + z**2 / (2 * n_non_tie)) / denom\n92\t    spread = z * (win_rate * (1 - win_rate) / n_non_tie + z**2 / (4 * n_non_tie**2))**0.5 / denom\n93\t    ci_lo, ci_hi = max(0, center - spread), min(1, center + spread)\n94\t\n95\t    print(f\"\\n  {pole_a} win rate (non-tie): {win_rate:.4f} ({formal_wins}/{n_non_tie})\")\n96\t    print(f\"  95% CI (Wilson):  [{ci_lo:.4f}, {ci_hi:.4f}]\")\n97\t    print(f\"  Sign test p:      {sign_p:.6f}\")\n98\t    print(f\"  Significant:      {'YES' if sign_p < 0.05 else 'NO'} (α=0.05)\")\n99\t\n100\t    print(f\"\\n  --- Comparison with Pairwise ---\")\n101\t    print(f\"  Pairwise (reference): 69.1% win rate, p=0.006\")\n102\t    print(f\"  Binarized Likert:     {win_rate*100:.1f}% win rate, p={sign_p:.4f}\")\n103\t    if sign_p < 0.05:\n104\t        print(f\"  → Binarized Likert ALSO significant: gap may be test choice, not measurement structure\")\n105\t        print(f\"  → C2 (Likert Blindspot) needs reframing\")\n106\t    else:\n107\t        print(f\"  → Binarized Likert NOT significant: confirms pairwise structural advantage\")\n108\t        print(f\"  → C2 (Likert Blindspot) validated — forced choice matters, not just test choice\")\n109\t\n110\t    return {\n111\t        \"group\": label,\n112\t        \"n\": n_total,\n113\t        \"n_non_tie\": n_non_tie,\n114\t        f\"{pole_a}_wins\": formal_wins,\n115\t        f\"{pole_b}_wins\": casual_wins,\n116\t        \"ties\": ties,\n117\t        \"tie_rate\": ties / n_total,\n118\t        \"win_rate\": win_rate,\n119\t        \"ci_lo\": ci_lo,\n120\t        \"ci_hi\": ci_hi,\n121\t        \"sign_p\": sign_p,\n122\t    }\n123\t\n124\t\n125\tdef main():\n126\t    parser = argparse.ArgumentParser(description=\"exp-010: Binarized Likert Sign Test\")\n127\t    parser.add_argument(\"--input-file\", required=True, help=\"scored_32b.jsonl path\")\n128\t    parser.add_argument(\"--output-dir\", default=None, help=\"Optional output dir for CSV\")\n129\t    parser.add_argument(\"--axis\", default=\"formality\", help=\"Style axis (default: formality)\")\n130\t    args = parser.parse_args()\n131\t\n132\t    records = load_scored(args.input_file)\n133\t    print(f\"Loaded {len(records)} scored records\")\n134\t\n135\t    results = []\n136\t\n137\t    r_all = binarized_analysis(records, axis=args.axis)\n138\t    if r_all:\n139\t        results.append(r_all)\n140\t\n141\t    for thresh in [0.90, 0.85, 0.80]:\n142\t        r = binarized_analysis(records, axis=args.axis, nli_threshold=thresh)\n143\t        if r:\n144\t            results.append(r)\n145\t\n146\t    cfg = {\n147\t        \"formality\": {\"field\": \"original_formality\", \"poles\": (\"formal\", \"casual\")},\n148\t        \"verbosity\": {\"field\": \"original_verbosity\", \"poles\": (\"verbose\", \"concise\")},\n149\t    }\n150\t    if args.axis in cfg:\n151\t        pole_a, pole_b = cfg[args.axis][\"poles\"]\n152\t        field = cfg[args.axis][\"field\"]\n153\t        print(f\"\\n{'='*60}\")\n154\t        print(f\"  Directional Breakdown (all records)\")\n155\t        print(f\"{'='*60}\")\n156\t        for direction in [pole_a, pole_b]:\n157\t            sub = [r for r in records if r.get(field) == direction]\n158\t            if len(sub) < 3:\n159\t                continue\n160\t            target = pole_b if direction == pole_a else pole_a\n161\t            print(f\"\\n  --- {direction}→{target} (n={len(sub)}) ---\")\n162\t            binarized_analysis(sub, axis=args.axis)\n163\t\n164\t    if args.output_dir and results:\n165\t        import csv\n166\t        os.makedirs(args.output_dir, exist_ok=True)\n167\t        csv_path = os.path.join(args.output_dir, \"exp010_binarized_likert.csv\")\n168\t        with open(csv_path, \"w\", newline=\"\") as f:\n169\t            writer = csv.DictWriter(f, fieldnames=results[0].keys())\n170\t            writer.writeheader()\n171\t            for r in results:\n172\t                writer.writerow(r)\n173\t        print(f\"\\nSaved CSV to {csv_path}\")\n174\t\n175\t\n176\tif __name__ == \"__main__\":\n177\t    main()\n178\t"}]},"parent_tool_use_id":"toolu_01FJcotXASHd7kdeVDZSpUAd","session_id":"e3b839b6-f829-41eb-a911-4574b0a14ec9","uuid":"22dfba3a-1a2b-4607-a978-122f92ebb7ec","timestamp":"2026-05-21T05:53:54.109Z"}
