\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces Rewriter independence: Qwen3-32B vs.\ GPT-4o rewriter, judged by Qwen3-32B on LLMBar. CIs overlap; effects are statistically indistinguishable, confirming bias originates in the judge, not the rewriter.}}{8}{table.caption.17}\protected@file@percent }
\newlabel{tab:rewriter}{{9}{8}{Rewriter independence: Qwen3-32B vs.\ GPT-4o rewriter, judged by Qwen3-32B on LLMBar. CIs overlap; effects are statistically indistinguishable, confirming bias originates in the judge, not the rewriter}{table.caption.17}{}}
