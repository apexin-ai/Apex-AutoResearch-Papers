{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01T5cZhGzpM7rK4xBzjYrgge","type":"tool_result","content":"{\"result\":\"{\\\"success\\\": true, \\\"data\\\": {\\\"path\\\": \\\"/home/ubuntu/.agent-ml-research-idea_gen_0514_5/projects/causal_style_decomp_judge/literature_map.yaml\\\", \\\"content\\\": \\\"meta:\\\\n  last_updated: \\\\\\\"2026-05-20T09:30:00Z\\\\\\\"\\\\n  total_papers: 10\\\\ncategories:\\\\n  - style-bias-documentation\\\\n  - judge-debiasing\\\\n  - causal-text-methods\\\\n  - evaluation-benchmarks\\\\npapers:\\\\n  sos_bench_2025:\\\\n    title: \\\\\\\"Style Over Substance: Failure Modes of LLM Judges in Alignment Benchmarking\\\\\\\"\\\\n    authors: [\\\\\\\"Murugadoss et al.\\\\\\\"]\\\\n    year: 2025\\\\n    venue: \\\\\\\"ICLR 2025\\\\\\\"\\\\n    url: \\\\\\\"https://arxiv.org/abs/2409.15268\\\\\\\"\\\\n    category: style-bias-documentation\\\\n    role: foundation\\\\n    relevance: \\\\\\\"Largest meta-benchmark documenting style-over-substance failure in LLM judges across 152K data points. Establishes the core problem CSD addresses.\\\\\\\"\\\\n    semantic_scholar_id: \\\\\\\"2409.15268\\\\\\\"\\\\n    verified: true\\\\n\\\\n  preference_leakage_2026:\\\\n    title: \\\\\\\"Preference Leakage: A Contamination Problem in LLM-as-a-judge\\\\\\\"\\\\n    authors: [\\\\\\\"Li et al.\\\\\\\"]\\\\n    year: 2026\\\\n    venue: \\\\\\\"ICLR 2026\\\\\\\"\\\\n    url: \\\\\\\"https://arxiv.org/abs/2502.01534\\\\\\\"\\\\n    category: style-bias-documentation\\\\n    role: foundation\\\\n    relevance: \\\\\\\"Shows judges rely on 'stylistic regularities—tone consistency, sentence cadence, punctuation density'. Establishes style bias propagation chain from judge → preference data → reward model → policy.\\\\\\\"\\\\n    semantic_scholar_id: \\\\\\\"2502.01534\\\\\\\"\\\\n    verified: true\\\\n\\\\n  fairjudge_2026:\\\\n    title: \\\\\\\"FairJudge: An Adaptive, Debiased, and Consistent LLM-as-a-Judge\\\\\\\"\\\\n    authors: [\\\\\\\"Wang et al.\\\\\\\"]\\\\n    year: 2026\\\\n    venue: \\\\\\\"arXiv\\\\\\\"\\\\n    url: \\\\\\\"https://arxiv.org/abs/2602.06625\\\\\\\"\\\\n    category: judge-debiasing\\\\n    role: direct-competitor\\\\n    relevance: \\\\\\\"Most directly relevant concurrent work. Trains dedicated judge via SFT→DPO→GRPO but requires retraining (white-box). CSD is black-box post-hoc—key differentiator.\\\\\\\"\\\\n    semantic_scholar_id: \\\\\\\"2602.06625\\\\\\\"\\\\n    verified: true\\\\n\\\\n  rate_icml_2025:\\\\n    title: \\\\\\\"RATE: Causal Explainability of Reward Models with Imperfect Counterfactuals\\\\\\\"\\\\n    authors: [\\\\\\\"Shen et al.\\\\\\\"]\\\\n    year: 2025\\\\n    venue: \\\\\\\"ICML 2025\\\\\\\"\\\\n    url: \\\\\\\"https://arxiv.org/abs/2501.00000\\\\\\\"\\\\n    category: causal-text-methods\\\\n    role: method-component\\\\n    relevance: \\\\\\\"Provides the double-rewrite protocol for unbiased ATE estimation under imperfect counterfactuals. CSD adopts this protocol for Stage 1 counterfactual generation.\\\\\\\"\\\\n    verified: false\\\\n\\\\n  dml_chernozhukov_2018:\\\\n    title: \\\\\\\"Double/Debiased Machine Learning for Treatment and Structural Parameters\\\\\\\"\\\\n    authors: [\\\\\\\"Chernozhukov, V.\\\\\\\", \\\\\\\"Chetverikov, D.\\\\\\\", \\\\\\\"Demirer, M.\\\\\\\", \\\\\\\"Duflo, E.\\\\\\\", \\\\\\\"Hansen, C.\\\\\\\", \\\\\\\"Newey, W.\\\\\\\", \\\\\\\"Robins, J.\\\\\\\"]\\\\n    year: 2018\\\\n    venue: \\\\\\\"Econometrics Journal\\\\\\\"\\\\n    doi: \\\\\\\"10.1111/ectj.12097\\\\\\\"\\\\n    category: causal-text-methods\\\\n    role: method-component\\\\n    relevance: \\\\\\\"Provides the partially linear DML framework CSD uses in Stage 2. Doubly-robust property ensures consistency if either outcome model or propensity model is correctly specified.\\\\\\\"\\\\n    verified: true\\\\n\\\\n  lc_alpacaeval_2025:\\\\n    title: \\\\\\\"Length-Controlled AlpacaEval: A Simple Way to Debias Automatic Evaluators\\\\\\\"\\\\n    authors: [\\\\\\\"Dubois et al.\\\\\\\"]\\\\n    year: 2025\\\\n    venue: \\\\\\\"ICLR 2025\\\\\\\"\\\\n    url: \\\\\\\"https://arxiv.org/abs/2404.04475\\\\\\\"\\\\n    category: judge-debiasing\\\\n    role: direct-competitor\\\\n    relevance: \\\\\\\"Demonstrates effective post-hoc regression debiasing but only controls single dimension (length). CSD extends to multi-dimensional interventional causal identification—key baseline.\\\\\\\"\\\\n    semantic_scholar_id: \\\\\\\"2404.04475\\\\\\\"\\\\n    verified: true\\\\n\\\\n  casse_2026:\\\\n    title: \\\\\\\"A Concise Agent is Less Expert: Revealing Side Effects of Using Style Features on Conversational Agents\\\\\\\"\\\\n    authors: [\\\\\\\"CASSE authors\\\\\\\"]\\\\n    year: 2026\\\\n    venue: \\\\\\\"arXiv\\\\\\\"\\\\n    url: \\\\\\\"https://arxiv.org/abs/2601.10809\\\\\\\"\\\\n    category: style-bias-documentation\\\\n    role: foundation\\\\n    relevance: \\\\\\\"Documents cross-feature stylistic interactions across 12 style features. Shows conciseness reduces perceived expertise—supports CSD's legitimacy-aware correction design (α parameter).\\\\\\\"\\\\n    semantic_scholar_id: \\\\\\\"2601.10809\\\\\\\"\\\\n    verified: true\\\\n\\\\n  counterfactual_rhetorical_2025:\\\\n    title: \\\\\\\"Counterfactual LLM-based Framework for Measuring Rhetorical Style\\\\\\\"\\\\n    authors: [\\\\\\\"Authors\\\\\\\"]\\\\n    year: 2025\\\\n    venue: \\\\\\\"arXiv\\\\\\\"\\\\n    url: \\\\\\\"https://arxiv.org/abs/2512.19908\\\\\\\"\\\\n    category: causal-text-methods\\\\n    role: direct-competitor\\\\n    relevance: \\\\\\\"Highly similar pipeline (LLM counterfactual rewrite + statistical aggregation) but only quantifies style effects without correction. CSD completes the quantify→correct loop.\\\\\\\"\\\\n    semantic_scholar_id: \\\\\\\"2512.19908\\\\\\\"\\\\n    verified: true\\\\n\\\\n  soumik_2026:\\\\n    title: \\\\\\\"Judging the Judges: A Systematic Evaluation of Bias Mitigation Strategies in LLM-as-a-Judge Pipelines\\\\\\\"\\\\n    authors: [\\\\\\\"Soumik et al.\\\\\\\"]\\\\n    year: 2026\\\\n    venue: \\\\\\\"arXiv\\\\\\\"\\\\n    url: \\\\\\\"https://arxiv.org/abs/2604.23178\\\\\\\"\\\\n    category: judge-debiasing\\\\n    role: direct-competitor\\\\n    relevance: \\\\\\\"Tests 9 debiasing strategies across 5 judges. Best strategy (combined budget) achieves +11.2pp. CSD should directly compare against this. Effect sizes 0.76-0.92 validate our premise.\\\\\\\"\\\\n    semantic_scholar_id: \\\\\\\"2604.23178\\\\\\\"\\\\n    verified: true\\\\n\\\\n  veitch_uai_2020:\\\\n    title: \\\\\\\"Adapting Text Embeddings for Causal Inference\\\\\\\"\\\\n    authors: [\\\\\\\"Veitch, V.\\\\\\\", \\\\\\\"Sridhar, D.\\\\\\\", \\\\\\\"Blei, D.\\\\\\\"]\\\\n    year: 2020\\\\n    venue: \\\\\\\"UAI 2020\\\\\\\"\\\\n    url: \\\\\\\"https://arxiv.org/abs/1905.12741\\\\\\\"\\\\n    category: causal-text-methods\\\\n    role: method-component\\\\n    relevance: \\\\\\\"Establishes functional intervention framework for binary text treatments satisfying positivity. Theoretical foundation for CSD's binary style axes being well-posed interventions.\\\\\\\"\\\\n    semantic_scholar_id: \\\\\\\"1905.12741\\\\\\\"\\\\n    verified: true\\\\n\\\", \\\"total_chars\\\": 5502, \\\"truncated\\\": false}, \\\"error\\\": null, \\\"metadata\\\": {}}\"}"}]},"parent_tool_use_id":"toolu_01APExJ8cK9eGvZRntXSdyKN","session_id":"84c1e33b-a907-4d62-a6bc-d61bef62f953","uuid":"1efe2307-7e87-461b-a617-83120679f439","timestamp":"2026-05-21T16:12:17.566Z"}
