{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012xZ8pFx99sqbmSCdfp69eL","type":"tool_result","content":"1\tfrom __future__ import annotations\n2\t\"\"\"ATE (Average Treatment Effect) analysis for style bias quantification.\n3\t\n4\tSupports multiple style axes: formality (formal/casual), verbosity (verbose/concise).\n5\tATE = score(pole_a) - score(pole_b), where pole_a is the expected-preferred pole.\n6\t\n7\tInput:  scored.jsonl (with score_original, score_counterfactual, score_double_rewrite)\n8\tOutput: CSV summary + visualizations (ATE bar chart, score violin plot)\n9\tDeps:   scipy, pandas, numpy, matplotlib, seaborn\n10\t\"\"\"\n11\t\n12\timport argparse\n13\timport json\n14\timport os\n15\t\n16\tAXIS_CONFIG = {\n17\t    \"formality\": {\"poles\": (\"formal\", \"casual\"), \"field\": \"original_formality\"},\n18\t    \"verbosity\": {\"poles\": (\"verbose\", \"concise\"), \"field\": \"original_verbosity\"},\n19\t    \"tone\": {\"poles\": (\"assertive\", \"hedging\"), \"field\": \"original_tone\"},\n20\t    \"rate_control\": {\"poles\": (\"original\", \"rewritten\"), \"field\": \"rate_role\"},\n21\t    \"register\": {\"poles\": (\"academic\", \"conversational\"), \"field\": \"original_register\"},\n22\t}\n23\t\n24\t_AXIS = \"formality\"\n25\t\n26\t\n27\tdef load_scored(path: str) -> pd.DataFrame:\n28\t    records = []\n29\t    with open(path) as f:\n30\t        for line in f:\n31\t            if line.strip():\n32\t                records.append(json.loads(line))\n33\t    df = pd.DataFrame(records)\n34\t    # Drop rows with missing scores\n35\t    for col in [\"score_original\", \"score_counterfactual\", \"score_double_rewrite\"]:\n36\t        df = df[df[col].notna()]\n37\t    df[\"score_original\"] = df[\"score_original\"].astype(float)\n38\t    df[\"score_counterfactual\"] = df[\"score_counterfactual\"].astype(float)\n39\t    df[\"score_double_rewrite\"] = df[\"score_double_rewrite\"].astype(float)\n40\t    return df\n41\t\n42\t\n43\tdef compute_ate(df: pd.DataFrame, alpha: float = 0.05) -> dict:\n44\t    \"\"\"ATE as style premium: score(pole_a) - score(pole_b).\"\"\"\n45\t    cfg = AXIS_CONFIG[_AXIS]\n46\t    pole_b = cfg[\"poles\"][1]\n47\t    field = cfg[\"field\"]\n48\t    is_pole_b = (df[field] == pole_b).values\n49\t\n50\t    score_formal = np.where(is_pole_b, df[\"score_counterfactual\"].values, df[\"score_original\"].values)\n51\t    score_casual = np.where(is_pole_b, df[\"score_original\"].values, df[\"score_counterfactual\"].values)\n52\t    diff = pd.Series(score_formal - score_casual, index=df.index)\n53\t\n54\t    n = len(diff)\n55\t    raw_ate = diff.mean()\n56\t    raw_se = diff.std(ddof=1) / np.sqrt(n)\n57\t    t_crit = stats.t.ppf(1 - alpha / 2, df=n - 1)\n58\t    raw_ci = (raw_ate - t_crit * raw_se, raw_ate + t_crit * raw_se)\n59\t    _, p_val = stats.ttest_1samp(diff, 0)\n60\t    cohens_d = raw_ate / diff.std(ddof=1) if diff.std(ddof=1) > 0 else 0.0\n61\t\n62\t    # RATE correction: flip rewrite bias for pole_a originals so direction matches\n63\t    raw_rewrite_bias = (df[\"score_double_rewrite\"] - df[\"score_original\"]).values\n64\t    rewrite_bias_vec = pd.Series(np.where(is_pole_b, raw_rewrite_bias, -raw_rewrite_bias), index=df.index)\n65\t    rewrite_bias = rewrite_bias_vec.mean()\n66\t    corrected_ate = raw_ate - rewrite_bias\n67\t\n68\t    corrected_diff = diff - rewrite_bias_vec\n69\t    corrected_se = corrected_diff.std(ddof=1) / np.sqrt(n)\n70\t    corrected_ci = (corrected_ate - t_crit * corrected_se, corrected_ate + t_crit * corrected_se)\n71\t    _, p_corr = stats.ttest_1samp(corrected_diff, 0)\n72\t    cohens_d_corr = corrected_ate / corrected_diff.std(ddof=1) if corrected_diff.std(ddof=1) > 0 else 0.0\n73\t\n74\t    return {\n75\t        \"n\": n,\n76\t        \"raw_ate\": raw_ate,\n77\t        \"raw_se\": raw_se,\n78\t        \"raw_ci_lo\": raw_ci[0],\n79\t        \"raw_ci_hi\": raw_ci[1],\n80\t        \"raw_p\": p_val,\n81\t        \"raw_cohens_d\": cohens_d,\n82\t        \"rewrite_bias\": rewrite_bias,\n83\t        \"corrected_ate\": corrected_ate,\n84\t        \"corrected_se\": corrected_se,\n85\t        \"corrected_ci_lo\": corrected_ci[0],\n86\t        \"corrected_ci_hi\": corrected_ci[1],\n87\t        \"corrected_p\": p_corr,\n88\t        \"corrected_cohens_d\": cohens_d_corr,\n89\t    }\n90\t\n91\t\n92\tdef directional_analysis(df: pd.DataFrame, alpha: float) -> pd.DataFrame:\n93\t    cfg = AXIS_CONFIG[_AXIS]\n94\t    pole_a, pole_b = cfg[\"poles\"]\n95\t    field = cfg[\"field\"]\n96\t    rows = []\n97\t    for direction in [pole_a, pole_b]:\n98\t        sub = df[df[field] == direction]\n99\t        if len(sub) < 2:\n100\t            continue\n101\t        result = compute_ate(sub, alpha)\n102\t        target = pole_b if direction == pole_a else pole_a\n103\t        result[\"direction\"] = f\"{direction}→{target}\"\n104\t        rows.append(result)\n105\t    return pd.DataFrame(rows)\n106\t\n107\t\n108\tdef plot_ate_bar(results: dict, dir_df: pd.DataFrame, output_dir: str):\n109\t    fig, ax = plt.subplots(figsize=(8, 5))\n110\t\n111\t    labels = [\"Overall (raw)\", \"Overall (corrected)\"]\n112\t    ates = [results[\"raw_ate\"], results[\"corrected_ate\"]]\n113\t    errors = [\n114\t        [results[\"raw_ate\"] - results[\"raw_ci_lo\"]],\n115\t        [results[\"corrected_ate\"] - results[\"corrected_ci_lo\"]],\n116\t    ]\n117\t    errors_hi = [\n118\t        [results[\"raw_ci_hi\"] - results[\"raw_ate\"]],\n119\t        [results[\"corrected_ci_hi\"] - results[\"corrected_ate\"]],\n120\t    ]\n121\t\n122\t    for _, row in dir_df.iterrows():\n123\t        labels.append(row[\"direction\"])\n124\t        ates.append(row[\"corrected_ate\"])\n125\t        errors.append([row[\"corrected_ate\"] - row[\"corrected_ci_lo\"]])\n126\t        errors_hi.append([row[\"corrected_ci_hi\"] - row[\"corrected_ate\"]])\n127\t\n128\t    err_lo = [e[0] for e in errors]\n129\t    err_hi = [e[0] for e in errors_hi]\n130\t\n131\t    x = np.arange(len(labels))\n132\t    colors = [\"#4C72B0\", \"#DD8452\"] + [\"#55A868\"] * len(dir_df)\n133\t    ax.barh(x, ates, xerr=[err_lo, err_hi], color=colors[:len(labels)], capsize=4, height=0.6)\n134\t    ax.axvline(0, color=\"black\", linewidth=0.8, linestyle=\"--\")\n135\t    ax.set_yticks(x)\n136\t    ax.set_yticklabels(labels)\n137\t    ax.set_xlabel(\"ATE (score difference)\")\n138\t    ax.set_title(\"Style Bias: Average Treatment Effect\")\n139\t    plt.tight_layout()\n140\t    fig.savefig(os.path.join(output_dir, \"ate_bar.png\"), dpi=150)\n141\t    plt.close(fig)\n142\t\n143\t\n144\tdef plot_score_violin(df: pd.DataFrame, output_dir: str):\n145\t    fig, ax = plt.subplots(figsize=(8, 5))\n146\t\n147\t    plot_data = pd.DataFrame({\n148\t        \"Score\": pd.concat([df[\"score_original\"], df[\"score_counterfactual\"]], ignore_index=True),\n149\t        \"Version\": [\"Original\"] * len(df) + [\"Counterfactual\"] * len(df),\n150\t    })\n151\t\n152\t    sns.violinplot(data=plot_data, x=\"Version\", y=\"Score\", ax=ax, inner=\"box\", palette=\"Set2\")\n153\t    ax.set_title(\"Score Distribution: Original vs Counterfactual\")\n154\t    ax.set_ylim(0.5, 10.5)\n155\t    plt.tight_layout()\n156\t    fig.savefig(os.path.join(output_dir, \"score_violin.png\"), dpi=150)\n157\t    plt.close(fig)\n158\t\n159\t\n160\tdef run_analysis(df: pd.DataFrame, alpha: float, output_dir: str, prefix: str = \"ate\"):\n161\t    \"\"\"Run full ATE analysis pipeline on a dataframe and save results.\"\"\"\n162\t    os.makedirs(output_dir, exist_ok=True)\n163\t\n164\t    results = compute_ate(df, alpha)\n165\t\n166\t    print(f\"\\n{'='*60}\")\n167\t    print(f\"  Overall ATE Analysis — {prefix}\")\n168\t    print(f\"{'='*60}\")\n169\t    print(f\"  N = {results['n']}\")\n170\t    print(f\"  Raw ATE          = {results['raw_ate']:+.4f}  (SE={results['raw_se']:.4f})\")\n171\t    print(f\"  Raw 95% CI       = [{results['raw_ci_lo']:+.4f}, {results['raw_ci_hi']:+.4f}]\")\n172\t    print(f\"  Raw p-value      = {results['raw_p']:.6f}\")\n173\t    print(f\"  Raw Cohen's d    = {results['raw_cohens_d']:+.4f}\")\n174\t    print(f\"  Rewrite bias     = {results['rewrite_bias']:+.4f}\")\n175\t    print(f\"  Corrected ATE    = {results['corrected_ate']:+.4f}  (SE={results['corrected_se']:.4f})\")\n176\t    print(f\"  Corrected 95% CI = [{results['corrected_ci_lo']:+.4f}, {results['corrected_ci_hi']:+.4f}]\")\n177\t    print(f\"  Corrected p      = {results['corrected_p']:.6f}\")\n178\t    print(f\"  Corrected d      = {results['corrected_cohens_d']:+.4f}\")\n179\t\n180\t    dir_df = directional_analysis(df, alpha)\n181\t    if not dir_df.empty:\n182\t        print(f\"\\n{'='*60}\")\n183\t        print(\"  Directional Analysis\")\n184\t        print(f\"{'='*60}\")\n185\t        for _, row in dir_df.iterrows():\n186\t            print(f\"\\n  {row['direction']}  (n={row['n']})\")\n187\t            print(f\"    Corrected ATE = {row['corrected_ate']:+.4f}, p = {row['corrected_p']:.6f}, d = {row['corrected_cohens_d']:+.4f}\")\n188\t\n189\t    strat_rows = []\n190\t    if \"nli_cf\" in df.columns:\n191\t        nli_sub = df[df[\"nli_cf\"] >= 0.90]\n192\t        label = \"primary: nli_cf≥0.90 (n={})\".format(len(nli_sub))\n193\t        if len(nli_sub) >= 3:\n194\t            nli_result = compute_ate(nli_sub, alpha)\n195\t            nli_result[\"group\"] = label\n196\t            strat_rows.append(nli_result)\n197\t\n198\t    if \"bertscore_cf\" in df.columns:\n199\t        for bs_thresh in [0.85, 0.88, 0.90, 0.92]:\n200\t            sub = df[df[\"bertscore_cf\"] >= bs_thresh]\n201\t            label = \"secondary: bertscore_cf≥{:.2f} (n={})\".format(bs_thresh, len(sub))\n202\t            if len(sub) >= 3:\n203\t                bs_result = compute_ate(sub, alpha)\n204\t                bs_result[\"group\"] = label\n205\t                strat_rows.append(bs_result)\n206\t\n207\t    all_label = \"tertiary: all (n={})\".format(len(df))\n208\t    all_result = compute_ate(df, alpha)\n209\t    all_result[\"group\"] = all_label\n210\t    strat_rows.append(all_result)\n211\t\n212\t    print(f\"\\n{'='*60}\")\n213\t    print(\"  Stratified Analysis\")\n214\t    print(f\"{'='*60}\")\n215\t    for row in strat_rows:\n216\t        print(f\"  {row['group']}: ATE={row['corrected_ate']:+.4f}, p={row['corrected_p']:.6f}, d={row['corrected_cohens_d']:+.4f}\")\n217\t\n218\t    summary_rows = [{\"group\": \"overall\", **results}]\n219\t    for _, row in dir_df.iterrows():\n220\t        summary_rows.append({\"group\": row[\"direction\"], **row.to_dict()})\n221\t    for row in strat_rows:\n222\t        summary_rows.append(row)\n223\t    summary_df = pd.DataFrame(summary_rows)\n224\t    csv_path = os.path.join(output_dir, f\"{prefix}_summary.csv\")\n225\t    summary_df.to_csv(csv_path, index=False)\n226\t    print(f\"\\nSaved summary to {csv_path}\")\n227\t\n228\t    plot_ate_bar(results, dir_df, output_dir)\n229\t    plot_score_violin(df, output_dir)\n230\t    print(f\"Saved plots to {output_dir}/\")\n231\t\n232\t    return results, dir_df, strat_rows\n233\t\n234\t\n235\tdef winsorize_score_diff(df: pd.DataFrame, sigma: float = 3.0) -> pd.DataFrame:\n236\t    \"\"\"Winsorize the pole_a-pole_b score difference at ±sigma standard deviations.\"\"\"\n237\t    cfg = AXIS_CONFIG[_AXIS]\n238\t    pole_b = cfg[\"poles\"][1]\n239\t    field = cfg[\"field\"]\n240\t    df = df.copy()\n241\t    is_pole_b = (df[field] == pole_b).values\n242\t    score_formal = np.where(is_pole_b, df[\"score_counterfactual\"].values, df[\"score_original\"].values)\n243\t    score_casual = np.where(is_pole_b, df[\"score_original\"].values, df[\"score_counterfactual\"].values)\n244\t    diff = score_formal - score_casual\n245\t\n246\t    mu, sd = diff.mean(), diff.std(ddof=1)\n247\t    lo, hi = mu - sigma * sd, mu + sigma * sd\n248\t    clipped = np.clip(diff, lo, hi)\n249\t    n_clipped = int(np.sum((diff < lo) | (diff > hi)))\n250\t    print(f\"  Winsorize at {sigma}σ: bounds=[{lo:+.2f}, {hi:+.2f}], clipped {n_clipped} values\")\n251\t\n252\t    new_formal = score_casual + clipped\n253\t    df.loc[is_pole_b, \"score_counterfactual\"] = new_formal[is_pole_b]\n254\t    df.loc[~is_pole_b, \"score_original\"] = new_formal[~is_pole_b]\n255\t\n256\t    # Also winsorize double_rewrite diff\n257\t    dr_diff = df[\"score_double_rewrite\"].values - df[\"score_original\"].values\n258\t    dr_mu, dr_sd = dr_diff.mean(), dr_diff.std(ddof=1)\n259\t    dr_lo, dr_hi = dr_mu - sigma * dr_sd, dr_mu + sigma * dr_sd\n260\t    dr_clipped = np.clip(dr_diff, dr_lo, dr_hi)\n261\t    df[\"score_double_rewrite\"] = df[\"score_original\"].values + dr_clipped\n262\t\n263\t    return df\n264\t\n265\t\n266\tdef main():\n267\t    parser = argparse.ArgumentParser(description=\"ATE analysis for style bias\")\n268\t    parser.add_argument(\"--input-file\", required=True)\n269\t    parser.add_argument(\"--output-dir\", required=True)\n270\t    parser.add_argument(\"--alpha\", type=float, default=0.05)\n271\t    parser.add_argument(\"--sensitivity\", action=\"store_true\",\n272\t                        help=\"Run pre-registered sensitivity analyses (primary + sens1 + sens2)\")\n273\t    parser.add_argument(\"--axis\", default=\"formality\", choices=list(AXIS_CONFIG.keys()),\n274\t                        help=\"Style axis (default: formality)\")\n275\t    args = parser.parse_args()\n276\t\n277\t    global _AXIS\n278\t    _AXIS = args.axis\n279\t\n280\t    import matplotlib\n281\t    matplotlib.use(\"Agg\")\n282\t    import matplotlib.pyplot as plt\n283\t    import numpy as np\n284\t    import pandas as pd\n285\t    import seaborn as sns\n286\t    from scipy import stats\n287\t\n288\t    for name, obj in [(\"pd\", pd), (\"np\", np), (\"stats\", stats), (\"plt\", plt), (\"sns\", sns)]:\n289\t        globals()[name] = obj\n290\t\n291\t    os.makedirs(args.output_dir, exist_ok=True)\n292\t\n293\t    df = load_scored(args.input_file)\n294\t    print(f\"Loaded {len(df)} scored records\")\n295\t\n296\t    if not args.sensitivity:\n297\t        run_analysis(df, args.alpha, args.output_dir, prefix=\"ate\")\n298\t    else:\n299\t        # Pre-registered exclusion protocol: 3 analysis sets\n300\t        # Primary: NLI ≥ 0.90, no exclusion\n301\t        if \"nli_cf\" in df.columns:\n302\t            df_primary = df[df[\"nli_cf\"] >= 0.90].copy()\n303\t        else:\n304\t            df_primary = df.copy()\n305\t        print(f\"\\n{'#'*60}\")\n306\t        print(f\"  PRIMARY ANALYSIS (NLI≥0.90, n={len(df_primary)})\")\n307\t        print(f\"{'#'*60}\")\n308\t        run_analysis(df_primary, args.alpha, args.output_dir, prefix=\"ate_primary\")\n309\t\n310\t        # Sensitivity 1: primary + exclude NLI < 0.50\n311\t        if \"nli_cf\" in df.columns:\n312\t            df_sens1 = df[(df[\"nli_cf\"] >= 0.90) & (df[\"nli_cf\"] >= 0.50)].copy()\n313\t        else:\n314\t            df_sens1 = df_primary.copy()\n315\t        print(f\"\\n{'#'*60}\")\n316\t        print(f\"  SENSITIVITY 1: exclude NLI<0.50 (n={len(df_sens1)})\")\n317\t        print(f\"{'#'*60}\")\n318\t        run_analysis(df_sens1, args.alpha, args.output_dir, prefix=\"ate_sens1\")\n319\t\n320\t        # Sensitivity 2: primary + winsorize score_diff at 3σ\n321\t        df_sens2 = winsorize_score_diff(df_primary, sigma=3.0)\n322\t        print(f\"\\n{'#'*60}\")\n323\t        print(f\"  SENSITIVITY 2: winsorize at 3σ (n={len(df_sens2)})\")\n324\t        print(f\"{'#'*60}\")\n325\t        run_analysis(df_sens2, args.alpha, args.output_dir, prefix=\"ate_sens2\")\n326\t\n327\t        # Also run on ALL records for reference\n328\t        print(f\"\\n{'#'*60}\")\n329\t        print(f\"  REFERENCE: all records (n={len(df)})\")\n330\t        print(f\"{'#'*60}\")\n331\t        run_analysis(df, args.alpha, args.output_dir, prefix=\"ate_all\")\n332\t\n333\t\n334\tif __name__ == \"__main__\":\n335\t    main()\n336\t"}]},"parent_tool_use_id":"toolu_01Wj2CiaHKUBUwsCGmV3oRYB","session_id":"84c1e33b-a907-4d62-a6bc-d61bef62f953","uuid":"c8cea8f9-c940-48e6-9115-8d1a3f7178a6","timestamp":"2026-05-21T16:12:02.135Z"}
{"type":"assistant","message":{"model":"claude-opus-4-6","id":"msg_01EzVuus7ridvFCKz3Q3bjiu","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Uqexy6EU3oaQ5U8xW6qXBo","name":"Read","input":{"file_path":"/home/ubuntu/.agent-ml-research-idea_gen_0514_5/projects/causal_style_decomp_judge/artifacts/csd_pipeline/pairwise_scoring.py"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":10267,"cache_read_input_tokens":34733,"cache_creation":{"ephemeral_5m_input_tokens":10267,"ephemeral_1h_input_tokens":0},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":"toolu_01Wj2CiaHKUBUwsCGmV3oRYB","session_id":"84c1e33b-a907-4d62-a6bc-d61bef62f953","uuid":"1594f040-0f6d-49ab-afae-2935a266d6e5"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Uqexy6EU3oaQ5U8xW6qXBo","type":"tool_result","content":"1\t\"\"\"Pairwise comparison scoring via GPT-4o with position bias control.\n2\t\n3\tEach record is evaluated twice (pole_a-first and pole_b-first). Only consistent\n4\tjudgments count; inconsistent pairs are ties. Uses sign test for significance.\n5\tSupports multiple style axes: formality (formal/casual), verbosity (verbose/concise).\n6\t\n7\tInput:  verified.jsonl (all records, no filtering)\n8\tOutput: pairwise_results.jsonl — per-record with trial1/trial2/consistent/pole_a_wins\n9\t        pairwise_summary.csv — aggregated stats\n10\tDeps:   openai (async client), asyncio, scipy\n11\t\"\"\"\n12\t\n13\timport argparse\n14\timport asyncio\n15\timport csv\n16\timport json\n17\timport logging\n18\timport os\n19\timport re\n20\timport time\n21\t\n22\tlogger = logging.getLogger(__name__)\n23\t\n24\tAXIS_CONFIG = {\n25\t    \"formality\": {\"poles\": (\"formal\", \"casual\"), \"field\": \"original_formality\"},\n26\t    \"verbosity\": {\"poles\": (\"verbose\", \"concise\"), \"field\": \"original_verbosity\"},\n27\t    \"tone\": {\"poles\": (\"assertive\", \"hedging\"), \"field\": \"original_tone\"},\n28\t    \"rate_control\": {\"poles\": (\"original\", \"rewritten\"), \"field\": \"rate_role\"},\n29\t    \"register\": {\"poles\": (\"academic\", \"conversational\"), \"field\": \"original_register\"},\n30\t}\n31\t\n32\tPAIRWISE_SYSTEM = (\n33\t    \"You are an expert evaluator of AI assistant responses. \"\n34\t    \"Compare the two responses below and pick the better one.\"\n35\t)\n36\t\n37\tPAIRWISE_USER_TEMPLATE = \"\"\"Instruction: {instruction}\n38\t\n39\tResponse A:\n40\t{response_a}\n41\t\n42\tResponse B:\n43\t{response_b}\n44\t\n45\tWhich response is better in terms of overall quality (helpfulness, accuracy, completeness, coherence)?\n46\tOutput ONLY \"A\" or \"B\".\"\"\"\n47\t\n48\t\n49\tdef parse_choice(text: str) -> str | None:\n50\t    text = text.strip().upper()\n51\t    if text in (\"A\", \"B\"):\n52\t        return text\n53\t    m = re.search(r\"\\b([AB])\\b\", text)\n54\t    return m.group(1) if m else None\n55\t\n56\t\n57\tclass RateLimiter:\n58\t    def __init__(self, max_per_minute: int):\n59\t        self._interval = 60.0 / max_per_minute\n60\t        self._last = 0.0\n61\t        self._lock = asyncio.Lock()\n62\t\n63\t    async def acquire(self):\n64\t        async with self._lock:\n65\t            now = time.monotonic()\n66\t            wait = self._interval - (now - self._last)\n67\t            if wait > 0:\n68\t                await asyncio.sleep(wait)\n69\t            self._last = time.monotonic()\n70\t\n71\t\n72\tasync def compare_one(\n73\t    client, model: str, instruction: str,\n74\t    response_a: str, response_b: str,\n75\t    limiter: RateLimiter, max_retries: int = 3,\n76\t) -> str | None:\n77\t    messages = [\n78\t        {\"role\": \"system\", \"content\": PAIRWISE_SYSTEM},\n79\t        {\"role\": \"user\", \"content\": PAIRWISE_USER_TEMPLATE.format(\n80\t            instruction=instruction, response_a=response_a, response_b=response_b\n81\t        )},\n82\t    ]\n83\t    for attempt in range(max_retries):\n84\t        await limiter.acquire()\n85\t        try:\n86\t            resp = await client.chat.completions.create(\n87\t                model=model, messages=messages, temperature=0.0, max_tokens=8,\n88\t            )\n89\t            text = resp.choices[0].message.content.strip()\n90\t            choice = parse_choice(text)\n91\t            if choice is not None:\n92\t                return choice\n93\t            logger.warning(\"Could not parse choice from '%s', retrying\", text)\n94\t        except Exception as e:\n95\t            logger.warning(\"API error (attempt %d/%d): %s\", attempt + 1, max_retries, e)\n96\t            if attempt < max_retries - 1:\n97\t                await asyncio.sleep(2 ** attempt)\n98\t    return None\n99\t\n100\t\n101\tasync def score_record_dual(\n102\t    client, model: str, rec: dict,\n103\t    semaphore: asyncio.Semaphore, limiter: RateLimiter, max_retries: int,\n104\t    axis: str = \"formality\",\n105\t) -> dict:\n106\t    \"\"\"Run two trials per record: pole_a-first and pole_b-first.\"\"\"\n107\t    cfg = AXIS_CONFIG[axis]\n108\t    pole_a, pole_b = cfg[\"poles\"]\n109\t    field = cfg[\"field\"]\n110\t\n111\t    async with semaphore:\n112\t        instruction = rec[\"instruction\"]\n113\t        original_pole = rec[field]\n114\t\n115\t        if original_pole == pole_a:\n116\t            text_a = rec[\"original_text\"]\n117\t            text_b = rec[\"counterfactual_text\"]\n118\t        else:\n119\t            text_a = rec[\"counterfactual_text\"]\n120\t            text_b = rec[\"original_text\"]\n121\t\n122\t        # Trial 1: A=pole_a, B=pole_b\n123\t        t1_raw = await compare_one(\n124\t            client, model, instruction, text_a, text_b, limiter, max_retries\n125\t        )\n126\t        t1_prefers_a = (t1_raw == \"A\") if t1_raw else None\n127\t\n128\t        # Trial 2: A=pole_b, B=pole_a\n129\t        t2_raw = await compare_one(\n130\t            client, model, instruction, text_b, text_a, limiter, max_retries\n131\t        )\n132\t        t2_prefers_a = (t2_raw == \"B\") if t2_raw else None\n133\t\n134\t        if t1_prefers_a is not None and t2_prefers_a is not None:\n135\t            consistent = (t1_prefers_a == t2_prefers_a)\n136\t            pole_a_wins = t1_prefers_a if consistent else None\n137\t        else:\n138\t            consistent = None\n139\t            pole_a_wins = None\n140\t\n141\t        return {\n142\t            \"id\": rec[\"id\"],\n143\t            \"instruction\": rec[\"instruction\"],\n144\t            f\"original_{axis}\": original_pole,\n145\t            \"nli_cf\": rec.get(\"nli_cf\"),\n146\t            \"bertscore_cf\": rec.get(\"bertscore_cf\"),\n147\t            \"trial1_choice\": t1_raw,\n148\t            f\"trial1_prefers_{pole_a}\": t1_prefers_a,\n149\t            \"trial2_choice\": t2_raw,\n150\t            f\"trial2_prefers_{pole_a}\": t2_prefers_a,\n151\t            \"consistent\": consistent,\n152\t            f\"{pole_a}_wins\": pole_a_wins,\n153\t        }\n154\t\n155\t\n156\tdef load_processed_ids(output_file: str) -> set[str]:\n157\t    ids = set()\n158\t    if os.path.exists(output_file):\n159\t        with open(output_file) as f:\n160\t            for line in f:\n161\t                if line.strip():\n162\t                    ids.add(json.loads(line)[\"id\"])\n163\t    return ids\n164\t\n165\t\n166\tasync def run(args):\n167\t    api_key = [REDACTED] or os.environ.get(\"OPENAI_API_KEY\")\n168\t    if not api_key:[REDACTED]        raise ValueError(\"Set OPENAI_API_KEY or pass --api-key\")\n170\t\n171\t    from openai import AsyncOpenAI\n172\t    base_url = args.base_url or os.environ.get(\"OPENAI_BASE_URL\")\n173\t    client = AsyncOpenAI(api_key=[REDACTED], base_url=base_url) if base_url else AsyncOpenAI(api_key=[REDACTED]    with open(args.input_file) as f:\n176\t        records = [json.loads(line) for line in f if line.strip()]\n177\t\n178\t    processed_ids = load_processed_ids(args.output_file)\n179\t    todo = [r for r in records if r[\"id\"] not in processed_ids]\n180\t    logger.info(\"Total: %d, already done: %d, to score: %d\", len(records), len(processed_ids), len(todo))\n181\t\n182\t    if not todo:\n183\t        logger.info(\"Nothing to do\")\n184\t        return\n185\t\n186\t    semaphore = asyncio.Semaphore(args.max_concurrent)\n187\t    limiter = RateLimiter(args.rate_limit)\n188\t\n189\t    tasks = [\n190\t        score_record_dual(client, args.model, rec, semaphore, limiter, args.retry, axis=args.axis)\n191\t        for rec in todo\n192\t    ]\n193\t\n194\t    os.makedirs(os.path.dirname(args.output_file) or \".\", exist_ok=True)\n195\t\n196\t    with open(args.output_file, \"a\") as fout:\n197\t        for coro in asyncio.as_completed(tasks):\n198\t            result = await coro\n199\t            fout.write(json.dumps(result, ensure_ascii=False) + \"\\n\")\n200\t            fout.flush()\n201\t            pole_a = AXIS_CONFIG[args.axis][\"poles\"][0]\n202\t            logger.info(\n203\t                \"Compared %s: t1=%s t2=%s consistent=%s %s_wins=%s\",\n204\t                result[\"id\"], result[\"trial1_choice\"], result[\"trial2_choice\"],\n205\t                result[\"consistent\"], pole_a, result.get(f\"{pole_a}_wins\"),\n206\t            )\n207\t\n208\t\n209\tdef analyze(input_file: str, output_dir: str, axis: str = \"formality\"):\n210\t    from scipy import stats\n211\t\n212\t    cfg = AXIS_CONFIG[axis]\n213\t    pole_a, pole_b = cfg[\"poles\"]\n214\t    field = cfg[\"field\"]\n215\t    wins_key = f\"{pole_a}_wins\"\n216\t\n217\t    with open(input_file) as f:\n218\t        records = [json.loads(line) for line in f if line.strip()]\n219\t\n220\t    total = len(records)\n221\t    valid = [r for r in records if r.get(\"trial1_choice\") and r.get(\"trial2_choice\")]\n222\t    consistent = [r for r in valid if r.get(\"consistent\") is True]\n223\t    ties = [r for r in valid if r.get(\"consistent\") is False]\n224\t\n225\t    print(f\"\\n{'='*60}\")\n226\t    print(f\"  Pairwise Comparison (Position-Controlled) — {axis}\")\n227\t    print(f\"{'='*60}\")\n228\t    print(f\"  Total records: {total}\")\n229\t    print(f\"  Valid (both trials): {len(valid)}\")\n230\t    print(f\"  Consistent: {len(consistent)} ({len(consistent)/len(valid)*100:.1f}%)\")\n231\t    print(f\"  Ties (inconsistent): {len(ties)} ({len(ties)/len(valid)*100:.1f}%)\")\n232\t\n233\t    t1_a = sum(1 for r in valid if r[\"trial1_choice\"] == \"A\")\n234\t    t2_a = sum(1 for r in valid if r[\"trial2_choice\"] == \"A\")\n235\t    print(f\"\\n  Position bias:\")\n236\t    print(f\"    Trial 1 chose A: {t1_a}/{len(valid)} ({t1_a/len(valid)*100:.1f}%)\")\n237\t    print(f\"    Trial 2 chose A: {t2_a}/{len(valid)} ({t2_a/len(valid)*100:.1f}%)\")\n238\t    total_a = t1_a + t2_a\n239\t    total_trials = 2 * len(valid)\n240\t    print(f\"    Overall A rate: {total_a}/{total_trials} ({total_a/total_trials*100:.1f}%)\")\n241\t\n242\t    n_consistent = len(consistent)\n243\t    a_wins = sum(1 for r in consistent if r[wins_key] is True)\n244\t    b_wins = n_consistent - a_wins\n245\t\n246\t    print(f\"\\n{'='*60}\")\n247\t    print(f\"  Overall Results (consistent pairs only)\")\n248\t    print(f\"{'='*60}\")\n249\t    print(f\"  N = {n_consistent}\")\n250\t    print(f\"  {pole_a} wins: {a_wins} ({a_wins/n_consistent*100:.1f}%)\")\n251\t    print(f\"  {pole_b} wins: {b_wins} ({b_wins/n_consistent*100:.1f}%)\")\n252\t\n253\t    sign_p = stats.binomtest(a_wins, n_consistent, 0.5).pvalue\n254\t    win_rate = a_wins / n_consistent\n255\t    z = 1.96\n256\t    denom = 1 + z**2 / n_consistent\n257\t    center = (win_rate + z**2 / (2 * n_consistent)) / denom\n258\t    spread = z * (win_rate * (1 - win_rate) / n_consistent + z**2 / (4 * n_consistent**2))**0.5 / denom\n259\t    ci_lo, ci_hi = max(0, center - spread), min(1, center + spread)\n260\t\n261\t    print(f\"  {pole_a} win rate: {win_rate:.4f}\")\n262\t    print(f\"  95% CI (Wilson): [{ci_lo:.4f}, {ci_hi:.4f}]\")\n263\t    print(f\"  Sign test p-value: {sign_p:.6f}\")\n264\t\n265\t    print(f\"\\n{'='*60}\")\n266\t    print(\"  Directional Analysis (consistent only)\")\n267\t    print(f\"{'='*60}\")\n268\t    dir_rows = []\n269\t    for direction in [pole_a, pole_b]:\n270\t        sub = [r for r in consistent if r.get(field) == direction]\n271\t        if not sub:\n272\t            continue\n273\t        ns = len(sub)\n274\t        fw = sum(1 for r in sub if r[wins_key] is True)\n275\t        wr = fw / ns if ns > 0 else 0\n276\t        bp = stats.binomtest(fw, ns, 0.5).pvalue\n277\t        target = pole_b if direction == pole_a else pole_a\n278\t        label = f\"{direction}→{target}\"\n279\t        print(f\"\\n  {label} (n={ns})\")\n280\t        print(f\"    {pole_a} wins: {fw} ({fw/ns*100:.1f}%), p={bp:.6f}\")\n281\t        if direction == pole_a:\n282\t            print(f\"    ({pole_a}=original, {pole_b}=rewrite → {pole_a} win = prefer original)\")\n283\t        else:\n284\t            print(f\"    ({pole_b}=original, {pole_a}=rewrite → {pole_a} win = prefer rewrite)\")\n285\t        dir_rows.append({\"group\": label, \"n\": ns, f\"{pole_a}_wins\": fw,\n286\t                         \"win_rate\": wr, \"p_value\": bp})\n287\t\n288\t    print(f\"\\n{'='*60}\")\n289\t    print(\"  NLI-Stratified Analysis (consistent only)\")\n290\t    print(f\"{'='*60}\")\n291\t    strat_rows = []\n292\t    for label, filt in [\n293\t        (\"NLI≥0.90\", lambda r: r.get(\"nli_cf\", 0) >= 0.90),\n294\t        (\"All\", lambda r: True),\n295\t    ]:\n296\t        sub = [r for r in consistent if filt(r)]\n297\t        ns = len(sub)\n298\t        if ns == 0:\n299\t            continue\n300\t        fw = sum(1 for r in sub if r[wins_key] is True)\n301\t        wr = fw / ns\n302\t        bp = stats.binomtest(fw, ns, 0.5).pvalue\n303\t        print(f\"  {label} (n={ns}): {pole_a} wins {fw} ({fw/ns*100:.1f}%), p={bp:.6f}\")\n304\t        strat_rows.append({\"group\": label, \"n\": ns, f\"{pole_a}_wins\": fw,\n305\t                           \"win_rate\": wr, \"p_value\": bp})\n306\t\n307\t    os.makedirs(output_dir, exist_ok=True)\n308\t    summary_rows = [\n309\t        {\"group\": \"overall\", \"n\": n_consistent, f\"{pole_a}_wins\": a_wins,\n310\t         f\"{pole_b}_wins\": b_wins, \"win_rate\": win_rate, \"ci_lo\": ci_lo,\n311\t         \"ci_hi\": ci_hi, \"sign_test_p\": sign_p, \"ties\": len(ties),\n312\t         \"consistency_rate\": len(consistent) / len(valid) if valid else 0,\n313\t         \"position_a_rate\": total_a / total_trials if total_trials else 0},\n314\t    ]\n315\t    csv_path = os.path.join(output_dir, \"pairwise_summary.csv\")\n316\t    fieldnames = list(summary_rows[0].keys())\n317\t    with open(csv_path, \"w\", newline=\"\") as f:\n318\t        writer = csv.DictWriter(f, fieldnames=fieldnames)\n319\t        writer.writeheader()\n320\t        writer.writerow(summary_rows[0])\n321\t    print(f\"\\nSaved summary to {csv_path}\")\n322\t\n323\t    detail_path = os.path.join(output_dir, \"pairwise_detailed.csv\")\n324\t    detail_fields = [\"group\", \"n\", f\"{pole_a}_wins\", \"win_rate\", \"p_value\"]\n325\t    with open(detail_path, \"w\", newline=\"\") as f:\n326\t        writer = csv.DictWriter(f, fieldnames=detail_fields)\n327\t        writer.writeheader()\n328\t        for row in dir_rows + strat_rows:\n329\t            writer.writerow(row)\n330\t    print(f\"Saved detailed to {detail_path}\")\n331\t\n332\t\n333\tdef main():\n334\t    parser = argparse.ArgumentParser(description=\"Position-controlled pairwise comparison scoring\")\n335\t    parser.add_argument(\"--input-file\", required=True)\n336\t    parser.add_argument(\"--output-file\", required=True)\n337\t    parser.add_argument(\"--model\", default=\"gpt-4o\")\n338\t    parser.add_argument(\"--api-key\", default=None)\n339\t    parser.add_argument(\"--base-url\", default=\"http://47.94.22.126/v1\")\n340\t    parser.add_argument(\"--max-concurrent\", type=int, default=5)\n341\t    parser.add_argument(\"--rate-limit\", type=int, default=60)\n342\t    parser.add_argument(\"--retry\", type=int, default=3)\n343\t    parser.add_argument(\"--analyze-only\", action=\"store_true\")\n344\t    parser.add_argument(\"--analysis-dir\", default=None)\n345\t    parser.add_argument(\"--axis\", default=\"formality\", choices=list(AXIS_CONFIG.keys()),\n346\t                        help=\"Style axis (default: formality)\")\n347\t    args = parser.parse_args()\n348\t\n349\t    logging.basicConfig(level=logging.INFO, format=\"%(asctime)s %(levelname)s %(message)s\")\n350\t\n351\t    if args.analyze_only:\n352\t        analysis_dir = args.analysis_dir or os.path.dirname(args.output_file) or \".\"\n353\t        analyze(args.output_file, analysis_dir, axis=args.axis)\n354\t    else:\n355\t        asyncio.run(run(args))\n356\t        analysis_dir = args.analysis_dir or os.path.dirname(args.output_file) or \".\"\n357\t        analyze(args.output_file, analysis_dir, axis=args.axis)\n358\t\n359\t\n360\tif __name__ == \"__main__\":\n361\t    main()\n362\t"}]},"parent_tool_use_id":"toolu_01Wj2CiaHKUBUwsCGmV3oRYB","session_id":"84c1e33b-a907-4d62-a6bc-d61bef62f953","uuid":"b90b7946-2be1-42eb-9259-cf3f128abdae","timestamp":"2026-05-21T16:12:03.164Z"}
