\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Logistic decomposition of formality preference (Form.\ OR) and original preference (Orig.\ OR). GPT-4o$\times $LLMBar achieves clean decomposition: formality OR (2.21, $p{=}0.010$) exceeds original OR (1.82, $p{=}0.052$). Gemini$\times $LLMBar shows the reverse: original preference is significant and exceeds formality OR.}}{6}{table.4}\protected@file@percent }
\newlabel{tab:decomp}{{4}{6}{Logistic decomposition of formality preference (Form.\ OR) and original preference (Orig.\ OR). GPT-4o$\times $LLMBar achieves clean decomposition: formality OR (2.21, $p{=}0.010$) exceeds original OR (1.82, $p{=}0.052$). Gemini$\times $LLMBar shows the reverse: original preference is significant and exceeds formality OR}{table.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Scaled replication at $n{=}500$ (GPT-4o$\times $LLMBar). $n_\text  {eff}$: effective sample size (position-consistent pairs for pairwise; non-tie pairs for binarized Likert; all NLI-passed for Likert ATE). $n_{80\%}$: total $n$ required for 80\% power. Pairwise is ${\sim }7\times $ more sample-efficient than binarized Likert.}}{6}{table.5}\protected@file@percent }
\newlabel{tab:scaled}{{5}{6}{Scaled replication at $n{=}500$ (GPT-4o$\times $LLMBar). $n_\text {eff}$: effective sample size (position-consistent pairs for pairwise; non-tie pairs for binarized Likert; all NLI-passed for Likert ATE). $n_{80\%}$: total $n$ required for 80\% power. Pairwise is ${\sim }7\times $ more sample-efficient than binarized Likert}{table.5}{}}
