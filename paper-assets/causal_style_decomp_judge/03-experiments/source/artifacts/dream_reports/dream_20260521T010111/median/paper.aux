\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Rewriter robustness check. Both rewriters detect significant formality preference. The 6.6pp difference is not statistically significant ($\chi ^2$ $p{=}0.43$) and falls within the Qwen CI [56.0\%, 79.7\%].}}{7}{table.6}\protected@file@percent }
\newlabel{tab:rewriter}{{6}{7}{Rewriter robustness check. Both rewriters detect significant formality preference. The 6.6pp difference is not statistically significant ($\chi ^2$ $p{=}0.43$) and falls within the Qwen CI [56.0\%, 79.7\%]}{table.6}{}}
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces NLI gate validation against human judgments. The raw Cohen's $\kappa $ (0.43) is depressed by extreme class imbalance (prevalence index$=$0.83; 95/100 human-pass). The prevalence-adjusted $\kappa $ (PABAK$=$0.82) indicates excellent agreement. High precision (98.9\%) ensures that pairs passing the NLI gate are reliably content-preserving.}}{7}{table.7}\protected@file@percent }
\newlabel{tab:human_nli}{{7}{7}{NLI gate validation against human judgments. The raw Cohen's $\kappa $ (0.43) is depressed by extreme class imbalance (prevalence index$=$0.83; 95/100 human-pass). The prevalence-adjusted $\kappa $ (PABAK$=$0.82) indicates excellent agreement. High precision (98.9\%) ensures that pairs passing the NLI gate are reliably content-preserving}{table.7}{}}
