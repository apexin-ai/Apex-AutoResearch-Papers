\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Multi-judge formality pairwise results on LLMBar. $n_\text  {cons}$: position-consistent pairs. Win\%: formal variant win rate. $p$: two-sided sign test. GPT-4o and Gemini-Flash show significant formality preference; Claude-Sonnet is non-significant, possibly due to insufficient power at $n{=}50$ consistent pairs (MDE$\approx $0.18).}}{4}{table.1}\protected@file@percent }
\newlabel{tab:multijudge}{{1}{4}{Multi-judge formality pairwise results on LLMBar. $n_\text {cons}$: position-consistent pairs. Win\%: formal variant win rate. $p$: two-sided sign test. GPT-4o and Gemini-Flash show significant formality preference; Claude-Sonnet is non-significant, possibly due to insufficient power at $n{=}50$ consistent pairs (MDE$\approx $0.18)}{table.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Formal win rate ($p$-value) across 9 judge$\times $benchmark cells. \textbf  {Bold green}: $p{<}0.05$. \textit  {Italic gold}: $p{<}0.10$. Gray: non-significant. Bottom row: NLI pass rate per benchmark. Benchmark ordering: LLMBar $\gg $ AlpacaEval $>$ MT-Bench.}}{4}{table.2}\protected@file@percent }
\newlabel{tab:fullgrid}{{2}{4}{Formal win rate ($p$-value) across 9 judge$\times $benchmark cells. \textbf {Bold green}: $p{<}0.05$. \textit {Italic gold}: $p{<}0.10$. Gray: non-significant. Bottom row: NLI pass rate per benchmark. Benchmark ordering: LLMBar $\gg $ AlpacaEval $>$ MT-Bench}{table.2}{}}
