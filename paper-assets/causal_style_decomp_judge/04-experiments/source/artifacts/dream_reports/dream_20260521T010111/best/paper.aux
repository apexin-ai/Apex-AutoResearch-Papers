\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces The Likert Blindspot across the full judge$\times $benchmark grid. Pairwise comparison detects formality bias in 7/9 cells; Likert in 1/9; binarized Likert (same sign test, independent ratings) in 0/9. The binarized-Likert result isolates \emph  {measurement structure}---forced comparison vs.\ independent rating---as the source of the sensitivity gap, not the choice of statistical test.}}{5}{table.caption.12}\protected@file@percent }
\newlabel{tab:blindspot}{{3}{5}{The Likert Blindspot across the full judge$\times $benchmark grid. Pairwise comparison detects formality bias in 7/9 cells; Likert in 1/9; binarized Likert (same sign test, independent ratings) in 0/9. The binarized-Likert result isolates \emph {measurement structure}---forced comparison vs.\ independent rating---as the source of the sensitivity gap, not the choice of statistical test}{table.caption.12}{}}
\@LN@col{1}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Original preference control on LLMBar. Original-preference win rates are non-significant across all judges. Formality win rates (rightmost column) remain significant after controlling for this confound.}}{5}{table.caption.13}\protected@file@percent }
\newlabel{tab:origpref}{{4}{5}{Original preference control on LLMBar. Original-preference win rates are non-significant across all judges. Formality win rates (rightmost column) remain significant after controlling for this confound}{table.caption.13}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Scaled replication: GPT-4o$\times $MT-Bench at $n = 500$. Effect size is stable; confidence interval halves. Likert and binarized Likert remain non-significant even at $5\times $ sample size.}}{5}{table.caption.14}\protected@file@percent }
\newlabel{tab:scaled}{{5}{5}{Scaled replication: GPT-4o$\times $MT-Bench at $n = 500$. Effect size is stable; confidence interval halves. Likert and binarized Likert remain non-significant even at $5\times $ sample size}{table.caption.14}{}}
