\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Four-judge evidence matrix (LLMBar, $n \approx 88$ NLI-passed pairs per cell). BT significance: ***$p<.001$, \textsuperscript  {\dag  }$p<.10$. \textbf  {Key finding}: GPT-4o and Qwen3-32B show significant style bias on both axes; Claude and Llama show none. \emph  {No Likert comparison reaches significance for any judge on any axis.}}}{3}{table.caption.8}\protected@file@percent }
