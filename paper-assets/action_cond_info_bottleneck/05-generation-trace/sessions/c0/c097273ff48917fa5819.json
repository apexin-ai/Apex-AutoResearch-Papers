              "command": "cat > /root/acib/scripts/run_remaining_suites_eval.sh << 'SCRIPT_EOF'\n#!/bin/bash\n# Eval remaining suites for a given model.\n#\n# Usage:\n#   bash run_remaining_suites_eval.sh <model_path> <gpu_id> <suite_list> <output_dir>\n#\n# Examples:\n#   # Run 3 remaining suites for baseline_std\n#   bash run_remaining_suites_eval.sh lerobot/smolvla_libero 1 \"libero_object libero_goal libero_10\" /root/acib/outputs/baseline_std_v3\n#\n#   # Run 3 remaining suites for baseline_plus\n#   bash run_remaining_suites_eval.sh lerobot/smolvla_libero_plus 0 \"libero_object libero_goal libero_10\" /root/acib/outputs/baseline_plus_v2\n#\n#   # Run a single suite\n#   bash run_remaining_suites_eval.sh lerobot/smolvla_libero 1 \"libero_goal\" /root/acib/outputs/baseline_std_v3\n#\n# Suite names: libero_spatial, libero_object, libero_goal, libero_10\n# Each suite: 10 tasks × 50 episodes\n\nset -e\n\nMODEL_PATH=\"${1:?Usage: $0 <model_path> <gpu_id> <suite_list> <output_dir>}\"\nGPU_ID=\"${2:?Missing gpu_id}\"\nSUITE_LIST=\"${3:?Missing suite_list (space-separated)}\"\nOUTPUT_DIR=\"${4:?Missing output_dir}\"\n\nsource /root/miniconda3/etc/profile.d/conda.sh && conda activate base\nsource /etc/network_turbo\nexport HF_HOME=/root/autodl-tmp/.hf_cache\nexport REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt\nexport SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt\nexport HF_HUB_DISABLE_XET=1\nexport MUJOCO_GL=egl\nexport PYOPENGL_PLATFORM=egl\nexport CUDA_VISIBLE_DEVICES=$GPU_ID\n\nRENAME_MAP='{\"observation.images.image\": \"observation.images.camera1\", \"observation.images.image2\": \"observation.images.camera2\"}'\n\ncd /root/acib\n\necho \"$(date '+%Y-%m-%d %H:%M:%S') Starting eval\"\necho \"  Model: $MODEL_PATH\"\necho \"  GPU: $GPU_ID\"\necho \"  Suites: $SUITE_LIST\"\necho \"  Output: $OUTPUT_DIR\"\n\nfor suite in $SUITE_LIST; do\n    echo \"$(date '+%Y-%m-%d %H:%M:%S') === Starting suite: $suite ===\"\n    lerobot-eval \\\n        --policy.path=$MODEL_PATH \\\n        --env.type=libero \\\n        --env.task=$suite \\\n        --eval.n_episodes=50 \\\n        --eval.batch_size=1 \\\n        --env.max_parallel_tasks=1 \\\n        --policy.empty_cameras=1 \\\n        --rename_map=\"$RENAME_MAP\" \\\n        --output_dir=${OUTPUT_DIR}/$suite\n    echo \"$(date '+%Y-%m-%d %H:%M:%S') === Finished suite: $suite ===\"\ndone\n\necho \"$(date '+%Y-%m-%d %H:%M:%S') All suites completed.\"\nSCRIPT_EOF\nchmod +x /root/acib/scripts/run_remaining_suites_eval.sh",
