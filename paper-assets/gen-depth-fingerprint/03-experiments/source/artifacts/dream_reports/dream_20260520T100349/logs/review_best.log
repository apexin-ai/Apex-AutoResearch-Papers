{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01N7uWodo9b7H6nFcedD357w","type":"tool_result","content":"1\tThis appendix presents feature ablation results supporting the complementarity analysis in \\S\\ref{sec:results-differential}.\n2\t\n3\t\\begin{table}[t]\n4\t\\centering\n5\t\\footnotesize\n6\t\\begin{tabular}{lcc}\n7\t\\toprule\n8\t\\textbf{Feature set} & \\textbf{F1} & \\textbf{Top feature (imp.)} \\\\\n9\t\\midrule\n10\tFull (7 features)     & 0.773 & hapax\\_ratio (0.35) \\\\\n11\tSurface only (2)      & 0.688 & hapax\\_ratio (0.41) \\\\\n12\tReference only (5)    & 0.713 & entropy\\_mean (0.27) \\\\\n13\t\\bottomrule\n14\t\\end{tabular}\n15\t\\caption{Feature ablation (8-gen, 10-fold stratified CV, 3-class). Full $>$ surface (+8.5\\,pp) and Full $>$ reference (+6.0\\,pp) confirms complementarity.}\n16\t\\label{tab:ablation}\n17\t\\end{table}\n18\t"}]},"parent_tool_use_id":"toolu_01Aa4LbC8tVN8tPubtpYmsUq","session_id":"d4cded27-964c-4711-9220-b05f8309dff9","uuid":"03899edd-73c0-4be2-8c86-5f383612a7f1","timestamp":"2026-05-20T10:44:42.375Z"}
