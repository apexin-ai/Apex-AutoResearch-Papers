\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces 3-class LOGO F1 across reference models (6-generator subset). Spread = 0.024pp. All configurations show negative entropy drift, confirming depth signal is generation-intrinsic, not a reference-model artifact.}}{6}{table.5}\protected@file@percent }
\newlabel{tab:crossref}{{5}{6}{3-class LOGO F1 across reference models (6-generator subset). Spread = 0.024pp. All configurations show negative entropy drift, confirming depth signal is generation-intrinsic, not a reference-model artifact}{table.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Continuation vs.\ paraphrastic chains. Continuation chains retain significantly more depth signal (+5pp 3-class, +8pp binary). Spearman $\rho $ signs are consistent across chain types (all drifting features negative), but magnitudes are attenuated for paraphrastic chains.}}{6}{table.6}\protected@file@percent }
\newlabel{tab:paraphrastic}{{6}{6}{Continuation vs.\ paraphrastic chains. Continuation chains retain significantly more depth signal (+5pp 3-class, +8pp binary). Spearman $\rho $ signs are consistent across chain types (all drifting features negative), but magnitudes are attenuated for paraphrastic chains}{table.6}{}}
