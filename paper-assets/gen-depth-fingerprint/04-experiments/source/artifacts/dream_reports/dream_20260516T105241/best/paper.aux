\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Per-generator held-out F1 under LOGO evaluation (3-class). Smaller generators ($\leq $1B) are easier to classify; the scale gradient is consistent with the location-shift theory (smaller models exhibit more pronounced drift). Overall binary LOGO F1 = 0.73; 3-class LOGO F1 = 0.78.}}{5}{table.3}\protected@file@percent }
\newlabel{tab:logo}{{3}{5}{Per-generator held-out F1 under LOGO evaluation (3-class). Smaller generators ($\leq $1B) are easier to classify; the scale gradient is consistent with the location-shift theory (smaller models exhibit more pronounced drift). Overall binary LOGO F1 = 0.73; 3-class LOGO F1 = 0.78}{table.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Binary LOGO F1 (gen-1 vs.\ gen-2+) across 9 generators. Our 7-feature ensemble outperforms the best single baseline (Avg-LogProb) by +3.0pp and the 4-baseline ensemble by +2.0pp ($p < 0.001$, paired bootstrap). Per-generator F1 std for the 7-feature ensemble (0.056) is lower than Avg-LogProb (${\sim }$0.09), indicating more stable cross-generator performance.}}{5}{table.4}\protected@file@percent }
\newlabel{tab:baselines}{{4}{5}{Binary LOGO F1 (gen-1 vs.\ gen-2+) across 9 generators. Our 7-feature ensemble outperforms the best single baseline (Avg-LogProb) by +3.0pp and the 4-baseline ensemble by +2.0pp ($p < 0.001$, paired bootstrap). Per-generator F1 std for the 7-feature ensemble (0.056) is lower than Avg-LogProb (${\sim }$0.09), indicating more stable cross-generator performance}{table.4}{}}
