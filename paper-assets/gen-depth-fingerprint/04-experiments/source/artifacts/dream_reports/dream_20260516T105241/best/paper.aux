\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces QLoRA fine-tuned LM vs.\ XGBoost on 7 handcrafted features. The neural model captures substantially more depth signal from raw text, but at $>$100$\times $ training cost. Per-class 5-class F1 for QLoRA: depth-0 = 0.999, depth-1 = 0.80, depth-2 = 0.40, depth-3 = 0.32, depth-4 = 0.42.}}{10}{table.8}\protected@file@percent }
\newlabel{tab:qlora}{{8}{10}{QLoRA fine-tuned LM vs.\ XGBoost on 7 handcrafted features. The neural model captures substantially more depth signal from raw text, but at $>$100$\times $ training cost. Per-class 5-class F1 for QLoRA: depth-0 = 0.999, depth-1 = 0.80, depth-2 = 0.40, depth-3 = 0.32, depth-4 = 0.42}{table.8}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {A.3}Continuation vs.\ Paraphrastic Detailed Results}{10}{subsection.A.3}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces Spearman $\rho $ comparison. All signs consistent; paraphrastic magnitudes attenuated by 0.08--0.15, reflecting attractor convergence compressing the drift space. Cross-transfer F1: cont$\to $para = 0.74, para$\to $cont = 0.77 ($n_{\text  {para}} = 4{,}900$ clean chains).}}{10}{table.9}\protected@file@percent }
\newlabel{tab:para_detail}{{9}{10}{Spearman $\rho $ comparison. All signs consistent; paraphrastic magnitudes attenuated by 0.08--0.15, reflecting attractor convergence compressing the drift space. Cross-transfer F1: cont$\to $para = 0.74, para$\to $cont = 0.77 ($n_{\text {para}} = 4{,}900$ clean chains)}{table.9}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {A.4}rp-LOFO Sensitivity Analysis}{10}{subsection.A.4}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {10}{\ignorespaces rp-LOFO analysis: classifiers trained on 8 generators ($r_p = 1.0$), tested on $r_p = 1.1$ data. Reference features (entropy mean) are $r_p$-invariant ($\Delta \rho < 0.01$); surface features (hapax, TTR) show mild suppression ($\Delta \rho \approx 0.03$). Both pass the $\geq $0.70 gate, justifying Gemma's inclusion in main results.}}{10}{table.10}\protected@file@percent }
\newlabel{tab:rplofo}{{10}{10}{rp-LOFO analysis: classifiers trained on 8 generators ($r_p = 1.0$), tested on $r_p = 1.1$ data. Reference features (entropy mean) are $r_p$-invariant ($\Delta \rho < 0.01$); surface features (hapax, TTR) show mild suppression ($\Delta \rho \approx 0.03$). Both pass the $\geq $0.70 gate, justifying Gemma's inclusion in main results}{table.10}{}}
