\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Feature-depth Spearman $\rho $ on the MVP dataset (Pythia-2.8B, individual-level, bootstrap 95\% CIs all exclude 0 for drifting features). Features partition into drifting ($|\rho | > 0.35$) and stationary ($|\rho | < 0.12$) groups, consistent with a location-shift model.}}{4}{table.1}\protected@file@percent }
\newlabel{tab:spearman}{{1}{4}{Feature-depth Spearman $\rho $ on the MVP dataset (Pythia-2.8B, individual-level, bootstrap 95\% CIs all exclude 0 for drifting features). Features partition into drifting ($|\rho | > 0.35$) and stationary ($|\rho | < 0.12$) groups, consistent with a location-shift model}{table.1}{}}
