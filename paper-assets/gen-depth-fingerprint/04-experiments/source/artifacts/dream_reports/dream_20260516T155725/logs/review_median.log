{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DXx5pj3XMLarYDEJxtmyos","type":"tool_result","content":"1\t% EMNLP 2026 ARR Submission — ACL 2023 Template\n2\t\\documentclass[11pt]{article}\n3\t\\usepackage[review]{acl}\n4\t\\usepackage{times}\n5\t\\usepackage{latexsym}\n6\t\\usepackage{graphicx}\n7\t\\usepackage{booktabs}\n8\t\\usepackage{enumitem}\n9\t\\usepackage{amsmath}\n10\t\n11\t\\graphicspath{{../chart/}}\n12\t\n13\t\\title{Depth Fingerprinting: Ordinal Generation Depth Estimation\\\\in Non-Paraphrastic LLM Text Chains}\n14\t\n15\t\\author{Anonymous}\n16\t\n17\t\\begin{document}\n18\t\\maketitle\n19\t\n20\t\\input{abstract}\n21\t\n22\t\\input{introduction}\n23\t\\input{related_work}\n24\t\\input{method}\n25\t\\input{results}\n26\t\n27\t\\input{discussion}\n28\t\\input{conclusion}\n29\t\\input{limitations}\n30\t\\input{ethics}\n31\t\n32\t\\bibliography{references}\n33\t\n34\t\\appendix\n35\t\\section{Length Confound Analysis}\n36\t\\label{app:length}\n37\t\\input{appendix_length}\n38\t\n39\t\\section{Prompt Type Generalization}\n40\t\\label{app:prompt-type}\n41\t\\input{appendix_prompt_type}\n42\t\n43\t\\section{Finer-Grained Depth Classification}\n44\t\\label{app:finer-depth}\n45\t\\input{appendix_finer_depth}\n46\t\n47\t\\section{End-to-End Depth Classification (QLoRA)}\n48\t\\label{app:qlora}\n49\t\\input{appendix_qlora}\n50\t\n51\t\\section{Leave-One-Feature-Out Analysis}\n52\t\\label{app:lofo}\n53\t\\input{appendix_lofo}\n54\t\n55\t\\section{Confusion Matrix}\n56\t\\label{app:confusion}\n57\t\\input{appendix_confusion_matrix}\n58\t\n59\t\\section{Classifier Sensitivity}\n60\t\\label{app:classifier}"}]},"parent_tool_use_id":"toolu_01BGZc6RK4DNRToboczGVSyt","session_id":"ec2149a7-b6c7-4246-a1a9-e6c336a9e562","uuid":"15d52940-1bc9-4023-80c8-cc1447de4f97","timestamp":"2026-05-16T16:24:56.236Z"}
