\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Feature trajectories across generation depth ($y$-axis: $z$-scored feature values). \textbf  {Top row (drifting)}: entropy mean and hapax ratio decline monotonically across all eight generators ($|\rho | > 0.59$). \textbf  {Bottom row (stationary)}: entropy max and tail decay remain flat ($|\rho | < 0.07$). Colored lines: individual generators; diamonds: cross-generator mean (red for drifting, blue for stationary). This dichotomy defines the DDR.}}{2}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:ddr-trajectory}{{1}{2}{Feature trajectories across generation depth ($y$-axis: $z$-scored feature values). \textbf {Top row (drifting)}: entropy mean and hapax ratio decline monotonically across all eight generators ($|\rho | > 0.59$). \textbf {Bottom row (stationary)}: entropy max and tail decay remain flat ($|\rho | < 0.07$). Colored lines: individual generators; diamonds: cross-generator mean (red for drifting, blue for stationary). This dichotomy defines the DDR}{figure.caption.1}{}}
