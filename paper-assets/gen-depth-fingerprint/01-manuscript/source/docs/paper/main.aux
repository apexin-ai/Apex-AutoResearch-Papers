\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Feature distributions by generation depth (violin plots, $N$\,=\,37{,}058). Drifting features (entropy mean, TTR, hapax ratio: $|\rho | > 0.60$) show clear location shifts and narrowing with increasing depth. Shape features (entropy max, tail decay: $|\rho | < 0.10$) remain approximately stationary. Quartile lines indicate median and interquartile range.}}{13}{figure.caption.41}\protected@file@percent }
\newlabel{fig:violin}{{7}{13}{Feature distributions by generation depth (violin plots, $N$\,=\,37{,}058). Drifting features (entropy mean, TTR, hapax ratio: $|\rho | > 0.60$) show clear location shifts and narrowing with increasing depth. Shape features (entropy max, tail decay: $|\rho | < 0.10$) remain approximately stationary. Quartile lines indicate median and interquartile range}{figure.caption.41}{}}
