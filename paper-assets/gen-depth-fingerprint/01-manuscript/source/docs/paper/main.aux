\@writefile{lof}{\contentsline {figure}{\numberline {19}{\ignorespaces Decoding strategy robustness. \textbf  {(a)} Mean Cohen's $d$ (gen-1 vs.\ gen-2+) across three decoding strategies. Drifting features maintain large $d$ across all strategies; shape features remain below the stationarity threshold ($d < 0.15$). Reference lines mark drifting ($d{=}0.50$) and stationary ($d{=}0.15$) thresholds. \textbf  {(b)} Per-generator mean shape-feature $|d|$: all generators stay near-stationary under all three strategies.}}{34}{figure.caption.149}\protected@file@percent }
\newlabel{fig:decoding-robustness}{{19}{34}{Decoding strategy robustness. \textbf {(a)} Mean Cohen's $d$ (gen-1 vs.\ gen-2+) across three decoding strategies. Drifting features maintain large $d$ across all strategies; shape features remain below the stationarity threshold ($d < 0.15$). Reference lines mark drifting ($d{=}0.50$) and stationary ($d{=}0.15$) thresholds. \textbf {(b)} Per-generator mean shape-feature $|d|$: all generators stay near-stationary under all three strategies}{figure.caption.149}{}}
\@LN@col{1}
