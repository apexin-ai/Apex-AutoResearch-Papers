{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BkbJJdPrNpWqwYffuxaujm","type":"tool_result","content":"1\t% Auto-generated from literature_map.yaml\n2\t% 43 entries\n3\t\n4\t@article{sutton1999options,\n5\t  title = {Between MDPs and Semi-MDPs: A Framework for Temporal Abstraction in Reinforcement Learning},\n6\t  author = {Sutton, R.S and Precup, D and Singh, S},\n7\t  year = {1999},\n8\t  journal = {Artificial Intelligence 112},\n9\t}\n10\t\n11\t@inproceedings{hafner2020dreamerv1,\n12\t  title = {Dream to Control: Learning Behaviors by Latent Imagination},\n13\t  author = {Hafner, D and Lillicrap, T and Ba, J and Norouzi, M},\n14\t  year = {2020},\n15\t  booktitle = {International Conference on Learning Representations},\n16\t}\n17\t\n18\t@article{hafner2023dreamerv3,\n19\t  title = {Mastering Diverse Domains through World Models},\n20\t  author = {Hafner, Danijar and Pasukonis, Jurgis and Ba, Jimmy and Lillicrap, Timothy},\n21\t  year = {2025},\n22\t  journal = {Nature},\n23\t  eprint = {2301.04104},\n24\t  archivePrefix = {arXiv},\n25\t}\n26\t\n27\t@inproceedings{sharma2017figar,\n28\t  title = {Fine Grained Action Repetition for Deep Reinforcement Learning},\n29\t  author = {Sharma, S and Lakshminarayanan, A.S and Ravindran, B},\n30\t  year = {2017},\n31\t  booktitle = {International Conference on Learning Representations},\n32\t}\n33\t\n34\t@inproceedings{janner2019mbpo,\n35\t  title = {When to Trust Your Model: Model-Based Policy Optimization},\n36\t  author = {Janner, M and Fu, J and Zhang, M and Levine, S},\n37\t  year = {2019},\n38\t  booktitle = {Advances in Neural Information Processing Systems},\n39\t}\n40\t\n41\t@article{asadi2019combating,\n42\t  title = {Combating the Compounding-Error Problem with a Multi-step Model},\n43\t  author = {Asadi, K and Misra, D and Kim, S and Littman, M.L},\n44\t  year = {2019},\n45\t  journal = {arXiv preprint arXiv:1905.13320},\n46\t  eprint = {1905.13320},\n47\t  archivePrefix = {arXiv},\n48\t}\n49\t\n50\t@article{lambert2022investigating,\n51\t  title = {Investigating Compounding Prediction Errors in Learned Dynamics Models},\n52\t  author = {Lambert, N and Pister, K.S.J and Calandra, R},\n53\t  year = {2022},\n54\t  journal = {arXiv preprint arXiv:2203.09637},\n55\t  eprint = {2203.09637},\n56\t  archivePrefix = {arXiv},\n57\t}\n58\t\n59\t@inproceedings{hansen2024tdmpc2,\n60\t  title = {TD-MPC2: Scalable, Robust World Models for Continuous Control},\n61\t  author = {Hansen, N and Su, H and Wang, X},\n62\t  year = {2024},\n63\t  booktitle = {International Conference on Learning Representations},\n64\t  eprint = {2310.16828},\n65\t  archivePrefix = {arXiv},\n66\t}\n67\t\n68\t@inproceedings{yu2020mopo,\n69\t  title = {MOPO: Model-based Offline Policy Optimization},\n70\t  author = {Yu, T and Thomas, G and Yu, L and Ermon, S and Zou, J and Levine, S and Finn, C and Ma, T},\n71\t  year = {2020},\n72\t  booktitle = {Advances in Neural Information Processing Systems},\n73\t  eprint = {2005.13239},\n74\t  archivePrefix = {arXiv},\n75\t}\n76\t\n77\t@inproceedings{thrun1993issues,\n78\t  title = {Issues in Using Function Approximation for Reinforcement Learning},\n79\t  author = {Thrun, S and Schwartz, A},\n80\t  year = {1993},\n81\t  booktitle = {Connectionist Models Summer School},\n82\t}\n83\t\n84\t@inproceedings{vanhasselt2016double,\n85\t  title = {Deep Reinforcement Learning with Double Q-Learning},\n86\t  author = {van Hasselt, Hado and Guez, Arthur and Silver, David},\n87\t  year = {2016},\n88\t  booktitle = {AAAI Conference on Artificial Intelligence},\n89\t}\n90\t\n91\t@inproceedings{fujimoto2018td3,\n92\t  title = {Addressing Function Approximation Error in Actor-Critic Methods},\n93\t  author = {Fujimoto, Scott and {van Hoof}, Herke and Meger, David},\n94\t  year = {2018},\n95\t  booktitle = {International Conference on Machine Learning},\n96\t}\n97\t\n98\t@inproceedings{haarnoja2018sac,\n99\t  title = {Soft Actor-Critic: Off-Policy Maximum Entropy Deep Reinforcement Learning with a Stochastic Actor},\n100\t  author = {Haarnoja, T and Zhou, A and Abbeel, P and Levine, S},\n101\t  year = {2018},\n102\t  booktitle = {International Conference on Machine Learning},\n103\t}\n104\t\n105\t@inproceedings{lu2018nondelusional,\n106\t  title = {Non-delusional Q-learning and Value-Iteration},\n107\t  author = {Lu, T and Schuurmans, D and Boutilier, C},\n108\t  year = {2018},\n109\t  booktitle = {Advances in Neural Information Processing Systems},\n110\t}\n111\t\n112\t@inproceedings{lakshminarayanan2017dynamic,\n113\t  title = {Dynamic Action Repetition for Deep Reinforcement Learning},\n114\t  author = {Lakshminarayanan, A.S and Sharma, S and Ravindran, B},\n115\t  year = {2017},\n116\t  booktitle = {AAAI Conference on Artificial Intelligence},\n117\t}\n118\t\n119\t@inproceedings{biedenkapp2021temporl,\n120\t  title = {TempoRL: Learning When to Act},\n121\t  author = {Biedenkapp, A and Rajan, R and Hutter, F and Lindauer, M},\n122\t  year = {2021},\n123\t  booktitle = {International Conference on Machine Learning},\n124\t}\n125\t\n126\t@inproceedings{hafner2021dreamerv2,\n127\t  title = {Mastering Atari with Discrete World Models},\n128\t  author = {Hafner, D and Lillicrap, T and Norouzi, M and Ba, J},\n129\t  year = {2021},\n130\t  booktitle = {International Conference on Learning Representations},\n131\t}\n132\t\n133\t@inproceedings{micheli2023iris,\n134\t  title = {Transformers are Sample-Efficient World Models},\n135\t  author = {Micheli, V and Alonso, E and Fleuret, F},\n136\t  year = {2023},\n137\t  booktitle = {International Conference on Learning Representations},\n138\t}\n139\t\n140\t@inproceedings{robine2023twm,\n141\t  title = {Transformer-based World Models Are Happy With 100k Interactions},\n142\t  author = {Robine, J and Hoeftmann, M and Uelwer, T and Harmeling, S},\n143\t  year = {2023},\n144\t  booktitle = {International Conference on Learning Representations},\n145\t}\n146\t\n147\t@inproceedings{gumbsch2024thick,\n148\t  title = {Learning Hierarchical World Models with Adaptive Temporal Abstractions from Discrete Latent Dynamics},\n149\t  author = {Gumbsch, C and Sajid, N and Martius, G and Butz, M.V},\n150\t  year = {2024},\n151\t  booktitle = {International Conference on Learning Representations},\n152\t}\n153\t\n154\t@inproceedings{mattes2024hieros,\n155\t  title = {Hieros: Hierarchical Imagination on Structured State Space Sequence World Models},\n156\t  author = {Mattes, P and Schlosser, R and Herbrich, R},\n157\t  year = {2024},\n158\t  booktitle = {International Conference on Machine Learning},\n159\t}\n160\t\n161\t@inproceedings{henderson2018deep,\n162\t  title = {Deep Reinforcement Learning that Matters},\n163\t  author = {Henderson, P and Islam, R and Bachman, P and Pineau, J and Precup, D and Meger, D},\n164\t  year = {2018},\n165\t  booktitle = {AAAI Conference on Artificial Intelligence},\n166\t}\n167\t\n168\t@inproceedings{nikishin2022primacy,\n169\t  title = {The Primacy Bias in Deep Reinforcement Learning},\n170\t  author = {Nikishin, E and Schwarzer, M and D'Oro, P and Bacon, P.-L and Courville, A},\n171\t  year = {2022},\n172\t  booktitle = {International Conference on Machine Learning},\n173\t}\n174\t\n175\t@inproceedings{ma2024harmonydream,\n176\t  title = {HarmonyDream: Task Harmonization Inside World Models},\n177\t  author = {Ma, H and Wu, J and Feng, N and Xiao, C and Li, D and Hao, J and Wang, J and Long, M},\n178\t  year = {2024},\n179\t  booktitle = {International Conference on Machine Learning},\n180\t}\n181\t\n182\t@inproceedings{lambert2020objective,\n183\t  title = {Objective Mismatch in Model-based Reinforcement Learning},\n184\t  author = {Lambert, N and Amos, B and Yadan, O and Calandra, R},\n185\t  year = {2020},\n186\t  booktitle = {L4DC},\n187\t}\n188\t\n189\t@inproceedings{agarwal2021precipice,\n190\t  title = {Deep Reinforcement Learning at the Edge of the Statistical Precipice},\n191\t  author = {Agarwal, R and Schwarzer, M and Castro, P.S and Courville, A.C and Bellemare, M},\n192\t  year = {2021},\n193\t  booktitle = {Advances in Neural Information Processing Systems},\n194\t}\n195\t\n196\t@article{tassa2018dmcontrol,\n197\t  title = {DeepMind Control Suite},\n198\t  author = {Tassa, Yuval and Doron, Yotam and Muldal, Alistair and Erez, Tom and Li, Yazhe and de Las Casas, Diego and Budden, David and Abdolmaleki, Abbas and Merel, Josh and Lefrancq, Andrew and Lillicrap, Timothy and Riedmiller, Martin},\n199\t  year = {2018},\n200\t  journal = {arXiv preprint arXiv:1801.00690},\n201\t  eprint = {1801.00690},\n202\t  archivePrefix = {arXiv},\n203\t}\n204\t\n205\t@inproceedings{tallec2019making,\n206\t  title = {Making Deep Q-learning methods Robust to Time Discretization},\n207\t  author = {Tallec, C and Blier, L and Ollivier, Y},\n208\t  year = {2019},\n209\t  booktitle = {International Conference on Machine Learning},\n210\t  eprint = {1901.09732},\n211\t  archivePrefix = {arXiv},\n212\t}\n213\t\n214\t@inproceedings{engstrom2020implementation,\n215\t  title = {Implementation Matters in Deep Policy Gradients: A Case Study on PPO and TRPO},\n216\t  author = {Engstrom, L and Ilyas, A and Santurkar, S and Tsipras, D and Janoos, F and Rudolph, L and Madry, A},\n217\t  year = {2020},\n218\t  booktitle = {International Conference on Learning Representations},\n219\t  eprint = {2005.12729},\n220\t  archivePrefix = {arXiv},\n221\t}\n222\t\n223\t@inproceedings{andrychowicz2021whatmatters,\n224\t  title = {What Matters for On-Policy Deep Actor-Critic Methods? A Large-Scale Study},\n225\t  author = {Andrychowicz, M and Raichuk, A and Stańczyk, P and Orsini, M and Girgin, S and Marinier, R and Hussenot, L and Geist, M and Pietquin, O and Michalski, M and Gelly, S and Bachem, O},\n226\t  year = {2021},\n227\t  booktitle = {International Conference on Learning Representations},\n228\t  eprint = {2006.05990},\n229\t  archivePrefix = {arXiv},\n230\t}\n231\t\n232\t@inproceedings{frauenknecht2025rollouts,\n233\t  title = {On Rollouts in Model-Based Reinforcement Learning},\n234\t  author = {Frauenknecht, B and Subhasish, D and Solowjow, F and Trimpe, S},\n235\t  year = {2025},\n236\t  booktitle = {International Conference on Learning Representations},\n237\t  eprint = {2501.16918},\n238\t  archivePrefix = {arXiv},\n239\t}\n240\t\n241\t@article{hafner2025dreamerv4,\n242\t  title = {Training Agents Inside of Scalable World Models},\n243\t  author = {Hafner, Danijar and Yan, Wilson and Lillicrap, Timothy},\n244\t  year = {2025},\n245\t  journal = {arXiv preprint arXiv:2509.24527},\n246\t  eprint = {2509.24527},\n247\t  archivePrefix = {arXiv},\n248\t}\n249\t\n250\t@inproceedings{lyle2022capacity,\n251\t  title = {Understanding and Preventing Capacity Loss in Reinforcement Learning},\n252\t  author = {Lyle, C and Rowland, M and Dabney, W},\n253\t  year = {2022},\n254\t  booktitle = {International Conference on Learning Representations},\n255\t  eprint = {2204.09560},\n256\t  archivePrefix = {arXiv},\n257\t}\n258\t\n259\t@inproceedings{nikishin2023plasticity,\n260\t  title = {Deep Reinforcement Learning with Plasticity Injection},\n261\t  author = {Nikishin, E and Oh, J and Ostrovski, G and Lyle, C and Pascanu, R and Dabney, W and Barreto, A},\n262\t  year = {2023},\n263\t  booktitle = {Advances in Neural Information Processing Systems},\n264\t}\n265\t\n266\t@inproceedings{nhu2025tawm,\n267\t  title = {Time-Aware World Model for Adaptive Prediction and Control},\n268\t  author = {Nhu, Anh N. and Son, Sanghyun and Lin, Ming C.},\n269\t  year = {2025},\n270\t  booktitle = {International Conference on Machine Learning},\n271\t  eprint = {2506.08441},\n272\t  archivePrefix = {arXiv},\n273\t}\n274\t\n275\t@inproceedings{li2025lsimagine,\n276\t  title = {Open-World Reinforcement Learning over Long Short-Term Imagination},\n277\t  author = {Li, J and Wang, Q and Wang, Y and Jin, X and Li, Y and Zeng, W and Yang, X},\n278\t  year = {2025},\n279\t  booktitle = {International Co