\@writefile{toc}{\contentsline {subsection}{\numberline {6.1}Cheetah Run}{5}{subsection.6.1}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces Cheetah Run: CIVO trigger, causal control, and unexposed configurations. CIVO is more severe in Cheetah (NVE peaks 8--70$\times $) than Walker (2--4$\times $), consistent with greater RSSM prediction difficulty.}}{6}{table.caption.12}\protected@file@percent }
\newlabel{tab:cheetah}{{8}{6}{Cheetah Run: CIVO trigger, causal control, and unexposed configurations. CIVO is more severe in Cheetah (NVE peaks 8--70$\times $) than Walker (2--4$\times $), consistent with greater RSSM prediction difficulty}{table.caption.12}{}}
