\@writefile{toc}{\contentsline {subsection}{\numberline {4.2}RSSM Fidelity Gap}{3}{subsection.4.2}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces RSSM fidelity analysis. Both absolute errors and gap ratios are reported; 008d's low observation gap ratio (1.30$\times $) is misleading because its $\mathrm  {dt}=1$ absolute error is already $3\times $ baseline (model has partially collapsed). The trained embedding's reward gap (2.78$\times $) indicates precise but inaccurate dt-specific reward predictions.}}{3}{table.caption.5}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{tab:rssm_fidelity}{{1}{3}{RSSM fidelity analysis. Both absolute errors and gap ratios are reported; 008d's low observation gap ratio (1.30$\times $) is misleading because its $\mathrm {dt}=1$ absolute error is already $3\times $ baseline (model has partially collapsed). The trained embedding's reward gap (2.78$\times $) indicates precise but inaccurate dt-specific reward predictions}{table.caption.5}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.3}Trained dt-Embedding Reliably Triggers Pathological Overestimation}{4}{subsection.4.3}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Walker Walk 008d (trained dt-embedding, $\mathrm  {dt}=2$, subsample ON, $H=8$). All seeds exceed NVE $\geq 1.5\times $; collapse is stochastic (seed 2 self-corrects).}}{4}{table.caption.6}\protected@file@percent }
\newlabel{tab:walker_008d}{{2}{4}{Walker Walk 008d (trained dt-embedding, $\mathrm {dt}=2$, subsample ON, $H=8$). All seeds exceed NVE $\geq 1.5\times $; collapse is stochastic (seed 2 self-corrects)}{table.caption.6}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.4}The $2\times 2$ Ablation Matrix}{4}{subsection.4.4}\protected@file@percent }
\newlabel{sec:ablation_matrix}{{4.4}{4}{The $2\times 2$ Ablation Matrix}{subsection.4.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces $2\times 2$ ablation matrix. CIVO occurs \emph  {only} when the embedding is trained AND exposed to $\mathrm  {dt}>1$ transitions, confirming both conditions are jointly necessary.}}{4}{table.caption.7}\protected@file@percent }
\newlabel{tab:ablation_2x2}{{3}{4}{$2\times 2$ ablation matrix. CIVO occurs \emph {only} when the embedding is trained AND exposed to $\mathrm {dt}>1$ transitions, confirming both conditions are jointly necessary}{table.caption.7}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.5}Causal Control: Embedding Removal}{4}{subsection.4.5}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Walker Walk 008f causal control ($\mathrm  {dt\_embed\_dim}=0$, subsample ON). No seed triggers CIVO. Reward MAE is $75\times $ baseline because the reward head cannot distinguish $\mathrm  {dt}=1$ from $\mathrm  {dt}=2$.}}{4}{table.caption.8}\protected@file@percent }
\newlabel{tab:walker_008f}{{4}{4}{Walker Walk 008f causal control ($\mathrm {dt\_embed\_dim}=0$, subsample ON). No seed triggers CIVO. Reward MAE is $75\times $ baseline because the reward head cannot distinguish $\mathrm {dt}=1$ from $\mathrm {dt}=2$}{table.caption.8}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.6}Value Suppression in Unexposed Configurations}{4}{subsection.4.6}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Walker Walk 008a (trained but unexposed dt-embedding, subsample OFF, $H=15$). Value suppression (NVE $< 1.0\times $) across all seeds; no CIVO.}}{5}{table.caption.9}\protected@file@percent }
\newlabel{tab:walker_008a}{{5}{5}{Walker Walk 008a (trained but unexposed dt-embedding, subsample OFF, $H=15$). Value suppression (NVE $< 1.0\times $) across all seeds; no CIVO}{table.caption.9}{}}
\@writefile{toc}{\contentsline {section}{\numberline {5}NVE Diagnostic Validation}{5}{section.5}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {5.1}Threshold Sensitivity and AUROC}{5}{subsection.5.1}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces NVE threshold sensitivity analysis (29 data points, 4 environments). The Youden-optimal threshold (1.53$\times $) independently converges to our preselected 1.5$\times $, with 2\% gap. AUROC $= 0.969$.}}{5}{table.caption.10}\protected@file@percent }
\newlabel{tab:nve_auroc}{{6}{5}{NVE threshold sensitivity analysis (29 data points, 4 environments). The Youden-optimal threshold (1.53$\times $) independently converges to our preselected 1.5$\times $, with 2\% gap. AUROC $= 0.969$}{table.caption.10}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.2}Cross-Environment NVE Classification}{5}{subsection.5.2}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces NVE$\geq 1.5\times $ cross-environment classification. Trained dt-embedding triggers pathological overestimation in 9/9 seeds across 3 environments; untrained configurations never exceed the threshold (0/12).}}{5}{table.caption.11}\protected@file@percent }
\newlabel{tab:nve_cross_env}{{7}{5}{NVE$\geq 1.5\times $ cross-environment classification. Trained dt-embedding triggers pathological overestimation in 9/9 seeds across 3 environments; untrained configurations never exceed the threshold (0/12)}{table.caption.11}{}}
