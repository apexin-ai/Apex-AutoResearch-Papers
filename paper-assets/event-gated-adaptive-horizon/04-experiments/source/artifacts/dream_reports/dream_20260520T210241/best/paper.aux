\@writefile{toc}{\contentsline {section}{\numberline {7}Multiple Vulnerability Pathways}{6}{section.7}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {7.1}dt=1 Imagination Does Not Prevent Collapse}{6}{subsection.7.1}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {10}{\ignorespaces Hopper Hop cross-configuration summary (predicted). NVE severity (2--8$\times $) is intermediate between Walker and Cheetah.}}{7}{table.caption.14}\protected@file@percent }
\newlabel{tab:hopper}{{10}{7}{Hopper Hop cross-configuration summary (predicted). NVE severity (2--8$\times $) is intermediate between Walker and Cheetah}{table.caption.14}{}}
\@writefile{lot}{\contentsline {table}{\numberline {11}{\ignorespaces 008e\_v3: dt=1 imagination with trained dt-embedding (4 seeds). Collapse rate (2/4 = 50\%) matches 008d's rate with $\mathrm  {dt}=2$ imagination. Healthy seeds achieve near-baseline performance ($\sim $95\%).}}{7}{table.caption.15}\protected@file@percent }
\newlabel{tab:dt1_imag}{{11}{7}{008e\_v3: dt=1 imagination with trained dt-embedding (4 seeds). Collapse rate (2/4 = 50\%) matches 008d's rate with $\mathrm {dt}=2$ imagination. Healthy seeds achieve near-baseline performance ($\sim $95\%)}{table.caption.15}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {7.2}Pathway A vs.\ Pathway B Dynamics}{7}{subsection.7.2}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {12}{\ignorespaces Pathway A (classic CIVO, 008d) vs.\ Pathway B (eval-driven, 008e\_v3 s2). In Pathway A, value explosion drives NVE and the actor locks onto overestimated regions (entropy decreasing). In Pathway B, evaluation performance collapses first, passively inflating NVE through the denominator, while the policy destabilizes (entropy increasing).}}{7}{table.caption.16}\protected@file@percent }
\newlabel{tab:pathways}{{12}{7}{Pathway A (classic CIVO, 008d) vs.\ Pathway B (eval-driven, 008e\_v3 s2). In Pathway A, value explosion drives NVE and the actor locks onto overestimated regions (entropy decreasing). In Pathway B, evaluation performance collapses first, passively inflating NVE through the denominator, while the policy destabilizes (entropy increasing)}{table.caption.16}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {7.3}Actor Entropy Signatures}{7}{subsection.7.3}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {7.4}Value Prediction Distribution Analysis}{7}{subsection.7.4}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {13}{\ignorespaces Actor entropy signatures across configurations. Healthy configurations converge smoothly; Pathway A shows accelerating entropy decrease (policy locking); Pathway B shows entropy increase (policy destabilization).}}{8}{table.caption.17}\protected@file@percent }
\newlabel{tab:entropy}{{13}{8}{Actor entropy signatures across configurations. Healthy configurations converge smoothly; Pathway A shows accelerating entropy decrease (policy locking); Pathway B shows entropy increase (policy destabilization)}{table.caption.17}{}}
\@writefile{lot}{\contentsline {table}{\numberline {14}{\ignorespaces $V(s)$ vs.\ Monte Carlo return statistics. The trained embedding (008d) shows extreme dt-specific overestimation ($+250\%$ at $\mathrm  {dt}=2$ states at 55K), while the unexposed configuration (008a) shows slight pessimism.}}{8}{table.caption.18}\protected@file@percent }
\newlabel{tab:value_dist}{{14}{8}{$V(s)$ vs.\ Monte Carlo return statistics. The trained embedding (008d) shows extreme dt-specific overestimation ($+250\%$ at $\mathrm {dt}=2$ states at 55K), while the unexposed configuration (008a) shows slight pessimism}{table.caption.18}{}}
