1540\t        --logdir logdir/exp_008e_v3_walker_s2 --steps 105000 --seed 2 --compile False\n1541\t        --device cuda:0 --gate_enabled True --gate_fixed_dt 1 --gate_subsample_max_dt\n1542\t        2 --imag_horizon 15\"\n1543\t      server: bjb1-45299\n1544\t      gpu:\n1545\t      - cuda:1\n1546\t      pid: '43437'\n1547\t      log_path: ~/runs/event-gated-adaptive-horizon/exp_008e_v3_walker_s2.log\n1548\t      submitted_at: '2026-05-15T00:46:45.424Z'\n1549\t      submitted_via: submit_training_job\n1550\t      backend: tmux\n1551\t      account: root\n1552\t    model_name: DreamerV3+SubsampleON_FixedDt1_H15 (gate_subsample_max_dt=2, gate_fixed_dt=1,\n1553\t      imag_horizon=15, trained dt_emb)\n1554\t    server: bjb1-45299\n1555\t    account: root\n1556\t    pid: '43437'\n1557\t    log_path: ~/runs/event-gated-adaptive-horizon/exp_008e_v3_walker_s2.log\n1558\t    reproduce:\n1559\t      command: bash -c \"source /root/miniconda3/etc/profile.d/conda.sh && conda activate\n1560\t        base && export LD_PRELOAD=/usr/lib/x86_64-linux-gnu/libstdc++.so.6 && export\n1561\t        MUJOCO_GL=osmesa && export PYOPENGL_PLATFORM=osmesa && cd /root/autodl-tmp/event-gated-adaptive-horizon\n1562\t        && python dreamer.py --configs defaults dmc_proprio --task dmc_walker_walk\n1563\t        --logdir logdir/exp_008e_v3_walker_s2 --steps 105000 --seed 2 --compile False\n1564\t        --device cuda:0 --gate_enabled True --gate_fixed_dt 1 --gate_subsample_max_dt\n1565\t        2 --imag_horizon 15\"\n1566\t      code_commit: 09876d7080affdb0fb329e24753a46d998da9d8e\n1567\t    metrics:\n1568\t      current_step: 8000\n1569\t      target_steps: 105000\n1570\t      progress_pct: 7.6\n1571\t      eval_checkpoints:\n1572\t      - step: 5000\n1573\t        eval_return: 39.27\n1574\t        value_mean: 0.00193\n1575\t        ve_ratio: 5.0e-05\n1576\t      gate_dt_mean: 1\n1577\t      gate_dt_1_frac: 1\n1578\t      trend: Just started. 1 eval point only, too early for comparison.\n1579