{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WkKNkjUgpaqxwDRFDQEeRR","type":"tool_result","content":"1\t# Experiment Plan — event-gated-adaptive-horizon\n2\t# Target: CoRL 2026 (DDL 2026-05-29)\n3\t# Last updated: 2026-05-14\n4\t\n5\tclaims:\n6\t  C1: \"Variable-rate imagination in DreamerV3 consistently degrades performance\"\n7\t  C2: \"Trained dt_embedding is the causal mechanism for delusional critic collapse\"\n8\t  C3: \"Untrained dt_embedding prevents optimistic drift via value growth suppression\"\n9\t  C4: \"Longer dt amplifies degradation monotonically\"\n10\t  C5: \"Learning signal reduction from shorter horizons is secondary, not root cause\"\n11\t  C6: \"Restricting imagination to dt=1 during multi-dt training provides practical mitigation (95% baseline)\"\n12\t\n13\texperiments:\n14\t  # ============================================================\n15\t  # Walker Walk — MVP experiments (completed / running)\n16\t  # ============================================================\n17\t\n18\t  - id: plan_001\n19\t    name: \"Walker Walk baseline (seed 0)\"\n20\t    claim: [C1, C2, C3]\n21\t    description: \"dt=1 baseline establishing reference performance and v/e calibration\"\n22\t    priority: P0\n23\t    registry_id: exp_001_baseline\n24\t    status: done\n25\t    gpu_budget_hours: 5\n26\t\n27\t  - id: plan_002\n28\t    name: \"Walker Walk trained dt_emb collapse (seed 0)\"\n29\t    claim: [C1, C2]\n30\t    description: \"dt=2 + subsample ON + trained dt_emb → delusional critic collapse\"\n31\t    priority: P0\n32\t    registry_id: exp_006_fixed_dt2\n33\t    status: done\n34\t    gpu_budget_hours: 5\n35\t\n36\t  - id: plan_003\n37\t    name: \"Walker Walk dt=4 degradation (seed 0)\"\n38\t    claim: [C1, C4]\n39\t    description: \"dt=4 fixed → severe degradation, monotonic dt relationship\"\n40\t    priority: P0\n41\t    registry_id: exp_007_fixed_dt4\n42\t    status: done\n43\t    gpu_budget_hours: 3\n44\t\n45\t  - id: plan_004\n46\t    name: \"Walker Walk untrained dt_emb H=15 (seed 0)\"\n47\t    claim: [C3, C5]\n48\t    description: \"subsample OFF + untrained dt_emb + H=15 → value growth suppression, V-recovery\"\n49\t    priority: P0\n50\t    registry_id: exp_008a_no_subsample_dt2\n51\t    status: done\n52\t    result: \"105K=778 (85% baseline), normalized v/e=0.59x, zigzag recovery with two dip-recovery cycles\"\n53\t    gpu_budget_hours: 5\n54\t\n55\t  - id: plan_005\n56\t    name: \"Walker Walk untrained dt_emb H=8 (seed 0)\"\n57\t    claim: [C2, C5]\n58\t    description: \"subsample OFF + untrained dt_emb + H=8 → plateau (learning signal reduction)\"\n59\t    priority: P0\n60\t    registry_id: exp_008c_no_subsample_dt2_h8\n61\t    status: done\n62\t    gpu_budget_hours: 5\n63\t\n64\t  - id: plan_006\n65\t    name: \"Walker Walk trained dt_emb H=8 (seed 0)\"\n66\t    claim: [C2]\n67\t    description: \"subsample ON + trained dt_emb + H=8 → delusional critic (causal pair with 008f)\"\n68\t    priority: P0\n69\t    registry_id: exp_008d_subsample_on_h8\n70\t    status: done\n71\t    result: \"normalized v/e 1.71x@35K → 2.09x@45K, collapse\"\n72\t    gpu_budget_hours: 5\n73\t\n74\t  - id: plan_007\n75\t    name: \"Walker Walk dt_embed_dim=0 H=8 — C2 causal control (seed 0)\"\n76\t    claim: [C2]\n77\t    description: \"subsample ON + dt_embed_dim=0 + H=8 → isolates dt_embedding as cause\"\n78\t    priority: P0\n79\t    registry_id: exp_008f_no_dt_embed_subsample_on_h8\n80\t    status: done\n81\t    result: \"Zigzag recovery to 503@105K (173→375→324→246→319→503), normalized v/e=0.30x, value self-correction. C2 causal chain closed.\"\n82\t    gpu_budget_hours: 5\n83\t\n84\t  - id: plan_008\n85\t    name: \"Walker Walk untrained dt_emb + subsample ON H=15 — B+ confound (seed 0)\"\n86\t    claim: [C3, C5]\n87\t    description: \"subsample ON + untrained dt_emb + H=15 → resolves whether B+ protection comes from untrained dt_emb or subsample OFF\"\n88\t    priority: P0\n89\t    registry_id: exp_008e_v3_subsample_on_dt1_h15\n90\t    status: done\n91\t    result: \"eval_return_105K=869.9 (95% baseline), normalized v/e=0.80x. B+ confirmed + practical mitigation guideline.\"\n92\t    gpu_budget_hours: 5\n93\t\n94\t  # ============================================================\n95\t  # Walker Walk — Multi-seed replication (P0)\n96\t  # ============================================================\n97\t\n98\t  - id: plan_010\n99\t    name: \"Walker Walk baseline seeds 1-2\"\n100\t    claim: [C1, C2, C3]\n101\t    description: \"2 additional seeds for baseline v/e calibration\"\n102\t    priority: P0\n103\t    gpu_budget_hours: 10\n104\t    deps: []\n105\t    registry_ids:\n106\t      seed1: exp_009d_baseline_walker_s1   # 500K, cuda:0 after 010a\n107\t      seed2: exp_009a_baseline_walker_s2   # RUNNING\n108\t\n109\t  - id: plan_011\n110\t    name: \"Walker Walk 008d (trained dt_emb, collapse) seeds 1-2\"\n111\t    claim: [C2]\n112\t    description: \"Replicate delusional critic collapse with 2 more seeds\"\n113\t    priority: P0\n114\t    gpu_budget_hours: 10\n115\t    deps: [plan_010]\n116\t    registry_ids:\n117\t      seed1: exp_009e_008d_walker_s1       # 105K, cuda:1 after 009b\n118\t      seed2: exp_009b_008d_walker_s2       # RUNNING cuda:1\n119\t\n120\t  - id: plan_012\n121\t    name: \"Walker Walk 008f (dt_embed_dim=0, stable) seeds 1-2\"\n122\t    claim: [C2]\n123\t    description: \"Replicate causal control stability with 2 more seeds\"\n124\t    priority: P0\n125\t    gpu_budget_hours: 10\n126\t    deps: [plan_010]\n127\t    registry_ids:\n128\t      seed1: exp_009f_008f_walker_s1       # 105K, cuda:1 after 009e\n129\t      seed2: exp_009c_008f_walker_s2       # DONE(negative) 105K, extending to 200K\n130\t\n131\t  - id: plan_014\n132\t    name: \"Walker Walk 008e_v3 (mitigation) seeds 1-2\"\n133\t    claim: [C6]\n134\t    description: \"Multi-seed validation of 008e_v3 as recommended mitigation (untrained dt_emb + subsample ON + dt=1 imag + H=15). P0 because 008f unreliable after 009c negative.\"\n135\t    priority: P0\n136\t    gpu_budget_hours: 10\n137\t    deps: [plan_008]\n138\t    registry_ids:\n139\t      seed1: exp_008e_v3_walker_s1   # 105K, cuda:1 after 009f\n140\t      seed2: exp_008e_v3_walker_s2   # 105K, cuda:1 after s1\n141\t\n142\t  - id: plan_013\n143\t    name: \"Walker Walk 008a (untrained dt_emb, V-recovery) seeds 1-2\"\n144\t    claim: [C3]\n145\t    description: \"Replicate value growth suppression with 2 more seeds\"\n146\t    priority: P1\n147\t    gpu_budget_hours: 10\n148\t    deps: [plan_010]\n149\t\n150\t  # ============================================================\n151\t  # Cheetah Run — Cross-environment validation (P0)\n152\t  # ============================================================\n153\t\n154\t  - id: plan_020\n155\t    name: \"Cheetah Run baseline (3 seeds)\"\n156\t    claim: [C1, C2, C3]\n157\t    description: \"dt=1 baseline in second DMC environment\"\n158\t    priority: P0\n159\t    gpu_budget_hours: 15\n160\t    deps: []\n161\t\n162\t  - id: plan_021\n163\t    name: \"Cheetah Run trained dt_emb + subsample ON (3 seeds)\"\n164\t    claim: [C1, C2]\n165\t    description: \"Replicate delusional critic collapse in Cheetah Run\"\n166\t    priority: P0\n167\t    gpu_budget_hours: 15\n168\t    deps: [plan_020]\n169\t\n170\t  - id: plan_022\n171\t    name: \"Cheetah Run dt_embed_dim=0 + subsample ON (3 seeds)\"\n172\t    claim: [C2]\n173\t    description: \"Replicate causal control in Cheetah Run\"\n174\t    priority: P0\n175\t    gpu_budget_hours: 15\n176\t    deps: [plan_020]\n177\t\n178\t  - id: plan_023\n179\t    name: \"Cheetah Run untrained dt_emb + no subsample (3 seeds)\"\n180\t    claim: [C3]\n181\t    description: \"Replicate value growth suppression in Cheetah Run\"\n182\t    priority: P1\n183\t    gpu_budget_hours: 15\n184\t    deps: [plan_020]\n185\t\n186\t  # ============================================================\n187\t  # Analysis experiments (no GPU needed)\n188\t  # ============================================================\n189\t\n190\t  - id: plan_030\n191\t    name: \"RSSM prediction quality: dt=1 vs dt=2 transitions\"\n192\t    claim: [C2]\n193\t    description: \"Measure observation/reward reconstruction loss at dt=2 vs dt=1 transitions from existing trained models. Quantifies RSSM fidelity gap — the mechanistic foundation for why trained dt_emb causes delusional critic.\"\n194\t    priority: P1\n195\t    gpu_budget_hours: 1\n196\t    deps: []\n197\t\n198\t  - id: plan_031\n199\t    name: \"Actor entropy analysis\"\n200\t    claim: [C2, C3]\n201\t    description: \"Plot actor_entropy vs training step for healthy (008a/008c) vs collapsed (006/008d) configurations. If collapsed configs show entropy increase → actor confusion from delusional critic gradients.\"\n202\t    priority: P1\n203\t    gpu_budget_hours: 0\n204\t    deps: []\n205\t\n206\t  - id: plan_032\n207\t    name: \"Value prediction distribution vs realized returns\"\n208\t    claim: [C2, C3]\n209\t    description: \"Distribution plots of V(s) vs Monte Carlo return for trained vs untrained dt_emb. More informative than single v/e ratio — directly shows where value estimates diverge.\"\n210\t    priority: P2\n211\t    gpu_budget_hours: 1\n212\t    deps: []\n213\t\n214\t  - id: plan_033\n215\t    name: \"dt_embedding cosine similarity analysis\"\n216\t    claim: [C2]\n217\t    description: \"Analyze learned dt_embedding vectors: cosine similarity between dt=1 and dt=2 embeddings, and how this evolves during training.\"\n218\t    priority: P2\n219\t    gpu_budget_hours: 0\n220\t    deps: []\n221\t\n222\t  # ============================================================\n223\t  # Cartpole Swingup — Non-locomotion validation (P0)\n224\t  # ============================================================\n225\t\n226\t  - id: plan_050\n227\t    name: \"Cartpole Swingup baseline (3 seeds)\"\n228\t    claim: [C1, C2, C3]\n229\t    description: \"