periments (completed / running)\n  # ============================================================\n\n  - id: plan_001\n    name: \"Walker Walk baseline (seed 0)\"\n    claim: [C1, C2, C3]\n    description: \"dt=1 baseline establishing reference performance and v/e calibration\"\n    priority: P0\n    registry_id: exp_001_baseline\n    status: done\n    gpu_budget_hours: 5\n\n  - id: plan_002\n    name: \"Walker Walk trained dt_emb collapse (seed 0)\"\n    claim: [C1, C2]\n    description: \"dt=2 + subsample ON + trained dt_emb → delusional critic collapse\"\n    priority: P0\n    registry_id: exp_006_fixed_dt2\n    status: done\n    gpu_budget_hours: 5\n\n  - id: plan_003\n    name: \"Walker Walk dt=4 degradation (seed 0)\"\n    claim: [C1, C4]\n    description: \"dt=4 fixed → severe degradation, monotonic dt relationship\"\n    priority: P0\n    registry_id: exp_007_fixed_dt4\n    status: done\n    gpu_budget_hours: 3\n\n  - id: plan_004\n    name: \"Walker Walk untrained dt_emb H=15 (seed 0)\"\n    claim: [C3, C5]\n    description: \"subsample OFF + untrained dt_emb + H=15 → value growth suppression, V-recovery\"\n    priority: P0\n    registry_id: exp_008a_no_subsample_dt2\n    status: done\n    result: \"105K=778 (85% baseline), normalized v/e=0.59x, zigzag recovery with two dip-recovery cycles\"\n    gpu_budget_hours: 5\n\n  - id: plan_005\n    name: \"Walker Walk untrained dt_emb H=8 (seed 0)\"\n    claim: [C2, C5]\n    description: \"subsample OFF + untrained dt_emb + H=8 → plateau (learning signal reduction)\"\n    priority: P0\n    registry_id: exp_008c_no_subsample_dt2_h8\n    status: done\n    gpu_budget_hours: 5\n\n  - id: plan_006\n    name: \"Walker Walk trained dt_emb H=8 (seed 0)\"\n    claim: [C2]\n    description: \"subsample ON + trained dt_emb + H=8 → delusional critic (causal pair with 008f)\"\n    priority: P0\n    registry_id: exp_008d_subsample_on_h8\n    status: done\n    result: \"normalized v/e 1.71x@35K → 2.09x@45K, collapse\"\n    gpu_budget_hours: 5\n\n  - id: plan_007\n    name: \"Walker Walk dt_embed_dim=0 H=8 — C2 causal control (seed 0)\"\n    claim: [C2]\n    description: \"subsample ON + dt_embed_dim=0 + H=8 → isolates dt_embedding as cause\"\n    priority: P0\n    registry_id: exp_008f_no_dt_embed_subsample_on_h8\n    status: done\n    result: \"Zigzag recovery to 503@105K (173→375→324→246→319→503), normalized v/e=0.30x, value self-correction. C2 causal chain closed.\"\n    gpu_budget_hours: 5\n\n  - id: plan_008\n    name: \"Walker Walk untrained dt_emb + subsample ON H=15 — B+ confound (seed 0)\"\n    claim: [C3, C5]\n    description: \"subsample ON + untrained dt_emb + H=15 → resolves whether B+ protection comes from untrained dt_emb or subsample OFF\"\n    priority: P0\n    registry_id: exp_008e_v3_subsample_on_dt1_h15\n    status: done\n    result: \"eval_return_105K=869.9 (95% baseline), normalized v/e=0.80x. B+ confirmed + practical mitigation guideline.\"\n    gpu_budget_hours: 5\n\n  # ============================================================\n  # Walker Walk — Multi-seed replication (P0)\n  # ============================================================\n\n  - id: plan_010\n    name: \"Walker Walk baseline seeds 1-2\"\n    claim: [C1, C2, C3]\n    description: \"2 additional seeds for baseline v/e calibration\"\n    priority: P0\n    gpu_budget_hours: 10\n    deps: []\n    registry_ids:\n      seed1: exp_009d_baseline_walker_s1   # 500K, cuda:0 after 010a\n      seed2: exp_009a_baseline_walker_s2   # RUNNING\n\n  - id: plan_011\n    name: \"Walker Walk 008d (trained dt_emb, collapse) seeds 1-2\"\n    claim: [C2]\n    description: \"Replicate delusional critic collapse with 2 more seeds\"\n    priority: P0\n    gpu_budget_hours: 10\n    deps: [plan_010]\n    registry_ids:\n      seed1: exp_009e_008d_walker_s1       # 105K, cuda:1 after 009b\n      seed2: exp_009b_008d_walker_s2       # RUNNING cuda:1\n\n  - id: plan_012\n    name: \"Walker Walk 008f (dt_embed_dim=0, stable) seeds