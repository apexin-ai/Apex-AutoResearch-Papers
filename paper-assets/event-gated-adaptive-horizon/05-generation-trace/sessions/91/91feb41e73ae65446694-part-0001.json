     train_data.append({\\\\\\\"step\\\\\\\": step, \\\\\\\"train_return\\\\\\\": d[\\\\\\\"train_return\\\\\\\"]})\\\\n    \\\\n    return train_data, metric_data, eval_data\\\\n\\\\n# Load all experiments\\\\nall_data = {}\\\\nfor name, path in EXPERIMENTS.items():\\\\n    train, metrics, evals = load_metrics(path)\\\\n    all_data[name] = {\\\\n        \\\\\\\"train\\\\\\\": train,\\\\n        \\\\\\\"metrics\\\\\\\": metrics,\\\\n        \\\\\\\"evals\\\\\\\": evals,\\\\n    }\\\\n    print(f\\\\\\\"\\\\\\\\n{name}:\\\\\\\")\\\\n    print(f\\\\\\\"  Train entries: {len(train)}, Metric entries: {len(metrics)}, Eval entries: {len(evals)}\\\\\\\")\\\\n    if metrics:\\\\n        steps = [m[\\\\\\\"step\\\\\\\"] for m in metrics]\\\\n        print(f\\\\\\\"  Step range: {min(steps)} - {max(steps)}\\\\\\\")\\\\n        print(f\\\\\\\"  value_mean range: {min(m['value_mean'] for m in metrics):.2f} - {max(m['value_mean'] for m in metrics):.2f}\\\\\\\")\\\\n        print(f\\\\\\\"  target_mean range: {min(m['target_mean'] for m in metrics):.2f} - {max(m['target_mean'] for m in metrics):.2f}\\\\\\\")\\\\n\\\\n# Also get eval returns at matching steps\\\\nfor name, data in all_data.items():\\\\n    eval_by_step = {e[\\\\\\\"step\\\\\\\"]: e[\\\\\\\"eval_return\\\\\\\"] for e in data[\\\\\\\"evals\\\\\\\"]}\\\\n    for m in data[\\\\\\\"metrics\\\\\\\"]:\\\\n        m[\\\\\\\"eval_return_at_step\\\\\\\"] = eval_by_step.get(m[\\\\\\\"step\\\\\\\"], None)\\\\n    # Aggregate train returns by step\\\\n    train_by_step = defaultdict(list)\\\\n    for t in data[\\\\\\\"train\\\\\\\"]:\\\\n        train_by_step[t[\\\\\\\"step\\\\\\\"]].append(t[\\\\\\\"train_return\\\\\\\"])\\\\n    for m in data[\\\\\\\"metrics\\\\\\\"]:\\\\n        tr = train_by_step.get(m[\\\\\\\"step\\\\\\\"], [])\\\\n        m[\\\\\\\"train_return_mean\\\\\\\"] = np.mean(tr) if tr else None\\\\n\\\\n# ===== FIGURE 1: Value Mean vs Target Mean Over Training =====\\\\nfig, axes = plt.subplots(1, 3, figsize=(