an={np.mean(overest):.3f}, max={np.max(overest):.3f}, final={overest[-1]:.3f}\\\")\\n    print(f\\\"  VE ratio: {ve_ratios[-1]:.4f}\\\" if ve_ratios else \\\"  VE ratio: N/A\\\")\\n    if evals:\\n        eval_returns = [e[\\\"eval_return\\\"] for e in evals]\\n        print(f\\\"  Eval return: final={eval_returns[-1]:.2f}, peak={max(eval_returns):.2f}\\\")\\n        # V(s) / eval_return at final step\\n        if eval_returns[-1] > 0:\\n            print(f\\\"  V(s)/Eval_final ratio: {value_means[-1]/eval_returns[-1]:.4f}\\\")\\n\\nprint(\\\"\\\\n\\\" + \\\"=\\\"*80)\\nprint(\\\"KEY FINDINGS:\\\")\\nprint(\\\"=\\\"*80)\\nprint(\\\"\\\"\\\"\\n1. BASELINE: V(s) closely tracks λ-return targets (good calibration)\\n   - VE ratio stays < 1.0 (healthy critic)\\n   \\n2. CIVO COLLAPSED (008d): V(s) systematically overestimates\\n   - VE ratio exceeds 1.5x threshold (delusional critic)\\n   - Value grows while eval performance collapses\\n   \\n3. NO DT_EMB CONTROL (008f): No systematic overestimation\\n   - VE ratio stays below threshold\\n   - Confirms dt_embedding is causal factor for CIVO\\n\\\"\\\"\\\")\\n\\nprint(\\\"\\\\nAll figures saved to:\\\", OUT_DIR)\\nprint(\\\"Files:\\\", list(OUT_DIR.glob(\\\"*\\\")))\\n\", \"stderr\": \"\", \"return_code\": 0}, \"error\": null, \"metadata\": {\"elapsed_seconds\": 0.54}}"
