                "result": "{\"success\": true, \"data\": {\"stdout\": \"\\\"\\\"\\\"\\nValue Distribution Analysis: V(s) vs Target/Actual Returns\\nCompares baseline, CIVO-collapsed (008d), and no-dt-emb control (008f)\\n\\\"\\\"\\\"\\nimport json\\nimport numpy as np\\nimport matplotlib\\nmatplotlib.use('Agg')\\nimport matplotlib.pyplot as plt\\nfrom pathlib import Path\\nfrom collections import defaultdict\\n\\n# Config\\nBASE_DIR = Path(\\\"/root/autodl-tmp/event-gated-adaptive-horizon/logdir\\\")\\nEXPERIMENTS = {\\n    \\\"Baseline (exp_001_s4)\\\": BASE_DIR / \\\"exp_001_baseline_s4\\\" / \\\"metrics.jsonl\\\",\\n    \\\"CIVO Collapsed (exp_008d_s4)\\\": BASE_DIR / \\\"exp_008d_civo_trigger_s4\\\" / \\\"metrics.jsonl\\\",\\n    \\\"No dt_emb Control (exp_008f_s4)\\\": BASE_DIR / \\\"exp_008f_no_dt_emb_s4\\\" / \\\"metrics.jsonl\\\",\\n}\\nOUT_DIR = Path(\\\"/root/autodl-tmp/event-gated-adaptive-horizon/artifacts/figures\\\")\\nOUT_DIR.mkdir(parents=True, exist_ok=True)\\n\\ndef load_metrics(path):\\n    \\\"\\\"\\\"Load metrics.jsonl, separate train lines from metric lines.\\\"\\\"\\\"\\n    train_data = []  # step, train_return\\n    metric_data = []  # step, value_mean, target_mean, etc.\\n    eval_data = []  # step, eval_return\\n    \\n    with open(path) as f:\\n        for line in f:\\n            line = line.strip()\\n            if not line:\\n                continue\\n            d = json.loads(line)\\n            step = d.get(\\\"step\\\", 0)\\n            \\n            if \\\"value_mean\\\" in d:\\n                metric_data.append(d)\\n            elif \\\"eval_return\\\" in d:\\n                eval_data.append(d)\\n            elif \\\"train_return\\\" in d:\\n                train_data.append({\\\"step\\\": step, \\\"train_return\\\": d[\\\"train_return\\\"]})\\n    \\n    return train_data, metric_data, eval_data\\n\\n# Load all experiments\\nall_data = {}\\nfor name, path in EXPERIMENTS.items():\\n    train, metrics, evals = load_metrics(path)\\n    all_data[name] = {\\n        \\\"train\\\": train,\\n        \\\"metrics\\\": metrics,\\n        \\\"evals\\\": evals,\\n    }\\n    print(f\\\"\\\\n{name}:\\\")\\n    print(f\\\"  Train entries: {len(train)}, Metric entries: {len(metrics)}, Eval entries: {len(evals)}\\\")\\n    if metrics:\\n        steps = [m[\\\"step\\\"] for m in metrics]\\n        print(f\\\"  Step range: {min(steps)} - {max(steps)}\\\")\\n        print(f\\\"  value_mean range: {min(m['value_mean'] for m in metrics):.2f} - {max(m['value_mean'] for m in metrics):.2f}\\\")\\n        print(f\\\"  target_mean range: {min(m['target_mean'] for m in metrics):.2f} - {max(m['target_mean'] for m in metrics):.2f}\\\")\\n\\n# Also get eval returns at matching steps\\nfor name, data in all_data.items():\\n    eval_by_step = {e[\\\"step\\\"]: e[\\\"eval_return\\\"] for e in data[\\\"evals\\\"]}\\n    for m in data[\\\"metrics\\\"]:\\n        m[\\\"eval_return_at_step\\\"] = eval_by_step.get(m[\\\"step\\\"], None)\\n    # Aggregate train returns by step\\n    train_by_step = defaultdict(list)\\n    for t in data[\\\"train\\\"]:\\n        train_by_step[t[\\\"step\\\"]].append(t[\\\"train_return\\\"])\\n    for m in data[\\\"metrics\\\"]:\\n        tr = train_by_step.get(m[\\\"step\\\"], [])\\n        m[\\\"train_return_mean\\\"] = np.mean(tr) if tr else None\\n\\n# ===== FIGURE 1: Value Mean vs Target Mean Over Training =====\\nfig, axes = plt.subplots(1, 3, figsize=(15, 4.5), sharey=False)\\ncolors = {\\\"Baseline (exp_001_s4)\\\": \\\"#2196F3\\\", \\n           \\\"CIVO Collapsed (exp_008d_s4)\\\": \\\"#F44336\\\",\\n           \\\"No dt_emb Control (exp_008f_s4)\\\": \\\"#4CAF50\\\"}\\n\\nfor idx, (name, data) in enumerate(all_data.items()):\\n    ax = axes[idx]\\n    metrics = data[\\\"metrics\\\"]\\n    if not metrics:\\n        continue\\n    \\n    steps = np.array([m[\\\"step\\\"] for m in metrics]) / 1000\\n    value_means = np.array([m[\\\"value_mean\\\"] for m in metrics])\\n    target_means = np.array([m[\\\"target_mean\\\"] for m in metrics])\\n    \\n    ax.plot(steps, value_means, 'o-', color=colors[name], label=\\\"V(s) [critic prediction]\\\", markersize=5)\\n    ax.plot(steps, target_means, 's--', color=colors[name], alpha=0.6, label=\\\"λ-return target\\\", markersize=4)\\n    \\n    # Add diagonal reference\\n    ax.set_xlabel(\\\"Training Step (K)\\\")\\n    ax.set_ylabel(\\\"Value\\\")\\n    ax.set_title(name, fontsize=10, fontweight='bold')\\n    ax.legend(fontsize=8)\\n    ax.grid(True, alpha=0.3)\\n\\nplt.tight_layout()\\nplt.savefig(OUT_DIR / \\\"value_vs_target_timeseries.png\\\", dpi=150, bbox_inche\\n\\n... [截断: 输出过长，省略 4852 字符] ...\\n\\nn evals]\\n        ax.plot(steps, returns, 'o-', color=colors[name], label=name.split(\\\"(\\\")[0].strip(), markersize=4, linewidth=1.5)\\nax.set_xlabel(\\\"Step (K)\\\")\\nax.set_ylabel(\\\"Eval Return\\\")\\nax.set_title(\\\"(B) Actual Evaluation Returns\\\")\\nax.legend(fontsize=8)\\nax.grid(True, alpha=0.3)\\n\\n# Panel C: VE ratio\\nax = axes[1, 0]\\nfor name, data in all_data.items():\\n    metrics = data[\\\"metrics\\\"]\\n    if metrics:\\n        steps = [m[\\\"step\\\"]/1000 for m in metrics if \\\"civo/ve_ratio\\\" in m]\\n        ratios = [m[\\\"civo/ve_ratio\\\"] for m in metrics if \\\"civo/ve_ratio\\\" in m]\\n        if steps:\\n            ax.plot(steps, ratios, 'o-', color=colors[name], label=name.split(\\\"(\\\")[0].strip(), markersize=4, linewidth=1.5)\\nax.axhline(y=1.0, color='gray', linestyle='--', alpha=0.7)\\nax.axhline(y=1.5, color='red', linestyle=':', alpha=0.5, label='CIVO threshold')\\nax.set_xlabel(\\\"Step (K)\\\")\\nax.set_ylabel(\\\"VE Ratio\\\")\\nax.set_title(\\\"(C) Value/Eval Ratio (CIVO Indicator)\\\")\\nax.legend(fontsize=8)\\nax.grid(True, alpha=0.3)\\nax.set_ylim(bottom=0)\\n\\n# Panel D: V(s) vs Target scatter (all experiments)\\nax = axes[1, 1]\\nfor name, data in all_data.items():\\n    metrics = data[\\\"metrics\\\"]\\n    if metrics:\\n        values =