\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces PPL ($\downarrow $) on WikiText-2 at 4$\times $ compression. Unconstrained failure: catastrophic on Qwen-7B ($3.3\times $ bf16), severe on Pythia ($1.9\times $), moderate on Gemma-2 ($1.5\times $), mild on remaining incl.\ Qwen-14B (${\sim }1.1\times $). Greedy and MCKP columns are both unconstrained; identical allocations on 5/7 models (equivalence verified experimentally on Qwen-7B and Qwen-14B; Qwen-14B and Pythia Greedy values inferred via this equivalence). Best constrained result per model in \textbf  {bold}. $^*$BOS-corrected.}}{6}{table.caption.14}\protected@file@percent }
\newlabel{tab:main_results}{{2}{6}{PPL ($\downarrow $) on WikiText-2 at 4$\times $ compression. Unconstrained failure: catastrophic on Qwen-7B ($3.3\times $ bf16), severe on Pythia ($1.9\times $), moderate on Gemma-2 ($1.5\times $), mild on remaining incl.\ Qwen-14B (${\sim }1.1\times $). Greedy and MCKP columns are both unconstrained; identical allocations on 5/7 models (equivalence verified experimentally on Qwen-7B and Qwen-14B; Qwen-14B and Pythia Greedy values inferred via this equivalence). Best constrained result per model in \textbf {bold}. $^*$BOS-corrected}{table.caption.14}{}}
