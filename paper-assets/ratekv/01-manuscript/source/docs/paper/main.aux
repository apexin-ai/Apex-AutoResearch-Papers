\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Compounding effect across architectures. As the number of 2-bit heads ($k$) increases, PPL degradation follows architecture-dependent trajectories: Llama (spike, $c{=}0.57$) explodes to $1519\times $ at $k{=}256$ due to a single extreme-sensitivity head compounding through the residual stream; Qwen (spread, $c{=}0.61$) degrades $10\times $; Mistral (flat, $c{=}0.24$) remains most resilient ($6.4\times $). All three stay near-baseline for $k{\leq }8$, validating the cardinality constraint regime. Qwen saturates at $k{\approx }96$ due to its 112 KV heads (maximum ${\sim }96$ eligible for 2-bit assignment).}}{7}{figure.caption.16}\protected@file@percent }
\newlabel{fig:compounding_cross}{{1}{7}{Compounding effect across architectures. As the number of 2-bit heads ($k$) increases, PPL degradation follows architecture-dependent trajectories: Llama (spike, $c{=}0.57$) explodes to $1519\times $ at $k{=}256$ due to a single extreme-sensitivity head compounding through the residual stream; Qwen (spread, $c{=}0.61$) degrades $10\times $; Mistral (flat, $c{=}0.24$) remains most resilient ($6.4\times $). All three stay near-baseline for $k{\leq }8$, validating the cardinality constraint regime. Qwen saturates at $k{\approx }96$ due to its 112 KV heads (maximum ${\sim }96$ eligible for 2-bit assignment)}{figure.caption.16}{}}
