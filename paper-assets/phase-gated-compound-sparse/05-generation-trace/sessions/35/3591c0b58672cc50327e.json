cho \"=== c5b retry DONE WITH $FAIL_COUNT FAILURES $(date -u) ===\" | tee -a \"$LOG\"\nfi\nSCRIPT_EOF\nchmod +x /root/autodl-tmp/pacs/run_c5b_retry.sh",
