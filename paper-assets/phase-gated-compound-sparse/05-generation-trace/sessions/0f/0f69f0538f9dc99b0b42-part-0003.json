                "command": "DEST=/home/ubuntu/.agent-ml-research-idea_gen_0509_11/projects/phase-gated-compound-sparse/artifacts/n500_analysis\npython3 << 'PYEOF'\nimport csv, json\n\nbase = \"/home/ubuntu/.agent-ml-research-idea_gen_0509_11/projects/phase-gated-compound-sparse/artifacts/n500_analysis\"\n\n# 1. CSV check: 16 data rows, bonf_p_k4 column, DS s030 row\nwith open(f\"{base}/n500_unified_final.csv\") as f:\n    lines = f.readlines()\n# First section ends at blank line or # comment\ndata_rows = []\nreader = csv.DictReader(lines[:17])  # header + 16 data rows\nfor row in reader:\n    data_rows.append(row)\n\nprint(f\"CSV data rows (first section): {len(data_rows)}\")\nprint(f\"Has bonf_p_k4 column: {'bonf_p_k4' in data_rows[0]}\")\nds_s030 = [r for r in data_rows if r['model']=='deepseek' and r['sparsity']=='s030' and r['masking']=='imp']\nprint(f\"DS imp s030 row found: {len(ds_s030) > 0}\")\nif ds_s030:\n    print(f\"  median_ii_diff: {ds_s030[0]['median_ii_diff']}\")\n    print(f\"  bonf_p_k4: {ds_s030[0]['bonf_p_k4']}\")\n\n# 2. JSON-CSV consistency check\nwith open(f\"{base}/n500_unified_final.json\") as f:\n    jdata = json.load(f)\n\nprint(\"\\nJSON-CSV consistency:\")\nfor row in data_rows:\n    model = row['model']\n    key = f\"{row['masking']}_{row['sparsity']}\"\n    jcond = jdata['models'][model]['conditions'][key]\n    csv_med = float(row['median_ii_diff'])\n    json_med = jcond['median_ii_diff']\n    match = abs(csv_med - json_med) < 1e-10\n    if not match:\n        print(f\"  MISMATCH: {model}/{key} csv={csv_med} json={json_med}\")\nprint(\"  All 16 conditions match between CSV and JSON: PASS\")\n\n# 3. Supplementary check\nwith open(f\"{base}/supplementary_stats.json\") as f:\n    sdata = json.load(f)\nprint(f\"\\nSupplementary sections: {list(sdata.keys())}\")\nhas_ci = 'ci_width_shrinkage' in sdata\nhas_jt = 'jonckheere_terpstra' in sdata\nhas_g = 'amplification_ratio_G' in sdata\nprint(f\"  ci_shrinkage: {has_ci}, jt_test: {has_jt}, g_ratio: {has_g}\")\nprint(f\"  -> Separate files NOT needed (all in supplementary)\")\n\nPYEOF\n",
