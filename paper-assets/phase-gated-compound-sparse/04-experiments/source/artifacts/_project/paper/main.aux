\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Per-phase interaction index (II) from the $n{=}50$ profiling subset (DeepSeek-R1-Distill-Qwen-7B). This preliminary table does not include per-condition bootstrap CIs; full-scale values with bootstrap 95\% CIs ($B{=}10{,}000$) at $n{=}496$ appear in Table~\ref {tab:main-results}, and strategy-contrast CIs for this subset appear in the permutation test (Table~\ref {tab:permutation}). $G$ values use the ratio-of-medians definition ($\setbox \z@ \hbox {\mathsurround \z@ $\textstyle \mathrm  {II}$}\mathaccent "0365{\mathrm  {II}}_{\textit  {low}} / \setbox \z@ \hbox {\mathsurround \z@ $\textstyle \mathrm  {II}$}\mathaccent "0365{\mathrm  {II}}_{\textit  {high}}$) and serve as an auxiliary illustration of phase concentration; the primary evidence is $\Delta $ (see Appendix~\ref {app:g-metric}). At low sparsity ($s{=}0.15$), the ratio-of-medians and per-problem definitions diverge ($7.5{\times }$ vs.\ $69{\times }$) because per-problem ratios are sensitive to near-zero $\mathrm  {II}_{\textit  {high}}$ values.}}{18}{table.caption.46}\protected@file@percent }
\newlabel{tab:profiling-subset}{{6}{18}{Per-phase interaction index (II) from the $n{=}50$ profiling subset (DeepSeek-R1-Distill-Qwen-7B). This preliminary table does not include per-condition bootstrap CIs; full-scale values with bootstrap 95\% CIs ($B{=}10{,}000$) at $n{=}496$ appear in Table~\ref {tab:main-results}, and strategy-contrast CIs for this subset appear in the permutation test (Table~\ref {tab:permutation}). $G$ values use the ratio-of-medians definition ($\widetilde {\mathrm {II}}_{\textit {low}} / \widetilde {\mathrm {II}}_{\textit {high}}$) and serve as an auxiliary illustration of phase concentration; the primary evidence is $\Delta $ (see Appendix~\ref {app:g-metric}). At low sparsity ($s{=}0.15$), the ratio-of-medians and per-problem definitions diverge ($7.5{\times }$ vs.\ $69{\times }$) because per-problem ratios are sensitive to near-zero $\mathrm {II}_{\textit {high}}$ values}{table.caption.46}{}}
\@LN@col{1}
