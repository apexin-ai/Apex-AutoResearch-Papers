\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Paired median difference $\Delta $ (primary metric) as a function of sparsity level $s$ for DeepSeek-R1-Distill-Qwen-7B ($n{=}496$, left) and Qwen2.5-7B-Instruct ($n{=}475$, right). Importance-based eviction (red) exhibits monotonically increasing $\Delta $ ($0.39$--$8.48$ for DeepSeek, $0.07$--$3.16$ for Qwen); random eviction (blue) remains near zero at low sparsity (ns) and shows weak effects at $s \geq 0.25$. Error bars show asymmetric bootstrap 95\% CIs. DeepSeek importance effects are ${\sim }2.7{\times }$ larger than Qwen, consistent with the training-paradigm contrast (\S  \ref {sec:cross-model}). Significance: {*}{*}{*}\,$p_{\text  {Bonf}} < 0.001$; {*}{*}\,$p_{\text  {Bonf}} < 0.01$; ns\,$p_{\text  {Bonf}} > 0.05$.}}{8}{figure.caption.19}\protected@file@percent }
\newlabel{fig:hero}{{1}{8}{Paired median difference $\Delta $ (primary metric) as a function of sparsity level $s$ for DeepSeek-R1-Distill-Qwen-7B ($n{=}496$, left) and Qwen2.5-7B-Instruct ($n{=}475$, right). Importance-based eviction (red) exhibits monotonically increasing $\Delta $ ($0.39$--$8.48$ for DeepSeek, $0.07$--$3.16$ for Qwen); random eviction (blue) remains near zero at low sparsity (ns) and shows weak effects at $s \geq 0.25$. Error bars show asymmetric bootstrap 95\% CIs. DeepSeek importance effects are ${\sim }2.7{\times }$ larger than Qwen, consistent with the training-paradigm contrast (\S \ref {sec:cross-model}). Significance: {*}{*}{*}\,$p_{\text {Bonf}} < 0.001$; {*}{*}\,$p_{\text {Bonf}} < 0.01$; ns\,$p_{\text {Bonf}} > 0.05$}{figure.caption.19}{}}
