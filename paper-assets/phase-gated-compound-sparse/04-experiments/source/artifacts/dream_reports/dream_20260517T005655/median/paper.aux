\@writefile{toc}{\contentsline {section}{\numberline {4}Experiments}{4}{section.4}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.1}Scoring-Independent Control: Recency Eviction}{4}{subsection.4.1}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Recency eviction dose-response: $d_z$ increases with sparsity but remains null or weak across the tested range, confirming scoring-independent eviction does not produce the phase gradient observed with importance-based methods.}}{5}{table.3}\protected@file@percent }
\newlabel{tab:recency_dose}{{3}{5}{Recency eviction dose-response: $d_z$ increases with sparsity but remains null or weak across the tested range, confirming scoring-independent eviction does not produce the phase gradient observed with importance-based methods}{table.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces GPQA Diamond importance-based phase gradient across sparsity levels. The monotonic dose-response and large effect sizes ($d_z=0.81$ to $1.05$) confirm phase gradient universality on a third benchmark.}}{5}{table.4}\protected@file@percent }
\newlabel{tab:gpqa_dose}{{4}{5}{GPQA Diamond importance-based phase gradient across sparsity levels. The monotonic dose-response and large effect sizes ($d_z=0.81$ to $1.05$) confirm phase gradient universality on a third benchmark}{table.4}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.2}Cross-Benchmark Validation: GPQA Diamond}{5}{subsection.4.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.3}Strategy Specificity is Task-Modulated}{5}{subsection.4.3}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Per-phase perplexity decomposition on GPQA at $s=0.20$. KV-only and compound (both) degradation concentrate dramatically in low phase while dense perplexity is similar across phases, confirming that compound severity, not baseline difficulty, drives the phase gradient.}}{6}{table.5}\protected@file@percent }
\newlabel{tab:gpqa_ppl}{{5}{6}{Per-phase perplexity decomposition on GPQA at $s=0.20$. KV-only and compound (both) degradation concentrate dramatically in low phase while dense perplexity is similar across phases, confirming that compound severity, not baseline difficulty, drives the phase gradient}{table.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Cross-benchmark strategy specificity ratio at $s=0.25$. The importance/random gradient ratio decreases with task complexity (longer reasoning chains), indicating that strategy specificity is task-modulated rather than a universal constant.}}{6}{table.6}\protected@file@percent }
\newlabel{tab:specificity}{{6}{6}{Cross-benchmark strategy specificity ratio at $s=0.25$. The importance/random gradient ratio decreases with task complexity (longer reasoning chains), indicating that strategy specificity is task-modulated rather than a universal constant}{table.6}{}}
