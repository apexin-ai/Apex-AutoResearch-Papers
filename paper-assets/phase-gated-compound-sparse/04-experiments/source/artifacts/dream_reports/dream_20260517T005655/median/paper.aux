\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Triple dissociation at $s=0.25$: phase gradient by eviction strategy. Only importance-based eviction produces a significant phase gradient. Recency (scoring-independent) remains null.}}{4}{table.1}\protected@file@percent }
\newlabel{tab:triple_s025}{{1}{4}{Triple dissociation at $s=0.25$: phase gradient by eviction strategy. Only importance-based eviction produces a significant phase gradient. Recency (scoring-independent) remains null}{table.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Triple dissociation at $s=0.30$ (extreme sparsity). Recency shows a weak trend ($d_z=0.32$) that does not survive Bonferroni correction, while importance remains dominant.}}{4}{table.2}\protected@file@percent }
\newlabel{tab:triple_s030}{{2}{4}{Triple dissociation at $s=0.30$ (extreme sparsity). Recency shows a weak trend ($d_z=0.32$) that does not survive Bonferroni correction, while importance remains dominant}{table.2}{}}
