\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Triple dissociation across full sparsity range on MATH-500 (DeepSeek-R1-Distill-Qwen-7B, $n=100$). Only importance-based eviction produces significant phase gradients. Recency (scoring-independent) and random (structure-independent) are consistently non-significant.}}{5}{table.caption.9}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{tab:triple_dissociation}{{1}{5}{Triple dissociation across full sparsity range on MATH-500 (DeepSeek-R1-Distill-Qwen-7B, $n=100$). Only importance-based eviction produces significant phase gradients. Recency (scoring-independent) and random (structure-independent) are consistently non-significant}{table.caption.9}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Recency control at $s=0.25$ (DeepSeek-R1-Distill-Qwen-7B, $n=100$). Phase gradient is negligible despite high absolute interaction values. The importance-to-recency effect size ratio of $36\times $ confirms scoring-pathway specificity.}}{5}{table.caption.10}\protected@file@percent }
\newlabel{tab:recency_s025}{{2}{5}{Recency control at $s=0.25$ (DeepSeek-R1-Distill-Qwen-7B, $n=100$). Phase gradient is negligible despite high absolute interaction values. The importance-to-recency effect size ratio of $36\times $ confirms scoring-pathway specificity}{table.caption.10}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.3}Cross-Benchmark Validation: GPQA-Diamond}{5}{subsection.4.3}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Recency control at $s=0.30$ (DeepSeek-R1-Distill-Qwen-7B, $n=100$). Even at maximum sparsity, recency phase gradient remains negligible ($d_z = 0.15$) while importance reaches $d_z = 1.13$.}}{6}{table.caption.11}\protected@file@percent }
\newlabel{tab:recency_s030}{{3}{6}{Recency control at $s=0.30$ (DeepSeek-R1-Distill-Qwen-7B, $n=100$). Even at maximum sparsity, recency phase gradient remains negligible ($d_z = 0.15$) while importance reaches $d_z = 1.13$}{table.caption.11}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces GPQA-Diamond dose-response (DeepSeek-R1-Distill-Qwen-7B, importance eviction, $n=198$). Phase gradient increases monotonically with sparsity. Strategy specificity ratio $\geq 3\times $ across all levels.}}{6}{table.caption.12}\protected@file@percent }
\newlabel{tab:gpqa_dose_response}{{4}{6}{GPQA-Diamond dose-response (DeepSeek-R1-Distill-Qwen-7B, importance eviction, $n=198$). Phase gradient increases monotonically with sparsity. Strategy specificity ratio $\geq 3\times $ across all levels}{table.caption.12}{}}
