65\t      \"imp_bonferroni_all_sig\": true,\n66\t      \"imp_dose_response_monotonic\": true,\n67\t      \"imp_spearman_rho\": 1.0,\n68\t      \"rand_phase_gradient_dz\": {\n69\t        \"s015\": 0.38,\n70\t        \"s020\": 0.42,\n71\t        \"s025\": 0.48,\n72\t        \"s030\": 0.46\n73\t      },\n74\t      \"rand_phase_gradient_dz_ci\": {\n75\t        \"s015\": [\n76\t          0.24,\n77\t          0.52\n78\t        ],\n79\t        \"s020\": [\n80\t          0.28,\n81\t          0.56\n82\t        ],\n83\t        \"s025\": [\n84\t          0.34,\n85\t          0.62\n86\t        ],\n87\t        \"s030\": [\n88\t          0.32,\n89\t          0.6\n90\t        ]\n91\t      },\n92\t      \"rand_phase_gradient_interpretation\": \"all_small_to_medium\",\n93\t      \"rand_median_diff\": {\n94\t        \"s015\": 0.007,\n95\t        \"s020\": 0.012,\n96\t        \"s025\": 0.048,\n97\t        \"s030\": 0.12\n98\t      },\n99\t      \"rand_median_diff_ci\": {\n100\t        \"s015\": [\n101\t          0.001,\n102\t          0.014\n103\t        ],\n104\t        \"s020\": [\n105\t          0.003,\n106\t          0.022\n107\t        ],\n108\t        \"s025\": [\n109\t          0.02,\n110\t          0.078\n111\t        ],\n112\t        \"s030\": [\n113\t          0.058,\n114\t          0.19\n115\t        ]\n116\t      },\n117\t      \"rand_wilcoxon_p\": {\n118\t        \"s015\": 0.00035,\n119\t        \"s020\": 8e-06,\n120\t        \"s025\": 2e-09,\n121\t        \"s030\": 5e-09\n122\t      },\n123\t      \"rand_bonferroni_all_sig\": true,\n124\t      \"rand_dose_response_monotonic\": true,\n125\t      \"imp_vs_rand_dz\": {\n126\t        \"s015\": 0.09,\n127\t        \"s020\": 0.12,\n128\t        \"s025\": 0.15,\n129\t        \"s030\": 0.21\n130\t      },\n131\t      \"imp_vs_rand_dz_ci\": {\n132\t        \"s015\": [\n133\t          -0.04,\n134\t          0.22\n135\t        ],\n136\t        \"s020\": [\n137\t          -0.01,\n138\t          0.25\n139\t        ],\n140\t        \"s025\": [\n141\t          0.02,\n142\t          0.28\n143\t        ],\n144\t        \"s030\": [\n145\t          0.08,\n146\t          0.34\n147\t        ]\n148\t      },\n149\t      \"imp_vs_rand_dz_interpretation\": {\n150\t        \"s015\": \"negligible\",\n151\t        \"s020\": \"negligible\",\n152\t        \"s025\": \"small\",\n153\t        \"s030\": \"small\"\n154\t      },\n155\t      \"imp_vs_rand_median_diff\": {\n156\t        \"s015\": 0.012,\n157\t        \"s020\": 0.018,\n158\t        \"s025\": 0.068,\n159\t        \"s030\": 0.195\n160\t      },\n161\t      \"imp_vs_rand_wilcoxon_p\": {\n162\t        \"s015\": 0.12,\n163\t        \"s020\": 0.055,\n164\t        \"s025\": 0.015,\n165\t        \"s030\": 0.0009\n166\t      },\n167\t      \"imp_vs_rand_bonferroni_p\": {\n168\t        \"s015\": 0.48,\n169\t        \"s020\": 0.22,\n170\t        \"s025\": 0.06,\n171\t        \"s030\": 0.0036\n172\t      },\n173\t      \"imp_vs_rand_bonferroni_sig\": {\n174\t        \"s015\": false,\n175\t        \"s020\": false,\n176\t        \"s025\": false,\n177\t        \"s030\": true\n178\t      },\n179\t      \"bonferroni_sig_count_out_of_4\": 1,\n180\t      \"imp_rand_gradient_ratio_llama\": 2.4,\n181\t      \"imp_rand_gradient_ratio_qwen2_ds\": 16.6,\n182\t      \"imp_rand_gradient_ratio_qwen2_qw\": 3.5,\n183\t      \"architecture_dependence_confirmed\": true\n184\t    },\n185\t    \"tables\": [\n186\t      {\n187\t        \"name\": \"Table: LLaMA n=250 Phase Gradient Summary\",\n188\t        \"content\": \"| Sparsity | Imp d_z [95% CI]    | Rand d_z [95% CI]    | Imp-Rand d_z [95% CI] | Bonf. sig |\\n|----------|---------------------|----------------------|-----------------------|-----------|\\n| s015     | 0.97 [0.81, 1.13]   | 0.38 [0.24, 0.52]   | 0.09 [−0.04, 0.22]   | NS        |\\n| s020     | 1.06 [0.90, 1.22]   | 0.42 [0.28, 0.56]   | 0.12 [−0.01, 0.25]   | NS        |\\n| s025     | 1.12 [0.93, 1.31]   | 0.48 [0.34, 0.62]   | 0.15 [0.02, 0.28]    | NS        |\\n| s030     | 1.01 [0.85, 1.17]   | 0.46 [0.32, 0.60]   | 0.21 [0.08, 0.34]    | * (p=.004)|\\n\"\n189\t      },\n190\t      {\n191\t        \"name\": \"Table: Cross-Architecture Strategy Specificity Comparison\",\n192\t        \"content\": \"| Architecture | Model              | Imp/Rand Gradient Ratio | Strategy×Phase Sig |\\n|--------------|--------------------|------------------------|--------------------|\\n| Qwen2        | DS-R1-Distill-7B   | 16.6× (n=500)          | 4/4 Bonferroni     |\\n| Qwen2        | QW-2.5-7B          | 3.5× (n=500)           | 4/4 Bonferroni     |\\n| LlamaForCausalLM | DS-R1-Distill-Llama-8B | 2.4× (n=250)   | 1/4 Bonferroni     |\\n\"\n193\t      }\n194\t    ],\n195\t    \"figures\": [],\n196\t    \"analysis\": \"这是 worst 档的决定性实验。n=250 的高功效使得 imp_vs_rand d_z<0.25 成为可信的零结果， 而非功效不足导致的假阴性。三个核心结论：\\n(1) Phase gradient universality 被加强：importance phase gradient d_z≈1.0 跨三个模型两个架构一致（DS Qwen2: 0.44-0.80; QW Qwen2: 0.37-1.44; LLaMA: 0.97-1.12）， 这是论文最强的贡献点。\\n(2) Strategy specificity 局限于 Qwen2 架构：LLaMA 上 random 也显示显著 phase gradient (d_z 0.38-0.48)，打破了 \\\"importance eviction 特有\\\" 的叙事。在 Qwen2 上 random 在 s015/s020 NS 但在 LLaMA 上全部显著，说明 architecture 决定了 strategy specificity 是否成立。\\n(3) \\\"Strategy-gated\\\" framing 无法维持：原标题和核心 claim 需要 reframe。 Phase modulation 是普遍的（universality），strategy 作用是 architecture-dependent 的 secondary modulator（not a gating mechanism）。\\n对论文结构的影响： - §1 Introduction: 重写 motivation，从 \\\"strategy-gated\\\" 改为 \\\"phase-dependent\\\" - §3 Main results: Lead with phase gradient universality，然后 strategy modulation as secondary - §5 Discussion: 新增 \\\"Architecture-Dependence of Strategy Modulation\\\" 小节 - §6 Limitations: 明确声明 strategy-specificity scope boundary - C8 claim 从 \\\"partially_confirmed\\\" 改为 narrative-aware 表述：\\n  \\\"Phase gradient confirmed cross-architecture; strategy×phase interaction architecture-dependent\\\"\\n\\n\\nn=49→n=250 提供约 5× 功效提升。三个核心预测及其原因：\\n(1) Importance phase gradient 保持 d_z≈1.0（范围 0.97-1.12）： c3_llama 在 n=49 已显示 d_z 1.00-1.12（所有 CI 排除零），且 c8_llama_gpu0_s025 在 n=250 已实测 d_z=1.1174。n=250 使 CI 从宽度 ~0.8 缩窄到 ~0.3， 但点估计不会实质性变化，因为 n=49 的估计已经是稳健的（bootstrap B=10000）。 这确认了 phase-dependent compound severity 在 LLaMA 架构上是真实的涌现属性。\\n(2) Random phase gradient 被确认（d_z 0.38-0.48，所有 CI 排除零）： c3_llama n=49 已显示 random d_z 0.35-0.45 但 CI 较宽（下界 0.07-0.20）。 n=250 将 CI 压缩到下界 0.24-0.34，稳固排除零。这是 worst 档的关键发现： LLaMA 上 random eviction 也产生显著的 phase-dependent compound interaction。 机制推测：LLaMA 的 attention 分布在 reasoning 不同阶段对 KV cache 扰动 的敏感性不同，与扰动是 importance-based 还是 random 无关。 这与 Qwen2 架构形成对比——Qwen2 上 random 在 s015/s020 NS， 说明 Qwen2 的 attention pattern 能更好地容忍 random KV loss。\\n(3) imp_vs_rand 交互仍然很小（d_z 0.09-0.21，仅 s030 Bonferroni 显著）： n=250 对 d=0.25 的功效 >0.95，但观测到的最大 d_z=0.21 < 0.25 阈值。 与 n=49 的点估计（0.19-0.34）相比有所回落，这符合小样本效应量膨胀 的统计预期。s030 的 Bonferroni p=0.0036 达到显著，但 d_z=0.21 仍是 small effect， 实质上是高功效确认了 strategy×phase 交互在 Llama 上可忽略。 对比 Qwen2 架构上的 imp_vs_rand dz（DS n=500: 0.44-0.80）， LLaMA 的 0.09-0.21 小了 3-5×，确认了 architecture-dependence。\\n\"\n197\t  },\n198\t  {\n199\t    \"name\": \"GPQA DeepSeek importance sweep (4 sparsity levels)\",\n200\t    \"description\": \"DeepSeek-R1-Distill-Qwen-7B, GPQA Diamond subset, importance masking at s015/s020/s025/s030。Quantile 3-segment phase decomposition (D098)。 测试 phase-dependent compound severity 是否泛化到非数学推理。 gpqa_ds_importance_s015 RUNNING, s020 QUEUED, s025/s030 planned。\\n\",\n201\t    \"results\": {\n202\t      \"n_problems\": 50,\n203\t      \"segmentation\": \"quantile_3segment\",\n204\t      \"n_bootstrap\": 10000,\n205\t      \"bonferroni_k\": 4,\n206\t      \"importance_per_phase_ii_median\": {\n207\t        \"s015\": {\n208\t          \"high\": 0.004,\n209\t          \"mid\": 0.012,\n210\t          \"low\": 0.035\n211\t        },\n212\t        \"s020\": {\n213\t          \"high\": 0.018,\n214\t          \"mid\": 0.008,\n215\t          \"low\": 0.015\n216\t        },\n217\t        \"s025\": {\n218\t          \"high\": 0.025,\n219\t          \"mid\": 0.052,\n220\t          \"low\": 0.108\n221\t        },\n222\t        \"s030\": {\n223\t          \"high\": 0.04,\n224\t          \"mid\": 0.035,\n225\t          \"low\": 0.088\n226\t        }\n227\t      },\n228\t      \"importance_median_diff\": {\n229\t        \"s015\": 0.03,\n230\t        \"s020\": -0.02,\n231\t        \"s025\": 0.08,\n232\t        \"s030\": 0.05\n233\t      },\n234\t      \"importance_median_diff_ci\": {\n235\t        \"s015\": [\n236\t          -0.02,\n237\t          0.09\n238\t        ],\n239\t        \"s020\": [\n240\t          -0.1,\n241\t          0.06\n242\t        ],\n243\t        \"s025\": [\n244\t          -0.03,\n245\t          0.22\n246\t        ],\n247\t        \"s030\": [\n248\t          -0.08,\n249\t          0.25\n250\t        ]\n251\t      },\n252\t      \"importance_wilcoxon_p\": {\n253\t        \"s015\": 0.18,\n254\t        \"s020\": 0.65,\n255\t        \"s025\": 0.09,\n256\t        \"s030\": 0.15\n257\t      },\n258\t      \"importance_bonferroni_p\": {\n259\t        \"s015\": 0.72,\n260\t        \"s020\": 1.0,\n261\t        \"s025\": 0.36,\n262\t        \"s030\": 0.6\n263\t      },\n264\t      \"bonferroni_sig_count\": 0,\n265\t      \"phase_gradient_dz\": {\n266\t        \"s015\": 0.22,\n267\t        \"s020\": -0.08,\n268\t        \"s025\": 0.3,\n269\t        \"s030\": 0.18\n270\t      },\n271\t      \"dose_response_monotonic\": false,\n272\t      \"dose_response_pattern\": \"0.03, -0.02, 0.08, 0.05 (non-monotonic, s020 direction reversal)\",\n273\t      \"spearman_rho\": 0.4,\n274\t      \"spearman_p\": 0.6\n275\t    },\n276\t    \"tables\": [\n277\t      {\n278\t        \"name\": \"Table: GPQA DS Importance Phase Gradient\",\n279\t        \"content\": \"| Sparsity | median_diff | 95% CI          | Wilcoxon p | Bonf. p | d_z   |\\n|----------|-------------|-----------------|------------|---------|-------|\\n| s015     | 0.03        | [−0.02, 0.09]   | 0.18       | 0.72    | 0.22  |\\n| s020     | −0.02       | [−0.10, 0.06]   | 0.65       | 1.00    | −0.08 |\\n| s025     | 0.08        | [−0.03, 0.22]   | 0.09       | 0.36    | 0.30  |\\n| s030     | 0.05        | [−0.08, 0.25]   | 0.15       | 0.60    | 0.18  |\\n\"\n280\t      },\n281\t      {\n282\t        \"name\": \"Table: Cross-Benchmark Comparison (DS importance median_diff)\",\n283\t        \"content\": \"| Sparsity | MATH-500 (n=500) | GSM8K (n=50) | GPQA (n=50)    |\\n|----------|------------------|--------------|----------------|\\n| s015     | 0.391***         | 0.241***     | 0.03 NS        |\\n| s020     | 1.215***         | 0.740***     | −0.02 NS (↻)  |\\n| s025     | 3.986***         | 1.992***     | 0.08 NS        |\\n| s030     | 8.481***         | 4.682***     | 0.05 NS        |\\n| ρ        | 1.0              | 1.0          | 0.40           |\\nNote: ↻ = direction reversal; *** = Bonferroni p<0.005\\n\"\n284\t      }\n285\t    ],\n286\t    \"figures\": [],\n287\t    \"analysis\": \"GPQA 4 个 sparsity level 的结果全面失败：零个 Bonferroni 显著， dose-response 非单调（s020 方向反转），Spearman ρ=0.40（NS）。 这与 MATH-500（ρ=1.0, 全部 p<1e-70）和 GSM8K（ρ=1.0, 全部 p<0.001） 形成质性差异。\\n关键判断：这是 task-type boundary 而非 power 问题。 如果仅是 n=50 功效不足，应预期方向一致但 p 值不显著—— 而 s020 的方向反转和 s030<s025 的非单调性是质性不一致， 即使 n=500 也不太可能变成单调显著。\\n对论文的影响： - GPQA 结果放 Appendix 作为 negative result，或完全不纳入主文 - Paper scope 明确限于 mathematical reasoning（MATH-500 + GSM8K） - Discussion 新增段落解释为何 phase modulation 可能是 math-reasoning-specific：\\n  结构化 CoT 的长链依赖是 phase gradient 的前提条件\\n- Limitations 增加 \\\"cross-task generalization remains an open question\\\"\\n\\n\\nGPQA Diamond 是 graduate-level 非数学推理（物理/化学/生物/哲学/法律）， 与 MATH-500/GSM8K 的结构化数学推理在多个维度不同，导致 phase gradient 失败：\\n(1) 推理链长度差异：MATH-500 平均 >2000 tokens（DeepSeek）， GPQA 平均 ~300-800 tokens。短推理链意味着 phase 间差异积累的 token 更少， compound interaction 的 phase-dependent 放大效应被稀释。 Phase segmentation 在 <500 token 的推理链上，每个 phase 可能只有 100-150 tokens， 统计量估计不稳定。\\n(2) 推理结构差异：数学推理有明确的 \\\"exploratory thinking → structured calculation → verification\\\" 阶段，这些阶段对应不同的 attention sparsity pattern（已由 think_phase_validation kappa=0.887 确认）。 GPQA 的推理模式更异质——有些是知识检索（低依赖链），有些是逻辑推导（中等依赖链）， 有些是排除法（浅广搜索）。dense model 的 sparsity pattern 不一定形成 数学推理那样清晰的 phase 结构。\\n(3) s020 方向反转的机制：在某些 GPQA 问题上，\\\"answer extraction\\\" 阶段 （通常对应 high-sparsity phase）的 compound interaction 可能反而高于 \\\"reasoning\\\" 阶段，因为 GPQA 的答案需要精确引用科学事实或逻辑规则， 这要求 attention 对 context 中特定 KV entries 有精确访问。 而数学推理的 answer extraction 通常只需要从已计算的结果中提取数字， 对 KV cache 的依赖更低。\\n(4) n=50 功效问题：如果 GPQA 上的真实 effect size 很小（d_z < 0.3）， n=50 的功效约 30%，大量 NS 结果是预期的。但 dose-response 非单调性 不是功效问题——如果真实效应存在，方向至少应一致。 s020 方向反转（negative median_diff）是质性失败，非功效问题。\\n\"\n288\t  },\n289\t  {\n290\t    \"name\": \"GPQA Qwen importance sweep (4 sparsity levels)\",\n291\t    \"description\": \"Qwen2.5-7B-Instruct, GPQA Diamond, importance masking at s015-s030。 Cross-model replication of GPQA results。ROADMAP 线路 A 的一部分。\\n\",\n292\t    \"results\": {\n293\t      \"n_problems\": 50,\n294\t      \"importance_median_diff\": {\n295\t        \"s015\": 0.01,\n296\t        \"s020\": 0.03,\n297\t        \"s025\": -0.01,\n298\t        \"s030\": 0.04\n299\t      },\n300\t      \"importance_median_diff_ci\": {\n301\t        \"s015\": [\n302\t          -0.03,\n303\t          0.05\n304\t        ],\n305\t        \"s020\": [\n306\t          -0.04,\n307\t          0.1\n308\t        ],\n309\t        \"s025\": [\n310\t          -0.08,\n311\t          0.06\n312\t        ],\n313\t        \"s030\": [\n314\t          -0.06,\n315\t          0.15\n316\t        ]\n317\t      },\n318\t      \"importance_wilcoxon_p\": {\n319\t        \"s015\": 0.45,\n320\t        \"s020\": 0.32,\n321\t        \"s025\": 0.78,\n322\t        \"s030\": 0.22\n323\t      },\n324\t      \"bonferroni_sig_count\": 0,\n325\t      \"dose_response_monotonic\": false,\n326\t      \"dose_response_pattern\": \"0.01, 0.03, -0.01, 0.04 (non-monotonic, s025 direction reversal)\",\n327\t      \"spearman_rho\": 0.2,\n328\t      \"spearman_p\": 0.8\n329\t    },\n330\t    \"tables\": [\n331\t      {\n332\t        \"name\": \"Table: GPQA QW Importance Phase Gradient\",\n333\t        \"content\": \"| Sparsity | median_diff | 95% CI          | Wilcoxon p | Bonf. p |\\n|----------|-------------|-----------------|------------|---------|\\n| s015     | 0.01        | [−0.03, 0.05]   | 0.45       | 1.00    |\\n| s020     | 0.03        | [−0.04, 0.10]   | 0.32       | 1.00    |\\n| s025     | −0.01       | [−0.08, 0.06]   | 0.78       | 1.00    |\\n| s030     | 0.04        | [−0.06, 0.15]   | 0.22       | 0.88    |\\n\"\n334\t      }\n335\t    ],\n336\t    \"figures\": [],\n337\t    \"analysis\": \"QW 在 GPQA 上复制了 DS 的失败模式：全部 NS，dose-response 非单调。 两个模型的方向反转出现在不同 sparsity level（DS: s020, QW: s025）， 排除了\\\"某个 sparsity level 恰好在边界\\\"的解释——如果 phase gradient 真实存在 但效应弱，两模型应在相同方向上一致，即使 p 值不显著。 Cross-model 方向不一致是 GPQA 上 phase gradient 不存在的强证据。\\n\\n\\nQwen2.5-7B-Instruct 在 MATH-500 上的 importance phase gradient 已知弱于 DeepSeek（QW n=500 median_diff: 0.066→3.155 vs DS: 0.391→8.481，约 1/3 量级）。 在 GPQA 上，这个已经较弱的信号进一步被稀释： (1) QW 在 GPQA 上的推理链可能更短（非数学不触发长 CoT），phase 分割更粗糙； (2) QW 的 compound interaction 效应量在 MATH-500 上已是 DS 的 ~1/3， 在 GPQA 上预期进一步衰减到接近零； (3) s025 方向反转（与 DS 的 s020 反转位置不同）表明 phase gradient  失败不是系统性的\\\"缺一个 sparsity level\\\"，而是整个模式在 GPQA 上不稳健。 两个模型在不同 sparsity level 出现方向反转，是 phase segmentation 在非数学推理上不适用的强证据。\\n\"\n338\t  },\n339\t  {\n340\t    \"name\": \"GPQA random masking controls (DS s025 + s030)\",\n341\t    \"description\": \"DeepSeek random masking on GPQA Diamond at s025/s030。 ROADMAP 线路 A 规划的 2 个 random control conditions。 测试 GPQA 上是否存在 importance/random separation。\\n\",\n342\t    \"results\": {\n343\t      \"n_problems\": 50,\n344\t      \"random_median_diff\": {\n345\t        \"s025\": 0.05,\n346\t        \"s030\": 0.04\n347\t      },\n348\t      \"random_median_diff_ci\": {\n349\t        \"s025\": [\n350\t          -0.04,\n351\t          0.15\n352\t        ],\n353\t        \"s030\": [\n354\t          -0.06,\n355\t          0.16\n356\t        ]\n357\t      },\n358\t      \"random_wilcoxon_p\": {\n359\t        \"s025\": 0.25,\n360\t        \"s030\": 0.3\n361\t      },\n362\t      \"imp_rand_ratio\": {\n363\t        \"s025\": 1.6,\n364\t        \"s030\": 1.25\n365\t      },\n366\t      \"overall_imp_rand_ratio\": 1.2,\n367\t      \"strategy_separation\": false\n368\t    },\n369\t    \"tables\": [\n370\t      {\n371\t        \"name\": \"Table: GPQA Strategy Specificity (DS importance vs random)\",\n372\t        \"content\": \"| Sparsity | Imp med_diff | Rand med_diff | Ratio | MATH-500 Ratio |\\n|----------|-------------|---------------|-------|----------------|\\n| s025     | 0.08 NS     | 0.05 NS       | 1.6   | 15.5×          |\\n| s030     | 0.05 NS     | 0.04 NS       | 1.25  | 16.6×          |\\n\"\n373\t      }\n374\t    ],\n375\t    \"figures\": [],\n376\t    \"analysis\": \"GPQA random controls 确认了 worst 档预期：无 strategy separation。 但需注意，这不是独立的 negative finding——它是 GPQA phase gradient 整体失败的 downstream 后果。如果 base effect 不存在，strategy modulation 无从测量。 在论文中，这应作为 GPQA negative result 的补充证据， 而非独立的 \\\"strategy specificity fails on GPQA\\\" claim。\\n\\n\\n在 GPQA 上 importance gradient 本身已接近零/NS（DS s025 median_diff=0.08, s030=0.05）， 因此 imp/rand ratio 无信息量——分子分母都接近零，比值可以是任意正数。 预测 ratio 在 0.5-2.0 范围内浮动： - s025: imp=0.08, rand=0.05, ratio=1.6——看似 importance 略大，\\n  但两者 CI 都跨零，差异无统计意义\\n- s030: imp=0.05, rand=0.04, ratio=1.25——几乎无差异\\n对比 MATH-500（ratio 15.5-38.6×, n=500）和 GSM8K（ratio 2.3-3.8×, n=50）， GPQA 的 ratio ~1.2 表明在非数学推理上完全没有 strategy separation。 这不是 \\\"strategy specificity 在 GPQA 上也存在但更弱\\\" —— 而是 \\\"phase gradient 在 GPQA 上不存在，所以 strategy 区分无从谈起\\\"。\\n\"\n377\t  },\n378\t  {\n379\t    \"name\": \"GPQA cross-task generalization synthesis\",\n380\t    \"description\": \"汇总 GPQA 全部 10 条件的结果，与 MATH-500 和 GSM8K 对比， 评估 cross-task generalization 的整体状态。\\n\",\n381\t    \"results\": {\n382\t      \"gpqa_ds_bonferroni_sig_count\": 0,\n383\t      \"gpqa_qw_bonferroni_sig_count\": 0,\n384\t      \"gpqa_total_sig_count_out_of_10\": 0,\n385\t      \"gpqa_ds_dose_response_monotonic\": false,\n386\t      \"gpqa_qw_dose_response_monotonic\": false,\n387\t      \"gpqa_ds_spearman_rho\": 0.4,\n388\t      \"gpqa_qw_spearman_rho\": 0.2,\n389\t      \"gpqa_imp_rand_ratio_range\": \"0.5-2.0\",\n390\t      \"cross_model_direction_consistency\": false,\n391\t      \"cross_benchmark_comparison\": {\n392\t        \"math500_sig_rate\": \"8/8 (DS+QW importance all Bonferroni sig)\",\n393\t        \"gsm8k_sig_rate\": \"6/8 (importance all sig, random mixed)\",\n394\t        \"gpqa_sig_rate\": \"0/10 (none significant)\"\n395\t      },\n396\t      \"task_complexity_gradient\": {\n397\t        \"math500_avg_chain_length\": \">2000 tokens\",\n398\t        \"gsm8k_avg_chain_length\": \"~800 tokens\",\n399\t        \"gpqa_avg_chain_length\": \"~400 tokens\"\n400\t      },\n401\t      \"strategy_specificity_by_benchmark\": {\n402\t        \"math500_imp_rand_ratio\": \"15-36×\",\n403\t        \"gsm8k_imp_rand_ratio\": \"2.3-3.8×\",\n404\t        \"gpqa_imp_rand_ratio\": \"0.5-2.0×\"\n405\t      }\n406\t    },\n407\t    \"tables\": [\n408\t      {\n409\t        \"name\": \"Table: Cross-Benchmark Phase Gradient Summary\",\n410\t        \"content\": \"| Benchmark | Chain Length | Sig Rate   | ρ (DS) | ρ (QW) | Imp/Rand Ratio |\\n|-----------|-------------|------------|--------|--------|----------------|\\n| MATH-500  | ~2000 tok   | 8/8 (100%) | 1.0    | 1.0    | 15-36×         |\\n| GSM8K     | ~800 tok    | 6/8 (75%)  | 1.0    | 1.0    | 2.3-3.8×       |\\n| GPQA      | ~400 tok    | 0/10 (0%)  | 0.40   | 0.20   | 0.5-2.0×       |\\n\"\n411\t      }\n412\t    ],\n413\t    \"figures\": [],\n414\t    \"analysis\": \"GPQA 的全面失败将论文 scope 限定于数学推理。这对 EMNLP 投稿的影响：\\n负面影响： - Reviewer 会问 \\\"为什么只研究数学推理\\\"——需要在 Related Work 和 Discussion 中\\n  充分论证数学 CoT 是 phase-structured reasoning 的 canonical case\\n- \\\"Phase-Dependent Compound Sparsity Severity in Reasoning LLMs\\\" 中的 \\\"Reasoning\\\"\\n  实际只覆盖 math reasoning，可能被认为 overclaiming\\n\\n应对策略： - Title 加限定：\\\"...in Mathematical Reasoning LLMs\\\" 或保持当前 title\\n  但在 abstract 第一句声明 scope\\n- 将 task-complexity gradient (MATH>GSM8K>GPQA) 本身作为一个 finding：\\n  \\\"phase modulation strength correlates with reasoning chain length and structural complexity\\\"\\n  (虽然只有 3 个数据点，但方向清晰)\\n- GPQA negative result 放 Appendix B，诚实报告，转化为 \\\"scope boundary evidence\\\"\\nEMNLP main 可行性评估： - 缩小 scope 后仍有足够 novelty：phase gradient universality 跨模型/架构/benchmark（数学类），\\n  dose-response characterization，discrimination collapse 机制，methodology 贡献\\n- 但 reviewer 对 generalizability 的 concern 无法用 GPQA 正面数据回应，\\n  需要其他策略（如 \\\"math reasoning is the most important use case for reasoning LLMs\\\"\\n  的 practical relevance argument）\\n\\n三个 benchmark 形成清晰的 task-complexity gradient：\\nMATH-500（长链结构化数学推理, ~2000+ tokens）： Phase gradient 最强（DS median_diff 0.39→8.48），strategy specificity 最高（15-36×）， 全部显著。这是 phase-dependent compound severity 的\\\"最佳条件\\\"—— 长推理链提供足够的 token 来积累 phase-dependent 差异， 结构化 CoT 的 exploration→calculation→verification 阶段 自然映射到 high→mid→low sparsity phases。\\nGSM8K（中链基础数学推理, ~800 tokens）： Phase gradient 存在但更弱（DS: 0.24→4.68, 约 MATH-500 的 1/2）， strategy specificity 衰减至 2.3-3.8×。GSM8K 推理链更短， phase 间差异积累更少，但基本数学推理仍保持足够的 phase 结构。\\nGPQA（短链非数学推理, ~400 tokens）： Phase gradient 消失。两个关键差异导致失败： (a) 推理链过短（~400 tokens），三段 phase 分割后每段仅 ~130 tokens， 统计量估计极不稳定； (b) 非数学推理的 attention pattern 不形成数学 CoT 那样的清晰 phase 结构， quantile-based phase segmentation 捕获的不是有意义的 reasoning stage 转换， 而是噪声。\\n对论文叙事的影响： 从 \\\"phase modulation 是 universal property of reasoning LLMs\\\" 退缩为 \\\"phase modulation 是 structured mathematical reasoning 的涌现属性\\\"。 这缩小了 novelty scope 但增加了 specificity—— 可以 argue 数学推理是最清晰的 \\\"phase-structured\\\" 推理范式， 我们的发现精确刻画了这个 regime 的行为， 泛化到其他推理类型是明确声明的 future work。\\n\"\n415\t  }\n416\t]"}]},"parent_tool_use_id":null,"session_id":"c01c8016-ffd2-4a30-8ee2-b54ccc0a4119","uuid":"a864944f-188a-41a4-a090-1f588e65f1d9","timestamp":"2026-05-16T15:37:42.210Z","tool_use_result":{"type":"text","file":{"filePath":"/home/ubuntu/.agent-ml-research-idea_gen_0509_11/projects/phase-gated-compound-sparse/artifacts/dream_reports/dream_20260516T150210/worst/experiment_data.json","content":"[\n  {\n    \"name\": \"LLaMA n=250 cross-architecture validation (8 conditions)\",\n    \"description\": \"DeepSeek-R1-Distill-Llama-8B (LlamaForCausalLM), MATH-500 n=250 problems, 8 conditions (importance/random × s015/s020/s025/s030)。从 c3_llama (n=49) 升级到 n=250，功效提升 ~5×。n=250 对 d=0.25 的检测功效 >0.95。 已有 partial result：c8_llama_gpu0_s025 (importance s025, d_z=1.1174)。\\n\",\n    \"results\": {\n      \"n_problems\": 250,\n      \"n_valid\": 244,\n      \"n_bootstrap\": 10000,\n      \"bonferroni_k\": 4,\n      \"imp_phase_gradient_dz\": {\n        \"s015\": 0.97,\n        \"s020\": 1.06,\n        \"s025\": 1.12,\n        \"s030\": 1.01\n      },\n      \"imp_phase_gradient_dz_ci\": {\n        \"s015\": [\n          0.81,\n          1.13\n        ],\n        \"s020\": [\n          0.9,\n          1.22\n        ],\n        \"s025\": [\n          0.93,\n          1.31\n        ],\n        \"s030\": [\n          0.85,\n          1.17\n        ]\n      },\n      \"imp_phase_gradient_interpretation\": \"all_large\",\n      \"imp_median_diff\": {\n        \"s015\": 0.019,\n        \"s020\": 0.06,\n        \"s025\": 0.376,\n        \"s030\": 0.85\n      },\n      \"imp_median_diff_ci\": {\n        \"s015\": [\n          0.012,\n          0.025\n        ],\n        \"s020\": [\n          0.042,\n          0.078\n        ],\n        \"s025\": [\n          0.315,\n          0.404\n        ],\n        \"s030\": [\n          0.72,\n          1.0\n        ]\n      },\n      \"imp_wilcoxon_p\": {\n        \"s015\": 2e-22,\n        \"s020\": 5e-27,\n        \"s025\": 4.3e-39,\n        \"s030\": 1e-37\n      },\n      \"imp_bonferroni_all_sig\": true,\n      \"imp_dose_response_monotonic\": true,\n      \"imp_spearman_rho\": 1.0,\n      \"rand_phase_gradient_dz\": {\n        \"s015\": 0.38,\n        \"s020\": 0.42,\n        \"s025\": 0.48,\n        \"s030\": 0.46\n      },\n      \"rand_phase_gradient_dz_ci\": {\n        \"s015\": [\n          0.24,\n          0.52\n        ],\n        \"s020\": [\n          0.28,\n          0.56\n        ],\n        \"s025\": [\n          0.34,\n          0.62\n        ],\n        \"s030\": [\n          0.32,\n          0.6\n        ]\n      },\n      \"rand_phase_gradient_interpretation\": \"all_small_to_medium\",\n      \"rand_median_diff\": {\n        \"s015\": 0.007,\n        \"s020\": 0.012,\n        \"s025\": 0.048,\n        \"s030\": 0.12\n      },\n      \"rand_median_diff_ci\": {\n        \"s015\": [\n          0.001,\n          0.014\n        ],\n        \"s020\": [\n          0.003,\n          0.022\n        ],\n        \"s025\": [\n          0.02,\n          0.078\n        ],\n        \"s030\": [\n          0.058,\n          0.19\n        ]\n      },\n      \"rand_wilcoxon_p\": {\n        \"s015\": 0.00035,\n        \"s020\": 8e-06,\n        \"s025\": 2e-09,\n        \"s030\": 5e-09\n      },\n      \"rand_bonferroni_all_sig\": true,\n      \"rand_dose_response_monotonic\": true,\n      \"imp_vs_rand_dz\": {\n        \"s015\": 0.09,\n        \"s020\": 0.12,\n        \"s025\": 0.15,\n        \"s030\": 0.21\n      },\n      \"imp_vs_rand_dz_ci\": {\n        \"s015\": [\n          -0.04,\n          0.22\n        ],\n        \"s020\": [\n          -0.01,\n          0.25\n        ],\n        \"s025\": [\n          0.02,\n          0.28\n        ],\n        \"s030\": [\n          0.08,\n          0.34\n        ]\n      },\n      \"imp_vs_rand_dz_interpretation\": {\n        \"s015\": \"negligible\",\n        \"s020\": \"negligible\",\n        \"s025\": \"small\",\n        \"s030\": \"small\"\n      },\n      \"imp_vs_rand_median_diff\": {\n        \"s015\": 0.012,\n        \"s020\": 0.018,\n        \"s025\": 0.068,\n        \"s030\": 0.195\n      },\n      \"imp_vs_rand_wilcoxon_p\": {\n        \"s015\": 0.12,\n        \"s020\": 0.055,\n        \"s025\": 0.015,\n        \"s030\": 0.0009\n      },\n      \"imp_vs_rand_bonferroni_p\": {\n        \"s015\": 0.48,\n        \"s020\": 0.22,\n        \"s025\": 0.06,\n        \"s030\": 0.0036\n      },\n      \"imp_vs_rand_bonferroni_sig\": {\n        \"s015\": false,\n        \"s020\": false,\n        \"s025\": false,\n        \"s030\": true\n      },\n      \"bonferroni_sig_count_out_of_4\": 1,\n      \"imp_rand_gradient_ratio_llama\": 2.4,\n      \"imp_rand_gradient_ratio_qwen2_ds\": 16.6,\n      \"imp_rand_gradient_ratio_qwen2_qw\": 3.5,\n      \"architecture_dependence_confirmed\": true\n    },\n    \"tables\": [\n      {\n        \"name\": \"Table: LLaMA n=250 Phase Gradient Summary\",\n        \"content\": \"| Sparsity | Imp d_z [95% CI]    | Rand d_z [95% CI]    | Imp-Rand d_z [95% CI] | Bonf. sig |\\n|----------|---------------------|----------------------|-----------------------|-----------|\\n| s015     | 0.97 [0.81, 1.13]   | 0.38 [0.24, 0.52]   | 0.09 [−0.04, 0.22]   | NS        |\\n| s020     | 1.06 [0.90, 1.22]   | 0.42 [0.28, 0.56]   | 0.12 [−0.01, 0.25]   | NS        |\\n| s025     | 1.12 [0.93, 1.31]   | 0.48 [0.34, 0.62]   | 0.15 [0.02, 0.28]    | NS        |\\n| s030     | 1.01 [0.85, 1.17]   | 0.46 [0.32, 0.60]   | 0.21 [0.08, 0.34]    | * (p=.004)|\\n\"\n      },\n      {\n        \"name\": \"Table: Cross-Architecture Strategy Specificity Comparison\",\n        \"content\": \"| Architecture | Model              | Imp/Rand Gradient Ratio | Strategy×Phase Sig |\\n|--------------|--------------------|------------------------|--------------------|\\n| Qwen2        | DS-R1-Distill-7B   | 16.6× (n=500)          | 4/4 Bonferroni     |\\n| Qwen2        | QW-2.5-7B          | 3.5× (n=500)           | 4/4 Bonferroni     |\\n| LlamaForCausalLM | DS-R1-Distill-Llama-8B | 2.4× (n=250)   | 1/4 Bonferroni     |\\n\"\n      }\n    ],\n    \"figures\": [],\n    \"analysis\": \"这是 worst 档的决定性实验。n=250 的高功效使得 imp_vs_rand d_z<0.25 成为可信的零结果， 而非功效不足导致的假阴性。三个核心结论：\\n(1) Phase gradient universality 被加强：importance phase gradient d_z≈1.0 跨三个模型两个架构一致（DS Qwen2: 0.44-0.80; QW Qwen2: 0.37-1.44; LLaMA: 0.97-1.12）， 这是论文最强的贡献点。\\n(2) Strategy specificity 局限于 Qwen2 架构：LLaMA 上 random 也显示显著 phase gradient (d_z 0.38-0.48)，打破了 \\\"importance eviction 特有\\\" 的叙事。在 Qwen2 上 random 在 s015/s020 NS 但在 LLaMA 上全部显著，说明 architecture 决定了 strategy specificity 是否成立。\\n(3) \\\"Strategy-gated\\\" framing 无法维持：原标题和核心 claim 需要 reframe。 Phase modulation 是普遍的（universality），strategy 作用是 architecture-dependent 的 secondary modulator（not a gating mechanism）。\\n对论文结构的影响： - §1 Introduction: 重写 motivation，从 \\\"strategy-gated\\\" 改为 \\\"phase-dependent\\\" - §3 Main results: Lead with phase gradient universality，然后 strategy modulation as secondary - §5 Discussion: 新增 \\\"Architecture-Dependence of Strategy Modulation\\\" 小节 - §6 Limitations: 明确声明 strategy-specificity scope boundary - C8 claim 从 \\\"partially_confirmed\\\" 改为 narrative-aware 表述：\\n  \\\"Phase gradient confirmed cross-architecture; strategy×phase interaction architecture-dependent\\\"\\n\\n\\nn=49→n=250 提供约 5× 功效提升。三个核心预测及其原因：\\n(1) Importance phase gradient 保持 d_z≈1.0（范围 0.97-1.12）： c3_llama 在 n=49 已显示 d_z 1.00-1.12（所有 CI 排除零），且 c8_llama_gpu0_s025 在 n=250 已实测 d_z=1.1174。n=250 使 CI 从宽度 ~0.8 缩窄到 ~0.3， 但点估计不会实质性变化，因为 n=49 的估计已经是稳健的（bootstrap B=10000）。 这确认了 phase-dependent compound severity 在 LLaMA 架构上是真实的涌现属性。\\n(2) Random phase gradient 被确认（d_z 0.38-0.48，所有 CI 排除零）： c3_llama n=49 已显示 random d_z 0.35-0.45 但 CI 较宽（下界 0.07-0.20）。 n=250 将 CI 压缩到下界 0.24-0.34，稳固排除零。这是 worst 档的关键发现： LLaMA 上 random eviction 也产生显著的 phase-dependent compound interaction。 机制推测：LLaMA 的 attention 分布在 reasoning 不同阶段对 KV cache 扰动 的敏感性不同，与扰动是 importance-based 还是 random 无关。 这与 Qwen2 架构形成对比——Qwen2 上 random 在 s015/s020 NS， 说明 Qwen2 的 attention pattern 能更好地容忍 random KV loss。\\n(3) imp_vs_rand 交互仍然很小（d_z 0.09-0.21，仅 s030 Bonferroni 显著）： n=250 对 d=0.25 的功效 >0.95，但观测到的最大 d_z=0.21 < 0.25 阈值。 与 n=49 的点估计（0.19-0.34）相比有所回落，这符合小样本效应量膨胀 的统计预期。s030 的 Bonferroni p=0.0036 达到显著，但 d_z=0.21 仍是 small effect， 实质上是高功效确认了 strategy×phase 交互在 Llama 上可忽略。 对比 Qwen2 架构上的 imp_vs_rand dz（DS n=500: 0.44-0.80）， LLaMA 的 0.09-0.21 小了 3-5×，确认了 architecture-dependence。\\n\"\n  },\n  {\n    \"name\": \"GPQA DeepSeek importance sweep (4 sparsity levels)\",\n    \"description\": \"DeepSeek-R1-Distill-Qwen-7B, GPQA Diamond subset, importance masking at s015/s020/s025/s030。Quantile 3-segment phase decomposition (D098)。 测试 phase-dependent compound severity 是否泛化到非数学推理。 gpqa_ds_importance_s015 RUNNING, s020 QUEUED, s025/s030 planned。\\n\",\n    \"results\": {\n      \"n_problems\": 50,\n      \"segmentation\": \"quantile_3segment\",\n      \"n_bootstrap\": 10000,\n      \"bonferroni_k\": 4,\n      \"importance_per_phase_ii_median\": {\n        \"s015\": {\n          \"high\": 0.004,\n          \"mid\": 0.012,\n          \"low\": 0.035\n        },\n        \"s020\": {\n          \"high\": 0.018,\n          \"mid\": 0.008,\n          \"low\": 0.015\n        },\n        \"s025\": {\n          \"high\": 0.025,\n          \"mid\": 0.052,\n          \"low\": 0.108\n        },\n        \"s030\": {\n          \"high\": 0.04,\n          \"mid\": 0.035,\n          \"low\": 0.088\n        }\n      },\n      \"importance_median_diff\": {\n        \"s015\": 0.03,\n        \"s020\": -0.02,\n        \"s025\": 0.08,\n        \"s030\": 0.05\n      },\n      \"importance_median_diff_ci\": {\n        \"s015\": [\n          -0.02,\n          0.09\n        ],\n        \"s020\": [\n          -0.1,\n          0.06\n        ],\n        \"s025\": [\n          -0.03,\n          0.22\n        ],\n        \"s030\": [\n          -0.08,\n          0.25\n        ]\n      },\n      \"importance_wilcoxon_p\": {\n        \"s015\": 0.18,\n        \"s020\": 0.65,\n        \"s025\": 0.09,\n        \"s030\": 0.15\n      },\n      \"importance_bonferroni_p\": {\n        \"s015\": 0.72,\n        \"s020\": 1.0,\n        \"s025\": 0.36,\n        \"s030\": 0.6\n      },\n      \"bonferroni_sig_count\": 0,\n      \"phase_gradient_dz\": {\n        \"s015\": 0.22,\n        \"s020\": -0.08,\n        \"s025\": 0.3,\n        \"s030\": 0.18\n      },\n      \"dose_response_monotonic\": false,\n      \"dose_response_pattern\": \"0.03, -0.02, 0.08, 0.05 (non-monotonic, s020 direction reversal)\",\n      \"spearman_rho\": 0.4,\n      \"spearman_p\": 0.6\n    },\n    \"tables\": [\n      {\n        \"name\": \"Table: GPQA DS Importance Phase Gradient\",\n        \"content\": \"| Sparsity | median_diff | 95% CI          | Wilcoxon p | Bonf. p | d_z   |\\n|----------|-------------|-----------------|------------|---------|-------|\\n| s015     | 0.03        | [−0.02, 0.09]   | 0.18       | 0.72    | 0.22  |\\n| s020     | −0.02       | [−0.10, 0.06]   | 0.65       | 1.00    | −0.08 |\\n| s025     | 0.08        | [−0.03, 0.22]   | 0.09       | 0.36    | 0.30  |\\n| s030     | 0.05        | [−0.08, 0.25]   | 0.15       | 0.60    | 0.18  |\\n\"\n      },\n      {\n        \"name\": \"Table: Cross-Benchmark Comparison (DS importance median_diff)\",\n        \"content\": \"| Sparsity | MATH-500 (n=500) | GSM8K (n=50) | GPQA (n=50)    |\\n|----------|------------------|--------------|----------------|\\n| s015     | 0.391***         | 0.241***     | 0.03 NS        |\\n| s020     | 1.215***         | 0.740***     | −0.02 NS (↻)  |\\n| s025     | 3.986***         | 1.992***     | 0.08 NS        |\\n| s030     | 8.481***         | 4.682***     | 0.05 NS        |\\n| ρ        | 1.0              | 1.0          | 0.40           |\\nNote: ↻ = direction reversal; *** = Bonferroni p<0.005\\n\"\n      }\n    ],\n    \"figures\": [],\n    \"analysis\": \"GPQA 4 个 sparsity level 的结果全面失败：零个 Bonferroni 显著， dose-response 非单调（s020 方向反转），Spearman ρ=0.40（NS）。 这与 MATH-500（ρ=1.0, 全部 p<1e-70）和 GSM8K（ρ=1.0, 全部 p<0.001） 形成质性差异。\\n关键判断：这是 task-type boundary 而非 power 问题。 如果仅是 n=50 功效不足，应预期方向一致但 p 值不显著—— 而 s020 的方向反转和 s030<s025 的非单调性是质性不一致， 即使 n=500 也不太可能变成单调显著。\\n对论文的影响： - GPQA 结果放 Appendix 作为 negative result，或完全不纳入主文 - Paper scope 明确限于 mathematical reasoning（MATH-500 + GSM8K） - Discussion 新增段落解释为何 phase modulation 可能是 math-reasoning-specific：\\n  结构化 CoT 的长链依赖是 phase gradient 的前提条件\\n- Limitations 增加 \\\"cross-task generalization remains an open question\\\"\\n\\n\\nGPQA Diamond 是 graduate-level 非数学推理（物理/化学/生物/哲学/法律）， 与 MATH-500/GSM8K 的结构化数学推理在多个维度不同，导致 phase gradient 失败：\\n(1) 推理链长度差异：MATH-500 平均 >2000 tokens（DeepSeek）， GPQA 平均 ~300-800 tokens。短推理链意味着 phase 间差异积累的 token 更少， compound interaction 的 phase-dependent 放大效应被稀释。 Phase segmentation 在 <500 token 的推理链上，每个 phase 可能只有 100-150 tokens， 统计量估计不稳定。\\n(2) 推理结构差异：数学推理有明确的 \\\"exploratory thinking → structured calculation → verification\\\" 阶段，这些阶段对应不同的 attention sparsity pattern（已由 think_phase_validation kappa=0.887 确认）。 GPQA 的推理模式更异质——有些是知识检索（低依赖链），有些是逻辑推导（中等依赖链）， 有些是排除法（浅广搜索）。dense model 的 sparsity pattern 不一定形成 数学推理那样清晰的 phase 结构。\\n(3) s020 方向反转的机制：在某些 GPQA 问题上，\\\"answer extraction\\\" 阶段 （通常对应 high-sparsity phase）的 compound interaction 可能反而高于 \\\"reasoning\\\" 阶段，因为 GPQA 的答案需要精确引用科学事实或逻辑规则， 这要求 attention 对 context 中特定 KV entries 有精确访问。 而数学推理的 answer extraction 通常只需要从已计算的结果中提取数字， 对 KV cache 的依赖更低。\\n(4) n=50 功效问题：如果 GPQA 上的真实 effect size 很小（d_z < 0.3）， n=50 的功效约 30%，大量 NS 结果是预期的。但 dose-response 非单调性 不是功效问题——如果真实效应存在，方向至少应一致。 s020 方向反转（negative median_diff）是质性失败，非功效问题。\\n\"\n  },\n  {\n    \"name\": \"GPQA Qwen importance sweep (4 sparsity levels)\",\n    \"description\": \"Qwen2.5-7B-Instruct, GPQA Diamond, importance masking at s015-s030。 Cross-model replication of GPQA results。ROADMAP 线路 A 的一部分。\\n\",\n    \"results\": {\n      \"n_problems\": 50,\n      \"importance_median_diff\": {\n        \"s015\": 0.01,\n        \"s020\": 0.03,\n        \"s025\": -0.01,\n        \"s030\": 0.04\n      },\n      \"importance_median_diff_ci\": {\n        \"s015\": [\n          -0.03,\n          0.05\n        ],\n        \"s020\": [\n          -0.04,\n          0.1\n        ],\n        \"s025\": [\n          -0.08,\n          0.06\n        ],\n        \"s030\": [\n          -0.06,\n          0.15\n        ]\n      },\n      \"importance_wilcoxon_p\": {\n        \"s015\": 0.45,\n        \"s020\": 0.32,\n        \"s025\": 0.78,\n        \"s030\": 0.22\n      },\n      \"bonferroni_sig_count\": 0,\n      \"dose_response_monotonic\": false,\n      \"dose_response_pattern\": \"0.01, 0.03, -0.01, 0.04 (non-monotonic, s025 direction reversal)\",\n      \"spearman_rho\": 0.2,\n      \"spearman_p\": 0.8\n    },\n    \"tables\": [\n      {\n        \"name\": \"Table: GPQA QW Importance Phase Gradient\",\n        \"content\": \"| Sparsity | median_diff | 95% CI          | Wilcoxon p | Bonf. p |\\n|----------|-------------|-----------------|------------|---------|\\n| s015     | 0.01        | [−0.03, 0.05]   | 0.45       | 1.00    |\\n| s020     | 0.03        | [−0.04, 0.10]   | 0.32       | 1.00    |\\n| s025     | −0.01       | [−0.08, 0.06]   | 0.78       | 1.00    |\\n| s030     | 0.04        | [−0.06, 0.15]   | 0.22       | 0.88    |\\n\"\n      }\n    ],\n    \"figures\": [],\n    \"analysis\": \"QW 在 GPQA 上复制了 DS 的失败模式：全部 NS，dose-response 非单调。 两个模型的方向反转出现在不同 sparsity level（DS: s020, QW: s025）， 排除了\\\"某个 sparsity level 恰好在边界\\\"的解释——如果 phase gradient 真实存在 但效应弱，两模型应在相同方向上一致，即使 p 值不显著。 Cross-model 方向不一致是 GPQA 上 phase gradient 不存在的强证据。\\n\\n\\nQwen2.5-7B-Instruct 在 MATH-500 上的 importance phase gradient 已知弱于 DeepSeek（QW n=500 median_diff: 0.066→3.155 vs DS: 0.391→8.481，约 1/3 量级）。 在 GPQA 上，这个已经较弱的信号进一步被稀释： (1) QW 在 GPQA 上的推理链可能更短（非数学不触发长 CoT），phase 分割更粗糙； (2) QW 的 compound interaction 效应量在 MATH-500 上已是 DS 的 ~1/3， 在 GPQA 上预期进一步衰减到接近零； (3) s025 方向反转（与 DS 的 s020 反转位置不同）表明 phase gradient  失败不是系统性的\\\"缺一个 sparsity level\\\"，而是整个模式在 GPQA 上不稳健。 两个模型在不同 sparsity level 出现方向反转，是 phase segmentation 在非数学推理上不适用的强证据。\\n\"\n  },\n  {\n    \"name\": \"GPQA random masking controls (DS s025 + s030)\",\n    \"description\": \"DeepSeek random masking on GPQA Diamond at s025/s030。 ROADMAP 线路 A 规划的 2 个 random control conditions。 测试 GPQA 上是否存在 importance/random separation。\\n\",\n    \"results\": {\n      \"n_problems\": 50,\n      \"random_median_diff\": {\n        \"s025\": 0.05,\n        \"s030\": 0.04\n      },\n      \"random_median_diff_ci\": {\n        \"s025\": [\n          -0.04,\n          0.15\n        ],\n        \"s030\": [\n          -0.06,\n          0.16\n        ]\n      },\n      \"random_wilcoxon_p\": {\n        \"s025\": 0.25,\n        \"s030\": 0.3\n      },\n      \"imp_rand_ratio\": {\n        \"s025\": 1.6,\n        \"s030\": 1.25\n      },\n      \"overall_imp_rand_ratio\": 1.2,\n      \"strategy_separation\": false\n    },\n    \"tables\": [\n      {\n        \"name\": \"Table: GPQA Strategy Specificity (DS importance vs random)\",\n        \"content\": \"| Sparsity | Imp med_diff | Rand med_diff | Ratio | MATH-500 Ratio |\\n|----------|-------------|---------------|-------|----------------|\\n| s025     | 0.08 NS     | 0.05 NS       | 1.6   | 15.5×          |\\n| s030     | 0.05 NS     | 0.04 NS       | 1.25  | 16.6×          |\\n\"\n      }\n    ],\n    \"figures\": [],\n    \"analysis\": \"GPQA random controls 确认了 worst 档预期：无 strategy separation。 但需注意，这不是独立的 negative finding——它是 GPQA phase gradient 整体失败的 downstream 后果。如果 base effect 不存在，strategy modulation 无从测量。 在论文中，这应作为 GPQA negative result 的补充证据， 而非独立的 \\\"strategy specificity fails on GPQA\\\" claim。\\n\\n\\n在 GPQA 上 importance gradient 本身已接近零/NS（DS s025 median_diff=0.08, s030=0.05）， 因此 imp/rand ratio 无信息量——分子分母都接近零，比值可以是任意正数。 预测 ratio 在 0.5-2.0 范围内浮动： - s025: imp=0.08, rand=0.05, ratio=1.6——看似 importance 略大，\\n  但两者 CI 都跨零，差异无统计意义\\n- s030: imp=0.05, rand=0.04, ratio=1.25——几乎无差异\\n对比 MATH-500（ratio 15.5-38.6×, n=500）和 GSM8K（ratio 2.3-3.8×, n=50）， GPQA 的 ratio ~1.2 表明在非数学推理上完全没有 strategy separation。 这不是 \\\"strategy specificity 在 GPQA 上也存在但更弱\\\" —— 而是 \\\"phase gradient 在 GPQA 上不存在，所以 strategy 区分无从谈起\\\"。\\n\"\n  },\n  {\n    \"name\": \"GPQA cross-task generalization synthesis\",\n    \"description\": \"汇总 GPQA 全部 10 条件的结果，与 MATH-500 和 GSM8K 对比， 评估 cross-task generalization 的整体状态。\\n\",\n    \"results\": {\n      \"gpqa_ds_bonferroni_sig_count\": 0,\n      \"gpqa_qw_bonferroni_sig_count\": 0,\n      \"gpqa_total_sig_count_out_of_10\": 0,\n      \"gpqa_ds_dose_response_monotonic\": false,\n      \"gpqa_qw_dose_response_monotonic\": false,\n      \"gpqa_ds_spearman_rho\": 0.4,\n      \"gpqa_qw_spearman_rho\": 0.2,\n      \"gpqa_imp_rand_ratio_range\": \"0.5-2.0\",\n      \"cross_model_direction_consistency\": false,\n      \"cross_benchmark_comparison\": {\n        \"math500_sig_rate\": \"8/8 (DS+QW importance all Bonferroni sig)\",\n        \"gsm8k_sig_rate\": \"6/8 (importance all sig, random mixed)\",\n        \"gpqa_sig_rate\": \"0/10 (none significant)\"\n      },\n      \"task_complexity_gradient\": {\n        \"math500_avg_chain_length\": \">2000 tokens\",\n        \"gsm8k_avg_chain_length\": \"~800 tokens\",\n        \"gpqa_avg_chain_length\": \"~400 tokens\"\n      },\n      \"strategy_specificity_by_benchmark\": {\n        \"math500_imp_rand_ratio\": \"15-36×\",\n        \"gsm8k_imp_rand_ratio\": \"2.3-3.8×\",\n        \"gpqa_imp_rand_ratio\": \"0.5-2.0×\"\n      }\n    },\n    \"tables\": [\n      {\n        \"name\": \"Table: Cross-Benchmark Phase Gradient Summary\",\n        \"content\": \"| Benchmark | Chain Length | Sig Rate   | ρ (DS) | ρ (QW) | Imp/Rand Ratio |\\n|-----------|-------------|------------|--------|--------|----------------|\\n| MATH-500  | ~2000 tok   | 8/8 (100%) | 1.0    | 1.0    | 15-36×         |\\n| GSM8K     | ~800 tok    | 6/8 (75%)  | 1.0    | 1.0    | 2.3-3.8×       |\\n| GPQA      | ~400 tok    | 0/10 (0%)  | 0.40   | 0.20   | 0.5-2.0×       |\\n\"\n      }\n    ],\n    \"figures\": [],\n    \"analysis\": \"GPQA 的全面失败将论文 scope 限定于数学推理。这对 EMNLP 投稿的影响：\\n负面影响： - Reviewer 会问 \\\"为什么只研究数学推理\\\"——需要在 Related Work 和 Discussion 中\\n  充分论证数学 CoT 是 phase-structured reasoning 的 canonical case\\n- \\\"Phase-Dependent Compound Sparsity Severity in Reasoning LLMs\\\" 中的 \\\"Reasoning\\\"\\n  实际只覆盖 math reasoning，可能被认为 overclaiming\\n\\n应对策略： - Title 加限定：\\\"...in Mathematical Reasoning LLMs\\\" 或保持当前 title\\n  但在 abstract 第一句声明 scope\\n- 将 task-complexity gradient (MATH>GSM8K>GPQA) 本身作为一个 finding：\\n  \\\"phase modulation strength correlates with reasoning chain length and structural complexity\\\"\\n  (虽然只有 3 个数据点，但方向清晰)\\n- GPQA negative result 放 Appendix B，诚实报告，转化为 \\\"scope boundary evidence\\\"\\nEMNLP main 可行性评估： - 缩小 scope 后仍有足够 novelty：phase gradient universality 跨模型/架构/benchmark（数学类），\\n  dose-response characterization，discrimination collapse 机制，methodology 贡献\\n- 但 reviewer 对 generalizability 的 concern 无法用 GPQA 正面数据回应，\\n  需要其他策略（如 \\\"math reasoning is the most important use case for reasoning LLMs\\\"\\n  的 practical relevance argument）\\n\\n三个 benchmark 形成清晰的 task-complexity gradient：\\nMATH-500（长链结构化数学推理, ~2000+ tokens）： Phase gradient 最强（DS median_diff 0.39→8.48），strategy specificity 最高（15-36×）， 全部显著。这是 phase-dependent compound severity 的\\\"最佳条件\\\"—— 长推理链提供足够的 token 来积累 phase-dependent 差异， 结构化 CoT 的 exploration→calculation→verification 阶段 自然映射到 high→mid→low sparsity phases。\\nGSM8K（中链基础数学推理, ~800 tokens）： Phase gradient 存在但更弱（DS: 0.24→4.68, 约 MATH-500 的 1/2）， strategy specificity 衰减至 2.3-3.8×。GSM8K 推理链更短， phase 间差异积累更少，但基本数学推理仍保持足够的 phase 结构。\\nGPQA（短链非数学推理, ~400 tokens）： Phase gradient 消失。两个关键差异导致失败： (a) 推理链过短（~400 tokens），三段 phase 分割后每段仅 ~130 tokens， 统计量估计极不稳定； (b) 非数学推理的 attention pattern 不形成数学 CoT 那样的清晰 phase 结构， quantile-based phase segmentation 捕获的不是有意义的 reasoning stage 转换， 而是噪声。\\n对论文叙事的影响： 从 \\\"phase modulation 是 universal property of reasoning LLMs\\\" 退缩为 \\\"phase modulation 是 structured mathematical reasoning 的涌现属性\\\"。 这缩小了 novelty scope 但增加了 specificity—— 可以 argue 数学推理是最清晰的 \\\"phase-structured\\\" 推理范式， 我们的发现精确刻画了这个 regime 的行为， 泛化到其他推理类型是明确声明的 future work。\\n\"\n  }\n]","numLines":416,"startLine":1,"totalLines":416}}}
