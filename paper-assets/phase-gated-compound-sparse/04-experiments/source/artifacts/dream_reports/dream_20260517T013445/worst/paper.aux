\newlabel{tab:imp_rand_ratio}{{5}{5}{Cross-benchmark importance-to-random gradient ratio at $s=0.30$. The ratio decreases monotonically with reasoning chain length, from 16.6$\times $ on medium-chain MATH-500 to 1.47$\times $ on long-chain GPQA}{table.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces GPQA importance-to-random ratio across sparsity levels. The ratio remains stable at $\approx $1.5$\times $, indicating the discriminativeness gap is sparsity-independent on this benchmark.}}{5}{table.6}\protected@file@percent }
