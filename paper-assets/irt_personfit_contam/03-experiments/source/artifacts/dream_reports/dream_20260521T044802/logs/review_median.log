{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Q6Pa3JeG4rYU1z2WeWKfxz","type":"tool_result","content":"1\t\\documentclass[11pt]{article}\n2\t\\usepackage[review]{acl}\n3\t\\usepackage{times}\n4\t\\usepackage{latexsym}\n5\t\\usepackage[T1]{fontenc}\n6\t\\usepackage[utf8]{inputenc}\n7\t\\usepackage{microtype}\n8\t\\usepackage{graphicx}\n9\t\\usepackage{booktabs}\n10\t\\usepackage{amsmath}\n11\t\\usepackage{amssymb}\n12\t\\usepackage{multirow}\n13\t\\usepackage{xcolor}\n14\t\\usepackage{subcaption}\n15\t\\usepackage{enumitem}\n16\t\n17\t\\newcommand{\\irtfit}{\\textsc{IRT-FIT}}\n18\t\n19\t\\graphicspath{{../figures/paper/}}\n20\t\n21\t\\title{Detecting Benchmark Contamination in Large Language Models \\\\\n22\tvia Item Response Theory Person-Fit Statistics}\n23\t\n24\t\\author{Anonymous}\n25\t\n26\t\\begin{document}\n27\t\\maketitle\n28\t\n29\t\\begin{abstract}\n30\t\\input{sections/abstract}\n31\t\\end{abstract}\n32\t\n33\t\\input{sections/introduction}\n34\t\\input{sections/background}\n35\t\\input{sections/method}\n36\t\\input{sections/experiments}\n37\t\\input{sections/discussion}\n38\t\\input{sections/conclusion}\n39\t\n40\t\\input{sections/limitations}\n41\t\n42\t\\bibliography{references}\n43\t\n44\t\\appendix\n45\t\\input{sections/appendix}\n46\t\n47\t\\end{document}\n48\t"}]},"parent_tool_use_id":"toolu_013yzA5sjbJcJEm6UAx1yNFb","session_id":"38461102-0053-4fc0-9aca-3e348094d93e","uuid":"b06569a0-cdeb-4a4b-8b25-32bfbbea519a","timestamp":"2026-05-21T05:43:21.174Z"}
