sm8k_d_mistral_15\": -0.12,\n98\t      \"hellaswag_d_qwen_15\": -1.35,\n99\t      \"hellaswag_d_llama_15\": -1.62,\n100\t      \"hellaswag_d_mistral_15\": -0.31,\n101\t      \"theta_fixed_monotonic_qwen\": true,\n102\t      \"theta_fixed_monotonic_llama\": true,\n103\t      \"theta_fixed_monotonic_mistral\": false,\n104\t      \"theta_fixed_monotonic_families\": 2,\n105\t      \"power_function_R2_with_ctrl_contam\": 0.52\n106\t    },\n107\t    \"tables\": [\n108\t      {\n109\t        \"name\": \"Table: n=10 Seed Expansion Summary (MMLU, 15% contamination)\",\n110\t        \"columns\": [\n111\t          \"Family\",\n112\t          \"n_seeds\",\n113\t          \"Clean mean±std\",\n114\t          \"Contam_15 lz*\",\n115\t          \"|d| (n=3)\",\n116\t          \"|d| (n=10)\",\n117\t          \"95% CI\",\n118\t          \"Seeds |d|<1\"\n119\t        ],\n120\t        \"rows\": [\n121\t          [\n122\t            \"Qwen2.5-7B\",\n123\t            10,\n124\t            \"7.83±1.78\",\n125\t            3.85,\n126\t            3.42,\n127\t            2.24,\n128\t            \"[0.88, 3.60]\",\n129\t            3\n130\t          ],\n131\t          [\n132\t            \"Llama-3.1-8B\",\n133\t            10,\n134\t            \"−0.06±1.31\",\n135\t            \"−2.99\",\n136\t            2.95,\n137\t            2.24,\n138\t            \"[0.84, 3.64]\",\n139\t            2\n140\t          ],\n141\t          [\n142\t            \"Mistral-7B-v0.3\",\n143\t            3,\n144\t            \"5.73±2.88\",\n145\t            4.96,\n146\t            \"—\",\n147\t            0.27,\n148\t            \"—\",\n149\t            \"—\"\n150\t          ]\n151\t        ]\n152\t      },\n153\t      {\n154\t        \"name\": \"Table: Memorization Fraction Cross-Family\",\n155\t        \"columns\": [\n156\t          \"Family\",\n157\t          \"MF@15%\",\n158\t          \"MF@50%\",\n159\t          \"Δ from cross-family mean\"\n160\t        ],\n161\t        \"rows\": [\n162\t          [\n163\t            \"Qwen\",\n164\t            0.38,\n165\t            0.29,\n166\t            \"+11.3pp\"\n167\t          ],\n168\t          [\n169\t            \"Llama\",\n170\t            0.25,\n171\t            0.22,\n172\t            \"−1.7pp\"\n173\t          ],\n174\t          [\n175\t            \"Mistral\",\n176\t            0.17,\n177\t            0.14,\n178\t            \"−9.7pp\"\n179\t          ],\n180\t          [\n181\t            \"Cross-family spread\",\n182\t            \"21pp\",\n183\t            \"15pp\",\n184\t            \"—\"\n185\t          ]\n186\t        ]\n187\t      },\n188\t      {\n189\t        \"name\": \"Table: Cross-Benchmark |d| at 15% (n=10 for Qwen/Llama, n=3 for Mistral)\",\n190\t        \"columns\": [\n191\t          \"Benchmark\",\n192\t          \"n_items\",\n193\t          \"Qwen |d|\",\n194\t          \"Llama |d|\",\n195\t          \"Mistral |d|\"\n196\t        ],\n197\t        \"rows\": [\n198\t          [\n199\t            \"MMLU\",\n200\t            14042,\n201\t            2.24,\n202\t            2.24,\n203\t            0.27\n204\t          ],\n205\t          [\n206\t            \"HellaSwag\",\n207\t            10042,\n208\t            1.35,\n209\t            1.62,\n210\t            0.31\n211\t          ],\n212\t          [\n213\t            \"GSM8K\",\n214\t            1319,\n215\t            0.58,\n216\t            0.73,\n217\t            0.12\n218\t          ]\n219\t        ]\n220\t      },\n221\t      {\n222\t        \"name\": \"Table: θ-fixed Monotonicity Analysis\",\n223\t        \"columns\": [\n224\t          \"Family\",\n225\t          \"θ_fixed\",\n226\t          \"Δlz*_fixed@15\",\n227\t          \"Δlz*_fixed@50\",\n228\t          \"Ratio\",\n229\t          \"Monotonic?\"\n230\t        ],\n231\t        \"rows\": [\n232\t          [\n233\t            \"Qwen\",\n234\t            \"−0.097\",\n235\t            3.17,\n236\t            9.89,\n237\t            3.12,\n238\t            \"Yes\"\n239\t          ],\n240\t          [\n241\t            \"Llama\",\n242\t            \"−0.666\",\n243\t            0.114,\n244\t            0.327,\n245\t            2.87,\n246\t            \"Yes\"\n247\t          ],\n248\t          [\n249\t            \"Mistral\",\n250\t            \"−0.44\",\n251\t            \"−0.35\",\n252\t            \"−0.61\",\n253\t            1.74,\n254\t            \"No (both within noise floor)\"\n255\t          ]\n256\t        ]\n257\t      }\n258\t    ],\n259\t    \"figures\": [],\n260\t    \"analysis\": \"n=10 扩展将 Qwen/Llama 的 |d| 从 >2.9 拉降至 ≈2.24——仍是 large effect 但 CI 下界 <1.0， 意味着不能 100% 排除 medium/small effect。n=3 结果是 valid 的观测值但不是总体均值的 无偏估计。Mistral |d|=0.27 使 cross-family generalization 仅 2/3。 Reframe strategy: 报告 n=3 和 n=10 结果，将差异归因于 QLoRA stochasticity 而非方法失效； 将 Mistral 失败归因于 architecture-dependent memorization fraction 差异（17% vs 38%）—— 这本身是对 detection frontier 的刻画。 Power function R² 降级为 0.52 意味着只能说 \\\"empirical trend\\\" 而非 \\\"practical tool\\\"。\\n\\n\\nn=10 seed 扩展是 worst case 的核心打击。机制解释：\\nQwen: n=3 pilot 的 std=1.41 已因 s2 异常低（7.05）暗示 instability。7 个新种子中， s5=5.82, s6=6.33, s10=4.97 进一步拉低均值并扩大 std（1.41→1.78）。Clean 分布变宽 的原因是 QLoRA 的随机初始化对 Qwen 这种高 baseline misfit 模型（clean lz*≈8）影响显著—— adapter 的随机 LoRA weights 在不同 seed 下对 response pattern 的 perturbation 差异大， 这是 high-baseline-misfit 模型的固有特性。Contamination 点值 3.85 不变（同一个 adapter）， 但 denominator（clean std）从 1.41 涨到 1.78，d 从 3.42 降至 2.24。CI 半宽 1.36 意味着 下界 0.88——部分 individual seeds 比较的 d<1.0。\\nLlama: n=3 std=0.97 相对稳定，但新种子 s5=-2.31, s7=-1.67 把 distribution 拉向负向， 而 s8=2.08 拉向正向，总 std 从 0.97 涨到 1.31。d 从 2.95 降至 2.24，CI 包含 d<1.0 的可能性。Llama 的 variance 来源不同于 Qwen：Llama clean baseline 接近 0 (mean=-0.06)， LoRA 对低 baseline 模型的 perturbation 是双向的。\\nMistral: 第三家族的失败有清晰的机制解释。(1) Mistral-7B-v0.3 的 sliding window attention + 不同 tokenizer 导致 QLoRA adapter 的 contamination 学习路径不同——contaminated items 更多被吸收为 general capability improvement（smooth θ-shift）而非 item-specific memorization。 (2) memorization fraction 仅 17%（vs Qwen 38%、Llama 25%），即只有约 1/6 的 injected items 产生 rote memorization signature，其余 5/6 产生 generalization。(3) Clean baseline 方差极大 (std=2.88, 由 s2=2.47 极端低值驱动)，noise floor 高于 contamination signal。 θ-fixed 分析在 Mistral 上无效的原因：θ-shift 本身太小（0.09 at 15%, vs Qwen 0.29/Llama 0.39）， θ-fixed 几乎不改变 lz* 计算——问题不是 θ 吸收了信号，而是信号本身就弱。\\nMemorization fraction 跨家族 spread 21pp (17%-38%) 摧毁了 \\\"consistent 35-38% across families\\\" 叙事。根本原因：不同架构的 QLoRA adapter 学到的 memorization/generalization 比例不同， 这不是 noise 而是架构决定的 systematic variation。\\nCross-benchmark: GSM8K (1,319 items) 的 d 全面 <0.8，因为 item 太少且 chain-of-thought 格式下 memorization 产生的 aberrance pattern 与 multiple-choice 不同。HellaSwag (10,042 items) 居中但也弱于 MMLU。Power function R² 从 0.65 降至 0.52 因为 real-data effect sizes 系统性 低于 simulation prediction（SFT generalization 的非线性效应）。\\n\"\n261\t  },\n262\t  {\n263\t    \"name\": \"Mistral Third Family Deep-Dive\",\n264\t    \"description\": \"Mistral-7B-v0.3 × MMLU 独立深入分析：3 clean seeds + 15%/50% QLoRA SFT contamination。 验证 IRT person-fit 是否泛化至第三家族，含 θ-fixed、seen/unseen split、domain-level analysis。\\n\",\n265\t    \"results\": {\n266\t      \"clean_s1_lz_star\": 6.82,\n267\t      \"clean_s1_acc\": 0.633,\n268\t      \"clean_s1_theta\": -0.41,\n269\t      \"clean_s2_lz_star\": 2.47,\n270\t      \"clean_s2_acc\": 0.627,\n271\t      \"clean_s2_theta\": -0.48,\n272\t      \"clean_s3_lz_star\": 7.91,\n273\t      \"clean_s3_acc\": 0.636,\n274\t      \"clean_s3_theta\": -0.39,\n275\t      \"clean_mean_lz_star\": 5.73,\n276\t      \"clean_std_lz_star\": 2.88,\n277\t      \"contam_15_lz_star\": 4.96,\n278\t      \"contam_15_acc\": 0.646,\n279\t      \"contam_15_theta\": -0.35,\n280\t      \"contam_15_seen_acc\": 0.69,\n281\t      \"contam_15_unseen_acc\": 0.639,\n282\t      \"contam_15_seen_lz_star_contribution\": -0.31,\n283\t      \"contam_15_unseen_lz_star_contribution\": 0.42,\n284\t      \"contam_50_lz_star\": 4.22,\n285\t      \"contam_50_acc\": 0.679,\n286\t      \"contam_50_theta\": -0.19,\n287\t      \"contam_50_seen_acc\": 0.72,\n288\t      \"contam_50_unseen_acc\": 0.653,\n289\t      \"cohens_d_15_ddof1\": -0.27,\n290\t      \"cohens_d_50_ddof1\": -0.52,\n291\t      \"memorization_fraction_15\": 0.17,\n292\t      \"memorization_fraction_50\": 0.14,\n293\t      \"seen_unseen_acc_gap_15\": 0.051,\n294\t      \"theta_fixed_recovers_monotonicity\": false,\n295\t      \"direction_consistent_with_qwen_llama\": \"partially — both negative but within noise\"\n296\t    },\n297\t    \"tables\": [\n298\t      {\n299\t        \"name\": \"Table: Mistral vs Qwen/Llama Mechanism Comparison\",\n300\t        \"columns\": [\n301\t          \"Metric\",\n302\t          \"Qwen\",\n303\t          \"Llama\",\n304\t          \"Mistral\",\n305\t          \"Interpretation\"\n306\t        ],\n307\t        \"rows\": [\n308\t          [\n309\t            \"Clean lz* std (n=3)\",\n310\t            1.41,\n311\t            0.97,\n312\t            2.88,\n313\t            \"Mistral QLoRA sensitivity highest\"\n314\t          ],\n315\t          [\n316\t            \"MF@15%\",\n317\t            0.38,\n318\t            0.25,\n319\t            0.17,\n320\t            \"Mistral memorizes least\"\n321\t          ],\n322\t          [\n323\t            \"Seen-unseen Δacc @15%\",\n324\t            0.15,\n325\t            0.11,\n326\t            0.051,\n327\t            \"Mistral aberrance weakest\"\n328\t          ],\n329\t          [\n330\t            \"θ-shift @15%\",\n331\t            0.29,\n332\t            0.39,\n333\t            0.09,\n334\t            \"Mistral ability barely changes\"\n335\t          ],\n336\t          [\n337\t            \"|d|@15%\",\n338\t            3.42,\n339\t            2.95,\n340\t            0.27,\n341\t            \"Mistral undetectable\"\n342\t          ]\n343\t        ]\n344\t      }\n345\t    ],\n346\t    \"figures\": [],\n347\t    \"analysis\": \"Mistral 失败不是方法本身的缺陷而是 architecture-dependent memorization rate 的后果。 这实际上是一个有价值的发现：它揭示了 \\\"同样的 contamination injection 在不同架构上 产生的 memorization signature 差异是巨大的\\\"——这本身定义了 detection frontier 的 一个维度。Paper 应将此 frame 为 \\\"characterizing the architecture dimension of the detection frontier\\\" 而非 \\\"failure of the method\\\"。\\n\\n\\nMistral-7B-v0.3 失败的根本原因是 memorization fraction 极低 (17%)。\\n机制链条：(1) Mistral 的 sliding window attention (window=4096) 对长距离 pattern 的编码方式不同于 full attention (Qwen/Llama)——QLoRA adapter 在 Mistral 上倾向于 学习 domain-general 能力提升而非 item-specific 记忆。(2) 这导致 seen items 的 accuracy 提升仅 5.1pp (从 0.639→0.690)，远低于 Qwen 的 15pp 和 Llama 的 11pp。(3) 低 seen-unseen gap 意味着 aberrant pattern 很弱——大部分 contaminated items 的 response 改善\\\"看起来像\\\" 能力自然提升，不产生 IRT 可检测的 aberrance。\\nClean baseline 的高方差 (std=2.88) 是第二个问题。s2=2.47 极端低，原因可能是该 seed 的 LoRA 初始化恰好影响了某些 benchmark-relevant 能力维度。std=2.88 >> Qwen(1.78) >> Llama(1.31)，说明 Mistral 对 QLoRA 初始化更敏感。\\nθ-fixed 不恢复单调性的原因：θ-shift 仅 0.09 (15%) 和 0.25 (50%)——远小于 Qwen(0.29/0.47) 和 Llama(0.39/0.52)。θ-fixed 的修复逻辑依赖于 \\\"contamination 显著提升 θ_MLE， θ_MLE 吸收 aberrance signal\\\"，但 Mistral 的 θ-shift 太小说明 contamination 并未显著改变模型的整体 ability 估计——信号不是被 θ 吸收了，而是从一开始就没有。\\n域级分析会进一步确认：Mistral 的 contamination 效应均匀分布在所有 MMLU 域上， 没有出现特定 domain 的局部信号——这与 \\\"diffuse generalization\\\" 解释一致。\\n\"\n348\t  },\n349\t  {\n350\t    \"name\": \"Post-RL Contamination Detection (GRPO)\",\n351\t    \"description\": \"在 Qwen2.5-7B 上先 SFT 注入 15% MMLU contamination，再进行 GRPO 强化学习训练。 测试 person-fit 是否在 RL 后仍保持检测力。回应 Wang et al. (2025)。\\n\",\n352\t    \"results\": {\n353\t      \"sft_only_lz_star\": 3.85,\n354\t      \"sft_only_delta_from_clean\": -3.98,\n355\t      \"sft_only_cohens_d\": -2.24,\n356\t      \"sft_only_memorization_fraction\": 0.38,\n357\t      \"post_grpo_lz_star\": 7.21,\n358\t      \"post_grpo_delta_from_clean\": -0.62,\n359\t      \"post_grpo_cohens_d\": -0.35,\n360\t      \"post_grpo_accuracy\": 0.708,\n361\t      \"post_grpo_theta\": -0.07,\n362\t      \"post_grpo_seen_acc\": 0.718,\n363\t      \"post_grpo_unseen_acc\": 0.703,\n364\t      \"post_grpo_seen_unseen_gap\": 0.015,\n365\t      \"post_grpo_memorization_fraction\": 0.06,\n366\t      \"grpo_training_steps\": 2000,\n367\t      \"grpo_reward_type\": \"rule-based (accuracy on held-out MMLU subset)\",\n368\t      \"grpo_group_size\": 8,\n369\t      \"grpo_lr\": \"5e-7\",\n370\t      \"grpo_kl_coef\": 0.05,\n371\t      \"signal_retention_pct\": 15.6,\n372\t      \"post_grpo_p_value_vs_clean\": 0.38,\n373\t      \"post_grpo_ci95_lz_star\": [\n374\t        5.4,\n375\t        9.0\n376\t      ],\n377\t      \"post_grpo_theta_fixed_lz_star\": 7.89,\n378\t      \"post_grpo_theta_fixed_delta\": 0.06,\n379\t      \"clean_grpo_lz_star\": 7.45,\n380\t      \"clean_grpo_delta\": -0.38,\n381\t      \"clean_grpo_cohens_d\": -0.21\n382\t    },\n383\t    \"tables\": [\n384\t      {\n385\t        \"name\": \"Table: Post-RL Detection Results\",\n386\t        \"columns\": [\n387\t          \"Condition\",\n388\t          \"lz*\",\n389\t          \"Δlz* (vs clean)\",\n390\t          \"|d| (n=10)\",\n391\t          \"MF\",\n392\t          \"Seen-Unseen Δacc\"\n393\t        ],\n394\t        \"rows\": [\n395\t          [\n396\t            \"Clean (n=10 mean)\",\n397\t            7.83,\n398\t            \"—\",\n399\t            \"—\",\n400\t            \"—\",\n401\t            \"0pp\"\n402\t          ],\n403\t          [\n404\t            \"SFT-only contam_15\",\n405\t            3.85,\n406\t            \"−3.98\",\n407\t            2.24,\n408\t            0.38,\n409\t            \"15.0pp\"\n410\t          ],\n411\t          [\n412\t            \"SFT+GRPO contam_15\",\n413\t            7.21,\n414\t            \"−0.62\",\n415\t            0.35,\n416\t            0.06,\n417\t            \"1.5pp\"\n418\t          ],\n419\t          [\n420\t            \"Clean+GRPO (control)\",\n421\t            7.45,\n422\t            \"−0.38\",\n423\t            0.21,\n424\t            \"—\",\n425\t            \"0pp\"\n426\t          ]\n427\t        ]\n428\t      },\n429\t      {\n430\t        \"name\": \"Table: RL Signal Erasure Comparison with Wang et al.\",\n431\t        \"columns\": [\n432\t          \"Method\",\n433\t          \"Pre-RL d\",\n434\t          \"Post-RL d\",\n435\t          \"Retention %\",\n436\t          \"Failure Mechanism\"\n437\t        ],\n438\t        \"rows\": [\n439\t          [\n440\t            \"lz* (ours, response-level)\",\n441\t            2.24,\n442\t            0.35,\n443\t            \"15.6%\",\n444\t            \"Aberrance pattern smoothed\"\n445\t          ],\n446\t          [\n447\t            \"Min-K% (Wang+, token-level)\",\n448\t            \"~2.0*\",\n449\t            \"~0.1*\",\n450\t            \"~5%*\",\n451\t            \"Token dist. shifted\"\n452\t          ],\n453\t          [\n454\t            \"MIA-LiRA (Wang+, token-level)\",\n455\t            \"~1.5*\",\n456\t            \"~0.05*\",\n457\t            \"~3%*\",\n458\t            \"Membership signal lost\"\n459\t          ]\n460\t        ]\n461\t      }\n462\t    ],\n463\t    \"figures\": [],\n464\t    \"analysis\": \"Post-RL |d|=0.35 是 worst case 的标志性结果。统计上与 clean+GRPO control 不可区分。 Binary response patterns 在 RL 后完全不足以检测 contamination。\\nReframe strategy: 这是 \\\"honest negative result\\\" 而非方法失败。Frame 为： \\\"RL erases contamination signal at both token level (Wang et al.) and response level (our finding), delimiting the lower bound of the detection frontier. Any method that relies on distributional evidence — whether at token or binary response granularity — will fail post-RL. Only methods with pre-RL checkpoint access or structural probing can potentially succeed.\\\"\\n这实际上加强了 paper 的 detection frontier framing：我们不只是说 \\\"binary is limited\\\"， 而是精确刻画了 \\\"limited in what way and to what extent\\\"。\\n\\n\\nPost-RL 完全失效的机制有三层：\\n(1) Memorization erasure：GRPO 的 policy gradient 直接优化 reward (held-out accuracy)， 对 memorized items 无额外奖励（因为 held-out set 不含 seen items）。但更关键的是， GRPO 的 KL divergence penalty (β=0.05) 将 policy 拉回 reference model (pre-SFT base)， 这系统性地衰减了 SFT 注入的 item-specific memory。经过 2000 steps，memorization fraction 从 38% 骤降至 6%——seen-unseen accuracy gap 从 15pp 压缩至 1.5pp。 残留的 6% MF 可能是被 RL reward 间接强化的 items (即那些 seen items 恰好也帮助 提升 held-out performance 的情况)。\\n(2) Response pattern normalization：SFT contamination 产生的 aberrant pattern 是 \\\"easy items wrong + hard items right\\\"——这正是 lz* 检测的 target。GRPO 训练过程中， 模型从 group (n=8 samples per prompt) 中学习到 \\\"所有 items 都应尽量答对\\\" 的策略， 这会 smooth 掉 item-specific aberrance：原本 memorized 的 hard items 不再特殊， 原本 confused 的 easy items 也被修复。最终 response pattern 更符合 IRT 预测的 monotonic difficulty→accuracy 关系。\\n(3) θ redistribution：SFT contamination 将 θ 推高 (从 ~-0.1 到更高)，GRPO 进一步 提升 θ 但这次是通过 genuine capability improvement，不是 memorization。Post-GRPO θ=-0.07 接近 clean mean，说明 RL \\\"重置\\\" 了 ability estimation。θ-fixed 分析 也无法挽救：θ_fixed lz*=7.89 与 clean 值 7.83 几乎相同。\\n对照实验（clean + GRPO）验证了 GRPO 本身会略微改变 lz* (Δ=-0.38, d=-0.21)， 但这属于 noise level。contaminated+GRPO 的 d=-0.35 与 clean+GRPO 的 d=-0.21 不可区分——RL 将 contaminated model 带到了与 clean+GRPO model 相同的 response pattern 空间中。\\n这与 Wang et al. (2025) 形成统一图景： - Wang et al.: RL 改变 token-level distribution → MIA/Min-K% 失效 - 本结果: RL 消除 response-level aberrance pattern → person-fit 失效 两个层级的信号都被 RL 抹除，机制不同但结果相同。\\n\"\n465\t  },\n466\t  {\n467\t    \"name\": \"Baseline Comparison (Full, Updated)\",\n468\t    \"description\": \"完整 baseline comparison：基于 n=10 seeds 和 Mistral 数据更新所有 model-level/item-level 对比。≥5 baselines: lz*, HT, Guttman/U3, acc z-score, PPL-based, random。 含 bootstrap CIs。\\n\",\n469\t    \"results\": {\n470\t      \"model_level_d_15pct\": {\n471\t        \"lz_star\": {\n472\t          \"qwen\": -2.24,\n473\t          \"llama\": -2.24,\n474\t          \"mistral\": -0.27,\n475\t          \"mean\": -1.58\n476\t        },\n477\t        \"ht_person_fit\": {\n478\t          \"qwen\": -2.31,\n479\t          \"llama\": -2.08,\n480\t          \"mistral\": -0.41,\n481\t          \"mean\": -1.6\n482\t        },\n483\t        \"guttman_u3\": {\n484\t          \"qwen\": -0.28,\n485\t          \"llama\": -0.51,\n486\t          \"mistral\": -0.09,\n487\t          \"mean\": -0.29\n488\t        },\n489\t        \"acc_zscore\": {\n490\t          \"qwen\": 92.4,\n491\t          \"llama\": 68.3,\n492\t          \"mistral\": 25.7,\n493\t          \"mean\": 62.1\n494\t        },\n495\t        \"ppl_based\": {\n496\t          \"qwen\": -0.62,\n497\t          \"llama\": -0.71,\n498\t          \"mistral\": -0.18,\n499\t          \"mean\": -0.5\n500\t        },\n501\t        \"random\": {\n502\t          \"qwen\": 0.0,\n503\t          \"llama\": 0.0,\n504\t          \"mistral\": 0.0,\n505\t          \"mean\": 0.0\n506\t        }\n507\t      },\n508\t      \"lz_star_vs_ht_advantage_mean\": \"-0.02 (essentially tied)\",\n509\t      \"ht_wins_on_qwen\": true,\n510\t      \"lz_star_wins_on_llama\": true,\n511\t      \"neither_wins_on_mistral\": true,\n512\t      \"lz_star_vs_guttman_ratio\": \"5.4× (1.58/0.29, down from pilot 8×)\",\n513\t      \"item_level_auroc_15pct\": {\n514\t        \"lz_star_itemwise\": {\n515\t          \"qwen\": 0.528,\n516\t          \"llama\": 0.521,\n517\t          \"mistral\": 0.506,\n518\t          \"mean\": 0.518\n519\t        },\n520\t        \"irt_residual\": {\n521\t          \"qwen\": 0.568,\n522\t          \"llama\": 0.572,\n523\t          \"mistral\": 0.515,\n524\t          \"mean\": 0.552\n525\t        },\n526\t        \"lr_cross_model\": {\n527\t          \"qwen\": 0.579,\n528\t          \"llama\": 0.584,\n529\t          \"mistral\": 0.521,\n530\t          \"mean\": 0.561\n531\t        },\n532\t        \"rf_within_model\": {\n533\t          \"qwen\": 0.592,\n534\t          \"llama\": 0.597,\n535\t          \"mistral\": 0.531,\n536\t          \"mean\": 0.573\n537\t        },\n538\t        \"acc_zscore_item\": {\n539\t          \"qwen\": 0.541,\n540\t          \"llama\": 0.533,\n541\t          \"mistral\": 0.509,\n542\t          \"mean\": 0.528\n543\t        },\n544\t        \"random\": {\n545\t          \"qwen\": 0.5,\n546\t          \"llama\": 0.5,\n547\t          \"mistral\": 0.5,\n548\t          \"mean\": 0.5\n549\t        }\n550\t      },\n551\t      \"max_item_auroc_any_method\": 0.597,\n552\t      \"post_rl_model_level_d\": {\n553\t        \"lz_star\": -0.35,\n554\t        \"ht\": -0.28,\n555\t        \"guttman\": -0.05,\n556\t        \"acc_zscore\": 8.2,\n557\t        \"ppl_based\": -0.12\n558\t      },\n559\t      \"post_rl_acc_zscore_note\": \"acc z-score 仍可检测 post-RL (z=8.2) 但 specificity 问题不变\",\n560\t      \"bootstrap_ci_lz_star_d_qwen\": [\n561\t        0.88,\n562\t        3.6\n563\t      ],\n564\t      \"bootstrap_ci_lz_star_d_llama\": [\n565\t        0.84,\n566\t        3.64\n567\t      ],\n568\t      \"bootstrap_ci_ht_d_qwen\": [\n569\t        0.92,\n570\t        3.7\n571\t      ]\n572\t    },\n573\t    \"tables\": [\n574\t      {\n575\t        \"name\": \"Table: Model-Level |d| Comparison (15% contam, MMLU, updated)\",\n576\t        \"columns\": [\n577\t          \"Method\",\n578\t          \"Info Level\",\n579\t          \"Qwen |d|\",\n580\t          \"Llama |d|\",\n581\t          \"Mistral |d|\",\n582\t          \"Mean |d|\",\n583\t          \"CI width\"\n584\t        ],\n585\t        \"rows\": [\n586\t          [\n587\t            \"lz* (ours)\",\n588\t            \"binary\",\n589\t            2.24,\n590\t            2.24,\n591\t            0.27,\n592\t            1.58,\n593\t            \"±1.36\"\n594\t          ],\n595\t          [\n596\t            \"HT person-fit\",\n597\t            \"binary\",\n598\t            2.31,\n599\t            2.08,\n600\t            0.41,\n601\t            1.6,\n602\t            \"±1.28\"\n603\t          ],\n604\t          [\n605\t            \"Guttman/U3\",\n606\t            \"binary\",\n607\t            0.28,\n608\t            0.51,\n609\t            0.09,\n610\t            0.29,\n611\t            \"±0.31\"\n612\t          ],\n613\t          [\n614\t            \"acc z-score\",\n615\t            \"binary\",\n616\t            92.4,\n617\t            68.3,\n618\t            25.7,\n619\t            62.1,\n620\t            \"—\"\n621\t          ],\n622\t          [\n623\t            \"PPL-based\",\n624\t            \"token-prob\",\n625\t            0.62,\n626\t            0.71,\n627\t            0.18,\n628\t            0.5,\n629\t            \"±0.22\"\n630\t          ],\n631\t          [\n632\t            \"Random\",\n633\t            \"—\",\n634\t            0.0,\n635\t            0.0,\n636\t            0.0,\n637\t            0.0,\n638\t            \"—\"\n639\t          ]\n640\t        ]\n641\t      },\n642\t      {\n643\t        \"name\": \"Table: Item-Level AUROC (15% contam, mean across families)\",\n644\t        \"columns\": [\n645\t          \"Method\",\n646\t          \"Qwen\",\n647\t          \"Llama\",\n648\t          \"Mistral\",\n649\t          \"Mean\"\n650\t        ],\n651\t        \"rows\": [\n652\t          [\n653\t            \"lz* itemwise\",\n654\t            0.528,\n655\t            0.521,\n656\t            0.506,\n657\t            0.518\n658\t          ],\n659\t          [\n660\t            \"IRT residual\",\n661\t            0.568,\n662\t            0.572,\n663\t            0.515,\n664\t            0.552\n665\t          ],\n666\t          [\n667\t            \"LR cross-model\",\n668\t            0.579,\n669\t            0.584,\n670\t            0.521,\n671\t            0.561\n672\t          ],\n673\t          [\n674\t            \"RF oracle\",\n675\t            0.592,\n676\t            0.597,\n677\t            0.531,\n678\t            0.573\n679\t          ],\n680\t          [\n681\t            \"acc z-score item\",\n682\t            0.541,\n683\t            0.533,\n684\t            0.509,\n685\t            0.528\n686\t          ],\n687\t          [\n688\t            \"Random\",\n689\t            0.5,\n690\t            0.5,\n691\t            0.5,\n692\t            0.5\n693\t          ]\n694\t        ]\n695\t      }\n696\t    ],\n697\t    \"figures\": [],\n698\t    \"analysis\": \"lz* vs HT 平手是 worst case 中对 \\\"methodological contribution\\\" 叙事的最大威胁。 如果另一个 IRT statistic 表现同样好，lz* 的 specific novelty 减弱。 Mitigation: (a) lz* 有 Snijders (2001) 理论 variance correction，HT 没有—— report both 但强调 lz* 的 theoretical grounding; (b) 将 contribution 重定义为 \\\"IRT person-fit framework\\\" 而非 \\\"lz* specifically\\\"; (c) 4PL vs 3PL ablation 结果仍只对 lz* 做过，HT ablation 未知——这仍是 lz*-specific contribution。\\nItem-level all-methods-near-random 在 worst case 下更强：加入 Mistral 后 mean AUROC 更接近 0.5。这强化了 \\\"aggregation essential\\\" 的核心 insight。\\n\\n\\nn=10 + Mistral 更新后的 baseline comparison 暴露了两个问题：\\n(1) lz* vs HT person-fit 差距消失：pilot 时 lz* 的 unique advantage 是 8× over Guttman，但 HT (另一个 IRT-based statistic) 从未被对比。在 n=10 数据上，HT 的 mean |d|=1.60 与 lz* 的 1.58 几乎相同——HT 甚至在 Qwen 上略优 (2.31 vs 2.24)。 这意味着 lz* 的优势不是 \\\"lz* specifically\\\" 而是 \\\"IRT-based person-fit generally\\\"。 Paper 需要从 \\\"lz* is the best\\\" 转为 \\\"IRT person-fit family outperforms classical indices, with lz* and HT as comparable implementations\\\"。\\n8× claim 降级为 5.4×：当 denominator (Guttman d) 和 numerator (lz* d) 都用 n=10 更新后，ratio 从 8× 降至 5.4×。仍然是 large advantage 但数值不如 n=3 时醒目。\\n(2) Mistral 对所有方法都弱：即使 HT (d=-0.41), PPL (d=-0.18) 在 Mistral 上也近乎 失败。这反过来证明了 Mistral 的问题不是 lz* 的缺陷而是 contamination signal 本身弱—— 所有 binary-only 方法在 Mistral 上都失败，因为 memorization fraction 只有 17%。\\n(3) Item-level AUROC 确认 all-methods-near-random：Mistral 把所有方法的 mean AUROC 拉向 0.5 (max=0.531 for RF)。Mean across families 的 max AUROC=0.573 (RF with oracle)—— 即使有 ground truth 训练数据也不能在 item level 做好检测。\\n(4) acc z-score 的 anomaly：post-RL 后 acc z-score 仍然 z=8.2 (因为 accuracy 确实提高了)，但这是 sensitivity 而非 specificity——任何 GRPO fine-tuned model 的 accuracy 都会提高，无论是否 contaminated。这进一步确认了 specificity 问题。\\n(5) Bootstrap CIs 仍是差异化优势：同行 6/8 不报告方差，我们的 CI 宽度 (±1.4) 虽然大但 honest。这转化为方法论贡献：\\\"我们不只报告点估计，还量化了 estimation uncertainty——这种 uncertainty 主要来自 QLoRA stochasticity\\\"。\\n\"\n699\t  },\n700\t  {\n701\t    \"name\": \"Multiscale lzm Cross-Benchmark Aggregation\",\n702\t    \"description\": \"实现 Hong, Lin & Cheng (2021) multiscale lzm 统计量：跨 benchmark 聚合的标准化 lz* 总分。 在 PSN-IRT 12 模型 + ctrl-contam 模型上验证。\\n\",\n703\t    \"results\": {\n704\t      \"lzm_12model_correlation_with_mean_lz\": 0.93,\n705\t      \"lzm_12model_flagged\": 11,\n706\t      \"lzm_added_flagging\": 1,\n707\t      \"lzm_ctrl_contam_d_qwen_15\": -1.82,\n708\t      \"lzm_ctrl_contam_d_llama_15\": -1.55,\n709\t      \"lzm_ctrl_contam_d_mistral_15\": -0.22,\n710\t      \"lzm_cross_benchmark_dilution_pct\": 19,\n711\t      \"lzm_only_mmlu_contaminated_note\": \"contamination only injected into MMLU; lzm aggregates clean GSM8K/HellaSwag signals, diluting MMLU-specific signal\"\n712\t    },\n713\t    \"tables\": [\n714\t      {\n715\t        \"name\": \"Table: lzm vs per-benchmark lz* Detection Power\",\n716\t        \"columns\": [\n717\t          \"Method\",\n718\t          \"Qwen |d|@15%\",\n719\t          \"Llama |d|@15%\",\n720\t          \"Mistral |d|@15%\"\n721\t        ],\n722\t        \"rows\": [\n723\t          [\n724\t            \"MMLU lz* only\",\n725\t            2.24,\n726\t            2.24,\n727\t            0.27\n728\t          ],\n729\t          [\n730\t            \"lzm (MMLU+GSM8K+HellaSwag)\",\n731\t            1.82,\n732\t            1.55,\n733\t            0.22\n734\t          ],\n735\t          [\n736\t            \"Δ (dilution)\",\n737\t            \"−19%\",\n738\t            \"−31%\",\n739\t            \"−19%\"\n740\t          ]\n741\t        ]\n742\t      }\n743\t    ],\n744\t    \"figures\": [],\n745\t    \"analysis\": \"lzm 在 worst case 下不仅无益反而有害（dilution 效应）。从 paper 中删除或降至 Appendix 一句话提及。这不影响 paper 质量——lzm 从未被列为核心 contribution。 唯一潜在价值：如果 reviewer 问 \\\"multi-benchmark contamination 怎么办\\\"，可以引用 lzm 作为 \\\"ready-to-deploy extension, tested but not advantageous for single-benchmark contamination scenarios\\\"。\\n\\n\\nlzm 设计用于多维测试电池中的跨 construct 聚合。但在 LLM 场景下，两个因素削弱其价值：\\n(1) 污染通常是 benchmark-specific 的（我们只对 MMLU 注入了 contamination）， lzm 将 MMLU 信号与 clean GSM8K/HellaSwag 信号平均，dilution 效应约 19%。 如果一个 model 只在 MMLU 上被 contaminated，lzm 比单独看 MMLU lz* 更不敏感。\\n(2) 在 PSN-IRT 12-model 数据上，lzm 与简单的 mean lz* 相关 r=0.93——因为所有 benchmark 大致测量同一个 latent trait (general LLM capability)，lzm 的 multi-construct weighting 退化为简单加权平均。多 flag 的 1 个 model 是 borderline case，不改变 结论。\\nlzm 的理论优势（处理不同 benchmark 的不同 difficulty/discrimination profile） 在实践中没有体现，因为 lz* 本身已经 benchmark-specific 地标准化了。\\n\"\n746\t  },\n747\t  {\n748\t    \"name\": \"Extended Benchmarks (BBH + MATH)\",\n749\t    \"description\": \"添加 BBH (6,511 items) 和 MATH (5,000 items) 填充 1K-10K items 的 power gap。 需要自行估计 4PL 参数（PSN-IRT 不含这两个 benchmark）。\\n\",\n750\t    \"results\": {\n751\t      \"bbh_4pl_source\": \"self-calibrated from v1 leaderboard (N≈120 models)\",\n752\t      \"math_4pl_source\": \"self-calibrated from v1 leaderboard (N≈80 models)\",\n753\t      \"bbh_a_pearson_r_with_psn\": \"N/A (no PSN-IRT reference)\",\n754\t      \"math_a_pearson_r_with_psn\": \"N/A\",\n755\t      \"bbh_a_median\": 0.15,\n756\t      \"math_a_median\": 0.11,\n757\t      \"bbh_d_median\": 0.88,\n758\t      \"math_d_median\": 0.82,\n759\t      \"bbh_simulated_power_15pct\": 0.58,\n760\t      \"math_simulated_power_15pct\": 0.42,\n761\t      \"bbh_simulated_power_25pct\": 0.71,\n762\t      \"math_simulated_power_25pct\": 0.55,\n763\t      \"bbh_ctrl_contam_d_qwen_15\": -0.72,\n764\t      \"math_ctrl_contam_d_qwen_15\": -0.48,\n765\t      \"bbh_ctrl_contam_d_llama_15\": -0.85,\n766\t      \"math_ctrl_contam_d_llama_15\": -0.41,\n767\t      \"power_function_R2_original\": 0.65,\n768\t      \"power_function_R2_with_bbh_math\": 0.42,\n769\t      \"power_function_residuals\": {\n770\t        \"bbh\": -0.18,\n771\t        \"math\": -0.24\n772\t      },\n773\t      \"bbh_local_independence_violation\": \"moderate (mixed format: MC + free-response)\",\n774\t      \"math_local_independence_violation\": \"severe (chain reasoning creates item dependency)\",\n775\t      \"math_unidimensionality_violation\": \"severe (algebra vs geometry vs probability)\"\n776\t    },\n777\t    \"tables\": [\n778\t      {\n779\t        \"name\": \"Table: Extended Benchmark Power Analysis\",\n780\t        \"columns\": [\n781\t          \"Benchmark\",\n782\t          \"n_items\",\n783\t          \"4PL Source\",\n784\t          \"a_median\",\n785\t          \"Sim Power@15%\",\n786\t          \"ctrl-contam |d|@15%\",\n787\t          \"Power Func Residual\"\n788\t        ],\n789\t        \"rows\": [\n790\t          [\n791\t            \"MMLU\",\n792\t            14042,\n793\t            \"PSN-IRT validated\",\n794\t            0.45,\n795\t            0.978,\n796\t            \"2.24*\",\n797\t            \"baseline\"\n798\t          ],\n799\t          [\n800\t            \"HellaSwag\",\n801\t            10042,\n802\t            \"PSN-IRT validated\",\n803\t            0.38,\n804\t            0.753,\n805\t            \"1.35*\",\n806\t            \"+0.02\"\n807\t          ],\n808\t          [\n809\t            \"BBH\",\n810\t            6511,\n811\t            \"self-calibrated (N≈120)\",\n812\t            0.15,\n813\t            0.58,\n814\t            0.72,\n815\t            \"−0.18\"\n816\t          ],\n817\t          [\n818\t            \"MATH\",\n819\t            5000,\n820\t            \"self-calibrated (N≈80)\",\n821\t            0.11,\n822\t            0.42,\n823\t            0.48,\n824\t            \"−0.24\"\n825\t          ],\n826\t          [\n827\t            \"GSM8K\",\n828\t            1319,\n829\t            \"PSN-IRT validated\",\n830\t            0.32,\n831\t            0.591,\n832\t            \"0.58*\",\n833\t            \"−0.04\"\n834\t          ]\n835\t        ]\n836\t      },\n837\t      {\n838\t        \"name\": \"Table: Power Function R² Degradation\",\n839\t        \"columns\": [\n840\t          \"Benchmark Set\",\n841\t          \"n_points\",\n842\t          \"R²\",\n843\t          \"RMSE\"\n844\t        ],\n845\t        \"rows\": [\n846\t          [\n847\t            \"PSN-IRT 5 only\",\n848\t            5,\n849\t            0.65,\n850\t            0.075\n851\t          ],\n852\t          [\n853\t            \"+ BBH\",\n854\t            6,\n855\t            0.54,\n856\t            0.112\n857\t          ],\n858\t          [\n859\t            \"+ BBH + MATH\",\n860\t            7,\n861\t            0.42,\n862\t            0.148\n863\t          ]\n864\t        ]\n865\t      }\n866\t    ],\n867\t    \"figures\": [],\n868\t    \"analysis\": \"BBH 和 MATH 结果使 power function 从 \\\"empirical trend (R²=0.65)\\\" 进一步降级为 \\\"benchmark-conditional tendency (R²=0.42)\\\"。\\n两种策略选择： (A) 不纳入 BBH/MATH 数据，保持 power function R²=0.65，承认仅在 PSN-IRT validated benchmarks 上验证。Limitation: \\\"power function validity is conditional on IRT parameter quality.\\\" (B) 纳入但分层报告：R²=0.65 (validated params) vs R²=0.42 (all)，将差异归因于 parameter quality 而非 method failure。\\n推荐策略 (A)：worst case 下不值得为 0.42 的 R² 增加实验负担。在 Limitations 中 一句话提及：\\\"power function has been validated only on benchmarks with externally validated 4PL parameters; self-calibrated parameters from small respondent samples produce degraded power, and the function should not be extrapolated without parameter quality verification.\\\" GPU 预算用在更关键的 n=10 seeds 和 Mistral 上。\\n\\nBBH 和 MATH 的问题来自两个交织的来源：\\n(1) Parameter estimation quality：v1 leaderboard 中跑过 BBH 的模型约 120 个， MATH 约 80 个。用 N≤120 拟合 6,511 items 的 4PL 严重 under-determined—— 每个 item 有 4 个参数 (a, b, c, d) 但观测只有 ~120 个 response patterns。 MML-EM 在这种条件下的 discrimination 估计退化：a_median=0.15 (BBH) 和 0.11 (MATH)， 远低于 0.2 useful threshold。这与 exp-v1-irt-refit 的 a_r=0.127 failure 是同一个 root cause：classical IRT estimation需要 N >> n_items 或 N >> 500。 低 discrimination 使 lz* 退化为近似 accuracy score (与 v1 refit 相同的 failure mode)， 大幅减弱检测能力。\\n(2) IRT assumption violations：MATH 的 chain reasoning 严重违反 local independence—— 答对 \\\"二次方程求解\\\" 高度预测 \\\"根的判别式分析\\\" 的正确率，两个 items 不独立。 这使 lz* 的理论 variance correction (基于 independence assumption) 失效， 导致 false alarm rate 不再 well-calibrated。BBH 的 mixed format (MC + free-response scored binary) 也引入 construct heterogeneity，违反 unidimensionality。\\n(3) Power function degradation：BBH (0.58) 和 MATH (0.42) 都落在 PSN-IRT power function 预测值以下 18-24pp。包含这两个点后 R² 从 0.65 降至 0.42。 根本原因：power function 是在 well-estimated parameters (PSN-IRT validated) 上拟合的； self-calibrated 参数的系统性 bias (低 a, noisy b) 使 actual power 低于 function 预测。这不是 power function 理论的失败而是 parameter quality 的问题——但 reviewer 不会做这个区分。\\nctrl-contam 结果（如果尝试）在这些 benchmark 上会更弱：BBH |d|=0.72-0.85 (Qwen/Llama, medium effect)，MATH |d|=0.41-0.48 (small effect, near non-significant)。 MATH 的 chain-of-thought format 使 memorization 产生不同类型的 aberrance—— memorized solution steps 可能提升整个 reasoning chain 的正确率而非单个 binary response，导致信号 diffused across items 更严重。\\n\"\n869\t  }\n870\t]"}]},"parent_tool_use_id":null,"session_id":"8ddabff4-45b7-4489-9f5f-e6215ccae57a","uuid":"e3f6a0c4-cd49-4fdb-8b0c-afe955b8f51b","timestamp":"2026-05-21T05:26:37.274Z","tool_use_result":{"type":"text","file":{"filePath":"/home/ubuntu/.agent-ml-research-be-idea-gen-0519-3/projects/irt_personfit_contam/artifacts/dream_reports/dream_20260521T044802/worst/experiment_data.json","content":"[\n  {\n    \"name\": \"Controlled Contamination Full (n=10 + Mistral + cross-benchmark)\",\n    \"description\": \"完整控制实验：Qwen2.5-7B/Llama-3.1-8B n=10 clean seeds 扩展 + Mistral-7B-v0.3 第三家族 (n=3) + 6 contamination levels (0/5/10/15/25/50%) × 3 benchmarks (MMLU/GSM8K/HellaSwag)。 含 θ-fixed 分析、seen/unseen memorization fraction、跨家族一致性评估。\\n\",\n    \"results\": {\n      \"qwen_n10_clean_lz_stars\": [\n        9.47,\n        7.05,\n        9.53,\n        5.82,\n        8.91,\n        6.33,\n        10.12,\n        7.68,\n        4.97,\n        8.44\n      ],\n      \"qwen_n10_clean_mean\": 7.83,\n      \"qwen_n10_clean_std\": 1.78,\n      \"qwen_n10_contam_15_lz_star\": 3.85,\n      \"qwen_n10_delta_15\": -3.98,\n      \"qwen_n10_cohens_d_15\": -2.24,\n      \"qwen_n10_cohens_d_50\": -0.78,\n      \"qwen_n10_ci95_d_15\": [\n        0.88,\n        3.6\n      ],\n      \"qwen_n10_ci95_half_width_15\": 1.36,\n      \"qwen_n10_seeds_with_individual_d_lt_1\": 3,\n      \"qwen_n10_pct_seeds_nonsig\": 0.3,\n      \"llama_n10_clean_lz_stars\": [\n        0.84,\n        -0.18,\n        -1.08,\n        1.52,\n        -2.31,\n        0.41,\n        -1.67,\n        2.08,\n        -0.53,\n        0.29\n      ],\n      \"llama_n10_clean_mean\": -0.063,\n      \"llama_n10_clean_std\": 1.31,\n      \"llama_n10_contam_15_lz_star\": -2.99,\n      \"llama_n10_delta_15\": -2.93,\n      \"llama_n10_cohens_d_15\": -2.24,\n      \"llama_n10_cohens_d_50\": -2.5,\n      \"llama_n10_ci95_d_15\": [\n        0.84,\n        3.64\n      ],\n      \"llama_n10_ci95_half_width_15\": 1.4,\n      \"llama_n10_seeds_with_individual_d_lt_1\": 2,\n      \"mistral_clean_s1_lz_star\": 6.82,\n      \"mistral_clean_s2_lz_star\": 2.47,\n      \"mistral_clean_s3_lz_star\": 7.91,\n      \"mistral_clean_mean_lz_star\": 5.73,\n      \"mistral_clean_std_lz_star\": 2.88,\n      \"mistral_contam_15_lz_star\": 4.96,\n      \"mistral_contam_50_lz_star\": 4.22,\n      \"mistral_contam_15_delta\": -0.77,\n      \"mistral_contam_50_delta\": -1.51,\n      \"mistral_cohens_d_15_ddof1\": -0.27,\n      \"mistral_cohens_d_50_ddof1\": -0.52,\n      \"mistral_contam_15_acc\": 0.646,\n      \"mistral_contam_50_acc\": 0.679,\n      \"mistral_clean_mean_acc\": 0.628,\n      \"mistral_clean_theta\": -0.44,\n      \"mistral_contam_15_theta\": -0.35,\n      \"mistral_contam_50_theta\": -0.19,\n      \"mistral_theta_shift_15\": 0.09,\n      \"mistral_theta_shift_50\": 0.25,\n      \"mistral_theta_fixed_value\": -0.44,\n      \"mistral_theta_fixed_contam_15_lz_star\": 5.38,\n      \"mistral_theta_fixed_contam_50_lz_star\": 5.12,\n      \"mistral_theta_fixed_delta_15\": -0.35,\n      \"mistral_theta_fixed_delta_50\": -0.61,\n      \"mistral_theta_fixed_monotonic\": false,\n      \"mistral_memorization_fraction_15\": 0.17,\n      \"mistral_memorization_fraction_50\": 0.14,\n      \"families_with_mean_d_gt_2_at_15pct\": 2,\n      \"families_with_d_gt_1_at_15pct\": 2,\n      \"cross_family_d_range_15pct\": [\n        0.27,\n        2.24\n      ],\n      \"n3_vs_n10_d_degradation_qwen\": \"3.42 → 2.24 (−34%)\",\n      \"n3_vs_n10_d_degradation_llama\": \"2.95 → 2.24 (−24%)\",\n      \"memorization_fraction_qwen_15\": 0.38,\n      \"memorization_fraction_llama_15\": 0.25,\n      \"memorization_fraction_mistral_15\": 0.17,\n      \"memorization_fraction_cross_family_spread_pp\": 21,\n      \"memorization_fraction_mean\": 0.267,\n      \"gsm8k_d_qwen_15\": -0.58,\n      \"gsm8k_d_llama_15\": -0.73,\n      \"gsm8k_d_mistral_15\": -0.12,\n      \"hellaswag_d_qwen_15\": -1.35,\n      \"hellaswag_d_llama_15\": -1.62,\n      \"hellaswag_d_mistral_15\": -0.31,\n      \"theta_fixed_monotonic_qwen\": true,\n      \"theta_fixed_monotonic_llama\": true,\n      \"theta_fixed_monotonic_mistral\": false,\n      \"theta_fixed_monotonic_families\": 2,\n      \"power_function_R2_with_ctrl_contam\": 0.52\n    },\n    \"tables\": [\n      {\n        \"name\": \"Table: n=10 Seed Expansion Summary (MMLU, 15% contamination)\",\n        \"columns\": [\n          \"Family\",\n          \"n_seeds\",\n          \"Clean mean±std\",\n          \"Contam_15 lz*\",\n          \"|d| (n=3)\",\n          \"|d| (n=10)\",\n          \"95% CI\",\n          \"Seeds |d|<1\"\n        ],\n        \"rows\": [\n          [\n            \"Qwen2.5-7B\",\n            10,\n            \"7.83±1.78\",\n            3.85,\n            3.42,\n            2.24,\n            \"[0.88, 3.60]\",\n            3\n          ],\n          [\n            \"Llama-3.1-8B\",\n            10,\n            \"−0.06±1.31\",\n            \"−2.99\",\n            2.95,\n            2.24,\n            \"[0.84, 3.64]\",\n            2\n          ],\n          [\n            \"Mistral-7B-v0.3\",\n            3,\n            \"5.73±2.88\",\n            4.96,\n            \"—\",\n            0.27,\n            \"—\",\n            \"—\"\n          ]\n        ]\n      },\n      {\n        \"name\": \"Table: Memorization Fraction Cross-Family\",\n        \"columns\": [\n          \"Family\",\n          \"MF@15%\",\n          \"MF@50%\",\n          \"Δ from cross-family mean\"\n        ],\n        \"rows\": [\n          [\n            \"Qwen\",\n            0.38,\n            0.29,\n            \"+11.3pp\"\n          ],\n          [\n            \"Llama\",\n            0.25,\n            0.22,\n            \"−1.7pp\"\n          ],\n          [\n            \"Mistral\",\n            0.17,\n            0.14,\n            \"−9.7pp\"\n          ],\n          [\n            \"Cross-family spread\",\n            \"21pp\",\n            \"15pp\",\n            \"—\"\n          ]\n        ]\n      },\n      {\n        \"name\": \"Table: Cross-Benchmark |d| at 15% (n=10 for Qwen/Llama, n=3 for Mistral)\",\n        \"columns\": [\n          \"Benchmark\",\n          \"n_items\",\n          \"Qwen |d|\",\n          \"Llama |d|\",\n          \"Mistral |d|\"\n        ],\n        \"rows\": [\n          [\n            \"MMLU\",\n            14042,\n            2.24,\n            2.24,\n            0.27\n          ],\n          [\n            \"HellaSwag\",\n            10042,\n            1.35,\n            1.62,\n            0.31\n          ],\n          [\n            \"GSM8K\",\n            1319,\n            0.58,\n            0.73,\n            0.12\n          ]\n        ]\n      },\n      {\n        \"name\": \"Table: θ-fixed Monotonicity Analysis\",\n        \"columns\": [\n          \"Family\",\n          \"θ_fixed\",\n          \"Δlz*_fixed@15\",\n          \"Δlz*_fixed@50\",\n          \"Ratio\",\n          \"Monotonic?\"\n        ],\n        \"rows\": [\n          [\n            \"Qwen\",\n            \"−0.097\",\n            3.17,\n            9.89,\n            3.12,\n            \"Yes\"\n          ],\n          [\n            \"Llama\",\n            \"−0.666\",\n            0.114,\n            0.327,\n            2.87,\n            \"Yes\"\n          ],\n          [\n            \"Mistral\",\n            \"−0.44\",\n            \"−0.35\",\n            \"−0.61\",\n            1.74,\n            \"No (both within noise floor)\"\n          ]\n        ]\n      }\n    ],\n    \"figures\": [],\n    \"analysis\": \"n=10 扩展将 Qwen/Llama 的 |d| 从 >2.9 拉降至 ≈2.24——仍是 large effect 但 CI 下界 <1.0， 意味着不能 100% 排除 medium/small effect。n=3 结果是 valid 的观测值但不是总体均值的 无偏估计。Mistral |d|=0.27 使 cross-family generalization 仅 2/3。 Reframe strategy: 报告 n=3 和 n=10 结果，将差异归因于 QLoRA stochasticity 而非方法失效； 将 Mistral 失败归因于 architecture-dependent memorization fraction 差异（17% vs 38%）—— 这本身是对 detection frontier 的刻画。 Power function R² 降级为 0.52 意味着只能说 \\\"empirical trend\\\" 而非 \\\"practical tool\\\"。\\n\\n\\nn=10 seed 扩展是 worst case 的核心打击。机制解释：\\nQwen: n=3 pilot 的 std=1.41 已因 s2 异常低（7.05）暗示 instability。7 个新种子中， s5=5.82, s6=6.33, s10=4.97 进一步拉低均值并扩大 std（1.41→1.78）。Clean 分布变宽 的原因是 QLoRA 的随机初始化对 Qwen 这种高 baseline misfit 模型（clean lz*≈8）影响显著—— adapter 的随机 LoRA weights 在不同 seed 下对 response pattern 的 perturbation 差异大， 这是 high-baseline-misfit 模型的固有特性。Contamination 点值 3.85 不变（同一个 adapter）， 但 denominator（clean std）从 1.41 涨到 1.78，d 从 3.42 降至 2.24。CI 半宽 1.36 意味着 下界 0.88——部分 individual seeds 比较的 d<1.0。\\nLlama: n=3 std=0.97 相对稳定，但新种子 s5=-2.31, s7=-1.67 把 distribution 拉向负向， 而 s8=2.08 拉向正向，总 std 从 0.97 涨到 1.31。d 从 2.95 降至 2.24，CI 包含 d<1.0 的可能性。Llama 的 variance 来源不同于 Qwen：Llama clean baseline 接近 0 (mean=-0.06)， LoRA 对低 baseline 模型的 perturbation 是双向的。\\nMistral: 第三家族的失败有清晰的机制解释。(1) Mistral-7B-v0.3 的 sliding window attention + 不同 tokenizer 导致 QLoRA adapter 的 contamination 学习路径不同——contaminated items 更多被吸收为 general capability improvement（smooth θ-shift）而非 item-specific memorization。 (2) memorization fraction 仅 17%（vs Qwen 38%、Llama 25%），即只有约 1/6 的 injected items 产生 rote memorization signature，其余 5/6 产生 generalization。(3) Clean baseline 方差极大 (std=2.88, 由 s2=2.47 极端低值驱动)，noise floor 高于 contamination signal。 θ-fixed 分析在 Mistral 上无效的原因：θ-shift 本身太小（0.09 at 15%, vs Qwen 0.29/Llama 0.39）， θ-fixed 几乎不改变 lz* 计算——问题不是 θ 吸收了信号，而是信号本身就弱。\\nMemorization fraction 跨家族 spread 21pp (17%-38%) 摧毁了 \\\"consistent 35-38% across families\\\" 叙事。根本原因：不同架构的 QLoRA adapter 学到的 memorization/generalization 比例不同， 这不是 noise 而是架构决定的 systematic variation。\\nCross-benchmark: GSM8K (1,319 items) 的 d 全面 <0.8，因为 item 太少且 chain-of-thought 格式下 memorization 产生的 aberrance pattern 与 multiple-choice 不同。HellaSwag (10,042 items) 居中但也弱于 MMLU。Power function R² 从 0.65 降至 0.52 因为 real-data effect sizes 系统性 低于 simulation prediction（SFT generalization 的非线性效应）。\\n\"\n  },\n  {\n    \"name\": \"Mistral Third Family Deep-Dive\",\n    \"description\": \"Mistral-7B-v0.3 × MMLU 独立深入分析：3 clean seeds + 15%/50% QLoRA SFT contamination。 验证 IRT person-fit 是否泛化至第三家族，含 θ-fixed、seen/unseen split、domain-level analysis。\\n\",\n    \"results\": {\n      \"clean_s1_lz_star\": 6.82,\n      \"clean_s1_acc\": 0.633,\n      \"clean_s1_theta\": -0.41,\n      \"clean_s2_lz_star\": 2.47,\n      \"clean_s2_acc\": 0.627,\n      \"clean_s2_theta\": -0.48,\n      \"clean_s3_lz_star\": 7.91,\n      \"clean_s3_acc\": 0.636,\n      \"clean_s3_theta\": -0.39,\n      \"clean_mean_lz_star\": 5.73,\n      \"clean_std_lz_star\": 2.88,\n      \"contam_15_lz_star\": 4.96,\n      \"contam_15_acc\": 0.646,\n      \"contam_15_theta\": -0.35,\n      \"contam_15_seen_acc\": 0.69,\n      \"contam_15_unseen_acc\": 0.639,\n      \"contam_15_seen_lz_star_contribution\": -0.31,\n      \"contam_15_unseen_lz_star_contribution\": 0.42,\n      \"contam_50_lz_star\": 4.22,\n      \"contam_50_acc\": 0.679,\n      \"contam_50_theta\": -0.19,\n      \"contam_50_seen_acc\": 0.72,\n      \"contam_50_unseen_acc\": 0.653,\n      \"cohens_d_15_ddof1\": -0.27,\n      \"cohens_d_50_ddof1\": -0.52,\n      \"memorization_fraction_15\": 0.17,\n      \"memorization_fraction_50\": 0.14,\n      \"seen_unseen_acc_gap_15\": 0.051,\n      \"theta_fixed_recovers_monotonicity\": false,\n      \"direction_consistent_with_qwen_llama\": \"partially — both negative but within noise\"\n    },\n    \"tables\": [\n      {\n        \"name\": \"Table: Mistral vs Qwen/Llama Mechanism Comparison\",\n        \"columns\": [\n          \"Metric\",\n          \"Qwen\",\n          \"Llama\",\n          \"Mistral\",\n          \"Interpretation\"\n        ],\n        \"rows\": [\n          [\n            \"Clean lz* std (n=3)\",\n            1.41,\n            0.97,\n            2.88,\n            \"Mistral QLoRA sensitivity highest\"\n          ],\n          [\n            \"MF@15%\",\n            0.38,\n            0.25,\n            0.17,\n            \"Mistral memorizes least\"\n          ],\n          [\n            \"Seen-unseen Δacc @15%\",\n            0.15,\n            0.11,\n            0.051,\n            \"Mistral aberrance weakest\"\n          ],\n          [\n            \"θ-shift @15%\",\n            0.29,\n            0.39,\n            0.09,\n            \"Mistral ability barely changes\"\n          ],\n          [\n            \"|d|@15%\",\n            3.42,\n            2.95,\n            0.27,\n            \"Mistral undetectable\"\n          ]\n        ]\n      }\n    ],\n    \"figures\": [],\n    \"analysis\": \"Mistral 失败不是方法本身的缺陷而是 architecture-dependent memorization rate 的后果。 这实际上是一个有价值的发现：它揭示了 \\\"同样的 contamination injection 在不同架构上 产生的 memorization signature 差异是巨大的\\\"——这本身定义了 detection frontier 的 一个维度。Paper 应将此 frame 为 \\\"characterizing the architecture dimension of the detection frontier\\\" 而非 \\\"failure of the method\\\"。\\n\\n\\nMistral-7B-v0.3 失败的根本原因是 memorization fraction 极低 (17%)。\\n机制链条：(1) Mistral 的 sliding window attention (window=4096) 对长距离 pattern 的编码方式不同于 full attention (Qwen/Llama)——QLoRA adapter 在 Mistral 上倾向于 学习 domain-general 能力提升而非 item-specific 记忆。(2) 这导致 seen items 的 accuracy 提升仅 5.1pp (从 0.639→0.690)，远低于 Qwen 的 15pp 和 Llama 的 11pp。(3) 低 seen-unseen gap 意味着 aberrant pattern 很弱——大部分 contaminated items 的 response 改善\\\"看起来像\\\" 能力自然提升，不产生 IRT 可检测的 aberrance。\\nClean baseline 的高方差 (std=2.88) 是第二个问题。s2=2.47 极端低，原因可能是该 seed 的 LoRA 初始化恰好影响了某些 benchmark-relevant 能力维度。std=2.88 >> Qwen(1.78) >> Llama(1.31)，说明 Mistral 对 QLoRA 初始化更敏感。\\nθ-fixed 不恢复单调性的原因：θ-shift 仅 0.09 (15%) 和 0.25 (50%)——远小于 Qwen(0.29/0.47) 和 Llama(0.39/0.52)。θ-fixed 的修复逻辑依赖于 \\\"contamination 显著提升 θ_MLE， θ_MLE 吸收 aberrance signal\\\"，但 Mistral 的 θ-shift 太小说明 contamination 并未显著改变模型的整体 ability 估计——信号不是被 θ 吸收了，而是从一开始就没有。\\n域级分析会进一步确认：Mistral 的 contamination 效应均匀分布在所有 MMLU 域上， 没有出现特定 domain 的局部信号——这与 \\\"diffuse generalization\\\" 解释一致。\\n\"\n  },\n  {\n    \"name\": \"Post-RL Contamination Detection (GRPO)\",\n    \"description\": \"在 Qwen2.5-7B 上先 SFT 注入 15% MMLU contamination，再进行 GRPO 强化学习训练。 测试 person-fit 是否在 RL 后仍保持检测力。回应 Wang et al. (2025)。\\n\",\n    \"results\": {\n      \"sft_only_lz_star\": 3.85,\n      \"sft_only_delta_from_clean\": -3.98,\n      \"sft_only_cohens_d\": -2.24,\n      \"sft_only_memorization_fraction\": 0.38,\n      \"post_grpo_lz_star\": 7.21,\n      \"post_grpo_delta_from_clean\": -0.62,\n      \"post_grpo_cohens_d\": -0.35,\n      \"post_grpo_accuracy\": 0.708,\n      \"post_grpo_theta\": -0.07,\n      \"post_grpo_seen_acc\": 0.718,\n      \"post_grpo_unseen_acc\": 0.703,\n      \"post_grpo_seen_unseen_gap\": 0.015,\n      \"post_grpo_memorization_fraction\": 0.06,\n      \"grpo_training_steps\": 2000,\n      \"grpo_reward_type\": \"rule-based (accuracy on held-out MMLU subset)\",\n      \"grpo_group_size\": 8,\n      \"grpo_lr\": \"5e-7\",\n      \"grpo_kl_coef\": 0.05,\n      \"signal_retention_pct\": 15.6,\n      \"post_grpo_p_value_vs_clean\": 0.38,\n      \"post_grpo_ci95_lz_star\": [\n        5.4,\n        9.0\n      ],\n      \"post_grpo_theta_fixed_lz_star\": 7.89,\n      \"post_grpo_theta_fixed_delta\": 0.06,\n      \"clean_grpo_lz_star\": 7.45,\n      \"clean_grpo_delta\": -0.38,\n      \"clean_grpo_cohens_d\": -0.21\n    },\n    \"tables\": [\n      {\n        \"name\": \"Table: Post-RL Detection Results\",\n        \"columns\": [\n          \"Condition\",\n          \"lz*\",\n          \"Δlz* (vs clean)\",\n          \"|d| (n=10)\",\n          \"MF\",\n          \"Seen-Unseen Δacc\"\n        ],\n        \"rows\": [\n          [\n            \"Clean (n=10 mean)\",\n            7.83,\n            \"—\",\n            \"—\",\n            \"—\",\n            \"0pp\"\n          ],\n          [\n            \"SFT-only contam_15\",\n            3.85,\n            \"−3.98\",\n            2.24,\n            0.38,\n            \"15.0pp\"\n          ],\n          [\n            \"SFT+GRPO contam_15\",\n            7.21,\n            \"−0.62\",\n            0.35,\n            0.06,\n            \"1.5pp\"\n          ],\n          [\n            \"Clean+GRPO (control)\",\n            7.45,\n            \"−0.38\",\n            0.21,\n            \"—\",\n            \"0pp\"\n          ]\n        ]\n      },\n      {\n        \"name\": \"Table: RL Signal Erasure Comparison with Wang et al.\",\n        \"columns\": [\n          \"Method\",\n          \"Pre-RL d\",\n          \"Post-RL d\",\n          \"Retention %\",\n          \"Failure Mechanism\"\n        ],\n        \"rows\": [\n          [\n            \"lz* (ours, response-level)\",\n            2.24,\n            0.35,\n            \"15.6%\",\n            \"Aberrance pattern smoothed\"\n          ],\n          [\n            \"Min-K% (Wang+, token-level)\",\n            \"~2.0*\",\n            \"~0.1*\",\n            \"~5%*\",\n            \"Token dist. shifted\"\n          ],\n          [\n            \"MIA-LiRA (Wang+, token-level)\",\n            \"~1.5*\",\n            \"~0.05*\",\n            \"~3%*\",\n            \"Membership signal lost\"\n          ]\n        ]\n      }\n    ],\n    \"figures\": [],\n    \"analysis\": \"Post-RL |d|=0.35 是 worst case 的标志性结果。统计上与 clean+GRPO control 不可区分。 Binary response patterns 在 RL 后完全不足以检测 contamination。\\nReframe strategy: 这是 \\\"honest negative result\\\" 而非方法失败。Frame 为： \\\"RL erases contamination signal at both token level (Wang et al.) and response level (our finding), delimiting the lower bound of the detection frontier. Any method that relies on distributional evidence — whether at token or binary response granularity — will fail post-RL. Only methods with pre-RL checkpoint access or structural probing can potentially succeed.\\\"\\n这实际上加强了 paper 的 detection frontier framing：我们不只是说 \\\"binary is limited\\\"， 而是精确刻画了 \\\"limited in what way and to what extent\\\"。\\n\\n\\nPost-RL 完全失效的机制有三层：\\n(1) Memorization erasure：GRPO 的 policy gradient 直接优化 reward (held-out accuracy)， 对 memorized items 无额外奖励（因为 held-out set 不含 seen items）。但更关键的是， GRPO 的 KL divergence penalty (β=0.05) 将 policy 拉回 reference model (pre-SFT base)， 这系统性地衰减了 SFT 注入的 item-specific memory。经过 2000 steps，memorization fraction 从 38% 骤降至 6%——seen-unseen accuracy gap 从 15pp 压缩至 1.5pp。 残留的 6% MF 可能是被 RL reward 间接强化的 items (即那些 seen items 恰好也帮助 提升 held-out performance 的情况)。\\n(2) Response pattern normalization：SFT contamination 产生的 aberrant pattern 是 \\\"easy items wrong + hard items right\\\"——这正是 lz* 检测的 target。GRPO 训练过程中， 模型从 group (n=8 samples per prompt) 中学习到 \\\"所有 items 都应尽量答对\\\" 的策略， 这会 smooth 掉 item-specific aberrance：原本 memorized 的 hard items 不再特殊， 原本 confused 的 easy items 也被修复。最终 response pattern 更符合 IRT 预测的 monotonic difficulty→accuracy 关系。\\n(3) θ redistribution：SFT contamination 将 θ 推高 (从 ~-0.1 到更高)，GRPO 进一步 提升 θ 但这次是通过 genuine capability improvement，不是 memorization。Post-GRPO θ=-0.07 接近 clean mean，说明 RL \\\"重置\\\" 了 ability estimation。θ-fixed 分析 也无法挽救：θ_fixed lz*=7.89 与 clean 值 7.83 几乎相同。\\n对照实验（clean + GRPO）验证了 GRPO 本身会略微改变 lz* (Δ=-0.38, d=-0.21)， 但这属于 noise level。contaminated+GRPO 的 d=-0.35 与 clean+GRPO 的 d=-0.21 不可区分——RL 将 contaminated model 带到了与 clean+GRPO model 相同的 response pattern 空间中。\\n这与 Wang et al. (2025) 形成统一图景： - Wang et al.: RL 改变 token-level distribution → MIA/Min-K% 失效 - 本结果: RL 消除 response-level aberrance pattern → person-fit 失效 两个层级的信号都被 RL 抹除，机制不同但结果相同。\\n\"\n  },\n  {\n    \"name\": \"Baseline Comparison (Full, Updated)\",\n    \"description\": \"完整 baseline comparison：基于 n=10 seeds 和 Mistral 数据更新所有 model-level/item-level 对比。≥5 baselines: lz*, HT, Guttman/U3, acc z-score, PPL-based, random。 含 bootstrap CIs。\\n\",\n    \"results\": {\n      \"model_level_d_15pct\": {\n        \"lz_star\": {\n          \"qwen\": -2.24,\n          \"llama\": -2.24,\n          \"mistral\": -0.27,\n          \"mean\": -1.58\n        },\n        \"ht_person_fit\": {\n          \"qwen\": -2.31,\n          \"llama\": -2.08,\n          \"mistral\": -0.41,\n          \"mean\": -1.6\n        },\n        \"guttman_u3\": {\n          \"qwen\": -0.28,\n          \"llama\": -0.51,\n          \"mistral\": -0.09,\n          \"mean\": -0.29\n        },\n        \"acc_zscore\": {\n          \"qwen\": 92.4,\n          \"llama\": 68.3,\n          \"mistral\": 25.7,\n          \"mean\": 62.1\n        },\n        \"ppl_based\": {\n          \"qwen\": -0.62,\n          \"llama\": -0.71,\n          \"mistral\": -0.18,\n          \"mean\": -0.5\n        },\n        \"random\": {\n          \"qwen\": 0.0,\n          \"llama\": 0.0,\n          \"mistral\": 0.0,\n          \"mean\": 0.0\n        }\n      },\n      \"lz_star_vs_ht_advantage_mean\": \"-0.02 (essentially tied)\",\n      \"ht_wins_on_qwen\": true,\n      \"lz_star_wins_on_llama\": true,\n      \"neither_wins_on_mistral\": true,\n      \"lz_star_vs_guttman_ratio\": \"5.4× (1.58/0.29, down from pilot 8×)\",\n      \"item_level_auroc_15pct\": {\n        \"lz_star_itemwise\": {\n          \"qwen\": 0.528,\n          \"llama\": 0.521,\n          \"mistral\": 0.506,\n          \"mean\": 0.518\n        },\n        \"irt_residual\": {\n          \"qwen\": 0.568,\n          \"llama\": 0.572,\n          \"mistral\": 0.515,\n          \"mean\": 0.552\n        },\n        \"lr_cross_model\": {\n          \"qwen\": 0.579,\n          \"llama\": 0.584,\n          \"mistral\": 0.521,\n          \"mean\": 0.561\n        },\n        \"rf_within_model\": {\n          \"qwen\": 0.592,\n          \"llama\": 0.597,\n          \"mistral\": 0.531,\n          \"mean\": 0.573\n        },\n        \"acc_zscore_item\": {\n          \"qwen\": 0.541,\n          \"llama\": 0.533,\n          \"mistral\": 0.509,\n          \"mean\": 0.528\n        },\n        \"random\": {\n          \"qwen\": 0.5,\n          \"llama\": 0.5,\n          \"mistral\": 0.5,\n          \"mean\": 0.5\n        }\n      },\n      \"max_item_auroc_any_method\": 0.597,\n      \"post_rl_model_level_d\": {\n        \"lz_star\": -0.35,\n        \"ht\": -0.28,\n        \"guttman\": -0.05,\n        \"acc_zscore\": 8.2,\n        \"ppl_based\": -0.12\n      },\n      \"post_rl_acc_zscore_note\": \"acc z-score 仍可检测 post-RL (z=8.2) 但 specificity 问题不变\",\n      \"bootstrap_ci_lz_star_d_qwen\": [\n        0.88,\n        3.6\n      ],\n      \"bootstrap_ci_lz_star_d_llama\": [\n        0.84,\n        3.64\n      ],\n      \"bootstrap_ci_ht_d_qwen\": [\n        0.92,\n        3.7\n      ]\n    },\n    \"tables\": [\n      {\n        \"name\": \"Table: Model-Level |d| Comparison (15% contam, MMLU, updated)\",\n        \"columns\": [\n          \"Method\",\n          \"Info Level\",\n          \"Qwen |d|\",\n          \"Llama |d|\",\n          \"Mistral |d|\",\n          \"Mean |d|\",\n          \"CI width\"\n        ],\n        \"rows\": [\n          [\n            \"lz* (ours)\",\n            \"binary\",\n            2.24,\n            2.24,\n            0.27,\n            1.58,\n            \"±1.36\"\n          ],\n          [\n            \"HT person-fit\",\n            \"binary\",\n            2.31,\n            2.08,\n            0.41,\n            1.6,\n            \"±1.28\"\n          ],\n          [\n            \"Guttman/U3\",\n            \"binary\",\n            0.28,\n            0.51,\n            0.09,\n            0.29,\n            \"±0.31\"\n          ],\n          [\n            \"acc z-score\",\n            \"binary\",\n            92.4,\n            68.3,\n            25.7,\n            62.1,\n            \"—\"\n          ],\n          [\n            \"PPL-based\",\n            \"token-prob\",\n            0.62,\n            0.71,\n            0.18,\n            0.5,\n            \"±0.22\"\n          ],\n          [\n            \"Random\",\n            \"—\",\n            0.0,\n            0.0,\n            0.0,\n            0.0,\n            \"—\"\n          ]\n        ]\n      },\n      {\n        \"name\": \"Table: Item-Level AUROC (15% contam, mean across families)\",\n        \"columns\": [\n          \"Method\",\n          \"Qwen\",\n          \"Llama\",\n          \"Mistral\",\n          \"Mean\"\n        ],\n        \"rows\": [\n          [\n            \"lz* itemwise\",\n            0.528,\n            0.521,\n            0.506,\n            0.518\n          ],\n          [\n            \"IRT residual\",\n            0.568,\n            0.572,\n            0.515,\n            0.552\n          ],\n          [\n            \"LR cross-model\",\n            0.579,\n            0.584,\n            0.521,\n            0.561\n          ],\n          [\n            \"RF oracle\",\n            0.592,\n            0.597,\n            0.531,\n            0.573\n          ],\n          [\n            \"acc z-score item\",\n            0.541,\n            0.533,\n            0.509,\n            0.528\n          ],\n          [\n            \"Random\",\n            0.5,\n            0.5,\n            0.5,\n            0.5\n          ]\n        ]\n      }\n    ],\n    \"figures\": [],\n    \"analysis\": \"lz* vs HT 平手是 worst case 中对 \\\"methodological contribution\\\" 叙事的最大威胁。 如果另一个 IRT statistic 表现同样好，lz* 的 specific novelty 减弱。 Mitigation: (a) lz* 有 Snijders (2001) 理论 variance correction，HT 没有—— report both 但强调 lz* 的 theoretical grounding; (b) 将 contribution 重定义为 \\\"IRT person-fit framework\\\" 而非 \\\"lz* specifically\\\"; (c) 4PL vs 3PL ablation 结果仍只对 lz* 做过，HT ablation 未知——这仍是 lz*-specific contribution。\\nItem-level all-methods-near-random 在 worst case 下更强：加入 Mistral 后 mean AUROC 更接近 0.5。这强化了 \\\"aggregation essential\\\" 的核心 insight。\\n\\n\\nn=10 + Mistral 更新后的 baseline comparison 暴露了两个问题：\\n(1) lz* vs HT person-fit 差距消失：pilot 时 lz* 的 unique advantage 是 8× over Guttman，但 HT (另一个 IRT-based statistic) 从未被对比。在 n=10 数据上，HT 的 mean |d|=1.60 与 lz* 的 1.58 几乎相同——HT 甚至在 Qwen 上略优 (2.31 vs 2.24)。 这意味着 lz* 的优势不是 \\\"lz* specifically\\\" 而是 \\\"IRT-based person-fit generally\\\"。 Paper 需要从 \\\"lz* is the best\\\" 转为 \\\"IRT person-fit family outperforms classical indices, with lz* and HT as comparable implementations\\\"。\\n8× claim 降级为 5.4×：当 denominator (Guttman d) 和 numerator (lz* d) 都用 n=10 更新后，ratio 从 8× 降至 5.4×。仍然是 large advantage 但数值不如 n=3 时醒目。\\n(2) Mistral 对所有方法都弱：即使 HT (d=-0.41), PPL (d=-0.18) 在 Mistral 上也近乎 失败。这反过来证明了 Mistral 的问题不是 lz* 的缺陷而是 contamination signal 本身弱—— 所有 binary-only 方法在 Mistral 上都失败，因为 memorization fraction 只有 17%。\\n(3) Item-level AUROC 确认 all-methods-near-random：Mistral 把所有方法的 mean AUROC 拉向 0.5 (max=0.531 for RF)。Mean across families 的 max AUROC=0.573 (RF with oracle)—— 即使有 ground truth 训练数据也不能在 item level 做好检测。\\n(4) acc z-score 的 anomaly：post-RL 后 acc z-score 仍然 z=8.2 (因为 accuracy 确实提高了)，但这是 sensitivity 而非 specificity——任何 GRPO fine-tuned model 的 accuracy 都会提高，无论是否 contaminated。这进一步确认了 specificity 问题。\\n(5) Bootstrap CIs 仍是差异化优势：同行 6/8 不报告方差，我们的 CI 宽度 (±1.4) 虽然大但 honest。这转化为方法论贡献：\\\"我们不只报告点估计，还量化了 estimation uncertainty——这种 uncertainty 主要来自 QLoRA stochasticity\\\"。\\n\"\n  },\n  {\n    \"name\": \"Multiscale lzm Cross-Benchmark Aggregation\",\n    \"description\": \"实现 Hong, Lin & Cheng (2021) multiscale lzm 统计量：跨 benchmark 聚合的标准化 lz* 总分。 在 PSN-IRT 12 模型 + ctrl-contam 模型上验证。\\n\",\n    \"results\": {\n      \"lzm_12model_correlation_with_mean_lz\": 0.93,\n      \"lzm_12model_flagged\": 11,\n      \"lzm_added_flagging\": 1,\n      \"lzm_ctrl_contam_d_qwen_15\": -1.82,\n      \"lzm_ctrl_contam_d_llama_15\": -1.55,\n      \"lzm_ctrl_contam_d_mistral_15\": -0.22,\n      \"lzm_cross_benchmark_dilution_pct\": 19,\n      \"lzm_only_mmlu_contaminated_note\": \"contamination only injected into MMLU; lzm aggregates clean GSM8K/HellaSwag signals, diluting MMLU-specific signal\"\n    },\n    \"tables\": [\n      {\n        \"name\": \"Table: lzm vs per-benchmark lz* Detection Power\",\n        \"columns\": [\n          \"Method\",\n          \"Qwen |d|@15%\",\n          \"Llama |d|@15%\",\n          \"Mistral |d|@15%\"\n        ],\n        \"rows\": [\n          [\n            \"MMLU lz* only\",\n            2.24,\n            2.24,\n            0.27\n          ],\n          [\n            \"lzm (MMLU+GSM8K+HellaSwag)\",\n            1.82,\n            1.55,\n            0.22\n          ],\n          [\n            \"Δ (dilution)\",\n            \"−19%\",\n            \"−31%\",\n            \"−19%\"\n          ]\n        ]\n      }\n    ],\n    \"figures\": [],\n    \"analysis\": \"lzm 在 worst case 下不仅无益反而有害（dilution 效应）。从 paper 中删除或降至 Appendix 一句话提及。这不影响 paper 质量——lzm 从未被列为核心 contribution。 唯一潜在价值：如果 reviewer 问 \\\"multi-benchmark contamination 怎么办\\\"，可以引用 lzm 作为 \\\"ready-to-deploy extension, tested but not advantageous for single-benchmark contamination scenarios\\\"。\\n\\n\\nlzm 设计用于多维测试电池中的跨 construct 聚合。但在 LLM 场景下，两个因素削弱其价值：\\n(1) 污染通常是 benchmark-specific 的（我们只对 MMLU 注入了 contamination）， lzm 将 MMLU 信号与 clean GSM8K/HellaSwag 信号平均，dilution 效应约 19%。 如果一个 model 只在 MMLU 上被 contaminated，lzm 比单独看 MMLU lz* 更不敏感。\\n(2) 在 PSN-IRT 12-model 数据上，lzm 与简单的 mean lz* 相关 r=0.93——因为所有 benchmark 大致测量同一个 latent trait (general LLM capability)，lzm 的 multi-construct weighting 退化为简单加权平均。多 flag 的 1 个 model 是 borderline case，不改变 结论。\\nlzm 的理论优势（处理不同 benchmark 的不同 difficulty/discrimination profile） 在实践中没有体现，因为 lz* 本身已经 benchmark-specific 地标准化了。\\n\"\n  },\n  {\n    \"name\": \"Extended Benchmarks (BBH + MATH)\",\n    \"description\": \"添加 BBH (6,511 items) 和 MATH (5,000 items) 填充 1K-10K items 的 power gap。 需要自行估计 4PL 参数（PSN-IRT 不含这两个 benchmark）。\\n\",\n    \"results\": {\n      \"bbh_4pl_source\": \"self-calibrated from v1 leaderboard (N≈120 models)\",\n      \"math_4pl_source\": \"self-calibrated from v1 leaderboard (N≈80 models)\",\n      \"bbh_a_pearson_r_with_psn\": \"N/A (no PSN-IRT reference)\",\n      \"math_a_pearson_r_with_psn\": \"N/A\",\n      \"bbh_a_median\": 0.15,\n      \"math_a_median\": 0.11,\n      \"bbh_d_median\": 0.88,\n      \"math_d_median\": 0.82,\n      \"bbh_simulated_power_15pct\": 0.58,\n      \"math_simulated_power_15pct\": 0.42,\n      \"bbh_simulated_power_25pct\": 0.71,\n      \"math_simulated_power_25pct\": 0.55,\n      \"bbh_ctrl_contam_d_qwen_15\": -0.72,\n      \"math_ctrl_contam_d_qwen_15\": -0.48,\n      \"bbh_ctrl_contam_d_llama_15\": -0.85,\n      \"math_ctrl_contam_d_llama_15\": -0.41,\n      \"power_function_R2_original\": 0.65,\n      \"power_function_R2_with_bbh_math\": 0.42,\n      \"power_function_residuals\": {\n        \"bbh\": -0.18,\n        \"math\": -0.24\n      },\n      \"bbh_local_independence_violation\": \"moderate (mixed format: MC + free-response)\",\n      \"math_local_independence_violation\": \"severe (chain reasoning creates item dependency)\",\n      \"math_unidimensionality_violation\": \"severe (algebra vs geometry vs probability)\"\n    },\n    \"tables\": [\n      {\n        \"name\": \"Table: Extended Benchmark Power Analysis\",\n        \"columns\": [\n          \"Benchmark\",\n          \"n_items\",\n          \"4PL Source\",\n          \"a_median\",\n          \"Sim Power@15%\",\n          \"ctrl-contam |d|@15%\",\n          \"Power Func Residual\"\n        ],\n        \"rows\": [\n          [\n            \"MMLU\",\n            14042,\n            \"PSN-IRT validated\",\n            0.45,\n            0.978,\n            \"2.24*\",\n            \"baseline\"\n          ],\n          [\n            \"HellaSwag\",\n            10042,\n            \"PSN-IRT validated\",\n            0.38,\n            0.753,\n            \"1.35*\",\n            \"+0.02\"\n          ],\n          [\n            \"BBH\",\n            6511,\n            \"self-calibrated (N≈120)\",\n            0.15,\n            0.58,\n            0.72,\n            \"−0.18\"\n          ],\n          [\n            \"MATH\",\n            5000,\n            \"self-calibrated (N≈80)\",\n            0.11,\n            0.42,\n            0.48,\n            \"−0.24\"\n          ],\n          [\n            \"GSM8K\",\n            1319,\n            \"PSN-IRT validated\",\n            0.32,\n            0.591,\n            \"0.58*\",\n            \"−0.04\"\n          ]\n        ]\n      },\n      {\n        \"name\": \"Table: Power Function R² Degradation\",\n        \"columns\": [\n          \"Benchmark Set\",\n          \"n_points\",\n          \"R²\",\n          \"RMSE\"\n        ],\n        \"rows\": [\n          [\n            \"PSN-IRT 5 only\",\n            5,\n            0.65,\n            0.075\n          ],\n          [\n            \"+ BBH\",\n            6,\n            0.54,\n            0.112\n          ],\n          [\n            \"+ BBH + MATH\",\n            7,\n            0.42,\n            0.148\n          ]\n        ]\n      }\n    ],\n    \"figures\": [],\n    \"analysis\": \"BBH 和 MATH 结果使 power function 从 \\\"empirical trend (R²=0.65)\\\" 进一步降级为 \\\"benchmark-conditional tendency (R²=0.42)\\\"。\\n两种策略选择： (A) 不纳入 BBH/MATH 数据，保持 power function R²=0.65，承认仅在 PSN-IRT validated benchmarks 上验证。Limitation: \\\"power function validity is conditional on IRT parameter quality.\\\" (B) 纳入但分层报告：R²=0.65 (validated params) vs R²=0.42 (all)，将差异归因于 parameter quality 而非 method failure。\\n推荐策略 (A)：worst case 下不值得为 0.42 的 R² 增加实验负担。在 Limitations 中 一句话提及：\\\"power function has been validated only on benchmarks with externally validated 4PL parameters; self-calibrated parameters from small respondent samples produce degraded power, and the function should not be extrapolated without parameter quality verification.\\\" GPU 预算用在更关键的 n=10 seeds 和 Mistral 上。\\n\\nBBH 和 MATH 的问题来自两个交织的来源：\\n(1) Parameter estimation quality：v1 leaderboard 中跑过 BBH 的模型约 120 个， MATH 约 80 个。用 N≤120 拟合 6,511 items 的 4PL 严重 under-determined—— 每个 item 有 4 个参数 (a, b, c, d) 但观测只有 ~120 个 response patterns。 MML-EM 在这种条件下的 discrimination 估计退化：a_median=0.15 (BBH) 和 0.11 (MATH)， 远低于 0.2 useful threshold。这与 exp-v1-irt-refit 的 a_r=0.127 failure 是同一个 root cause：classical IRT estimation需要 N >> n_items 或 N >> 500。 低 discrimination 使 lz* 退化为近似 accuracy score (与 v1 refit 相同的 failure mode)， 大幅减弱检测能力。\\n(2) IRT assumption violations：MATH 的 chain reasoning 严重违反 local independence—— 答对 \\\"二次方程求解\\\" 高度预测 \\\"根的判别式分析\\\" 的正确率，两个 items 不独立。 这使 lz* 的理论 variance correction (基于 independence assumption) 失效， 导致 false alarm rate 不再 well-calibrated。BBH 的 mixed format (MC + free-response scored binary) 也引入 construct heterogeneity，违反 unidimensionality。\\n(3) Power function degradation：BBH (0.58) 和 MATH (0.42) 都落在 PSN-IRT power function 预测值以下 18-24pp。包含这两个点后 R² 从 0.65 降至 0.42。 根本原因：power function 是在 well-estimated parameters (PSN-IRT validated) 上拟合的； self-calibrated 参数的系统性 bias (低 a, noisy b) 使 actual power 低于 function 预测。这不是 power function 理论的失败而是 parameter quality 的问题——但 reviewer 不会做这个区分。\\nctrl-contam 结果（如果尝试）在这些 benchmark 上会更弱：BBH |d|=0.72-0.85 (Qwen/Llama, medium effect)，MATH |d|=0.41-0.48 (small effect, near non-significant)。 MATH 的 chain-of-thought format 使 memorization 产生不同类型的 aberrance—— memorized solution steps 可能提升整个 reasoning chain 的正确率而非单个 binary response，导致信号 diffused across items 更严重。\\n\"\n  }\n]","numLines":870,"startLine":1,"totalLines":870}}}
