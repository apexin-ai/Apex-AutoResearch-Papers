s = alpaca_indices[:5000]\\\\n    print(f\\\\\\\"  Alpaca items (sampled): {len(alpaca_indices)}\\\\\\\")\\\\n\\\\n    alpaca_items = []\\\\n    for idx in alpaca_indices:\\\\n        row = alpaca_raw[idx]\\\\n        text = row[\\\\\\\"instruction\\\\\\\"]\\\\n        if row.get(\\\\\\\"input\\\\\\\"):\\\\n            text += f\\\\\\\"\\\\\\\\n{row['input']}\\\\\\\"\\\n…[truncated 2615 chars]"
