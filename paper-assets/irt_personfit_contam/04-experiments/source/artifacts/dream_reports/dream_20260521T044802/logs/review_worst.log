\\\\\\\"\\\\n    abstract: \\\\\\\"\\\\\\\"\\\\n    semantic_scholar_id: \\\\\\\"\\\\\\\"\\\\n    verified: true\\\\n    added_by: worker\\\\n    added_at: \\\\\\\"2026-05-20T21:15:00Z\\\\\\\"\\\\n\\\\n  barton1981:\\\\n    title: \\\\\\\"An Upper Asymptote for the Three-Parameter Logistic Item-Response Model\\\\\\\"\\\\n    authors: [\\\\\\\"Barton, M. A.\\\\\\\", \\\\\\\"Lord, F. M.\\\\\\\"]\\\\n    year: 1981\\\\n    venue: \\\\\\\"ETS Research Report Series (RR-81-20)\\\\\\\"\\\\n    url: \\\\\\\"https://onlinelibrary.wiley.com/doi/abs/10.1002/j.2333-8504.1981.tb01255.x\\\\\\\"\\\\n    doi: \\\\\\\"10.1002/j.2333-8504.1981.tb01255.x\\\\\\\"\\\\n    bibtex_key: barton1981\\\\n    category: irt-foundations\\\\n    role: foundation\\\\n    relevance: \\\\\\\"Origin of the 4PL model adding upper asymptote parameter d to the 3PL — directly relevant to PSN-IRT's 4PL item parameters\\\\\\\"\\\\n    abstract: \\\\\\\"\\\\\\\"\\\\n    semantic_scholar_id: \\\\\\\"\\\\\\\"\\\\n    verified: true\\\\n    added_by: worker\\\\n    added_at: \\\\\\\"2026-05-20T21:15:00Z\\\\\\\"\\\\n\\\\n  birnbaum1968:\\\\n    title: \\\\\\\"Some Latent Trait Models and Their Use in Inferring an Examinee's Ability\\\\\\\"\\\\n    authors: [\\\\\\\"Birnbaum, A.\\\\\\\"]\\\\n    year: 1968\\\\n    venue: \\\\\\\"In F. M. Lord & M. R. Novick (Eds.), Statistical Theories of Mental Test Scores (pp. 397-479). Addison-Wesley\\\\\\\"\\\\n    url: \\\\\\\"\\\\\\\"\\\\n    doi: \\\\\\\"\\\\\\\"\\\\n    bibtex_key: birnbaum1968\\\\n    category: irt-foundations\\\\n    role: foundation\\\\n    relevance: \\\\\\\"Introduced the 2PL and 3PL IRT models — the parametric foundation underlying all modern IRT applications including our person-fit approach\\\\\\\"\\\\n    abstract: \\\\\\\"\\\\\\\"\\\\n    semantic_scholar_id: \\\\\\\"\\\\\\\"\\\\n    verified: true\\\\n    added_by: worker\\\\n    added_at: \\\\\\\"2026-05-20T21:15:00Z\\\\\\\"\\\\n\\\\n  deayala2009:\\\\n    title: \\\\\\\"The Theory and Practice of Item Response Theory\\\\\\\"\\\\n    authors: [\\\\\\\"de Ayala, R. J.\\\\\\\"]\\\\n    year: 2009\\\\n    venue: \\\\\\\"Guilford Press\\\\\\\"\\\\n    url: \\\\\\\"\\\\\\\"\\\\n    doi: \\\\\\\"\\\\\\\"\\\\n    bibtex_key: deayala2009\\\\n    category: irt-foundations\\\\n    role: foundation\\\\n    relevance: \\\\\\\"Modern comprehensive IRT textbook covering 1PL through 4PL models, estimation methods, and person-fit — standard graduate-level reference\\\\\\\"\\\\n    abstract: \\\\\\\"\\\\\\\"\\\\n    semantic_scholar_id: \\\\\\\"\\\\\\\"\\\\n    verified: true\\\\n    added_by: worker\\\\n    added_at: \\\\\\\"2026-05-20T21:15:00Z\\\\\\\"\\\\n\\\\n  # --- Cluster 1: irt-llm (new papers) ---\\\\n\\\\n  martinezplumed2019:\\\\n    title: \\\\\\\"Item Response Theory in AI: Analysing Machine Learning Classifiers at the Instance Level\\\\\\\"\\\\n    authors: [\\\\\\\"Martínez-Plumed, F.\\\\\\\", \\\\\\\"Prudêncio, R. B. C.\\\\\\\", \\\\\\\"Martínez-Usó, A.\\\\\\\", \\\\\\\"Hernández-Orallo, J.\\\\\\\"]\\\\n    year: 2019\\\\n    venue: \\\\\\\"Artificial Intelligence\\\\\\\"\\\\n    url: \\\\\\\"https://www.sciencedirect.com/science/article/pii/S0004370219300220\\\\\\\"\\\\n    doi: \\\\\\\"10.1016/j.artint.2018.09.004\\\\\\\"\\\\n    bibtex_key: martinezplumed2019\\\\n    category: irt-llm\\\\n    role: foundation\\\\n    relevance: \\\\\\\"Foundational work applying IRT to AI/ML evaluation at instance level — item difficulty, discrimination, guessing for classifiers. Establishes the IRT-for-AI paradigm our work extends to LLM contamination.\\\\\\\"\\\\n    abstract: \\\\\\\"\\\\\\\"\\\\n    semantic_scholar_id: \\\\\\\"\\\\\\\"\\\\n    verified: true\\\\n    added_by: worker\\\\n    added_at: \\\\\\\"2026-05-20T22:30:00Z\\\\\\\"\\\\n\\\\n  polo2024tinybenchmarks:\\\\n    title: \\\\\\\"tinyBenchmarks: Evaluating LLMs with Fewer Examples\\\\\\\"\\\\n    authors: [\\\\\\\"Polo, F. M.\\\\\\\", \\\\\\\"Weber, L.\\\\\\\", \\\\\\\"Choshen, L.\\\\\\\", \\\\\\\"Sun, Y.\\\\\\\", \\\\\\\"Xu, G.\\\\\\\", \\\\\\\"Yurochkin, M.\\\\\\\"]\\\\n    year: 2024\\\\n    venue: \\\\\\\"ICML 2024\\\\\\\"\\\\n    url: \\\\\\\"https://arxiv.org/abs/2402.14992\\\\\\\"\\\\n    doi: \\\\\\\"\\\\\\\"\\\\n    bibtex_key: polo2024tinybenchmarks\\\\n    category: irt-llm\\\\n    role: background\\\\n    relevance: \\\\\\\"Uses IRT-based item selection to reduce benchmark size by 100x while preserving ranking — complementary efficient-evaluation approach; validates that item-level analysis matters for LLM benchmarks.\\\\\\\"\\\\n    abstract: \\\\\\\"\\\\\\\"\\\\n    semantic_scholar_id: \\\\\\\"\\\\\\\"\\\\n    verified: true\\\\n    added_by: worker\\\\n    added_at: \\\\\\\"2026-05-20T22:30:00Z\\\\\\\"\\\\n\\\\n  # --- Cluster 2: post-rl-contamination (new paper) ---\\\\n\\\\n  zhang2026rlvr:\\\\n    title: \\\\\\\"Detecting RLVR Training Data via Structural Convergence of Reasoning\\\\\\\"\\\\n    authors: [\\\\\\\"Zhang, H.\\\\\\\", \\\\\\\"Yang, Y.\\\\\\\", \\\\\\\"Yan, J.\\\\\\\", \\\\\\\"Bao, G.\\\\\\\", \\\\\\\"Zhang, Y.\\\\\\\", \\\\\\\"Zhang, Y.\\\\\\\"]\\\\n    year: 2026\\\\n    venue: \\\\\\\"arXiv preprint\\\\\\\"\\\\n    url: \\\\\\\"https://arxiv.org/abs/2602.11792\\\\\\\"\\\\n    doi: \\\\\\\"\\\\\\\"\\\\n    bibtex_key: zhang2026rlvr\\\\n    category: post-rl-contamination\\\\n    role: direct-competitor\\\\n    relevance: \\\\\\\"Min-kNN Distance black-box detector exploiting reasoning structural collapse under RLVR — directly comparable baseline for post-RL contamination detection without token probabilities.\\\\\\\"\\\\n    abstract: \\\\\\\"\\\\\\\"\\\\n    semantic_scholar_id: \\\\\\\"\\\\\\\"\\\\n    verified: true\\\\n    added_by: worker\\\\n    added_at: \\\\\\\"2026-05-20T22:30:00Z\\\\\\\"\\\\n\\\\n  # --- Cluster 3: llm-evaluation-infrastructure ---\\\\n\\\\n  hendrycks2021mmlu:\\\\n    title: \\\\\\\"Measuring Massive Multitask Language Understanding\\\\\\\"\\\\n    authors: [\\\\\\\"Hendrycks, D.\\\\\\\", \\\\\\\"Burns, C.\\\\\\\", \\\\\\\"Basart, S.\\\\\\\", \\\\\\\"Zou, A.\\\\\\\", \\\\\\\"Mazeika, M.\\\\\\\", \\\\\\\"Song, D.\\\\\\\", \\\\\\\"Steinhardt, J.\\\\\\\"]\\\\n    year: 2021\\\\n    venue: \\\\\\\"ICLR 2021\\\\\\\"\\\\n    url: \\\\\\\"https://arxiv.org/abs/2009.03300\\\\\\\"\\\\n    doi: \\\\\\\"\\\\\\\"\\\\n    bibtex_key: hendrycks2021mmlu\\\\n    category: llm-evaluation-infrastructure\\\\n    role: foundation\\\\n    relevance: \\\\\\\"Introduced MMLU — the most widely used LLM benchmark with 57 tasks. Our contamination detection framework is primarily validated on MMLU-derived item parameters.\\\\\\\"\\\\n    abstract: \\\\\\\"\\\\\\\"\\\\n    semantic_scholar_id: \\\\\\\"\\\\\\\"\\\\n    verified: true\\\\n    added_by: worker\\\\n    added_at: \\\\\\\"2026-05-20T22:30:00Z\\\\\\\"\\\\n\\\\n  beeching2023openllm:\\\\n    title: \\\\\\\"Open LLM Leaderboard\\\\\\\"\\\\n    authors: [\\\\\\\"Beeching, E.\\\\\\\", \\\\\\\"Fourrier, C.\\\\\\\", \\\\\\\"Habib, N.\\\\\\\", \\\\\\\"Han, S.\\\\\\\", \\\\\\\"Lambert, N.\\\\\\\", \\\\\\\"Rajani, N.\\\\\\\", \\\\\\\"Sanseviero, O.\\\\\\\", \\\\\\\"Tunstall, L.\\\\\\\", \\\\\\\"Wolf, T.\\\\\\\"]\\\\n    year: 2023\\\\n    venue: \\\\\\\"HuggingFace\\\\\\\"\\\\n    url: \\\\\\\"https://huggingface.co/spaces/open-llm-leaderboard-old/open_llm_leaderboard\\\\\\\"\\\\n    doi: \\\\\\\"\\\\\\\"\\\\n    bibtex_key: beeching2023openllm\\\\n    category: llm-evaluation-infrastructure\\\\n    role: foundation\\\\n    relevance: \\\\\\\"The primary public LLM leaderboard aggregating benchmark scores — the ecosystem where contamination incentives are strongest and our method is most needed.\\\\\\\"\\\\n    abstract: \\\\\\\"\\\\\\\"\\\\n    semantic_scholar_id: \\\\\\\"\\\\\\\"\\\\n    verified: true\\\\n    added_by: worker\\\\n    added_at: \\\\\\\"2026-05-20T22:30:00Z\\\\\\\"\\\\n\\\\n  gao2023evalharness:\\\\n    title: \\\\\\\"A Framework for Few-Shot Language Model Evaluation\\\\\\\"\\\\n    authors: [\\\\\\\"Gao, L.\\\\\\\"