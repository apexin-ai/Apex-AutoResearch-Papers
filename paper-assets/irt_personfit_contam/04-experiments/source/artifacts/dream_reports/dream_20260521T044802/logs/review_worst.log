\\\\\\"\\\\n    doi: \\\\\\\"10.1145/3641289\\\\\\\"\\\\n    bibtex_key: chang2024survey\\\\n    category: llm-evaluation-infrastructure\\\\n    role: background\\\\n    relevance: \\\\\\\"Comprehensive survey covering what/where/how to evaluate LLMs — provides the broader evaluation landscape context for our contamination detection contribution.\\\\\\\"\\\\n    abstract: \\\\\\\"\\\\\\\"\\\\n    semantic_scholar_id: \\\\\\\"\\\\\\\"\\\\n    verified: true\\\\n    added_by: worker\\\\n    added_at: \\\\\\\"2026-05-20T22:30:00Z\\\\\\\"\\\\n\\\\n  biderman2024lessons:\\\\n    title: \\\\\\\"Lessons from the Trenches on Reproducible Evaluation of Language Models\\\\\\\"\\\\n    authors: [\\\\\\\"Biderman, S.\\\\\\\", \\\\\\\"Schoelkopf, H.\\\\\\\", \\\\\\\"Sutawika, L.\\\\\\\", \\\\\\\"Gao, L.\\\\\\\", \\\\\\\"Tow, J.\\\\\\\", \\\\\\\"Abbasi, B.\\\\\\\", \\\\\\\"Aji, A. F.\\\\\\\", \\\\\\\"Ammanamanchi, P. S.\\\\\\\", \\\\\\\"Black, S.\\\\\\\", \\\\\\\"Clive, J.\\\\\\\", \\\\\\\"DiPofi, A.\\\\\\\", \\\\\\\"Etxaniz, J.\\\\\\\", \\\\\\\"Fattori, B.\\\\\\\", \\\\\\\"Forde, J. Z.\\\\\\\", \\\\\\\"Foster, C.\\\\\\\", \\\\\\\"Hsu, J.\\\\\\\", \\\\\\\"Jaiswal, M.\\\\\\\", \\\\\\\"Lee, W. Y.\\\\\\\", \\\\\\\"Li, H.\\\\\\\", \\\\\\\"Lovering, C.\\\\\\\", \\\\\\\"Muennighoff, N.\\\\\\\", \\\\\\\"Pavlick, E.\\\\\\\", \\\\\\\"Phang, J.\\\\\\\", \\\\\\\"Skowron, A.\\\\\\\", \\\\\\\"Tan, S.\\\\\\\", \\\\\\\"Tang, X.\\\\\\\", \\\\\\\"Wang, K. A.\\\\\\\", \\\\\\\"Winata, G. I.\\\\\\\", \\\\\\\"Yvon, F.\\\\\\\", \\\\\\\"Zou, A.\\\\\\\"]\\\\n    year: 2024\\\\n    venue: \\\\\\\"arXiv preprint\\\\\\\"\\\\n    url: \\\\\\\"https://arxiv.org/abs/2405.14782\\\\\\\"\\\\n    doi: \\\\\\\"\\\\\\\"\\\\n    bibtex_key: biderman2024lessons\\\\n    category: llm-evaluation-infrastructure\\\\n    role: background\\\\n    relevance: \\\\\\\"Documents reproducibility challenges in LLM evaluation — prompt sensitivity, implementation differences, score variance — motivates why contamination detection must be robust to evaluation noise.\\\\\\\"\\\\n    abstract: \\\\\\\"\\\\\\\"\\\\n    semantic_scholar_id: \\\\\\\"\\\\\\\"\\\\n    verified: true\\\\n    added_by: worker\\\\n    added_at: \\\\\\\"2026-05-20T22:30:00Z\\\\\\\"\\\\n\\\", \\\"total_chars\\\": 23229, \\\"truncated\\\": false}, \\\"error\\\": null, \\\"metadata\\\": {}}\"}"}]},"parent_tool_use_id":"toolu_01GdhGLqpgevg1ZJUa3C3AeH","session_id":"46a229a4-0dcc-4513-b62d-d6edf34e81e4","uuid":"10e3f3bb-f2ea-4bdc-ad23-e3de280a3962","timestamp":"2026-05-21T05:51:51.097Z"}
