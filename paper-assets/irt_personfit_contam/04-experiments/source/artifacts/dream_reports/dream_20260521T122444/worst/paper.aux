\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Pre-RL vs.\ Post-RL detection. GRPO eliminates detection signals for \emph  {all} methods. Memorization fraction drops from 0.36 to 0.05; seen/unseen accuracy gap collapses from 0.10 to 0.01. Difficulty ordering is restored post-RL.}}{6}{table.5}\protected@file@percent }
\newlabel{tab:post_rl}{{5}{6}{Pre-RL vs.\ Post-RL detection. GRPO eliminates detection signals for \emph {all} methods. Memorization fraction drops from 0.36 to 0.05; seen/unseen accuracy gap collapses from 0.10 to 0.01. Difficulty ordering is restored post-RL}{table.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Detection power across benchmarks (Qwen, 15\% contamination). Self-calibrated parameters (BBH, MATH) incur 15--25\% power loss vs.\ PSN-IRT. The power function fit including self-calibrated benchmarks yields $R^2 = 0.62$.}}{6}{table.6}\protected@file@percent }
\newlabel{tab:extra_benchmarks}{{6}{6}{Detection power across benchmarks (Qwen, 15\% contamination). Self-calibrated parameters (BBH, MATH) incur 15--25\% power loss vs.\ PSN-IRT. The power function fit including self-calibrated benchmarks yields $R^2 = 0.62$}{table.6}{}}
