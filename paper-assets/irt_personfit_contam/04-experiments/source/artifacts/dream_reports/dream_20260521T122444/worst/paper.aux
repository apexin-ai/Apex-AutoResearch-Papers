\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Detection performance by IRT parameterization. Power gain is measured as absolute difference vs.\ 4PL. 46\% of MMLU items have $d < 0.95$; forcing $d = 1$ inflates false alarm rates and reduces power by 19--25pp.}}{5}{table.3}\protected@file@percent }
\newlabel{tab:4pl_ablation}{{3}{5}{Detection performance by IRT parameterization. Power gain is measured as absolute difference vs.\ 4PL. 46\% of MMLU items have $d < 0.95$; forcing $d = 1$ inflates false alarm rates and reduces power by 19--25pp}{table.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Detection method comparison. SFT column: model-level detection on Qwen2.5-7B at 15\% MMLU contamination. Post-RL column: after GRPO training. $\ell _z^*$ beats only 3 baselines (Guttman, U3, random). ConStat and Min-K++ outperform $\ell _z^*$ given richer information access. Acc.\ $z$-score is sensitive but non-specific.}}{5}{table.4}\protected@file@percent }
\newlabel{tab:baselines}{{4}{5}{Detection method comparison. SFT column: model-level detection on Qwen2.5-7B at 15\% MMLU contamination. Post-RL column: after GRPO training. $\ell _z^*$ beats only 3 baselines (Guttman, U3, random). ConStat and Min-K++ outperform $\ell _z^*$ given richer information access. Acc.\ $z$-score is sensitive but non-specific}{table.4}{}}
