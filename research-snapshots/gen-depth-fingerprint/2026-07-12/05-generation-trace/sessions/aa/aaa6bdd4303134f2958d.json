                "command": "cd /home/ubuntu/.agent-ml-research-idea_gen_0514_3/projects/gen-depth-fingerprint && python3 << 'PYEOF'\nimport pandas as pd\nimport numpy as np\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.decomposition import PCA\n\n# Load data\ndf = pd.read_csv(\"artifacts/_project/supplement/data/features_all_models.csv\")\nprint(f\"Shape: {df.shape}\")\nprint(f\"Columns: {list(df.columns)}\")\n\nfeature_cols = ['entropy_mean', 'entropy_std', 'entropy_min', 'entropy_max', 'tail_decay', 'ttr', 'hapax_ratio']\nX = df[feature_cols].values\n\n# Standardize\nscaler = StandardScaler()\nX_std = scaler.fit_transform(X)\n\n# === 1. Full PCA (all 7 features) ===\npca_full = PCA(n_components=7)\npca_full.fit(X_std)\n\nprint(\"\\n\" + \"=\"*60)\nprint(\"FULL PCA: Explained Variance Ratio (all 7 features)\")\nprint(\"=\"*60)\nfor i, (ev, cumev) in enumerate(zip(pca_full.explained_variance_ratio_, \n                                     np.cumsum(pca_full.explained_variance_ratio_))):\n    print(f\"  PC{i+1}: {ev:.4f}  (cumulative: {cumev:.4f})\")\n\nprint(f\"\\n  PC1+PC2 cumulative: {sum(pca_full.explained_variance_ratio_[:2]):.4f}\")\n\n# === 2. Loadings for PC1 and PC2 ===\nprint(\"\\n\" + \"=\"*60)\nprint(\"LOADINGS (component weights)\")\nprint(\"=\"*60)\nloadings = pca_full.components_  # shape (7, 7)\n\nprint(f\"\\n{'Feature':<16} {'PC1':>8} {'PC2':>8}\")\nprint(\"-\"*34)\nfor j, feat in enumerate(feature_cols):\n    print(f\"  {feat:<14} {loadings[0,j]:>8.4f} {loadings[1,j]:>8.4f}\")\n\n# === 3. Drifting features subset PCA ===\ndrift_cols = ['entropy_mean', 'ttr', 'hapax_ratio']\ndrift_idx = [feature_cols.index(c) for c in drift_cols]\nX_drift = X_std[:, drift_idx]\n\npca_drift = PCA(n_components=3)\npca_drift.fit(X_drift)\n\nprint(\"\\n\" + \"=\"*60)\nprint(\"DRIFTING-SUBSET PCA (entropy_mean, ttr, hapax_ratio)\")\nprint(\"=\"*60)\nfor i, ev in enumerate(pca_drift.explained_variance_ratio_):\n    print(f\"  PC{i+1}: {ev:.4f}\")\nprint(f\"\\n  PC1 alone explains {pca_drift.explained_variance_ratio_[0]:.4f} of drifting-feature variance\")\n\nprint(f\"\\n  Drift subset loadings on PC1:\")\nfor j, feat in enumerate(drift_cols):\n    print(f\"    {feat:<14} {pca_drift.components_[0,j]:>8.4f}\")\n\n# === 4. Correlation matrix (upper triangle) ===\nprint(\"\\n\" + \"=\"*60)\nprint(\"CORRELATION MATRIX (upper triangle, Pearson)\")\nprint(\"=\"*60)\ncorr = np.corrcoef(X_std.T)\n\n# Header\nheader = \"\".join(f\"{f[:8]:>10}\" for f in feature_cols)\nprint(f\"{'':>14}{header}\")\nprint(\"-\" * (14 + 10*7))\nfor i, fi in enumerate(feature_cols):\n    row = \"\"\n    for j, fj in enumerate(feature_cols):\n        if j < i:\n            row += f\"{'':>10}\"\n        else:\n            row += f\"{corr[i,j]:>10.3f}\"\n    print(f\"  {fi:<12}{row}\")\n\n# Also print just the strong correlations\nprint(\"\\n  Strong correlations (|r| > 0.5):\")\nfor i in range(len(feature_cols)):\n    for j in range(i+1, len(feature_cols)):\n        r = corr[i,j]\n        if abs(r) > 0.5:\n            print(f\"    {feature_cols[i]} <-> {feature_cols[j]}: r = {r:.3f}\")\n\nPYEOF",
