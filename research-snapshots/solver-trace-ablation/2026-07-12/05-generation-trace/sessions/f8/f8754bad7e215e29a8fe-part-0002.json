ile j < len(formula) and (formula[j].isalnum() or formula[j] == '_'):\\\\n101:                    j += 1\\\\n102:                if j < len(formula) and formula[j] == '(':\\\\n103:                    depth = 1\\\\n104:                    j += 1\\\\n105:                    while j < len(formula) and depth > 0:\\\\n106:                        if formula[j] == '(':\\\\n107:                            depth += 1\\\\n108:                        elif formula[j] == ')':\\\\n109:                            depth -= 1\\\\n110:                        j += 1\\\\n111:\\\\n112:            B = formula[right_start:j]\\\\n113:            replacement = f\\\\\\\"(({A} ∨ {B}) ∧ ¬({A} ∧ {B})\\\\n\\\\n... [截断: 输出过长，省略 501 字符] ...\\\\n\\\\n,\\\\n130:        }\\\\n131:        for unicode_sym, ascii_sym in replacements.items():\\\\n132:            formula = formula.replace(unicode_sym, ascii_sym)\\\\n133:        return formula\\\\n134:\\\\n135:    def prove(self, premises: list[str], conclusion: str, timeout: int = 5) -> SolverResult:\\\\n136:        premises = [self._normalize_fol(p) for p in premises]\\\\n137:        conclusion = self._normalize_fol(conclusion)\\\\n138:        input_text = self._build_input(premises, [conclusion])\\\\n139:        return self._run(input_text, timeout)\\\\n140:\\\\n141:    def check_consistency(self, formulas: list[str], timeout: int = 5) -> SolverResult:\\\\n142:        formulas = [self._normalize_fol(f) for f in formulas]\\\\n143:        # Consistency = the set is satisfiable.\\\\n144:        # Prover9 is a refutation prover: we ask it to derive a contradiction.\\\\n145:        # If it *fails* to find a proof, the set is consistent.\\\\n146:        input_text = self._build_input(formulas, [\\\\\\\"$F\\\\\\\"])  # $F = false\\\\n147:        result = self._run(input_text, timeout)\\\\n148:        # Invert: proved contradiction ⇒ inconsistent; failed ⇒ consistent\\\\n149:        return SolverResult(\\\\n150:            success=result.success,\\\\n151:      