errors=\\\\\\\"replace\\\\\\\",\\\\n191:                    timeout=timeout + 10,  # generous grace period\\\\n192:                )\\\\n193:                elapsed = time.monotonic() - t0\\\\n194:                raw = proc.stdout + proc.stderr\\\\n195:                proved = self._parse_proved(raw)\\\\n196:                return SolverResult(\\\\n197:                    success=True,\\\\n198:                    proved=proved,\\\\n199:                    time_seconds=elapsed,\\\\n200:                    raw_output=raw,\\\\n201:                )\\\\n202:            except subprocess.TimeoutExpired:\\\\n203:                elapsed = time.monotonic() - t0\\\\n204:                return SolverResult(\\\\n205:                    success=False,\\\\n206:                    proved=False,\\\\n207:                    time_seconds=elapsed,\\\\n208:                    raw_output=\\\\\\\"\\\\\\\",\\\\n209:                    error=\\\\\\\"subprocess timeout\\\\\\\",\\\\n210:                )\\\\n211:        finally:\\\\n212:            os.unlink(tmp_path)\\\\n213:\\\\n214:    @staticmethod\\\\n215:    def _parse_proved(output: str) -> bool:\\\\n216:        # Prover9 prints \\\\\\\"THEOREM PROVED\\\\\\\" on success\\\\n217:        for line in output.splitlines():\\\\n218:            if \\\\\\\"THEOREM PROVED\\\\\\\" in line.upper():\\\\n219:                return True\\\\n220:        return False\\\\n\\\", \\\"stderr\\\": \\\"\\\", \\\"return_code\\\": 0}, \\\"error\\\": null, \\\"metadata\\\": {\\\"elapsed_seconds\\\": 0.44}}\"}"
