\")\n\nif peak < 30:\n    print(f\"\\n=== RESULT: SINGLE GPU OK (peak {peak:.1f}GB / 32GB) ===\")\nelse:\n    print(f\"\\n=== RESULT: SINGLE GPU TIGHT (peak {peak:.1f}GB / 32GB) ===\")\nPYEOF\nsource /root/miniconda3/etc/profile.d/conda.sh && conda activate base && CUDA_VISIBLE_DEVICES=0 python3 /tmp/test_act_vram.py",
